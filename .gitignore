!/.forgejo/
!/.forgejo/**
# ADR-0030 Decision 4: /usr/share/man/ rendered from SSOT as build output
/usr/share/man/
/usr/share/man/**
# The block-all `/*` rule never un-ignored tests/. Files already tracked there
# (drift-gate-negatives.sh) survived only because tracking predates the rule --
# any NEW test was silently unstageable, which is how tests/powershell/ came to
# be referenced by a CI step while being impossible to commit (exit 127,
# "No such file or directory").
!/tests/
!/tests/**

# The ADRs and the north-star design docs. The block-all rule at the top left
# these ENTIRELY untracked -- 43 files, including every docs/adr decision record
# that the governance model cites (36 tracked files reference docs/adr) and the
# doc-*.md north stars. They existed only on a contributor's disk.
!/docs/
!/docs/**
!/docs/research/architecture-gap-audit-2026-09-29.md
# The dev-loop handoff ledger. The block-all `.*` rule above hides every
# dotted directory, and a handoff note only works if the next session can read
# it from a clean clone.
!/.devloop/
!/.devloop/**
# ...but NOT the orchestrator's per-run scratch directories. `!/.devloop/**` above
# re-includes everything under .devloop, and a .gitignore negation OUTRANKS
# .git/info/exclude, so the `.devloop/run-*/` line the orchestrator writes there is
# inert in this repo -- every run left its scratch dir showing as untracked, and
# devloop.sh then refuses to merge into a tree it dirtied itself ("base tree dirty
# before merge -- halting"). A later pattern wins within a file, so re-ignore them
# here. LEDGER.md and goal_state.json stay tracked: those are the durable handoff
# state, and no run-* directory has ever been committed.
/.devloop/run-*/
/.devloop/.zai-probe.state
/.devloop/backlog_archive.jsonl
/.devloop/HISTORICAL_BACKLOG.md
/.devloop/unified_tasks.jsonl
/docs/distilled/
/docs/research/task-migration-and-halflife.md
!/specs/
!/specs/**
# ...except the w10-live-boot staging dump: path-mangled edit-target artifacts
# from an unlanded design session ("EDIT TARGET: C:\MiOS\Justfile ..."), not
# documentation. Its two real design notes are .md and stay tracked.
docs/design/w10-live-boot/*
!docs/design/w10-live-boot/*.md
# Same trap as tests/: the block-all `/*` rule never un-ignored installation/,
# so installation/mios-common.ps1 -- which Get-MiOS.ps1, mios-install.ps1 and
# the Pester suite all dot-source -- was absent from every clean checkout.
!/installation/
!/installation/**
# ...except the .bat shims. Law 14 (TARGET-LANGUAGES) bans .bat outright, and
# grandfathered_cs is a C#-only list its own comment says must never grow.
# These two have never been tracked, so leaving them untracked is the status
# quo -- un-ignoring them would have smuggled a fresh Law-14 violation in as a
# side effect of rescuing mios-common.ps1.
/installation/*.bat
!/powershell/
!/powershell/**
!/ROADMAP.md
!/tasks.jsonl
!/TASKS.md
!/PROJECT.md
!/research/
/research/*
