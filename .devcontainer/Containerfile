# AI-hint: The MiOS devcontainer is the MiOS image plus account and container wiring.
# The OS pipeline owns packages, toolchains and payloads. This stage materializes
# boot-time account/tmpfiles state before an editor or lifecycle command attaches.
# Mirrored byte-identical into mios-bootstrap and -dev-loop; edit this source only.
ARG MIOS_IMAGE_REF=ghcr.io/mios-dev/mios:latest
FROM ${MIOS_IMAGE_REF}

# The checkout projects this from [identity].username together with remoteUser.
# Direct image builds default to the baked image's canonical identity.
ARG MIOS_IDENTITY_USERNAME
USER 0
RUN set -euo pipefail; \
    for helper in /usr/libexec/mios/mios-toml-get /usr/libexec/mios/mios-subuid-alloc; do \
        [ -x "$helper" ] || { echo "[devcontainer] ERROR: MiOS base image lacks required account helper $helper; build and publish the current full MiOS image before rebuilding this devcontainer" >&2; exit 1; }; \
    done; \
    image_user="$(env -u MIOS_IDENTITY_USERNAME /usr/libexec/mios/mios-toml-get identity username)"; \
    user="${MIOS_IDENTITY_USERNAME:-$image_user}"; renamed_from=""; \
    case "$user" in ''|root|[0-9-]*|*[!a-z0-9_-]*) \
        echo "[devcontainer] ERROR: canonical identity must be a non-root Linux user name" >&2; exit 1 ;; esac; \
    systemd-tmpfiles --create --prefix=/var/home --prefix=/var/roothome --prefix=/var/opt \
        --prefix=/var/srv --prefix=/var/mnt --prefix=/var/usrlocal; \
    if ! getent passwd "$user" >/dev/null; then systemd-sysusers; fi; \
    if ! getent passwd "$user" >/dev/null; then \
        owner="$(getent passwd 1000 | cut -d: -f1 || true)"; \
        if [ -n "$owner" ]; then \
            [ "$owner" = "$image_user" ] && [ "$owner" != root ] \
                || { echo "[devcontainer] ERROR: UID 1000 belongs to an unrelated account; rebuild the base image with the canonical identity" >&2; exit 1; }; \
            usermod --login "$user" --home "/var/home/$user" --move-home "$owner"; renamed_from="$owner"; \
            group="$(id -gn "$user")"; \
            if [ "$group" = "$owner" ] && ! getent group "$user" >/dev/null; then \
                groupmod --new-name "$user" "$group"; \
            fi; \
        else \
            shell="$(/usr/libexec/mios/mios-toml-get identity shell)"; \
            [ -x "$shell" ] || { echo "[devcontainer] ERROR: canonical login shell is unavailable in the base image" >&2; exit 1; }; \
            printf 'u %s 1000 "MiOS developer" /var/home/%s %s\n' "$user" "$user" "$shell" | systemd-sysusers -; \
        fi; \
    fi; \
    entry="$(getent passwd "$user")" \
        || { echo "[devcontainer] ERROR: canonical account provisioning failed" >&2; exit 1; }; \
    [ "$(id -u "$user")" = 1000 ] \
        || { echo "[devcontainer] ERROR: canonical developer account must own UID 1000" >&2; exit 1; }; \
    account_home="$(printf '%s\n' "$entry" | cut -d: -f6)"; \
    case "$account_home" in /home/*|/var/home/*) ;; *) \
        echo "[devcontainer] ERROR: canonical developer home is invalid" >&2; exit 1 ;; esac; \
    if [ ! -d "$account_home" ]; then \
        install -d -m 0700 -o "$user" -g "$(id -gn "$user")" "$account_home"; \
        cp -a /etc/skel/. "$account_home/"; \
        chown -R "$user:$(id -gn "$user")" "$account_home"; \
    fi; \
    sub_line="$(/usr/libexec/mios/mios-subuid-alloc --user "$user" --uid 1000)"; \
    for subfile in /etc/subuid /etc/subgid; do \
        touch "$subfile"; \
        if [ -n "$renamed_from" ]; then \
            awk -F: -v old="$renamed_from" -v new="$user" 'BEGIN { OFS=":" } $1==old { $1=new } { print }' "$subfile" > "$subfile.new"; \
            chmod 0644 "$subfile.new"; mv -f "$subfile.new" "$subfile"; \
        fi; \
        if ! awk -F: -v user="$user" '$1==user || $1=="1000" { found=1 } END { exit !found }' "$subfile"; then \
            printf '%s\n' "$sub_line" >> "$subfile"; \
        fi; \
    done; \
    /usr/libexec/mios/mios-subuid-alloc --check; \
    chage -I -1 -E -1 -M -1 -d -1 "$user"; \
    install -d -m 0755 /etc/sudoers.d; \
    install -d -m 0755 -o "$user" -g "$(id -gn "$user")" /workspaces; \
    printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$user" > /etc/sudoers.d/90-mios-devcontainer; \
    chmod 0440 /etc/sudoers.d/90-mios-devcontainer; \
    visudo -cf /etc/sudoers.d/90-mios-devcontainer; \
    sudo -n -l -U "$user" >/dev/null; \
    setpriv --reuid "$user" --regid "$(id -gn "$user")" --init-groups -- /usr/bin/true

ENV MIOS_DEVCONTAINER=1
USER 1000
WORKDIR /workspaces
CMD ["/bin/bash", "-l"]
