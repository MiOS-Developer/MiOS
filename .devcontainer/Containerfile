# The MiOS dev container IS the MiOS image. Codespaces, a local devcontainer, the
# Claude Code / Codex cloud environments and Cloud Shell all run [image].ref, the
# image every other MiOS deployment boots, so every MiOS component and feature is
# here because it is in MiOS. This file adds only what a container runtime needs
# where a booted MiOS has systemd: the /var targets tmpfiles.d and first boot
# create. It installs nothing; a component missing here is missing from MiOS and
# belongs in the OS pipeline (Containerfile, automation/, [packages.*]).
#
# Mirrored byte-identical into mios-bootstrap and -dev-loop; edit it HERE only.
# Gates: [bootstrap.sync].mirror_files via tools/sync-bootstrap.py --check (Law 15),
# tests/test_devcontainer_mirror.py in -dev-loop, and tools/ci-suites.py --check,
# which holds the ARG default equal to [image].ref and refuses any install here.
#
# `miosd image-build` ([build.images.devcontainer].build_args) passes the image it
# has just built, [image].local_tag, so a local build layers on current source.
ARG MIOS_IMAGE=ghcr.io/mios-dev/mios:latest
FROM ${MIOS_IMAGE}

# A container never boots: create the ostree /var link targets (/home, /root,
# /opt, /srv, /mnt, /usr/local) and the home of the image's own [identity] user,
# which first boot creates on a booted MiOS. That user is the devcontainer's
# remoteUser (tools/sync-dotfiles.py projects it from the same key).
RUN set -euo pipefail; \
    systemd-tmpfiles --create --prefix=/var/home --prefix=/var/roothome --prefix=/var/opt \
        --prefix=/var/srv --prefix=/var/mnt --prefix=/var/usrlocal; \
    user="$(/usr/libexec/mios/mios-toml-get identity username)"; \
    entry="$(getent passwd "$user")" \
        || { echo "[devcontainer] ERROR: [identity].username '${user}' is not a user of this MiOS image" >&2; exit 1; }; \
    home="$(printf '%s\n' "$entry" | cut -d: -f6)"; \
    if [ ! -d "$home" ]; then \
        install -d -m 0700 -o "$user" -g "$(id -gn "$user")" "$home"; \
        cp -a /etc/skel/. "$home/"; \
        chown -R "$user:$(id -gn "$user")" "$home"; \
    fi; \
    install -d -m 0755 /workspaces

ENV MIOS_DEVCONTAINER=1
WORKDIR /workspaces
CMD ["/bin/bash", "-l"]
