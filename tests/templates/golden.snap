--8<-- drift-check
# AI-hint: Drift check verifying static check for sample-test under the source-tree drift fitness-functions.
# AI-related: automation/98-drift-checks.sh
# AI-functions: check_sample-test
check_sample-test() {
    local hits=""
    if [[ -n "$hits" ]]; then
        printf '%s' "$hits" >&2
        _violation "drift violation in sample-test: static check for sample-test"
    else
        echo "[98-drift-checks] check passed: sample-test"
    fi
}
--8<-- bash-verb
#!/bin/bash
# AI-hint: Describe the capability of this bash verb script here.
# AI-related: /usr/share/mios/templates/bash-verb, /usr/share/mios/mios.toml
# AI-functions: main, parse_args, log_info, log_error

set -euo pipefail

log_info() {
    printf '[%s] INFO: %s\n' "sample-test" "$*" >&2
}

log_error() {
    printf '[%s] ERROR: %s\n' "sample-test" "$*" >&2
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done
}

show_help() {
    cat <<EOF
Usage: sample-test [options]

Options:
  -h, --help    Show this help message
EOF
}

main() {
    log_info "Initializing sample-test..."
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    parse_args "$@"
    main
fi
