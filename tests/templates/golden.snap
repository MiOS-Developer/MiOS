# AI-hint: Sibling unit test for the sample-test python module, ensuring compliance with drift-check 11.
# AI-related: /usr/lib/mios/agent-pipe/mios_pipe/sample-test.py, /usr/lib/mios/agent-pipe/test_mios_sample-test.py
# AI-functions: TestSampleTest

import unittest
from mios_pipe.sample-test import sample-test_helper

class TestSampleTest(unittest.TestCase):
    def test_helper(self):
        self.assertIsNotNone(sample-test_helper)

if __name__ == "__main__":
    unittest.main()
