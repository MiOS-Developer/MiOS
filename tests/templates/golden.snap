--8<-- systemd-unit
# AI-hint: systemd unit file for the mios-sample-test service.
# AI-related: /usr/lib/systemd/system/mios-sample-test.service, /usr/share/mios/mios.toml

[Unit]
Description=MiOS sample-test Service
After=network.target mios-pgvector.service
Wants=network.target

[Service]
Type=simple
User=mios-sample-test
Group=mios-sample-test
WorkingDirectory=/usr/lib/mios/agent-pipe
ExecStart=/usr/bin/python3 -m mios_pipe.sample-test
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
--8<-- quadlet
# AI-hint: Describe the container's purpose and its generator relation here.

[Unit]
Description=MiOS sample-test Container
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=mios-sample-test
Image=docker.io/library/sample-test:latest
Pod=mios-system.pod
User=1000
Group=1000

[Install]
WantedBy=multi-user.target default.target

[Service]
Delegate=yes
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300s
