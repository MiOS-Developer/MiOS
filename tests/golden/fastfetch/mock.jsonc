{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " \udb80\udd3e ",
    "color": {
      "keys": "blue",
      "title": "cyan",
      "separator": "yellow"
    }
  },
  "modules": [
    {
      "type": "title"
    },
    {
      "type": "separator"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "MiOS Linux (bootc/OCI workstation)"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "display",
      "key": "Display"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk"
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "key": "AI Engine",
      "format": "mios-llm-light (llama-swap :8500)"
    },
    {
      "type": "custom",
      "key": "Active Model",
      "format": "Qwen2.5-Coder-7B-Instruct-GGUF"
    },
    {
      "type": "custom",
      "key": "Mesh Nodes",
      "format": "1 (Local Node)"
    },
    {
      "type": "custom",
      "key": "Bootc Image",
      "format": "ghcr.io/mios-dev/mios:latest (sha256:7f8a91b2c3d4)"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}