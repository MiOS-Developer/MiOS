# AI-hint: GENERATED by `mios-gen render-usb-storage` from mios.toml [hardware.storage_link].usb_storage_autosuspend -- do not edit; edit the SSOT.
# AI-related: usr/share/mios/mios.toml, tools/native/mios-gen/src/usb_storage.rs
# usb_storage_autosuspend = false: a USB device exposing a mass-storage interface
# (class 08, subclass 06: bulk-only 50 or UAS 62) is never runtime-suspended, so a
# disk carrying root, swap or the journal cannot be put to sleep under load.
# ID_USB_INTERFACES comes from the usb_id builtin in 50-udev-default.rules.
ACTION=="add|bind", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:0806[56]?:*", TEST=="power/control", ATTR{power/control}="on"
