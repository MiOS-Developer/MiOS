# AI-hint: Defines the core MiOS boot-time service presets, enabling essential infrastructure like WSLg fixes, container storage permissions, firewall rules, virtualization daemons, and networking services.
# AI-related: /etc/mios/cron-rules.toml, /etc/mios/forge/runner-token, mios-role, mios-wslg-permissions-fix, mios-additionalimagestores-perms, mios-firewall-ports, mios-delegation-prefilter, mios-gpu-detect, mios-selinux-init, mios-sriov-init
# 'MiOS' systemd preset
# "enable" = on boot; "disable" = off. Role-specific services are NOT here;
# mios-role.service enables/disables them at runtime based on role.conf.

# --- Always-on core ---
# WSLg-only: chmod /mnt/wslg/runtime-dir to 0700 BEFORE weston starts,
# unblocking VAIL (shared-memory) mode. No-ops on non-WSLg
# substrates via ConditionPathIsDirectory.
enable mios-wslg-permissions-fix.service
# Boot-time chmod -R go+rX on the additionalimagestores under
# /usr/lib/containers/storage so unprivileged podman / flatpak / etc.
# can read it. Belt-and-suspenders for stale OCI images that pre-date
# the Containerfile bake-step chmod (commit a85925d). No-op when perms
# are already correct.
enable mios-additionalimagestores-perms.service
# .path companion -- self-heals if perms get reset between boots
# (e.g. operator runs `podman system reset` or pulls into the store).
enable mios-additionalimagestores-perms.path
# Same self-healing pattern for /usr/libexec/mios exec bits: a checkout of the
# deployed root / (git working tree of mios.git) without core.fileMode strips
# go+x from the libexec scripts, crash-looping every service that execs them as
# a non-owner user (203/EXEC). The .service snaps go+rX back at boot; the .path
# re-triggers within seconds if a checkout resets them again.
enable mios-libexec-perms.service
enable mios-libexec-perms.path
# Boot-time `firewall-cmd --add-port` for every MiOS service port.
# Belt-and-suspenders against stale OCI images / failed install-time
# 25-firewall-ports.sh runs that leave firewalld without the ports
# open, silently breaking ALL Windows->WSL bridging (3033/8642/8899/
# 9090). Idempotent.
enable mios-firewall-ports.service
enable sshd.service
enable NetworkManager.service
enable podman.socket
enable podman-auto-update.timer
enable libvirtd.socket
enable virtnetworkd.socket
enable virtqemud.socket
enable virtstoraged.socket
enable virtnodedevd.socket
enable virtnwfilterd.socket
enable virtsecretd.socket
enable virtproxyd.socket
enable uupd.timer
enable nvidia-cdi-refresh.path
enable nvidia-cdi-refresh.service
enable nvidia-persistenced.service
enable firewalld.service
enable nut-server.service
enable nut-monitor.service
enable chronyd.service
enable systemd-resolved.service
# avahi (mDNS/DNS-SD) backs FED-G5 LAN A2A peer discovery + announce. Enabling the
# daemon is INERT for A2A until the operator opts in via mios.toml [a2a].mdns_discovery
# / mdns_advertise (both default false); mios-aios-refresh drives the browse/advertise.
# Package is [packages.network-discovery] (avahi + avahi-tools + nss-mdns).
enable avahi-daemon.service
enable pmcd.service
enable pmlogger.service
enable pmproxy.service
enable bootloader-update.service
# Standard cron + at daemons (cronie + at, ProvideS /etc/cron.* +
# crontab + atq/atd). Hermes-Agent has its own in-process cronjob
# tool, but anything operators or agents schedule OUTSIDE the
# gateway -- shell scripts, system jobs, one-shot 'at' runs --
# expects these. Operator directive 2026-05-15.
enable crond.service
enable atd.service
enable mios-role.service
enable mios-luks-enroll.service
enable mios-gpu-detect.service
enable mios-selinux-init.service
enable mios-sriov-init.service
enable mios-cdi-detect.service
enable mios-libvirtd-setup.service
enable mios-grd-setup.service
# Hyper-V Enhanced Session bring-up: hv_sock module + hv-kvp-daemon +
# hv-vss-daemon + hv-fcopy-daemon + xrdp on the VMBus vsock transport.
# ConditionVirtualization=microsoft inside the unit gates the actual
# work to Hyper-V hosts; on every other deployment shape (bare-metal,
# WSL2, QEMU, VirtualBox) the unit no-ops at the systemd condition
# check. Safe to enable everywhere.
enable mios-hyperv-enhanced.service
enable systemd-sysext.service
enable systemd-confext.service
enable mios-dashboard-issue.service
enable mios-dashboard-issue.timer
enable mios-bootc-switch.path
enable gnome-remote-desktop.service
enable mios-firstboot.target
# /=git auto-init: turns / into a git working tree of the operator's
# Forgejo mios.git repo on first boot, after mios-forge-firstboot has
# created the admin user. Idempotent (sentinel = /.git presence).
enable mios-git-root-init.service
enable greenboot-healthcheck.service
enable greenboot-grub2-set-counter.service
enable greenboot-grub2-set-success.service
enable greenboot-rpm-ostree-grub2-check-fallback.service
enable greenboot-status.service
enable redboot-auto-reboot.service
enable cockpit.socket
enable mios-cockpit-link.socket
enable mios-cockpit-link.service
enable mios-searxng.service
enable mios-crawl4ai.service
enable mios-hermes-firstboot.service
enable mios-agent-pipe.service
enable mios-opencode-gateway.service
# Headless ChromeDev with CDP on :9222 -- backs Hermes's browser tool
# (operator directive 2026-05-15). Service ConditionPathExists-gates
# on the ChromeDev flatpak being present, so it no-ops cleanly on
# hosts that haven't installed it.
enable mios-hermes-browser.service
# P1 (operator 2026-06-19): SECOND non-thin Hermes WORKER on :8643 -- a real
# agent that runs its OWN native browser/CDP/terminal/skills tool loop with its
# OWN inference on the heavy lane (:11441 mios-heavy). Fully isolated from the
# thin :8642 Discord gateway (separate HERMES_HOME, NO Discord token). This is
# the WORKER-DISPATCH target of [agents.hermes].endpoint (:8643). Its dedicated
# CDP browser (:9223, profile-w2) so it never stomps the primary :9222 browser.
enable hermes-worker-firstboot.service
enable hermes-worker.service
enable hermes-worker.path
enable mios-hermes-browser-worker.service
# System-wide flatpak override policy: every installed flatpak
# inherits read+write access to the operator's XDG user dirs
# (~/Documents, ~/Pictures, ~/Videos, ~/Downloads, ...). Operator
# directive 2026-05-15: agent-installable flatpaks should Just Work
# against /var/home/mios/* by default. One-shot, idempotent.
enable mios-flatpak-init.service
# Background log triage: micro-LLM (qwen3:0.6b) classifies journal
# events in 30s batches. Cheap (<30s CPU/hour). Operator directive
# 2026-05-15: "background micro-llm could be a daemon for logs and
# log collection and presenting".
enable mios-log-watcher.service
# LLM-gated scheduler: reads /etc/mios/cron-rules.toml, asks the
# micro-LLM "should this fire now given current state?" for any
# rule with a gate. Operator directive 2026-05-15.
enable mios-cron-director.service
# Tails hermes-agent.service journal, regex-matches the SOUL.md
# forbidden-phrase list, micro-LLM confirms YES/NO, logs alerts to
# /var/lib/mios/agent-nudger/. Operator directive 2026-05-15:
# "the micro-llm should be intercepting these failure logs and
# nudging".
enable mios-agent-nudger.service
# sys_env environment cache: keep the shared snapshot (installed apps /
# services / HW) warm on the timer's 15-min cadence so sys_env reads are
# fast + current (the manual sys_env_refresh verb covers "I just installed
# X"). Ships disabled-by-default in systemd; this preset turns it on.
enable mios-sys-env-refresh.timer
enable mios-open-webui.service
# mios-code-server RETIRED: superseded by mios-agents (code-server + Claude + agy +
# tmux + mios-a2o) on the SAME MIOS_PORTS_CODE_SERVER. Disabled so no duplicate IDE
# service runs. The [containers.mios-code-server.*] def remains inert in mios.toml.
disable mios-code-server.service
# A2O agents super-container = the single code-server IDE (Claude CLI + agy/Gemini +
# tmux war room), on MIOS_PORTS_CODE_SERVER. ExecStartPre builds localhost/mios-agents:latest
# from /usr/share/mios/agents/Containerfile on first deploy; the deployed root / is the
# workspace so agents develop MiOS from within itself.
enable mios-agents.service
# Forge bootstrap: admin user + initial repo + runner registration token
# all minted on first boot. mios-forgejo-runner reads the token and
# self-registers; without firstboot enabled the runner stays inactive
# (ConditionPathExists=/etc/mios/forge/runner-token never satisfied).
enable mios-forge.service
enable mios-forge-firstboot.service
enable mios-forgejo-runner-firstboot.service
enable mios-forgejo-runner.service
# user@1000.service starts the per-user systemd manager + user D-Bus
# session bus for the 'mios' user (uid 1000, pinned in
# /usr/lib/sysusers.d/10-mios.conf). Normally systemd-logind reads
# /var/lib/systemd/linger/mios and starts this; on WSL2 logind is
# ConditionVirtualization=!wsl-gated, so we enable the template
# directly so the user bus exists regardless of logind. This is what
# eliminates the boot-time "Failed to connect to system scope bus
# via local transport" error from `wsl -d MiOS` and lets `wsl -- foo`
# reach the user D-Bus.
enable user@1000.service
enable usbguard.service
enable auditd.service
enable crowdsec.service
enable crowdsec-firewall-bouncer.service
enable nftables.service
# AdGuard Home DNS sinkhole (ad/tracker/malware DOMAIN blocking) + its first-boot
# config generator. Complements CrowdSec's malicious-IP firewalling above. Binds
# loopback by default (safe no-op until resolv.conf / the Tailscale global
# nameserver points at it); the generator adds the tailnet bind when Tailscale
# is up. See [adguard] in mios.toml.
enable mios-adguard-firstboot.service
enable mios-adguard.service
enable mios-mcp.service
enable redis.service
enable cloud-init.service
enable cloud-final.service
enable qemu-guest-agent.service

# --- WSL2 fallback & initialization (ConditionVirtualization=wsl gated) ---
# mios-wsl-early MUST stay first: it makes / rshared and creates
# /dev/{net/tun,fuse} before any unit with sandboxing or rootless
# podman fires. Without it, cockpit fails 226/NAMESPACE and every
# Quadlet fails fuse-overlayfs/slirp4netns at boot.
enable mios-wsl-early.service
enable mios-wsl-firstboot.service
enable mios-wsl-init.service
enable mios-wsl-runtime-dir.service
enable mios-wsl-interop-priority.service
# (dbus-daemon-wsl.service was removed entirely -- dbus-broker now runs
# on WSL via 10-mios-no-audit.conf, and the legacy /usr/bin/dbus-daemon
# binary is not shipped on Fedora CoreOS 44.)

# --- First-boot AI plane provisioning (sentinel-guarded) ---
# The OCI build's final /var cleanup wipes the agent venv + llama.cpp GGUFs, so
# on any non-baked deployment (overlay-provisioned dev VM, WSL import) the AI
# plane must provision post-deploy. mios-ai-firstboot also runs the pgvector
# default-account/identity seeding (step 2e). Both units carry
# [Install] WantedBy=multi-user.target but nothing Wants= them, and Fedora bootc
# disables any unit not matched by an 'enable' line -> without these two the AI
# plane is silently DEAD on first boot (the enable lines were dropped here).
enable mios-ai-firstboot.service
# The timer OWNS retry: it re-fires mios-ai-firstboot.service (~10min cadence)
# until the sentinel lands, so the service degrades open (exit 0) instead of a
# Restart=on-failure crash-loop that would hold the AI plane hostage behind a
# multi-GB model download.
enable mios-ai-firstboot.timer
enable mios-swarm-pack-firstboot.service
# FBM (task_180): first-boot large-model + bound-image provisioners. Both sentinel-guarded and
# degrade-open (Law 12); no-op when [ai].firstboot_models / firstboot_bound_images are empty.
enable mios-models-firstboot.service
enable mios-shell-session-gc.timer
enable mios-bound-images-firstboot.service

# --- Disabled in favor of uupd ---
disable bootc-fetch-apply-updates.timer
disable rpm-ostreed-automatic.timer

# --- Broken with composefs on F42+ ---
disable systemd-remount-fs.service

# --- Role-gated: default-off; mios-role.service turns on as appropriate ---
disable libvirtd.service
disable libvirtd-ro.socket
disable libvirtd-admin.socket
disable virtnetworkd.service
disable virtnodedevd.service
disable virtqemud.service
disable virtstoraged.service
disable gdm.service
disable k3s.service
disable k3s-agent.service
disable corosync.service
disable pacemaker.service
disable ceph-mon@.service
disable ceph-osd@.service

# --- Optional / Fail-silent (default disabled) ---
enable fapolicyd.service
disable tailscaled.service
disable mios-pxe-hub.service
disable waydroid-container.service
disable smb.service
disable nmb.service
disable nfs-server.service
disable rpcbind.service
disable libvirt-guests.service
disable mios-ha-bootstrap.service
disable osbuild-composer.service
disable osbuild-worker@1.service
disable multipathd.service
disable cloud-init-local.service
disable cloud-config.service
