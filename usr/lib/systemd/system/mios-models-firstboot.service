# AI-hint: Provision and verify the layered Day-0 light-lane fleet and optional models; retry incomplete downloads through the timer.
# AI-related: /usr/libexec/mios/mios-models-firstboot, mios-models-firstboot.timer
[Unit]
Description=First-boot model provisioner
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/mios/.models-firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/mios-models-firstboot
TimeoutStartSec=10800

[Install]
WantedBy=multi-user.target
