# AI-hint: Systemd service unit for the RFC 9334 remote-attestation verifier that checks TPM 2.0 quotes and onboards blades into the cluster.
# AI-doc: usr/share/doc/mios/manual/ch76-remote-attestation.md
# AI-related: usr/libexec/mios/mios-attest-server

[Unit]
Description=MiOS RFC 9334 RATS Remote TPM 2.0 Quote Verifier and Zero-Touch Cluster Onboarding Daemon
Documentation=file:///usr/share/doc/mios/manual/ch76-remote-attestation.md
After=network.target
# Ruling Q7 (task_3539): condition mios-attest-server off until Keylime replaces it
ConditionPathExists=/usr/share/doc/mios/keylime-ready

[Service]
Type=simple
ExecStart=/usr/libexec/mios/mios-attest-server serve
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
