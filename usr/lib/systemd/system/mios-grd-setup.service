# AI-hint: Legacy unit for /usr/libexec/mios-grd-setup (GRD TLS material only; never opens firewall ports). Obsolete: disabled in 90-mios.preset and not wanted by mios-firstboot.target; remote desktop is [remote.rdp] (xrdp via mios-rdp).
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' GNOME Remote Desktop Setup
ConditionVirtualization=!container
After=local-fs.target network-online.target gdm.service
Wants=network-online.target
ConditionPathExists=!/var/lib/mios/.grd-init-done
[Service]
Type=oneshot
ExecStart=/usr/libexec/mios-grd-setup
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
