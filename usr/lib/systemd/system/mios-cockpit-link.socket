# AI-hint: Native Cockpit public and discovery listeners projected from the canonical ports.
# AI-related: usr/lib/systemd/system/mios-cockpit-link.service
[Unit]
Description='MiOS' Cockpit Link Proxy Socket
ConditionVirtualization=!container
After=mios-selinux-init.service
Requires=mios-selinux-init.service

[Socket]
ListenStream=0.0.0.0:8110
ListenStream=0.0.0.0:8120
BindIPv6Only=both

[Install]
WantedBy=sockets.target
