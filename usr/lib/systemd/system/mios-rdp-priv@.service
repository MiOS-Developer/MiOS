[Unit]
Description=MiOS RDP root helper (one request from the native RDP server)
Documentation=file:///usr/libexec/mios/rdp-native

# CAP_SYS_PTRACE: TLS-KEY authorizes the caller by readlink(/proc/<pid>/exe) of the operator-owned
# mios-rdp-server; root may read another uid's exe link only with it (without it: "exe None", DENY,
# native server crash loop). ptrace(2) stays blocked (@debug is not in @system-service), and the
# process_vm_* calls the capability would unlock are removed from @ipc above.
[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/rdp-native/mios-rdp-priv
StandardOutput=journal
StandardError=journal
TimeoutStartSec=20
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/faillock /run/mios /var/lib/mios-rdp
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~process_vm_readv process_vm_writev
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_AUDIT_WRITE CAP_SETUID CAP_SETGID CAP_SYS_PTRACE
