# AI-hint: systemd timer that re-runs mios-credential-apply.service so a credential changed in mios.html reaches every admin surface within one interval.
# AI-related: /usr/lib/systemd/system/mios-credential-apply.timer, /usr/lib/systemd/system/mios-credential-apply.service, /usr/share/mios/mios.toml
[Unit]
Description='MiOS' operator credential reconcile schedule

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s

[Install]
WantedBy=timers.target
