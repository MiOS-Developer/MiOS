# AI-hint: Validates the selected light inference backend and projects verified device access before the lane starts.
# AI-related: tools/native/mios-gen/src/gpu_topology.rs, usr/share/containers/systemd/mios-llm-light.container
[Unit]
Description='MiOS' validated light inference backend projection
After=mios-cdi-detect.service
Wants=mios-cdi-detect.service
Before=mios-llm-light.service

[Service]
Type=oneshot
RuntimeDirectory=mios/light-backend
RuntimeDirectoryPreserve=yes
RemainAfterExit=no
ExecStart=/usr/bin/mios-gen light-backend --apply --reload
