# AI-hint: Systemd unit file that manages the ttyd service to provide a browser-accessible bash shell via WebSockets, mapping a terminal session to the mios user's environment.
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' ttyd -- browser pty bridge (Linux bash session)
Documentation=file:///usr/libexec/mios/mios-ttyd-launch
After=network-online.target mios-credential-apply.service
Wants=network-online.target mios-credential-apply.service
# Fedora's ttyd RPM installs to /usr/sbin/ttyd; on other distros
# (or after a future Fedora reshuffle) it may land in /usr/bin/.
# Either path satisfies the condition.
ConditionPathExistsGlob=/usr/?bin/ttyd

[Service]
Type=simple
EnvironmentFile=-/etc/mios/userenv.sh
EnvironmentFile=-/etc/mios/install.env
# Run as the operator login user so the session inherits the
# operator's $HOME, environment, and shell rc files. Connecting
# from a browser gives the SAME shell experience as the operator's
# WSL terminal.
User=mios
Group=mios
# ttyd's OWN login (never the operator credential: ttyd takes it on argv, which every
# local uid can read in /proc), written to /run/credstore by mios-credential-apply.service
# (root); mios-credential exec ttyd reads only $CREDENTIALS_DIRECTORY.
ImportCredential=mios.ttyd.password
ImportCredential=mios.ttyd.user
ExecStart=/usr/libexec/mios/mios-ttyd-launch bash

Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s

# Hardening: ttyd doesn't need elevated privs. Lock down what the
# pty subprocess can touch beyond the user's own files.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Operator's home + /var/home (where the actual home lives on
# bootc deployments) MUST be writable so bash works normally.
ReadWritePaths=/var/home /home /tmp /var/tmp

[Install]
WantedBy=multi-user.target
