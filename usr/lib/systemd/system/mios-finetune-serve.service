# AI-hint: Systemd unit to host the fine-tuned refiner model as an OpenAI /v1-compatible endpoint on port 11438, allowing the agent-pipe to swap between the high-quality transformer-served adapter and the faster llama.cpp path.
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' fine-tune serve (base+adapter refiner backend)
After=network-online.target
Wants=network-online.target
# The interpreter is the operator-built venv (usr/share/mios/finetune/requirements.txt), never
# baked: without it the unit is skipped instead of failing 203/EXEC every RestartSec.
ConditionPathExists=/var/lib/mios/finetune/venv/bin/python

[Service]
Type=simple
User=mios
Group=mios
Environment=HF_HOME=/var/home/mios/.cache/huggingface
Environment=MIOS_FINETUNE_SERVE_PORT=11438
ExecStart=/var/lib/mios/finetune/venv/bin/python /usr/libexec/mios/mios-finetune-serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# model load + first request can take ~40s on a cold GPU
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
