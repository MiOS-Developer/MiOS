# AI-hint: Systemd timer for hourly CephFS atomic subvolume snapshotting and retention management (task_738).
# AI-related: usr/lib/systemd/system/mios-ceph-snap.service, usr/libexec/mios/mios-ceph-snap

[Unit]
Description=Periodic CephFS Subvolume Snapshot Timer
Documentation=file:///usr/share/doc/mios/manual/ch66-v5-authority-inversion-and-cephfs-tiering.md

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
