# AI-hint: Systemd service unit executing the mios-node distributed edge micro-node daemon.
# AI-related: usr/share/containers/systemd/mios-node.container, automation/55-native-build.sh
[Unit]
Description=MiOS ('My OS') Distributed Edge Micro-Node Runtime Daemon
Documentation=man:mios-node(1) file:///usr/share/mios/docs/mios_engineering_master_docs.md
After=network-online.target mios-pgvector.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/mios-node run --node-id 101 --port ${MIOS_PORTS_NODE}
Restart=always
RestartSec=5s
Environment=MIOS_PORTS_NODE=8650
Environment=MIOS_AI_ENDPOINT=http://127.0.0.1:8700/v1
Environment=MIOS_LOG_LEVEL=info
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
