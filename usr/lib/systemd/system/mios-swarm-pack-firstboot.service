[Unit]
Description='MiOS' swarm small-model pack arming (gpu_profile=swarm only)
After=network-online.target mios-cdi-detect.service mios-ai-firstboot.service
Wants=network-online.target
# Don't even try before the agent stack's prerequisites; the script is idempotent.

# Each worker has its own bounded readiness deadline; allow multiple nodes to finish sequentially.
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/mios/mios-swarm-pack-firstboot
TimeoutStartSec=infinity
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
