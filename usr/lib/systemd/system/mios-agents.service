# AI-hint: Runs the mios-agents A2O super-container (code-server IDE + tmux war room + Claude CLI + agy/Gemini + the mios-a2o muxer) as a systemd-managed container.
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' A2O agents super-container (Claude + agy/Gemini + tmux war room + code-server)
Documentation=https://github.com/mios-dev/MiOS/blob/main/usr/share/mios/agents/ACTIVATION.md
After=network-online.target podman.socket
Wants=network-online.target
ConditionPathExists=/usr/share/mios/agents/Containerfile

[Service]
Type=simple
# systemd does NOT expand bash ${VAR:-default} in ExecStart -- it resolves to
# empty (code-server then dies "Invalid URL"). Set the defaults here; install.env
# (the mios.toml -> env SSOT bridge) overrides them when present. ExecStart uses
# plain ${VAR}.
Environment=MIOS_PORTS_CODE_SERVER=8900
Environment=MIOS_IDENTITY_DEFAULT_PASSWORD=mios
# install.env is bare KEY=value; these four values carry a space, parentheses
# or a {} placeholder, so they never reach it. ExecStart references each one
# bare and the renderer leaves a bare ref for systemd, which expands an unset
# name to empty. Declaring them here is the supply (task_3362).
Environment="MIOS_FRONTIER_LANE_B_MODEL=Gemini 3.5 Flash (High)"
Environment="MIOS_FRONTIER_CLAUDE_EFFORT_FLAG=--effort {e}"
Environment="MIOS_A2O_AGY_EFFORT_FLAG="
Environment="MIOS_A2O_GEMINI_EFFORT_FLAG="
EnvironmentFile=-/etc/mios/install.env
TimeoutStartSec=1200s
# Build the local super-container image on first deploy (idempotent no-op after).
ExecStartPre=/usr/libexec/mios/mios-agents-firstboot.sh
# Run it in the foreground under systemd (auto-restart + auto-start every boot).
# --network=host + MIOS_PORTS_CODE_SERVER mirrors the MiOS host-net service convention;
# / is bind-mounted as the workspace; /var/lib/mios/agents persists /home/coder
# (agy/claude credentials + war-room state) across restarts.
ExecStart=/usr/sbin/podman run --replace --name mios-agents \
  --network=host \
  --env PASSWORD=${MIOS_IDENTITY_DEFAULT_PASSWORD} \
  --env MIOS_A2O_ENGINE=agy \
  --env MIOS_A2O_WORK=/mnt/mios-root \
  --env MIOS_FRONTIER_ORCH_ENGINE=${MIOS_FRONTIER_ORCH_ENGINE} \
  --env MIOS_FRONTIER_ORCH_MODEL=${MIOS_FRONTIER_ORCH_MODEL} \
  --env MIOS_FRONTIER_ORCH_EFFORT=${MIOS_FRONTIER_ORCH_EFFORT} \
  --env MIOS_FRONTIER_LANE_A_ENGINE=${MIOS_FRONTIER_LANE_A_ENGINE} \
  --env MIOS_FRONTIER_LANE_A_MODEL=${MIOS_FRONTIER_LANE_A_MODEL} \
  --env MIOS_FRONTIER_LANE_A_EFFORT=${MIOS_FRONTIER_LANE_A_EFFORT} \
  --env MIOS_FRONTIER_LANE_B_ENGINE=${MIOS_FRONTIER_LANE_B_ENGINE} \
  --env MIOS_FRONTIER_LANE_B_MODEL=${MIOS_FRONTIER_LANE_B_MODEL} \
  --env MIOS_FRONTIER_LANE_B_EFFORT=${MIOS_FRONTIER_LANE_B_EFFORT} \
  --env MIOS_FRONTIER_CLAUDE_EFFORT_FLAG=${MIOS_FRONTIER_CLAUDE_EFFORT_FLAG} \
  --env MIOS_A2O_AGY_EFFORT_FLAG=${MIOS_A2O_AGY_EFFORT_FLAG} \
  --env MIOS_A2O_GEMINI_EFFORT_FLAG=${MIOS_A2O_GEMINI_EFFORT_FLAG} \
  --volume /var/lib/mios/agents:/home/coder:rw \
  localhost/mios-agents:latest \
  --bind-addr ${MIOS_NETWORK_LOOPBACK:-127.0.0.1}:${MIOS_PORTS_CODE_SERVER:-8900} /home/coder
ExecStop=/usr/sbin/podman stop -t 10 mios-agents
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# ProtectSystem=strict makes /var read-only, so every path the firstboot script
# and podman write is listed here. /var/lib/mios/agents is NOT a StateDirectory=:
# this unit runs as root, and StateDirectory= would recursively chown the
# coder home to root on every start. Its owner and mode belong to
# usr/lib/tmpfiles.d/mios-agents.conf alone (task_3432).
ReadWritePaths=/var/lib/mios/agents /var/lib/containers /run

[Install]
WantedBy=multi-user.target default.target