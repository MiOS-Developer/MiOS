# AI-hint: Oneshot that merges the Portal's queued credential saves into the operator tier and re-applies the one mios.html login to the Portal, Forgejo, code-server, Open WebUI and the Linux login (ttyd gets its own), at boot and from its timer.
# AI-related: /usr/libexec/mios/mios-credential, /usr/lib/mios/mios_credentials.py, mios-credential-apply.timer, mios-agent-pipe.service, mios-agents.service, mios-ttyd-bash.service, mios-forge.service
[Unit]
Description='MiOS' operator credential reconciler (mios.html -> Portal, Forge, code-server, ttyd, Open WebUI, Linux login)
Documentation=file:///usr/libexec/mios/mios-credential
After=local-fs.target
Before=mios-agent-pipe.service mios-agents.service mios-ttyd-bash.service mios-ttyd-powershell.service

[Service]
# No RemainAfterExit: the timer re-runs this unit, and an active unit cannot be re-triggered.
# --verify re-proves the Forgejo login, so a recreated forge database is repaired too.
Type=oneshot
ExecStart=/usr/libexec/mios/mios-credential apply --all --verify
TimeoutStartSec=300s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# No ProtectHome=: the operator's ~/.config/mios/mios.toml IS the input, and systemd ranks a
# ProtectHome= mount above a ReadWritePaths= entry for the same path, so the inbox merge (which
# drops to the operator's uid before it writes) could never write it. ProtectSystem=strict keeps
# every home read-only except through ReadWritePaths=.
# /run: the Portal's credstore, the inbox, rootful `podman exec`; /var/lib/mios/credential-apply:
# the HMAC ledger; /var/lib/mios/agents: code-server config.yaml (written as its owner);
# /etc: chpasswd (the Linux login) and /etc/mios (secrets.env scrub, the Open WebUI receipt);
# /.git: stripping userinfo from the deployed root's origin URL.
ReadWritePaths=/run /var/lib/mios/credential-apply -/var/lib/mios/agents -/var/lib/mios/open-webui /var/lib/containers /etc -/var/home -/home -/.git

[Install]
WantedBy=multi-user.target
