# AI-hint: Root oneshot writing a world-readable JSON snapshot of all podman containers for non-root readers (agent-pipe, dashboard, SSH users), then, whatever podman returned, the Portal status view's deployed-spec snapshot.
# AI-related: /usr/lib/mios/agent-pipe/mios_pipe/portal_spec.py, /usr/lib/mios/agent-pipe/mios_pipe/portal_status.py, mios-podman-ps.timer, mios.toml [portal.status]
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' rootful podman snapshot for the agent-pipe portal/dashboard
Documentation=file:///usr/lib/mios/agent-pipe/server.py
After=podman.socket
Wants=podman.socket

# The root-only `podman ps` snapshot for non-root readers (manual/system.md), then
# the Portal status spec.json as ExecStopPost=-, run whatever podman returned; -P keeps
# / off sys.path. 2 x [portal.status].probe_timeout_s < TimeoutStopSec (portal_spec._cfg).
[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/bin/podman ps -a --format json > /var/lib/mios/podman-ps.json.tmp 2>/dev/null && mv -f /var/lib/mios/podman-ps.json.tmp /var/lib/mios/podman-ps.json && chmod 0644 /var/lib/mios/podman-ps.json'
Environment=PYTHONPATH=/usr/lib/mios/agent-pipe:/usr/lib/mios
ExecStopPost=-/usr/lib/mios/agents/.venv/bin/python3 -P -m mios_pipe.portal_spec --write-spec
TimeoutStopSec=60s

[Install]
WantedBy=multi-user.target
