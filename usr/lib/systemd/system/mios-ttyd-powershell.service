# AI-hint: Systemd unit that launches a ttyd-wrapped PowerShell session via WSL interop, providing a browser-accessible interactive pwsh.exe terminal on port 7682 for the operator.
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' ttyd -- browser pty bridge (Windows PowerShell session)
Documentation=file:///usr/libexec/mios/mios-ttyd-launch
After=network-online.target mios-credential-apply.service
Wants=network-online.target mios-credential-apply.service
# Fedora's ttyd RPM installs to /usr/sbin/ttyd; either path is OK.
ConditionPathExistsGlob=/usr/?bin/ttyd
# Defer to mios-ttyd-bash.service ordering only for log clarity;
# the two are independent.

[Service]
Type=simple
EnvironmentFile=-/etc/mios/userenv.sh
EnvironmentFile=-/etc/mios/install.env
# Run as the operator -- WSL interop's /init creates per-user
# Windows interop sockets, so the agent service-user contexts
# CAN'T exec /mnt/c/Windows/System32/powershell.exe (operator-
# confirmed 2026-05-15 in mios-as-operator.sh's perm wall note).
# The browser session is the operator's anyway -- single tenant.
User=mios
Group=mios
# ttyd's OWN login (never the operator credential: ttyd takes it on argv, which every
# local uid can read in /proc), written to /run/credstore by mios-credential-apply.service
# (root); mios-credential exec ttyd reads only $CREDENTIALS_DIRECTORY.
ImportCredential=mios.ttyd.password
ImportCredential=mios.ttyd.user
ExecStart=/usr/libexec/mios/mios-ttyd-launch powershell

Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Needs to reach /mnt/c via WSL's mount tree -- can't ProtectHome=
# without breaking the interop.
ReadWritePaths=/var/home /home /tmp /var/tmp /mnt

[Install]
WantedBy=multi-user.target
