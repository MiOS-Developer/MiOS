# AI-hint: Native Cockpit proxy for the configured public and discovery listeners; the socket owns both bindings.
# AI-related: usr/lib/systemd/system/mios-cockpit-link.socket
[Unit]
Description='MiOS' Cockpit Link Proxy Service
After=network.target cockpit.socket mios-cockpit-link.socket mios-selinux-init.service
Requires=cockpit.socket mios-cockpit-link.socket mios-selinux-init.service
ConditionVirtualization=!container

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:9090
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
