# AI-hint: Ordered-before oneshot that lets the pgvector image float across PostgreSQL majors -- it dumps an older cluster with the older image into the initdb restore slot and stashes the old data dir so the new major can initialise, and...
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' pgvector PostgreSQL-major migration guard
Documentation=file:///usr/lib/systemd/system/mios-pgvector-major-upgrade.service
# Must settle the data dir BEFORE the container touches it.
Before=mios-pgvector.service
# Same virtualization guard as the pgvector container itself.
ConditionVirtualization=|!container
ConditionVirtualization=|wsl

[Service]
Type=oneshot
RemainAfterExit=yes
# SSOT env: MIOS_PGVECTOR_IMAGE / MIOS_PGVECTOR_DATA_DIR / MIOS_PGVECTOR_RESTORE_SQL /
# MIOS_PGVECTOR_USER / MIOS_PGVECTOR_DB all flow from mios.toml [pgvector] + [image.sidecars]
# -> userenv.sh. '-' tolerates absence (the script defaults every knob inline).
EnvironmentFile=-/etc/mios/userenv.sh
# Root because it must podman-run the old-major image and move a 0750 data dir.
ExecStart=/usr/libexec/mios/mios-pgvector-major-upgrade
ProtectHome=true
PrivateTmp=true

[Install]
# Pulled in by pgvector itself, so it cannot be skipped when the DB starts.
WantedBy=mios-pgvector.service multi-user.target
