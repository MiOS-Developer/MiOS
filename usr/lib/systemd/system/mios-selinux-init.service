# AI-hint: Reconciles upgrade-sensitive Cockpit SELinux policy before the legacy first-boot policy initialization.
[Unit]
Description='MiOS' SELinux Policy Loader
ConditionVirtualization=!container
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target
ConditionPathExists=/usr/share/selinux/packages/mios

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/selinux-init
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
