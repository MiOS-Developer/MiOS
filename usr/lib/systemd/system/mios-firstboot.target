# AI-hint: Defines the mios-firstboot.target unit to orchestrate initial provisioning services (CDI and libvirtd setup; GRD setup is obsolete, remote desktop is [remote.rdp]) during the first boot sequence of the MiOS system.
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' first-boot provisioning
Documentation=https://github.com/mios-dev/MiOS
After=multi-user.target
Wants=mios-cdi-detect.service mios-libvirtd-setup.service

[Install]
WantedBy=multi-user.target