[Unit]
Description=MiOS native global input controller bridge
PartOf=mios-desktop.target
After=graphical-session.target mios-gamepad-hypr3d.service
Conflicts=mios-gamepad-hypr3d.service
ConditionFileIsExecutable=/usr/libexec/mios/mios-inputd
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/libexec/mios/mios-inputd check
ExecStart=/usr/libexec/mios/mios-inputd serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=mios-desktop.target
