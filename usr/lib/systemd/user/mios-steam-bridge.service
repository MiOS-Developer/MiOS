[Unit]
Description=MiOS Steam Notification Bridge
PartOf=mios-desktop.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/libexec/mios/mios-steam-notify-bridge
KillMode=process
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=mios-desktop.target
