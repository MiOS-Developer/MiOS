[Unit]
Description=MiOS Quickshell desktop surfaces
PartOf=mios-desktop.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/quickshell --no-duplicate --path /usr/share/mios/quickshell/Config.qml
KillMode=process
Restart=on-failure
RestartSec=2

[Install]
WantedBy=mios-desktop.target
