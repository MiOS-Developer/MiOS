[Unit]
Description=MiOS shared Windows and Linux living wallpaper
PartOf=mios-desktop.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/mios-wallpaperd host
Restart=always
RestartSec=5
TimeoutStopSec=10
StartLimitIntervalSec=300
StartLimitBurst=20

[Install]
WantedBy=mios-desktop.target
