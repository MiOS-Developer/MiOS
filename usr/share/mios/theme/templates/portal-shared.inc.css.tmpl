/* AI-hint: MiOS-Portal chrome CSS, baked into omni.ja: Surfer's theme include patch makes
   browser-shared.css %include this file. MiOS glass from [colors]/[theme.shell], and the sketch
   layout (tabs left, chat right, chat auto-hide with a peek strip, no window controls) gated by the
   mios.portal.* prefs that [desktop.portal.gecko.layout] sets. Rendered by mios-dotfiles-render.
   AI-related: usr/share/mios/mios.toml,
   src/mios-portal/install/browser/defaults/preferences/mios-portal.js, src/mios-portal/src/browser/themes/shared/ */

:root, #main-window {
  color-scheme: dark !important;
  --mios-chrome-fill: color-mix(in srgb, @MIOS:bg@ @MIOS:theme.shell.fill_opacity_pct@%, transparent);
  --mios-chrome-outline: color-mix(in srgb, @MIOS:subtle@ @MIOS:theme.shell.outline_opacity_pct@%, transparent);
  --mios-chrome-radius: @MIOS:desktop.hyprland.config.decoration.rounding@px;
  --lwt-accent-color: transparent !important;
  --lwt-text-color: @MIOS:fg@ !important;
  --toolbox-bgcolor: transparent !important;
  --toolbox-bgcolor-inactive: transparent !important;
  --toolbar-bgcolor: var(--mios-chrome-fill) !important;
  --toolbar-color: @MIOS:fg@ !important;
  --toolbar-field-background-color: var(--mios-chrome-fill) !important;
  --toolbar-field-color: @MIOS:fg@ !important;
  --focus-outline-color: @MIOS:cursor@ !important;
  --tab-selected-bgcolor: color-mix(in srgb, @MIOS:cursor@ @MIOS:theme.shell.outline_opacity_pct@%, transparent) !important;
  --sidebar-background-color: transparent !important;
  --sidebar-text-color: @MIOS:fg@ !important;
  --sidebar-border-color: transparent !important;
  --sidebar-divider-color: var(--mios-chrome-outline) !important;
}

/* Glass: the window and the page stack are transparent (browser.tabs.allow_transparent_browser),
   so Hyprglass shows through; toolbars and sidebars take the shell glass fill. */
#main-window, #browser, #tabbrowser-tabbox, #tabbrowser-tabpanels, .browserContainer, .browserStack, browser {
  background-color: transparent !important;
}
#navigator-toolbox, #sidebar-container, sidebar-main, #sidebar-box, #sidebar-header {
  background-color: transparent !important;
  color: @MIOS:fg@ !important;
}

/* Diagram layout (IMG_0231.JPG):
   1) Webpages (#tabbrowser-tabbox) fill 100% of the Portal window frame edge-to-edge (0..100vw, 0..100vh).
   2) Left MiOS Sidebar (#sidebar-container / sidebar-main) floats over the left edge, uses Hyprglass frosted blur,
      and scales dynamically in height with tab-count / pane-count rather than stretching full window height.
   3) Right Smart Window Chat (#sidebar-box) floats over the right edge with Hyprglass frosted blur. */
#navigator-toolbox:not(:focus-within) {
  max-height: 0 !important;
  min-height: 0 !important;
  height: 0 !important;
  overflow: hidden !important;
  border: none !important;
  margin: 0 !important;
  padding: 0 !important;
  opacity: 0 !important;
  pointer-events: none !important;
}
#TabsToolbar, #PersonalToolbar, #sidebar-header {
  display: none !important;
}

/* No window controls: minimise/maximise/close belong to the shell. */
@media -moz-pref("mios.portal.hide-window-controls") {
  .titlebar-buttonbox-container, .titlebar-spacer {
    display: none !important;
  }
}

#browser {
  position: relative !important;
  width: 100vw !important;
  height: 100vh !important;
  overflow: hidden !important;
}

#tabbrowser-tabbox {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  max-width: 100vw !important;
  max-height: 100vh !important;
  margin: 0 !important;
  padding: 0 !important;
  z-index: 1 !important;
}

/* Chat opposite the tabs: explicit element ordering in Firefox 158.
   Tabs float on left (#sidebar-container), web pages span the full window frame (#tabbrowser-tabbox),
   and Smart Window Chat panel floats on right (#sidebar-box). */
@media -moz-pref("mios.portal.chat.end") {
  #sidebar-container { order: 0 !important; }
  #sidebar-launcher-splitter { order: 1 !important; display: none !important; }
  #tabbrowser-tabbox { order: 2 !important; }
  #sidebar-splitter { order: 3 !important; display: none !important; }
  #sidebar-box { order: 4 !important; }
  #ai-window-splitter, #ai-window-box {
    order: 5 !important;
    display: none !important;
  }

  /* Auto-hide: the floating Hyprglass chat panel overlays the page instead of shrinking it, collapsed to a
     @MIOS:desktop.portal.gecko.layout.chat_peek_px@px edge strip; it slides in on hover, focus, or when pinned. */
  @media -moz-pref("mios.portal.chat.autohide") {
    #sidebar-splitter {
      display: none !important;
    }
    #sidebar-box:not([hidden]) {
      position: fixed !important;
      inset-block: 0 !important;
      inset-inline-end: 0 !important;
      height: 100vh !important;
      z-index: 20 !important;
      width: @MIOS:desktop.portal.gecko.layout.chat_width_px@px !important;
      min-width: @MIOS:desktop.portal.gecko.layout.chat_width_px@px !important;
      max-width: 100% !important;
      padding: 18px 14px !important;
      box-sizing: border-box !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
      background-color: transparent !important;
      border: none !important;
      transform: translateX(calc(100% - @MIOS:desktop.portal.gecko.layout.chat_peek_px@px));
      opacity: @MIOS:desktop.portal.gecko.layout.chat_peek_opacity@;
      transition: transform @MIOS:desktop.portal.gecko.layout.chat_transition_ms@ms ease, opacity @MIOS:desktop.portal.gecko.layout.chat_transition_ms@ms ease;
    }
    #sidebar-box:not([hidden])::before {
      content: "";
      position: absolute;
      inset: 10px 6px;
      border-radius: @MIOS:desktop.hyprland.config.decoration.rounding@px;
      background: linear-gradient(
        155deg,
        color-mix(in srgb, @MIOS:bg@ 58%, transparent) 0%,
        color-mix(in srgb, @MIOS:bg@ 42%, transparent) 100%
      );
      backdrop-filter: blur(@MIOS:desktop.hyprland.config.decoration.blur.size@px) saturate(175%) brightness(1.06);
      border: 1.5px solid color-mix(in srgb, @MIOS:fg@ 28%, color-mix(in srgb, @MIOS:cursor@ 48%, transparent));
      box-shadow:
        inset 0 1.5px 0 color-mix(in srgb, @MIOS:fg@ 36%, transparent),
        inset 0 0 0 1px color-mix(in srgb, @MIOS:cursor@ 18%, transparent),
        0 18px 44px color-mix(in srgb, @MIOS:bg@ 65%, transparent);
      pointer-events: none;
      z-index: 0;
    }
    #sidebar-box:not([hidden]):is(:hover, :focus-within),
    :root[data-mios-chat-pinned="true"] #sidebar-box:not([hidden]) {
      transform: none !important;
      opacity: 1 !important;
    }
  }
}

/* Floating, content-scaled Hyprglass Left MiOS Sidebar:
   grows dynamically with tab-count / pane-count and floats over the full-frame webpage. */
#sidebar-container {
  position: fixed !important;
  inset-inline-start: 0 !important;
  top: 50% !important;
  bottom: auto !important;
  transform: translateY(-50%) !important;
  z-index: 20 !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: calc(100vh - 32px) !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  background: transparent !important;
  border: none !important;
}
sidebar-main {
  height: auto !important;
  min-height: 0 !important;
  max-height: calc(100vh - 32px) !important;
  flex: 0 1 auto !important;
  display: flex !important;
  flex-direction: column !important;
  background: transparent !important;
}
#sidebar-container #vertical-tabs {
  flex: 0 1 auto !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: 56vh !important;
  display: flex !important;
  flex-direction: column !important;
  background: transparent !important;
  color: @MIOS:fg@ !important;
}
#tabbrowser-tabs,
#tabbrowser-tabs[orient="vertical"] {
  flex: 0 1 auto !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: 56vh !important;
  display: flex !important;
  flex-direction: column !important;
  background: transparent !important;
  color: @MIOS:fg@ !important;
  border: none !important;
}
#pinned-tabs-container,
#tabbrowser-arrowscrollbox {
  flex: 0 1 auto !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: 48vh !important;
}
.tabbrowser-tab .tab-background {
  border-radius: 8px !important;
  background: color-mix(in srgb, @MIOS:subtle@ 18%, transparent) !important;
  border: 1px solid color-mix(in srgb, @MIOS:fg@ 14%, transparent) !important;
}
.tabbrowser-tab[selected] .tab-background {
  background: color-mix(in srgb, @MIOS:cursor@ 32%, color-mix(in srgb, @MIOS:bg@ 60%, transparent)) !important;
  border: 1px solid color-mix(in srgb, @MIOS:cursor@ 72%, transparent) !important;
  box-shadow: inset 0 1px 0 color-mix(in srgb, @MIOS:fg@ 28%, transparent) !important;
}
.tabbrowser-tab .tab-label, #tabs-newtab-button, #vertical-tabs-newtab-button {
  color: @MIOS:fg@ !important;
}

