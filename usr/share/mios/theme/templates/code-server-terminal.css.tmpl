/* AI-hint: GENERATED (mios-dotfiles-render surface code-server-terminal) -- the ONE MiOS stylesheet for VS Code and code-server: terminal insets from [theme].padding, plus the MiOS look. */

:root {
    --mios-safe-top: env(safe-area-inset-top, 0px);
    --mios-safe-bottom: env(safe-area-inset-bottom, 0px);
    --mios-safe-left: env(safe-area-inset-left, 0px);
    --mios-safe-right: env(safe-area-inset-right, 0px);
    /* Scale from the one shared surface radius ([desktop.hyprland] decoration.rounding). */
    --mios-radius-lg: @MIOS:desktop.hyprland.config.decoration.rounding@px;
    --mios-radius-xs: calc(var(--mios-radius-lg) / 7);
    --mios-radius-sm: calc(var(--mios-radius-lg) * 2 / 7);
    --mios-radius-md: calc(var(--mios-radius-lg) * 3 / 7);
    --mios-radius-pill: 9999px;
    --mios-border-thin: 1px solid color-mix(in srgb, @MIOS:fg@ @MIOS:theme.shell.outline_opacity_pct@%, transparent);
    --mios-border-subtle: 1px solid color-mix(in srgb, @MIOS:fg@ calc(@MIOS:theme.shell.outline_opacity_pct@% / 2), transparent);
    --mios-glass-bg: color-mix(in srgb, @MIOS:bg@ 88%, transparent);
    --mios-glass-blur: blur(20px);
}

/* ==========================================================================
   1. SAFE AREA INSETS & MOBILE FIRST VIEWPORT (EDGE-TO-EDGE FRAMELESS)
   ========================================================================== */
html, body, .monaco-workbench {
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    outline: none !important;
    background: #000000 !important;
    overflow: hidden !important;
    -webkit-font-smoothing: antialiased;
    width: 100vw !important;
    max-width: 100vw !important;
}

/* ==========================================================================
   2. ROUNDED FLOATING BOTTOM STATUS BAR (MODERN SMARTPHONE AESTHETIC)
   ========================================================================== */
.monaco-workbench .part.statusbar {
    margin: 4px 8px calc(4px + var(--mios-safe-bottom)) 8px !important;
    border-radius: var(--mios-radius-md) !important;
    border: var(--mios-border-thin) !important;
    background: var(--mios-glass-bg) !important;
    backdrop-filter: var(--mios-glass-blur) !important;
    -webkit-backdrop-filter: var(--mios-glass-blur) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.55) !important;
    height: 28px !important;
    line-height: 28px !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    z-index: 100 !important;
}

.monaco-workbench .part.statusbar .statusbar-item {
    border-radius: var(--mios-radius-sm) !important;
    margin: 2px 3px !important;
    padding: 0 6px !important;
    height: 24px !important;
    line-height: 24px !important;
    transition: background 0.15s ease !important;
}

.monaco-workbench .part.statusbar .statusbar-item:hover,
.monaco-workbench .part.statusbar .statusbar-item:active {
    background: rgba(255, 255, 255, 0.08) !important;
}

/* ==========================================================================
   3. EDGE-TO-EDGE INTEGRATED TERMINAL
   Insets from mios.toml [theme].padding and [theme].scrollbar_state; every other
   terminal padding/margin/border/offset from [theme.edge].code_server_chrome_px.
   Every rule here is scoped to the terminal or its panel. The card
   around the panel keeps the upstream compact geometry: its margin and border
   are subtracted in TypeScript, so zeroing them here would only leave a blank
   strip inside the card; the workbench bake patch removes the perimeter instead.
   ========================================================================== */
/* Terminal gutter (upstream terminal.css: padding-left var(--vscode-spacing-size200)) */
.monaco-workbench .xterm {
    padding-left: @MIOS:edge.left_px@px !important;
    padding-top: @MIOS:edge.top_px@px !important;
    padding-bottom: @MIOS:edge.bottom_px@px !important;
}

.monaco-workbench .xterm .xterm-scrollable-element {
    margin-left: calc(-1 * @MIOS:edge.left_px@px) !important;
    padding-left: @MIOS:edge.left_px@px !important;
}

/* Right inset of the viewport (upstream terminal.css: right 14px, the scrollbar reserve) */
.monaco-workbench .terminal-editor .terminal-wrapper:not(.fixed-dims) .xterm-viewport,
.monaco-workbench .pane-body.integrated-terminal .terminal-wrapper:not(.fixed-dims) .xterm-viewport {
    right: @MIOS:edge.right_px@px !important;
}

/* Panel header hidden to give the terminal the whole card */
.monaco-workbench .part.panel > .composite.title,
.monaco-workbench .part.panel .pane-composite-part > .title,
.monaco-workbench .part.panel .composite.title {
    display: none !important;
    height: 0 !important;
    min-height: 0 !important;
    max-height: 0 !important;
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
    visibility: hidden !important;
    overflow: hidden !important;
}

.monaco-workbench .part.panel > .content,
.monaco-workbench .part.panel .pane-composite-part > .content,
.monaco-workbench .part.panel .pane-body {
    height: 100% !important;
    width: 100% !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
}

/* Container, wrapper, split pane, and editor tab terminal hierarchy */
.monaco-workbench .part.panel .pane-body.integrated-terminal,
.monaco-workbench .part.panel .content .terminal-split-pane,
.monaco-workbench .part.panel .content .terminal-outer-container,
.monaco-workbench .part.panel .content .terminal-wrapper,
.monaco-workbench .part.panel .terminal-outer-container,
.monaco-workbench .part.editor .terminal-editor,
.monaco-workbench .part.editor .terminal-outer-container,
.monaco-workbench .part.editor .terminal-wrapper,
.pane-body.integrated-terminal,
.pane-body.integrated-terminal .terminal-outer-container,
.terminal-editor,
.terminal-editor .terminal-outer-container,
.terminal-editor .terminal-wrapper,
.terminal-editor .terminal-split-pane,
.terminal-outer-container,
.terminal-wrapper,
.terminal-split-pane,
.terminal-split-pane-wrapper,
.terminal-instance,
.xterm-react-component {
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    padding-left: @MIOS:theme.edge.code_server_chrome_px@px !important;
    padding-right: @MIOS:theme.edge.code_server_chrome_px@px !important;
    padding-top: @MIOS:theme.edge.code_server_chrome_px@px !important;
    padding-bottom: @MIOS:theme.edge.code_server_chrome_px@px !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
    outline: none !important;
    box-shadow: none !important;
    width: 100% !important;
    max-width: 100% !important;
}

/* Screen canvas fills the viewport */
.monaco-workbench .terminal .xterm-screen,
.pane-body.integrated-terminal .xterm-screen,
.terminal-editor .xterm-screen,
.xterm-screen {
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
    left: @MIOS:theme.edge.code_server_chrome_px@px !important;
    top: @MIOS:theme.edge.code_server_chrome_px@px !important;
    right: @MIOS:theme.edge.code_server_chrome_px@px !important;
    bottom: @MIOS:theme.edge.code_server_chrome_px@px !important;
    width: 100% !important;
}

.monaco-workbench .terminal .xterm-viewport,
.pane-body.integrated-terminal .xterm-viewport,
.terminal-editor .xterm-viewport {
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
}

/* No canvas gutter offset */
.xterm-screen canvas {
    left: @MIOS:theme.edge.code_server_chrome_px@px !important;
    top: @MIOS:theme.edge.code_server_chrome_px@px !important;
    right: @MIOS:theme.edge.code_server_chrome_px@px !important;
    bottom: @MIOS:theme.edge.code_server_chrome_px@px !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
}

/* Strip inner padding from xterm text rows */
.monaco-workbench .terminal .xterm-rows,
.xterm-rows {
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
}

/* Seamless terminal split views without partition dead space */
.terminal-split-pane-wrapper,
.terminal-split-pane-wrapper .split-view-container,
.terminal-split-pane-wrapper .split-view-view {
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
    width: 100% !important;
}

/* Terminal scrollbars follow [theme].scrollbar_state */
.monaco-workbench .terminal .scrollbar,
.monaco-workbench .terminal .scrollbar.vertical,
.monaco-workbench .terminal .scrollbar.horizontal,
.terminal-wrapper .scrollbar,
.terminal-wrapper .scrollbar.vertical,
.terminal-wrapper .scrollbar.horizontal,
.terminal-editor .scrollbar,
.terminal-editor .scrollbar.vertical,
.monaco-workbench .terminal .xterm-viewport::-webkit-scrollbar,
.terminal-wrapper .xterm-viewport::-webkit-scrollbar,
.xterm-viewport::-webkit-scrollbar,
.xterm .xterm-scrollable-element > .scrollbar {
    display: @MIOS:edge.scrollbar_display@ !important;
}

/* Suppress tabs widget, action bars, and decorations inside terminal */
.monaco-workbench .terminal-tabs-widget,
.monaco-workbench .terminal-tabs-widget.has-no-tabs,
.monaco-workbench .terminal-tabs-widget:empty,
.monaco-workbench .terminal-tab-actions,
.monaco-workbench .terminal-action-bar,
.monaco-workbench .terminal-header-actions,
.monaco-workbench .part.panel .tabs-and-actions-container,
.terminal-tabs-widget,
.terminal-tab-actions,
.terminal-header-actions {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
}

.terminal-shell-integration-decoration,
.terminal-command-decoration,
.terminal-decoration,
.monaco-workbench .terminal .terminal-decoration-overview-ruler,
.xterm-decoration-container {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
}

.terminal-widget-container {
    padding: @MIOS:theme.edge.code_server_chrome_px@px !important;
    margin: @MIOS:theme.edge.code_server_chrome_px@px !important;
    border: @MIOS:theme.edge.code_server_chrome_px@px !important;
}

/* ==========================================================================
   4. ROUNDED SURFACES & FRAMELESS CARDS FOR MOBILE & DESKTOP
   ========================================================================== */
/* Split view sashes and divider partitions: completely transparent */
.monaco-workbench .monaco-sash,
.monaco-workbench .monaco-sash.horizontal,
.monaco-workbench .monaco-sash.vertical,
.monaco-workbench .sash {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    opacity: 0 !important;
}

.monaco-workbench .monaco-sash::before,
.monaco-workbench .monaco-sash::after,
.monaco-workbench .sash::before,
.monaco-workbench .sash::after {
    display: none !important;
    content: none !important;
    border: none !important;
}

.monaco-workbench .split-view-container > .split-view-view {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
}

/* Quick Input / Command Palette / File Search */
.monaco-workbench .quick-input-widget {
    border-radius: var(--mios-radius-lg) !important;
    border: var(--mios-border-thin) !important;
    background: var(--mios-glass-bg) !important;
    backdrop-filter: var(--mios-glass-blur) !important;
    -webkit-backdrop-filter: var(--mios-glass-blur) !important;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.75) !important;
    padding: 8px !important;
    overflow: hidden !important;
}

.monaco-workbench .quick-input-widget .monaco-inputbox {
    border-radius: var(--mios-radius-md) !important;
    border: var(--mios-border-thin) !important;
    padding: 4px 8px !important;
    background: #000000 !important;
}

.monaco-workbench .quick-input-list .monaco-list-row {
    border-radius: var(--mios-radius-sm) !important;
    margin: 1px 4px !important;
}

/* Notifications & Toast alerts */
.monaco-workbench .notifications-toasts .notification-toast {
    border-radius: var(--mios-radius-md) !important;
    border: var(--mios-border-thin) !important;
    background: var(--mios-glass-bg) !important;
    backdrop-filter: var(--mios-glass-blur) !important;
    -webkit-backdrop-filter: var(--mios-glass-blur) !important;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6) !important;
    margin-bottom: 8px !important;
    overflow: hidden !important;
}

/* Context Menus and Dropdowns */
.monaco-menu .monaco-action-bar.vertical {
    border-radius: var(--mios-radius-md) !important;
    border: var(--mios-border-thin) !important;
    background: var(--mios-glass-bg) !important;
    backdrop-filter: var(--mios-glass-blur) !important;
    -webkit-backdrop-filter: var(--mios-glass-blur) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6) !important;
    padding: 4px !important;
}

.monaco-menu .monaco-action-bar.vertical .action-item {
    border-radius: var(--mios-radius-sm) !important;
}

/* Editor groups and tabs: rounded cards with small margins */
.monaco-workbench .part.editor > .content .editor-group-container {
    border-radius: var(--mios-radius-md) !important;
    border: var(--mios-border-subtle) !important;
    overflow: hidden !important;
    margin: 2px !important;
}

.monaco-workbench .part.editor .tab {
    border-radius: var(--mios-radius-sm) !important;
    margin: 2px 3px !important;
    border: none !important;
    height: 28px !important;
    line-height: 28px !important;
    transition: background 0.15s ease !important;
}

/* SideBar - Subtle thin border and rounded edge */
.monaco-workbench .part.sidebar {
    border-radius: 0 var(--mios-radius-md) var(--mios-radius-md) 0 !important;
    border-right: var(--mios-border-thin) !important;
    background: #000000 !important;
}

/* Inputs, buttons, and badges */
.monaco-workbench .monaco-inputbox,
.monaco-workbench .monaco-select-box {
    border-radius: var(--mios-radius-sm) !important;
    border: var(--mios-border-thin) !important;
}

.monaco-workbench .monaco-button {
    border-radius: var(--mios-radius-sm) !important;
    padding: 4px 10px !important;
}
