# AI-hint: Configures the terminal's visual identity by emitting OSC escape sequences to apply the MiOS unified color palette (Hokusai) to interactive shells, ensuring consi...
# AI-doc: usr/share/doc/mios/manual/profile.d.md
# shellcheck shell=sh

[ -t 1 ] || return 0
case "${TERM:-}" in linux|dumb|"") return 0 ;; esac
[ -n "${MIOS_COLORS_APPLIED:-}" ] && return 0
if [ -r /etc/mios/install.env ]; then
    set -a
    # shellcheck disable=SC1091
    . /etc/mios/install.env 2>/dev/null
    set +a
fi

# Helper: emit OSC <code>;<value> with the trailing BEL terminator.
_mios_osc() { printf '\033]%s;%s\007' "$1" "$2"; }

# Palette resolution -- read every slot from MIOS_ANSI_* / MIOS_COLOR_*
# (set by userenv.sh from mios.toml [colors]; defaults emitted from
# globals.sh / vendor /usr/share/mios/mios.toml). The hardcoded fallback
# in each ${VAR:-...} keeps a stock terminal painted correctly even if
# userenv.sh hasn't been sourced yet (e.g. earliest /etc/profile.d order).
_a0="${MIOS_COLORS_ANSI_0_BLACK:-@MIOS:bg@}"
_a1="${MIOS_COLORS_ANSI_1_RED:-@MIOS:error@}"
_a2="${MIOS_COLORS_ANSI_2_GREEN:-@MIOS:success@}"
_a3="${MIOS_COLORS_ANSI_3_YELLOW:-@MIOS:cursor@}"
_a4="${MIOS_COLORS_ANSI_4_BLUE:-@MIOS:accent@}"
_a5="${MIOS_COLORS_ANSI_5_MAGENTA:-@MIOS:earth@}"
_a6="${MIOS_COLORS_ANSI_6_CYAN:-@MIOS:subtle@}"
_a7="${MIOS_COLORS_ANSI_7_WHITE:-@MIOS:fg@}"
_a8="${MIOS_COLORS_ANSI_8_BRIGHT_BLACK:-@MIOS:muted@}"
_a9="${MIOS_COLORS_ANSI_9_BRIGHT_RED:-@MIOS:ansi_9_bright_red@}"
_a10="${MIOS_COLORS_ANSI_10_BRIGHT_GREEN:-@MIOS:ansi_10_bright_green@}"
_a11="${MIOS_COLORS_ANSI_11_BRIGHT_YELLOW:-@MIOS:ansi_11_bright_yellow@}"
_a12="${MIOS_COLORS_ANSI_12_BRIGHT_BLUE:-@MIOS:ansi_12_bright_blue@}"
_a13="${MIOS_COLORS_ANSI_13_BRIGHT_MAGENTA:-@MIOS:ansi_13_bright_magenta@}"
_a14="${MIOS_COLORS_ANSI_14_BRIGHT_CYAN:-@MIOS:silver@}"
_a15="${MIOS_COLORS_ANSI_15_BRIGHT_WHITE:-#FFFFFF}"
_fg="${MIOS_COLORS_FG:-@MIOS:fg@}"
_bg="${MIOS_COLORS_BG:-@MIOS:bg@}"
_cur="${MIOS_COLORS_CURSOR:-@MIOS:cursor@}"
_sel="${MIOS_COLORS_ACCENT:-@MIOS:accent@}"

# ── ANSI 16-color slots (OSC 4 ; <0..15> ; <#rgb>) ────────────────────────
_mios_osc 4 "0;${_a0}"
_mios_osc 4 "1;${_a1}"
_mios_osc 4 "2;${_a2}"
_mios_osc 4 "3;${_a3}"
_mios_osc 4 "4;${_a4}"
_mios_osc 4 "5;${_a5}"
_mios_osc 4 "6;${_a6}"
_mios_osc 4 "7;${_a7}"
_mios_osc 4 "8;${_a8}"
_mios_osc 4 "9;${_a9}"
_mios_osc 4 "10;${_a10}"
_mios_osc 4 "11;${_a11}"
_mios_osc 4 "12;${_a12}"
_mios_osc 4 "13;${_a13}"
_mios_osc 4 "14;${_a14}"
_mios_osc 4 "15;${_a15}"

# ── Defaults (foreground / background / cursor / highlight) ───────────────
_mios_osc 10 "${_fg}"
_mios_osc 11 "${_bg}"
_mios_osc 12 "${_cur}"
_mios_osc 17 "${_sel}"

unset -f _mios_osc
unset _a0 _a1 _a2 _a3 _a4 _a5 _a6 _a7 _a8 _a9 _a10 _a11 _a12 _a13 _a14 _a15
unset _fg _bg _cur _sel
export MIOS_COLORS_APPLIED=1
