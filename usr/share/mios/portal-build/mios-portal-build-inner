mach_package() {
    # A kept objdir still holds the previous run's package (possibly under another app name).
    find "$OBJ/dist" -maxdepth 1 -type f -name '*.linux-x86_64.*' -delete 2>/dev/null || true
    ( cd "$ENGINE" && ./mach package )
    mapfile -t PKGS < <(find "$OBJ/dist" -maxdepth 1 -type f -name '*.linux-x86_64.tar.xz')
    [ "${#PKGS[@]}" -eq 1 ] || die "expected one dist/*.linux-x86_64.tar.xz, found ${#PKGS[@]}"
    sanitize_package "${PKGS[0]}" "$P/surfer.json"
}

# ---------------------------------------------------------------- outputs
write_outputs() {
    local pkg=${PKGS[0]} base
    base=$(basename "$pkg")
    cp "$pkg" "/out/$base"
    tar -tJf "/out/$base" >/out/package-files.txt
    APP_EXE=$(awk -F/ -v b="$PB_BIN" 'NF==2 && ($2==b || $2=="firefox") {print; exit}' /out/package-files.txt)
    [ -n "$APP_EXE" ] || die "package has no top-level $PB_BIN or firefox executable"
    python3 -I - "/out/manifest.json" "/out/$base" <<PY
import hashlib, json, os, platform, subprocess, sys
out, pkg = sys.argv[1], sys.argv[2]
def ver(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=30).stdout.strip().splitlines()[0]
    except Exception:
        return ""
h = hashlib.sha256()
with open(pkg, "rb") as f:
    for chunk in iter(lambda: f.read(1 << 20), b""):
        h.update(chunk)
osr = dict(l.rstrip().split("=", 1) for l in open("/etc/os-release") if "=" in l)
steps = [l.rstrip("\n").split("\t") for l in open("/out/steps.tsv")]
m = {
    "product": {"name": "$PB_NAME", "binary": "$PB_BIN", "brand": "$PB_BRAND", "source": "$PRODUCT_SOURCE"},
    "lane": "$PB_LANE",
    "app_name": "$APP_NAME", "remoting_name": "$REMOTING_NAME",
    "resolved": json.loads('''$(resolved_json)'''),
    "source": {"tarball": "$TARBALL_NAME", "sha512": "$SRC_SHA512", "signature_key": "$PB_KEY_FPR"},
    "package": {"file": os.path.basename(pkg), "sha256": h.hexdigest(), "bytes": os.path.getsize(pkg),
                "executable": "$APP_EXE"},
    "toolchain": {
        "builder_os": osr.get("PRETTY_NAME", "").strip('"'), "python": platform.python_version(),
        "node": ver("node", "--version"), "npm": ver("npm", "--version"),
        "rustc": ver("rustc", "--version"), "cargo": ver("cargo", "--version"),
        "clang": ver("clang", "--version"), "lld": ver("ld.lld", "--version"),
        "cbindgen": ver("cbindgen", "--version"), "git": ver("git", "--version"),
    },
    "steps": [{"name": s[0], "seconds": int(s[1]), "exit": int(s[2])} for s in steps],
}
json.dump(m, open(out, "w"), indent=2)
print(json.dumps(m["resolved"]))
PY
}

do_build() {
    need PB_LANE PB_JOBS PB_MIN_FREE_GB
    : >"$STEPS"
    check_free
    step resolve resolve
    log "resolved: Firefox $FF_VER build$FF_BUILD rev $HG_REV, Surfer $SURFER_VER"
    resolved_json >/out/resolved.json
    step verify-sums verify_sums
    step fetch-source fetch_source
    step setup-project setup_project
    step policy guard_policy
    step surfer-download surfer_download
    step surfer-import surfer_import
    step surfer-license-check surfer_license
    step surfer-build surfer_build
    step mach-package mach_package
    write_outputs
    log "done: /out/$(basename "${PKGS[0]}")"
}

# ---------------------------------------------------------------- smoke
# Console lines that fail the smoke (mios-portal-probe CONSOLE_FAILURES matches the same three).
SMOKE_CONSOLE_FAILURES='console\.error: Policies:|Preference not allowed for stability reasons|Ignoring preference override'
do_smoke() {
    local pkg d exe spec name url rc=0
    pkg=$(find /out -maxdepth 1 -name '*.linux-x86_64.tar.xz' | head -1)
    [ -n "$pkg" ] || die "no package in /out to smoke-test"
    d=$(mktemp -d /work/smoke.XXXXXX)
    tar -xJf "$pkg" -C "$d"
    exe=$(json 'print(d["package"]["executable"])' </out/manifest.json)
    [ -x "$d/$exe" ] || die "packaged executable $exe is not executable"
    if [ -d /out/install-overlay ]; then
        # The product's install/ files (policies, default prefs, autoconfig) laid into the app dir.
        cp -a /out/install-overlay/. "$d/$(dirname "$exe")/"
        log "smoke: applied install-overlay: $(cd /out/install-overlay && find . -type f | tr '\n' ' ')"
    fi
    mkdir -p /out/smoke
    "$d/$exe" --version | tee /out/smoke/version.txt
    for spec in "$@"; do
        name=${spec%%=*}; url=${spec#*=}
        rm -rf "$d/profile"; mkdir -p "$d/profile"
        log "smoke: $name <- $url"
        if MOZ_DBUS_REMOTE=0 MOZ_CRASHREPORTER_DISABLE=1 timeout 180 "$d/$exe" --headless --no-remote \
            --profile "$d/profile" --window-size=1280,820 --screenshot "/out/smoke/$name.png" "$url" \
            >"/out/smoke/$name.log" 2>&1 && [ -s "/out/smoke/$name.png" ]; then
            # A refused policy or pref override means the shipped lockdown is not what runs.
            if grep -nE "$SMOKE_CONSOLE_FAILURES" "/out/smoke/$name.log" >&2; then
                log "smoke: $name FAILED: refused policy or preference override (see smoke/$name.log)"; rc=1
            else
                log "smoke: $name ok ($(stat -c %s "/out/smoke/$name.png") bytes, no refused policy)"
            fi
        else
            log "smoke: $name FAILED (see smoke/$name.log)"; rc=1
        fi
    done
    rm -rf "$d"
    return "$rc"
}

case "${1:-}" in
    resolve) resolve; resolved_json ;;
    resolve-env) resolve; resolved_env ;;
    verify-sums) resolve; verify_sums; printf '%s  %s\n' "$SRC_SHA512" "$TARBALL_NAME" ;;
    policy-check) P=${2:?project dir}; PB_LANE=${3:?lane}; guard_policy; echo "policy ok ($PB_LANE)" ;;
    copy-patch-check) P=${2:?project dir}; ENGINE=$P/engine; check_copy_patches; echo "copy-patches ok" ;;
    build) do_build ;;
    smoke) shift; do_smoke "$@" ;;
    *) echo "usage: $0 resolve|build|smoke NAME=URL...|verify-sums|policy-check DIR LANE|copy-patch-check DIR" >&2; exit 2 ;;
esac
