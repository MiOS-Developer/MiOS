#!/usr/bin/env bash
# AI-hint: MiOS configuration and runtime asset for mios-a2o.
# AI-related: /usr/share/mios/agents, mios-root, mios-agents, mios-frontier

set -uo pipefail
export PATH="${HOME:-/var/home/mios}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

SESSION="${MIOS_A2O_SESSION:-mios-a2o}"
ROOT="${MIOS_A2O_ROOT:-${HOME:-/var/home/mios}/.mios-a2o}"
LOGS="$ROOT/logs"; STATUS="$ROOT/status"; PROMPTS="$ROOT/prompts"; RUND="$ROOT/run"
WORK_DEFAULT="${MIOS_A2O_WORK:-$ROOT/work}"
ENGINE_DEFAULT="${MIOS_A2O_ENGINE:-agy}"     # agy | claude | gemini
AUTO="${MIOS_A2O_AUTO:-0}"                    # 1 => auto-approve tools (skip-permissions / yolo)
SANDBOX="${MIOS_A2O_SANDBOX:-0}"             # 1 => --sandbox (agy/gemini)
AGY_BIN="${MIOS_A2O_AGY_BIN:-agy}"
CLAUDE_BIN="${MIOS_A2O_CLAUDE_BIN:-claude}"
GEMINI_BIN="${MIOS_A2O_GEMINI_BIN:-gemini}"
AGY_MODEL="${MIOS_A2O_AGY_MODEL:-}"
CLAUDE_MODEL="${MIOS_A2O_CLAUDE_MODEL:-}"
GEMINI_MODEL="${MIOS_A2O_GEMINI_MODEL:-}"

ORCH_ENGINE="${MIOS_FRONTIER_ORCH_ENGINE:-claude}"
ORCH_MODEL="${MIOS_FRONTIER_ORCH_MODEL:-claude-sonnet-5}"
ORCH_EFFORT="${MIOS_FRONTIER_ORCH_EFFORT:-high}"
LANE_A_ENGINE="${MIOS_FRONTIER_LANE_A_ENGINE:-claude}"        # Claude Opus 4.8
LANE_A_MODEL="${MIOS_FRONTIER_LANE_A_MODEL:-claude-opus-4-8}"
LANE_A_EFFORT="${MIOS_FRONTIER_LANE_A_EFFORT:-xhigh}"
LANE_A_ROLE="${MIOS_FRONTIER_LANE_A_ROLE:-framework + ~80%}"
LANE_B_ENGINE="${MIOS_FRONTIER_LANE_B_ENGINE:-agy}"           # Gemini 3.5 Flash (High) via Antigravity
LANE_B_MODEL="${MIOS_FRONTIER_LANE_B_MODEL:-Gemini 3.5 Flash (High)}"
LANE_B_EFFORT="${MIOS_FRONTIER_LANE_B_EFFORT:-high}"
LANE_B_ROLE="${MIOS_FRONTIER_LANE_B_ROLE:-finalize (last ~20%)}"
LANE_B_FALLBACK_ENGINE="${MIOS_FRONTIER_LANE_B_FALLBACK_ENGINE:-claude}"
LANE_B_FALLBACK_MODEL="${MIOS_FRONTIER_LANE_B_FALLBACK_MODEL:-claude-sonnet-5}"
LANE_B_FALLBACK_EFFORT="${MIOS_FRONTIER_LANE_B_FALLBACK_EFFORT:-high}"
LANE_B_PREFER_FALLBACK="${MIOS_FRONTIER_LANE_B_PREFER_FALLBACK:-true}"
CLAUDE_EFFORT_FLAG="${MIOS_FRONTIER_CLAUDE_EFFORT_FLAG:-}"
AGY_EFFORT_FLAG="${MIOS_A2O_AGY_EFFORT_FLAG:-}"
GEMINI_EFFORT_FLAG="${MIOS_A2O_GEMINI_EFFORT_FLAG:-}"
_a2o_self_dir="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
_default_brief=""
for _d in "$_a2o_self_dir" /mnt/mios-root/usr/share/mios/agents /usr/share/mios/agents /usr/local/share/mios-agents; do
    [ -f "$_d/orchestrator-brief.md" ] && { _default_brief="$_d/orchestrator-brief.md"; break; }
done
ORCH_BRIEF="${MIOS_A2O_ORCH_BRIEF:-$_default_brief}"

mkdir -p "$LOGS" "$STATUS" "$PROMPTS" "$RUND" "$WORK_DEFAULT"

die(){ echo "Mios-a2o: $*" >&2; exit 1; }
have(){ command -v "$1" >/dev/null 2>&1; }
have tmux || die "Tmux not found on PATH"

engine_bin(){ case "$1" in agy) echo "$AGY_BIN";; claude) echo "$CLAUDE_BIN";; gemini) echo "$GEMINI_BIN";; *) return 1;; esac; }

lane_b_fallback_on(){ case "${LANE_B_PREFER_FALLBACK,,}" in 1|true|yes|on) return 0;; *) return 1;; esac; }

effort_flag(){
  local eng="$1" e="${2:-}" tpl=""
  [ -n "$e" ] || return 0
  case "$eng" in claude) tpl="$CLAUDE_EFFORT_FLAG";; agy) tpl="$AGY_EFFORT_FLAG";; gemini) tpl="$GEMINI_EFFORT_FLAG";; esac
  [ -n "$tpl" ] || return 0
  printf '%s' "${tpl//\{e\}/$e}"
}

ensure_server(){
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -n home -c "$WORK_DEFAULT"
    tmux set-option -g -t "$SESSION" history-limit 500000        >/dev/null 2>&1 || true
    tmux set-option -g -t "$SESSION" remain-on-exit on            >/dev/null 2>&1 || true
    tmux set-option -g -t "$SESSION" status-left "#[bold] A2O:#S #[default]" >/dev/null 2>&1 || true
    tmux send-keys -t "$SESSION:home" \
      "clear; echo 'MiOS A2O war room. Operator tasks open as windows (Ctrl-b n/p to cycle, Ctrl-b d to detach).'" C-m
  fi
}

exec_line(){
  local eng="$1" work="$2" model_in="${3:-}" effort_in="${4:-}" agy_log="${5:-}" mdl="" auto="" sb="" eff="" lf=""
  eff="$(effort_flag "$eng" "$effort_in")"
  case "$eng" in
    agy)
      mdl="${model_in:-$AGY_MODEL}"; [ -n "$mdl" ] && mdl="--model '$mdl'" || mdl=""
      [ "$AUTO" = 1 ] && auto="--dangerously-skip-permissions"
      [ "$SANDBOX" = 1 ] && sb="--sandbox"
      [ -n "$agy_log" ] && lf="--log-file '$agy_log'"
      echo "$AGY_BIN $mdl $eff"\$PROMPT\" < /dev/null"
      ;;
    claude)
      mdl="${model_in:-$CLAUDE_MODEL}"; [ -n "$mdl" ] && mdl="--model '$mdl'" || mdl=""
      [ "$AUTO" = 1 ] && auto="--dangerously-skip-permissions"
      echo "$CLAUDE_BIN $mdl $eff $auto -p \"\$PROMPT\" < /dev/null"
      ;;
    gemini)
      mdl="${model_in:-$GEMINI_MODEL}"; [ -n "$mdl" ] && mdl="-m '$mdl'" || mdl=""
      [ "$AUTO" = 1 ] && auto="--approval-mode yolo" || auto="--approval-mode default"
      [ "$SANDBOX" = 1 ] && sb="--sandbox"
      echo "$GEMINI_BIN $mdl $eff $auto"\$PROMPT\" < /dev/null"
      ;;
    *) return 1;;
  esac
}

cmd_dispatch(){
  local name="${1:-}" eng="${2:-$ENGINE_DEFAULT}" work="${3:-$WORK_DEFAULT}" model="${4:-}" effort="${5:-}"
  [ -n "$name" ] || die "Usage: dispatch <name> [engine] [workdir] [model] [effort]"
  case "$name" in *[!A-Za-z0-9._-]*) die "Task name must be slug [A-Za-z0-9._-]";; esac
  engine_bin "$eng" >/dev/null || die "Unknown engine '$eng'"
  have "$(engine_bin "$eng")" || die "Engine binary not found: $(engine_bin "$eng")"
  ensure_server; mkdir -p "$work"
  cat > "$PROMPTS/$name.txt"                          # prompt from stdin
  [ -s "$PROMPTS/$name.txt" ] || die "Empty prompt on stdin"
  # task_3185: Checkpoint marker for automatic container restart recovery
  printf 'NAME=%s\nENGINE=%s\nWORK=%s\nMODEL=%s\nEFFORT=%s\nPROMPT_FILE=%s\nDISPATCH_TS=%s\n' \
    "$name" "$eng" "$work" "$model" "$effort" "$PROMPTS/$name.txt" "$(date +%s)" > "$STATUS/$name.resume"
  local AGY_DEBUG_LOG="$RUND/$name.agy-debug.log"
  : > "$LOGS/$name.log"; rm -f "$STATUS/$name.status" "$STATUS/$name.running" "$AGY_DEBUG_LOG"; echo "$eng" > "$STATUS/$name.engine"
  local EXEC; EXEC="$(exec_line "$eng" "$work" "$model" "$effort" "$AGY_DEBUG_LOG")"
  local _sr="${MIOS_FRONTIER_STREAM_TO_REASONING:-0}"; _sr="${_sr,,}"
  local _stream_on=0; case "$_sr" in 1|true|yes|on) _stream_on=1;; esac
  local _agy_post=""
  if [ "$eng" = agy ]; then
    local EXEC_FALLBACK=""
    if [ -n "$LANE_B_FALLBACK_ENGINE" ]; then
      local raw_exec
      raw_exec="$(exec_line "$LANE_B_FALLBACK_ENGINE" "$work" "$LANE_B_FALLBACK_MODEL" "$LANE_B_FALLBACK_EFFORT" "")"
      EXEC_FALLBACK="${raw_exec//\$/\\\$}"
      EXEC_FALLBACK="${EXEC_FALLBACK//\"/\\\"}"
    fi
    _agy_post="$(cat <<AGYCHK
if [ "\$rc" = 0 ]; then
  _a2o_fail=0
  [ -s "$LOGS/$name.log" ] || _a2o_fail=1
  if [ -f "$AGY_DEBUG_LOG" ] && grep -qE 'RESOURCE_EXHAUSTED|INVALID_ARGUMENT|Failed to resolve model flag|agent executor error|model unreachable' "$AGY_DEBUG_LOG"; then _a2o_fail=1; fi
  if [ "\$_a2o_fail" = 1 ]; then
    rc=1
    _a2o_reason=""
    _is_quota=0
    if [ -f "$AGY_DEBUG_LOG" ] && grep -qiE 'RESOURCE_EXHAUSTED|quota reached' "$AGY_DEBUG_LOG"; then
      _is_quota=1
    fi

    if [ "\$_is_quota" = 1 ] && [ -n "$EXEC_FALLBACK" ]; then
      printf '%s\n' "=== [mios-a2o] agy quota failure detected -- retrying on fallback engine '$LANE_B_FALLBACK_ENGINE' ===" | tee -a "$LOGS/$name.log"
      PROMPT="\$(cat "$PROMPTS/$name.txt")"
      eval "$EXEC_FALLBACK" 2>&1 | tee -a "$LOGS/$name.log"
      rc=\${PIPESTATUS[0]}
      if [ "\$rc" = 0 ]; then
        printf '%s\n' "=== [mios-a2o] fallback engine '$LANE_B_FALLBACK_ENGINE' completed task successfully ===" | tee -a "$LOGS/$name.log"
        _a2o_fail=0
      else
        _a2o_reason="fallback engine '$LANE_B_FALLBACK_ENGINE' failed rc=\$rc"
      fi
    fi

    if [ "\$_a2o_fail" = 1 ]; then
      if [ "\$_is_quota" = 1 ]; then
        _a2o_resets="\$(grep -oE 'Resets in [^.:]*' "$AGY_DEBUG_LOG" | head -1)"
        if [ -n "\$_a2o_resets" ]; then _a2o_reason="agy: quota exhausted (429), \${_a2o_resets,,}"; else _a2o_reason="agy: quota exhausted (429)"; fi
      fi
      [ -n "\$_a2o_reason" ] || _a2o_reason="\$(grep -oiE 'INVALID_ARGUMENT[^:]*|Failed to resolve model flag[^:]*|agent executor error[^:]*|model unreachable[^:]*|RESOURCE_EXHAUSTED[^:]*' "$AGY_DEBUG_LOG" | head -1)"
      [ -n "\$_a2o_reason" ] || _a2o_reason="agy: no response (empty output; agy exited 0; see $AGY_DEBUG_LOG)"
      printf '%s\n' "=== [mios-a2o] agy failure detected (exited 0 but produced no valid response) ===" "\$_a2o_reason" | tee -a "$LOGS/$name.log"
    fi
  fi
fi
AGYCHK
)"
    _agy_post="$_agy_post
"
  fi
  cat > "$RUND/$name.sh" <<RUNNER
export PATH="$PATH"
cd "$work" 2>/dev/null || cd "$WORK_DEFAULT"
A2O_STREAM_ON="$_stream_on"
A2O_STREAM_PATH="${MIOS_FRONTIER_STREAM_PATH:-}"
A2O_MOUNT_ROOT="${MIOS_A2O_WORK:-}"
_a2o_stream(){  # \$1 = transition detail -> best-effort JSONL append to the frontier
  [ "\$A2O_STREAM_ON" = 1 ] || return 0
  [ -n "\$A2O_STREAM_PATH" ] || return 0
  local sp="\$A2O_STREAM_PATH"
  if [ ! -d "\$(dirname "\$sp")" ] && [ -n "\$A2O_MOUNT_ROOT" ] && [ -d "\$(dirname "\$A2O_MOUNT_ROOT\$sp")" ]; then
    sp="\$A2O_MOUNT_ROOT\$sp"
  fi
  local d; d="\$(dirname "\$sp")"
  [ -d "\$d" ] || mkdir -p "\$d" 2>/dev/null || return 0
  printf '{"ts":%s,"kind":"frontier","detail":"war-room: %s %s [%s]"}\n' \
    "\$(date +%s)" "$name" "\$1" "$eng" >> "\$sp" 2>/dev/null || return 0
  local n; n="\$(wc -l < "\$sp" 2>/dev/null || echo 0)"
  if [ "\${n:-0}" -gt 400 ] 2>/dev/null; then
    tail -n 200 "\$sp" > "\$sp.tmp" 2>/dev/null && mv "\$sp.tmp" "\$sp" 2>/dev/null || true
  fi
}
echo "\$ start [$eng]" > "$STATUS/$name.running"
_a2o_stream start
PROMPT="\$(cat "$PROMPTS/$name.txt")"
set -o pipefail
$EXEC 2>&1 | tee -a "$LOGS/$name.log"
rc=\${PIPESTATUS[0]}
${_agy_post}rm -f "$STATUS/$name.running" "$STATUS/$name.resume"
echo "\$rc" > "$STATUS/$name.status"
st=done; [ "\$rc" = 0 ] || st=failed
_a2o_stream "\$st rc=\$rc"
echo "" | tee -a "$LOGS/$name.log"
echo "=== [mios-a2o] task '$name' finished rc=\$rc ===" | tee -a "$LOGS/$name.log"
RUNNER
  chmod +x "$RUND/$name.sh"
  tmux kill-window -t "$SESSION:$name" 2>/dev/null || true
  tmux new-window -t "$SESSION" -n "$name" -c "$work" "bash '$RUND/$name.sh'"
  echo "Dispatched: task='$name' engine='$eng'${model:+ model='$model'}${effort:+ effort='$effort'} work='$work' auto=$AUTO sandbox=$SANDBOX"
  echo "Monitor: mios-a2o tail $name | window: $SESSION:$name | attach: tmux attach -t $SESSION"
}

cmd_a2a_dispatch(){
  local name="${1:-}" eng="${2:-$ENGINE_DEFAULT}" work="${3:-$WORK_DEFAULT}" model="${4:-}" effort="${5:-}"
  [ -n "$name" ] || die "Usage: dispatch --a2a <name> [engine] [workdir] [model] [effort]"
  case "$name" in *[!A-Za-z0-9._-]*) die "Task name must be slug [A-Za-z0-9._-]";; esac
  mkdir -p "$PROMPTS" "$STATUS" "$LOGS" "$RUND"
  cat > "$PROMPTS/$name.txt"
  [ -s "$PROMPTS/$name.txt" ] || die "Empty prompt on stdin"
  printf 'NAME=%s\nENGINE=%s\nWORK=%s\nMODEL=%s\nEFFORT=%s\nPROMPT_FILE=%s\nDISPATCH_TS=%s\n' \
    "$name" "$eng" "$work" "$model" "$effort" "$PROMPTS/$name.txt" "$(date +%s)" > "$STATUS/$name.resume"
  echo "$eng" > "$STATUS/$name.engine"
  : > "$LOGS/$name.log"
  echo "$ start [$eng:a2a]" > "$STATUS/$name.running"

  local a2a_url="${MIOS_A2O_A2A_URL:-http://127.0.0.1:${MIOS_PORT_A2O_A2A:-8643}/a2a}"
  local p_content; p_content="$(cat "$PROMPTS/$name.txt")"
  local dispatched=0
  if have curl; then
    local payload
    payload="$(python3 -c "import json, sys; print(json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': 'tasks/send', 'params': {'task_id': sys.argv[1], 'engine': sys.argv[2], 'work': sys.argv[3], 'model': sys.argv[4], 'effort': sys.argv[5], 'prompt': sys.argv[6]}}))" "$name" "$eng" "$work" "$model" "$effort" "$p_content" 2>/dev/null || true)"
    if [ -n "$payload" ]; then
      local resp
      resp="$(curl -s -m 5 -X POST -H "Content-Type: application/json" -d "$payload" "$a2a_url" 2>/dev/null || true)"
      if [ -n "$resp" ] && [[ "$resp" == *"result"* ]]; then
        echo "Dispatched over A2A JSON-RPC 2.0 to $a2a_url: task='$name' engine='$eng'"
        echo "$resp" >> "$LOGS/$name.log"
        dispatched=1
      fi
    fi
  fi
  if [ "$dispatched" = 0 ]; then
    echo "A2A endpoint unavailable ($a2a_url); degrading to local tmux dispatch"
    cmd_dispatch "$name" "$eng" "$work" "$model" "$effort" < "$PROMPTS/$name.txt"
  fi
}

cmd_lane(){
  local a2a_mode=0
  if [ "${1:-}" = "--a2a" ]; then
    a2a_mode=1; shift
  fi
  local lane="${1:-}" name="${2:-}"
  [ -n "$lane" ] && [ -n "$name" ] || die "Usage: lane [--a2a] <lane_id> <name>"
  local eng="" mdl="" eff="" role=""
  local lane_up="${lane^^}"
  case "$lane" in
    a|A|lane_a|LANE_A)
      eng="${MIOS_FRONTIER_LANE_A_ENGINE:-$LANE_A_ENGINE}"
      mdl="${MIOS_FRONTIER_LANE_A_MODEL:-$LANE_A_MODEL}"
      eff="${MIOS_FRONTIER_LANE_A_EFFORT:-$LANE_A_EFFORT}"
      role="${MIOS_FRONTIER_LANE_A_ROLE:-$LANE_A_ROLE}"
      ;;
    b|B|lane_b|LANE_B)
      eng="${MIOS_FRONTIER_LANE_B_ENGINE:-$LANE_B_ENGINE}"
      mdl="${MIOS_FRONTIER_LANE_B_MODEL:-$LANE_B_MODEL}"
      eff="${MIOS_FRONTIER_LANE_B_EFFORT:-$LANE_B_EFFORT}"
      role="${MIOS_FRONTIER_LANE_B_ROLE:-$LANE_B_ROLE}"
      if lane_b_fallback_on && [ -n "$LANE_B_FALLBACK_ENGINE" ]; then
        eng="$LANE_B_FALLBACK_ENGINE"; mdl="$LANE_B_FALLBACK_MODEL"; eff="$LANE_B_FALLBACK_EFFORT"
      fi
      ;;
    *)
      local v_eng="MIOS_A2O_LANE_${lane_up}_ENGINE"
      local v_mdl="MIOS_A2O_LANE_${lane_up}_MODEL"
      local v_eff="MIOS_A2O_LANE_${lane_up}_EFFORT"
      local v_role="MIOS_A2O_LANE_${lane_up}_ROLE"
      eng="${!v_eng:-$ENGINE_DEFAULT}"
      mdl="${!v_mdl:-}"
      eff="${!v_eff:-}"
      role="${!v_role:-dynamic lane $lane}"
      ;;
  esac
  if [ "$a2a_mode" = 1 ]; then
    cmd_a2a_dispatch "$name" "$eng" "$WORK_DEFAULT" "$mdl" "$eff"
  else
    cmd_dispatch "$name" "$eng" "$WORK_DEFAULT" "$mdl" "$eff"
  fi
}

cmd_status(){
  local only="${1:-}" f name eng state rc win; shopt -s nullglob; local any=0
  printf "%-24s %-9s %-9s %-5s %-6s\n" TASK ENGINE STATE RC WINDOW
  for f in "$LOGS"/*.log; do
    any=1; name="$(basename "$f" .log)"
    [ -n "$only" ] && [ "$only" != "$name" ] && continue
    eng="$(cat "$STATUS/$name.engine" 2>/dev/null)"; [ -z "$eng" ] && eng="?"
    if tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null | grep -qx "$name"; then win=yes; else win=no; fi
    if [ -f "$STATUS/$name.running" ]; then state=RUNNING; rc="-"
    elif [ -f "$STATUS/$name.status" ]; then rc="$(cat "$STATUS/$name.status")"; [ "$rc" = 0 ] && state=DONE || state=FAILED
    else state=PENDING; rc="-"; fi
    printf "%-24s %-9s %-9s %-5s %-6s\n" "$name" "$eng" "$state" "$rc" "$win"
  done
  if [ "$any" = 0 ]; then echo ""; fi
  return 0
}

cmd_tail(){ local n="${1:?usage: tail <name> [n]}"; tail -n "${2:-40}" "$LOGS/$n.log" 2>/dev/null || die "No log for '$n'"; }
cmd_capture(){ local n="${1:?usage: capture <name> [n]}"; tmux capture-pane -pt "$SESSION:$n" -S "-${2:-60}" 2>/dev/null || die "No window '$n'"; }
cmd_send(){ local n="${1:?usage: send <name> <keys...>}"; shift; tmux send-keys -t "$SESSION:$n" -- "$*" C-m; echo "Sent to '$n': $*"; }
cmd_repl(){ local eng="${1:-$ENGINE_DEFAULT}" name="${2:-repl-$eng}" work="${3:-$WORK_DEFAULT}"
  have "$(engine_bin "$eng")" || die "Engine binary not found: $(engine_bin "$eng")"
  ensure_server; tmux kill-window -t "$SESSION:$name" 2>/dev/null || true
  tmux new-window -t "$SESSION" -n "$name" -c "$work" "$(engine_bin "$eng")"
  echo "Interactive $eng in $SESSION:$name — attach: tmux attach -t $SESSION"; }
cmd_attach(){ echo "tmux attach -t $SESSION"; echo " wsl -d podman-MiOS-DEV"; }
cmd_list(){ tmux list-windows -t "$SESSION" 2>/dev/null || echo "War room not running"; }
cmd_kill(){ local a="${1:?usage: kill <name>|--all}"
  if [ "$a" = --all ]; then tmux kill-session -t "$SESSION" 2>/dev/null; echo "War room killed"
  else tmux kill-window -t "$SESSION:$a" 2>/dev/null; echo "Killed window '$a'"; fi; }
cmd_doctor(){
  echo "Session=$SESSION root=$ROOT work=$WORK_DEFAULT engine_default=$ENGINE_DEFAULT auto=$AUTO sandbox=$SANDBOX"
  echo "Roles:"
  printf "  %-13s %-7s %-22s effort=%-6s flag=%s\n" "orchestrator" "$ORCH_ENGINE" "$ORCH_MODEL" "$ORCH_EFFORT" "${CLAUDE_EFFORT_FLAG:-<none>}"
  printf "  %-13s %-7s %-22s effort=%-6s role=%s\n" "lane A" "$LANE_A_ENGINE" "$LANE_A_MODEL" "$LANE_A_EFFORT" "$LANE_A_ROLE"
  printf "  %-13s %-7s %-22s effort=%-6s role=%s\n" "lane B" "$LANE_B_ENGINE" "$LANE_B_MODEL" "$LANE_B_EFFORT" "$LANE_B_ROLE"
  if lane_b_fallback_on && [ -n "$LANE_B_FALLBACK_ENGINE" ]; then _fb_state="ACTIVE (Lane B routes here now)"; else _fb_state="inactive (Lane B uses agy)"; fi
  printf "  %-13s %-7s %-22s effort=%-6s %s\n" "lane B fallback" "$LANE_B_FALLBACK_ENGINE" "$LANE_B_FALLBACK_MODEL" "$LANE_B_FALLBACK_EFFORT" "$_fb_state"
  echo "Orchestrator_brief=${ORCH_BRIEF:-<none found>}"
  echo -n "tmux:   "; tmux -V
  for e in agy claude gemini; do b="$(engine_bin "$e")"; printf "%-7s " "$e:"; if have "$b"; then "$b" --version 2>/dev/null | head -1; else echo "Not installed"; fi; done
  echo -n "server: "; tmux has-session -t "$SESSION" 2>/dev/null && echo up || echo down
  if [ "$AUTO" = 1 ]; then echo "WARN: AUTO=1 auto-approves ALL tools — keep confined to this host/container"; fi
  [ -n "$ORCH_BRIEF" ] || echo "WARN: orchestrator-brief.md not found"
  return 0
}
cmd_selftest(){  # engine-free proof that dispatch->window->log->status->capture all work
  ensure_server; local name="selftest"
  : > "$LOGS/$name.log"; rm -f "$STATUS/$name.status" "$STATUS/$name.running"; echo "Selftest" > "$STATUS/$name.engine"
  cat > "$RUND/$name.sh" <<RUNNER
echo "\$ start [selftest]" > "$STATUS/$name.running"
{ echo "A2O_SELFTEST: window live in session '$SESSION' on \$(hostname)"; sleep 1; echo "A2O_SELFTEST_OK: dispatch->window->log->capture verified"; } 2>&1 | tee -a "$LOGS/$name.log"
rc=\${PIPESTATUS[0]}; rm -f "$STATUS/$name.running"; echo "\$rc" > "$STATUS/$name.status"
echo "=== [mios-a2o] selftest finished rc=\$rc ===" | tee -a "$LOGS/$name.log"
RUNNER
  chmod +x "$RUND/$name.sh"
  tmux kill-window -t "$SESSION:$name" 2>/dev/null || true
  tmux new-window -t "$SESSION" -n "$name" -c "$WORK_DEFAULT" "bash '$RUND/$name.sh'"
  echo "Selftest dispatched to $SESSION:selftest — verify: mios-a2o status ; mios-a2o tail selftest"
  echo "Roles configured:"
  echo "  orchestrator=$ORCH_ENGINE:$ORCH_MODEL  laneA=$LANE_A_ENGINE:$LANE_A_MODEL  laneB=$LANE_B_ENGINE:$LANE_B_MODEL"

  local FS="${SESSION}-frontier-selftest" lay_ok=1 lay_msg="" panes npanes role mdl expect
  tmux kill-session -t "$FS" 2>/dev/null || true
  ( export MIOS_A2O_NOATTACH=1 MIOS_A2O_FRONTIER="$FS"; cmd_frontier ) >/dev/null 2>&1 || true
  panes="$(tmux list-panes -t "$FS:frontier" -F '#{pane_title}' 2>/dev/null || true)"
  npanes="$(printf '%s\n' "$panes" | grep -c . || true)"
  for expect in "ORCHESTRATOR|$ORCH_MODEL" "LANE A|$LANE_A_MODEL" "LANE B|$LANE_B_MODEL" "MONITOR|"; do
    role="${expect%%|*}"; mdl="${expect#*|}"
    printf '%s\n' "$panes" | grep -q -- "$role" || { lay_ok=0; lay_msg="$lay_msg missing-pane:$role"; }
    [ -n "$mdl" ] && { printf '%s\n' "$panes" | grep -qF -- "$mdl" || { lay_ok=0; lay_msg="$lay_msg missing-model:$mdl"; }; }
  done
  [ "$npanes" = 4 ] || { lay_ok=0; lay_msg="$lay_msg pane-count=$npanes(want 4)"; }
  tmux kill-session -t "$FS" 2>/dev/null || true
  if [ "$lay_ok" = 1 ]; then
    echo "FRONTIER-LAYOUT: PASS — 4 panes [ORCHESTRATOR/LANE A/LANE B/MONITOR] carry resolved role models"
  else
    echo "FRONTIER-LAYOUT: FAIL —$lay_msg"
    return 1
  fi
}

newest_task(){  # echo newest task name, optionally filtered by engine (.engine marker)
  local eng="${1:-}" f name
  for f in $(ls -t "$LOGS"/*.log 2>/dev/null); do
    name="$(basename "$f" .log)"
    [ -z "$eng" ] && { echo "$name"; return 0; }
    [ "$(cat "$STATUS/$name.engine" 2>/dev/null)" = "$eng" ] && { echo "$name"; return 0; }
  done
  return 1
}
cmd_follow(){  # live-tail newest task log; --engine <eng> filters that lane; waits if none yet
  local n="" eng=""
  while [ $# -gt 0 ]; do case "$1" in --engine) eng="${2:-}"; shift 2;; *) n="$1"; shift;; esac; done
  if [ -z "$n" ]; then
    echo ">>> ${eng:-any} lane"
    while :; do n="$(newest_task "$eng")"; [ -n "$n" ] && break; sleep 2; done
  fi
  [ -f "$LOGS/$n.log" ] || die "No log for '$n'"
  echo ">>> following '$n'${eng:+ [$eng]}"
  exec tail -n +1 -F "$LOGS/$n.log"
}

cmd_frontier_help(){
  cat <<EOF
  MiOS Frontier -- ORCHESTRATOR (Sonnet 5) drives two sub-agent lanes in parallel
  ----------------------------------------------------------------------
  ORCHESTRATOR (this pane): decomposes your goal, then DISPATCHES:
    LANE A = ${LANE_A_MODEL} (${LANE_A_ROLE})
    LANE B = ${LANE_B_MODEL} (${LANE_B_ROLE})
  and keeps BOTH lanes live + fed until the job is complete (see the doctrine it
  was briefed with: ${ORCH_BRIEF:-<brief missing>}).

  Dispatch (the orchestrator runs these; you can too):
    echo 'Broad framework + 80%: scaffold module X ...' | mios-a2o lane a scaffold
    echo 'Finalize: finish TODOs, build, test to green' | MIOS_A2O_AUTO=1 mios-a2o lane b finish
  Monitor: mios-a2o status | tail <name> | follow --engine claude|agy
  Steer:   mios-a2o send <name> <keys>
  ----------------------------------------------------------------------
EOF
}

cmd_frontier(){  # ORCHESTRATOR (main) + LANE A / LANE B / MONITOR
  local S="${MIOS_A2O_FRONTIER:-mios-frontier}" self
  self="$(command -v mios-a2o 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")"
  if tmux has-session -t "$S" 2>/dev/null; then
    if [ -t 1 ] && [ -z "${MIOS_A2O_NOATTACH:-}" ]; then exec tmux attach -t "$S"; else echo "Frontier '$S' already up"; return 0; fi
  fi
  ensure_server
  local orch_bin orch_eff
  orch_bin="$(engine_bin "$ORCH_ENGINE" 2>/dev/null || echo "$ORCH_ENGINE")"
  orch_eff="$(effort_flag "$ORCH_ENGINE" "$ORCH_EFFORT")"
  mkdir -p "$RUND"
  cat > "$RUND/orchestrator.sh" <<ORUN
export PATH="$PATH"
cd "$WORK_DEFAULT" 2>/dev/null || true
BRIEF="\$(cat "$ORCH_BRIEF" 2>/dev/null || true)"
if ! command -v "$orch_bin" >/dev/null 2>&1; then
  echo "[frontier] orchestrator engine '$ORCH_ENGINE' not installed"; echo
  "$self" frontier-help; exec bash
fi
echo "[frontier] ORCHESTRATOR=$ORCH_ENGINE:$ORCH_MODEL  LANE A=$LANE_A_MODEL  LANE B=$LANE_B_MODEL"
[ -n "\$BRIEF" ] || echo "[frontier] WARN: no orchestrator-brief"
case "$ORCH_ENGINE" in
  claude)
    if [ -n "\$BRIEF" ]; then exec "$orch_bin" --model "$ORCH_MODEL" $orch_eff --append-system-prompt "\$BRIEF"
    else exec "$orch_bin" --model "$ORCH_MODEL" $orch_eff; fi ;;
  agy)    exec "$orch_bin" --model "$ORCH_MODEL" $orch_eff --add-dir "$WORK_DEFAULT" ;;
  gemini) exec "$orch_bin" -m "$ORCH_MODEL" $orch_eff ;;
  *)      exec "$orch_bin" ;;
esac
ORUN
  chmod +x "$RUND/orchestrator.sh"

  tmux new-session -d -s "$S" -n frontier -c "$WORK_DEFAULT"
  tmux set-option -t "$S" -g mouse on             >/dev/null 2>&1 || true
  tmux set-option -t "$S" -g history-limit 500000 >/dev/null 2>&1 || true
  tmux set-option -t "$S" -g pane-border-status top          >/dev/null 2>&1 || true
  tmux set-option -t "$S" -g pane-border-format " #{pane_title} " >/dev/null 2>&1 || true
  tmux split-window -h -t "$S:frontier.0" -c "$WORK_DEFAULT" -p 52
  tmux split-window -v -t "$S:frontier.1" -c "$WORK_DEFAULT" -p 66
  tmux split-window -v -t "$S:frontier.2" -c "$WORK_DEFAULT" -p 50
  tmux select-pane -t "$S:frontier.0" -T "ORCHESTRATOR $ORCH_ENGINE:$ORCH_MODEL (effort=$ORCH_EFFORT) - dispatches + monitors + keeps both lanes fed"
  tmux select-pane -t "$S:frontier.1" -T "LANE A $LANE_A_ENGINE:$LANE_A_MODEL (effort=$LANE_A_EFFORT) - $LANE_A_ROLE"
  tmux select-pane -t "$S:frontier.2" -T "LANE B $LANE_B_ENGINE:$LANE_B_MODEL (effort=$LANE_B_EFFORT) - $LANE_B_ROLE"
  tmux select-pane -t "$S:frontier.3" -T "MONITOR - all tasks (both lanes)"
  tmux send-keys -t "$S:frontier.1" "'$self' follow --engine $LANE_A_ENGINE" C-m
  tmux send-keys -t "$S:frontier.2" "'$self' follow --engine $LANE_B_ENGINE" C-m
  tmux send-keys -t "$S:frontier.3" "while :; do clear; '$self' status; sleep 3; done" C-m
  tmux send-keys -t "$S:frontier.0" "bash '$RUND/orchestrator.sh'" C-m
  tmux select-pane -t "$S:frontier.0"
  if [ -t 1 ] && [ -z "${MIOS_A2O_NOATTACH:-}" ]; then exec tmux attach -t "$S"
  else echo "Frontier '$S' ready"; tmux list-panes -t "$S:frontier" -F '  pane #{pane_index}: #{pane_title}'; fi
}

cmd_resume(){
  local count=0
  for f in "$STATUS"/*.resume; do
    [ -f "$f" ] || continue
    local NAME="" ENGINE="" WORK="" MODEL="" EFFORT="" PROMPT_FILE="" DISPATCH_TS=""
    # shellcheck disable=SC1090
    . "$f"
    if [ -n "$NAME" ] && [ -f "$PROMPT_FILE" ] && [ ! -f "$STATUS/$NAME.status" ]; then
      echo "=== [mios-a2o] resuming checkpointed task '$NAME' ($ENGINE) ==="
      cmd_dispatch "$NAME" "$ENGINE" "$WORK" "$MODEL" "$EFFORT" < "$PROMPT_FILE"
      count=$((count + 1))
    fi
  done
  echo "Resumed $count orphaned task(s)."
}

sub="${1:-help}"; shift 2>/dev/null || true
case "$sub" in
  dispatch) cmd_dispatch "$@";; lane) cmd_lane "$@";; resume) cmd_resume "$@";; status) cmd_status "$@";; tail) cmd_tail "$@";;
  capture) cmd_capture "$@";; send) cmd_send "$@";; repl) cmd_repl "$@";;
  attach) cmd_attach "$@";; list) cmd_list "$@";; kill) cmd_kill "$@";; doctor) cmd_doctor "$@";; selftest) cmd_selftest "$@";;
  follow) cmd_follow "$@";; frontier) cmd_frontier "$@";; frontier-help) cmd_frontier_help "$@";; warroom) cmd_frontier "$@";;
  help|-h|--help)
    echo "Mios-a2o — ORCHESTRATOR || sub-agents tmux frontier"
    echo "  frontier                             launch the war-room"
    echo "  lane <a|b> <name>                    dispatch to a sub-agent role; prompt on stdin"
    echo "  dispatch <name> [engine] [workdir] [model] [effort]   run a task in its own window"
    echo "  resume                               resume in-flight checkpointed tasks across restart"
    echo "  follow [name] ["
    echo "  status [name] | tail <name> [n] | capture <name> [n] | send <name> <keys...>"
    echo "  repl [engine] [name] [workdir] | attach | list | kill <name>|"
    echo "Roles: orchestrator=$ORCH_ENGINE:$ORCH_MODEL  laneA=$LANE_A_ENGINE:$LANE_A_MODEL  laneB=$LANE_B_ENGINE:$LANE_B_MODEL"
    echo "Env: MIOS_A2O_{ORCH,LANE_A,LANE_B}_{ENGINE,MODEL,EFFORT} MIOS_A2O_AUTO=1 MIOS_A2O_*_EFFORT_FLAG MIOS_A2O_ORCH_BRIEF";;
  *) die "Unknown command: $sub";;
esac
