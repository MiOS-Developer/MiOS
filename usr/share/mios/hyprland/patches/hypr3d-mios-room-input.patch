+#pragma once
+
+// MiOS room input (hypr3d-mios-room-input.patch): the pure math behind
+//  * PiP face-the-viewer: a PiP within its viewing distance of the camera (windows.face_distance, Theatre:
+//    windows.theatre_face_distance) turns its plane normal toward the camera POSITION and follows it as the camera
+//    moves; outside it eases back to the pose it was placed with. Every change is an exponential ease
+//    (windows.face_seconds), so nothing snaps, and a hysteresis band (windows.face_hysteresis) keeps a viewer
+//    standing on the boundary from flapping between the two targets.
+//  * the room's recenter verb: the camera eases to look at a point.
+// Conventions (World3D.cpp / ScreenProject.cpp / Camera.cpp): a window's normal is
+// (sin yaw cos p, -sin p, cos yaw cos p); the camera's forward is (sin yaw cos p, sin p, -cos yaw cos p).
+// No Hyprland dependency: tests/mios-face-viewer.cpp checks it in ctest.
+
+#include <algorithm>
+#include <cmath>
+
+namespace H3D::FaceViewer {
+
+constexpr float kPi  = 3.14159265358979323846f;
+constexpr float kTau = 6.28318530717958647692f;
+// The plugin clamps every window pitch to this (World3D::updateDrag): a window never lies flat.
+constexpr float kPitchLimit = 1.5f;
+
+struct SAngles {
+    float yaw = 0.f, pitch = 0.f;
+};
+
+inline float wrapPi(float a) {
+    if (!std::isfinite(a))
+        return 0.f;
+    a = std::remainder(a, kTau);
+    return a;
+}
+
+// The yaw/pitch whose window normal points from `cx,cy,cz` (window centre) toward `ex,ey,ez` (the eye).
+// A degenerate offset (the eye inside the centre) keeps `fallback`.
+inline SAngles faceToward(float cx, float cy, float cz, float ex, float ey, float ez, SAngles fallback) {
+    const float dx = ex - cx, dy = ey - cy, dz = ez - cz;
+    const float len = std::sqrt(dx * dx + dy * dy + dz * dz);
+    if (!std::isfinite(len) || len < 1e-4f)
+        return fallback;
+    SAngles out;
+    out.yaw   = std::atan2(dx / len, dz / len);
+    out.pitch = std::clamp(std::asin(std::clamp(-dy / len, -1.f, 1.f)), -kPitchLimit, kPitchLimit);
+    return out;
+}
+
+// The camera yaw/pitch that looks from the eye at a point (Camera::forward inverted).
+inline SAngles lookAt(float ex, float ey, float ez, float px, float py, float pz, float pitchLimit, SAngles fallback) {
+    const float dx = px - ex, dy = py - ey, dz = pz - ez;
+    const float len = std::sqrt(dx * dx + dy * dy + dz * dz);
+    if (!std::isfinite(len) || len < 1e-4f)
+        return fallback;
+    SAngles out;
+    out.yaw   = std::atan2(dx / len, -dz / len);
+    out.pitch = std::clamp(std::asin(std::clamp(dy / len, -1.f, 1.f)), -pitchLimit, pitchLimit);
+    return out;
+}
+
+// Inside the viewing distance? `wasFacing` applies the hysteresis band: facing starts at <= limit and ends only
+// beyond limit + hysteresis. A non-positive limit disables facing.
+inline bool withinViewingDistance(float distance, float limit, float hysteresis, bool wasFacing) {
+    if (!std::isfinite(distance) || !std::isfinite(limit) || limit <= 0.f)
+        return false;
+    const float band = std::max(0.f, std::isfinite(hysteresis) ? hysteresis : 0.f);
+    return wasFacing ? distance <= limit + band : distance <= limit;
+}
+
+// The fraction of the remaining angle one frame of `dt` seconds covers with time constant `seconds`
+// (1 - e^(-dt/seconds)). dt is clamped to 0.1 s, so a long frame never jumps; seconds <= 0 is clamped to 1 ms.
+inline float easeAlpha(float dt, float seconds) {
+    if (!std::isfinite(dt) || dt <= 0.f)
+        return 0.f;
+    const float tau = std::isfinite(seconds) ? std::max(seconds, 0.001f) : 0.2f;
+    return 1.f - std::exp(-std::min(dt, 0.1f) / tau);
+}
+
+// Ease an angle toward a target along the shorter way round.
+inline float easeAngle(float current, float target, float alpha) {
+    return wrapPi(current + wrapPi(target - current) * std::clamp(alpha, 0.f, 1.f));
+}
+
+struct SPose {
+    float yaw = 0.f, pitch = 0.f, roll = 0.f;
+};
+
+// Per-window face-the-viewer state. `base` is the pose the window was placed with (by the operator, the spawn,
+// Theatre or a restore); `applied` is what this module last wrote into the entity.
+struct SState {
+    bool  init = false, facing = false;
+    SPose base{}, applied{};
+};
+
+inline bool samePose(const SPose& a, const SPose& b) {
+    return std::fabs(wrapPi(a.yaw - b.yaw)) < 1e-6f && std::fabs(a.pitch - b.pitch) < 1e-6f &&
+        std::fabs(wrapPi(a.roll - b.roll)) < 1e-6f;
+}
+
+// Another owner (a grab, a resize, the view morph, the fullscreen passthrough) drives the pose this frame: adopt it
+// as the placed pose and stop facing until the window is free again (the hysteresis restarts from outside).
+inline void adopt(SState& s, const SPose& current) {
+    s.init = true;
+    s.facing = false;
+    s.base = s.applied = current;
+}
+
+// One frame. `pose` is the entity's pose as the frame built it (normally exactly what this module wrote last frame;
+// anything else means another writer placed the window, and that becomes its new base). `limit` is the viewing
+// distance for this window (<= 0 = never face). Returns true while the pose is still easing (the caller keeps
+// damaging the output so the motion completes).
+inline bool step(SState& s, SPose& pose, float cx, float cy, float cz, float ex, float ey, float ez, float limit,
+                 float hysteresis, float seconds, float dt) {
+    if (!s.init) {
+        s.init = true;
+        s.base = s.applied = pose;
+    } else if (!samePose(pose, s.applied)) {
+        s.base = pose;
+    }
+    const float dx = ex - cx, dy = ey - cy, dz = ez - cz;
+    s.facing = withinViewingDistance(std::sqrt(dx * dx + dy * dy + dz * dz), limit, hysteresis, s.facing);
+    SPose target = s.base;
+    if (s.facing) {
+        const SAngles a = faceToward(cx, cy, cz, ex, ey, ez, SAngles{s.base.yaw, s.base.pitch});
+        target = SPose{a.yaw, a.pitch, 0.f};
+    }
+    // Ease from what is on screen (the last applied pose): a new base from another writer (Theatre's per-frame
+    // placement, a restore) is approached smoothly too, never jumped to.
+    const SPose from = s.applied;
+    const float alpha = easeAlpha(dt, seconds);
+    SPose next;
+    next.yaw   = easeAngle(from.yaw, target.yaw, alpha);
+    next.pitch = std::clamp(from.pitch + (target.pitch - from.pitch) * alpha, -kPitchLimit, kPitchLimit);
+    next.roll  = easeAngle(from.roll, target.roll, alpha);
+    pose = s.applied = next;
+    return std::fabs(wrapPi(target.yaw - next.yaw)) > 1e-4f || std::fabs(target.pitch - next.pitch) > 1e-4f ||
+        std::fabs(wrapPi(target.roll - next.roll)) > 1e-4f;
+}
+
+// The window normal for a yaw/pitch (the plugin's convention), for tests and the live probe.
+inline void normalOf(float yaw, float pitch, float& nx, float& ny, float& nz) {
+    nx = std::sin(yaw) * std::cos(pitch);
+    ny = -std::sin(pitch);
+    nz = std::cos(yaw) * std::cos(pitch);
+}
+
+} // namespace H3D::FaceViewer
