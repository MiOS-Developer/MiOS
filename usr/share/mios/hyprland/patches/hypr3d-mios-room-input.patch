+++ b/tests/mios-face-viewer.cpp
@@ -0,0 +1,127 @@
+// AI-hint: Executable positive/negative controls for PiP face-the-viewer (viewing distance, hysteresis, eased follow, return to the placed pose) and the room recenter look-at.
+// AI-related: src/World/FaceViewer.hpp, usr/share/mios/mios.toml [desktop.hyprland.hypr3d.config.windows]
+#include "../src/World/FaceViewer.hpp"
+#include <cmath>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+using namespace H3D::FaceViewer;
+
+static void check(bool v, const std::string& what) {
+    if (!v)
+        throw std::runtime_error("face-viewer regression: " + what);
+}
+
+// Angle (degrees) between the window normal and the direction from the window centre to the eye.
+static float offAxisDeg(const SPose& p, float cx, float cy, float cz, float ex, float ey, float ez) {
+    float nx, ny, nz;
+    normalOf(p.yaw, p.pitch, nx, ny, nz);
+    float dx = ex - cx, dy = ey - cy, dz = ez - cz;
+    const float len = std::sqrt(dx * dx + dy * dy + dz * dz);
+    dx /= len; dy /= len; dz /= len;
+    return std::acos(std::clamp(nx * dx + ny * dy + nz * dz, -1.f, 1.f)) * 180.f / kPi;
+}
+
+static float poseDeltaDeg(const SPose& a, const SPose& b) {
+    float ax, ay, az, bx, by, bz;
+    normalOf(a.yaw, a.pitch, ax, ay, az);
+    normalOf(b.yaw, b.pitch, bx, by, bz);
+    return std::acos(std::clamp(ax * bx + ay * by + az * bz, -1.f, 1.f)) * 180.f / kPi;
+}
+
+int main() {
+    const float dt = 1.f / 60.f, tau = 0.2f, hyst = 0.1f;
+    // faceToward points the normal at the eye, for every direction (including straight up / down: pitch clamp).
+    for (float ex : {-3.f, 0.f, 2.f})
+        for (float ey : {-1.f, 0.f, 1.5f})
+            for (float ez : {-2.f, 0.5f, 4.f}) {
+                const auto a = faceToward(0, 0, 0, ex, ey, ez, {});
+                const float off = offAxisDeg({a.yaw, a.pitch, 0}, 0, 0, 0, ex, ey, ez);
+                const float elev = std::asin(std::fabs(ey) / std::sqrt(ex * ex + ey * ey + ez * ez));
+                check(elev > kPitchLimit || off < 0.1f, "faceToward aims the normal at the eye");
+            }
+    // lookAt is the camera convention: forward = (sin y cos p, sin p, -cos y cos p)
+    {
+        const auto l = lookAt(1, 2, 3, 4, 1, -1, 1.5f, {});
+        const float fx = std::sin(l.yaw) * std::cos(l.pitch), fy = std::sin(l.pitch), fz = -std::cos(l.yaw) * std::cos(l.pitch);
+        const float dx = 3, dy = -1, dz = -4, len = std::sqrt(dx * dx + dy * dy + dz * dz);
+        check(std::fabs(fx - dx / len) < 1e-5f && std::fabs(fy - dy / len) < 1e-5f && std::fabs(fz - dz / len) < 1e-5f, "lookAt");
+    }
+    // hysteresis: starts at <= limit, ends only beyond limit + band; limit <= 0 never faces
+    check(withinViewingDistance(2.0f, 2.f, hyst, false), "facing starts at the limit");
+    check(!withinViewingDistance(2.05f, 2.f, hyst, false), "not inside before it starts");
+    check(withinViewingDistance(2.05f, 2.f, hyst, true), "the band keeps it facing");
+    check(!withinViewingDistance(2.11f, 2.f, hyst, true), "facing ends beyond the band");
+    check(!withinViewingDistance(0.1f, 0.f, hyst, false) && !withinViewingDistance(NAN, 2.f, hyst, false), "disabled / invalid");
+
+    // A PiP placed at the origin facing +Z (the room's spawn pose), the viewer walks around it.
+    const SPose placed{0.f, 0.f, 0.f};
+    SState s;
+    SPose p = placed;
+    float maxStep = 0.f;
+    // 1) viewer 1.5 m away, 60 degrees to the side: inside 2 m -> the PiP turns to face the eye, smoothly
+    float ex = 1.5f * std::sin(60.f * kPi / 180.f), ey = 0.3f, ez = 1.5f * std::cos(60.f * kPi / 180.f);
+    check(offAxisDeg(p, 0, 0, 0, ex, ey, ez) > 55.f, "precondition: the placed pose does not face the side viewer");
+    for (int i = 0; i < 120; ++i) {
+        const SPose before = p;
+        step(s, p, 0, 0, 0, ex, ey, ez, 2.f, hyst, tau, dt);
+        maxStep = std::max(maxStep, poseDeltaDeg(before, p));
+    }
+    check(offAxisDeg(p, 0, 0, 0, ex, ey, ez) < 0.5f, "inside the viewing distance the normal faces the camera");
+    check(maxStep < 6.f, "no snapping: <= 6 deg per 60 Hz frame for a 61 deg turn (tau 0.2 s)");
+    // 2) the viewer keeps moving (orbiting at 1.2 m): the PiP follows, lagging only by the ease
+    float worstFollow = 0.f;
+    for (int i = 0; i < 240; ++i) {
+        const float ang = (60.f - i * 0.25f) * kPi / 180.f;
+        ex = 1.2f * std::sin(ang); ez = 1.2f * std::cos(ang); ey = 0.2f;
+        step(s, p, 0, 0, 0, ex, ey, ez, 2.f, hyst, tau, dt);
+        if (i > 60)
+            worstFollow = std::max(worstFollow, offAxisDeg(p, 0, 0, 0, ex, ey, ez));
+    }
+    check(worstFollow < 4.f, "follows the moving camera (steady-state lag < 4 deg at 15 deg/s)");
+    // 3) the viewer leaves (3 m, outside 2 m + band): the PiP eases back to the pose it was placed with
+    ex = 3.f * std::sin(1.f); ez = 3.f * std::cos(1.f); ey = 0.f;
+    maxStep = 0.f;
+    for (int i = 0; i < 180; ++i) {
+        const SPose before = p;
+        step(s, p, 0, 0, 0, ex, ey, ez, 2.f, hyst, tau, dt);
+        maxStep = std::max(maxStep, poseDeltaDeg(before, p));
+    }
+    check(poseDeltaDeg(p, placed) < 0.05f, "outside the viewing distance it returns to its placed pose");
+    check(offAxisDeg(p, 0, 0, 0, ex, ey, ez) > 50.f, "NEGATIVE: outside the distance it does not face the camera");
+    check(maxStep < 6.f, "the return is eased too");
+    // 4) Theatre distance: 3 m faces with a 4 m limit, not with the 2 m one
+    {
+        SState a, b;
+        SPose pa = placed, pb = placed;
+        for (int i = 0; i < 240; ++i) {
+            step(a, pa, 0, 0, 0, ex, ey, ez, 4.f, hyst, tau, dt);
+            step(b, pb, 0, 0, 0, ex, ey, ez, 2.f, hyst, tau, dt);
+        }
+        check(offAxisDeg(pa, 0, 0, 0, ex, ey, ez) < 0.5f, "Theatre 4 m: faces a viewer at 3 m");
+        check(poseDeltaDeg(pb, placed) < 1e-3f, "regular 2 m: a viewer at 3 m leaves the PiP as placed");
+    }
+    // 5) another writer re-places the window (Theatre / restore): it becomes the new base, approached smoothly
+    {
+        SState c;
+        SPose pc = placed;
+        step(c, pc, 0, 0, 0, 0, 0, 5, 2.f, hyst, tau, dt); // far viewer: settles on the placed pose
+        SPose moved{1.0f, 0.2f, 0.f};
+        pc = moved;
+        step(c, pc, 0, 0, 0, 0, 0, 5, 2.f, hyst, tau, dt);
+        check(poseDeltaDeg(pc, placed) < 6.f, "a new base is eased toward, not jumped to");
+        for (int i = 0; i < 200; ++i)
+            step(c, pc, 0, 0, 0, 0, 0, 5, 2.f, hyst, tau, dt);
+        check(poseDeltaDeg(pc, moved) < 0.05f, "and becomes the rest pose");
+        // adopt(): a drag owns the pose; it becomes the base and facing restarts from outside
+        c.facing = true;
+        adopt(c, SPose{0.5f, 0.f, 0.f});
+        check(!c.facing && samePose(c.base, SPose{0.5f, 0.f, 0.f}), "adopt");
+    }
+    // 6) NEGATIVE control of the smoothing itself: an un-eased (snapping) follow fails the per-frame bound
+    check(easeAlpha(dt, tau) < 0.1f && easeAlpha(1.0f, tau) < 0.40f && easeAlpha(0.f, tau) == 0.f,
+          "eased: a 60 Hz frame covers < 10 % of the gap; a 1 s stall is clamped to one 0.1 s step");
+    std::cout << "face-viewer: facing inside the distance, follow, eased return, Theatre limit, hysteresis, look-at passed\n";
+    return 0;
+}
