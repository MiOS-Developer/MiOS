+static SDispatchResult dispatchClick(std::string args) {
+    while (!args.empty() && std::isspace(static_cast<unsigned char>(args.front())))
+        args.erase(args.begin());
+    while (!args.empty() && std::isspace(static_cast<unsigned char>(args.back())))
+        args.pop_back();
+    if (!ownsInput())
+        return {.success = false, .error = "hypr3d not active or not owning input"};
+
+    uint32_t btn = BTN_LEFT;
+    if (args.find("right") != std::string::npos || args.find("alt") != std::string::npos || args.find("2") != std::string::npos)
+        btn = BTN_RIGHT;
+    else if (args.find("middle") != std::string::npos || args.find("3") != std::string::npos)
+        btn = BTN_MIDDLE;
+
+    if (args.find("down") != std::string::npos || args.find("press") != std::string::npos) {
+        vcClickButton(btn, true);
+    } else if (args.find("up") != std::string::npos || args.find("release") != std::string::npos) {
+        vcClickButton(btn, false);
+    } else {
+        vcClickButton(btn, true);
+        vcClickButton(btn, false);
+    }
+    return {};
+}
