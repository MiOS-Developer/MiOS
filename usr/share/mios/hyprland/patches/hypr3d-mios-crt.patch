+        std::string cmd = "sh -c 'CHOICE=$(printf \"" + inputList + "\" | (wofi --dmenu -p \"Hypr3D ShaderGlass Window\" 2>/dev/null || rofi -dmenu -p \"Hypr3D ShaderGlass Window\" 2>/dev/null || zenity --list --column=\"Windows\" --title=\"Hypr3D ShaderGlass Window\" 2>/dev/null) | awk \"{print \\$1}\"); if [ -n \"$CHOICE\" ]; then hyprctl dispatch hypr3d:crt \"$CHOICE\"; fi' &";
+        system(cmd.c_str());
+    } else {
+        cycleCrtPreset();
+    }
+}
