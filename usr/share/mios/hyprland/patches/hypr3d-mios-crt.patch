+static void toggleFullscreen2D(bool allowExit) {
+    if (!g_active)
+        return;
+
+    const auto MON = targetMonitor();
+    if (!MON)
+        return;
+
+    const auto FSW = Fullscreen::controller()->getFullscreenWindow(MON);
+    if (g_fsPhase == EFullscreenPhase::In2D ||
+        g_fsPhase == EFullscreenPhase::To2D || FSW) {
+        const auto W = FSW ? FSW : g_fsWindow.lock();
+        if (!allowExit) {
+            // North button while already in 2D fullscreen captures input to the current window
+            // rather than exiting back to 3D (L3+R3 or Super+F12 returns to 3D).
+            if (W) {
+                focusRoomWindow(W);
+                setKeyboardMode(EKeyboardMode::Window);
+                notify("[hypr3d] input captured to 2D fullscreen window (press L3+R3 or Super+F12 to return to 3D)",
+                       CHyprColor{0.2f, 0.8f, 0.4f, 1.0f});
+            }
+            damageCurrentMonitor();
+            return;
+        }
+        if (W) {
+            Fullscreen::controller()->setFullscreenMode(
+                W, Fullscreen::FSMODE_NONE, Fullscreen::FSMODE_NONE);
+        }
+        if (g_fsPhase == EFullscreenPhase::In2D ||
+            g_fsPhase == EFullscreenPhase::To2D) {
+            startTo3D();
+        }
+        notify("[hypr3d] returned from 2D fullscreen to 3D room",
+               CHyprColor{0.2f, 0.8f, 0.4f, 1.0f});
+        damageCurrentMonitor();
+        return;
+    }
+
+    if (!ownsInput())
+        return;
+
+    std::uintptr_t targetId = 0;
+    if (pointerFree() && g_vcId != 0 && g_world.find(g_vcId)) {
+        targetId = g_vcId;
+    } else {
+        const auto HIT = aimHit();
+        if (HIT.hit && g_world.find(HIT.id))
+            targetId = HIT.id;
+    }
+    if (targetId == 0)
+        targetId = targetCrtWindow();
+    if (targetId == 0)
+        return;
+
+    const auto W = Compat::findWindowById(targetId);
+    if (!W)
+        return;
+
+    focusRoomWindow(W);
+    startTo2D(W, /*captureRestoreBox=*/true);
+    Fullscreen::controller()->setFullscreenMode(
+        W, Fullscreen::FSMODE_FULLSCREEN, Fullscreen::FSMODE_FULLSCREEN);
+    notify("[hypr3d] fullscreened window in 2D (press L3+R3 or Super+F12 to return to 3D)",
+           CHyprColor{0.2f, 0.8f, 0.4f, 1.0f});
+    damageCurrentMonitor();
+}
