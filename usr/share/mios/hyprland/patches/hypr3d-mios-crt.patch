+static void triggerJump() {
+    if (!ownsInput())
+        return;
+    if (g_playerFlying)
+        return;
+    if (g_playerPosture != EPlayerPosture::Stand) {
+        g_playerPosture = EPlayerPosture::Stand;
+        notify("[hypr3d] posture: stand", CHyprColor{0.2f, 0.8f, 0.4f, 1.0f});
+        damageCurrentMonitor();
+    }
+    if (g_grounded || !g_playerBody.IsInvalid())
+        g_playerJumpQueued = true;
+    damageCurrentMonitor();
+}
+
+static void toggleFlyMode(const std::string& arg) {
+    if (!ownsInput())
+        return;
+
+    if (arg == "on" || arg == "1" || arg == "fly" || arg == "hover" || arg == "true") {
+        g_playerFlying = true;
+    } else if (arg == "off" || arg == "0" || arg == "walk" || arg == "gravity" || arg == "false") {
+        g_playerFlying = false;
+    } else {
+        g_playerFlying = !g_playerFlying;
+    }
+
+    if (g_playerFlying) {
+        g_playerPosture = EPlayerPosture::Stand;
+        g_playerJumpQueued = false;
+        if (!g_playerBody.IsInvalid() && g_bodyIf) {
+            g_bodyIf->SetGravityFactor(g_playerBody, 0.0f);
+            g_bodyIf->SetLinearVelocity(g_playerBody, JPH::Vec3::sZero());
+        }
+        notify("[hypr3d] movement: flying / hover mode (South=Up, West=Down)",
+               CHyprColor{0.2f, 0.8f, 0.9f, 1.0f});
+    } else {
+        g_analogVertical = 0.0f;
+        if (!g_playerBody.IsInvalid() && g_bodyIf) {
+            g_bodyIf->SetGravityFactor(g_playerBody, 1.0f);
+            g_bodyIf->ActivateBody(g_playerBody);
+        }
+        notify("[hypr3d] movement: gravity / walking mode",
+               CHyprColor{0.2f, 0.8f, 0.4f, 1.0f});
+    }
+    damageCurrentMonitor();
+}
