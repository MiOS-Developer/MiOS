+static void cyclePosture(const std::string& arg) {
+    if (!ownsInput())
+        return;
+
+    if (g_playerFlying)
+        return;
+
+    if (arg == "stand" || arg == "0") {
+        g_playerPosture = EPlayerPosture::Stand;
+    } else if (arg == "crouch" || arg == "1") {
+        g_playerPosture = EPlayerPosture::Crouch;
+    } else if (arg == "sit" || arg == "2") {
+        g_playerPosture = EPlayerPosture::Sit;
+    } else {
+        switch (g_playerPosture) {
+            case EPlayerPosture::Stand:  g_playerPosture = EPlayerPosture::Crouch; break;
+            case EPlayerPosture::Crouch: g_playerPosture = EPlayerPosture::Sit;    break;
+            case EPlayerPosture::Sit:    g_playerPosture = EPlayerPosture::Stand;  break;
+        }
+    }
+
+    const char* name =
+        (g_playerPosture == EPlayerPosture::Crouch) ? "crouch" :
+        (g_playerPosture == EPlayerPosture::Sit)    ? "sit" :
+                                                      "stand";
+    notify(std::string("[hypr3d] posture: ") + name,
+           CHyprColor{0.2f, 0.8f, 0.4f, 1.0f});
+    damageCurrentMonitor();
+}
