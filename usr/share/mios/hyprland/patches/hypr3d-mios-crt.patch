+        std::ostringstream ss;
+        ss << "0x" << std::hex << entity.id << " " << cls << " \xe2\x80\x94 " << title;
+        entries.emplace_back(entity.id, ss.str());
+    }
+
+    if (entries.empty())
+        return;
+
+    bool hasMenu = false;
+    for (const char* tool : {"wofi", "rofi", "zenity"}) {
+        std::string checkCmd = std::string("which ") + tool + " >/dev/null 2>&1";
+        if (system(checkCmd.c_str()) == 0) {
+            hasMenu = true;
+            break;
+        }
+    }
+
+    if (hasMenu) {
+        std::string inputList;
+        for (const auto& entry : entries) {
+            inputList += entry.second + "\\n";
