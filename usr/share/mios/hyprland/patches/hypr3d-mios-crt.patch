+static bool handleHyprbarsClick3D(const PHLWINDOW& W, const Vector2D& rawLocal, uint32_t button = BTN_LEFT) {
+    if (!W)
+        return false;
+    // Protruding 28px-tall hyprbars glass tab lives above the surface top edge
+    // (rawLocal.y in [-28..0], rawLocal.x in [42..130]), with generous touch/click padding.
+    if (rawLocal.y <= 10.0 && rawLocal.y >= -34.0 && rawLocal.x >= 28.0 && rawLocal.x <= 144.0) {
+        focusRoomWindow(W);
+        const std::uintptr_t id = Compat::windowId(W);
+        std::ostringstream addr;
+        addr << "address:0x" << std::hex << id;
+        if (rawLocal.x < 73.0) {
+            // Button 0 (Close): Left-Click = graceful close, Right-Click = force kill (SIGKILL)
+            if (button == BTN_RIGHT) {
+                (void)Config::Actions::signalWindow(SIGKILL, W);
+                (void)Config::Actions::closeWindow(W);
+            } else {
+                (void)Config::Actions::closeWindow(W);
+            }
+        } else if (rawLocal.x < 99.0) {
+            // Button 1 (Minimize): Left-Click = animated 3D minimize, Right-Click = instant minimize
+            if (button == BTN_RIGHT)
+                g_skipCloseAnim3D.insert(id);
+            HyprlandAPI::invokeHyprctlCommand("dispatch",
+                "hl.dsp.window.move({workspace = \"special:minimized\", window = \"" + addr.str() + "\", follow = false})");
+        } else {
+            // Button 2 (Maximize): Right-Click = Fullscreen (2D) Mode (Super + F11), Left-Click = 3D Maximize / Restore
+            if (button == BTN_RIGHT || g_fsPhase == EFullscreenPhase::In2D || g_fsPhase == EFullscreenPhase::To2D) {
+                toggleFullscreen2D(/*allowExit=*/true);
+            } else if (const auto MON = targetMonitor()) {
+                const CBox   curBox  = Compat::currentWindowBox(W);
+                const double maxW    = std::round(MON->m_size.x * 0.82);
+                const double maxH    = std::round(MON->m_size.y * 0.82);
+                const bool   isMax3D = (curBox.w >= maxW - 24.0 && curBox.h >= maxH - 24.0);
+                CBox         targetBox{};
+                if (isMax3D) {
+                    const auto   it    = g_preMax3DBoxes.find(id);
+                    const double restW = (it != g_preMax3DBoxes.end() && it->second.w >= 240.0 && it->second.w < maxW - 24.0) ?
+                        it->second.w :
+                        static_cast<double>(g_cfgSpawnWidth);
+                    const double restH = (it != g_preMax3DBoxes.end() && it->second.h >= 160.0 && it->second.h < maxH - 24.0) ?
+                        it->second.h :
+                        static_cast<double>(g_cfgSpawnHeight);
+                    targetBox = CBox{
+                        MON->m_position.x + std::round((MON->m_size.x - restW) * 0.5),
+                        MON->m_position.y + std::max(48.0, std::round((MON->m_size.y - restH) * 0.5)),
+                        restW,
+                        restH
+                    };
+                } else {
+                    g_preMax3DBoxes[id] = curBox;
+                    targetBox = CBox{
+                        MON->m_position.x + std::round((MON->m_size.x - maxW) * 0.5),
+                        MON->m_position.y + std::max(48.0, std::round((MON->m_size.y - maxH) * 0.5)),
+                        maxW,
+                        maxH
+                    };
+                }
+                Compat::driveWindowBox(W, targetBox);
+                g_boxDriven.insert(id);
+                g_roomBoxes[id] = CBox{targetBox.x - MON->m_position.x, targetBox.y - MON->m_position.y, targetBox.w, targetBox.h};
+                g_skirtFinalRefreshId = id;
+            }
+        }
+        damageCurrentMonitor();
+        return true;
+    }
+    return false;
+}
