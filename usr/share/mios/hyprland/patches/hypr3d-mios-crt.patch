+static void toggleCursorCameraMode(const std::string& arg) {
+    if (!ownsInput())
+        return;
+
+    if (arg == "cursor" || arg == "window" || arg == "1") {
+        setKeyboardMode(EKeyboardMode::Window);
+    } else if (arg == "camera" || arg == "space" || arg == "0") {
+        setKeyboardMode(EKeyboardMode::Space);
+    } else {
+        setKeyboardMode(g_keyboardMode == EKeyboardMode::Window ?
+                            EKeyboardMode::Space :
+                            EKeyboardMode::Window);
+    }
+}
