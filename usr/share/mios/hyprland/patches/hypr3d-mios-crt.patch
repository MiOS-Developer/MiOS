+static void vcClickButton(uint32_t button, bool pressed) {
+    if (!ownsInput())
+        return;
+
+    const uint32_t nowMs = inputTimeMs();
+
+    if (!pressed) {
+        if (g_clientButtonDown && button == g_clientButton)
+            finishClientButton(nowMs);
+        damageCurrentMonitor();
+        return;
+    }
+
+    if (g_clientButtonDown)
+        finishClientButton(nowMs);
+
+    if (pointerFree()) {
+        const auto MON = targetMonitor();
+        if (MON && g_vcSpace == ECursorSpace::Screen)
+            vcResolveScreen(MON);
+
+        if (g_vcId != 0) {
+            const auto* E = g_world.find(g_vcId);
+            const auto TARGET = targetFromHit(g_vcId);
+            if (E && (TARGET.window || TARGET.layer)) {
+                const auto LOCAL = surfaceLocal(*E, g_vcLocal);
+                const Vector2D RAW_LOCAL{g_vcLocal.x - E->surfaceOffsetX, g_vcLocal.y - E->surfaceOffsetY};
+                if ((button == BTN_LEFT || button == BTN_RIGHT) && TARGET.window && handleHyprbarsClick3D(TARGET.window, RAW_LOCAL, button))
+                    return;
+                if (TARGET.window) {
+                    Compat::focusWindow(TARGET.window);
+                    g_lastFocusId = g_vcId;
+                }
+                if (TARGET.layer)
+                    Compat::deliverClick(TARGET.layer, LOCAL, button, true, nowMs);
+                else
+                    Compat::deliverClick(TARGET.window, LOCAL, button, true, nowMs);
+                g_clientButtonWindow = TARGET.window;
+                g_clientButtonLayer  = TARGET.layer;
+                g_clientButton       = button;
+                g_clientButtonLocal  = LOCAL;
+                g_clientButtonDown   = true;
+                damageCurrentMonitor();
+                return;
+            }
+        }
+
+        if (MON && g_vcId == 0) {
+            const World3D::SHit scrHit = pickVisible(screenRay(MON, g_vcScreen));
+            if (scrHit.hit)
+                vcEnterWindow(scrHit);
+            if (g_vcId != 0) {
+                const auto* E = g_world.find(g_vcId);
+                const auto TARGET = targetFromHit(g_vcId);
+                if (E && (TARGET.window || TARGET.layer)) {
+                    const auto LOCAL = surfaceLocal(*E, g_vcLocal);
+                    const Vector2D RAW_LOCAL{g_vcLocal.x - E->surfaceOffsetX, g_vcLocal.y - E->surfaceOffsetY};
+                    if ((button == BTN_LEFT || button == BTN_RIGHT) && TARGET.window && handleHyprbarsClick3D(TARGET.window, RAW_LOCAL, button))
+                        return;
+                    if (TARGET.window) {
+                        Compat::focusWindow(TARGET.window);
+                        g_lastFocusId = g_vcId;
+                    }
+                    if (TARGET.layer)
+                        Compat::deliverClick(TARGET.layer, LOCAL, button, true, nowMs);
+                    else
+                        Compat::deliverClick(TARGET.window, LOCAL, button, true, nowMs);
+                    g_clientButtonWindow = TARGET.window;
+                    g_clientButtonLayer  = TARGET.layer;
+                    g_clientButton       = button;
+                    g_clientButtonLocal  = LOCAL;
+                    g_clientButtonDown   = true;
+                    damageCurrentMonitor();
+                    return;
+                }
+            }
+        }
+    }
+
+    const World3D::SHit HIT = aimHit();
+    const auto TARGET = HIT.hit ? targetFromHit(HIT.id) : SHitTarget{};
+    if (!TARGET.window && !TARGET.layer)
+        return;
+
+    const Vector2D LOCAL = localFromHit(HIT);
+    Vector2D RAW_LOCAL = LOCAL;
+    if (const auto* E = g_world.find(HIT.id)) {
+        RAW_LOCAL = Vector2D{
+            std::clamp(HIT.u, 0.0f, 1.0f) * E->logicalWidth - E->surfaceOffsetX,
+            std::clamp(HIT.v, 0.0f, 1.0f) * E->logicalHeight - E->surfaceOffsetY,
+        };
+    }
+    if ((button == BTN_LEFT || button == BTN_RIGHT) && TARGET.window && handleHyprbarsClick3D(TARGET.window, RAW_LOCAL, button))
+        return;
+    if (TARGET.window)
+        focusRoomWindow(TARGET.window);
+
+    if (TARGET.layer)
+        Compat::deliverClick(TARGET.layer, LOCAL, button, true, nowMs);
+    else
+        Compat::deliverClick(TARGET.window, LOCAL, button, true, nowMs);
+
+    g_clientButtonWindow = TARGET.window;
+    g_clientButtonLayer  = TARGET.layer;
+    g_clientButton       = button;
+    g_clientButtonLocal  = LOCAL;
+    g_clientButtonDown   = true;
+    damageCurrentMonitor();
+}
