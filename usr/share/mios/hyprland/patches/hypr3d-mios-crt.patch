+static bool startGrab3D() {
+    if (!ownsInput() || g_fsPhase != EFullscreenPhase::None)
+        return false;
+
+    const World3D::SHit HIT = aimHit();
+    const auto TARGET = HIT.hit ? targetFromHit(HIT.id) : SHitTarget{};
+    const auto& CAM = g_scene.camera();
+    const Vec3 DIR = CAM.centerRay();
+
+    float bestT = -1.f;
+    size_t bestIdx = SIZE_MAX;
+
+    for (size_t i = 0; i < g_sceneObjects.size(); ++i) {
+        if (!g_sceneObjects[i].dynamic)
+            continue;
+
+        const auto* MODEL = g_scene.sceneModel(i);
+        if (!MODEL || !MODEL->loaded())
+            continue;
+
+        const float T = MODEL->rayCast(CAM.position, DIR);
+        if (T > 0.f && (bestT < 0.f || T < bestT)) {
+            bestT   = T;
+            bestIdx = i;
+        }
+    }
+
+    if (bestIdx != SIZE_MAX && bestT < 0.f)
+        bestIdx = SIZE_MAX;
+    if (bestIdx != SIZE_MAX && HIT.hit && bestT >= HIT.distance)
+        bestIdx = SIZE_MAX;
+
+    if (bestIdx != SIZE_MAX) {
+        const auto* MODEL = g_scene.sceneModel(bestIdx);
+        g_mapGrabIndex = bestIdx;
+        g_mapGrabDist  = std::sqrt(
+            (MODEL->position() - CAM.position).x * (MODEL->position() - CAM.position).x +
+            (MODEL->position() - CAM.position).y * (MODEL->position() - CAM.position).y +
+            (MODEL->position() - CAM.position).z * (MODEL->position() - CAM.position).z);
+        s_modelZoomId    = SIZE_MAX;
+        g_pointerGesture = EPointerGesture::MapDrag;
+        g_pointerButton  = BTN_LEFT;
+        g_pointerDown    = true;
+        g_resize         = {};
+        damageCurrentMonitor();
+        return true;
+    }
+
+    World3D::SHit useHit = HIT;
+    SHitTarget useTarget = TARGET;
+
+    if (!useTarget.window && !useTarget.layer) {
+        const auto fallbackId = (pointerFree() && g_vcId != 0) ? g_vcId : targetCrtWindow();
+        const auto* ENTITY = fallbackId ? g_world.find(fallbackId) : nullptr;
+        if (!ENTITY)
+            return false;
+        useTarget = targetFromHit(fallbackId);
+        if (!useTarget.window && !useTarget.layer)
+            return false;
+
+        useHit.hit = true;
+        useHit.id  = fallbackId;
+        useHit.u   = 0.5f;
+        useHit.v   = 0.5f;
+        Vec3 planePt{};
+        if (!rayPlanePoint(CAM.position, DIR, ENTITY->center, g_world.normalOf(fallbackId), planePt)) {
+            const Vec3 toEnt = ENTITY->center - CAM.position;
+            const float d = std::max(0.5f, std::sqrt(dot(toEnt, toEnt)));
+            planePt = CAM.position + DIR * d;
+        }
+        useHit.point = planePt;
+        const Vec3 diff = planePt - CAM.position;
+        useHit.distance = std::sqrt(dot(diff, diff));
+    }
+
+    if (useTarget.window)
+        focusRoomWindow(useTarget.window);
+
+    if (!g_world.startDrag(useHit.id, useHit, CAM.position, CAM.forward()))
+        return false;
+
+    s_zoomId = 0;
+    if (g_fsAssertFrames > 0 && useTarget.window && useHit.id == Compat::windowId(useTarget.window)) {
+        g_fsAssertFrames = 0;
+        g_fsWindow = {};
+    }
+
+    g_pointerGesture = EPointerGesture::Move3D;
+    g_pointerButton  = BTN_LEFT;
+    g_pointerDown    = true;
+    g_resize         = {};
+    damageCurrentMonitor();
+    return true;
+}
+
+static bool startResize3D() {
+    if (!ownsInput() || g_fsPhase != EFullscreenPhase::None)
+        return false;
+
+    const auto& CAM = g_scene.camera();
+    const Vec3 DIR = CAM.centerRay();
+    World3D::SHit useHit = aimHit();
+    SHitTarget useTarget = useHit.hit ? targetFromHit(useHit.id) : SHitTarget{};
+
+    if (useTarget.window && modelInFront(CAM.position, DIR, useHit))
+        return false;
+
+    if (!useTarget.window) {
+        const auto fallbackId = (pointerFree() && g_vcId != 0) ? g_vcId : targetCrtWindow();
+        const auto* ENTITY = fallbackId ? g_world.find(fallbackId) : nullptr;
+        if (!ENTITY)
+            return false;
+        useTarget = targetFromHit(fallbackId);
+        if (!useTarget.window)
+            return false;
+
+        useHit.hit = true;
+        useHit.id  = fallbackId;
+        Vec3 planePt{};
+        if (!rayPlanePoint(CAM.position, DIR, ENTITY->center, g_world.normalOf(fallbackId), planePt)) {
+            const Vec3 toEnt = ENTITY->center - CAM.position;
+            const float d = std::max(0.5f, std::sqrt(dot(toEnt, toEnt)));
+            planePt = CAM.position + DIR * d;
+        }
+        useHit.point = planePt;
+        const Vec3 diff = planePt - CAM.position;
+        useHit.distance = std::sqrt(dot(diff, diff));
+        const Vec3 local = g_world.localPoint(fallbackId, planePt);
+        useHit.u = local.x < 0.0f ? 0.25f : 0.75f;
+        useHit.v = local.y > 0.0f ? 0.25f : 0.75f;
+    }
+
+    const auto* ENTITY = g_world.find(useHit.id);
+    if (!ENTITY || !useTarget.window)
+        return false;
+
+    focusRoomWindow(useTarget.window);
+
+    g_resize = {};
+    g_resize.active = true;
+    g_resize.id = useHit.id;
+    g_resize.window = useTarget.window;
+    g_resize.startBox = Compat::currentWindowBox(useTarget.window);
+    g_resize.startCenter = ENTITY->center;
+    g_resize.startWorldWidth = ENTITY->width;
+    g_resize.startWorldHeight = ENTITY->height;
+    g_resize.planePoint = ENTITY->center;
+    g_resize.planeNormal = g_world.normalOf(useHit.id);
+    g_resize.edgeX = useHit.u < 0.5f ? -1 : 1;
+    g_resize.edgeY = useHit.v < 0.5f ? 1 : -1;
+    g_resize.grabPx = worldPointToGlobalPx(targetMonitor(), useHit.point);
+
+    g_pointerGesture = EPointerGesture::ResizeReal;
+    g_pointerButton  = BTN_RIGHT;
+    g_pointerDown    = true;
+    damageCurrentMonitor();
+    return true;
+}
