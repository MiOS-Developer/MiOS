+static void cycleCrtPreset() {
+    g_crtPresetIdx = (g_crtPresetIdx + 1) % kCrtPresets.size();
+    const auto& P = kCrtPresets[g_crtPresetIdx];
+
+    g_crtGlobalOn = true;
+    const auto target = targetCrtWindow();
+    if (target != 0 && !g_crtWindows.contains(target))
+        g_crtWindows.insert(target);
+    for (const auto& entity : g_world.entities())
+        g_crtWindows.insert(entity.id);
+
+    applyGlobalShaderGlassState(true);
+    notify(std::string("[hypr3d] ShaderGlass preset: ") + P.name,
+           CHyprColor{0.4f, 0.8f, 0.4f, 1.0f});
+}
