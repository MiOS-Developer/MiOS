+static SDispatchResult dispatchGrab(std::string args) {
+    while (!args.empty() && std::isspace(static_cast<unsigned char>(args.front())))
+        args.erase(args.begin());
+    while (!args.empty() && std::isspace(static_cast<unsigned char>(args.back())))
+        args.pop_back();
+
+    const bool grabHeld = g_pointerDown &&
+        (g_pointerGesture == EPointerGesture::Move3D || g_pointerGesture == EPointerGesture::MapDrag);
+
+    if (args == "up" || args == "release" || args == "0" || args == "stop" || args == "off") {
+        if (grabHeld) {
+            resetPointerGesture();
+            damageCurrentMonitor();
+        }
+        return {};
+    }
+
+    if (args == "down" || args == "press" || args == "1" || args == "start" || args == "on") {
+        if (!ownsInput())
+            return {.success = false, .error = "hypr3d not active or not owning input"};
+        if (grabHeld)
+            return {};
+        if (!startGrab3D())
+            return {.success = false, .error = "hypr3d:grab could not start window grab"};
+        return {};
+    }
+
+    if (args.empty() || args == "toggle") {
+        if (grabHeld) {
+            resetPointerGesture();
+            damageCurrentMonitor();
+            return {};
+        }
+        if (!ownsInput())
+            return {.success = false, .error = "hypr3d not active or not owning input"};
+        if (!startGrab3D())
+            return {.success = false, .error = "hypr3d:grab could not start window grab"};
+        return {};
+    }
+
+    return {.success = false, .error = "unknown hypr3d:grab argument: " + args};
+}
+
+static SDispatchResult dispatchResize(std::string args) {
+    while (!args.empty() && std::isspace(static_cast<unsigned char>(args.front())))
+        args.erase(args.begin());
+    while (!args.empty() && std::isspace(static_cast<unsigned char>(args.back())))
+        args.pop_back();
+
+    const bool resizeHeld = g_pointerDown && g_pointerGesture == EPointerGesture::ResizeReal;
+
+    if (args == "up" || args == "release" || args == "0" || args == "stop" || args == "off") {
+        if (resizeHeld) {
+            resetPointerGesture();
+            damageCurrentMonitor();
+        }
+        return {};
+    }
+
+    if (args == "down" || args == "press" || args == "1" || args == "start" || args == "on") {
+        if (!ownsInput())
+            return {.success = false, .error = "hypr3d not active or not owning input"};
+        if (resizeHeld)
+            return {};
+        if (!startResize3D())
+            return {.success = false, .error = "hypr3d:resize could not start window resize"};
+        return {};
+    }
+
+    if (args.empty() || args == "toggle") {
+        if (resizeHeld) {
+            resetPointerGesture();
+            damageCurrentMonitor();
+            return {};
+        }
+        if (!ownsInput())
+            return {.success = false, .error = "hypr3d not active or not owning input"};
+        if (!startResize3D())
+            return {.success = false, .error = "hypr3d:resize could not start window resize"};
+        return {};
+    }
+
+    return {.success = false, .error = "unknown hypr3d:resize argument: " + args};
+}
