+static void syncShaderGlassStateFromFile() {
+    std::ifstream st("/tmp/mios-hypr3d-crt.state");
+    if (!st)
+        return;
+    std::string line;
+    bool sawGlobal = false;
+    bool globalVal = false;
+    bool activeVal = false;
+    bool sawTargets = false;
+    std::unordered_set<std::uintptr_t> fileTargets;
+    while (std::getline(st, line)) {
+        if (line.rfind("global=", 0) == 0) {
+            sawGlobal = true;
+            globalVal = (line.substr(7) == "1");
+        } else if (line.rfind("active=", 0) == 0) {
+            activeVal = (line.substr(7) == "1");
+        } else if (line.rfind("preset_idx=", 0) == 0) {
+            try {
+                g_crtPresetIdx = static_cast<size_t>(std::stoul(line.substr(11))) % kCrtPresets.size();
+            } catch (...) {}
+        } else if (line.rfind("targets=", 0) == 0 || line.rfind("target=", 0) == 0) {
+            sawTargets = true;
+            const auto eq = line.find('=');
+            std::string list = (eq != std::string::npos) ? line.substr(eq + 1) : "";
+            for (char& c : list) {
+                if (c == ',' || c == ';')
+                    c = ' ';
+            }
+            std::istringstream iss(list);
+            std::string tok;
+            while (iss >> tok) {
+                try {
+                    const std::uintptr_t wid = std::stoull(tok, nullptr, 16);
+                    if (wid != 0)
+                        fileTargets.insert(wid);
+                } catch (...) {}
+            }
+        }
+    }
+    if (sawTargets)
+        g_crtWindows = std::move(fileTargets); // targets are a snapshot; removed windows must detach
+    if (sawGlobal)
+        g_crtGlobalOn = globalVal;
+    else if (activeVal && !sawTargets) {
+        g_crtGlobalOn = true;
+    }
+}
+
+static void applyGlobalShaderGlassState(bool writeState) {
+    if (!writeState)
+        syncShaderGlassStateFromFile();
+
+    const auto& P = kCrtPresets[g_crtPresetIdx % kCrtPresets.size()];
+    auto q = g_scene.renderQuality();
+    q.crtCurvature      = P.curvature;
+    q.crtRadius         = P.radius;
+    q.crtScanlines      = P.scanlines;
+    q.crtScanlineWeight = P.scanlineWeight;
+    q.crtDotmask        = P.dotmask;
+    g_scene.setRenderQuality(q);
+
+    if (writeState) {
+        const bool anyActive = g_crtGlobalOn || !g_crtWindows.empty();
+        std::ofstream st("/tmp/mios-hypr3d-crt.state", std::ios::trunc);
+        if (st) {
+            st << "active=" << (anyActive ? 1 : 0) << "\n"
+               << "global=" << (g_crtGlobalOn ? 1 : 0) << "\n"
+               << "preset=" << P.name << "\n"
+               << "preset_idx=" << g_crtPresetIdx << "\n"
+               << "targets=";
+            bool first = true;
+            for (const auto wid : g_crtWindows) {
+                if (!first)
+                    st << ",";
+                st << "0x" << std::hex << wid << std::dec;
+                first = false;
+            }
+            st << "\n";
+        }
+        std::ofstream hst("/tmp/hypr3d-status.txt", std::ios::app);
+        if (hst) {
+            hst << "crtGlobal=" << (g_crtGlobalOn ? 1 : 0)
+                << " crtPreset=" << P.name
+                << " crtWindows=" << (g_crtGlobalOn ? std::max<size_t>(1, g_crtWindows.size()) : g_crtWindows.size()) << "\n";
+        }
+    }
