+static SDispatchResult dispatchCamera(std::string args) {
+    if (!ownsInput())
+        return {.success = false, .error = "hypr3d not active or not owning input"};
+
+    if (args.find("stop") != std::string::npos || args.find("reset") != std::string::npos) {
+        g_analogLookX = 0.0f;
+        g_analogLookY = 0.0f;
+        g_input.reset();
+        damageCurrentMonitor();
+        return {};
+    }
+
+    for (char& c : args) {
+        if (c == ',')
+            c = ' ';
+    }
+    std::istringstream iss(args);
+    double dx = 0.0, dy = 0.0;
+    if (!(iss >> dx >> dy))
+        return {.success = false, .error = "hypr3d:camera requires dx and dy arguments"};
+
+    if (std::fabs(dx) <= 2.0 && std::fabs(dy) <= 2.0) {
+        if (dx == 0.0 && dy == 0.0) {
+            g_input.reset();
+            damageCurrentMonitor();
+            return {};
+        }
+        dx *= 16.0;
+        dy *= 16.0;
+    }
+
+    if (pointerFree()) {
+        vcMove(dx, dy);
+    } else {
+        g_input.addMotion(dx, dy);
+    }
+    damageCurrentMonitor();
+    return {};
+}
+
+static SDispatchResult dispatchMove(std::string args) {
+    if (!ownsInput())
+        return {.success = false, .error = "hypr3d not active or not owning input"};
+
+    for (char& c : args) {
+        if (c == ',')
+            c = ' ';
+    }
+    std::istringstream iss(args);
+    float val1 = 0.0f, val2 = 0.0f;
+    if (iss >> val1) {
+        if (iss >> val2) {
+            g_analogStrafe = std::clamp(val1, -1.0f, 1.0f);
+            g_analogFwd    = std::clamp(-val2, -1.0f, 1.0f);
+        } else {
+            g_analogFwd    = std::clamp(val1, -1.0f, 1.0f);
+            g_analogStrafe = 0.0f;
+        }
+        g_lastAnalogMoveTime = std::chrono::steady_clock::now();
+        if (std::fabs(g_analogStrafe) < 0.001f && std::fabs(g_analogFwd) < 0.001f) {
+            g_analogStrafe = 0.0f;
+            g_analogFwd    = 0.0f;
+            s_moveVel      = {};
+        }
+        damageCurrentMonitor();
+        return {};
+    }
+
+    if (args.find("stop") != std::string::npos || args.find("reset") != std::string::npos) {
+        g_analogFwd    = 0.0f;
+        g_analogStrafe = 0.0f;
+        s_moveVel      = {};
+        damageCurrentMonitor();
+        return {};
+    }
+
+    return {.success = false, .error = "hypr3d:move requires <lx> <ly> or 'stop'"};
+}
+
+static SDispatchResult dispatchCrt(std::string args) {
+    while (!args.empty() && std::isspace(static_cast<unsigned char>(args.front())))
+        args.erase(args.begin());
+    while (!args.empty() && std::isspace(static_cast<unsigned char>(args.back())))
+        args.pop_back();
+
+    if (args.empty() || args == "toggle" || args == "active") {
+        toggleWindowCrt(targetCrtWindow());
+        return {};
+    }
+
+    if (args == "select" || args == "picker") {
+        selectWindowCrt();
+        return {};
+    }
+
+    if (args == "cycle" || args == "preset" || args == "next") {
+        cycleCrtPreset();
+        return {};
+    }
+
+    if (args == "all" || args == "on") {
+        g_crtGlobalOn = true;
+        for (const auto& entity : g_world.entities()) {
+            g_crtWindows.insert(entity.id);
+        }
+        applyGlobalShaderGlassState(true);
+        notify("[hypr3d] ShaderGlass CRT enabled globally",
+               CHyprColor{0.4f, 0.8f, 0.4f, 1.0f});
+        return {};
+    }
+
+    if (args == "off" || args == "clear") {
+        g_crtGlobalOn = false;
+        g_crtWindows.clear();
+        applyGlobalShaderGlassState(true);
+        notify("[hypr3d] ShaderGlass CRT disabled globally",
+               CHyprColor{0.4f, 0.8f, 0.4f, 1.0f});
+        return {};
+    }
+
+    std::string subcmd;
+    std::string hexStr = args;
+    if (args.rfind("on ", 0) == 0) {
+        subcmd = "on";
+        hexStr = args.substr(3);
+    } else if (args.rfind("off ", 0) == 0) {
+        subcmd = "off";
+        hexStr = args.substr(4);
+    } else if (args.rfind("toggle ", 0) == 0) {
+        subcmd = "toggle";
+        hexStr = args.substr(7);
+    }
+
+    while (!hexStr.empty() && std::isspace(static_cast<unsigned char>(hexStr.front())))
+        hexStr.erase(hexStr.begin());
+
+    try {
+        std::uintptr_t winId = std::stoull(hexStr, nullptr, 16);
+        if (winId != 0) {
+            if (subcmd == "on") {
+                g_crtWindows.insert(winId);
+                applyGlobalShaderGlassState(true);
+                notify("[hypr3d] ShaderGlass CRT enabled on window", CHyprColor{0.4f, 0.8f, 0.4f, 1.0f});
+            } else if (subcmd == "off") {
+                g_crtWindows.erase(winId);
+                applyGlobalShaderGlassState(true);
+                notify("[hypr3d] ShaderGlass CRT disabled on window", CHyprColor{0.4f, 0.8f, 0.4f, 1.0f});
+            } else {
+                toggleWindowCrt(winId);
+            }
+            return {};
+        }
+    } catch (...) {
+    }
+
+    return {.success = false, .error = "unknown hypr3d:crt command: " + args};
+}
