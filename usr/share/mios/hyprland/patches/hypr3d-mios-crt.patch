+static void cycleCameraViewMode(const std::string& arg) {
+    if (!ownsInput())
+        return;
+
+    if (arg == "0" || arg == "first" || arg == "fp") {
+        g_viewMode = 0;
+    } else if (arg == "1" || arg == "third" || arg == "behind") {
+        g_viewMode = 1;
+    } else if (arg == "2" || arg == "front" || arg == "mirror") {
+        g_viewMode = 2;
+    } else {
+        g_viewMode = (g_viewMode + 1) % 3;
+    }
+
+    g_scene.camera().mirrorView = (g_viewMode == 2);
+    g_scene.setPlayerVisible(g_viewMode != 0);
+
+    const char* modeName =
+        (g_viewMode == 0) ? "first person" :
+        (g_viewMode == 1) ? "third person (behind)" :
+                            "third person (front)";
+    notify(std::string("[hypr3d] camera view: ") + modeName,
+           CHyprColor{0.2f, 0.8f, 0.4f, 1.0f});
+    damageCurrentMonitor();
+}
