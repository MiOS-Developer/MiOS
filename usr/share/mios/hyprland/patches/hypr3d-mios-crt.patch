+    in.read(reinterpret_cast<char*>(&pkt), sizeof(pkt));
+    if (in.gcount() < 44 ||
+        pkt.magic != 0x4D493344u || pkt.version != 1u)
+        return;
+
+    const auto now_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            std::chrono::steady_clock::now().time_since_epoch())
+                            .count();
+    const int64_t age_ns = now_ns - pkt.timestamp_ns;
+    const bool validSeqAge = (age_ns >= -1'000'000'000LL && age_ns <= 2'000'000'000LL);
+
+    if (!s_padSeqInit) {
+        s_lastSelectSeq = pkt.select_seq;
+        s_lastStartSeq  = pkt.start_seq;
+        s_lastSouthSeq  = pkt.south_seq;
+        s_lastFlySeq    = pkt.fly_seq;
+        s_lastWestSeq   = pkt.west_seq;
+        s_lastNorthSeq  = pkt.north_seq;
+        s_lastRbSeq     = pkt.rb_seq;
+        s_lastLbSeq     = pkt.lb_seq;
+        s_padSeqInit    = true;
+    } else {
+        if (pkt.select_seq != s_lastSelectSeq) {
+            const bool increased = pkt.select_seq > s_lastSelectSeq;
+            s_lastSelectSeq = pkt.select_seq;
+            if (increased && validSeqAge)
+                cycleCameraViewMode("cycle");
+        }
+        if (pkt.start_seq != s_lastStartSeq) {
+            const bool increased = pkt.start_seq > s_lastStartSeq;
+            s_lastStartSeq = pkt.start_seq;
+            if (increased && validSeqAge)
+                toggleCursorCameraMode("toggle");
+        }
+        if (pkt.fly_seq != s_lastFlySeq) {
+            const bool increased = pkt.fly_seq > s_lastFlySeq;
+            s_lastFlySeq   = pkt.fly_seq;
+            s_lastSouthSeq = pkt.south_seq;
+            if (increased && validSeqAge)
+                toggleFlyMode("toggle");
+        } else if (pkt.south_seq != s_lastSouthSeq) {
+            const bool increased = pkt.south_seq > s_lastSouthSeq;
+            s_lastSouthSeq = pkt.south_seq;
+            if (increased && validSeqAge && !g_playerFlying)
+                triggerJump();
+        }
+        if (pkt.west_seq != s_lastWestSeq) {
+            const bool increased = pkt.west_seq > s_lastWestSeq;
+            s_lastWestSeq = pkt.west_seq;
+            if (increased && validSeqAge && !g_playerFlying)
+                cyclePosture("cycle");
+        }
+        if (pkt.north_seq != s_lastNorthSeq) {
+            const bool increased = pkt.north_seq > s_lastNorthSeq;
+            s_lastNorthSeq = pkt.north_seq;
+            if (increased && validSeqAge)
+                toggleFullscreen2D();
+        }
+        if (pkt.rb_seq != s_lastRbSeq) {
+            const bool increased = pkt.rb_seq > s_lastRbSeq;
+            s_lastRbSeq = pkt.rb_seq;
+            if (increased && validSeqAge)
+                toggleWindowCrt(targetCrtWindow());
+        }
+        if (pkt.lb_seq != s_lastLbSeq) {
+            const bool increased = pkt.lb_seq > s_lastLbSeq;
+            s_lastLbSeq = pkt.lb_seq;
+            if (increased && validSeqAge)
+                cycleCrtPreset();
+        }
+    }
+
+    const bool fresh      = (age_ns >= -1'000'000'000LL && age_ns <= 250'000'000LL);
+    const bool wantGrab   = fresh && (pkt.rt_grab != 0);
+    const bool wantResize = fresh && (pkt.lt_resize != 0);
+
+    const float newVert = (fresh && g_playerFlying)
+        ? ((pkt.south_held != 0 ? 1.0f : 0.0f) - (pkt.west_held != 0 ? 1.0f : 0.0f))
+        : 0.0f;
+    if (newVert != g_analogVertical) {
+        g_analogVertical = newVert;
+        damageCurrentMonitor();
+    } else if (g_analogVertical != 0.0f) {
+        damageCurrentMonitor();
+    }
+
+    const float lx = fresh ? std::clamp(pkt.lx, -1.0f, 1.0f) : 0.0f;
+    const float ly = fresh ? std::clamp(pkt.ly, -1.0f, 1.0f) : 0.0f;
+    const float rx = fresh ? std::clamp(pkt.rx, -1.0f, 1.0f) : 0.0f;
+    const float ry = fresh ? std::clamp(pkt.ry, -1.0f, 1.0f) : 0.0f;
+
+    // Unified Left Stick: ALWAYS drives character translation (in both Camera and Cursor modes,
+    // and while holding RT grab or LT resize).
+    const bool movingNow = (std::fabs(lx) > 0.001f || std::fabs(ly) > 0.001f);
+    if (movingNow) {
+        g_analogStrafe       = lx;
+        g_analogFwd          = -ly;
+        g_lastAnalogMoveTime = std::chrono::steady_clock::now();
+        s_padWasMoving       = true;
+        damageCurrentMonitor();
+    } else if (s_padWasMoving) {
+        g_analogStrafe = 0.0f;
+        g_analogFwd    = 0.0f;
+        s_moveVel      = {};
+        s_padWasMoving = false;
+        damageCurrentMonitor();
+    }
+
+    if (pointerFree()) {
+        if (s_padGrabActive || s_padResizeActive) {
+            s_padGrabActive   = false;
+            s_padResizeActive = false;
+            if (g_pointerDown) {
+                resetPointerGesture();
+                damageCurrentMonitor();
+            }
+        }
+        if (s_padWasLooking) {
+            g_input.reset();
+            s_padWasLooking = false;
+        }
+
+        // In Cursor Mode: RT = Main Click (BTN_LEFT), LT = Alt Click (BTN_RIGHT).
+        if (wantGrab != s_padCursorLeftActive) {
+            s_padCursorLeftActive = wantGrab;
+            vcClickButton(BTN_LEFT, wantGrab);
+        }
+        if (wantResize != s_padCursorRightActive) {
+            s_padCursorRightActive = wantResize;
+            vcClickButton(BTN_RIGHT, wantResize);
+        }
+
+        if (std::fabs(rx) > 0.001f || std::fabs(ry) > 0.001f) {
+            vcMove(static_cast<double>(rx) * 900.0 * static_cast<double>(dt),
+                   static_cast<double>(ry) * 900.0 * static_cast<double>(dt));
+            damageCurrentMonitor();
+        }
+        return;
+    }
+
+    if (s_padCursorLeftActive) {
+        s_padCursorLeftActive = false;
+        vcClickButton(BTN_LEFT, false);
+    }
+    if (s_padCursorRightActive) {
+        s_padCursorRightActive = false;
+        vcClickButton(BTN_RIGHT, false);
+    }
+
+    if (wantGrab != s_padGrabActive) {
+        s_padGrabActive = wantGrab;
+        if (wantGrab) {
+            startGrab3D();
+        } else if (g_pointerDown &&
+                   (g_pointerGesture == EPointerGesture::Move3D ||
+                    g_pointerGesture == EPointerGesture::MapDrag)) {
+            resetPointerGesture();
+            damageCurrentMonitor();
+        }
+    }
+
+    if (wantResize != s_padResizeActive) {
+        s_padResizeActive = wantResize;
+        if (wantResize) {
+            startResize3D();
+        } else if (g_pointerDown && g_pointerGesture == EPointerGesture::ResizeReal) {
+            resetPointerGesture();
+            damageCurrentMonitor();
+        }
+    }
+
+    const bool lookingNow = (std::fabs(rx) > 0.001f || std::fabs(ry) > 0.001f);
+    if (lookingNow) {
+        g_input.addMotion(static_cast<double>(rx) * 960.0 * static_cast<double>(dt),
+                          static_cast<double>(ry) * 960.0 * static_cast<double>(dt));
+        s_padWasLooking = true;
+        damageCurrentMonitor();
+    } else if (s_padWasLooking) {
+        g_input.reset();
+        s_padWasLooking = false;
+        damageCurrentMonitor();
+    }
+}
