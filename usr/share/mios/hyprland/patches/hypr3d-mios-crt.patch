+    auto surfLock = surface.lock();
+    if (!surfLock)
+        return 0;
+
+    std::uintptr_t hash = 0;
+    surfLock->breadthfirst(
+        [](SP<CWLSurfaceResource> surf, const Vector2D&, void* data) {
+            if (!surf || !surf->m_current.buffer.m_buffer)
+                return;
+            auto* h = static_cast<std::uintptr_t*>(data);
+            auto ptr = reinterpret_cast<std::uintptr_t>(surf->m_current.buffer.m_buffer.get());
+            *h = (*h * 31) ^ ptr;
+        },
+        &hash
+    );
+
+    return hash;
