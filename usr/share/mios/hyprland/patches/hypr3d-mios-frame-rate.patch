+// MiOS frame rate: the dome the glass reflects, latched on due frames (the dome itself follows world.live_fps).
+unsigned int GLScene::latchGlassEnvironment(unsigned int environment) {
+    if (!environment)
+        return 0;
+    GLint w = 0, h = 0;
+    glBindTexture(GL_TEXTURE_2D, environment);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+    if (w <= 0 || h <= 0)
