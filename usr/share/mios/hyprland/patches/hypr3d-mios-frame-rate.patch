+void GLScene::releaseGlassCache() {
+    for (auto& [k, slot] : m_glassSlots) {
+        if (slot.tex)
+            glDeleteTextures(1, &slot.tex);
+        if (slot.fbo)
+            glDeleteFramebuffers(1, &slot.fbo);
+    }
+    m_glassSlots.clear();
+    m_glassSlotBytes = 0;
+    if (m_glassEnvTex)
+        glDeleteTextures(1, &m_glassEnvTex);
+    if (m_glassEnvFBO)
+        glDeleteFramebuffers(1, &m_glassEnvFBO);
+    m_glassEnvTex = m_glassEnvFBO = 0;
+    m_glassEnvW = m_glassEnvH = 0;
+    m_glassEnvSource = 0;
+    m_glassStats.slots = 0;
+    m_glassStats.bytes = 0;
+}
