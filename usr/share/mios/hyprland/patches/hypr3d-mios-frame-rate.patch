+
+// MiOS frame rate: keep a copy of the frosted backdrop of one glass batch for the frames until the next due one.
+// Returns the slot texture, or 0 when the cache budget is spent (that batch then refreshes every frame).
+unsigned int GLScene::storeGlassSlot(uint64_t key, unsigned int source) {
+    if (!source)
+        return 0;
+    GLint w = 0, h = 0;
+    glBindTexture(GL_TEXTURE_2D, source);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+    if (w <= 0 || h <= 0)
+        return 0;
+    auto it = m_glassSlots.find(key);
+    if (it == m_glassSlots.end() || it->second.w != w || it->second.h != h) {
+        const size_t BYTES = static_cast<size_t>(w) * static_cast<size_t>(h) * 4;
+        const size_t OLD   = it == m_glassSlots.end() ? 0 : static_cast<size_t>(it->second.w) * static_cast<size_t>(it->second.h) * 4;
+        if (m_glassSlotBytes - OLD + BYTES > static_cast<size_t>(m_glassCacheMiB) << 20)
+            return 0;
+        SGlassSlotTex& slot = m_glassSlots[key];
+        if (!slot.tex) {
+            glGenTextures(1, &slot.tex);
+            glGenFramebuffers(1, &slot.fbo);
+        }
+        glBindTexture(GL_TEXTURE_2D, slot.tex);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        GLint oldDraw = 0;
+        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &oldDraw);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, slot.fbo);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, slot.tex, 0);
+        const bool COMPLETE = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(oldDraw));
+        m_glassSlotBytes = m_glassSlotBytes - OLD + BYTES;
+        slot.w = w;
+        slot.h = h;
+        if (!COMPLETE) {
+            glDeleteFramebuffers(1, &slot.fbo);
+            glDeleteTextures(1, &slot.tex);
+            m_glassSlotBytes -= BYTES;
+            m_glassSlots.erase(key);
+            return 0;
+        }
+        it = m_glassSlots.find(key);
+    }
+    if (!blitTexture(source, it->second.fbo, w, h))
+        return 0;
+    it->second.used = true;
+    m_glassStats.slots = m_glassSlots.size();
+    m_glassStats.bytes = m_glassSlotBytes;
+    return it->second.tex;
+}
