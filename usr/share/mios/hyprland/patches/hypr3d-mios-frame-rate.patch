+            glGenTextures(1, &m_glassEnvTex);
+            glGenFramebuffers(1, &m_glassEnvFBO);
+        }
+        // the dome's own sampling state (filters, wrap), so the reflection samples the copy exactly as the dome
+        GLint params[4] = {GL_LINEAR, GL_LINEAR, GL_CLAMP_TO_EDGE, GL_CLAMP_TO_EDGE};
+        const GLenum NAMES[4] = {GL_TEXTURE_MIN_FILTER, GL_TEXTURE_MAG_FILTER, GL_TEXTURE_WRAP_S, GL_TEXTURE_WRAP_T};
+        for (int k = 0; k < 4; ++k)
+            glGetTexParameteriv(GL_TEXTURE_2D, NAMES[k], &params[k]);
+        if (params[0] != GL_NEAREST && params[0] != GL_LINEAR)
+            params[0] = GL_LINEAR; // no mip chain on the copy
+        glBindTexture(GL_TEXTURE_2D, m_glassEnvTex);
+        for (int k = 0; k < 4; ++k)
+            glTexParameteri(GL_TEXTURE_2D, NAMES[k], params[k]);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        GLint oldDraw = 0;
+        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &oldDraw);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_glassEnvFBO);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_glassEnvTex, 0);
+        const bool COMPLETE = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, static_cast<GLuint>(oldDraw));
+        m_glassEnvW = COMPLETE ? w : 0;
+        m_glassEnvH = COMPLETE ? h : 0;
+        if (!COMPLETE)
+            return 0;
+    }
+    if (!blitTexture(environment, m_glassEnvFBO, w, h))
+        return 0;
+    m_glassEnvSource = environment;
+    ++m_glassStats.envLatch;
+    return m_glassEnvTex;
+}
