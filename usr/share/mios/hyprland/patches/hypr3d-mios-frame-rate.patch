+// MiOS frame rate: true on frames where the glass backdrop and reflection refresh (render.glass_fps; 0 = every
+// frame). Phase-locked deadlines (no drift); a size, scale or MSAA change invalidates every slot, so the first frame
+// after it always refreshes.
+bool GLScene::glassFrameDue() {
+    if (m_glassDropCache) {
+        releaseGlassCache();
+        m_glassDropCache = false;
+    }
+    if (m_glassFps <= 0.f)
+        return true;
+    if (m_glassKeyW != m_sceneWidth || m_glassKeyH != m_sceneHeight || m_glassKeyMsaa != m_msaaSamples ||
+        m_glassKeyScale != m_sceneScale) {
+        releaseGlassCache();
+        m_glassKeyW     = m_sceneWidth;
+        m_glassKeyH     = m_sceneHeight;
+        m_glassKeyMsaa  = m_msaaSamples;
+        m_glassKeyScale = m_sceneScale;
+        m_glassNext     = {};
+    }
+    const auto NOW    = std::chrono::steady_clock::now();
+    const auto PERIOD = std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::duration<double>(1.0 / m_glassFps));
+    if (m_glassNext.time_since_epoch().count() != 0 && NOW + std::chrono::microseconds(500) < m_glassNext)
+        return false;
+    m_glassNext = (m_glassNext.time_since_epoch().count() != 0 && NOW - m_glassNext < PERIOD) ? m_glassNext + PERIOD : NOW + PERIOD;
+    for (auto& [k, slot] : m_glassSlots)
+        slot.used = false;
+    return true;
