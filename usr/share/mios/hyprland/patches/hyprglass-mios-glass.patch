diff --git a/src/MiosGlass.cpp b/src/MiosGlass.cpp
new file mode 100644
index 0000000..dc827b6
--- /dev/null
+++ b/src/MiosGlass.cpp
@@ -0,0 +1,237 @@
+// MiOS: edge pass + shaped glass for hyprbars. See MiosGlass.hpp.
+#include "MiosGlass.hpp"
+#include "BuiltInPresets.hpp"
+#include "GlassDecoration.hpp"
+#include "GlassRenderer.hpp"
+#include "Globals.hpp"
+#include "RenderGuards.hpp"
+#include "WindowGeometry.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <GLES3/gl32.h>
+#include <hyprland/src/desktop/view/Window.hpp>
+#include <hyprland/src/managers/fullscreen/FullscreenController.hpp>
+#include <hyprland/src/render/OpenGL.hpp>
+#include <hyprland/src/render/Renderer.hpp>
+
+// ── Edge pass ────────────────────────────────────────────────────────────────
+
+CGlassEdgeDecoration::CGlassEdgeDecoration(PHLWINDOW window) : IHyprWindowDecoration(window), m_window(window) {}
+
+SDecorationPositioningInfo CGlassEdgeDecoration::getPositioningInfo() {
+    SDecorationPositioningInfo info;
+    info.priority       = 10000;
+    info.policy         = DECORATION_POSITION_ABSOLUTE;
+    info.desiredExtents = {{0, 0}, {0, 0}};
+    return info;
+}
+
+void CGlassEdgeDecoration::onPositioningReply(const SDecorationPositioningReply&) {}
+
+static bool edgePassOn() {
+    const auto& config = g_pGlobalState->config;
+    return config.edgePass && **config.edgePass > 0.0;
+}
+
+void CGlassEdgeDecoration::draw(PHLMONITOR monitor, float const&) {
+    if (!g_pGlobalState || !monitor || !edgePassOn() || RenderGuards::isForeignRender())
+        return;
+    const auto window = m_window.lock();
+    if (!window)
+        return;
+    // the pane's own enable rules (tag, global switch); an opaque window is exactly what the edge pass is for
+    const auto* glass = glassDecorationFor(window);
+    if (!glass || !glass->edgeEnabled())
+        return;
+    // into the window's own (possibly redirected: wobbly, motion) pass, over its content and under its popups
+    g_pHyprRenderer->addPassElement(makeUnique<CGlassEdgePassElement>(m_self));
+}
+
+void CGlassEdgeDecoration::renderPass(PHLMONITOR monitor) {
+    if (!g_pGlobalState || !monitor || !edgePassOn())
+        return;
+    auto& shaderManager = g_pGlobalState->shaderManager;
+    shaderManager.initializeIfNeeded();
+    if (!shaderManager.isInitialized())
+        return;
+    const auto window = m_window.lock();
+    const auto target = g_pHyprRenderer->m_renderData.currentFB;
+    if (!window || !target)
+        return;
+    auto* glass = glassDecorationFor(window);
+    if (!glass)
+        return;
+    // internal fullscreen draws unrounded at the screen edges: no window outline to light
+    if (Fullscreen::controller()->getFullscreenModes(window).internal == Fullscreen::FSMODE_FULLSCREEN)
+        return;
+    auto optBox = WindowGeometry::computeWindowBox(window, monitor);
+    if (!optBox || optBox->w < 2 || optBox->h < 2)
+        return;
+    CBox windowBox    = *optBox;
+    CBox transformBox = WindowGeometry::applyMonitorTransform(windowBox, monitor);
+
+    const auto&           config = g_pGlobalState->config;
+    const SResolveContext ctx    = {glass->presetName(), glass->isThemeDark(), config, g_pGlobalState->customPresets};
+    const float           scale  = monitor->m_scale > 0.0f ? monitor->m_scale : 1.0f;
+    const float           radius = window->rounding() * scale;
+
+    // the window's fade (open/close, workspace switch), not its active/inactive opacity: the edge sits over the
+    // content at full strength whatever the content's own opacity
+    float alpha = window->alphaTotalWithout(Desktop::View::WINDOW_ALPHA_ACTIVE);
+    if (const auto workspace = window->m_workspace; workspace && !window->m_pinned)
+        alpha *= workspace->m_alpha->value();
+    if (alpha <= 0.002f)
+        return;
+
+    GlassRenderer::SMiosGlassOptions options;
+    options.edgePass = true;
+    options.edgeGain = static_cast<float>(**config.edgePass);
+    if (config.edgePassWidth && **config.edgePassWidth > 0.0)
+        options.bezelPx = static_cast<float>(**config.edgePassWidth) * scale;
+
+    GlassRenderer::applyGlassEffect(nullptr, target, windowBox, transformBox, alpha, {radius, radius, radius, radius}, window->roundingPower(), Vector2D{},
+                                    ctx, nullptr, 0.0f, nullptr, &options);
+}
+
+eDecorationType CGlassEdgeDecoration::getDecorationType() {
+    return DECORATION_CUSTOM;
+}
+
+void CGlassEdgeDecoration::updateWindow(PHLWINDOW) {
+    damageEntire();
+}
+
+void CGlassEdgeDecoration::damageEntire() {
+    const auto window = m_window.lock();
+    if (!window)
+        return;
+    if (const auto box = WindowGeometry::computePaddedGlobalBox(window, 0.0f))
+        g_pHyprRenderer->damageBox(*box);
+}
+
+eDecorationLayer CGlassEdgeDecoration::getDecorationLayer() {
+    return DECORATION_LAYER_OVER;
+}
+
+uint64_t CGlassEdgeDecoration::getDecorationFlags() {
+    return DECORATION_NON_SOLID;
+}
+
+std::string CGlassEdgeDecoration::getDisplayName() {
+    return "HyprGlassEdge";
+}
+
+PHLWINDOW CGlassEdgeDecoration::getOwner() {
+    return m_window.lock();
+}
+
+std::vector<UP<IPassElement>> CGlassEdgePassElement::draw() {
+    if (m_decoration.valid())
+        m_decoration->renderPass(g_pHyprRenderer->m_renderData.pMonitor.lock());
+    return {};
+}
+
+std::optional<CBox> CGlassEdgePassElement::boundingBox() {
+    if (!m_decoration.valid())
+        return std::nullopt;
+    const auto window  = m_decoration->getOwner();
+    const auto monitor = g_pHyprRenderer->m_renderData.pMonitor.lock();
+    auto       box     = WindowGeometry::computeWindowBox(window, monitor);
+    if (!box)
+        return std::nullopt;
+    const float scale = monitor->m_scale > 0.0f ? monitor->m_scale : 1.0f;
+    box->scale(1.0 / scale).round();
+    if (!std::isfinite(box->x) || !std::isfinite(box->y) || box->w <= 0.0 || box->h <= 0.0)
+        return std::nullopt;
+    return box;
+}
+
+// ── Shaped glass for hyprbars ────────────────────────────────────────────────
+
+extern "C" __attribute__((visibility("default"))) int mios_hyprglass_draw_shape_v1(const SMiosGlassShapeV1* s) {
+    if (!s || s->structSize < sizeof(SMiosGlassShapeV1) || !g_pGlobalState || !s->window || RenderGuards::isForeignRender())
+        return 0;
+    auto& shaderManager = g_pGlobalState->shaderManager;
+    shaderManager.initializeIfNeeded();
+    if (!shaderManager.isInitialized())
+        return 0;
+    const auto monitor = g_pHyprRenderer->m_renderData.pMonitor.lock();
+    const auto source  = g_pHyprRenderer->m_renderData.currentFB;
+    if (!monitor || !source || monitor->m_transform != WL_OUTPUT_TRANSFORM_NORMAL)
+        return 0;
+
+    CGlassDecoration* glass = nullptr;
+    for (const auto& decoration : g_pGlobalState->decorations) {
+        auto* deco = decoration.get();
+        if (deco && deco->getOwner().get() == s->window) {
+            glass = deco;
+            break;
+        }
+    }
+    if (!glass || !glass->isGlassEnabled())
+        return 0; // no glass for this window: the caller draws its own fallback
+
+    CBox box{s->box[0], s->box[1], s->box[2], s->box[3]};
+    if (!std::isfinite(box.x) || !std::isfinite(box.y) || box.w < 1.0 || box.h < 1.0 || s->alpha <= 0.002f)
+        return 1;
+
+    const SResolveContext ctx = {glass->presetName(), glass->isThemeDark(), g_pGlobalState->config, g_pGlobalState->customPresets};
+    const float blurStrength  = resolvePresetFloat(ctx, &SPresetValues::blurStrength, &SOverridableConfig::blurStrength);
+    const int   downscale     = blurStrength >= GlassRenderer::BLUR_DOWNSCALE_THRESHOLD ? GlassRenderer::BLUR_DOWNSCALE_MAX : 1;
+
+    auto&    sample = g_pGlobalState->miosShapeSamples[s->key];
+    Vector2D paddingRatio;
+    if (s->backdropFbo == 0)
+        GlassRenderer::sampleBackground(sample, source, box, paddingRatio, downscale);
+    else {
+        // the caller's padded copy of the backdrop: the same blit sampleBackground() does, from its framebuffer
+        constexpr int PAD = GlassRenderer::SAMPLE_PADDING_PX;
+        if (s->backdropPad < PAD)
+            return 0;
+        const auto map = GlassRenderer::sampleMapFor(box, downscale);
+        if (!sample)
+            sample = g_pHyprRenderer->createFB("hyprglass-mios-shape");
+        if (sample->m_size.x != map.width || sample->m_size.y != map.height || sample->m_drmFormat != source->m_drmFormat)
+            sample->alloc(map.width, map.height, source->m_drmFormat);
+        auto* gl = dynamic_cast<Render::GL::CGLFramebuffer*>(sample.get());
+        if (!gl)
+            return 0;
+        paddingRatio = Vector2D(static_cast<double>(PAD) / map.fullWidth, static_cast<double>(PAD) / map.fullHeight);
+        const int off = s->backdropPad - PAD;
+        g_pHyprOpenGL->setCapStatus(GL_SCISSOR_TEST, false);
+        if (glIsEnabled(GL_SCISSOR_TEST))
+            glDisable(GL_SCISSOR_TEST);
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, s->backdropFbo);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, gl->getFBID());
+        glBlitFramebuffer(off, off, off + map.fullWidth, off + map.fullHeight, 0, 0, map.width, map.height, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    }
+
+    float blurRadius     = blurStrength * 12.0f / downscale;
+    int   blurIterations = std::clamp(static_cast<int>(resolvePresetInt(ctx, &SPresetValues::blurIterations, &SOverridableConfig::blurIterations)), 1, 5);
+    if (ctx.config.blurFold && **ctx.config.blurFold) {
+        const auto folded = GlassRenderer::foldBlurPasses(blurRadius, blurIterations);
+        blurRadius        = folded.radius;
+        blurIterations    = folded.iterations;
+    }
+    GlassRenderer::blurBackground(sample, blurRadius, blurIterations, source);
+
+    GlassRenderer::SMiosGlassOptions options;
+    options.shapeMode    = s->shape == 1 ? 1 : 0;
+    options.tabBox       = {s->tabBox[0], s->tabBox[1], s->tabBox[2], s->tabBox[3]};
+    options.tabShape     = {s->tabShape[0], s->tabShape[1], s->tabShape[2], s->tabShape[3]};
+    options.tabSpread    = {s->tabSpread[0], s->tabSpread[1]};
+    options.tabFlip      = s->tabFlip;
+    options.sampleYClamp = {s->yClamp[0], s->yClamp[1]};
+    options.tintOverride = s->tint;
+    const float power    = s->roundingPower > 0.0f ? s->roundingPower : 2.0f;
+    CBox        drawBox  = box;
+    GlassRenderer::applyGlassEffect(sample, source, drawBox, box, std::clamp(s->alpha, 0.0f, 1.0f), {s->radii[0], s->radii[1], s->radii[2], s->radii[3]}, power,
+                                    paddingRatio, ctx, nullptr, 0.0f, nullptr, &options);
+    return 1;
+}
+
+extern "C" __attribute__((visibility("default"))) void mios_hyprglass_release_v1(uintptr_t key) {
+    if (g_pGlobalState)
+        g_pGlobalState->miosShapeSamples.erase(key);
+}
diff --git a/src/MiosGlass.hpp b/src/MiosGlass.hpp
new file mode 100644
index 0000000..7559385
--- /dev/null
+++ b/src/MiosGlass.hpp
@@ -0,0 +1,91 @@
+#pragma once
+
+// MiOS (usr/share/mios/hyprland/patches/hyprglass-mios-glass.patch): two additions that keep every window and its
+// controls on ONE glass material, the window's own hyprglass preset.
+//
+// 1. Edge pass. The glass pane is drawn UNDER a window, so an opaque client (most Flatpak/RPM apps, VM viewers,
+//    dialogs) hides it completely. CGlassEdgeDecoration draws a second pass OVER the window's content that
+//    carries only the preset's edge light along the rounded outline -- bevel ring, fresnel rim, top specular,
+//    inner shadow, same terms/colours/falloffs as the pane (Shaders.hpp, edgePass) -- at
+//    plugin:hyprglass:edge_pass x the preset strengths, falling off over plugin:hyprglass:edge_pass_width logical
+//    px. It follows the pane's enable rules (hyprglass_disabled tag, plugin:hyprglass:enabled) and nothing else:
+//    no class, opacity or float/tile state excludes a window.
+//
+// 2. Shaped glass for another plugin. mios_hyprglass_draw_shape_v1() draws this plugin's glass (sample, blur,
+//    liquidglass shader: refraction, chromatic fringe, lens, tone, tint, bevel, fresnel, specular) with the
+//    preset of a given window into an arbitrary box, as a rounded box or as the MiOS controls-tab silhouette.
+//    hyprbars (MiOS overlay patch) draws the controls tab and its buttons through it, so the tab is the window's
+//    glass, not a copy of it. Resolved per call with dlopen(RTLD_NOLOAD) + dlsym; never cached across frames.
+
+#include <cstdint>
+
+#include <hyprland/src/desktop/view/Window.hpp>
+#include <hyprland/src/render/decorations/IHyprWindowDecoration.hpp>
+#include <hyprland/src/render/pass/PassElement.hpp>
+
+extern "C" {
+// v1 contract, mirrored in the hyprbars patch. Geometry is monitor-local device px of the current render pass
+// (the box hyprbars and hyprglass both project with projectBoxToTarget); shape space is box px, y down.
+struct SMiosGlassShapeV1 {
+    uint32_t  structSize;      // sizeof(SMiosGlassShapeV1)
+    void*     window;          // CWindow* whose preset/theme the glass uses; its glass must be enabled
+    uintptr_t key;             // caller-owned cache key for the sample framebuffer
+    float     box[4];          // drawn box x, y, w, h
+    float     alpha;           // glass alpha (the caller's reveal x the window's fade)
+    int32_t   shape;           // 0 = rounded box (radii), 1 = controls tab (tab*)
+    float     radii[4];        // top-left, top-right, bottom-right, bottom-left (shape 0)
+    float     roundingPower;   // shape 0; <= 0 = 2
+    float     tabBox[4];       // centre x, y, half extents x, y
+    float     tabShape[4];     // corner radius, fillet blend width, window edge y, tab top y
+    float     tabSpread[2];    // fillet spread, merge depth below the edge
+    float     tabFlip;         // 1 = shape space mirrored vertically (inset tab)
+    float     yClamp[2];       // backdrop rows (box px) the glass may read; x > y = no limit
+    int64_t   tint;            // RRGGBBAA replacing the preset tint (alpha = strength), -1 = the preset's
+    uint32_t  backdropFbo;     // 0 = sample the current framebuffer; else a GL framebuffer holding the box
+    int32_t   backdropPad;     //   padded by this many px on every side (>= 60), e.g. with the window's shadow removed
+};
+__attribute__((visibility("default"))) int  mios_hyprglass_draw_shape_v1(const SMiosGlassShapeV1* shape);
