+// MiOS rotated outputs (hypr3d-mios-transform.patch): the 8 axis-aligned maps of
+// centred coordinates, k -> M_k (x, y): 0 (x, y), 1 (-y, x), 2 (-x, -y),
+// 3 (y, -x), 4 (-x, y), 5 (y, x), 6 (x, -y), 7 (-y, -x). miosOutputMap(t) is
+// the map from an output's BUFFER texture coordinates to its upright (logical)
+// image for wl_output_transform t; M_k^-1 = M_k^T. Measured on nested outputs
+// with every transform 0..7 (window at the work-area centre, 1:1, cascade
+// right/down): it is M_t itself (flipped-90 = (y, x), flipped-270 = (-y, -x)).
+inline int miosOutputMap(int wlTransform) {
+    return wlTransform & 7;
+}
+inline void miosApplyMap(int k, float& x, float& y, bool inverse) {
+    const float X = x, Y = y;
+    switch (k & 7) {
+        case 1: x = inverse ? Y : -Y; y = inverse ? -X : X; break;
+        case 2: x = -X; y = -Y; break;
+        case 3: x = inverse ? -Y : Y; y = inverse ? X : -X; break;
+        case 4: x = -X; break;
+        case 5: x = Y; y = X; break;
+        case 6: y = -Y; break;
+        case 7: x = -Y; y = -X; break;
+        default: break;
+    }
+}
