+        bool hit = false;
+        if (pointerFree() && g_vcSpace != ECursorSpace::Desktop && g_vcId == id) {
+            local = {g_vcLocal.x - entity->surfaceOffsetX, g_vcLocal.y - entity->surfaceOffsetY};
+            hit = true;
+        } else if (!pointerFree()) {
+            const auto aim = aimHit();
