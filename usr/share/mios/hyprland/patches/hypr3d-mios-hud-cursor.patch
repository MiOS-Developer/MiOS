+static std::array<float,48> controlStyleForWindow(std::uintptr_t id) {
+    std::array<float,48> style{};
+    const auto window=Compat::findWindowById(id);
+    if (!window || !g_pPluginSystem) return style;
+    using Reader=bool(*)(void*,float*,size_t);
+    for (const auto* plugin : g_pPluginSystem->getAllPlugins()) {
+        if (plugin->m_name != "hyprbars") continue;
+        const auto reader=reinterpret_cast<Reader>(dlsym(plugin->m_handle,"mios_hyprbars_controls_v1"));
+        if (!reader || !reader(window.get(),style.data(),style.size())) return {};
+        break;
+    }
+    if (style[2] <= 0.F || style[7] > .5F) return style;
+    const auto* entity=g_world.find(id);
+    Vector2D local; bool hit=false;
+    if (entity && pointerFree() && g_vcSpace != ECursorSpace::Desktop && g_vcId == id) {
+        local={g_vcLocal.x-entity->surfaceOffsetX,g_vcLocal.y-entity->surfaceOffsetY}; hit=true;
+    } else if (entity && !pointerFree()) {
+        const auto aim=aimHit();
+        if (aim.hit && aim.id==id) {
+            local={aim.u*entity->logicalWidth-entity->surfaceOffsetX,aim.v*entity->logicalHeight-entity->surfaceOffsetY}; hit=true;
+        }
+    }
+    if (hit) for (size_t i=0;i<3;++i) {
+        const size_t p=12+i*12;
+        if (std::hypot(local.x-style[p],local.y-style[p+1]) <= style[p+2]) style[7]=1.F;
+    }
+    return style;
+}
