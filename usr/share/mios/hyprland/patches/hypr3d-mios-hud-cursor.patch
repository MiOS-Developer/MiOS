+    const std::string mode = MODE.good() ? *MODE : "focus+proximity";
+    const auto style = controlStyleForWindow(id);
+    if (style[2] <= 0.F) return {0.F,0.F};
+    const float offset = 0.F;
+    const float radius = RADIUS.good() ? std::max(0.f, static_cast<float>(*RADIUS)) : 0.f;
+    const auto window = Compat::findWindowById(id);
+    const bool focused = window && Compat::focusedWindow() == window;
+    bool near = false;
+    if (const auto* entity = g_world.find(id)) {
