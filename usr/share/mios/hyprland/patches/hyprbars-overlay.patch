+// Cursor within reveal_radius of the tab (bar coordinates: the strip of bar_height above the window's top edge).
+// Measured against the window's GOAL geometry, not the animated one: while a window pops in, slides or wobbles
+// its current box passes the cursor and leaves it again, which would raise the tab and drop it back down, and
+// once the animation stopped nothing would damage the hidden tab to re-check until the cursor moved.
+bool CHyprBar::cursorNearTab() {
+    if (!validMapped(m_pWindow))
+        return false;
+    const auto  R       = g_pGlobalState->config.revealRadius->value();
+    const auto  HEIGHT  = g_pGlobalState->config.barHeight->value();
+    const auto  PAD     = g_pGlobalState->config.pillPadding->value();
+    const auto  BARPAD  = g_pGlobalState->config.barPadding->value();
+    const bool  RIGHT   = g_pGlobalState->config.barButtonsAlignment->value() != "left";
+    const float BUTTONS = buttonsWidth();
+    const auto  GPOS    = m_pWindow->position(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+    const auto  GSIZE   = m_pWindow->size(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+    const auto  PWS     = m_pWindow->m_workspace;
+    const auto  WSOFF   = PWS && !m_pWindow->m_pinned ? PWS->m_renderOffset->goal() : Vector2D{};
+    const float X0      = RIGHT ? GSIZE.x - BARPAD - BUTTONS - PAD : BARPAD - PAD;
+    const float X1      = X0 + BUTTONS + 2 * PAD;
+    const auto  C       = g_pInputManager->getMouseCoordsInternal() - (Vector2D{GPOS.x, GPOS.y - (m_bInset ? 0 : HEIGHT)} + WSOFF);
+    return C.x >= X0 - R && C.x <= X1 + R && C.y >= -R && C.y <= HEIGHT + R;
+}
+
+// Where the tab goes. It protrudes above the window's top-left unless that would put it
+//  - into a fullscreen window's missing headroom (fullscreen: it drops down inside the window),
+//  - off the top of the monitor,
+//  - under a layer surface that has priority (yield_layers: the status island, the dock), or
+//  - under a neighbouring window drawn above this one (a tiled window under any other tile or floating
+//    window, a floating window under a later floating one),
+// in which case it is drawn inside the window's top-left as an overlay on the window itself. Measured on
+// the GOAL geometry, like the reveal, so an animation never flips it back and forth.
+bool CHyprBar::computeInset() {
+    if (!validMapped(m_pWindow) || !g_pGlobalState->config.barOverlay->value())
+        return false;
+    const auto W = m_pWindow.lock();
+    if (Fullscreen::controller()->getFullscreenModes(W).internal == Fullscreen::FSMODE_FULLSCREEN)
+        return true;
+    if (mobileMode()) {
+        // mobile: the status pill sits in the notch between the tabs, so nothing is yielded to
+        const auto PM = W->m_monitor.lock();
+        return PM && W->position(Desktop::View::IGeometric::GEOMETRIC_GOAL).y - tabHeight() < PM->m_position.y;
+    }
+    if (!g_pGlobalState->config.tabYield->value())
+        return false;
+    const auto PMON = W->m_monitor.lock();
+    if (!PMON)
+        return false;
+
+    const double HEIGHT = g_pGlobalState->config.barHeight->value();
+    const double PAD    = g_pGlobalState->config.pillPadding->value();
+    const double BARPAD = g_pGlobalState->config.barPadding->value();
+    const bool   RIGHT  = g_pGlobalState->config.barButtonsAlignment->value() != "left";
+    const double BTNS   = buttonsWidth();
+    const auto   GPOS   = W->position(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+    const auto   GSIZE  = W->size(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+    const double FILLET = std::min((double)std::max(0.F, W->rounding()), HEIGHT) / 2.0;
+    const double X0     = GPOS.x + (RIGHT ? GSIZE.x - BARPAD - BTNS - PAD : BARPAD - PAD) - FILLET;
+    const CBox   TAB    = {X0, GPOS.y - HEIGHT, BTNS + 2 * PAD + 2 * FILLET, HEIGHT};
+
+    if (TAB.y < PMON->m_position.y)
+        return true;
+
+    // layer surfaces with priority
+    const std::string LIST = g_pGlobalState->config.yieldLayers->value();
+    if (!LIST.empty()) {
+        Hyprutils::String::CVarList names(LIST, 0, ',', true);
+        for (const auto LEVEL : {ZWLR_LAYER_SHELL_V1_LAYER_TOP, ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY}) {
+            for (auto const& lsw : PMON->m_layerSurfaceLayers[LEVEL]) {
+                const auto ls = lsw.lock();
+                if (!ls || !ls->m_mapped || ls->m_geometry.w <= 0 || ls->m_geometry.h <= 0)
+                    continue;
+                if (std::ranges::none_of(names, [&](const std::string& n) { return n == ls->m_namespace; }))
+                    continue;
+                if (!ls->m_geometry.intersection(TAB).empty())
+                    return true;
+            }
+        }
+    }
+
+    // neighbouring windows drawn above this one
+    bool seenSelf = false;
+    for (auto const& o : Desktop::windowState()->windows()) {
+        if (o == W) {
+            seenSelf = true;
+            continue;
+        }
+        if (!o->m_isMapped || o->isHidden() || o->m_workspace != W->m_workspace || o->m_monitor != W->m_monitor)
+            continue;
+        const bool ABOVE = W->m_isFloating ? (o->m_isFloating && seenSelf) : true;
+        if (!ABOVE)
+            continue;
+        const CBox OBOX = {o->position(Desktop::View::IGeometric::GEOMETRIC_GOAL), o->size(Desktop::View::IGeometric::GEOMETRIC_GOAL)};
+        if (!OBOX.intersection(TAB).empty())
+            return true;
+    }
+    return false;
+}
