+// Overlay mode: the controls are a glass tab protruding above the window's top edge at its top-left. Its
+// silhouette is a signed-distance field: a box with rounded top corners (corner = min(radius, tab height)/2)
+// smooth-unioned (polynomial smin, blend k ~ the fillet) with the half-plane of the window below its top
+// edge, so the concave fillets where the tab's sides meet the window are part of the same field and the
+// tab reads as one continuous pane with the window. Every layer is shaded from that field with smoothstep
+// coverage at device-pixel scale (no stencil, no stair-steps): tint, a top-light sheen, a faint darker inner
+// edge, and a 1px specular rim that fades out as it runs down into the window edge (never along the window
+// edge itself). The blurred backdrop is sampled at draw time and masked by the texture's alpha. `melt` 0..1
+// drives both directions: the tab's height shrinks into the edge while the fillets spread sideways and the
+// shape fades; the circles sink into the window and fade twice as fast. Never moves between windows.
+namespace {
+    double smoothstep01(double e0, double e1, double x) {
+        const double t = std::clamp((x - e0) / (e1 - e0), 0.0, 1.0);
+        return t * t * (3.0 - 2.0 * t);
+    }
+    // polynomial smooth minimum (iq): blends a and b over a band of width k
+    double smin(double a, double b, double k) {
+        if (k <= 1e-6)
+            return std::min(a, b);
+        const double h = std::clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
+        return b + (a - b) * h - k * h * (1.0 - h);
+    }
+    // box centred at (0,0), half extents (hx,hy), corner radius r
+    double sdRoundBox(double px, double py, double hx, double hy, double r) {
+        const double qx = std::abs(px) - hx + r, qy = std::abs(py) - hy + r;
+        const double ox = std::max(qx, 0.0), oy = std::max(qy, 0.0);
+        return std::sqrt(ox * ox + oy * oy) + std::min(std::max(qx, qy), 0.0) - r;
+    }
