+// One tab's button: drawn as renderBarButtons / renderBarButtonsText draw theirs (a circle of the button's size in
+// its colour, its icon in "sans" at size x 0.62), centred in the tab. which: 0 = menu (left), 1 = close (right).
+void CHyprBar::renderMobileButton(const CBox& tabBox, int which, float scale, float a, bool icons) {
+    const auto&      B             = g_pGlobalState->buttons;
+    const auto       IDX           = g_pGlobalState->config.mobileCloseButton->value();
+    const auto       INACTIVECOLOR = g_pGlobalState->config.inactiveButtonColor->value();
+    const double     SIZE          = mobileButtonSize();
+    CHyprColor       bg, fg;
+    std::string      icon;
+    if (which == 0) {
+        bg   = configColor(g_pGlobalState->config.mobileMenuColor->value());
+        fg   = configColor(g_pGlobalState->config.mobileMenuIconColor->value());
+        icon = g_pGlobalState->config.mobileMenuIcon->value();
+    } else {
+        if (B.empty())
+            return;
+        const auto& b = B[(IDX >= 0 && (size_t)IDX < B.size()) ? (size_t)IDX : 0];
+        bg            = b.bgcol;
+        fg            = b.userfg ? b.fgcol : (b.bgcol.r + b.bgcol.g + b.bgcol.b < 1) ? CHyprColor(0xFFFFFFFF) : CHyprColor(0xFF000000);
+        icon          = b.icon;
+    }
+    if (INACTIVECOLOR > 0 && !m_bWindowHasFocus)
+        bg = configColor(INACTIVECOLOR);
+    const auto GLASSCOLOR = bg;
+    bg.a *= a;
+    const double S  = SIZE * scale;
+    CBox         bb = {tabBox.x + (tabBox.w - S) / 2.0, tabBox.y + (tabBox.h - S) / 2.0, S, S};
+    bb.round();
+    // MiOS: the same tinted glass orb as the desktop buttons
+    if (!drawGlassButton(m_pWindow.lock(), (uintptr_t)this + 2 + (which ? 1 : 0), bb, GLASSCOLOR, m_fButtonGlassA))
+        g_pHyprOpenGL->renderRect(bb, bg, {.round = static_cast<int>(std::round(S / 2.0)), .roundingPower = 2.F});
+
+    if (!icons || icon.empty())
+        return;
+    const std::string KEY = std::format("{}/{:x}/{:.3f}", icon, fg.getAsHex(), scale);
+    if (!m_pMobileIconTex[which] || m_pMobileIconTex[which]->m_texID == 0 || m_mobileIconKey[which] != KEY) {
+        m_pMobileIconTex[which] = g_pHyprRenderer->renderText(icon, fg, std::round(SIZE * 0.62 * scale), false, "sans", S);
+        m_mobileIconKey[which]  = KEY;
+    }
+    const auto& T = m_pMobileIconTex[which];
+    if (!T || T->m_texID == 0)
+        return;
+    CBox pos = {bb.x + bb.w / 2.0 - T->m_size.x / 2.0, bb.y + bb.h / 2.0 - T->m_size.y / 2.0, T->m_size.x, T->m_size.y};
+    g_pHyprOpenGL->renderTexture(T, pos, {.a = a});
+}
