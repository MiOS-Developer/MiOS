+void CHyprBar::refreshInset() {
+    const bool INSET = computeInset();
+    if (INSET == m_bInset)
+        return;
+    damageEntire(); // both strips: damageEntire covers above and inside the top edge
+    m_bInset = INSET;
+    damageEntire();
+}
+
+void CHyprBar::updateReveal(std::optional<PHLWINDOW> focused, bool fromRender) {
+    if (!validMapped(m_pWindow))
+        return;
+    const auto PWINDOW = m_pWindow.lock();
+    if (!fromRender)
+        refreshInset();
+    float      target  = 1.F;
+    if (revealEnabled()) {
+        const auto MODE    = revealMode();
+        const bool FOCUSED = (focused.has_value() ? focused.value() : Desktop::focusState()->window()) == PWINDOW;
+        if (MODE == "focus")
+            target = FOCUSED ? 1.F : 0.F;
+        else if (MODE == "proximity")
+            target = cursorNearTab() ? 1.F : 0.F;
+        else
+            target = FOCUSED && cursorNearTab() ? 1.F : 0.F;
+    }
+    if (m_fReveal->goal() != target) {
+        Log::logger->log(Log::DEBUG, "[hyprbars] tab {:x} {} (mode {})", (uintptr_t)PWINDOW.get(), target > 0.F ? "rises" : "melts", revealMode());
+        *m_fReveal = target;
+    }
+
+    // While raised, the protruding tab's strip above the window is input area of this window, so reaching for the
+    // controls over another window (follow_mouse) does not move focus away and melt them.
+    const bool INPUT = g_pGlobalState->config.barOverlay->value() && target > 0.F && !m_bInset; // an inset tab sits on the window itself
+    if (INPUT != m_bInputExtents && !fromRender) { // never re-position mid-render; the next event does
+        m_bInputExtents = INPUT;
+        g_pDecorationPositioner->repositionDeco(this);
+    }
+    publishTab();
 }
 
