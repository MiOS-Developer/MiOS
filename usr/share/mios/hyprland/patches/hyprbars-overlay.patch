+// Socket2 event for the shell (the top-bar app-menu pills step aside only while a tab is actually up):
+//   hyprbarstab>>ADDRESS,RAISED,X,Y,W,H,INSET
+// RAISED is the reveal goal (1 as the tab starts to rise, 0 as it starts to melt; the shell animates over the
+// same fadeIn curve), X,Y,W,H the tab's extent in global layout px including its fillets (GOAL geometry), INSET
+// 1 when it hangs inside the window. Sent only on change; a closing window sends RAISED 0.
+void CHyprBar::publishTab(bool gone) {
+    if (!g_pGlobalState->config.barOverlay->value() || !g_pEventManager)
+        return;
+    const auto W = m_pWindow.lock();
+    if (!W)
+        return;
+    std::string data;
+    if (gone || !validMapped(m_pWindow))
+        data = std::format("{:x},0,0,0,0,0,0", (uintptr_t)W.get());
+    else {
+        const double HEIGHT = g_pGlobalState->config.barHeight->value();
+        const double PAD    = g_pGlobalState->config.pillPadding->value();
+        const double BARPAD = g_pGlobalState->config.barPadding->value();
+        const bool   RIGHT  = g_pGlobalState->config.barButtonsAlignment->value() != "left";
+        const double BTNS   = buttonsWidth();
+        const auto   GPOS   = W->position(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+        const auto   GSIZE  = W->size(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+        const double FILLET = std::min((double)std::max(0.F, W->rounding()), HEIGHT) / 2.0;
+        const double X0     = GPOS.x + (RIGHT ? GSIZE.x - BARPAD - BTNS - PAD : BARPAD - PAD) - FILLET;
+        if (mobileMode()) {
+            // mobile: the left (menu) tab, at the touch height
+            const double MH = tabHeight();
+            const double MF = std::min((double)std::max(0.F, W->rounding()) / 2.0, MH / 2.0);
+            const auto   L  = mobileTabs(GSIZE.x, W->rounding())[0];
+            data = std::format("{:x},{},{},{},{},{},{}", (uintptr_t)W.get(), m_fReveal->goal() > 0.F ? 1 : 0, (int)std::floor(GPOS.x + L.x - MF),
+                               (int)std::floor(m_bInset ? GPOS.y : GPOS.y - MH), (int)std::ceil(L.w + 2 * MF), (int)std::ceil(MH), m_bInset ? 1 : 0);
+        } else
+        data = std::format("{:x},{},{},{},{},{},{}", (uintptr_t)W.get(), m_fReveal->goal() > 0.F ? 1 : 0, (int)std::floor(X0), (int)std::floor(m_bInset ? GPOS.y : GPOS.y - HEIGHT),
+                           (int)std::ceil(BTNS + 2 * PAD + 2 * FILLET), (int)HEIGHT, m_bInset ? 1 : 0);
+    }
+    if (data == m_lastTabEvent)
+        return;
+    m_lastTabEvent = data;
+    g_pEventManager->postEvent(SHyprIPCEvent{"hyprbarstab", data});
+}
