+// ---- MiOS mobile tabs ------------------------------------------------------------------------------------------
+// A window with the hyprbars:mobile rule (the MiOS projection sets it on windows of mobile outputs) gets its controls
+// split into two tabs of the SAME glass, silhouette and button rendering as the desktop tab: the left tab rises from
+// the window's top-left and holds the window-menu button, the right one rises from its top-right and holds the close
+// button; the status pill sits in the notch between them. Both are always raised (focused or not), never yield to a
+// layer or a neighbour (the mobile layout shows one window), and each is at least mobile_touch_target logical px
+// wide and tall so a finger can hit it; the whole tab is the button's hit area. Each tab's box starts one window
+// rounding plus one fillet in from the window's side, so its outer fillet lands on the straight part of the top edge,
+// exactly where the desktop tab sits at bar_padding.
+bool CHyprBar::mobileMode() {
+    return m_bMobile && g_pGlobalState->config.barOverlay->value();
+}
+
+// The tab strip's height: bar_height, raised to the touch target on mobile tabs.
+double CHyprBar::tabHeight() {
+    return g_pGlobalState->config.barHeight->value();
+}
+
+// The mobile buttons share the close button's size (the desktop buttons' size), so the dots read as the same buttons.
+double CHyprBar::mobileButtonSize() {
+    const auto& B   = g_pGlobalState->buttons;
+    const auto  IDX = g_pGlobalState->config.mobileCloseButton->value();
+    if (!B.empty())
+        return B[(IDX >= 0 && (size_t)IDX < B.size()) ? (size_t)IDX : 0].size;
+    return g_pGlobalState->config.barHeight->value() / 2.0;
+}
+
+std::array<CHyprBar::SMobileTab, 2> CHyprBar::mobileTabs(double windowWidth, double rounding) {
+    const double H      = tabHeight();
+    const double PAD    = g_pGlobalState->config.pillPadding->value();
+    const double ROUND  = std::max(0.0, rounding);
+    const double FILLET = std::min(ROUND / 2.0, H / 2.0);
+    const double INSET  = ROUND + FILLET;
+    const double W      = mobileButtonSize() + 2.0 * PAD;
+    return {SMobileTab{INSET, W}, SMobileTab{windowWidth - INSET - W, W}};
+}
+
+// coords: relative to the tab strip (assignedBoxGlobal). The whole tab is the hit area.
+bool CHyprBar::doMobilePress(const Vector2D& coords) {
+    if (!validMapped(m_pWindow))
+        return false;
+    const double H      = tabHeight();
+    const auto   TABS     = mobileTabs(assignedBoxGlobal().w, m_pWindow->rounding());
+    const double TARGET   = std::max(H, (double)std::max<Config::INTEGER>(0, g_pGlobalState->config.mobileTouchTarget->value()));
+    const double PAD      = g_pGlobalState->config.pillPadding->value();
+    const double TARGET_W = std::max((double)g_pGlobalState->config.mobileTouchTarget->value(), mobileButtonSize() + 2.0 * PAD);
+    const double PADY     = (TARGET - H) / 2.0;
+    if (coords.y < -PADY || coords.y > H + PADY)
+        return false;
+    std::string cmd;
+    for (int i = 0; i < 2; ++i) {
+        const double PADX = std::max(0.0, (TARGET_W - TABS[i].w) / 2.0);
+        if ((coords.x >= TABS[i].x - PADX && coords.x <= TABS[i].x + TABS[i].w + PADX) || (i == 1 && coords.x >= TABS[1].x && coords.x <= TABS[1].x + TABS[1].w)) {
+            if (i == 0)
+                cmd = g_pGlobalState->config.mobileMenuAction->value();
+            else {
+                const auto& B   = g_pGlobalState->buttons;
+                const auto  IDX = g_pGlobalState->config.mobileCloseButton->value();
+                if (!B.empty())
+                    cmd = B[(IDX >= 0 && (size_t)IDX < B.size()) ? (size_t)IDX : 0].cmd;
+            }
+            break;
+        }
+    }
+    if (!cmd.empty())
+        g_pKeybindManager->m_dispatchers["exec"](cmd);
+    return true; // a tap on a tab never reaches the client under it
+}
