+            vec2  n    = length(g) > 1e-5 ? normalize(g) : vec2(0.0, -1.0);
+            if (flip > 0.5) n.y = -n.y;                                   // back to screen space for the light
+            float face = clamp(dot(n, vec2(-0.70710678, -0.70710678)) * 0.5 + 0.5, 0.0, 1.0);
+            vec3  bl   = mix(vec3(1.0), bevelColor.rgb, bevelColor.a);
+            color      = mix(color, bl, ring * face * light.x * baseFade);
+        }
+        vec3 fl = mix(vec3(1.0), fresnelColor.rgb, fresnelColor.a);
+        color += fl * (prox * prox * light.y * 0.15 * baseFade);                  // fresnel glow
+        color += vec3(1.0, 0.99, 0.97) * (prox * prox * light.z * 0.08 * baseFade); // top specular (the tab is the window's top)
+    }
+
+    // the window's own colour layer over its glass, as Hyprland composites the window's surface
+    color     = mix(clamp(color, 0.0, 1.0), winColor.rgb, winColor.a);
+    fragColor = vec4(color * cov, cov);
+}
+)GLSL";
+
+    // First half of the separable frost: copy -> (unshadow, gaussian along x) -> blurH. The main shader runs the
+    // vertical half while it shades the tab, so a wide frost costs 2 x (6 sigma + 1) taps per pixel, not a 2D
+    // kernel. Drawn as a full-target quad; gl_FragCoord is the sample texel (row = box y + pad, as in tap()).
+    const char* const GLASS_HBLUR_FRAG = R"GLSL(#version 300 es
+precision highp float;
+uniform sampler2D tex;
+uniform vec2  sampleSize;   // sample framebuffer size, px
+uniform float padY;         // the drawn box's origin row inside the sample
+uniform float sigma;        // frost sigma, px
+uniform vec4  shadow;       // window shadow: top y, range px, power, alpha (0 = none)
+uniform vec3  shadowColor;
+uniform vec2  mirror;       // MiOS: x = +1 rows below y (box px) / -1 rows above y read mirrored (the window side of the
+                            // edge: hyprglass' own blur and refraction then see the backdrop continue); 0 = off
+in vec2 v_texcoord;
+layout(location = 0) out vec4 fragColor;
+
+vec3 unshadow(vec3 c, float y) {
+    if (shadow.w <= 0.0) return c;
+    float dt = y - shadow.x;
+    if (dt <= 0.0) return c;
+    float s = min(shadow.w * (dt < shadow.y ? pow(dt / shadow.y, shadow.z) : 1.0), 0.9);
+    return clamp((c - shadowColor * s) / (1.0 - s), 0.0, 1.0);
+}
+vec3 texel(vec2 f) {
+    return clamp(texture(tex, clamp(f / sampleSize, vec2(0.0005), vec2(0.9995))).rgb, 0.0, 1.0);
+}
+void main() {
+    vec2 f = gl_FragCoord.xy;
+    float by = f.y - padY;
+    if (mirror.x > 0.5 && by > mirror.y) f.y = 2.0 * mirror.y - by + padY;
+    if (mirror.x < -0.5 && by < mirror.y) f.y = 2.0 * mirror.y - by + padY;
+    vec3 c;
+    if (sigma < 0.05)
+        c = texel(f);
+    else {
+        float inv = -0.5 / (sigma * sigma);
+        int   R   = int(min(ceil(sigma * 3.0), 48.0));
+        vec3  acc = vec3(0.0);
+        float ws  = 0.0;
+        for (int i = -48; i <= 48; i++) {
+            if (i < -R || i > R) continue;
+            float w = exp(float(i * i) * inv);
+            acc += texel(f + vec2(float(i), 0.0)) * w;
+            ws += w;
+        }
+        c = acc / ws;
+    }
+    fragColor = vec4(unshadow(c, f.y - padY), 1.0);
+}
+)GLSL";
+
+    GLuint glFBID(const SP<Render::IFramebuffer>& fb) {
+        auto* gl = dynamic_cast<Render::GL::CGLFramebuffer*>(fb.get());
+        return gl ? gl->getFBID() : 0;
+    }
+
+    bool ensureGlassShader() {
+        auto& G = g_pGlobalState->glass;
+        if (G.tried)
+            return G.ok;
+        G.tried  = true;
+        G.shader = makeShared<CShader>();
+        if (!G.shader->createProgram(g_pHyprOpenGL->m_shaders->TEXVERTSRC, GLASS_FRAG, true)) {
+            Log::logger->log(Log::ERR, "[hyprbars] glass tab shader failed to compile; using the CPU fallback");
+            G.shader.reset();
+            return false;
+        }
+        const auto P  = G.shader->program();
+        G.tabBox      = glGetUniformLocation(P, "tabBox");
+        G.tabShape    = glGetUniformLocation(P, "tabShape");
+        G.tabSpread   = glGetUniformLocation(P, "tabSpread");
+        G.sampleSize  = glGetUniformLocation(P, "sampleSize");
+        G.samplePad   = glGetUniformLocation(P, "samplePad");
+        G.boxSize     = glGetUniformLocation(P, "boxSize");
+        G.sigma        = glGetUniformLocation(P, "sigma");
+        G.flip         = glGetUniformLocation(P, "flip");
+        G.yClamp       = glGetUniformLocation(P, "yClamp");
+        G.tone         = glGetUniformLocation(P, "tone");
+        G.vibrancy     = glGetUniformLocation(P, "vibrancy");
+        G.glassTint    = glGetUniformLocation(P, "glassTint");
+        G.winColor     = glGetUniformLocation(P, "winColor");
+        G.fresnelColor = glGetUniformLocation(P, "fresnelColor");
+        G.bevelColor   = glGetUniformLocation(P, "bevelColor");
+        G.light       = glGetUniformLocation(P, "light");
+        G.bevelSize   = glGetUniformLocation(P, "bevelSize");
+        G.alpha       = glGetUniformLocation(P, "alpha");
+
+        G.hblur = makeShared<CShader>();
+        if (!G.hblur->createProgram(g_pHyprOpenGL->m_shaders->TEXVERTSRC, GLASS_HBLUR_FRAG, true)) {
+            Log::logger->log(Log::ERR, "[hyprbars] glass tab blur shader failed to compile; using the CPU fallback");
+            G.hblur.reset();
+            G.shader.reset();
+            return false;
+        }
+        const auto H   = G.hblur->program();
+        G.hSampleSize  = glGetUniformLocation(H, "sampleSize");
+        G.hPadY        = glGetUniformLocation(H, "padY");
+        G.hSigma       = glGetUniformLocation(H, "sigma");
+        G.shadow       = glGetUniformLocation(H, "shadow");
+        G.shadowColor  = glGetUniformLocation(H, "shadowColor");
+        G.mirror       = glGetUniformLocation(H, "mirror");
+        G.ok           = true;
+        return true;
+    }
+
+    struct SGlassTab {
+        CBox   box;                                 // drawn box, monitor-local device px (pixel aligned)
+        double cx, cy, hx, hy, rc, kb, bd, top, fx; // tab geometry, device px relative to box
+        double merge, bevelPx, bezelPx;
+        float  alpha;
+        bool   inset = false; // shape space mirrored: the tab hangs down inside the window from its top edge
+        double edgeY = 0;     // the window's top edge, box px (actual space)
+        float  winA  = 1.F;   // the window's active/inactive opacity (applies to its colour layer only)
+    };
+
+    // Draws the tab into the current framebuffer. False when the GL path is unavailable (caller falls back).
+    // key: the tab's sample-framebuffer key in hyprglass (MiOS path).
+    bool drawGlassTab(PHLMONITOR pMonitor, PHLWINDOW pWindow, const SGlassTab& T, uintptr_t key) {
+        if (!pMonitor || !ensureGlassShader())
+            return false;
+        auto&      G      = g_pGlobalState->glass;
+        const auto SOURCE = g_pHyprRenderer->m_renderData.currentFB;
+        if (!SOURCE || !glFBID(SOURCE))
+            return false;
+        if (pMonitor->m_transform != WL_OUTPUT_TRANSFORM_NORMAL)
+            return false; // the sample copy below assumes an untransformed output
+
+        CRegion damage{g_pHyprRenderer->m_renderData.damage};
+        damage.intersect(T.box);
+        if (damage.empty())
+            return true;
+
+        // device px, like hyprglass' own kernel (its radius is blur_strength x 12 device px whatever the scale)
+        const float BUILTIN_SIGMA = g_pGlobalState->config.pillBlur->value() ? (float)std::clamp((double)g_pGlobalState->config.pillBlurSigma->value(), 0.0, GLASS_SIGMA_MAX) : 0.F;
+        // MiOS: with hyprglass the copy below only removes the window's shadow (hyprglass frosts it itself) and
+        // carries hyprglass' sample padding
+        const bool  HG    = hyprglassPresent();
+        const float SIGMA = HG ? 0.F : BUILTIN_SIGMA;
+
+        // copy the framebuffer under the tab (+ frost padding of 3 sigma) into the sample buffer
+        const int PAD = HG ? HYPRGLASS_SAMPLE_PAD : std::max(GLASS_SAMPLE_PAD_MIN, (int)std::ceil(SIGMA * 3.F) + 2);
+        const int SW = (int)T.box.w + 2 * PAD, SH = (int)T.box.h + 2 * PAD;
+        if (!G.sample)
+            G.sample = g_pHyprRenderer->createFB("hyprbars-glass-sample");
+        if (!G.blurH)
+            G.blurH = g_pHyprRenderer->createFB("hyprbars-glass-blurh");
+        if (G.sample->m_size.x != SW || G.sample->m_size.y != SH || G.sample->m_drmFormat != SOURCE->m_drmFormat)
+            G.sample->alloc(SW, SH, SOURCE->m_drmFormat);
+        if (G.blurH->m_size.x != SW || G.blurH->m_size.y != SH || G.blurH->m_drmFormat != SOURCE->m_drmFormat)
+            G.blurH->alloc(SW, SH, SOURCE->m_drmFormat);
+        if (!glFBID(G.sample) || !glFBID(G.blurH))
+            return false;
+
+        int       sx0 = (int)T.box.x - PAD, sy0 = (int)T.box.y - PAD, sx1 = sx0 + SW, sy1 = sy0 + SH;
+        int       dx0 = 0, dy0 = 0, dx1 = SW, dy1 = SH;
+        const int FW = (int)SOURCE->m_size.x, FH = (int)SOURCE->m_size.y;
+        bool      clamped = false;
+        if (sx0 < 0) { dx0 -= sx0; sx0 = 0; clamped = true; }
+        if (sy0 < 0) { dy0 -= sy0; sy0 = 0; clamped = true; }
+        if (sx1 > FW) { dx1 -= sx1 - FW; sx1 = FW; clamped = true; }
+        if (sy1 > FH) { dy1 -= sy1 - FH; sy1 = FH; clamped = true; }
+        if (sx1 <= sx0 || sy1 <= sy0)
+            return true;
+
+        g_pHyprOpenGL->setCapStatus(GL_SCISSOR_TEST, false);
+        if (glIsEnabled(GL_SCISSOR_TEST))
+            glDisable(GL_SCISSOR_TEST);
+        if (clamped) {
+            glBindFramebuffer(GL_FRAMEBUFFER, glFBID(G.sample));
+            glClearColor(0.F, 0.F, 0.F, 0.F);
+            glClear(GL_COLOR_BUFFER_BIT);
+        }
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, glFBID(SOURCE));
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, glFBID(G.sample));
+        glBlitFramebuffer(sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        glBindFramebuffer(GL_FRAMEBUFFER, glFBID(SOURCE));
+
+        // the window's drop shadow over the strip above its top edge (straight-edge part of Hyprland's shadow.glsl)
+        static auto PSHADOWS      = CConfigValue<Config::INTEGER>("decoration:shadow:enabled");
+        static auto PSHADOWSIZE   = CConfigValue<Config::INTEGER>("decoration:shadow:range");
+        static auto PSHADOWPOWER  = CConfigValue<Config::INTEGER>("decoration:shadow:render_power");
+        static auto PSHADOWSCALE  = CConfigValue<Config::FLOAT>("decoration:shadow:scale");
+        static auto PSHADOWOFFSET = CConfigValue<Config::VEC2>("decoration:shadow:offset");
+        static auto PSHADOWSHARP  = CConfigValue<Config::INTEGER>("decoration:shadow:sharp");
+        float       shTop = 0, shRange = 1, shPower = 1, shA = 0;
+        CHyprColor  shCol{0, 0, 0, 0};
+        if (!T.inset && g_pGlobalState->config.pillShadowComp->value() && *PSHADOWS && !*PSHADOWSHARP && *PSHADOWSIZE > 0 && !pWindow->m_realShadowColor.m_colors.empty()) {
+            const double S     = pMonitor->m_scale;
+            const auto   POS   = pWindow->position(Desktop::View::IGeometric::GEOMETRIC_CURRENT) - pMonitor->m_position + pWindow->m_floatingOffset;
+            const auto   SIZE  = pWindow->size(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+            const auto   WSOFF = pWindow->m_workspace && !pWindow->m_pinned ? pWindow->m_workspace->m_renderOffset->value() : Vector2D{};
+            const double H     = SIZE.y + 2.0 * *PSHADOWSIZE;
+            const double CY    = POS.y + WSOFF.y + SIZE.y / 2.0;
+            const double SCALE = std::clamp((double)*PSHADOWSCALE, 0.0, 1.0);
+            const double TOPL  = CY - H * SCALE / 2.0 + (*PSHADOWOFFSET).y;
+            shTop              = (float)(std::round(TOPL * S) - T.box.y);
+            shRange            = (float)(*PSHADOWSIZE * S);
+            shPower            = (float)std::clamp(*PSHADOWPOWER, (Config::INTEGER)1, (Config::INTEGER)4);
+            shCol              = pWindow->m_realShadowColor.m_colors.front();
+            shA                = (float)(shCol.a * T.alpha);
+        }
+
+        const auto win     = configColor(g_pGlobalState->config.pillColor->value());
+        const auto fresnel = configColor(g_pGlobalState->config.pillRimColor->value());
+        const auto gtint   = configColor(g_pGlobalState->config.pillGlassTint->value());
+        const auto bevel   = configColor(g_pGlobalState->config.pillBevelColor->value());
+        const auto PCT     = [](const SP<Config::Values::CIntValue>& v) { return (float)std::clamp(v->value(), (Config::INTEGER)0, (Config::INTEGER)100) / 100.F; };
+        const auto F       = [](const SP<Config::Values::CFloatValue>& v) { return (float)v->value(); };
+
+        // horizontal half of the frost (and the shadow removal): sample -> blurH, a full-target quad
+        auto hpass = [&](float sigma) -> bool {
+            static constexpr std::array<float, 9> FULLSCREEN = {2.F, 0.F, 0.F, 0.F, 2.F, 0.F, -1.F, -1.F, 1.F};
+            auto                                  hs         = g_pHyprOpenGL->useShader(G.hblur).lock();
+            if (!hs)
+                return false;
+            g_pHyprRenderer->blend(false);
+            glBindFramebuffer(GL_FRAMEBUFFER, glFBID(G.blurH));
+            g_pHyprOpenGL->setViewport(0, 0, SW, SH);
+            hs->setUniformMatrix3fv(SHADER_PROJ, 1, GL_FALSE, FULLSCREEN);
+            hs->setUniformInt(SHADER_TEX, 0);
+            glUniform2f(G.hSampleSize, (float)SW, (float)SH);
+            glUniform1f(G.hPadY, (float)PAD);
+            glUniform1f(G.hSigma, sigma);
+            // hyprglass blurs/refracts the copy itself: the window side of the edge mirrors the backdrop (the
+            // built-in shader clamps its own taps instead)
+            glUniform2f(G.mirror, !HG ? 0.F : (T.inset ? -1.F : 1.F), T.inset ? (float)T.edgeY : (float)T.bd);
+            glUniform4f(G.shadow, shTop, shRange, shPower, shA);
+            glUniform3f(G.shadowColor, (float)shCol.r, (float)shCol.g, (float)shCol.b);
+            glActiveTexture(GL_TEXTURE0);
+            G.sample->getTexture()->bind();
+            glBindVertexArray(hs->getUniformLocation(SHADER_SHADER_VAO));
+            glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+            glBindVertexArray(0);
+            glBindFramebuffer(GL_FRAMEBUFFER, glFBID(SOURCE));
+            g_pHyprOpenGL->setViewport(0, 0, (int)SOURCE->m_size.x, (int)SOURCE->m_size.y);
+            g_pHyprRenderer->blend(true);
+            return true;
+        };
+        if (!hpass(SIGMA))
+            return false;
+
+        if (HG) {
+            // MiOS: the window's own glass, drawn by hyprglass over the unshadowed backdrop
+            SMiosGlassShapeV1 s{};
+            s.structSize  = sizeof(s);
+            s.window      = pWindow.get();
+            s.key         = key;
+            s.box[0]      = (float)T.box.x;
+            s.box[1]      = (float)T.box.y;
+            s.box[2]      = (float)T.box.w;
+            s.box[3]      = (float)T.box.h;
+            s.alpha       = T.alpha;
+            s.shape       = 1;
+            s.tabBox[0]   = (float)T.cx;
+            s.tabBox[1]   = (float)T.cy;
+            s.tabBox[2]   = (float)T.hx;
+            s.tabBox[3]   = (float)T.hy;
+            s.tabShape[0] = (float)T.rc;
+            s.tabShape[1] = (float)T.kb;
+            s.tabShape[2] = (float)T.bd;
+            s.tabShape[3] = (float)T.top;
+            s.tabSpread[0] = (float)T.fx;
+            s.tabSpread[1] = (float)T.merge;
+            s.tabFlip     = T.inset ? 1.F : 0.F;
+            // protruding: never read the window under the tab; inset: never read the row above the window
+            s.yClamp[0]   = T.inset ? (float)T.edgeY + 0.5F : -1e6F;
+            s.yClamp[1]   = T.inset ? 1e6F : (float)T.bd - 0.5F;
+            // The window's colour layer (pill_color x the window's opacity) folds into the glass tint, under the
+            // lights, exactly: mix(mix(c, t1, a1), t2, a2) = mix(c, (t1 a1 (1 - a2) + t2 a2) / A, A),
+            // A = 1 - (1 - a1)(1 - a2); t1/a1 = the preset tint (pill_glass_tint), t2/a2 = the colour layer.
+            {
+                const auto   t1 = configColor(g_pGlobalState->config.pillGlassTint->value());
+                const auto   t2 = configColor(g_pGlobalState->config.pillColor->value());
+                const double a1 = std::clamp(t1.a, 0.0, 1.0), a2 = std::clamp(t2.a * std::clamp((double)T.winA, 0.0, 1.0), 0.0, 1.0);
+                const double A  = 1.0 - (1.0 - a1) * (1.0 - a2);
+                auto         q  = [](double v) { return (int64_t)std::lround(std::clamp(v, 0.0, 1.0) * 255.0); };
+                auto         ch = [&](double c1, double c2) { return A > 1e-6 ? (c1 * a1 * (1.0 - a2) + c2 * a2) / A : 0.0; };
+                s.tint          = (q(ch(t1.r, t2.r)) << 24) | (q(ch(t1.g, t2.g)) << 16) | (q(ch(t1.b, t2.b)) << 8) | q(A);
+            }
+            s.backdropFbo = glFBID(G.blurH);
+            s.backdropPad = PAD;
+            if (hyprglassDraw(s))
+                return true;
+            if (!hpass(BUILTIN_SIGMA)) // hyprglass declined (the window's glass is off): built-in frost
+                return false;
+        }
+
+        const auto TRANSFORM = Math::wlTransformToHyprutils(Math::invertTransform(pMonitor->m_transform));
+        Mat3x3     matrix    = g_pHyprRenderer->projectBoxToTarget(T.box, TRANSFORM);
+        matrix.transpose();
+
+        glActiveTexture(GL_TEXTURE0);
+        G.blurH->getTexture()->bind();
+        auto shader = g_pHyprOpenGL->useShader(G.shader).lock();
+        if (!shader)
+            return false;
+        shader->setUniformMatrix3fv(SHADER_PROJ, 1, GL_FALSE, matrix.getMatrix());
+        shader->setUniformInt(SHADER_TEX, 0);
+        glUniform2f(G.sampleSize, (float)SW, (float)SH);
+        glUniform2f(G.samplePad, (float)PAD, (float)PAD);
+        glUniform2f(G.boxSize, (float)T.box.w, (float)T.box.h);
+        glUniform4f(G.tabBox, (float)T.cx, (float)T.cy, (float)T.hx, (float)T.hy);
+        glUniform4f(G.tabShape, (float)T.rc, (float)T.kb, (float)T.bd, (float)T.top);
+        glUniform2f(G.tabSpread, (float)T.fx, (float)T.merge);
+        glUniform1f(G.sigma, SIGMA);
+        glUniform1f(G.flip, T.inset ? 1.F : 0.F);
+        // protruding: never read the window under the tab; inset: never read the row above the window
+        glUniform2f(G.yClamp, T.inset ? (float)T.edgeY + 0.5F : -1e6F, T.inset ? 1e6F : (float)T.bd - 0.5F);
+        glUniform4f(G.tone, F(g_pGlobalState->config.pillSaturation), F(g_pGlobalState->config.pillBrightness), F(g_pGlobalState->config.pillContrast),
+                    PCT(g_pGlobalState->config.pillDim));
+        glUniform1f(G.vibrancy, F(g_pGlobalState->config.pillVibrancy));
+        glUniform4f(G.glassTint, (float)gtint.r, (float)gtint.g, (float)gtint.b, (float)gtint.a);
+        glUniform4f(G.winColor, (float)win.r, (float)win.g, (float)win.b, (float)(win.a * std::clamp(T.winA, 0.F, 1.F)));
+        glUniform4f(G.fresnelColor, (float)fresnel.r, (float)fresnel.g, (float)fresnel.b, (float)fresnel.a);
+        glUniform4f(G.bevelColor, (float)bevel.r, (float)bevel.g, (float)bevel.b, (float)bevel.a);
+        glUniform4f(G.light, PCT(g_pGlobalState->config.pillEdge), PCT(g_pGlobalState->config.pillFresnel), PCT(g_pGlobalState->config.pillSheen), (float)T.bezelPx);
+        glUniform1f(G.bevelSize, (float)T.bevelPx);
+        glUniform1f(G.alpha, T.alpha);
+        glBindVertexArray(shader->getUniformLocation(SHADER_SHADER_VAO));
+
+        g_pHyprRenderer->blend(true);
+        for (auto& r : damage.getRects()) {
+            g_pHyprOpenGL->scissor(&r);
+            glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        }
+        g_pHyprOpenGL->scissor(nullptr);
+        glBindVertexArray(0);
+        return true;
+    }
+}
+
+// The glass tab reads the framebuffer around it, so while it is visible the pass treats it like live blur:
+// damage touching it is expanded, keeping every pixel the frost taps read current.
+bool CHyprBar::overlayNeedsBlur() {
+    return g_pGlobalState->config.barOverlay->value() && g_pGlobalState->config.pillEnabled->value() && m_fReveal->value() > 0.001F;
+}
+
+void CHyprBar::renderOverlay(PHLMONITOR pMonitor, const float& a) {
+    const auto  PWINDOW = m_pWindow.lock();
+    static auto PENABLEBLURGLOBAL = CConfigValue<Config::BOOL>("decoration:blur:enabled");
+    const auto  HEIGHT            = g_pGlobalState->config.barHeight->value();
+    const auto  PAD               = g_pGlobalState->config.pillPadding->value();
+    const auto  BARPAD            = g_pGlobalState->config.barPadding->value();
+    const bool  RIGHT             = g_pGlobalState->config.barButtonsAlignment->value() != "left";
+    constexpr float SPREAD        = 0.35F;
+
+    m_seExtents = {};
+    if (HEIGHT < 1 || g_pGlobalState->buttons.empty()) {
+        m_iLastHeight = HEIGHT;
+        return;
+    }
+
+    refreshInset();                   // a neighbour, the bar row or fullscreen may have changed without input
+    updateReveal(std::nullopt, true); // catches a bar created after its window's focus event
+    const float REVEAL = revealEnabled() ? std::clamp(m_fReveal->value(), 0.F, 1.F) : 1.F;
+    m_bButtonsDirty    = false;
+    if (REVEAL <= 0.001F)
+        return;
+    const float  MELT = 1.F - REVEAL;
+    const double S    = pMonitor->m_scale;
+    // The glass follows the window's fade (open/close, workspace switch), never its active/inactive opacity --
+    // the same rule hyprglass applies to the window's own pane (alphaTotalWithout(WINDOW_ALPHA_ACTIVE)). `a` is
+    // alpha x fade; with the opacity folded in, the unfrosted backdrop showed straight through the tab at
