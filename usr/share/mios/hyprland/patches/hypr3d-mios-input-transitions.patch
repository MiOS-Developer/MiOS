 // --- lifecycle --------------------------------------------------------------
 
+// MiOS input transitions: leaving the room always hands the keyboard to a
+// window. In order: the window the room had focused at exit, the window that
+// had the keyboard before the room opened (back to what you were doing in 2D),
+// the newest still-shown window in Hyprland's focus history (the 2D window was
+// closed in the room), then the newest window on the room's monitor. Only a window still shown on a visible workspace
+// (refocusing must never switch the operator's workspace), and nothing under
+// a session lock (the lock surface owns the keyboard; a lock is also how a
+// room can end). Without it a room exit with no aim focus -- a quick
+// re-toggle, or the crosshair on the floor -- left keys going nowhere.
+static bool roomExitFocusable(const PHLWINDOW& W) {
+    return W && W->m_isMapped && !W->isHidden() && W->m_workspace && W->m_workspace->isVisible() &&
+        !(W->m_ruleApplicator && W->m_ruleApplicator->noFocus().valueOrDefault());
+}
+
+static PHLWINDOW roomExitFocusTarget(const PHLWINDOWREF& exitFocus) {
+    if (const auto W = exitFocus.lock(); roomExitFocusable(W))
+        return W;
+    if (const auto W = g_preRoomFocus.lock(); roomExitFocusable(W))
+        return W;
+    if (const auto TRACKER = Desktop::History::windowTracker()) {
+        const auto& HISTORY = TRACKER->fullHistory();
+        for (auto it = HISTORY.rbegin(); it != HISTORY.rend(); ++it)
+            if (const auto W = it->lock(); roomExitFocusable(W))
+                return W;
+    }
+    if (!Desktop::windowState())
+        return nullptr;
+    const auto MON = targetMonitor();
+    PHLWINDOW any;
+    for (const auto& W : Desktop::windowState()->windows()) {
+        if (!roomExitFocusable(W))
+            continue;
+        if (MON && W->m_monitor.lock() == MON)
+            any = W;
+        else if (!any)
+            any = W;
+    }
+    return any;
+}
+
+static void restoreFocusAfterRoom(const PHLWINDOWREF& exitFocus) {
+    const bool LOCKED = g_pSessionLockManager && g_pSessionLockManager->isSessionLocked();
+    const auto W      = LOCKED ? nullptr : roomExitFocusTarget(exitFocus);
+    g_preRoomFocus.reset();
+    if (W)
+        Compat::focusWindow(W);
+}
