+// AI-hint: Separate PiP room magnification from bounded native raster allocation.
+// AI-related: main.cpp spatial resize and Theatre placement, tests/mios-pip-geometry.cpp
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <optional>
+namespace H3D::PiP {
+struct Resize { double rasterFactor, spatialFactor; };
+inline std::optional<Resize> resize(double w,double h,double wanted,double minW,double minH,double maxW,double maxH,double budget) {
+ if (!(std::isfinite(w)&&std::isfinite(h)&&std::isfinite(wanted)&&std::isfinite(budget)) || w<=0 || h<=0 || wanted<=0 || budget<=0 || std::isnan(minW)||std::isnan(minH)||std::isnan(maxW)||std::isnan(maxH)) return {};
+ const double low=std::max({1.0/w,1.0/h,std::max(0.0,minW)/w,std::max(0.0,minH)/h});
+ const double high=std::min({budget/w,budget/h,maxW/w,maxH/h});
+ // Inconsistent client hints: keep the current raster, rather than allocate
+ // beyond the budget or call clamp with an inverted range. Room scale still works.
+ const double raster=low<=high ? std::clamp(wanted,low,high) : 1.0;
+ const double spatial=wanted/raster;
+ if (!std::isfinite(spatial)||spatial<=0) return {};
+ return Resize{raster,spatial};
+}
+inline std::optional<double> theatreScale(double w,double h,double distance,double tanHalfFov,double outputAspect,double widthFraction,double heightFraction) {
+ if (!(w>0&&h>0&&distance>0&&tanHalfFov>0&&outputAspect>0&&widthFraction>0&&heightFraction>0)) return {};
+ const double s=std::min(2*distance*tanHalfFov*outputAspect*widthFraction/w,2*distance*tanHalfFov*heightFraction/h);
+ if(!std::isfinite(s)||s<=0) return {};
+ return s;
+}
+}
