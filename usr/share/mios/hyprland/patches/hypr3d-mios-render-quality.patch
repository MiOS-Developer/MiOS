+// MiOS: resolve the multisampled scene into m_sceneColor and leave the
+// single-sample scene FBO bound (read + draw) for readers of the image.
+void GLScene::resolveSceneMsaa() {
+    if (m_msaaSamples < 2 || !m_msaaFBO)
+        return;
+    const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+    glDisable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, m_msaaFBO);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_sceneFBO);
+    glBlitFramebuffer(0, 0, m_sceneWidth, m_sceneHeight,
+                      0, 0, m_sceneWidth, m_sceneHeight,
+                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, m_sceneFBO);
+    if (scissor)
+        glEnable(GL_SCISSOR_TEST);
+}
