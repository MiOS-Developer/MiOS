+// MiOS: rotated-grid 4-tap supersampling for minified window textures.
+// Window buffers have no mipmaps; when a texel footprint exceeds ~1 pixel the
+// single bilinear tap aliases (crawling text). 1:1 and magnified stay 1 tap.
+uniform int uTexSS;
+vec4 texSS(sampler2D s, vec2 uv) {
+    vec2 dx = dFdx(uv), dy = dFdy(uv);
+    if (uTexSS == 0) return texture(s, uv);
+    vec2 ts = vec2(textureSize(s, 0));
+    float fp = max(length(dx * ts), length(dy * ts));
+    if (fp < 1.15) return texture(s, uv);
+    return 0.25 * (texture(s, uv + 0.125 * dx + 0.375 * dy) +
+                   texture(s, uv - 0.125 * dx - 0.375 * dy) +
+                   texture(s, uv + 0.375 * dx - 0.125 * dy) +
+                   texture(s, uv - 0.375 * dx + 0.125 * dy));
+}
