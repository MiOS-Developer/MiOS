+enum class ERetinaFit : uint8_t { Off, Resize, Distance };
+static bool       g_cfgPixelExact = false;
+static ERetinaFit g_cfgFit        = ERetinaFit::Off;
+static float      g_cfgFitMargin  = 8.0f;
+static float      g_cfgSafeTop    = 0.0f;
+static float      g_cfgSafeBottom = 0.0f;
+static bool       g_cfgPixelSnap  = false;
+static float      g_cfgCascade    = 0.0f;
+static float      g_cfgMinMag     = 0.0f;
