+    if (maxDist > 0.0f && dist > maxDist)
+        dist = maxDist;
+    dist = std::max(0.6f, dist);
+
+    // the multiplier keeps M through every depth step (cascade on)
+    P.fitM = M;
+    P.mul  = COMP ? dist / DIST0 : 1.0f;
+    P.M    = COMP ? M : M * DIST0 / dist;
