+    const double PX   = mon->m_size.y / (2.0 * ZC * retinaTan()); // logical px per world unit at ZC
+    out.x     = mon->m_size.x * 0.5 + dot(V, RIGHT) * PX;
+    out.y     = mon->m_size.y * 0.5 - dot(V, UP) * PX;
+    out.r     = HALF * PX;
+    out.depth = Z - HALF * TILT;
