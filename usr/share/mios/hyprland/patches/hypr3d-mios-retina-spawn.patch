+// One settle step for a room window the placement put down (syncWorld, after
+// the entity took its pose; no layout side effects). Returns the new centre.
+static Vec3 retinaSettle(const PHLMONITOR& mon, World3D::SEntity& entity, const CBox& BOX, float winScale) {
+    const auto IT = g_retinaSettle.find(entity.id);
+    if (IT == g_retinaSettle.end())
+        return entity.center;
+    auto& S = IT->second;
+    if (g_viewMorph != EViewMorph::None || g_fsPhase != EFullscreenPhase::None)
+        return entity.center; // the morph or the passthrough owns the pose
+    if ((g_world.dragActive() && g_world.draggedId() == entity.id) ||
+        (g_resize.active && g_resize.id == entity.id) || ++S.frames > kRetinaSettleFrames) {
+        g_retinaSettle.erase(IT); // the operator took it, or it never settled
+        return entity.center;
+    }
+    const bool CHANGED = std::fabs(BOX.x - S.lastBox.x) > 0.5 || std::fabs(BOX.y - S.lastBox.y) > 0.5 ||
+        std::fabs(BOX.w - S.lastBox.w) > 0.5 || std::fabs(BOX.h - S.lastBox.h) > 0.5;
+    S.stable = CHANGED ? 0 : S.stable + 1;
+    S.lastBox = BOX;
+
+    Vec3 center = entity.center;
+
+    // push back (or forward again) when the snapshot box is not the one placed
+    if (g_cfgFit != ERetinaFit::Off) {
+        const CBox  FA = retinaFitArea(mon);
+        const float M0 = configWindowScale() * retinaD1(mon) / std::max(0.1f, g_cfgSpawnDistance);
+        const float M  = std::min(M0, static_cast<float>(std::min(FA.w / std::max(1.0, BOX.w), FA.h / std::max(1.0, BOX.h))));
+        if (std::fabs(M - S.M) > 1e-4f) {
+            center = S.origin + (center - S.origin) * (S.M / M);
+            if (M < M0 - 1e-4f && S.M >= M0 - 1e-4f)
+                ++g_retinaPushed;
+            if (g_retinaLast.id == entity.id) {
+                g_retinaLast.dist *= S.M / M;
+                g_retinaLast.M *= M / S.M; // on screen: the fit change times any stacking step
+                g_retinaLast.box    = BOX;
+                g_retinaLast.pushed = M < M0 - 1e-4f;
+                g_retinaLast.small  = g_cfgMinMag > 0.0f && M < g_cfgMinMag - 1e-4f;
+            }
+            S.M      = M;
+            S.stable = 0;
+        }
+    }
