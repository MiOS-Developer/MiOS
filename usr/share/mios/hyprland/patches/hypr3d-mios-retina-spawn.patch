+    // the pixel snap, once the box has held still
+    if (!g_cfgPixelSnap || S.stable < kRetinaStableFrames)
+        return center;
+    g_retinaSettle.erase(IT);
+    const auto& CAM = g_scene.camera();
+    if (CAM.mirrorView || std::fabs(CAM.roll) > 1e-5f || !mon || mon->m_size.y < 1.0 ||
+        (static_cast<int>(mon->m_transform) % 2) != 0)
+        return center; // rotated outputs and rolled views have no fixed pixel grid here
+    const Vec3   FWD = CAM.forward(), RIGHT = CAM.right(), UP = cross(RIGHT, FWD);
+    const Vec3   N   = retinaNormal(entity.yaw, entity.pitch);
+    if (dot(N, FWD) > -0.99999f || std::fabs(entity.roll) > 1e-5f)
+        return center; // not facing the eye: no 1:1 pixel grid to land on
+    const double SPX   = mon->m_scale;                          // output px per logical px
+    const double HPX   = mon->m_size.y * SPX;                   // output px rows
+    const double Z     = dot(center - CAM.position, FWD);
+    if (Z <= 0.05)
+        return center;
+    const double PXW   = HPX / (2.0 * Z * retinaTan());         // output px per world unit
+    const double WPX   = entity.width * PXW;                    // window width on screen, output px
+    const double MEAS  = WPX / std::max(1.0, BOX.w * SPX);      // the magnification it shows
+    if (std::fabs(MEAS - 1.0) > 2e-3)
+        return center; // not at 1:1: no grid to align
+    const Vec3   V     = center - CAM.position;
+    const double LEFT  = mon->m_size.x * SPX * 0.5 + dot(V, RIGHT) * PXW - WPX * 0.5;
+    const double TOP   = HPX * 0.5 - dot(V, UP) * PXW - entity.height * PXW * 0.5;
+    // texel edges sit at frac(box origin x s) inside the snapshot
+    const double FX    = BOX.x * SPX - std::floor(BOX.x * SPX), FY = BOX.y * SPX - std::floor(BOX.y * SPX);
+    const double EX    = LEFT - FX, EY = TOP - FY;
+    const double DX    = std::round(EX) - EX, DY = std::round(EY) - EY;
+    center = center + RIGHT * static_cast<float>(DX / PXW) - UP * static_cast<float>(DY / PXW);
+    ++g_retinaSnapped;
+    if (g_retinaLast.id == entity.id) {
+        g_retinaLast.snapX = static_cast<float>(DX);
+        g_retinaLast.snapY = static_cast<float>(DY);
+    }
+    (void)winScale;
+    return center;
+}
