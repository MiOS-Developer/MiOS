+// tan(fov / 2) at rest zoom (the C-key zoom is transient; placement ignores it).
+static double retinaTan() {
+    return std::tan(static_cast<double>(kFovDeg) * 3.14159265358979323846 / 360.0);
+}
+
+// The 1:1 distance of a monitor, world units: a window at scale 1 this far
+// away covers exactly its 2D pixels (= g_fsDistance, ScreenProject's D).
+static float retinaD1(const PHLMONITOR& mon) {
+    const double H = mon && mon->m_size.y > 1.0 ? mon->m_size.y : 1080.0;
+    return static_cast<float>((H / World3D::LOGICAL_PX_PER_UNIT * 0.5) / retinaTan());
+}
+
+// Where room windows may sit (monitor-local logical px): the work area (the
+// monitor minus its reserved bars) shrunk by fit_margin on every side.
+static CBox retinaFitArea(const PHLMONITOR& mon) {
+    if (!mon)
+        return {};
+    CBox wa = mon->logicalBoxMinusReserved();
+    wa.x -= mon->m_position.x;
+    wa.y -= mon->m_position.y;
+    if (wa.w < 16.0 || wa.h < 16.0)
+        wa = CBox{0.0, 0.0, mon->m_size.x, mon->m_size.y};
+    const double top = std::max(wa.y, static_cast<double>(g_cfgSafeTop));
+    const double bottom = std::max(mon->m_size.y - (wa.y + wa.h), static_cast<double>(g_cfgSafeBottom));
+    wa.y = top;
+    wa.h = std::max(16.0, mon->m_size.y - top - bottom);
+    const double M = std::max(0.0f, g_cfgFitMargin);
+    const double W = std::max(16.0, wa.w - 2.0 * M);
+    const double H = std::max(16.0, wa.h - 2.0 * M);
+    return CBox{wa.x + (wa.w - W) * 0.5, wa.y + (wa.h - H) * 0.5, W, H};
+}
+
+// A box shrunk into the fit area (never grown), at least the client's minimum
+// size, centred in the fit area, on the logical pixel grid. `deco` is the
+// decoration the compositor adds around the box (decorated minus real box).
+static CBox retinaFitted(const PHLMONITOR& mon, const CBox& box, const PHLWINDOW& window,
+                         const Vector2D& deco = {}) {
+    const CBox FA = retinaFitArea(mon);
+    double     w = std::min(box.w, FA.w - deco.x);
+    double     h = std::min(box.h, FA.h - deco.y);
+    if (window)
+        if (const auto MIN = window->minSize()) {
+            w = std::max(w, MIN->x);
+            h = std::max(h, MIN->y);
+        }
+    w = std::max(16.0, std::round(w));
+    h = std::max(16.0, std::round(h));
+    return CBox{std::round(FA.x + (FA.w - w - deco.x) * 0.5), std::round(FA.y + (FA.h - h - deco.y) * 0.5), w, h};
+}
