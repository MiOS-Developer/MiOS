+// The quad model's normal (World3D rotateLocal of +Z without roll).
+static Vec3 retinaNormal(float yaw, float pitch) {
+    return Vec3{std::sin(yaw) * std::cos(pitch), -std::sin(pitch), std::cos(yaw) * std::cos(pitch)};
