+static void retinaRecord(std::uintptr_t id, const CBox& box, const SRetinaPose& P) {
+    g_retinaMul[id]    = P.mul;
+    g_retinaSettle[id] = SRetinaSettle{g_scene.camera().position, P.fitM, 0, 0, box};
+    g_retinaLast       = SRetinaLast{id, box, P.M, P.dist, P.mul, 0.0f, 0.0f, P.k, P.pushed,
+                               g_cfgMinMag > 0.0f && P.M < g_cfgMinMag - 1e-4f};
+    ++g_retinaPlaced;
+    if (P.pushed)
+        ++g_retinaPushed;
+}
