+
+static bool retinaObstacle(const PHLMONITOR& mon, const Vec3& center, float yaw, float pitch,
+                           float worldW, float worldH, SRetinaObstacle& out) {
+    const auto& CAM   = g_scene.camera();
+    const Vec3  FWD   = CAM.forward();
+    const Vec3  RIGHT = CAM.right();
+    const Vec3  UP    = cross(RIGHT, FWD);
+    const Vec3  V     = center - CAM.position;
+    const float Z     = dot(V, FWD);
+    const float HALF  = 0.5f * std::sqrt(worldW * worldW + worldH * worldH);
+    if (Z + HALF <= 0.05f)
+        return false; // behind the eye
+    const float  TILT = std::sqrt(std::max(0.0f, 1.0f - std::pow(dot(retinaNormal(yaw, pitch), FWD), 2.0f)));
