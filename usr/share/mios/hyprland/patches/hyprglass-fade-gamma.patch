diff --git a/src/GlassDecoration.cpp b/src/GlassDecoration.cpp
index 434fdff..f677299 100644
--- a/src/GlassDecoration.cpp
+++ b/src/GlassDecoration.cpp
@@ -12,6 +12,7 @@
 #include "WorkspaceAnimation.hpp"
 
 #include <algorithm>
+#include <cmath>
 #include <GLES3/gl32.h>
 #include <hyprland/src/desktop/view/Window.hpp>
 #include <hyprland/src/desktop/rule/windowRule/WindowRuleApplicator.hpp>
@@ -533,6 +534,12 @@ void CGlassDecoration::renderPass(PHLMONITOR monitor, const float& alpha, bool x
     if (const auto workspace = window->m_workspace; workspace && !window->m_pinned)
         glassAlpha *= workspace->m_alpha->value();
 
+    // MiOS: shape the pane's fade separately from the surface. With a gamma above 1 the pane stays
+    // transparent while a window-open shader grows the window's own glass from a point, and leaves
+    // early on close, so the full-size pane never shows as a rectangle behind the effect.
+    if (const auto& gamma = g_pGlobalState->config.fadeGamma; gamma && **gamma > 0.0 && glassAlpha < 1.0f)
+        glassAlpha = std::pow(std::clamp(glassAlpha, 0.0f, 1.0f), static_cast<float>(**gamma));
+
     // A fullscreen window shows no edge, like Hyprland draws it no border.
     m_lastFocusLightStrength = fsUnrounded ? 0.0f : focusLightFor(ctx);
     float focusLight         = 0.0f;
