+// AI-hint: Deterministic clock, fail-closed validation and enter/exit visibility regression tests.
+// AI-related: src/Input/DockCaptureFeedback.hpp, src/main.cpp dock_capture_feedback
+#include "../src/Input/DockCaptureFeedback.hpp"
+#include <iostream>
+#include <limits>
+#include <memory>
+#include <vector>
+#include <stdexcept>
+using namespace MiosDockCapture;
+static void require(bool ok,const char* label) {if (!ok) throw std::runtime_error(label);}
+int main() {
+    const auto t=Clock::time_point{}+std::chrono::seconds(100);
+    Feedback f;
+    const auto valid=[&](Clock::time_point now=Clock::time_point{}) {return f.update("DP-1","#Ff8000",2,1000,1000,now==Clock::time_point{}?t:now);};
+    require(valid(),"valid style");
+    require(f.rgba[0]==1.f && f.rgba[3]==1.f,"RGB defaults opaque");
+    require(f.live(t+std::chrono::milliseconds(999)),"lease before deadline");
+    require(!f.live(t+std::chrono::milliseconds(1000)),"deadline exclusive");
+    const auto origin=f.phaseOrigin;
+    const auto quarter=t+std::chrono::milliseconds(250);
+    const float phase=f.orbitPhase(quarter);
+    require(valid(quarter),"heartbeat");
+    require(f.phaseOrigin==origin && std::abs(f.orbitPhase(quarter)-phase)<0.00001f,"heartbeat preserves phase");
+    require(f.live(t+std::chrono::milliseconds(1249)),"heartbeat extends lease");
+    require(f.expire(t+std::chrono::milliseconds(1250)) && !f.active,"lease clears at deadline");
+    require(!f.expire(t+std::chrono::milliseconds(1251)),"expiry idempotent");
+    require(valid() && f.clear() && !f.live(t),"explicit clear");
+    require(!f.clear(),"clear idempotent");
+    require(valid() && f.update("HDMI-A-1","#11223380",32,20000,10000,quarter),"upper bounds");
+    require(f.phaseOrigin==quarter && std::abs(f.rgba[3]-128.f/255.f)<0.00001f,"output change resets phase RGBA");
+    require(f.update("DP-1","#00000000",0.001,100,100,t),"lower bounds transparent valid");
+    for (const auto output:{"","HEADLESS-1","headless-2","HeAdLeSs","DP\n1"}) {
+        require(valid(),"restore output");require(!f.update(output,"#ffffff",2,1000,1000,t) && !f.active,"invalid output clears");
+    }
+    require(!physicalOutput(std::string(129,'X')) && !physicalOutput(std::string("DP-1\0X",6)),"bounded printable output");
+    for (const auto style:{"ffffff","#fff","#gg0000","#fffffffff","#12345z","#112233xx"}) {
+        require(valid(),"restore color");require(!f.update("DP-1",style,2,1000,1000,t) && !f.active,"invalid color clears");
+    }
+    for (const double width:{0.,-1.,32.001,std::numeric_limits<double>::infinity(),std::numeric_limits<double>::quiet_NaN()}) {
+        require(valid(),"restore width");require(!f.update("DP-1","#ffffff",width,1000,1000,t) && !f.active,"invalid width clears");
+    }
+    for (const double period:{99.,20001.,100.5,std::numeric_limits<double>::infinity()}) {
+        require(valid(),"restore period");require(!f.update("DP-1","#ffffff",2,period,1000,t) && !f.active,"invalid period clears");
+    }
+    for (const double lease:{99.,10001.,100.5,std::numeric_limits<double>::quiet_NaN()}) {
+        require(valid(),"restore lease");require(!f.update("DP-1","#ffffff",2,1000,lease,t) && !f.active,"invalid lease clears");
+    }
+    require(sceneVisible(true,1.f,false,false,false),"room visible");
+    require(sceneVisible(true,0.f,true,false,false),"exit morph visible");
+    require(sceneVisible(true,0.f,false,true,false),"enter before first frame visible");
+    require(!sceneVisible(true,1.f,true,true,true),"native fullscreen flat");
+    require(!sceneVisible(false,1.f,true,true,false),"inactive flat");
+    require(!sceneVisible(true,0.f,false,false,false),"closed transition flat");
+    require(valid(),"restore phase");
+    require(f.orbitPhase(t+std::chrono::milliseconds(1000))==0.f,"expired phase zero");
+    require(f.update("DP-1","#ffffff",2,1000,10000,t),"long lease");
+    require(std::abs(f.orbitPhase(t)-f.orbitPhase(t+std::chrono::milliseconds(1000)))<0.00001f,"periodic orbit phase");
+    require(std::abs(f.orbitPhase(t+std::chrono::milliseconds(250))-.25f)<0.00001f,"quarter orbit");
+    require(std::abs(f.orbitPhase(t+std::chrono::milliseconds(1250))-.25f)<0.00001f,"phase wraps after full orbit");
+    require(f.orbitPhase(t+std::chrono::milliseconds(999))>=0.f && f.orbitPhase(t+std::chrono::milliseconds(999))<1.f,"normalized phase before wrap");
+    const auto continued=t+std::chrono::milliseconds(1250);
+    const float beforeHeartbeat=f.orbitPhase(continued);
+    require(f.update("DP-1","#ffffff",2,1000,10000,continued),"renew orbit lease");
+    require(std::abs(f.orbitPhase(continued)-beforeHeartbeat)<0.00001f,"heartbeat preserves wrapped orbit phase");
+    // The old heartbeat-only path does not suppress this first render frame.
+    require(suppressFlatLayer("mios-dock-capture-glow","DP-1","DP-1",true),"same-frame layer suppression before shell heartbeat");
+    require(!suppressFlatLayer("mios-dock","DP-1","DP-1",true),"other layers preserved");
+    require(!suppressFlatLayer("mios-dock-capture-glow","DP-2","DP-1",true),"foreign output preserved");
+    require(!suppressFlatLayer("mios-dock-capture-glow","DP-1","DP-1",false),"native fullscreen preserved");
+    require(!suppressFlatLayer("mios-dock-capture-glow","HEADLESS-1","HEADLESS-1",true),"headless excluded");
+    require(suppressFlatLayer("mios-dock-capture-glow","DP-1","DP-1",sceneVisible(true,0,true,false,false)),"exit morph suppresses flat layer");
+    require(suppressFlatLayer("mios-dock-capture-glow","DP-1","DP-1",sceneVisible(true,0,false,true,false)),"enter morph suppresses flat layer");
+    std::vector<std::unique_ptr<float>> factors;
+    factors.push_back(std::make_unique<float>(.6f));const auto* fade=factors.back().get();
+    factors.push_back(std::make_unique<float>(0.f));const auto* ours=factors.back().get();
+    factors.push_back(std::make_unique<float>(.8f));const auto* other=factors.back().get();
+    require(removeFactor(factors,ours),"owned zero factor removed");
+    require(factors.size()==2 && factors[0].get()==fade && factors[1].get()==other,"factor identity preserves native fade and later foreign factors");
+    require(*factors[0]==.6f && *factors[1]==.8f,"no native fade goal/value changes");
+    require(!removeFactor(factors,ours) && factors.size()==2,"stale factor token harmless");
+    *factors[0]=0.f; // native unmap/fade is never restored to an earlier alpha.
+    require(!removeFactor(factors,ours) && *factors[0]==0.f,"unmapped layer never revived");
+    std::cout<<"dock capture validation, lease, circling phase and morph regressions passed\n";
+}
