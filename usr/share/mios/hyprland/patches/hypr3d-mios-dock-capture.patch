+// The same rounded material SDF and interpolated mesh UVs as the window face.
+// No screen-space bounds, extra quad, depth change or second texture capture.
+vec4 miosDockCapture(vec4 base, vec2 coord) {
+    if (uDockCaptureGlow.y<=0.0 || uTextured==0 || uGlassWall!=0) return base;
+    fullSize=max(uGlassMetrics.xy,vec2(1.0));
+    invFullSize=1.0/fullSize; glassBoxSizePx=fullSize; radii=vec4(uGlassMetrics.z);
+    float sd=getCornerSDF(coord);
+    float pixel=max(fwidth(sd),0.001);
+    float coverage=clamp(0.5-sd/pixel,0.0,1.0);
+    float inside=max(-sd,0.0);
+    float width=max(uDockCaptureGlow.x,0.001);
+    float rim=1.0-smoothstep(max(width-pixel,0.0),width+pixel,inside);
+    float halo=0.22*exp(-inside/max(width*1.75,0.001));
+    // Clockwise conical comet, evaluated in the same aspect-correct local
+    // material coordinates as the rounded/CRT edge. The centre has no angle.
+    vec2 edge=(coord-vec2(0.5))*fullSize;
+    float angle=dot(edge,edge)>0.00000001 ? atan(edge.x,-edge.y)/6.283185307179586 : 0.0;
+    float orbit=fract(angle-(uDockCaptureGlow.y-1.0));
+    float comet=orbit<0.12 ? mix(1.0,0.6,orbit/0.12) :
+                orbit<0.4 ? mix(0.6,0.0,(orbit-0.12)/0.28) :
+                orbit<0.9 ? 0.0 : (orbit-0.9)/0.1;
+    float a=clamp(max(rim,halo)*coverage*uDockCaptureColor.a*comet*uColor.a,0.0,1.0);
+    float combined=a+base.a*(1.0-a);
+    vec3 rgb=combined>0.00001 ? (uDockCaptureColor.rgb*a+base.rgb*base.a*(1.0-a))/combined : vec3(0.0);
+    return vec4(rgb,combined);
+}
