+// AI-hint: Pure monotonic lease and style validation for native room-plane dock capture feedback.
+// AI-related: src/main.cpp dock_capture_feedback, src/Render/GLScene.cpp
+#pragma once
+#include <array>
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace MiosDockCapture {
+using Clock = std::chrono::steady_clock;
+inline bool physicalOutput(std::string_view name) {
+    if (name.empty() || name.size() > 128) return false;
+    for (const unsigned char c : name) if (c < 32 || c > 126) return false;
+    constexpr std::string_view headless = "headless";
+    if (name.size() >= headless.size()) {
+        bool same = true;
+        for (size_t i = 0; i < headless.size(); ++i) {
+            const unsigned char c = name[i];
+            same = same && (c == headless[i] || c == headless[i] - 'a' + 'A');
+        }
+        if (same) return false;
+    }
+    return true;
+}
+inline std::optional<std::array<float,4>> color(std::string_view text) {
+    if ((text.size() != 7 && text.size() != 9) || text[0] != '#') return {};
+    std::array<float,4> result{0.f,0.f,0.f,1.f};
+    const auto digit=[](char c)->int {
+        if (c >= '0' && c <= '9') return c-'0';
+        if (c >= 'a' && c <= 'f') return c-'a'+10;
+        if (c >= 'A' && c <= 'F') return c-'A'+10;
+        return -1;
+    };
+    for (size_t i=0; i<(text.size()-1)/2; ++i) {
+        const int hi=digit(text[1+i*2]), lo=digit(text[2+i*2]);
+        if (hi<0 || lo<0) return {};
+        result[i]=static_cast<float>(hi*16+lo)/255.f;
+    }
+    return result;
+}
+// Entering and leaving morphs are room scenes too; fullscreen native passthrough is flat.
+inline bool sceneVisible(bool active, float transition, bool morphing, bool entering, bool in2D) {
+    return active && !in2D && (transition>0.f || morphing || entering);
+}
+// Evaluated in render.pre before the compositor submits any overlay surfaces.
+inline bool suppressFlatLayer(std::string_view layerNamespace, std::string_view output,
+                              std::string_view roomOutput, bool roomVisible) {
+    return layerNamespace=="mios-dock-capture-glow" && physicalOutput(output) &&
+           output==roomOutput && roomVisible;
+}
+// Remove only our multiplicative factor; preserve fade state and unrelated factors.
+template <class Factors, class Token>
+inline bool removeFactor(Factors& factors,const Token* token) {
+    const auto found=std::find_if(factors.begin(),factors.end(),[&](const auto& factor) {return factor.get()==token;});
+    if (found==factors.end()) return false;
+    factors.erase(found);return true;
+}
+struct Feedback {
+    bool active = false;
+    std::string output;
+    std::array<float,4> rgba{};
+    float widthPx = 0.f;
+    int periodMs = 0;
+    Clock::time_point deadline{}, phaseOrigin{};
+    bool clear() { const bool was=active; active=false; return was; }
+    bool live(Clock::time_point now) const { return active && now<deadline; }
+    bool expire(Clock::time_point now) { return active && now>=deadline ? clear() : false; }
+    bool update(std::string_view nextOutput, std::string_view nextColor, double width,
+                double period, double lease, Clock::time_point now) {
+        const auto parsed=color(nextColor);
+        if (!physicalOutput(nextOutput) || !parsed || !std::isfinite(width) || width<=0.0 || width>32.0
+            || !std::isfinite(period) || period<100.0 || period>20000.0 || std::floor(period)!=period
+            || !std::isfinite(lease) || lease<100.0 || lease>10000.0 || std::floor(lease)!=lease) {
+            clear(); return false;
+        }
+        if (!live(now) || output!=nextOutput) phaseOrigin=now;
+        active=true; output=nextOutput; rgba=*parsed; widthPx=static_cast<float>(width);
+        periodMs=static_cast<int>(period); deadline=now+std::chrono::milliseconds(static_cast<int>(lease));
+        return true;
+    }
+    float orbitPhase(Clock::time_point now) const {
+        if (!live(now)) return 0.f;
+        const double turns=std::chrono::duration<double,std::milli>(now-phaseOrigin).count()/periodMs;
+        return std::min(static_cast<float>(turns-std::floor(turns)),std::nextafter(1.f,0.f));
+    }
+};
+}
