+// Per-output room visibility includes both transition directions, not only input ownership.
+static bool dockCaptureSceneVisible(std::string_view output = {}) {
+    if (g_pSessionLockManager && g_pSessionLockManager->isSessionLocked()) return false;
+    const auto mon=targetMonitor();
+    return mon && MiosDockCapture::physicalOutput(mon->m_name) &&
+        (output.empty() || output==mon->m_name) &&
+        MiosDockCapture::sceneVisible(g_active,g_transition,g_viewMorph!=EViewMorph::None,
+                                     g_transitionTarget>0.f,g_fsPhase==EFullscreenPhase::In2D);
+}
+// A separate multiplicative alpha factor hides only the flat feedback layer.
+// Native fade values, goals and callbacks are never modified. Weak references
+// prevent this bookkeeping from extending a layer's Wayland lifetime.
+struct DockCaptureLayerFactor {PHLLSREF layer;CAnimatedVariable<float>* factor=nullptr;};
+static std::vector<DockCaptureLayerFactor> g_dockCaptureLayerFactors;
+static void clearDockCaptureLayerFactors() {
+    for (auto& item:g_dockCaptureLayerFactors)
+        if (const auto layer=item.layer.lock()) {
+            if (MiosDockCapture::removeFactor(layer->alpha().all(),item.factor) && g_pHyprRenderer)
+                if (const auto mon=layer->m_monitor.lock();mon && MiosDockCapture::physicalOutput(mon->m_name))
+                    g_pHyprRenderer->damageMonitor(mon);
+        }
+    g_dockCaptureLayerFactors.clear();
+}
+static void syncDockCaptureLayerFactors(const PHLMONITOR& mon) {
+    const auto room=targetMonitor();
+    std::erase_if(g_dockCaptureLayerFactors,[&](auto& item) {
+        const auto layer=item.layer.lock();
+        const auto output=layer?layer->m_monitor.lock():nullptr;
+        const bool keep=layer && output && room &&
+            MiosDockCapture::suppressFlatLayer(layer->m_namespace,output->m_name,room->m_name,
+                                               dockCaptureSceneVisible(output->m_name));
+        if (keep) {
+            const auto& factors=layer->alpha().all();
+            if (std::any_of(factors.begin(),factors.end(),[&](const auto& f){return f.get()==item.factor;})) return false;
+        }
+        if (layer) MiosDockCapture::removeFactor(layer->alpha().all(),item.factor);
+        return true;
+    });
+    if (!mon || !room || !dockCaptureSceneVisible(mon->m_name) || !Animation::mgr()) return;
+    for (const auto& list:mon->m_layerSurfaceLayers) for (const auto& ref:list) {
+        const auto layer=ref.lock();
+        if (!layer || !layer->m_mapped || layer->m_monitor.lock()!=mon ||
+            !MiosDockCapture::suppressFlatLayer(layer->m_namespace,mon->m_name,room->m_name,true)) continue;
+        if (std::any_of(g_dockCaptureLayerFactors.begin(),g_dockCaptureLayerFactors.end(),
+            [&](const auto& item){return item.layer.lock()==layer;})) continue;
+        auto& factors=layer->alpha().all();
+        if (factors.empty() || !factors.front()) continue;
+        PHLANIMVAR<float> zero;
+        Animation::mgr()->createAnimation(0.f,zero,factors.front()->getConfig().lock(),AVARDAMAGE_NONE);
+        // Allocate bookkeeping first: a failed vector growth cannot leave an unowned factor.
+        g_dockCaptureLayerFactors.push_back({layer,zero.get()});
+        factors.push_back(std::move(zero));
+    }
+}
+static void clearDockCaptureFeedback() {
+    g_dockCaptureFeedback.clear();
+    if (g_dockCapturePainted) damageCurrentMonitor();
+    g_dockCapturePainted=false;
+}
+static void applyDockCaptureFeedback(const PHLMONITOR& mon) {
+    const auto now=MiosDockCapture::Clock::now();
+    const bool expired=g_dockCaptureFeedback.expire(now);
+    if (expired && g_dockCapturePainted) damageCurrentMonitor();
+    const bool visible=mon && mon->m_name==g_dockCaptureFeedback.output &&
+        dockCaptureSceneVisible(g_dockCaptureFeedback.output) && g_dockCaptureFeedback.live(now) &&
+        g_dockCaptureFeedback.rgba[3]>0.f;
+    bool painted=false;
+    for (auto& window:g_renderWindows) {
+        window.dockCaptureColor={};window.dockCaptureGlow={};
+        if (!visible || !window.texture || window.alpha<=0.f || window.glassMetrics[3]<=.5f) continue;
+        window.dockCaptureColor=g_dockCaptureFeedback.rgba;
+        window.dockCaptureGlow={g_dockCaptureFeedback.widthPx,1.f+g_dockCaptureFeedback.orbitPhase(now)};
