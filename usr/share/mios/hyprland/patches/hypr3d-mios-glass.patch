+std::vector<float> buildEnvironmentDome() {
+    // Structural tessellation, not a wallpaper resolution: the original
+    // GPU texture stays live and keeps its output dimensions. Duplicate
+    // seam vertices carry u=0 and u=1 so no triangle crosses the UV wrap.
+    constexpr int longitudeSegments = 96, latitudeSegments = 48;
+    std::vector<float> dome;
+    auto vertex = [&](int x, int y) {
+        const float u = float(x) / longitudeSegments;
+        const float v = float(y) / latitudeSegments;
+        const float lon = (u - 0.5f) * 2.f * PI;
+        const float lat = (0.5f - v) * PI;
+        dome.insert(dome.end(), {std::sin(lon) * std::cos(lat),
+                    std::sin(lat), -std::cos(lon) * std::cos(lat), u, v});
+    };
+    for (int y = 0; y < latitudeSegments; ++y)
+        for (int x = 0; x < longitudeSegments; ++x) {
+            vertex(x,y); vertex(x+1,y); vertex(x+1,y+1);
+            vertex(x,y); vertex(x+1,y+1); vertex(x,y+1);
+        }
+    return dome;
+}
