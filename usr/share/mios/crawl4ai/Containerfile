# AI-hint: Defines the Docker build for the crawl4ai engine, providing a Python 3.12 environment with camoufox for stealth fallback and a FastAPI wrapper to process web scraping tasks via CDP or local Firefox.
# AI-related: mios-crawl4ai-service
FROM localhost/mios-base:latest

RUN dnf5 install -y firefox nss gtk3 alsa-lib libX11 libXcomposite libXdamage libXrandr mesa-libgbm \
    && dnf5 clean all \
    && python3.13 -m venv /opt/crawl4ai-venv
ENV PATH=/opt/crawl4ai-venv/bin:$PATH

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN pip install --no-cache-dir \
        crawl4ai \
        "camoufox[geoip]" \
        fastapi \
        "uvicorn[standard]" \
        pydantic \
        playwright

RUN playwright install firefox

RUN python -m camoufox fetch

WORKDIR /app
EXPOSE 11235
CMD ["python", "/app/mios-crawl4ai-service.py"]
