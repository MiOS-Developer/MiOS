# AI-hint: MiOS mios-headscale container. (WS-7 pods-as-SSOT).
# DO NOT EDIT -- regenerate via tools/generate-pod-quadlets.py from [containers.mios-headscale] in mios.toml.
# /usr/share/containers/systemd/mios-headscale.container

[Unit]
After=network-online.target mios-headscale-firstboot.service
Description='MiOS' Headscale Mesh VPN Control Plane Coordinator
Requires=mios-headscale-firstboot.service
Wants=network-online.target

[Container]
ContainerName=mios-headscale
Exec=serve
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
Group=833
Image=docker.io/headscale/headscale:latest
Label=org.opencontainers.image.title=mios-headscale
Label=org.opencontainers.image.url=https://github.com/juanfont/headscale
Label=io.podman_desktop.openInBrowser=http://localhost:8085/metrics
Pod=mios-system.pod
User=833
Volume=/etc/headscale:/etc/headscale:Z
Volume=/var/lib/headscale:/var/lib/headscale:Z
Volume=/run/headscale:/var/run/headscale:Z
Volume=/usr/share/mios/mini/headscale-policy.hujson:/usr/share/mios/mini/headscale-policy.hujson:ro

[Install]
WantedBy=multi-user.target default.target

[Service]
Delegate=yes
ExecCondition=/usr/libexec/mios/mios-headscale-firstboot --enabled-check
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300s
