# AI-hint: MiOS mios-piper container. (WS-7 pods-as-SSOT).
# DO NOT EDIT -- regenerate via tools/generate-pod-quadlets.py from [containers.mios-piper] in mios.toml.
# /usr/share/containers/systemd/mios-piper.container

[Unit]
After=network-online.target mios-cdi-detect.service mios-webtools-firstboot.service
Description='MiOS' Piper Streaming TTS Engine (piper1-gpl http_server)
Documentation=https://github.com/OHF-Voice/piper1-gpl
Wants=network-online.target

[Container]
ContainerName=mios-piper
EnvironmentFile=/etc/mios/install.env
Exec=-m en_US-lessac-medium --data-dir /usr/share/piper/voices --host 0.0.0.0 --port ${MIOS_PORTS_PIPER}
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
Group=831
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:${MIOS_PORTS_PIPER}/info', timeout=5)" || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s
HealthTimeout=10s
Image=localhost/mios-piper:latest
Label=org.opencontainers.image.title=mios-piper
Label=org.opencontainers.image.description="Local piper1-gpl streaming server for MiOS real-time speech synthesis"
Label=org.opencontainers.image.source=https://github.com/OHF-Voice/piper1-gpl
Label=org.opencontainers.image.licenses=GPL-3.0-or-later
Pod=mios-ai.pod
User=831
Volume=/run/mios:/run/mios:Z

[Install]
WantedBy=multi-user.target default.target

[Service]
Delegate=yes
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300s
