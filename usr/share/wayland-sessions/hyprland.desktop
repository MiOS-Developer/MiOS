# AI-hint: Generated MiOS desktop session; hardware profile is the only session difference.
# AI-related: /usr/share/mios/mios.toml, /usr/share/mios/hyprland/session.lua
[Desktop Entry]
Name=MiOS iGPU (default)
Comment=MiOS Hyprland and Quickshell; igpu hardware profile
Exec=/usr/bin/mios-gen hyprland-session --hardware-profile igpu
TryExec=/usr/bin/mios-gen
Type=Application
DesktopNames=Hyprland
