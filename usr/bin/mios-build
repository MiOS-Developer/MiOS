#!/usr/bin/env bash
# AI-hint: Local development tool that performs a local podman build of the current tree, optionally staging the image via bootc switch or rebooting the system to bypass the remote CI/CD pipeline for rapid iteration.
# AI-related: /etc/mios/install.env, mios-rebuild

set -euo pipefail

TAG="localhost/mios:latest"
DO_SWITCH=1
DO_REBOOT=0

while (( $# > 0 )); do
    case "$1" in
        --apply)      DO_REBOOT=1; shift ;;
        --no-switch)  DO_SWITCH=0; shift ;;
        --tag)        TAG="$2"; shift 2 ;;
        --help|-h)
            sed -n '2,15p' "$0" | sed 's/^# \?//'
            exit 0
            ;;
        *)
            echo "Mios-build: unknown flag '$1'" >&2
            exit 2
            ;;
    esac
done

if [[ $EUID -ne 0 ]]; then
    exec sudo -E "$0" "$@"
fi

if [[ ! -f /Containerfile ]]; then
    echo "ERROR: /Containerfile not found. Is this a MiOS-deployed root" >&2
    exit 1
fi

if [[ -r /etc/mios/install.env ]]; then
    _mios_had_u=0; case "$-" in *u*) _mios_had_u=1;; esac
    set +u; set -a; source /etc/mios/install.env 2>/dev/null || true; set +a
    [ "$_mios_had_u" = 1 ] && set -u
fi

BUILD_ARGS=()
[[ -n "${MIOS_LINUX_USER:-}"        ]] && BUILD_ARGS+=(--build-arg "MIOS_IDENTITY_USERNAME=${MIOS_LINUX_USER}")
[[ -n "${MIOS_IDENTITY_HOSTNAME:-}"          ]] && BUILD_ARGS+=(--build-arg "MIOS_IDENTITY_HOSTNAME=${MIOS_IDENTITY_HOSTNAME}")
[[ -n "${MIOS_AI_MODEL:-}"          ]] && BUILD_ARGS+=(--build-arg "MIOS_AI_MODEL=${MIOS_AI_MODEL}")
[[ -n "${MIOS_AI_EMBED_MODEL:-}"    ]] && BUILD_ARGS+=(--build-arg "MIOS_AI_EMBED_MODEL=${MIOS_AI_EMBED_MODEL}")

echo "[mios-build] building ${TAG} from /"
podman build "${BUILD_ARGS[@]}" -f /Containerfile -t "${TAG}" /

if (( DO_SWITCH )); then
    echo "[mios-build] staging via bootc switch"
    bootc switch --transport containers-storage "${TAG}"
fi

if (( DO_REBOOT )); then
    echo "[mios-build] rebooting in 3s "
    sleep 3
    systemctl reboot
else
    echo
    echo "Build staged. Reboot to apply:"
    echo "    sudo systemctl reboot"
fi

exit 0
