#!/usr/bin/env bash
# AI-hint: Wrapper script to launch the Chrome Dev flatpak with the --remote-debugging-port flag enabled, allowing the Hermes Agent to connect via CDP at port 9222 to share the operator's browser session.
# AI-related: mios-chrome-profile, localhost:9222
# AI-functions: _status

set -euo pipefail

CDP_PORT="${MIOS_PORTS_CHROME_CDP:-9222}"
FLATPAK_ID="${MIOS_CHROME_FLATPAK_ID:-com.google.ChromeDev}"

_status() {
    if ! command -v flatpak >/dev/null 2>&1; then
        echo "Flatpak: not installed"; return 1
    fi
    if ! flatpak info "$FLATPAK_ID" >/dev/null 2>&1; then
        echo "Flatpak: $FLATPAK_ID NOT installed"
        return 1
    fi
    echo "Flatpak: $FLATPAK_ID installed"
    if curl -fsS -m 2 "http://localhost:${CDP_PORT}/json/version" >/dev/null 2>&1; then
        echo "CDP: reachable on :$CDP_PORT"
        curl -s "http://localhost:${CDP_PORT}/json/version" | head -3
    else
        echo "CDP: not reachable on :$CDP_PORT"
    fi
}

case "${1:-}" in
    --status|status)
        _status; exit $?
        ;;
    --help|-h|help)
        sed -n '/^# /,/^$/{s/^# \?//;p}' "$0" | head -32
        exit 0
        ;;
esac

USE_CDP=1
if [[ "${1:-}" == "--no-cdp" ]]; then
    USE_CDP=0
    shift
fi

cdp_args=()
if [[ $USE_CDP -eq 1 ]]; then
    cdp_args+=("--remote-debugging-port=${CDP_PORT}")
    cdp_args+=("--remote-debugging-address=127.0.0.1")
    cdp_args+=("--user-data-dir=${HOME}/.local/share/mios-chrome-profile")
fi

wayland_args=(
    "--ozone-platform=wayland"
    "--enable-features=UseOzonePlatform,WaylandWindowDecorations"
    "--gtk-version=4"
)

exec flatpak run "$FLATPAK_ID" "${wayland_args[@]}" "${cdp_args[@]}" "$@"
