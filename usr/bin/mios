def _load_routing_list(key: str) -> list:
    """Load a [routing].<key> phrase list from the layered mios.toml (lowercased,
    longest-first). SSOT -- no hardcoded English. Fail-safe -> []."""
    env_var = "MIOS_ROUTING_" + key.upper()
    env_val = os.environ.get(env_var) or os.environ.get("MIOS_" + key.upper())
    if env_val:
        return sorted({s.strip().lower() for s in env_val.split(",") if s.strip()}, key=len, reverse=True)
    try:
        import tomllib
    except ImportError:
        try:
            import tomli as tomllib  # type: ignore
        except ImportError:
            return []
    for p in (os.environ.get("MIOS_TOML", ""), "/etc/mios/mios.toml",
              "/usr/share/mios/mios.toml"):
        if not p or not pathlib.Path(p).is_file():
            continue
        try:
            with open(p, "rb") as f:
                rt = (tomllib.load(f).get("routing") or {})
            vals = sorted(
                {str(x).lower().strip() for x in (rt.get(key) or []) if str(x).strip()},
                key=len, reverse=True)
            if vals:
                return vals
        except Exception:
            continue
    return []


_CLI_LAUNCH_TRIGGERS = frozenset(_load_routing_list("launch_triggers"))
_CLI_COMPOUND = frozenset(_load_routing_list("compound_connectives"))


def _cli_launch_followup(prompt: str) -> bool:
    """True if `prompt` is a launch FOLLOW-UP / RETRY about a PRIOR launch
    (operator 2026-06-14, BUG B/C): "epiphany didn't launch for me", "attempt to
    launch and verify", "try again". These carry no fresh "open/launch X" head,
    so `_cli_launch_target` returns None and they fell through to free-form
    Hermes -> narration. When the session has a remembered last-launched app, the
    caller re-runs the launch+verify path against it deterministically. Phrase
    lists are SSOT [routing].launch_followup_phrases / launch_retry_phrases (no
    hardcoded English here)."""
    t = (prompt or "").strip().lower()
    if not t or len(t) > 160:
        return False
    for key in ("launch_followup_phrases", "launch_retry_phrases"):
        for ph in _load_routing_list(key):
            if ph and ph in t:
                return True
    return False


def _run_verified_launch(app: str) -> int:
    """Fire the LAUNCH+VERIFY path for `app` (the launch_and_verify_app verb's
    backend: mios-os-control launch <app>, which fires the launch THEN polls the
    window verifier). This is what a launch RETRY/VERIFY follow-up should run --
    not narrate (operator 2026-06-14, BUG B: the CLI told the operator to run
    `mios-gui epiphany` and asked permission instead of acting). Falls back to a
    plain mios-launch + mios-verify-launch when mios-os-control is absent, then to
    a bare mios-launch. Returns the process exit code (0 = launched/verified)."""
    for argv in (["mios-os-control", "launch", app],):
        try:
            sys.stderr.write(f"mios: launching + verifying '{app}' (deterministic verify route)\n")
            return subprocess.run(argv).returncode
        except FileNotFoundError:
            break
    try:
        sys.stderr.write(f"mios: launching '{app}' (deterministic launch route)\n")
        rc = subprocess.run(["mios-launch", app]).returncode
    except FileNotFoundError:
        return 127
    try:
        subprocess.run(["mios-verify-launch", app])
    except FileNotFoundError:
        pass
    return rc


def _cli_launch_target(prompt: str):
    """If `prompt` is an unambiguous 'open/launch/start/run <app>', return the
    cleaned app name for mios-launch; else None (fall through to chat)."""
    t = (prompt or "").strip()
    if not t or len(t) > 80 or "?" in t:
        return None
    words = t.split()
    if len(words) < 2:
        return None
    if words[0].lower().strip(".,:;!\"'") not in _CLI_LAUNCH_TRIGGERS:
        return None
    rest = " ".join(words[1:]).strip().rstrip(" .,!;:")
    low = rest.lower()
    fillers = _load_routing_list("launch_filler_phrases")
    changed = True
    while changed and rest:
        changed = False
        for f in fillers:
            if f and low.endswith(f):
                rest = rest[: len(rest) - len(f)].rstrip(" ,.")
                low = rest.lower()
                changed = True
                break
    lead = set(_load_routing_list("launch_target_lead_phrases"))
    trail = set(_load_routing_list("launch_target_trail_phrases"))
    rw = rest.split()
    while rw and rw[0].lower() in lead:
        rw.pop(0)
    while rw and rw[-1].lower() in trail:
        rw.pop()
    rest = " ".join(rw).strip()
    low = rest.lower()
    if not rest or len(rest.split()) > 3:
        return None
    if "://" in rest or any(w in _CLI_COMPOUND for w in low.split()):
        return None
    return rest


def _daemon_main(args: list[str]) -> int:
    """MiOS daemon supervisor: refresh agent session leases and forward pending messages."""
    import shutil
    import time
    install_cron = "--install-cron" in args or "--cron" in args

    if install_cron:
        cron_file = pathlib.Path("/etc/mios/cron-rules.toml")
        cron_entry = (
            "\n# Global agent relay lease refresh and message forwarder\n"
            "[[rule]]\n"
            "name = \"agent-relay-refresh-forward\"\n"
            "cron = \"* * * * *\"\n"
            "do   = \"/usr/bin/mios daemon --tick\"\n"
        )
        try:
            cron_file.parent.mkdir(parents=True, exist_ok=True)
            current = cron_file.read_text(encoding="utf-8") if cron_file.is_file() else ""
            if "agent-relay-refresh-forward" not in current:
                with cron_file.open("a", encoding="utf-8") as f:
                    f.write(cron_entry)
                print("[mios daemon] Registered cron rule in /etc/mios/cron-rules.toml")
            else:
                print("[mios daemon] Cron rule already registered in /etc/mios/cron-rules.toml")
        except Exception as e:
            sys.stderr.write(f"[mios daemon] Warning: could not write /etc/mios/cron-rules.toml: {e}\n")

    state_dir = pathlib.Path(os.environ.get("XDG_STATE_HOME") or pathlib.Path.home() / ".local/state") / "mios" / "agent-relay"
    state_file = state_dir / "state.json"
    notified_count = 0
    refreshed_count = 0
    now = int(time.time())

    if state_file.is_file():
        try:
            data = json.loads(state_file.read_text(encoding="utf-8"))
            agents = data.get("agents", {})
            messages = data.get("messages", [])

            for aid, ainfo in agents.items():
                if ainfo.get("expires", 0) > now - 60:
                    ainfo["expires"] = now + 300
                    refreshed_count += 1

            for m in messages:
                if m.get("status") == "queued" and now - m.get("created", 0) < 300:
                    target = m.get("to", "")
                    sender = m.get("from", "")
                    mid = m.get("message_id", "")
                    try:
                        tmux_bin = shutil.which("tmux")
                        if tmux_bin:
                            subprocess.run([tmux_bin, "display-message", f"[MiOS Relay] Inbound message {mid} for {target} from {sender}"],
                                           capture_output=True, timeout=2)
                            notified_count += 1
                    except Exception:
                        pass

            if refreshed_count > 0:
                tmp = state_file.with_suffix(".tmp")
                tmp.write_text(json.dumps(data, indent=2), encoding="utf-8")
                tmp.replace(state_file)
        except Exception as e:
            sys.stderr.write(f"[mios daemon] Error processing relay state: {e}\n")

    print(json.dumps({
        "status": "ok",
        "tick": now,
        "leases_refreshed": refreshed_count,
        "messages_notified": notified_count
    }))
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2 and sys.stdin.isatty() and sys.stdout.isatty() and sys.platform != "win32":
        os.execv("/usr/libexec/mios/mios-terminal", ["mios-terminal"])
    if len(argv) >= 2 and argv[1] in ("agents", "agent"):
        if argv[1] == "agent" and len(argv) > 2 and sys.stdin.isatty() and sys.stdout.isatty() and not os.environ.get("TMUX"):
            os.execv("/usr/libexec/mios/mios-terminal", ["mios-terminal", "--agent", *argv[2:]])
        option = "--agent-cli" if argv[1] == "agents" else "--launch-agent"
        os.execv(sys.executable, [sys.executable, "/usr/libexec/mios/mios-mcp-server", option, *argv[2:]])
    if len(argv) >= 2 and argv[1] in ("ai", "ai-workspace"):
        if len(argv) >= 3 and argv[2].lower() == "clear":
            _clear = "/usr/libexec/mios/mios-ai-clear"
            if pathlib.Path(_clear).is_file():
                os.execvp(_clear, [_clear] + argv[3:])
            sys.stderr.write("mios: mios-ai-clear not found at %s\n" % _clear)
            return 1
        if not os.environ.get("TMUX") and sys.stdin.isatty() and sys.stdout.isatty() and sys.platform != "win32":
            os.execv("/usr/libexec/mios/mios-terminal", ["mios-terminal", "--workspace", *argv[2:]])
        os.execv(sys.executable, [sys.executable, "/usr/libexec/mios/mios-mcp-server", "--workspace", *argv[2:]])
    if len(argv) >= 2 and argv[1] == "daemon":
        return _daemon_main(argv[2:])
    if (len(argv) < 2 or (len(argv) >= 2 and argv[1] in ("mon", "monitor"))) and sys.stdin.isatty() and sys.stdout.isatty():
        mon_bin = "/usr/libexec/mios/mios-dashboard"
        mon_py = "/usr/libexec/mios/mios-mon.py"
        extra_args = argv[2:] if len(argv) >= 2 and argv[1] in ("mon", "monitor") else []
        root = os.environ.get("MIOS_DRIFT_ROOT") or os.environ.get("MIOS_ROOT") or (
            os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
            if os.path.isabs(__file__) else None
        )
        for cand in [
            os.path.join(root, "usr/libexec/mios/mios-mon.py") if root else None,
            "C:/MiOS/usr/libexec/mios/mios-mon.py",
            mon_py,
        ]:
            if cand and os.path.isfile(cand):
                os.execv(sys.executable, [sys.executable, cand, *extra_args])
        if os.path.isfile(mon_bin) and os.access(mon_bin, os.X_OK):
            os.execv(mon_bin, [mon_bin, *extra_args])
        sys.stderr.write("mios: monitor interface not found at " + mon_py + "\n")
        return 1
    if len(argv) >= 2 and argv[1] in ("shell", "terminal") and sys.stdin.isatty() and sys.stdout.isatty() and sys.platform != "win32":
        os.execv("/usr/libexec/mios/mios-terminal", ["mios-terminal", *argv[2:]])
    if len(argv) < 2 or argv[1] in ("-h", "--help") or (len(argv) >= 2 and argv[1] == "help"):
        sys.stderr.write(
            "mios -- MiOS verb dispatcher + locally-hosted OpenAI agent shell.\n\n"
            "Verbs:\n"
            "  mios                               unified tmux workspace (clients, agents, systems)\n"
            "  mios mon (or monitor)              unified live TUI monitor\n"
            "  mios terminal (or shell)             native themed tmux interface (local or SSH)\n"
            "  mios ai-terminal                     mobile text interface to MiOS AI\n"
            "  mios mcp                             combined MiOS + terminal MCP stdio\n"
            "  mios agents [--install]              global SSOT agent CLI catalog / installation\n"
            "  mios agent NAME [ARGS...]            launch a globally installed agent with native MCP\n"
            "  mios build                           run the MiOS OCI build pipeline (unattended on a non-TTY)\n"
            "  mios dash                            framed dashboard snapshot (services + telemetry)\n"
            "  mios mini                            compact framed static dashboard snapshot\n"
            "  mios config                          open the HTML configurator in your browser\n"
            "  mios code                            open code-server in your browser\n"
            "  mios ai [AGENT ARGS...]               native responsive head + four worker workspace\n"
            "  mios ai-web                          open Open WebUI in your browser\n"
            "  mios ai clear                        DAY-0 clean slate: wipe chats/jobs/kanban/DBs/RAG\n"
            "  mios xbox                            Xbox VM Secure Boot / XML repair\n"
            "  mios virt                            apply optimized VM config + CPU pinning\n"
            "  mios vfio                            configure GPU/USB passthrough (Isolation)\n"
            "  mios vfio-check                      report VFIO / IOMMU binding state\n"
            "  mios vfio-toggle                     interactive VFIO device selector\n"
            "  mios tune                            system-wide CPU isolation & latency tuning\n"
            "  mios summary                         quick ASCII system overview\n"
            "  mios profile                         interactive hardware/system profiler menu\n"
            "  mios assess                          comprehensive system capability report\n"
            "  mios iommu                           pretty-print hardware IOMMU topology\n"
            "  mios iommu-groups                    list raw IOMMU groups and devices\n"
            "  mios env                             inspect layered MIOS_* environment\n"
            "  mios sync-env                        regenerate install.env from mios.toml\n"
            "  mios blade                           manage blade roles and activation capabilities\n"
            "  mios flatpaks                        manage system-wide Flatpaks\n"
            "  mios theme                           sync bibata/GTK/Qt themes\n"
            "  mios dotfiles                        project the SSOT dotfiles to your LIVE HOME\n"
            "  mios new <type> <name>               scaffold a new file from templates\n"
            "  mios user                            initialize user space (dotfiles/XDG)\n"
            "  mios models                          manage first-boot large models (list, sync, add, rm)\n"
            "  mios secret                          secure secrets management & Linux Keyrings\n"
            "  mios status                          system status (--json, --yaml, --table)\n"
            "  mios version                         system version & Law conformance\n"
            "  mios health                          system health assessment\n"
            "  mios info                            system telemetry and platform info\n"
            "  mios help                            this help\n\n"
            "Chat (anything else):\n"
            "  mios <prompt>                        chat + tool calls against Hermes-Agent\n"
            "  mios --no-tools <prompt>             disable function calling\n"
            "  mios --json <schema-name> <prompt>   structured output (schema-name = file in\n"
            "                                       /usr/lib/mios/schemas/ without .schema.json)\n"
        )
        try:
            root = os.environ.get("MIOS_DRIFT_ROOT") or os.environ.get("MIOS_ROOT") or (
                os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
                if os.path.isabs(__file__) else None
            )
            _lib_path = os.path.join(root, "usr", "lib", "mios") if root else "/usr/lib/mios"
            if _lib_path not in sys.path and os.path.isdir(_lib_path):
                sys.path.insert(0, _lib_path)
            from cli.plugin_loader import get_available_plugins
            plugins = get_available_plugins()
            if plugins:
                sys.stderr.write("\nPlugins:\n")
                for p_name, p_info in plugins.items():
                    sys.stderr.write(f"  mios {p_name.ljust(30)} {p_info.description}\n")
        except Exception:
            pass
        return 0 if len(argv) >= 2 else 1

    if len(argv) >= 3 and argv[1].lower() == "ai" and argv[2].lower() == "clear":
        _clear = "/usr/libexec/mios/mios-ai-clear"
        if pathlib.Path(_clear).is_file():
            os.execvp(_clear, [_clear] + argv[3:])
        sys.stderr.write("mios: mios-ai-clear not found at %s\n" % _clear)
        return 1

    # T-513: Dynamic TTY / JSON / YAML output formatting engine
    root = os.environ.get("MIOS_DRIFT_ROOT") or os.environ.get("MIOS_ROOT") or (
        os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
        if os.path.isabs(__file__) else None
    )
    _lib_path = os.path.join(root, "usr", "lib", "mios") if root else "/usr/lib/mios"
    if _lib_path not in sys.path and os.path.isdir(_lib_path):
        sys.path.insert(0, _lib_path)

    first_low = argv[1].lower()
    if first_low in ("version", "-v", "--version", "health", "info"):
        try:
            from cli.formatter import (
                OutputFormatter,
                get_system_health,
                get_system_info,
                get_system_version,
            )
            force_fmt = None
            if "--json" in argv:
                force_fmt = "json"
            elif "--yaml" in argv:
                force_fmt = "yaml"
            elif "--table" in argv or "--text" in argv:
                force_fmt = "table"

            formatter = OutputFormatter(force_format=force_fmt)
            if first_low in ("version", "-v", "--version"):
                res = get_system_version()
                title = "MiOS Version"
            elif first_low == "health":
                res = get_system_health()
                title = "MiOS System Health"
            else:
                res = get_system_info()
                title = "MiOS System Information"

            print(formatter.format(res, title=title))
            return 0
        except Exception as e:
            sys.stderr.write(f"mios: output formatting error: {e}\n")
            return 1

    if first_low == "status":
        try:
            from cli.formatter import OutputFormatter, get_system_status
            status_bin = os.path.join(root, "usr", "libexec", "mios", "mios-system-status") if root else "/usr/libexec/mios/mios-system-status"
            if os.path.isfile(status_bin):
                cmd = [status_bin] if os.access(status_bin, os.X_OK) else [sys.executable, status_bin]
                cp = subprocess.run(cmd, capture_output=True, text=True)
                if cp.returncode == 0 and cp.stdout.strip():
                    try:
                        data = json.loads(cp.stdout)
                    except Exception:
                        data = get_system_status()
                else:
                    data = get_system_status()
            else:
                data = get_system_status()

            force_fmt = None
            if "--json" in argv:
                force_fmt = "json"
            elif "--yaml" in argv:
                force_fmt = "yaml"
            elif "--table" in argv or "--text" in argv:
                force_fmt = "table"

            formatter = OutputFormatter(force_format=force_fmt)
            print(formatter.format(data, title="MiOS System Status"))
            return 0
        except Exception as e:
            sys.stderr.write(f"mios status: {e}\n")
            return 1

    first = argv[1]
    if first in KNOWN_VERBS and KNOWN_VERBS[first] is not None:
        cmd = KNOWN_VERBS[first]
        target = cmd[0]
        if sys.platform == "win32" and target.endswith("mios-dashboard"):
            for cand in [
                os.path.join(root, "usr/libexec/mios/mios-mon.py") if root else None,
                os.path.join(root, "installation/mios-mon.py") if root else None,
                "C:/MiOS/usr/libexec/mios/mios-mon.py",
                "M:/usr/libexec/mios/mios-mon.py",
                "/usr/libexec/mios/mios-mon.py",
            ]:
                if cand and pathlib.Path(cand).is_file():
                    py_exec = sys.executable or ("python.exe" if sys.platform == "win32" else "python3")
                    py_args = [py_exec, cand] + cmd[1:] + argv[2:]
                    if sys.platform == "win32":
                        sys.exit(subprocess.call(py_args))
                    else:
                        os.execvp(py_exec, py_args)

        resolved_target = os.path.join(root, target.lstrip("/\\")) if root else target
        if not pathlib.Path(target).is_file() and not (root and pathlib.Path(resolved_target).is_file()):
            if target.endswith("miosd") and root:
                for cand in [
                    os.path.join(root, "src/mios-rs/target/release/miosd"),
                    os.path.join(root, "src/mios-rs/target/debug/miosd"),
                ]:
                    if pathlib.Path(cand).is_file():
                        resolved_target = cand
                        break
        if pathlib.Path(target).is_file() or (root and pathlib.Path(resolved_target).is_file()) or subprocess.run(
            ["sh", "-c", f"command -v {target}"], capture_output=True, text=True
        ).returncode == 0:
            exec_target = target if pathlib.Path(target).is_file() else (resolved_target if root and pathlib.Path(resolved_target).is_file() else target)
            os.execvp(exec_target, [exec_target] + cmd[1:] + argv[2:])

        sys.stderr.write(f"mios: required entrypoint is unavailable: {target}\n")
        return 127

    # Dynamic plugin dispatch (T-514)
    try:
        from cli.plugin_loader import get_available_plugins, run_plugin
        plugins = get_available_plugins()
        if first_low in plugins:
            return run_plugin(first_low, argv[2:])
    except Exception as e:
        sys.stderr.write(f"mios: plugin error: {e}\n")

    use_tools  = False
    schema_obj = None
    args = argv[1:]
    if args and args[0] in ("--no-tools", "--thin"):
        use_tools = False
        args = args[1:]
    elif args and args[0] == "--tools":
        use_tools = True
        args = args[1:]
    elif args and args[0] == "--json":
        if len(args) < 3:
            sys.stderr.write("mios --json requires <schema-name> <prompt>\n")
            return 2
        schema_obj = load_schema(args[1])
        if not schema_obj:
            sys.stderr.write(
                f"mios: schema '{args[1]}' not found at "
                f"{LIB}/schemas/{args[1]}.schema.json\n"
            )
            return 2
        use_tools = False
        args = args[2:]

    prompt = " ".join(args).strip()
    if not prompt:
        sys.stderr.write("mios: empty prompt\n")
        return 2

    session = load_session()

    if use_tools:
        _app = _cli_launch_target(prompt)
        if _app:
            try:
                sys.stderr.write(f"mios: launching '{_app}' (deterministic launch route)\n")
                _r = subprocess.run(["mios-launch", _app])
                _ok = _r.returncode == 0
                print(f"Opened {_app}." if _ok
                      else f"Could not open {_app} (mios-launch exit {_r.returncode}).")
                session["last_app"] = _app
                save_session(session)
                return 0 if _ok else 1
            except FileNotFoundError:
                pass  # mios-launch not on PATH -> fall through to the chat path
        elif _cli_launch_followup(prompt):
            _last = session.get("last_app")
            if _last:
                _rc = _run_verified_launch(str(_last))
                _ok = _rc == 0
                print(f"Re-ran launch + verify for {_last}: "
                      + ("confirmed it opened." if _ok
                         else f"still could not confirm it opened (exit {_rc})."))
                session["last_app"] = str(_last)
                save_session(session)
                return 0 if _ok else 1

    try:
        from openai import OpenAI
    except ImportError:
        sys.stderr.write(
            "mios: openai SDK missing. Install via:\n"
            "    sudo dnf install -y python3-openai      # Fedora 44+\n"
            "  OR\n"
            "    pip install --user 'openai>=1.55'\n"
        )
        sys.exit(127)

    client = OpenAI(base_url=ENDPOINT, api_key=API_KEY, default_headers={"x-mios-reasoning-ok": "true"})
    is_orchestrator = ":8640" in ENDPOINT or "/agent-pipe" in ENDPOINT
    msgs: list[dict[str, Any]] = []
    if not is_orchestrator:
        msgs.append({"role": "system", "content": resolve_system_prompt()})
    _replay = (not schema_obj) and isinstance(session.get("history"), list)
    if _replay:
        for _m in session["history"][-(SESSION_HISTORY_TURNS * 2):]:
            if isinstance(_m, dict) and _m.get("role") in ("user", "assistant") and _m.get("content"):
                msgs.append({"role": _m["role"], "content": str(_m["content"])})
    msgs.append({"role": "user", "content": prompt})
    tools = load_tools() if use_tools else None

    import socket as _socket, platform as _platform, datetime as _datetime
    _now = _datetime.datetime.now().astimezone()
    _client_vars = {"SURFACE": "mios-cli"}
    try: _client_vars["CWD"] = os.getcwd()
    except OSError: pass
    try: _client_vars["HOST"] = _socket.gethostname()
    except OSError: pass
    try: _client_vars["OS"] = (_platform.system() + " " + _platform.release()).strip()
    except Exception: pass
    _client_vars["CURRENT_DATE"] = _now.strftime("%Y-%m-%d")
    _client_vars["CURRENT_TIME"] = _now.strftime("%H:%M")
    _client_vars["CURRENT_WEEKDAY"] = _now.strftime("%A")
    if _now.tzname():
        _client_vars["CURRENT_TIMEZONE"] = _now.tzname()
    extra_body = {"metadata": {"chat_id": session.get("id"),
                               "session_id": session.get("id"),
                               "variables": _client_vars}}
    request_user = session.get("id")

    answer_box: list[str] = []
    try:
        chat_streaming(client, msgs, tools, schema_obj,
                       extra_body=extra_body, request_user=request_user,
                       answer_box=answer_box)
        if _replay:
            session.setdefault("history", [])
            session["history"].append({"role": "user", "content": prompt})
            _ans = ("".join(answer_box)).strip()
            if _ans:
                session["history"].append({"role": "assistant", "content": _ans[:4000]})
            save_session(session)
        else:
            save_session(session)  # roll the id's TTL forward
        return 0
    except KeyboardInterrupt:
        sys.stderr.write("\nmios: interrupted\n")
        return 130
    except Exception as e:                    # noqa: BLE001
        sys.stderr.write(f"\nmios: {type(e).__name__}: {e}\n")
        sys.stderr.write(f"  endpoint: {ENDPOINT}\n  model: {MODEL}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
