#!/usr/bin/env bash
# AI-hint: Executes during first boot to resolve and install system-wide Flatpaks defined in mios.toml or the bake-time fallback list, ensuring the desktop environment has required applications.
# AI-related: /usr/lib/mios/userenv.sh, /etc/mios/mios.toml, /usr/share/mios/mios.toml, /usr/share/mios/flatpak-list, mios-flatpak-install.service, display-manager.service, network-online.target
# AI-functions: log, parse_ref, ensure_remote
set -uo pipefail

LOG_TAG="mios-flatpak-install"
log() { logger -t "$LOG_TAG" -- "$*"; printf '[%s] %s\n' "$LOG_TAG" "$*"; }

# [desktop].runtime_installs from the LAYERED SSOT (default true). A cloud or
# container deployment's [deployment.cloud] host drop-in sets it false: apps
# baked into the image stay, and nothing is installed at runtime.
MIOS_TOML_GET="${MIOS_TOML_GET:-/usr/libexec/mios/mios-toml-get}"
if [[ -x "$MIOS_TOML_GET" && "$("$MIOS_TOML_GET" desktop runtime_installs true 2>/dev/null)" == false ]]; then
    log "[desktop].runtime_installs is false (cloud/container deployment): no runtime flatpak install"
    exit 0
fi

if ! command -v flatpak >/dev/null 2>&1; then
    log "Flatpak not installed"
    exit 0
fi

if ! flatpak remote-list --system 2>/dev/null | grep -qw flathub; then
    log "Adding flathub remote"
    flatpak remote-add --if-not-exists --system flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo 2>&1 | while read -r ln; do log "$ln"; done || true
fi

flatpaks=""
if [[ -r /usr/lib/mios/userenv.sh ]]; then
    source /usr/lib/mios/userenv.sh 2>/dev/null || true
    flatpaks="${MIOS_DESKTOP_FLATPAKS:-}"
fi

if [[ -z "$flatpaks" && -r /usr/share/mios/flatpak-list ]]; then
    flatpaks=$(tr '\n' ',' < /usr/share/mios/flatpak-list | sed 's/,$//')
fi

if [[ -z "$flatpaks" ]]; then
    log "No flatpaks selected via mios.toml [desktop].flatpaks"
    exit 0
fi

mapfile -t WANTED < <(printf '%s\n' "$flatpaks" | tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e '/^#/d')
log "Operator-selected flatpaks: ${WANTED[*]}"

parse_ref() {
    case "$1" in
        *:*) printf '%s\n%s\n' "${1%%:*}" "${1#*:}" ;;
        *)   printf 'flathub\n%s\n' "$1" ;;
    esac
}

ensure_remote() {
    local remote="$1"
    if flatpak remote-list --system --columns=name 2>/dev/null | grep -qw "$remote"; then
        return 0
    fi
    case "$remote" in
        flathub)
            flatpak remote-add --if-not-exists --system flathub \
                https://dl.flathub.org/repo/flathub.flatpakrepo 2>&1 | while read -r ln; do log "$ln"; done || true ;;
        flathub-beta)
            flatpak remote-add --if-not-exists --system flathub-beta \
                https://flathub.org/beta-repo/flathub-beta.flatpakrepo 2>&1 | while read -r ln; do log "$ln"; done || true ;;
        gnome-nightly)
            flatpak remote-add --if-not-exists --system gnome-nightly \
                https://nightly.gnome.org/gnome-nightly.flatpakrepo 2>&1 | while read -r ln; do log "$ln"; done || true ;;
        fedora)
            flatpak remote-add --if-not-exists --system fedora \
                oci+https://registry.fedoraproject.org 2>&1 | while read -r ln; do log "$ln"; done || true ;;
        *)
            log "Unknown remote '$remote'" ;;
    esac
}

mapfile -t INSTALLED < <(flatpak list --system --app --columns=application 2>/dev/null)
declare -A have
for app in "${INSTALLED[@]}"; do have["$app"]=1; done

TODO=()
for raw in "${WANTED[@]}"; do
    pair=( $(parse_ref "$raw") )
    app="${pair[1]}"
    if [[ -n "${have[$app]:-}" ]]; then
        log "Already installed: $app"
    else
        TODO+=("$raw")
    fi
done

if (( ${#TODO[@]} == 0 )); then
    log "All selected flatpaks already installed"
    install -d -m 0755 /var/lib/mios
    printf '%s\n' "${WANTED[@]}" | sort -u > /var/lib/mios/.flatpaks-installed
    exit 0
fi

log "Installing ${#TODO[@]} flatpak"
rc=0
for raw in "${TODO[@]}"; do
    pair=( $(parse_ref "$raw") )
    remote="${pair[0]}"
    app="${pair[1]}"

    ensure_remote "$remote"

    flatpak update --system --appstream "$remote" 2>&1 | while read -r ln; do log "$ln"; done || true

    out=$(flatpak install --system --noninteractive --or-update -y "$remote" "$app" 2>&1)
    irc=$?
    printf '%s\n' "$out" | while read -r ln; do log "$ln"; done
    if [[ $irc -ne 0 && "$app" != *//* ]] && printf '%s' "$out" | grep -qiE 'multiple refs|must specify.*branch|multiple branches'; then
        branch="${MIOS_FLATPAK_DEFAULT_BRANCH:-24.08}"
        log "Ambiguous branch for $app"
        out=$(flatpak install --system --noninteractive --or-update -y "$remote" "${app}//${branch}" 2>&1)
        irc=$?
        printf '%s\n' "$out" | while read -r ln; do log "$ln"; done
    fi
    if [[ $irc -eq 0 ]]; then
        log "Installed: ${remote}:${app}"
    else
        log "FAILED: ${remote}:${app}"
        rc=1
    fi
done

install -d -m 0755 /var/lib/mios
printf '%s\n' "${WANTED[@]}" | sort -u > /var/lib/mios/.flatpaks-installed
log "Wrote sentinel: /var/lib/mios/.flatpaks-installed"

exit $rc
