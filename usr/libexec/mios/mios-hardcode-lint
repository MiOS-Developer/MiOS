#!/usr/bin/env python3
# AI-hint: Read-only enforcement gate for the NO-HARDCODE law (Law 7): fails on a date or dated attribution in comments, docstrings or .py string prose, and on AI-hint header crash-risks (a BOM not at byte 0, a header above a shebang).
# AI-related: ../../../automation/98-drift-checks.sh, ../../share/mios/mios.toml, ./mios-ai-tag, ../../../CLAUDE.md, tools/native/mios-hardcode-lint/
# AI-functions: _try_native_bin, _date_in_comment_py, _date_in_string_py, _date_in_comment_generic, _header_risk, scan, main
#
# Comments must describe the WHY abstractly, never pin code to a frozen history.
# A date inside served CSS/JS-comment text or a system-prompt string is prose the
# comment scan never sees, so .py adds a string-token scan that flags only a
# whitespace-led date and exempts one used as a VALUE (a protocol-version or
# config literal, or one glued into a URL/slug/identifier); other files use
# quote-aware comment detection. Exit 1 on violation, MIOS_HARDCODE_LINT_SOFT=1
# for advisory; pairs with the surface-parity + module-boundary gates.
"""NO-HARDCODE law enforcement: forbid date-literals in comments/docstrings + dated attributions in string-literal prose + header crash-risks."""

from __future__ import annotations

import ast
import io
import os
import re
import subprocess
import sys
import tokenize

_DATE = re.compile(r'\b20[0-9]{2}-[01][0-9]-[0-3][0-9]\b')
_BOM = b'\xef\xbb\xbf'
_EXEMPT = (
    '/var/lib/mios/', '/.git/', '/__pycache__/', '/node_modules/',
    '/usr/share/mios/knowledge/',          # generated knowledge snapshots
    '/.claude/',                           # Claude worktrees
    '/.agents/',                           # Agent worktrees
)
_UNIT_EXT = ('.service', '.socket', '.container', '.timer', '.conf')
_CODE_EXT = ('.py', '.sh', '.bash', '.toml', '.yml', '.yaml', '.ps1', '.psm1') + _UNIT_EXT


def _is_self(path: str) -> bool:
    """True when `path` is this script (or a link to it), not a native build.

    The candidate list includes /usr/libexec/mios/mios-hardcode-lint, which on a
    repo-as-root host IS this script. While it was mode 0644 the exec failed and
    the Python scan ran; made executable, the shim re-ran itself without end
    until the OOM killer stopped it (98-drift-checks check_no_hardcode).
    """
    try:
        return os.path.samefile(path, os.path.abspath(__file__))
    except OSError:
        return False


def _try_native_bin(args_list: list[str]) -> None:
    if os.environ.get("MIOS_HARDCODE_LINT_NO_NATIVE") == "1":
        return
    bin_path = os.environ.get("MIOS_HARDCODE_LINT_BIN")
    if not bin_path:
        exe = "mios-hardcode-lint.exe" if os.name == "nt" else "mios-hardcode-lint"
        root = os.environ.get("MIOS_ROOT") or os.path.abspath(
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..")
        )
        for candidate in (
            os.path.join(root, "tools", "native", "target", "release", exe),
            os.path.join(root, "tools", "native", "target", "debug", exe),
            os.path.join("/usr/libexec/mios", exe),
            os.path.join("/usr/bin", exe),
            os.path.join("/usr/local/bin", exe),
        ):
            if os.path.isfile(candidate) and not _is_self(candidate):
                bin_path = candidate
                break
    if bin_path and os.path.isfile(bin_path) and not _is_self(bin_path):
        # The child never delegates again, so no chain of shims can recurse.
        env = dict(os.environ, MIOS_HARDCODE_LINT_NO_NATIVE="1")
        try:
            res = subprocess.run([bin_path] + args_list, stdout=sys.stdout, stderr=sys.stderr, env=env)
            sys.exit(res.returncode)
        except OSError:
            pass


def _date_in_comment_py(text: str):
    """Yield (lineno, snippet) for a date inside a .py COMMENT or DOCSTRING only."""
    try:
        for t in tokenize.generate_tokens(io.StringIO(text).readline):
            if t.type == tokenize.COMMENT and _DATE.search(t.string):
                yield t.start[0], t.string.strip()[:80]
    except (tokenize.TokenError, IndentationError, SyntaxError):
        return
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return
    lines = text.split('\n')
    for node in ast.walk(tree):
        if not isinstance(node, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            continue
        body = getattr(node, 'body', None) or []
        if (body and isinstance(body[0], ast.Expr)
                and isinstance(getattr(body[0], 'value', None), ast.Constant)
                and isinstance(body[0].value.value, str)):
            c = body[0].value
            for ln in range(c.lineno, (c.end_lineno or c.lineno) + 1):
                if 1 <= ln <= len(lines) and _DATE.search(lines[ln - 1]):
                    yield ln, lines[ln - 1].strip()[:80]


def _date_in_string_py(text: str):
    """Yield (lineno, snippet) for a dated ATTRIBUTION baked into a .py STRING
    literal -- the hole that a date inside served CSS/JS-comment text or inside a
    system-prompt string slips through (the #-comment scan never sees string
    content). A date used as a VALUE is legitimate and exempt: a standalone or
    leading literal (a protocol-version id or a date config value is quote-led, so
    the char before it is the opening quote) or one glued into a URL/slug/identifier
    (preceded by a non-space joiner). The forbidden pattern is a date sitting in
    running prose -- structurally, one preceded by WHITESPACE and never the head of
    its own literal -- which is exactly how an `<attribution> <date>` credit reads.
    The discriminator is positional, not lexical (no keyword/English gate)."""
    try:
        toks = list(tokenize.generate_tokens(io.StringIO(text).readline))
    except (tokenize.TokenError, IndentationError, SyntaxError):
        return
    lines = text.split('\n')
    str_types = {tokenize.STRING}
    fmid = getattr(tokenize, 'FSTRING_MIDDLE', None)  # 3.12+ splits f-strings
    if fmid is not None:
        str_types.add(fmid)
    for t in toks:
        if t.type not in str_types:
            continue
        s = t.string
        for m in _DATE.finditer(s):
            i = m.start()
            if i == 0 or not s[i - 1].isspace():
                continue
            ln = t.start[0] + s[:i].count('\n')
            snip = lines[ln - 1].strip()[:80] if 1 <= ln <= len(lines) else m.group(0)
            yield ln, snip


def _comment_start(line: str) -> int:
    in_s = in_d = False
    for i, ch in enumerate(line):
        if ch == "'" and not in_d:
            in_s = not in_s
        elif ch == '"' and not in_s:
            in_d = not in_d
        elif not in_s and not in_d and ch == '#':
            return -1 if line[:2] == '#!' else i
    return -1


def _date_in_comment_generic(text: str):
    """Yield (lineno, snippet) for a date inside a #-comment (quote-aware)."""
    for idx, line in enumerate(text.split('\n'), 1):
        cs = _comment_start(line)
        if cs >= 0 and _DATE.search(line[cs:]):
            yield idx, line[cs:].strip()[:80]


def _header_risk(raw: bytes, path: str):
    """A header crash-risk: a STRANDED file-BOM (PS1 byte-0 rule), or a header line
    ABOVE a shebang the file actually declares. NOT flagged: a U+FEFF inside a string
    literal (legit, e.g. BOM-stripping code), or a sourced script with no shebang."""
    if path.endswith('.ps1') and not raw.startswith(_BOM) and _BOM in raw[:256]:
        return "UTF-8 BOM stranded in PS1 head (must be byte 0 -- breaks irm|iex parse)"
    if path.endswith(('.sh', '.bash')):
        head = raw.decode('utf-8', 'ignore').split('\n')[:40]
        sb = [i for i, l in enumerate(head) if l.startswith('#!')]
        if sb and sb[0] != 0:
            return "shebang not on line 1 (a header/comment is above it)"
    return None

_PORT_PATTERNS = [
    re.compile(r'localhost:(\d+)'),
    re.compile(r'127\.0\.0\.1:(\d+)'),
    re.compile(r':(\d{4,5})\b'),
]

_IP_PATTERN = re.compile(
    r'\b(?:[1-9]|\d{2}|1\d{2}|2[0-4]\d|25[0-5])\.(?:\d|[1-9]\d|1\d{2}|2[0-4]\d|25[0-5])\.(?:\d|[1-9]\d|1\d{2}|2[0-4]\d|25[0-5])\.(?:\d|[1-9]\d|1\d{2}|2[0-4]\d|25[0-5])\b'
)

def _is_routable_ip(ip_str: str) -> bool:
    if ip_str in ("127.0.0.1", "0.0.0.0"):
        return False
    parts = ip_str.split('.')
    if len(parts) != 4:
        return False
    try:
        p1, p2, p3, p4 = [int(p) for p in parts]
    except ValueError:
        return False
    if p1 == 10:
        return False
    if p1 == 172 and (16 <= p2 <= 31):
        return False
    if p1 == 192 and p2 == 168:
        return False
    if p1 == 100 and (64 <= p2 <= 127):
        return False
    return True

def _anchor_pattern(pat: str) -> str:
    prefix = r'(?<!\d)' if not pat.startswith('^') and not pat.startswith(r'\b') and not pat.startswith(r'(?<!') else ''
    suffix = r'(?!\d)' if not pat.endswith('$') and not pat.endswith(r'\b') and not pat.endswith(r'(?!\d)') and not pat.endswith(r'(?![0-9])') else ''
    return prefix + pat + suffix

_UNIT_DIRECTIVE_PREFIXES = (
    'listenstream=', 'listendatagram=',
    'execstart=', 'execstartpre=', 'execstartpost=', 'execstop=',
    'exec=',
    'environment=',
)

def _is_unit_directive_line(line: str, in_multiline: bool) -> tuple[bool, bool]:
    stripped = line.strip()
    if stripped.startswith('#') or stripped.startswith(';') or stripped.startswith('//'):
        return False, in_multiline
    lower = stripped.lower()
    is_directive_start = any(lower.startswith(p) for p in _UNIT_DIRECTIVE_PREFIXES)
    has_bind = '--bind' in stripped
    is_directive = is_directive_start or in_multiline or has_bind
    next_multiline = is_directive and stripped.endswith('\\')
    return is_directive, next_multiline

def _check_ports_ips_py(text: str, filename: str, exempt_patterns: list[str]) -> list[tuple[int, str]]:
    violations = []
    exempt_rx = [re.compile(_anchor_pattern(pat)) for pat in exempt_patterns]
    try:
        toks = list(tokenize.generate_tokens(io.StringIO(text).readline))
    except (tokenize.TokenError, IndentationError, SyntaxError):
        return []
    
    lines = text.split('\n')
    for t in toks:
        if t.type == tokenize.COMMENT:
            continue
        if t.type == tokenize.STRING and t.string.startswith(('"""', "'''", 'r"""', "r'''", 'u"""', "u'''")):
            continue
            
        s = t.string
        ln = t.start[0]
        line = lines[ln - 1] if 1 <= ln <= len(lines) else ""
        
        is_line_exempt = False
        for rx in exempt_rx:
            if rx.search(line):
                is_line_exempt = True
                break
        if is_line_exempt:
            continue
            
        for pat in _PORT_PATTERNS:
            for m in pat.finditer(s):
                port_num_str = m.group(1)
                try:
                    port_num = int(port_num_str)
                except ValueError:
                    continue
                if not (1 <= port_num <= 65535):
                    continue
                
                start = m.start()
                end = m.end()
                if end < len(s) and s[end] == ']':
                    continue
                if start > 0 and s[start - 1] in ('[', '-', '+', ':', '/'):
                    continue
                
                violations.append((ln, m.group(0)))
                
        for m in _IP_PATTERN.finditer(s):
            ip_str = m.group(0)
            if _is_routable_ip(ip_str):
                violations.append((ln, ip_str))
                
    return violations

def _check_ports_ips(text: str, filename: str, exempt_patterns: list[str]) -> list[tuple[int, str]]:
    violations = []
    lines = text.split('\n')
    exempt_rx = [re.compile(_anchor_pattern(pat)) for pat in exempt_patterns]
    is_unit = filename.endswith(_UNIT_EXT)
    in_multiline = False

    for idx, line in enumerate(lines, 1):
        stripped = line.strip()
        if stripped.startswith('#') or stripped.startswith('//') or stripped.startswith(';'):
            continue
        
        if is_unit:
            is_directive, in_multiline = _is_unit_directive_line(line, in_multiline)
            if not is_directive:
                continue

        is_line_exempt = False
        for rx in exempt_rx:
            if rx.search(line):
                is_line_exempt = True
                break
        if is_line_exempt:
            continue
            
        code_part = line
        in_s = in_d = False
        for i, ch in enumerate(line):
            if ch == "'" and not in_d:
                in_s = not in_s
            elif ch == '"' and not in_s:
                in_d = not in_d
            elif not in_s and not in_d and ch == '#':
                code_part = line[:i]
                break
                
        for pat in _PORT_PATTERNS:
            for m in pat.finditer(code_part):
                port_num_str = m.group(1)
                try:
                    port_num = int(port_num_str)
                except ValueError:
                    continue
                if not (1 <= port_num <= 65535):
                    continue
                    
                start = m.start()
                end = m.end()
                if end < len(code_part) and code_part[end] == ']':
                    continue
                if start > 0 and code_part[start - 1] in ('-', '+', ':', '['):
                    continue
                violations.append((idx, m.group(0)))
                
        for m in _IP_PATTERN.finditer(code_part):
            ip_str = m.group(0)
            if _is_routable_ip(ip_str):
                violations.append((idx, ip_str))
                
    return violations

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios"))
import mios_toml  # noqa: E402  -- the ONE shared layered-mios.toml resolver


def _load_allowlist(roots):
    exempt_files = []
    exempt_patterns = []
    for r in roots:
        toml_path = os.path.join(r, "usr/share/mios/mios.toml")
        if os.path.isfile(toml_path):
            data = mios_toml.load_merged(layers=[toml_path])
            sec = mios_toml.section(data, "security.nohc_allowlist")
            exempt_files.extend(sec.get("exempt_files", []))
            exempt_patterns.extend(sec.get("exempt_patterns", []))
            break
    return exempt_files, exempt_patterns

def scan(roots):
    violations = []
    scanned = 0
    exempt_files, exempt_patterns = _load_allowlist(roots)
    exempt_files_rx = [re.compile(pat) for pat in exempt_files]
    for root in roots:
        if os.path.isfile(root):
            items = [(os.path.dirname(root), os.path.basename(root), root)]
        else:
            items = []
            for dirpath, dirs, files in os.walk(root):
                dirs[:] = [d for d in dirs if d not in ('.git', '__pycache__', 'node_modules')]
                for fn in files:
                    items.append((dirpath, fn, os.path.join(dirpath, fn)))
        for dirpath, fn, p in items:
            rel = p.replace('\\', '/')
            if any(x in rel for x in _EXEMPT) or not fn.endswith(_CODE_EXT):
                continue
            try:
                raw = open(p, 'rb').read()
            except OSError:
                continue
            if not raw:
                continue
            scanned += 1
            hr = _header_risk(raw, fn)
            if hr:
                violations.append((p, 0, f"HEADER: {hr}"))
            text = raw.decode('utf-8-sig' if raw[:3] == _BOM else 'utf-8', 'ignore').replace('\r\n', '\n')
            
            is_file_exempt = False
            for rx in exempt_files_rx:
                if rx.search(rel):
                    is_file_exempt = True
                    break
            
            if fn.endswith(('.py', '.sh', '.bash', '.ps1', '.psm1') + _UNIT_EXT) and not is_file_exempt:
                if fn.endswith('.py'):
                    for ln, snip in _check_ports_ips_py(text, fn, exempt_patterns):
                        violations.append((p, ln, f"HARDCODED-PORT/IP: {snip}"))
                else:
                    for ln, snip in _check_ports_ips(text, fn, exempt_patterns):
                        violations.append((p, ln, f"HARDCODED-PORT/IP: {snip}"))
                    
            if 'usr/share/mios/ventoy/autorun' in rel:
                for idx, line in enumerate(text.split('\n'), 1):
                    if 'chpasswd' in line and re.search(r'echo\s+["\'][a-zA-Z0-9_-]+:[a-zA-Z0-9_-]+["\']\s*\|\s*chpasswd', line):
                        violations.append((p, idx, f"PLAINTEXT-CHPASSWD: {line.strip()[:80]}"))
                    
            # A GENERATED file is exempt from the timeless-comment rule: its
            # comments are PROJECTED from mios.toml `comment = "..."` values,
            # where a date is a value and legitimately exempt (the lint is
            # value-aware). It only becomes a #-comment once rendered, and a
            # "DO NOT EDIT" file cannot be hand-corrected -- the fix belongs
            # in mios.toml. Keyed off the file's own generated marker rather
            # than an allowlist, so it can never drift out of date.
            # Both tokens, and only in the file's own top banner -- a
            # GENERATOR mentions "DO NOT EDIT" in the header it EMITS, and
            # generators are authored files that must stay linted.
            _banner = '\n'.join(text.splitlines()[:4])
            is_generated = 'GENERATED' in _banner and 'DO NOT EDIT' in _banner
            if not is_generated:
                if fn.endswith('.py'):
                    for ln, snip in _date_in_comment_py(text):
                        violations.append((p, ln, f"DATE-IN-COMMENT: {snip}"))
                    for ln, snip in _date_in_string_py(text):
                        violations.append((p, ln, f"DATE-IN-STRING: {snip}"))
                elif not fn.endswith(_UNIT_EXT):
                    for ln, snip in _date_in_comment_generic(text):
                        violations.append((p, ln, f"DATE-IN-COMMENT: {snip}"))
    return violations, scanned


def main(argv):
    _try_native_bin(argv[1:])
    roots = [a for a in argv[1:] if not a.startswith('--')] or ['.']
    soft = os.environ.get('MIOS_HARDCODE_LINT_SOFT', '0') == '1'
    missing = [r for r in roots if not os.path.exists(r)]
    if missing:
        sys.stderr.write('[mios-hardcode-lint] FAIL: root(s) do not exist: %s\n'
                         % ', '.join(missing))
        return 1
    v, scanned = scan(roots)
    # An empty scan used to print PASS. The gate passes $ROOT in, so a wrong
    # or empty root linted nothing and still reported clean.
    if scanned == 0:
        sys.stderr.write('[mios-hardcode-lint] FAIL: scanned 0 files under %s -- '
                         'nothing was linted, so this is not a pass\n' % ', '.join(roots))
        return 1
    if not v:
        print('[mios-hardcode-lint] PASS: %d file(s) scanned; no date-in-comment/string '
              '/ header crash-risk / port-IP hardcode.' % scanned)
        return 0
    for p, ln, msg in v[:60]:
        sys.stderr.write(f"    {p}:{ln}: {msg}\n")
    if len(v) > 60:
        sys.stderr.write(f"    ... and {len(v) - 60} more\n")
    sys.stderr.write(f"[mios-hardcode-lint] FAIL: {len(v)} NO-HARDCODE violation(s) "
                     "(strip dates/ports/IPs -> timeless comment/string / env vars; move a header below the shebang/BOM).\n")
    if soft:
        sys.stderr.write("[mios-hardcode-lint] (MIOS_HARDCODE_LINT_SOFT=1 -> advisory, exit 0)\n")
        return 0
    return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
