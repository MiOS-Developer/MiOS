#!/bin/bash
# AI-hint: Copies a system-shipped MiOS shim from /usr/libexec/mios/ to /usr/local/bin/ to create a mutable version that overrides the default on PATH, allowing agents to iteratively modify and improve existing tools.
# AI-related: /usr/libexec/mios/mios-tool-clone, mios-windows, mios-windows-experimental
# AI-functions: usage
set -euo pipefail

set -eu

usage() {
    cat <<'USAGE'
usage: mios-tool-clone <name> [--as <new-name>] [--force]

  <name>          System tool name to clone (under /usr/libexec/mios/<name>).

  --as <new-name> Land the clone at /usr/local/bin/<new-name> instead of
                  <name>. Default: same name (overrides the vendor shim
                  on PATH).

  --force         Overwrite an existing local clone.

Available system tools:
USAGE
    if [ -d /usr/libexec/mios ]; then
        local tool
        for tool in /usr/libexec/mios/mios-*; do
            [ -e "$tool" ] || [ -L "$tool" ] || continue
            printf '  %s\n' "${tool##*/}"
        done
    fi
}

if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    [ "$#" -lt 1 ] && exit 64 || exit 0
fi

NAME="$1"
shift
NEW_NAME="$NAME"
FORCE=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --as) NEW_NAME="$2"; shift 2 ;;
        --force) FORCE=1; shift ;;
        *) echo "Mios-tool-clone: unknown arg: $1" >&2; exit 64 ;;
    esac
done

SRC="/usr/libexec/mios/$NAME"
if [ ! -x "$SRC" ]; then
    echo "Mios-tool-clone: no executable system tool at $SRC" >&2
    echo >&2
    usage >&2
    exit 1
fi

DEST="/usr/local/bin/${NEW_NAME}"

if [ -e "$DEST" ] && [ "$FORCE" != "1" ]; then
    echo "Mios-tool-clone: $DEST already exists" >&2
    exit 1
fi

SUDO=()
if [ "$(id -u)" -ne 0 ]; then
    SUDO=(sudo -n)
fi
"${SUDO[@]}" install -m 0755 "$SRC" "$DEST"

TMP="$(mktemp)"
SHEBANG="$(head -1 "$DEST")"
{
    echo "$SHEBANG"
    echo "# mios-tool-clone: forked from $SRC at $. Edit freely; /usr/local/bin precedes /usr/libexec/mios on PATH"
    tail -n +2 "$DEST"
} > "$TMP"
"${SUDO[@]}" install -m 0755 "$TMP" "$DEST"
rm -f "$TMP"

echo "[mios-tool-clone] forked $SRC -> $DEST"
if [ "$NEW_NAME" = "$NAME" ]; then
    echo "[mios-tool-clone] same-name clone: $DEST takes PATH precedence over $SRC"
else
    echo "[mios-tool-clone] renamed clone: original '$NAME' still active; new '$NEW_NAME' ships alongside"
fi
echo "[mios-tool-clone] edit: $DEST"
