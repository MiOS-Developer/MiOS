#!/usr/bin/env python3
# AI-hint: FBM first-boot bound-image provisioner. Reads [ai].firstboot_bound_images from mios.toml
# AI-related: mios-bound-images-firstboot.service, /usr/share/mios/mios.toml
import sys
import os
import subprocess
import pathlib
try:
    import tomllib
except ImportError:
    try:
        import tomli as tomllib
    except ImportError:
        print("ERROR: tomllib or tomli not found")
        sys.exit(1)

SENTINEL = pathlib.Path("/var/lib/mios/.bound-images-firstboot-done")

if SENTINEL.exists():
    print(f"Sentinel {SENTINEL} exists. Bound images provisioner already completed.")
    sys.exit(0)

if os.name == 'nt':
    SENTINEL = pathlib.Path("C:/var/lib/mios/.bound-images-firstboot-done")


# [ai].firstboot_pulls from the LAYERED SSOT (default true): a cloud or container
# deployment's [deployment.cloud] host drop-in sets it false. No sentinel is written,
# so removing the drop-in resumes the pulls on the next boot.
_TOML_GET = os.environ.get("MIOS_TOML_GET", "/usr/libexec/mios/mios-toml-get")
if os.access(_TOML_GET, os.X_OK) and subprocess.run(
        [_TOML_GET, "ai", "firstboot_pulls", "true"], capture_output=True, text=True).stdout.strip() == "false":
    print("[ai].firstboot_pulls is false (cloud/container deployment): no bound image is pulled")
    sys.exit(0)

TOML_PATH = os.environ.get("MIOS_TOML", "C:/MiOS/usr/share/mios/mios.toml" if os.name == 'nt' else "/usr/share/mios/mios.toml")

try:
    with open(TOML_PATH, "rb") as f:
        cfg = tomllib.load(f)
except Exception as e:
    print(f"Failed to load {TOML_PATH}: {e}")
    sys.exit(0)

ai_cfg = cfg.get("ai", {})
images = ai_cfg.get("firstboot_bound_images", [])

if not images:
    print("No firstboot_bound_images found in config.")
else:
    print(f"Found {len(images)} bound images.")
    for img in images:
        name = img.get("image")
        if not name:
            continue
            
        print(f"Pulling {name}...")
        cmd = ["podman", "pull", name]
        
        try:
            res = subprocess.run(cmd)
            if res.returncode == 0:
                print(f"Successfully pulled {name}")
            else:
                print(f"WARN: Failed to pull {name} (exit {res.returncode})")
        except FileNotFoundError:
            print(f"WARN: podman not found, skipping pull of {name}")
            
SENTINEL.parent.mkdir(parents=True, exist_ok=True)
SENTINEL.touch()
print("First-boot bound images provisioning complete (sentinel written).")
sys.exit(0)
