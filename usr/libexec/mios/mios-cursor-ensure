#!/bin/bash
# AI-hint: Ensures the global system cursor theme (Bibata) is correctly installed and linked in /usr/share/icons or ~/.local/share/icons based on available privileges to guarantee consistent cursor rendering across X11, Wayland, and Flatpak apps.
# AI-related: /usr/libexec/mios/mios-cursor-ensure, /etc/mios/mios.toml, /usr/share/mios/mios.toml
# AI-functions: _toml_get, _write_default_pointer, _wire

set -uo pipefail

_toml_get() {
    python3 - "$1" <<'PYEOF'
import sys
sys.path.insert(0, "/usr/lib/mios")
import mios_toml
node = mios_toml.load_merged()
dotted = sys.argv[1]
for k in dotted.split("."):
    node = node[k]
print(node)
PYEOF
}

THEME="$(_toml_get theme.cursor_linux.theme)" || exit 1
SIZE="$(_toml_get theme.cursor_linux.size)" || exit 1
REPO="$(_toml_get theme.cursor_linux.source_repo)" || exit 1
MARKER_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/mios"

if [ "$(id -u)" = "0" ] && { [ -w /usr/share/icons ] || [ ! -e /usr/share/icons ]; }; then
    MODE=global
    DEST=/usr/share/icons
else
    MODE=user
    DEST="$HOME/.local/share/icons"
fi

_write_default_pointer() {   # $1 = dir that contains <theme>
    local dir="$1"
    mkdir -p "$dir/default" 2>/dev/null || return 0
    cat > "$dir/default/index.theme" <<EOF
[Icon Theme]
Name=Default
Comment=MiOS default cursor
Inherits=$THEME
EOF
}

_wire() {   # $1 = dir that contains <theme>/cursors
    local src="$1"
    _write_default_pointer "$src"
    if [ "$MODE" = global ]; then
        chmod -R a+rX "$src/$THEME" "$src/default" 2>/dev/null || true
    else
        mkdir -p "$HOME/.icons" 2>/dev/null || true
        [ -e "$HOME/.icons/$THEME" ] || ln -s "$src/$THEME" "$HOME/.icons/$THEME" 2>/dev/null || true
        _write_default_pointer "$HOME/.icons"
        if command -v gsettings >/dev/null 2>&1; then
            gsettings set org.gnome.desktop.interface cursor-theme "$THEME" 2>/dev/null || true
            gsettings set org.gnome.desktop.interface cursor-size "$SIZE" 2>/dev/null || true
        fi
    fi
}

if [ "$MODE" = global ]; then
    _search=("/usr/share/icons")
else
    _search=("$DEST" "$HOME/.icons")
fi
for base in "${_search[@]}"; do
    if [ -d "$base/$THEME/cursors" ]; then
        _wire "$base"
        mkdir -p "$MARKER_DIR" 2>/dev/null && : > "$MARKER_DIR/cursor-ensured" 2>/dev/null || true
        echo "Mios-cursor-ensure: [$MODE] '$THEME' present; default-cursor pointer wired"
        exit 0
    fi
done

# Flatpak cannot see /usr/share/icons from the host. Materialize the baked
# theme in the user icon directory instead of downloading it or linking to
# a host-only path. The global override exposes xdg-data/icons read-only.
if [ "$MODE" = user ] && [ -d "/usr/share/icons/$THEME/cursors" ]; then
    mkdir -p "$DEST"
    cp -a "/usr/share/icons/$THEME" "$DEST/"
    _wire "$DEST"
    echo "Mios-cursor-ensure: [user] hydrated '$THEME' from the baked image"
    exit 0
fi

command -v curl >/dev/null 2>&1 || { echo "Mios-cursor-ensure: curl missing" >&2; exit 1; }

VER=$(curl -sL --connect-timeout 15 --max-time 30 \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null \
      | grep -m1 '"tag_name"' | sed 's/.*"v\?\([^"]*\)".*/\1/')
if [ -z "$VER" ]; then
    echo "Mios-cursor-ensure: could not resolve latest release for $REPO" >&2
    exit 1
fi

ARCHIVE="${THEME}.tar.xz"
URL="https://github.com/$REPO/releases/download/v${VER}/${ARCHIVE}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "Mios-cursor-ensure: [$MODE] fetching $THEME v$VER -> $DEST"
if ! curl -fSL --connect-timeout 20 --max-time 120 --retry 2 --retry-delay 5 "$URL" -o "$TMP/$ARCHIVE"; then
    echo "Mios-cursor-ensure: download failed" >&2
    exit 1
fi

mkdir -p "$DEST"
if ! tar -xf "$TMP/$ARCHIVE" -C "$DEST"; then
    echo "Mios-cursor-ensure: extract failed" >&2
    exit 1
fi
if [ ! -d "$DEST/$THEME/cursors" ]; then
    echo "Mios-cursor-ensure: extracted but '$DEST/$THEME/cursors' missing" >&2
    exit 1
fi

chmod -R a+rX "$DEST/$THEME" 2>/dev/null || true
_wire "$DEST"
mkdir -p "$MARKER_DIR" 2>/dev/null && : > "$MARKER_DIR/cursor-ensured" 2>/dev/null || true
echo "Mios-cursor-ensure: [$MODE] installed $THEME ($(find "$DEST/$THEME/cursors" -mindepth 1 -maxdepth 1 | wc -l) cursors) into $DEST + wired default-cursor pointer"
exit 0
