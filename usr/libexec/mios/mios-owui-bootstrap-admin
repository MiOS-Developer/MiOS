#!/usr/bin/env python3
# AI-hint: Bootstraps the first Open WebUI admin in its SQLite database, resolving the ONE SSOT login (the mios.html value) through mios_credentials.surface_password, so first boot never locks it out.
# AI-related: /etc/mios/secrets.env, /etc/mios/owui-admin-password, /etc/mios/mios.toml, /usr/share/mios/mios.toml, /usr/lib/mios/mios_credentials.py, mios-hermes-firstboot, mios-credential-apply, mios-open-webui, port key `open_webui`
"""mios-owui-bootstrap-admin -- create the first OWUI admin user when
the `user` table is empty, so a fresh install / reinstall doesn't
lock the operator out of Open WebUI.

Resolves identity from the operator view (mios_credentials.operator_load: [identity].username
and [identity].email are vendor/host -- root never takes them from the operator's tier) and
the password through mios_credentials.surface_password
("owui"): MIOS_OPERATOR_PASSWORD -> MIOS_OWUI_ADMIN_PASSWORD (env/secrets.env)
-> [identity].default_password -- the SAME chain Forge / Portal / code-server
use, so one operator password works everywhere. There is no literal
fallback: with no SSOT credential the admin is left as-is (exit 2). A
"__random__" override generates + writes a 24-char password to
/etc/mios/owui-admin-password (mode 0600 root-only).

Idempotent: skips if any user row exists. Logs to stderr so
mios-hermes-firstboot can capture the output via _log.

Why direct sqlite + bcrypt instead of POST /api/v1/auths/signup:
  * doesn't depend on OWUI being up + responsive at firstboot time
  * doesn't need ENABLE_SIGNUP=True dance (toggle env, restart, post,
    toggle back, restart) which is fragile and slow
  * uses the same bcrypt scheme OWUI does (passlib bcrypt $2b$)

`--verify` (mios-credential apply --verify, the reconciler's timer) writes nothing while a
user row matches [identity].email; when none does it runs as above, so a recreated database
gets its admin back instead of leaving the first-signup seat open.

Exit 0 when the admin was created or reconciled (or, with --verify, is present); 2 when no SSOT credential resolves;
4 when users exist but none matches [identity].email (left as it is); 5 when the
database or its schema is not ready. mios-credential apply records the credential as
applied only on 0, and mios-hermes-firstboot ignores the code, so firstboot never blocks.
"""
import json
import os
import secrets
import sqlite3
import string
import sys
import time
import uuid
from pathlib import Path

DB = Path(os.environ.get("MIOS_OWUI_DB", "/var/lib/mios/open-webui/webui.db"))
PASSWORD_OUT = Path(os.environ.get("MIOS_OWUI_PASSWORD_FILE", "/etc/mios/owui-admin-password"))


def _log(msg: str) -> None:
    print(f"[mios-owui-bootstrap-admin] {msg}", file=sys.stderr)


sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios"))
import mios_toml  # noqa: E402  -- the ONE shared layered-mios.toml resolver
import mios_credentials as mc  # noqa: E402  -- the ONE operator-credential chain
try:
    from mios_db_config import safe_ident
except ImportError:
    import re
    _IDENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
    def safe_ident(ident: str, allowlist) -> str:
        if not isinstance(ident, str) or not _IDENT_RE.match(ident):
            raise ValueError(f"Invalid SQL identifier format: {ident!r}")
        if ident not in allowlist:
            raise ValueError(f"SQL identifier {ident!r} not in schema allowlist")
        return ident


# Exit codes mios-credential apply reads (owui surface): 0 reconciled/created, 2 no SSOT
# credential, 4 users exist but none matches [identity].email (left as it is), 5 the
# database or its schema is not ready yet (re-run later).
EXIT_NO_MATCH = 4
EXIT_NOT_READY = 5


def _read_mios_toml_identity():
    """Return (username, email) from layered mios.toml; defaults if missing.
    Resolved through the shared real-TOML overlay (per-user > host > vendor,
    per-key) -- replaces the former hand-rolled line scanner."""
    data = mc.operator_load()[0]
    ident = mios_toml.section(data, "identity")
    name = str(ident.get("username") or "mios")
    email = str(ident.get("email") or "admin@mios.local")
    return name, email


def _resolved() -> dict:
    """surface_password('owui') over the operator's tier: {value, tier, shadowed}.
    Raises mios_credentials.CredentialError when no SSOT layer carries one."""
    data = mc.operator_load()[0]
    return mc.surface_password("owui", data)


def _password_tier():
    """(tier label, generated): "__random__" opts INTO a 24-char password (0600
    receipt); none is generated silently. Only the label is ever logged."""
    got = _resolved()
    return got["tier"], got["value"] == mc.RANDOM_OPT_IN


def _tier_source(label, generated) -> str:
    return f"generated ({label}=__random__)" if generated else str(label)


def _read_password(_label, generated) -> str:
    if generated:
        alphabet = string.ascii_letters + string.digits + "_-"
        return "".join(secrets.choice(alphabet) for _ in range(24))
    return _resolved()["value"]


def _write_credentials_receipt(name: str, email: str, source: str,
                               generated_password=None) -> None:
    """Record who the admin is and where its password comes from.

    The password itself is written only when MiOS generated it (__random__):
    that is the one case the operator cannot know it otherwise. A password
    the operator set in the SSOT is never copied into a second file.
    """
    PASSWORD_OUT.parent.mkdir(parents=True, exist_ok=True)
    secret_line = (f"  password: {generated_password}\n" if generated_password
                   else f"  password: (not stored; set by {source})\n")
    body = (
        "# MiOS Open WebUI admin credentials\n"
        f"# Auto-created by mios-owui-bootstrap-admin at {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\n"
        f"# Source: {source}\n"
        "#\n"
        "# Use these to log in at http://localhost:8200/. This password is\n"
        "# reconciled from the MiOS SSOT ([identity].default_password, or\n"
        "# MIOS_OPERATOR_PASSWORD / MIOS_OWUI_ADMIN_PASSWORD) on every first-\n"
        "# boot run -- to change it, set the SSOT field, NOT the OWUI profile\n"
        "# UI (a reboot would otherwise revert that change).\n"
        "#\n"
        f"  username: {name}\n"
        f"  email:    {email}\n"
        + secret_line
    )
    # Created 0600 and never followed through a link: write-then-chmod left
    # the receipt world-readable for the length of the write.
    fd = os.open(PASSWORD_OUT, os.O_WRONLY | os.O_CREAT | os.O_TRUNC
                 | getattr(os, "O_NOFOLLOW", 0), 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(body)
    PASSWORD_OUT.chmod(0o600)


def _bcrypt_hash(password: str) -> str:
    """OWUI uses passlib bcrypt $2b$ -- match it exactly so our row is valid."""
    try:
        import bcrypt  # noqa
    except ImportError:
        return _bcrypt_hash_via_container(password)
    salt = bcrypt.gensalt(rounds=12)
    return bcrypt.hashpw(password.encode("utf-8"), salt).decode("utf-8")


def _bcrypt_hash_via_container(password: str) -> str:
    """Fallback: call OWUI's python with bcrypt to hash."""
    import subprocess
    code = (
        "import bcrypt, sys; "
        "p = sys.stdin.read().rstrip('\\n').encode(); "
        "print(bcrypt.hashpw(p, bcrypt.gensalt(rounds=12)).decode())"
    )
    try:
        out = subprocess.run(
            ["podman", "exec", "-i", "mios-open-webui", "python3", "-c", code],
            input=password, capture_output=True, text=True, timeout=30, check=True
        )
        return out.stdout.strip()
    except (subprocess.SubprocessError, FileNotFoundError):
        _log("FATAL: bcrypt unavailable on host AND fallback container exec failed")
        raise SystemExit(2)


def _export_admin_api_key(conn, uid: str) -> None:
    """Export the admin's OWUI api_key to /etc/mios/owui-admin.key (0640
    root:mios-ai) so the agent-pipe / mios-ai broker -- which CANNOT read
    webui.db (0640 mios-open-webui) -- can authenticate to OWUI's retrieval
    API for knowledge_search instead of silently degrading to the pgvector
    fallback. The key is minted by mios-owui-install-pipe (or OWUI); this only
    EXPORTS it. Best-effort, idempotent, never raises (we already run as root
    here so the chown succeeds on a real host)."""
    try:
        cols = {r[1] for r in conn.execute("PRAGMA table_info(api_key)")}
        if "key" not in cols:
            return
        row = conn.execute(
            "SELECT key FROM api_key WHERE user_id = ? ORDER BY created_at DESC LIMIT 1;",
            (uid,),
        ).fetchone()
        key = (row[0] if row else "") or ""
        if not key:
            _log("no OWUI admin api_key minted yet -- skipping export "
                 "(install-pipe mints it; a later boot will export)")
            return
        out = Path(os.environ.get("MIOS_OWUI_API_KEY_FILE", "/etc/mios/owui-admin.key"))
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(key + "\n", encoding="utf-8")
        out.chmod(0o640)
        try:
            import grp
            os.chown(str(out), 0, grp.getgrnam("mios-ai").gr_gid)
        except (KeyError, PermissionError, OSError):
            pass  # group may not exist / not root -- file is still 0640
        _log(f"exported OWUI admin api_key -> {out} (mode 0640, root:mios-ai)")
    except Exception:  # noqa: BLE001 -- never block firstboot
        _log("api_key export skipped: database or credential file unavailable")


def main():
    if not DB.exists():
        _log(f"OWUI db {DB} not present yet -- skipping (re-run after first OWUI start)")
        return EXIT_NOT_READY

    conn = sqlite3.connect(str(DB))
    try:
        try:
            user_cols = {row[1] for row in conn.execute("PRAGMA table_info(user)")}
        except sqlite3.OperationalError:
            _log("OWUI db schema not ready -- skipping")
            return EXIT_NOT_READY
        if "id" not in user_cols:
            _log("OWUI user table not ready (no columns) -- skipping")
            return EXIT_NOT_READY

        name, email = _read_mios_toml_identity()
        if "--verify" in sys.argv[1:] and conn.execute(
                "SELECT 1 FROM user WHERE email = ? LIMIT 1", (email,)).fetchone():
            _log("--verify: the OWUI admin is present -- nothing written")
            return 0
        try:
            tier, generated = _password_tier()
        except mc.CredentialError:
            _log("no SSOT credential for the OWUI admin -- leaving it as-is "
                 "(set [identity].default_password in mios.html)")
            return 2
        source = _tier_source(tier, generated)
        password = _read_password(tier, generated)
        receipt_password = password if generated else None
        now = int(time.time())
        password_hash = _bcrypt_hash(password)

        row = conn.execute("SELECT id FROM user WHERE email = ? LIMIT 1", (email,)).fetchone()
        if row:
            uid = row[0]
            arow = conn.execute("SELECT id FROM auth WHERE id = ?", (uid,)).fetchone()
            if arow:
                conn.execute(
                    "UPDATE auth SET email = ?, password = ?, active = 1 WHERE id = ?",
                    (email, password_hash, uid),
                )
            else:
                conn.execute(
                    "INSERT INTO auth (id, email, password, active) VALUES (?,?,?,?)",
                    (uid, email, password_hash, 1),
                )
            if "role" in user_cols:
                conn.execute("UPDATE user SET role = 'admin', updated_at = ? WHERE id = ?", (now, uid))
            conn.commit()
            _write_credentials_receipt(name, email, source, receipt_password)
            _export_admin_api_key(conn, uid)
            _log("reconciled OWUI admin credentials to SSOT")
            return 0

        existing = conn.execute("SELECT COUNT(*) FROM user").fetchone()[0]
        if existing > 0:
            _log(f"OWUI has {existing} user(s), none matching the configured admin -- leaving as-is")
            return EXIT_NO_MATCH

        uid = str(uuid.uuid4())
        _log("creating first OWUI admin from configured identity and credentials")
        candidate = {
            "id": uid,
            "name": name,
            "username": name,
            "email": email,
            "role": "admin",
            "profile_image_url": "/static/favicon.png",
            "last_active_at": now,
            "updated_at": now,
            "created_at": now,
            "settings": json.dumps({}),
            "info": None,
            "api_key": None,    # legacy (<= 0.x) schemas only
            "oauth_sub": None,  # legacy column name
            "oauth": None,      # current column name
        }
        use = {k: v for k, v in candidate.items() if k in user_cols}
        user_col_allowlist = frozenset(candidate.keys())
        safe_cols = [safe_ident(k, user_col_allowlist) for k in use]
        safe_cols_sql = ", ".join(safe_cols)
        ph_sql = ", ".join("?" for _ in safe_cols)
        conn.execute(f"INSERT INTO user ({safe_cols_sql}) VALUES ({ph_sql})", tuple(use.values()))
        conn.execute(
            "INSERT INTO auth (id, email, password, active) VALUES (?,?,?,?)",
            (uid, email, password_hash, 1),
        )
        conn.commit()
        _log("admin user created (role=admin)")
        _write_credentials_receipt(name, email, source, receipt_password)
        _export_admin_api_key(conn, uid)
        _log("credentials written to the configured private receipt (mode 0600)")
        return 0
    finally:
        conn.close()


if __name__ == "__main__":
    sys.exit(main())
