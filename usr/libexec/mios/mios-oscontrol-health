#!/usr/bin/env bash
# AI-hint: Probes the SSOT Windows OS-control executor and the WSL shell interop plane.
# AI-related: mios-pc-control, mios-os-recipe, mios-oscontrol-server, mios-powershell
# AI-functions: (probe-only)
set -uo pipefail

_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../lib/mios" && pwd)"
exec_status="down"; exec_url=""
if exec_url="$(python3 "$_lib/mios_oscontrol_client.py" endpoint 2>/dev/null)"; then
  python3 "$_lib/mios_oscontrol_client.py" health >/dev/null 2>&1 && exec_status="up"
fi

interop="down"
_pwsh="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
[ -x "$_pwsh" ] || _pwsh="$(command -v powershell.exe 2>/dev/null)"
if [ -n "$_pwsh" ]; then
  timeout 8 "$_pwsh" -NoProfile -NonInteractive -Command "exit 0" >/dev/null 2>&1 && interop="up"
fi

blind="false"; reason="ok"
if [ "$exec_status" = "down" ] && [ "$interop" = "down" ]; then
  blind="true"
  reason="Windows control plane OFFLINE: start the in-session OS-control executor on the host (log into the desktop session)."
elif [ "$exec_status" = "down" ]; then
  reason="In-session executor (${exec_url:-invalid SSOT endpoint}) offline; WSL-interop powershell.exe fallback is available for shell-class Windows actions only (no GUI/window control)."
fi

_r="${reason//\\/\\\\}"; _r="${_r//\"/\\\"}"
printf '{"executor":"%s","executor_endpoint":"%s","interop":"%s","blind":%s,"reason":"%s"}\n' \
  "$exec_status" "$exec_url" "$interop" "$blind" "$_r"
