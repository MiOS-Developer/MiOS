def execute_console_stream(
    target: str,
    backend: str = "pikvm",
    token: Optional[str] = None,
    port: Optional[int] = None,
    scheme: Optional[str] = None,
    dry_run: bool = False,
    mock: bool = False,
    allow_unauthenticated: bool = False,
    timeout: int = 10,
) -> Dict[str, Any]:
    """Inspects/retrieves VNC/WebRTC/serial console URL for target node."""
    if backend not in SUPPORTED_BACKENDS:
        raise ValueError(f"Invalid backend '{backend}'. Must be one of: {', '.join(SUPPORTED_BACKENDS)}")

    host, target_port = validate_target_ip(target)
    parsed_scheme = parse_target(target)[2]
    effective_port = port if port is not None else target_port
    effective_scheme = scheme or parsed_scheme
    auth_token = check_authentication(token, dry_run=dry_run, allow_unauthenticated=allow_unauthenticated)

    final_scheme, final_port = _determine_scheme_and_port(
        host, effective_port, default_port=443, scheme_override=effective_scheme
    )

    if backend == "pikvm":
        console_info = {
            "console_url": f"{final_scheme}://{host}:{final_port}/stream",
            "webrtc_url": f"wss://{host}:{final_port}/share/webrtc",
            "vnc_url": f"vnc://{host}:5900",
            "protocol": "webrtc",
        }
    elif backend == "redfish":
        console_info = {
            "console_url": f"{final_scheme}://{host}:{final_port}/redfish/v1/console",
            "protocol": "websocket",
        }
    elif backend == "openbmc":
        console_info = {
            "console_url": f"wss://{host}:{final_port}/console0",
            "serial_url": f"ssh://{host}:2200",
            "protocol": "websocket",
        }
    else:
        raise ValueError(f"Unsupported backend '{backend}'")

    result = {
        "status": "ok",
        "success": True,
        "target": target,
        "backend": backend,
        **console_info,
    }

    if dry_run:
        result["dry_run"] = True
    elif mock or (os.environ.get(ENV_MOCK_KEY, "").lower() in ("1", "true", "yes")):
        result["mock"] = True

    return result


def build_cli_parser() -> argparse.ArgumentParser:
    """Builds comprehensive CLI argument parser."""
    parser = argparse.ArgumentParser(
        prog="mios-ipkvm-manager",
        description="Dedicated Out-of-Band IP-KVM management mesh and Redfish/PiKVM virtual media provisioner",
    )

    common_parent = argparse.ArgumentParser(add_help=False)
    common_parent.add_argument("--json", action="store_true", help="Output result in structured JSON format")
    common_parent.add_argument("--auth-token", default=None, help="Authentication token for BMC API")
    common_parent.add_argument(
        "--backend",
        choices=SUPPORTED_BACKENDS,
        default="pikvm",
        help="BMC API backend: pikvm, redfish, or openbmc (default: pikvm)",
    )
    common_parent.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate parameters and build request without transmitting network packets",
    )
    common_parent.add_argument(
        "--mock",
        action="store_true",
        help="Simulate execution without requiring physical hardware",
    )
    common_parent.add_argument(
        "--allow-unauthenticated",
        action="store_true",
        help="Explicitly bypass auth token requirement in dry-run mode only",
    )
    common_parent.add_argument(
        "--port",
        type=int,
        default=None,
        help="Override destination TCP port for BMC API",
    )
    common_parent.add_argument(
        "--scheme",
        choices=["http", "https"],
        default=None,
        help="Override URL scheme (http or https)",
    )
    common_parent.add_argument(
        "--timeout",
        type=int,
        default=10,
        help="Network request timeout in seconds (default: 10)",
    )

    subparsers = parser.add_subparsers(dest="verb", required=True, help="Management verb")

    # mesh-status
    mesh_p = subparsers.add_parser(
        "mesh-status",
        parents=[common_parent],
        help="Inspects and reports WireGuard management mesh interface state",
    )
    mesh_p.add_argument(
        "--interface",
        default=DEFAULT_MESH_IFACE,
        help=f"Management WireGuard interface name (default: {DEFAULT_MESH_IFACE})",
    )

    # power
    power_p = subparsers.add_parser(
        "power",
        parents=[common_parent],
        help="Controls ATX power via Redfish, OpenBMC, or PiKVM APIs",
    )
    power_p.add_argument("--target", required=True, help="Target node name or IP (must be in 10.200.0.0/16 or 127.0.0.1)")
    power_p.add_argument("--action", required=True, choices=SUPPORTED_POWER_ACTIONS, help="Power action")

    # mount-iso
    mount_p = subparsers.add_parser(
        "mount-iso",
        parents=[common_parent],
        help="Mounts virtual boot media / ISO image",
    )
    mount_p.add_argument("--target", required=True, help="Target node name or IP")
    mount_p.add_argument("--iso-url", required=True, help="URL or path of virtual media ISO")

    # eject-iso
    eject_p = subparsers.add_parser(
        "eject-iso",
        parents=[common_parent],
        help="Ejects virtual boot media",
    )
    eject_p.add_argument("--target", required=True, help="Target node name or IP")

    # console-stream
    console_p = subparsers.add_parser(
        "console-stream",
        parents=[common_parent],
        help="Inspects/connects to VNC/WebRTC/serial console URL",
    )
    console_p.add_argument("--target", required=True, help="Target node name or IP")

    return parser


def main(argv: Optional[list[str]] = None) -> int:
    parser = build_cli_parser()
    args = parser.parse_args(argv)

    token = resolve_auth_token(args.auth_token)

    try:
        if args.verb == "mesh-status":
            result = get_mesh_status(args.interface)
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                state_str = "ACTIVE" if result["mesh_active"] else result["link_state"].upper()
                print("Management Mesh Status:")
                print(f"  Interface:    {result['interface']}")
                print(f"  Subnet:       {result['subnet']}")
                print(f"  MTU:          {result['mtu']}")
                print(f"  Link State:   {result['link_state']}")
                print(f"  IP Address:   {result['ip_address'] or 'None'}")
                print(f"  Status:       {state_str}")
            return 0

        elif args.verb == "power":
            result = execute_power(
                target=args.target,
                action=args.action,
                backend=args.backend,
                token=token,
                port=args.port,
                scheme=args.scheme,
                dry_run=args.dry_run,
                mock=args.mock,
                allow_unauthenticated=args.allow_unauthenticated,
                timeout=args.timeout,
            )
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                p_state = result.get("power_state", result.get("action"))
                prefix = "[DRY RUN] " if result.get("dry_run") else ("[MOCK] " if result.get("mock") else "")
                print(f"[mios-ipkvm] {prefix}Power {args.action} on {args.target} ({args.backend}): {p_state}")
            return 0

        elif args.verb == "mount-iso":
            result = execute_mount_iso(
                target=args.target,
                iso_url=args.iso_url,
                backend=args.backend,
                token=token,
                port=args.port,
                scheme=args.scheme,
                dry_run=args.dry_run,
                mock=args.mock,
                allow_unauthenticated=args.allow_unauthenticated,
                timeout=args.timeout,
            )
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                prefix = "[DRY RUN] " if result.get("dry_run") else ("[MOCK] " if result.get("mock") else "")
                print(f"[mios-ipkvm] {prefix}Mounted virtual media '{args.iso_url}' on {args.target} ({args.backend})")
            return 0

        elif args.verb == "eject-iso":
            result = execute_eject_iso(
                target=args.target,
                backend=args.backend,
                token=token,
                port=args.port,
                scheme=args.scheme,
                dry_run=args.dry_run,
                mock=args.mock,
                allow_unauthenticated=args.allow_unauthenticated,
                timeout=args.timeout,
            )
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                prefix = "[DRY RUN] " if result.get("dry_run") else ("[MOCK] " if result.get("mock") else "")
                print(f"[mios-ipkvm] {prefix}Ejected virtual media from {args.target} ({args.backend})")
            return 0

        elif args.verb == "console-stream":
            result = execute_console_stream(
                target=args.target,
                backend=args.backend,
                token=token,
                port=args.port,
                scheme=args.scheme,
                dry_run=args.dry_run,
                mock=args.mock,
                allow_unauthenticated=args.allow_unauthenticated,
                timeout=args.timeout,
            )
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                prefix = "[DRY RUN] " if result.get("dry_run") else ("[MOCK] " if result.get("mock") else "")
                print(
                    f"[mios-ipkvm] {prefix}Console stream for {args.target} ({args.backend}): "
                    f"{result.get('console_url')} (protocol: {result.get('protocol')})"
                )
            return 0

        else:
            raise ValueError(f"Unknown verb: {args.verb}")

    except (SecurityError, ValueError, ConnectionError, RuntimeError) as e:
        if getattr(args, "json", False):
            err_dict = {
                "status": "error",
                "success": False,
                "error": str(e),
                "error_type": e.__class__.__name__,
            }
            print(json.dumps(err_dict, indent=2))
        else:
            sys.stderr.write(f"Error: {e}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
