#!/usr/bin/env bash
# AI-hint: Thin glue for the env-baseline projection: prints the sealed snapshot of the resolved MIOS_* environment (one escaped KEY=value per line) by exec'ing the native `mios-gen env-snapshot`, which owns every rule the former bash body applied.
# AI-related: tools/native/mios-gen/src/env_snapshot.rs, /usr/share/mios/mios.toml, /usr/lib/mios/userenv.sh, /usr/share/mios/reference/env-baseline.txt
# AI-functions: main
#
# Kept as an entry point because drift checks and tools/drift-checks.py run it
# by path. The logic is native (Law 14): the snapshot is rendered in process
# from the same resolver library userenv.sh executes, so it no longer depends on
# which mios-resolver is first on PATH, and only the tree's VENDOR tiers are
# read -- never the host's /etc/mios when the tree is `/`.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
VENDOR_TOML="${MIOS_VENDOR_TOML:-${ROOT_DIR}/usr/share/mios/mios.toml}"

gen=""
if [[ -n "${MIOS_NATIVE_BIN_DIR:-}" ]]; then
    gen="${MIOS_NATIVE_BIN_DIR}/mios-gen"
elif [[ -n "${MIOS_GEN_BIN:-}" ]]; then
    gen="${MIOS_GEN_BIN}"
else
    for candidate in "${ROOT_DIR}/tools/native/target/release/mios-gen" \
        "${ROOT_DIR}/tools/native/target/debug/mios-gen" \
        /usr/libexec/mios/mios-gen /usr/bin/mios-gen; do
        [[ -x "$candidate" ]] && { gen="$candidate"; break; }
    done
fi
if [[ -z "$gen" || ! -x "$gen" ]]; then
    echo "[mios-env-snapshot] ERROR: native mios-gen not found (build tools/native or set MIOS_GEN_BIN)" >&2
    exit 2
fi

exec env -i PATH=/usr/bin:/bin "$gen" env-snapshot --root "${ROOT_DIR}" --vendor "${VENDOR_TOML}"
