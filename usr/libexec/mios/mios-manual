#!/usr/bin/env python3
# AI-hint: The generative documentation CLI: builds the comment corpus ledger that makes "this comment's knowledge landed in a doc" machine-checkable and reports the census behind the documentation ratchet. Only `prune` edits source, only for landed knowledge.
# AI-related: usr/lib/mios/mios_comments.py, usr/share/mios/reference/manual-corpus.tsv, automation/98-drift-checks.sh, docs/design/doc-generative-documentation.md
# AI-functions: cmd_ledger, cmd_audit, cmd_coverage, cmd_harvest, cmd_prune, cmd_landing, cmd_check_functions, cmd_render, cmd_rehash, check_harvested_functions, landed, main
"""mios-manual -- corpus ledger and census for the MiOS documentation system.

Spec: docs/design/doc-generative-documentation.md sections 3.4 and 5.

Subcommands:
  ledger          rebuild usr/share/mios/reference/manual-corpus.tsv from the tree
  audit           census as JSON (counts by class and reason)
  coverage        the two ratchet numbers, for the gate and for humans
  harvest         move a comment's prose into a doc and record where it landed
  prune           delete a comment that provably landed (the only destructive path)
  landing         verify every pruned comment still lands in a doc
  check-functions verify harvested AI-functions lines against source
  render          splice derived content into MIOS-GEN marker interiors
  rehash          after an in-place rewrite (mios-task migrate-ids), move landed rows to their new hash

`--root` selects the repo, and either layout resolves, so the same tools serve
mios.git and mios-bootstrap.git without being copied across (Law 15).

The ledger is the safety mechanism for the whole programme. Deletion of a
comment is only ever permitted once a ledger row proves its knowledge reached a
doc, so the landing columns must survive ordinary code churn: they are carried
forward BY CONTENT HASH, never recomputed. Moving a block within a file, or
reformatting the code around it, keeps its landing record.

Rows for blocks that no longer exist but were pruned are kept as tombstones --
that retention is what lets a gate prove, after the fact, that a comment which
is gone did land somewhere first.
"""
from __future__ import annotations

import argparse
import collections
import json
import os
import re
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_ROOT_DEFAULT = os.path.abspath(os.path.join(_HERE, "..", "..", ".."))
sys.path.insert(0, os.path.join(_ROOT_DEFAULT, "usr", "lib", "mios"))

try:
    import tomllib
except ImportError:  # pragma: no cover
    tomllib = None

import mios_comments as mc  # noqa: E402

LEDGER_REL = "usr/share/mios/reference/manual-corpus.tsv"

COLUMNS = ["path", "start_line", "end_line", "lines", "words", "sha12", "class",
           "reason", "as", "stale", "landed_doc", "landed_anchor", "landed_words",
           "pruned"]

# Which files the census covers is defined once, in mios_comments.
SCAN_EXT = mc.SCAN_EXT


def _ssot_path(root: str) -> str:
    """The SSOT for a repo root, in either repo's layout.

    mios.git keeps it at usr/share/mios/mios.toml (it IS the deployed /usr);
    mios-bootstrap.git keeps its overlay at the root. Resolving both here is
    what lets one set of doc tools serve both repos, instead of the tools being
    copied across -- which Law 15 forbids.
    """
    for rel in ("usr/share/mios/mios.toml", "mios.toml"):
        cand = os.path.join(root, rel.replace("/", os.sep))
        if os.path.isfile(cand):
            return cand
    return os.path.join(root, "usr", "share", "mios", "mios.toml")


def _policy(root: str) -> mc.Policy:
    if tomllib is None:
        return mc.Policy()
    with open(_ssot_path(root), "rb") as fh:
        return mc.Policy.from_toml(tomllib.load(fh))


def _iter_blocks(root: str, policy: mc.Policy, refindex=None):
    for rel, full in mc.iter_source_files(root):
        try:
            blocks = mc.lex(full)
        except Exception:
            continue
        for b in blocks:
            b = mc.Block(**{**b.__dict__, "path": rel})
            yield b, mc.classify(b, policy, refindex)


# Landing columns describe the TEXT, not the site: if the same comment appears
# in four files and its prose lands in a doc, it has landed for all four.
_LANDING_COLUMNS = ("landed_doc", "landed_anchor", "landed_words", "pruned")


class Ledger(dict):
    """sha12 -> row for lookups, every row preserved for writing.

    A plain dict keyed by sha12 loses duplicates, and identical comment text is
    common -- the same header boilerplate sits in many files. Reading the ledger
    into one and writing `list(rows.values())` back silently dropped 1105 of
    9669 rows, so a harvest followed by a commit would have deleted a ninth of
    the census with nothing to show for it.
    """

    def __init__(self):
        super().__init__()
        self._all = []

    def add(self, row):
        self._all.append(row)
        self.setdefault(row["sha12"], row)

    def __setitem__(self, key, row):
        if key not in self:
            self._all.append(row)
        super().__setitem__(key, row)

    def values(self):
        """Every row, with landing propagated to rows sharing a sha12."""
        for row in self._all:
            canon = dict.get(self, row["sha12"])
            if canon is not None and canon is not row:
                for col in _LANDING_COLUMNS:
                    if canon.get(col):
                        row[col] = canon[col]
        return list(self._all)


def _read_ledger(path):
    """Existing rows keyed by sha12, so landing survives code churn."""
    out = Ledger()
    if not os.path.isfile(path):
        return out
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip(chr(10)).split(chr(9))
            if len(parts) != len(COLUMNS):
                continue
            out.add(dict(zip(COLUMNS, parts)))
    return out


def _refuse_if_degraded() -> int:
    """The census must be the same artifact everywhere, or it is not a projection.

    A file the Python lexer could not tokenize or parse falls back to the regex
    lexer, which the module itself documents as miscounting -- and whether that
    happens depends on the INTERPRETER, not the file, so the same tree yields
    different ledgers on different machines. Refusing is the honest outcome.
    """
    if not mc.DEGRADED:
        return 0
    print("cannot build a reproducible census: these files did not parse on "
          f"python{sys.version_info.major}.{sys.version_info.minor}, so their "
          "comments were counted by the fallback lexer:", file=sys.stderr)
    for rel in sorted(set(mc.DEGRADED)):
        print(f"  {rel}", file=sys.stderr)
    print("  (the repo's sources need a newer Python; upgrade rather than "
          "committing the degraded ledger)", file=sys.stderr)
    return 1


def _row(b, v, old: dict) -> dict:
    """One ledger row; the landing columns are carried forward by hash, never recomputed."""
    return {
        "path": b.path, "start_line": str(b.start_line), "end_line": str(b.end_line),
        "lines": str(b.lines), "words": str(b.words), "sha12": b.sha12,
        "class": v.cls, "reason": v.reason, "as": v.as_,
        "stale": "1" if v.stale else "0",
        "landed_doc": old.get("landed_doc", ""),
        "landed_anchor": old.get("landed_anchor", ""),
        "landed_words": old.get("landed_words", ""),
        "pruned": old.get("pruned", "0"),
    }


def cmd_ledger(args) -> int:
    root = args.root
    policy = _policy(root)
    mc.DEGRADED.clear()
    dest = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    prior = _read_ledger(dest)

    rows = []
    seen: set[str] = set()
    for b, v in _iter_blocks(root, policy):
        seen.add(b.sha12)
        rows.append(_row(b, v, prior.get(b.sha12, {})))

    # Tombstones: a pruned block is gone from the tree but its landing proof
    # must outlive it, otherwise nothing can show the deletion was safe.
    tombstones = [r for sha, r in prior.items()
                  if sha not in seen and r.get("pruned") == "1"]
    rows.extend(tombstones)
    rows.sort(key=lambda r: (r["path"], int(r["start_line"] or 0)))

    body = ["# " + "\t".join(COLUMNS)]
    body += ["\t".join(r[c] for c in COLUMNS) for r in rows]
    text = "\n".join(body) + "\n"

    if _refuse_if_degraded():
        return 1

    if args.check:
        current = ""
        if os.path.isfile(dest):
            with open(dest, encoding="utf-8", newline="") as fh:
                current = fh.read()
        if current.replace("\r\n", "\n") != text:
            print(f"{LEDGER_REL} is stale -- run `mios-manual ledger --write`",
                  file=sys.stderr)
            return 1
        print(f"{LEDGER_REL} up to date ({len(rows)} rows)")
        return 0

    os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(text)
    print(f"wrote {LEDGER_REL}: {len(rows)} rows "
          f"({len(tombstones)} tombstones carried)")
    return 0


def landed(row: dict, root: str, policy: mc.Policy) -> bool:
    """True when this row's knowledge is provably in a doc.

    The predicate `prune` and the landing gate both use. Deliberately strict:
    the doc must exist, must carry the block's own content hash as an anchor,
    and the passage must retain most of the words. Anything weaker would let a
    one-line stub authorise deleting a 90-line design note.
    """
    doc = row.get("landed_doc") or ""
    if not doc:
        return False
    p = os.path.join(root, doc.replace("/", os.sep))
    if not os.path.isfile(p):
        return False
    try:
        with open(p, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return False
    marker = f"mios-src:{row['sha12']}"
    if marker not in text:
        return False
    try:
        want = int(row.get("words") or 0)
        got = int(row.get("landed_words") or 0)
    except ValueError:
        return False
    return got >= policy.landing_min_word_ratio * want


def _write_ledger(root: str, rows: list[dict]) -> None:
    dest = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    rows = sorted(rows, key=lambda r: (r["path"], int(r["start_line"] or 0)))
    body = ["# " + "\t".join(COLUMNS)]
    body += ["\t".join(r[c] for c in COLUMNS) for r in rows]
    with open(dest, "w", encoding="utf-8", newline="\n") as fh:
        fh.write("\n".join(body) + "\n")


def _slug(text: str, limit: int = 60) -> str:
    """A short human title for a harvested passage.

    Source comments often open with banner decoration (`--- section ---`) or a
    bullet; carrying that into a Markdown heading reads as noise, so strip the
    ornament and title the passage by its first real words.
    """
    import re as _re
    first = " ".join(text.split())
    first = _re.sub(r"^[\s\-=*#/_.:|>+]+", "", first)
    first = _re.sub(r"[\s\-=*_]+$", "", first)
    # A leading "key:" label is a better title on its own than a truncated line.
    label = _re.match(r"^([A-Za-z][\w ./-]{2,40}?):\s", first)
    if label:
        return label.group(1).strip()
    if len(first) > limit:
        first = first[:limit].rsplit(" ", 1)[0].rstrip(" ,;:") + "..."
    return first or "harvested note"


def _passage(block, rel_src: str) -> str:
    """The doc form of a source comment.

    Carries the mios-src anchor that landed() looks for, so the doc itself is
    the proof -- not a promise recorded elsewhere.
    """
    return (f"### {_slug(block.text)}\n\n"
            f"{block.text.strip()}\n\n"
            f"<!-- mios-src:{block.sha12} "
            f"from {rel_src}:{block.start_line}-{block.end_line} -->\n")


def sanitize(text: str, ssot: dict) -> str:
    """Clean a scraped comment before it reaches a doc.

    A comment is written for whoever is editing that file; a manual is read by
    an operator on a booted host. Dev-box paths mean nothing to them, and a
    secret that leaked into a comment must not be republished into a doc that
    ships in the image.
    """
    import re as _re
    cfg = (ssot.get("docs", {}) or {}).get("sanitize", {}) or {}
    for pair in cfg.get("path_rewrites", []) or []:
        if isinstance(pair, (list, tuple)) and len(pair) == 2:
            text = text.replace(str(pair[0]), str(pair[1]))
    mask = str(cfg.get("redact_with", "[redacted]"))
    for pat in cfg.get("redact_patterns", []) or []:
        try:
            text = _re.sub(str(pat), mask, text)
        except _re.error:
            continue
    return text


def _distill_dest(rel: str, dest_dir: str) -> str:
    """Which manual page a file's prose belongs on.

    Grouped by the directory the file lives in, so the manual mirrors the tree
    an operator is already navigating rather than inventing a second taxonomy.
    """
    parent = os.path.dirname(rel)
    name = os.path.basename(parent) if parent else "root"
    name = "".join(c if (c.isalnum() or c in "-_.") else "-" for c in name) or "root"
    return f"{dest_dir.rstrip('/')}/{name}.md"


def cmd_distill(args) -> int:
    """The Day-N+1 pass: scrape comments, sanitize, distil into the manual.

    Deliberately NON-destructive. It never edits source and never touches an
    AI-hint: hints stay where they are and reach the docs through the index
    deriver, while narrative comments are copied forward. Removing a scraped
    comment stays a separate, opt-in `prune`.
    """
    root = args.root
    policy = _policy(root)
    with open(_ssot_path(root), "rb") as fh:
        ssot = tomllib.load(fh)
    cfg = (ssot.get("docs", {}) or {}).get("distill", {}) or {}
    if not cfg.get("enable", True):
        print("distill disabled ([docs.distill].enable = false)")
        return 0
    dest_dir = str(cfg.get("dest_dir") or "usr/share/doc/mios/manual")

    mc.DEGRADED.clear()
    ledger_path = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    rows = _read_ledger(ledger_path)
    if not rows:
        print(f"{LEDGER_REL} is empty -- run `mios-manual ledger --write` first",
              file=sys.stderr)
        return 1

    # Exactly the blocks cmd_coverage and check_docs_ratchet count, so a clean
    # distill always leaves the narrative ratchet at zero.
    by_dest: dict[str, list] = {}
    for b, v in _iter_blocks(root, policy):
        if v.cls != "MIGRATE":
            continue
        row = rows.get(b.sha12)
        if row is not None and landed(row, root, policy):
            continue          # already distilled, by content hash
        if row is None:
            rows[b.sha12] = _row(b, v, {})
        by_dest.setdefault(_distill_dest(b.path, dest_dir), []).append(b)

    if _refuse_if_degraded():
        return 1

    if not by_dest:
        print("nothing to distil: every scraped comment already landed")
        return 0

    written = recorded = 0
    for dest_rel, blocks in sorted(by_dest.items()):
        dest_abs = os.path.join(root, dest_rel.replace("/", os.sep))
        existing = ""
        if os.path.isfile(dest_abs):
            with open(dest_abs, encoding="utf-8") as fh:
                existing = fh.read()
        chunks, queued = [], set()
        for b in blocks:
            if f"mios-src:{b.sha12}" in existing or b.sha12 in queued:
                continue      # the passage is there; only its landing is recorded
            queued.add(b.sha12)
            clean = sanitize(b.text, ssot)
            chunks.append(f"### {_slug(clean)}\n\n{clean.strip()}\n\n"
                          f"<!-- mios-src:{b.sha12} "
                          f"from {b.path}:{b.start_line}-{b.end_line} -->\n")
        if args.dry_run:
            print(f"would distil {len(chunks)} block(s) and record"
                  f" {len(blocks)} landing(s) -> {dest_rel}")
            written += len(chunks)
            continue
        if chunks:
            os.makedirs(os.path.dirname(dest_abs), exist_ok=True)
            with open(dest_abs, "a", encoding="utf-8", newline="\n") as fh:
                if not existing:
                    area = os.path.splitext(os.path.basename(dest_rel))[0]
                    fh.write(f"<!-- AI-hint: Manual pages distilled from the source "
                             f"comments of {area}, sanitized, each passage anchored to "
                             f"the comment it came from. -->\n\n# {area}\n\n")
                fh.write("\n".join(chunks))
            print(f"distilled {len(chunks)} block(s) -> {dest_rel}")
        for b in blocks:
            row = rows[b.sha12]
            row["landed_doc"] = dest_rel
            row["landed_anchor"] = f"mios-src:{b.sha12}"
            row["landed_words"] = str(b.words)
        written += len(chunks)
        recorded += len(blocks)

    if not args.dry_run and recorded:
        _write_ledger(root, list(rows.values()))
    print(f"distilled {written} block(s), recorded {recorded} landing(s)"
          f" across {len(by_dest)} manual page(s)")
    return 0


def summarize_hint(text: str, max_chars: int = 240) -> str:
    """Summarize an overlong hint block into a clean, concise summary."""
    lines = text.strip().splitlines()
    prefix = "AI-hint: "

    clean_lines = []
    for line in lines:
        l = line.strip()
        for p in ("#", "//", "/*", "*/", '"""'):
            if l.startswith(p):
                l = l[len(p):].strip()
            if l.endswith(p):
                l = l[:-len(p)].strip()
        if l.startswith("AI-hint:"):
            l = l[len("AI-hint:"):].strip()
        if l:
            clean_lines.append(l)

    body = " ".join(clean_lines)
    budget = max_chars - len(prefix)
    if len(body) <= budget:
        return prefix + body

    truncated = body[:budget]
    last_dot = max(truncated.rfind(". "), truncated.rfind(".\n"))
    if last_dot > 60:
        summary = truncated[:last_dot + 1]
    else:
        last_space = truncated.rfind(" ")
        if last_space > 30:
            summary = truncated[:last_space] + "..."
        else:
            summary = truncated[:budget - 3] + "..."
    return prefix + summary


def cmd_harvest(args) -> int:
    """Move a source comment's PROSE into a doc, and record where it landed.

    Harvest never edits source. It writes the passage, stamps the anchor and
    fills the ledger's landing columns; `prune` is the only thing that removes
    the original, and only once landed() proves this step happened.
    """
    root = args.root
    policy = _policy(root)

    if getattr(args, "check", False):
        return cmd_check_functions(args)

    if getattr(args, "refresh", False):
        is_apply = getattr(args, "apply", False)
        is_dry_run = getattr(args, "dry_run", False) or not is_apply
        ledger_path = os.path.join(root, LEDGER_REL.replace("/", os.sep))
        rows = _read_ledger(ledger_path)

        path_arg = getattr(args, "path", None)
        harvest_dir = os.path.join(root, "usr", "share", "doc", "mios", "manual", "_harvest")
        if path_arg:
            dest_rel = getattr(args, "to", None) or _distill_dest(path_arg, "usr/share/doc/mios/manual/_harvest")
            docs = [dest_rel]
        else:
            doc_arg = getattr(args, "doc", None)
            if doc_arg:
                docs = [doc_arg]
            elif not os.path.isdir(harvest_dir):
                print(f"no harvest directory at {harvest_dir}", file=sys.stderr)
                return 0
            else:
                docs = [
                    f"usr/share/doc/mios/manual/_harvest/{fname}"
                    for fname in sorted(os.listdir(harvest_dir))
                    if fname.endswith(".md")
                ]

        refreshed_count = 0
        skipped_count = 0

        for dest_rel in docs:
            dest_abs = os.path.join(root, dest_rel.replace("/", os.sep))
            if not os.path.isfile(dest_abs):
                continue
            with open(dest_abs, encoding="utf-8") as fh:
                existing = fh.read()

            anchors = list(_ANCHOR_RE.finditer(existing))
            file_changed = False
            for m in anchors:
                old_sha, src_rel, s_l, e_l = m.groups()
                src_rel_clean = src_rel.replace("\\", "/")
                if path_arg and src_rel_clean != path_arg.replace("\\", "/"):
                    continue
                src_abs = os.path.join(root, src_rel_clean.replace("/", os.sep))
                if not os.path.isfile(src_abs):
                    continue
                try:
                    blocks = mc.lex(src_abs)
                except Exception:
                    continue
                header_block = next((b for b in blocks if b.in_header_block or b.start_line == 1), None)
                if not header_block:
                    continue
                header_block = mc.Block(**{**header_block.__dict__, "path": src_rel_clean})
                new_passage = _passage(header_block, src_rel_clean)

                pat = re.compile(
                    r'### (?:(?!###).)*?<!--\s*mios-src:[0-9a-f]+\s+from\s+'
                    + re.escape(src_rel) + r':\d+-\d+\s*-->\n*',
                    re.DOTALL
                )
                old_m = pat.search(existing)
                if not old_m:
                    continue
                old_block = old_m.group(0).strip()
                if old_block == new_passage.strip():
                    skipped_count += 1
                    continue

                if is_dry_run:
                    print(f"would refresh {header_block.sha12} ({header_block.words} words) {src_rel_clean} in {dest_rel}")
                    refreshed_count += 1
                else:
                    existing = pat.sub(lambda _: new_passage + "\n", existing, count=1)
                    file_changed = True
                    row = rows.get(header_block.sha12)
                    if row is None:
                        row = {
                            "path": header_block.path,
                            "start_line": str(header_block.start_line),
                            "end_line": str(header_block.end_line),
                            "lines": str(header_block.end_line - header_block.start_line + 1),
                            "words": str(header_block.words),
                            "sha12": header_block.sha12,
                            "class": "STAY",
                            "reason": "ai-header",
                            "as": "doc",
                            "stale": "0",
                            "landed_doc": dest_rel,
                            "landed_anchor": f"mios-src:{header_block.sha12}",
                            "landed_words": str(header_block.words),
                            "pruned": "0"
                        }
                        rows[header_block.sha12] = row
                    else:
                        row["landed_doc"] = dest_rel
                        row["landed_anchor"] = f"mios-src:{header_block.sha12}"
                        row["landed_words"] = str(header_block.words)
                    refreshed_count += 1
                    print(f"refreshed {header_block.sha12} ({header_block.words} words) {src_rel_clean} -> {dest_rel}")

            if file_changed and not is_dry_run:
                with open(dest_abs, "w", encoding="utf-8", newline="\n") as fh:
                    fh.write(existing)

        if not is_dry_run:
            _write_ledger(root, list(rows.values()))
            print(f"refreshed {refreshed_count} block(s) in _harvest/ ({skipped_count} already current)")
        else:
            print(f"dry-run: {refreshed_count} block(s) would be refreshed ({skipped_count} already current)")
        return 0

    class_name = getattr(args, "class_name", None)
    if class_name == "overlong-hint":
        policy.hint_max_chars = 260
        wanted = []
        for b, v in _iter_blocks(root, policy):
            if v.cls == "MIGRATE_HEADER" or (b.in_header_block and len(b.text) > 260):
                if not getattr(args, "block", None) or b.sha12.startswith(args.block):
                    wanted.append((b, v))

        if not wanted:
            print("no overlong-hint blocks found", file=sys.stderr)
            return 0

        ledger_path = os.path.join(root, LEDGER_REL.replace("/", os.sep))
        rows = _read_ledger(ledger_path)
        if not rows:
            print(f"{LEDGER_REL} is empty -- run `mios-manual ledger --write` first", file=sys.stderr)
            return 1

        is_apply = getattr(args, "apply", False)
        is_dry_run = getattr(args, "dry_run", False) or not is_apply

        added_count = 0
        skipped_count = 0

        for b, v in wanted:
            # One page per SOURCE DIRECTORY, matching `_distill_dest`'s grouping --
            # not one page per source FILE. A per-file destination fans out into
            # hundreds of tiny tracked pages (one per script), which trips the
            # legibility ratchet's tracked_files ceiling the moment this bulk
            # migration is committed, for no documentation benefit: an operator
            # already navigates the manual by directory, not by original filename.
            dest_rel = _distill_dest(b.path, "usr/share/doc/mios/manual/_harvest")
            dest_abs = os.path.join(root, dest_rel.replace("/", os.sep))

            existing = ""
            if os.path.isfile(dest_abs):
                with open(dest_abs, encoding="utf-8") as fh:
                    existing = fh.read()

            if f"mios-src:{b.sha12}" in existing:
                skipped_count += 1
                row = rows.get(b.sha12)
                if row:
                    row["landed_doc"] = dest_rel
                    row["landed_anchor"] = f"mios-src:{b.sha12}"
                    row["landed_words"] = str(b.words)
                continue

            passage = _passage(b, b.path)
            if is_dry_run:
                print(f"would harvest {b.sha12} ({b.words} words) {b.path}:{b.start_line}-{b.end_line} -> {dest_rel}")
                added_count += 1
            else:
                os.makedirs(os.path.dirname(dest_abs), exist_ok=True)
                header = ""
                if not existing:
                    header = (f"<!-- AI-hint: Prose harvested out of source comments by "
                              f"`mios-manual harvest`; each passage carries the mios-src anchor "
                              f"that proves which comment it came from. -->\n\n"
                              f"# Harvested notes\n\n")
                with open(dest_abs, "a", encoding="utf-8", newline="\n") as fh:
                    if header:
                        fh.write(header)
                    elif not existing.endswith("\n\n"):
                        fh.write("\n")
                    fh.write(passage + "\n")

                row = rows.get(b.sha12)
                if row is None:
                    row = {
                        "path": b.path,
                        "start_line": str(b.start_line),
                        "end_line": str(b.end_line),
                        "lines": str(b.end_line - b.start_line + 1),
                        "words": str(b.words),
                        "sha12": b.sha12,
                        "class": v.cls,
                        "reason": v.reason,
                        "as": "doc",
                        "stale": "1" if v.stale else "0",
                        "landed_doc": dest_rel,
                        "landed_anchor": f"mios-src:{b.sha12}",
                        "landed_words": str(b.words),
                        "pruned": "0"
                    }
                    rows[b.sha12] = row
                else:
                    row["landed_doc"] = dest_rel
                    row["landed_anchor"] = f"mios-src:{b.sha12}"
                    row["landed_words"] = str(b.words)

                added_count += 1

        if not is_dry_run:
            _write_ledger(root, list(rows.values()))
            print(f"harvested {added_count} overlong hint(s) into usr/share/doc/mios/manual/_harvest/ ({skipped_count} already landed)")
        else:
            print(f"dry-run: {added_count} overlong hint(s) would be harvested ({skipped_count} already landed)")
        return 0

    if not getattr(args, "path", None) or not getattr(args, "to", None):
        print("error: --path and --to are required unless --class is specified", file=sys.stderr)
        return 1

    src_rel = args.path.replace(os.sep, "/")
    dest_rel = args.to.replace(os.sep, "/")
    dest_abs = os.path.join(root, dest_rel.replace("/", os.sep))

    # Refuse a generated destination. Harvesting into one puts prose in a file
    # its generator will overwrite, and the doc's own round-trip test fails
    # immediately -- which is how this was found. Generated docs say so in
    # their header, so the check needs no list to maintain.
    if os.path.isfile(dest_abs):
        with open(dest_abs, encoding="utf-8", errors="replace") as fh:
            head = fh.read(1024)
        if "DO NOT EDIT" in head or "GENERATED by" in head:
            print(f"error: {dest_rel} is a generated document -- harvest into a"
                  f" hand-written doc, or omit --to for the _harvest area",
                  file=sys.stderr)
            return 1


    wanted = [b for b, v in _iter_blocks(root, policy)
              if b.path == src_rel and v.cls == "MIGRATE"
              and (not args.block or b.sha12.startswith(args.block))]
    if not wanted:
        print(f"no MIGRATE block in {src_rel}"
              + (f" matching {args.block}" if args.block else ""), file=sys.stderr)
        return 1

    ledger_path = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    rows = _read_ledger(ledger_path)
    if not rows:
        print(f"{LEDGER_REL} is empty -- run `mios-manual ledger --write` first",
              file=sys.stderr)
        return 1

    existing = ""
    if os.path.isfile(dest_abs):
        with open(dest_abs, encoding="utf-8") as fh:
            existing = fh.read()

    added, skipped = [], []
    chunks = []
    for b in wanted:
        if f"mios-src:{b.sha12}" in existing:
            skipped.append(b.sha12)
            continue
        chunks.append(_passage(b, src_rel))
        added.append(b)

    if args.dry_run:
        for b in added:
            print(f"would harvest {b.sha12} ({b.words} words) "
                  f"{src_rel}:{b.start_line}-{b.end_line} -> {dest_rel}")
        for sha in skipped:
            print(f"already landed: {sha}")
        return 0

    if chunks:
        os.makedirs(os.path.dirname(dest_abs), exist_ok=True)
        header = ""
        if not existing:
            header = (f"<!-- AI-hint: Prose harvested out of source comments by "
                      f"`mios-manual harvest`; each passage carries the mios-src anchor "
                      f"that proves which comment it came from. -->\n\n"
                      f"# Harvested notes\n\n")
        with open(dest_abs, "a", encoding="utf-8", newline="\n") as fh:
            if header:
                fh.write(header)
            elif not existing.endswith("\n\n"):
                fh.write("\n")
            fh.write("\n".join(chunks))

    for b in added:
        row = rows.get(b.sha12)
        if row is None:
            continue
        row["landed_doc"] = dest_rel
        row["landed_anchor"] = f"mios-src:{b.sha12}"
        row["landed_words"] = str(b.words)
    _write_ledger(root, list(rows.values()))

    for b in added:
        print(f"harvested {b.sha12} ({b.words} words) -> {dest_rel}")
    for sha in skipped:
        print(f"already landed: {sha}")
    return 0


def cmd_prune(args) -> int:
    """Delete a source comment, but ONLY where landed() proves it is in a doc.

    This is the only destructive path in the programme, so the predicate is
    checked per block immediately before the lines are removed.
    """
    root = args.root
    policy = _policy(root)

    ledger_path = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    rows = _read_ledger(ledger_path)

    class_name = getattr(args, "class_name", None)
    if class_name == "overlong-hint":
        policy.hint_max_chars = 260
        is_apply = getattr(args, "apply", False)
        is_dry_run = getattr(args, "dry_run", False) or not is_apply

        targets = []
        for b, v in _iter_blocks(root, policy):
            if not (v.cls == "MIGRATE_HEADER" or (b.in_header_block and len(b.text) > 260)):
                continue
            if getattr(args, "path", None) and b.path != args.path.replace(os.sep, "/"):
                continue
            if getattr(args, "block", None) and not b.sha12.startswith(args.block):
                continue
            row = rows.get(b.sha12)
            if row is None:
                print(f"refusing {b.sha12}: no ledger row", file=sys.stderr)
                continue
            if getattr(args, "only_landed", False) and not landed(row, root, policy):
                print(f"refusing {b.sha12}: not landed in a doc (harvest it first)", file=sys.stderr)
                continue
            targets.append((b, row))

        if not targets:
            print("nothing prunable (harvest first, then prune)", file=sys.stderr)
            return 1

        if is_dry_run:
            for b, row in targets:
                print(f"would prune overlong-hint {b.path}:{b.start_line}-{b.end_line} ({b.sha12})")
            return 0

        by_file = {}
        for b, row in targets:
            by_file.setdefault(b.path, []).append((b, row))

        pruned_count = 0
        for rel_path, t_list in by_file.items():
            src_abs = os.path.join(root, rel_path.replace("/", os.sep))
            with open(src_abs, encoding="utf-8", newline="") as fh:
                lines = fh.readlines()

            for b, row in sorted(t_list, key=lambda t: t[0].start_line, reverse=True):
                landed_doc = row.get("landed_doc", "")
                summary = summarize_hint(b.text, max_chars=130)
                if rel_path.endswith(".py") or rel_path.endswith(".sh") or rel_path.endswith(".ps1") or rel_path.endswith(".yml") or rel_path.endswith(".toml"):
                    replacement = f"# {summary.lstrip('#').strip()}\n# AI-doc: {landed_doc}\n"
                else:
                    replacement = f"/* {summary.strip()} */\n/* AI-doc: {landed_doc} */\n"

                lines[b.start_line - 1:b.end_line] = [replacement]
                row["pruned"] = "1"
                pruned_count += 1

            with open(src_abs, "w", encoding="utf-8", newline="") as fh:
                fh.writelines(lines)

        _write_ledger(root, list(rows.values()))
        print(f"pruned {pruned_count} overlong hint(s) across {len(by_file)} file(s)")
        return 0

    if not getattr(args, "path", None):
        print("error: --path is required unless --class is specified", file=sys.stderr)
        return 1

    src_rel = args.path.replace(os.sep, "/")
    src_abs = os.path.join(root, src_rel.replace("/", os.sep))

    targets = []
    for b, v in _iter_blocks(root, policy):
        if b.path != src_rel or v.cls != "MIGRATE":
            continue
        if args.block and not b.sha12.startswith(args.block):
            continue
        row = rows.get(b.sha12)
        if row is None:
            print(f"refusing {b.sha12}: no ledger row", file=sys.stderr)
            continue
        if not landed(row, root, policy):
            print(f"refusing {b.sha12}: not landed in a doc "
                  f"(harvest it first)", file=sys.stderr)
            continue
        targets.append((b, row))

    if not targets:
        print("nothing prunable (harvest first, then prune)", file=sys.stderr)
        return 1

    if args.dry_run:
        for b, _ in targets:
            print(f"would prune {src_rel}:{b.start_line}-{b.end_line} ({b.sha12})")
        return 0

    with open(src_abs, encoding="utf-8", newline="") as fh:
        lines = fh.readlines()
    # Highest line first, so earlier offsets stay valid as lines are removed.
    for b, row in sorted(targets, key=lambda t: t[0].start_line, reverse=True):
        del lines[b.start_line - 1:b.end_line]
        row["pruned"] = "1"
    with open(src_abs, "w", encoding="utf-8", newline="") as fh:
        fh.writelines(lines)

    _write_ledger(root, list(rows.values()))
    for b, _ in targets:
        print(f"pruned {src_rel}:{b.start_line}-{b.end_line} ({b.sha12})")
    return 0


def cmd_landing(args) -> int:
    """Every pruned comment must still be provably present in a doc.

    A tombstone whose doc passage was later deleted would mean a comment was
    removed and its knowledge then silently lost -- exactly what the ledger
    exists to make impossible. This is the gate for that.
    """
    root = args.root
    policy = _policy(root)
    rows = _read_ledger(os.path.join(root, LEDGER_REL.replace("/", os.sep)))
    broken = [r for r in rows.values()
              if r.get("pruned") == "1" and not landed(r, root, policy)]
    for r in broken:
        print(f"pruned block {r['sha12']} ({r['path']}) no longer lands in "
              f"{r.get('landed_doc') or '<unset>'}", file=sys.stderr)
    if broken:
        return 1
    pruned_n = sum(1 for r in rows.values() if r.get("pruned") == "1")
    print(f"landing proofs intact ({pruned_n} pruned block(s) still documented)")
    return 0


_ANCHOR_RE = re.compile(r'<!--\s*mios-src:([0-9a-f]+)\s+from\s+([^:]+):(\d+)-(\d+)\s*-->')


def check_harvested_functions(root: str, target_doc: str | None = None) -> list[str]:
    """Verify that every function named in a harvested AI-functions line exists in its source.

    Acceptance criteria (task_3482):
    WHEN a harvested AI-functions line names a function absent from its mios-src
    source THE SYSTEM SHALL fail a check naming the doc line and the function.
    """
    violations = []
    if target_doc:
        doc_paths = [os.path.join(root, target_doc.replace("/", os.sep))]
    else:
        harvest_dir = os.path.join(root, "usr", "share", "doc", "mios", "manual", "_harvest")
        default_mios = os.path.join(harvest_dir, "mios.md")
        if os.path.isfile(default_mios):
            doc_paths = [default_mios]
        elif os.path.isdir(harvest_dir):
            doc_paths = [
                os.path.join(harvest_dir, fname)
                for fname in sorted(os.listdir(harvest_dir))
                if fname.endswith(".md")
            ]
        else:
            return violations

    for doc_path in doc_paths:
        if not os.path.isfile(doc_path):
            continue
        doc_rel = os.path.relpath(doc_path, root).replace(os.sep, "/")
        try:
            with open(doc_path, encoding="utf-8", errors="replace") as fh:
                lines = fh.readlines()
        except OSError:
            continue

        current_funcs = None
        current_line_no = None

        for idx, line in enumerate(lines, 1):
            stripped = line.strip()
            if stripped.startswith("AI-functions:"):
                raw = stripped[len("AI-functions:"):].strip()
                fns = []
                for token in raw.split(","):
                    t = token.strip()
                    if not t or t == "(test)":
                        continue
                    if t.startswith("class "):
                        t = t[len("class "):].strip()
                    fns.append(t)
                current_funcs = fns
                current_line_no = idx
            m = _ANCHOR_RE.search(line)
            if m and current_funcs is not None:
                sha, src_rel, s_line, e_line = m.groups()
                src_path = os.path.join(root, src_rel.replace("/", os.sep))
                if not os.path.isfile(src_path):
                    violations.append(
                        f"FAIL: {doc_rel}:{current_line_no}: source file {src_rel} does not exist"
                    )
                else:
                    try:
                        with open(src_path, encoding="utf-8", errors="replace") as sf:
                            src_text = sf.read()
                        for fn in current_funcs:
                            pat = r'\b' + re.escape(fn) + r'\b'
                            if not re.search(pat, src_text):
                                violations.append(
                                    f"FAIL: {doc_rel}:{current_line_no}: function '{fn}' is absent from {src_rel}"
                                )
                    except OSError as exc:
                        violations.append(
                            f"FAIL: {doc_rel}:{current_line_no}: error reading {src_rel}: {exc}"
                        )
                current_funcs = None
                current_line_no = None

    return violations


def cmd_check_functions(args) -> int:
    """Verify harvested AI-functions lines name only functions still in source."""
    root = args.root
    target_doc = getattr(args, "doc", None) or getattr(args, "path", None)
    if getattr(args, "all", False):
        target_doc = None
    violations = check_harvested_functions(root, target_doc)
    for v in violations:
        print(v, file=sys.stderr)
    if violations:
        print(f"harvested functions check: FAIL ({len(violations)} violation(s))", file=sys.stderr)
        return 1
    target_name = target_doc or "usr/share/doc/mios/manual/_harvest/*.md"
    print(f"harvested functions intact across {target_name}")
    return 0


def cmd_audit(args) -> int:
    root = args.root
    policy = _policy(root)
    try:
        refindex = mc.RefIndex.build(root) if args.stale else None
    except RuntimeError as e:
        print(f"audit --stale: {e}", file=sys.stderr)
        return 1
    by_class = collections.Counter()
    by_reason = collections.Counter()
    words = collections.Counter()
    stale_n = 0
    total = 0
    for b, v in _iter_blocks(root, policy, refindex):
        total += 1
        by_class[v.cls] += 1
        by_reason[v.reason] += 1
        words[v.cls] += b.words
        if v.stale:
            stale_n += 1
    report = {
        "blocks": total,
        "by_class": dict(by_class.most_common()),
        "by_reason": dict(by_reason.most_common()),
        "words_by_class": dict(words.most_common()),
        "stale": stale_n if refindex else None,
    }
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"comment blocks: {total}")
        for k, v in by_class.most_common():
            print(f"  {k:16s} {v:6d}  ({words[k]:,} words)")
        if refindex:
            print(f"  stale refs      {stale_n:6d}")
    return 0


FLOOR_REL = "usr/share/mios/reference/doc-ratchet-floor.tsv"
_RATCHET_KEYS = ("max_unmigrated_narrative", "max_stale_refs", "max_overlong_hints", "max_undocumented_components")


def read_floor(root: str) -> dict[str, int]:
    """The lowest ceiling ever recorded, per ratchet key."""
    out: dict[str, int] = {}
    path = os.path.join(root, FLOOR_REL.replace("/", os.sep))
    if not os.path.isfile(path):
        return out
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) == 2 and parts[1].strip().isdigit():
                out[parts[0].strip()] = int(parts[1])
    return out


def cmd_coverage(args) -> int:
    """The ratchet numbers, so the gate and a human read the same figures."""
    root = args.root
    policy = _policy(root)
    rows = _read_ledger(os.path.join(root, LEDGER_REL.replace("/", os.sep)))
    narrative = hints = 0
    for b, v in _iter_blocks(root, policy):
        row = rows.get(b.sha12)
        if row is not None and landed(row, root, policy):
            continue
        if v.cls == "MIGRATE":
            narrative += 1
        elif v.cls == "MIGRATE_HEADER":
            hints += 1
    out = {"unmigrated_narrative": narrative, "overlong_hints": hints}

    if getattr(args, "write_floor", False):
        # min(recorded, current ceiling): the mark only ever falls, so a ceiling
        # that was lowered once can never be quietly raised back to a prior
        # value even if history is rewritten or the HEAD comparison is skipped.
        with open(_ssot_path(root), "rb") as fh:
            data = tomllib.load(fh)
            docs = data.get("docs", {}) or {}
            ai_tag = data.get("ai_tag", {}) or {}
            merged = {**docs, **ai_tag}
        prior = read_floor(root)
        rows = []
        for k in _RATCHET_KEYS:
            if k not in merged:
                continue
            rows.append((k, min(int(merged[k]), prior.get(k, int(merged[k])))))
        dest = os.path.join(root, FLOOR_REL.replace("/", os.sep))
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "w", encoding="utf-8", newline="\n") as fh:
            fh.write("# ratchet_key\tlowest_ceiling_ever_recorded\n")
            for k, v in rows:
                fh.write(f"{k}\t{v}\n")
        print(f"wrote {FLOOR_REL}: " + ", ".join(f"{k}={v}" for k, v in rows))
        return 0

    if args.json:
        print(json.dumps(out))
    else:
        print(f"unmigrated narrative blocks: {narrative}")
        print(f"over-cap AI-hint headers:    {hints}")
    return 0


