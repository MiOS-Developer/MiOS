MARK_OPEN = "<!-- MIOS-GEN:{id} -->"
MARK_CLOSE = "<!-- /MIOS-GEN:{id} -->"
_MARK_RE = None


def _marker_re():
    global _MARK_RE
    if _MARK_RE is None:
        import re
        _MARK_RE = re.compile(
            r"(?P<open><!--\s*MIOS-GEN:(?P<id>[^\s>]+)\s*-->)"
            r"(?P<body>.*?)"
            r"(?P<close><!--\s*/MIOS-GEN:(?P=id)\s*-->)",
            re.S)
    return _MARK_RE


class DeriverError(ValueError):
    """A deriver was asked for something the SSOT does not define.

    Unknown deriver KINDS already failed the run; unknown ARGS silently fell
    back to rendering everything, so `ports:ai` quietly emitted the full table
    instead of saying the category does not exist.
    """


# The root the derivers read from. Their signature is (ssot, arg), so the
# render pass parks it here rather than threading it through every one.
_DERIVE_ROOT = [_ROOT_DEFAULT]


def _tracked(root: str, pattern: str = "") -> list[str]:
    """Repo-relative paths of tracked files, sorted.

    Tracked rather than walked, for the same reason the census is: an untracked
    scratch file must not change what the gate checks.
    """
    import subprocess
    args = ["git", "ls-files", "-z"] + ([pattern] if pattern else [])
    try:
        out = subprocess.run(args, cwd=root, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, check=True).stdout.decode("utf-8")
        paths = sorted(r for r in out.split("\0") if r)
    except Exception:
        return []
    if pattern:
        # Windows checkouts set core.ignorecase=true, so `git ls-files
        # usr/libexec/mios/mios-*` matched the then-CamelCase monitor there and
        # not on Linux (since renamed to mios-mon.py).
        # That made the generated index depend on which machine ran it, and CI
        # and the contributor took turns reverting each other. Re-filter in
        # Python, where the comparison is unambiguously byte-exact.
        import fnmatch
        paths = [r for r in paths if fnmatch.fnmatchcase(r, pattern)]
    return paths


def _tracked_markdown(root: str, extra: tuple = ()) -> list[str]:
    """Absolute paths of every git-tracked .md file, plus docs under usr/share/doc/mios."""
    rels = set(_tracked(root, "*.md"))
    doc_dir = os.path.join(root, "usr", "share", "doc", "mios")
    if os.path.isdir(doc_dir):
        for dp, dn, fns in os.walk(doc_dir):
            dn[:] = [d for d in dn if d != ".git"]
            for f in fns:
                if f.endswith(".md"):
                    rels.add(os.path.relpath(os.path.join(dp, f), root).replace(os.sep, "/"))
    for e in extra:
        if e not in rels and (_tracked(root, e) or os.path.isfile(os.path.join(root, e.replace("/", os.sep)))):
            rels.add(e)
    return sorted(os.path.join(root, r.replace("/", os.sep)) for r in rels)


def _derive_ports(ssot: dict, arg: str) -> str:
    cats = (ssot.get("ports", {}) or {}).get("categories", {}) or {}
    ports = ssot.get("ports", {}) or {}
    if arg and arg not in cats:
        raise DeriverError(f"ports: no such category '{arg}' in [ports.categories]")
    names = [arg] if arg else sorted(cats)
    out = ["| Category | Service | Port |", "|---|---|---|"]
    for cname in names:
        cat = cats[cname] or {}
        for m in cat.get("members", []) or []:
            if not m:      # reserved slot: holds an index, names no service
                continue
            out.append(f"| {cname} | {m} | {ports.get(m, '?')} |")
        for pin, val in (cat.get("pinned", {}) or {}).items():
            out.append(f"| {cname} | {pin} (pinned) | {val} |")
    out.append("")
    out.append("<!-- derived from usr/share/mios/mios.toml [ports.categories] -->")
    return "\n".join(out)


def _derive_laws(ssot: dict, arg: str) -> str:
    laws = (ssot.get("laws", {}) or {}).get("laws", []) or []
    out = ["| # | Law | Applies to | Enforced by |", "|---|---|---|---|"]
    for l in laws:
        out.append(f"| {l.get('id')} | {l.get('slug')} | {l.get('applies_to')} "
                   f"| `{l.get('enforced_by')}` |")
    out.append("")
    out.append("<!-- derived from usr/share/mios/mios.toml [laws].laws -->")
    return "\n".join(out)


def _derive_root_exceptions(ssot: dict, arg: str) -> str:
    """Law 6's sanctioned root Quadlets, so the exception list is never retyped."""
    sec = (ssot.get("security", {}) or {}).get("privileged_quadlets", {}) or {}
    rows = sec.get("root", []) or []
    out = ["| Quadlet | Runs as root because |", "|---|---|"]
    for entry in rows:
        if isinstance(entry, dict):
            out.append(f"| `{entry.get('unit', '?')}` | {entry.get('why', '')} |")
        else:
            out.append(f"| `{entry}` | see `[security.privileged_quadlets]` |")
    out.append("")
    out.append("<!-- derived from usr/share/mios/mios.toml "
               "[security.privileged_quadlets].root -->")
    return "\n".join(out)


def _derive_pipeline(ssot: dict, arg: str) -> str:
    """The numbered build phases -- the doc that goes stale fastest by hand."""
    phases = ((ssot.get("build", {}) or {}).get("phases", {}) or {}).get("list", []) or []
    out = ["| # | Phase | Script | Fatal | Applies |", "|---|---|---|---|---|"]
    for p in phases:
        out.append(f"| {p.get('ordinal', '?')} | {p.get('name', '')} "
                   f"| `{p.get('script', '')}` "
                   f"| {'yes' if p.get('fatal') else 'no'} "
                   f"| {p.get('apply_class', '')} |")
    out.append("")
    out.append(f"<!-- derived from usr/share/mios/mios.toml [build.phases].list "
               f"({len(phases)} phases) -->")
    return "\n".join(out)


def _derive_verbs(ssot: dict, arg: str) -> str:
    """The `mios <verb>` surface, straight from [verbs.*]."""
    verbs = ssot.get("verbs", {}) or {}
    if arg and arg not in verbs:
        raise DeriverError(f"verbs: no such verb '{arg}' in [verbs]")
    names = [arg] if arg else sorted(verbs)
    out = ["| Verb | Surface | Description |", "|---|---|---|"]
    for name in names:
        v = verbs.get(name) or {}
        if not isinstance(v, dict):
            continue
        out.append(f"| `mios {name}` | {v.get('surface', '')} "
                   f"| {v.get('description', '')} |")
    out.append("")
    out.append(f"<!-- derived from usr/share/mios/mios.toml [verbs] "
               f"({len(names)} verb(s)) -->")
    return "\n".join(out)


def _derive_boilerplate(ssot: dict, arg: str) -> str:
    """The framing paragraph every MiOS doc opens with.

    It was hand-copied into dozens of files, so the copies drifted. One SSOT
    string, spliced wherever it is wanted.
    """
    bp = (ssot.get("docs", {}) or {}).get("boilerplate", {}) or {}
    key = arg or "what-mios-is"
    text = bp.get(key)
    if not text:
        raise DeriverError(
            f"boilerplate: no '{key}' in [docs.boilerplate] "
            f"(have: {', '.join(sorted(bp)) or 'none'})")
    return text.strip() + "\n\n<!-- derived from usr/share/mios/mios.toml " \
                          f"[docs.boilerplate].{key} -->"


def _hint_index(root: str, pattern: str) -> list[tuple[str, str]]:
    """(path, AI-hint) for every tracked file matching a glob.

    The hint header is already the one-line description of what a file is for,
    written next to the file and kept honest by check_hint_coverage. Reading it
    back out is how a documentation index stops being a hand-kept list.
    """
    # fnmatchcase, not fnmatch: fnmatch normalises case on Windows, so
    # `usr/libexec/mios/mios-*` matched the then-CamelCase monitor there and
    # not on Linux (since renamed to mios-mon.py).
    # The index is a committed artifact -- when its content depends on which
    # machine regenerated it, CI and the contributor take turns reverting each
    # other and the gate reports a file rather than a cause.
    import fnmatch
    tagmod = mc.load_ai_tag(root)
    if tagmod is None:
        raise DeriverError("index: cannot load mios-ai-tag to read AI-hints")
    out = []
    for rel in _tracked(root):
        if not fnmatch.fnmatchcase(rel, pattern):
            continue
        full = os.path.join(root, rel.replace("/", os.sep))
        try:
            with open(full, encoding="utf-8", errors="replace") as fh:
                head = fh.read(4000)
        except OSError:
            continue
        hint = tagmod.existing_hint(head)
        if hint:
            out.append((rel, hint))
    return sorted(out)


def _derive_index(ssot: dict, arg: str) -> str:
    if not arg:
        raise DeriverError("index: needs a glob, e.g. index:usr/libexec/mios/mios-*")
    rows = _hint_index(_DERIVE_ROOT[0], arg)
    if not rows:
        raise DeriverError(f"index: no tracked file with an AI-hint matches '{arg}'")
    out = ["| File | What it is |", "|---|---|"]
    for rel, hint in rows:
        one = " ".join(hint.split())
        if len(one) > 200:
            one = one[:200].rsplit(" ", 1)[0] + "..."
        out.append(f"| `{rel}` | {one} |")
    out.append("")
    out.append(f"<!-- derived from the AI-hint headers of {len(rows)} file(s) "
               f"matching {arg} -->")
    return "\n".join(out)


def _derive_related(ssot: dict, arg: str) -> str:
    """The AI-related line of one file, as links."""
    if not arg:
        raise DeriverError("related: needs a path, e.g. related:usr/libexec/mios/mios-manual")
    full = os.path.join(_DERIVE_ROOT[0], arg.replace("/", os.sep))
    if not os.path.isfile(full):
        raise DeriverError(f"related: no such file '{arg}'")
    import re as _re
    with open(full, encoding="utf-8", errors="replace") as fh:
        head = fh.read(4000)
    m = _re.search(r"AI-related:\s*(.+?)\s*(?:-->)?\s*$", head, _re.I | _re.M)
    if not m:
        raise DeriverError(f"related: '{arg}' carries no AI-related header")
    items = [i.strip() for i in m.group(1).split(",") if i.strip()]
    out = [f"- `{i}`" for i in items]
    out.append("")
    out.append(f"<!-- derived from the AI-related header of {arg} -->")
    return "\n".join(out)


def _derive_units(ssot: dict, arg: str) -> str:
    """The systemd units shipped with MiOS, read directly from unit files."""
    root = _DERIVE_ROOT[0]
    unit_dirs = ["usr/lib/systemd/system", "usr/share/containers/systemd", "usr/lib/systemd/user"]
    units = []
    for udir in unit_dirs:
        full_dir = os.path.join(root, udir.replace("/", os.sep))
        if not os.path.isdir(full_dir):
            continue
        for fn in sorted(os.listdir(full_dir)):
            if fn.endswith((".service", ".timer", ".container", ".socket", ".target", ".path", ".mount", ".automount")):
                desc = "?"
                path = os.path.join(full_dir, fn)
                try:
                    with open(path, encoding="utf-8", errors="replace") as fh:
                        for line in fh:
                            line_s = line.strip()
                            if line_s.startswith("Description="):
                                desc = line_s.split("=", 1)[1].strip("'\"")
                                break
                except OSError:
                    pass
                units.append((fn, udir, desc))

    out = ["| Unit | Directory | Description |", "|---|---|---|"]
    for fn, udir, desc in sorted(units, key=lambda x: x[0]):
        out.append(f"| `{fn}` | `{udir}` | {desc} |")
    out.append("")
    out.append(f"<!-- derived from tracked unit files ({len(units)} unit(s)) -->")
    return "\n".join(out)


def _derive_events(ssot: dict, arg: str) -> str:
    """Observed event kinds from schema-init.sql and source files."""
    root = _DERIVE_ROOT[0]
    sql_path = os.path.join(root, "usr/share/mios/postgres/schema-init.sql")
    events = [
        ("config.changed", "Emitted when mios.toml or runtime configuration changes"),
        ("blade.role_applied", "Emitted when blade archetype role changes"),
        ("service.failover", "Emitted when workload placement failover triggers"),
        ("security.auth_posture", "Emitted when auth posture status changes"),
        ("agent.tool_call", "Emitted when an agent invokes a tool verb"),
        ("agent.memory_saved", "Emitted when an agent saves a fact to memory"),
    ]
    if os.path.isfile(sql_path):
        with open(sql_path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
        import re
        for m in re.finditer(r"['\"]([a-z0-9_\-\.:]+)['\"]\s*,\s*--\s*(.+)", text):
            events.append((m.group(1), m.group(2).strip()))
    out = ["| Event Kind | Description |", "|---|---|"]
    for kind, desc in sorted(set(events)):
        out.append(f"| `{kind}` | {desc} |")
    out.append("")
    out.append(f"<!-- derived from event schema definitions ({len(set(events))} event(s)) -->")
    return "\n".join(out)


def _derive_features(ssot: dict, arg: str) -> str:
    """Blade capabilities/features declared in SSOT mios.toml."""
    blade = ssot.get("blade") or {}
    archetypes = blade.get("archetypes") or {}
    features = {}
    for arch, caps in archetypes.items():
        if isinstance(caps, list):
            for c in caps:
                features.setdefault(c, []).append(arch)
        elif isinstance(caps, str):
            features.setdefault(caps, []).append(arch)

    out = ["| Capability / Feature | Granted by Archetypes |", "|---|---|"]
    for feat in sorted(features):
        archs = ", ".join(f"`{a}`" for a in sorted(features[feat]))
        out.append(f"| `{feat}` | {archs} |")
    out.append("")
    out.append(f"<!-- derived from [blade.archetypes] SSOT ({len(features)} feature(s)) -->")
    return "\n".join(out)


DERIVERS = {
    "ports": _derive_ports,
    "laws": _derive_laws,
    "root-exceptions": _derive_root_exceptions,
    "pipeline": _derive_pipeline,
    "verbs": _derive_verbs,
    "boilerplate": _derive_boilerplate,
    "index": _derive_index,
    "related": _derive_related,
    "units": _derive_units,
    "events": _derive_events,
    "features": _derive_features,
}


def _derive(gen_id: str, ssot: dict) -> str | None:
    kind, _, arg = gen_id.partition(":")
    fn = DERIVERS.get(kind)
    return None if fn is None else fn(ssot, arg)


def cmd_rehash(args) -> int:
    """Carry landings across a rewrite that changed only the ids in comment text.

    `mios-task migrate-ids` rewrites old task ids to typed ones in the comments and in the docs they landed in
    alike. A comment's hash changes with its text, so the ledger, which carries a landing by hash, would lose
    it and `distill` would land the prose a second time. Each changed source is lexed as it was at --from and
    as it is now, and the two block sequences are aligned on their text with every word that holds a digit
    masked (an old id and its typed id mask alike); an aligned pair is one comment, so its old hash moves to
    its new one in the ledger and in every mios-src marker of the docs. A hash two different comments would
    move to is left alone.
    """
    import difflib
    import subprocess
    root, rev = args.root, args.rev
    masked = re.compile(r"[a-z0-9_#.-]*[0-9][a-z0-9_#.-]*")
    git = lambda *a: subprocess.run(["git", "-C", root, *a], capture_output=True)
    diff = git("diff", "--name-only", "--no-renames", rev)
    if diff.returncode != 0:
        print(f"rehash: git diff against {rev} failed: {diff.stderr.decode(errors='replace').strip()}",
              file=sys.stderr)
        return 1
    changed = set(diff.stdout.decode().split())
    moves, clash = {}, set()
    for rel, full in mc.iter_source_files(root):
        if rel not in changed:
            continue
        old = git("show", f"{rev}:{rel}")
        if old.returncode != 0:
            continue
        try:
            before, after = mc.lex(full, raw=old.stdout), mc.lex(full)
        except Exception:
            continue
        key = lambda blocks: [masked.sub("#", x.norm) for x in blocks]
        sm = difflib.SequenceMatcher(None, key(before), key(after), autojunk=False)
        for tag, i1, i2, j1, j2 in sm.get_opcodes():
            if tag != "equal":
                continue
            for x, y in zip(before[i1:i2], after[j1:j2]):
                if y.sha12 != x.sha12 and moves.setdefault(x.sha12, y.sha12) != y.sha12:
                    clash.add(x.sha12)
    if _refuse_if_degraded():
        return 1
    for c in clash:
        moves.pop(c, None)
    dest = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    rows = list(_read_ledger(dest)._all)
    moved = 0
    for row in rows:
        new = moves.get(row["sha12"])
        if new:
            row["sha12"] = new
            moved += 1
    marker = re.compile(r"mios-src:([0-9a-f]{12})")
    docs = {}
    for rel in git("ls-files", "-z", "--", "*.md").stdout.decode().split("\0"):
        path = os.path.join(root, rel.replace("/", os.sep))
        if not rel or not os.path.isfile(path):
            continue
        with open(path, encoding="utf-8", newline="") as fh:
            text = fh.read()
        new = marker.sub(lambda m: "mios-src:" + moves.get(m.group(1), m.group(1)), text)
        if new != text:
            docs[path] = new
    if args.dry_run:
        print(f"rehash: {len(moves)} hash(es) would move: {moved} ledger row(s), {len(docs)} doc(s) (dry run)")
        return 0
    for path, text in docs.items():
        with open(path, "w", encoding="utf-8", newline="") as fh:
            fh.write(text)
    body = ["# " + "\t".join(COLUMNS)] + ["\t".join(r[c] for c in COLUMNS) for r in rows]
    with open(dest, "w", encoding="utf-8", newline="\n") as fh:
        fh.write("\n".join(body) + "\n")
    print(f"rehash: {len(moves)} hash(es) moved: {moved} ledger row(s), {len(docs)} doc(s); "
          f"{len(clash)} ambiguous hash(es) left alone")
    return 0


def cmd_render(args) -> int:
    """Splice derived content into marker pairs. Writes NOWHERE else.

    The whole safety story of the doc model is that regeneration cannot destroy
    hand-written prose. That holds only because this function's sole write is
    replacing the interior of a matched MIOS-GEN pair -- there is deliberately no
    code path that emits a whole file, so an authored paragraph outside a marker
    is untouchable even if a deriver misbehaves.
    """
    root = args.root
    if tomllib is None:
        print("tomllib unavailable", file=sys.stderr)
        return 1
    with open(_ssot_path(root), "rb") as fh:
        ssot = tomllib.load(fh)
    _DERIVE_ROOT[0] = root

    # Scope: every TRACKED Markdown file, not just usr/share/doc/mios -- a
    # marker in README.md or docs/ was previously never rendered or checked, so
    # a stale derived table could ship from there. Note this cannot reuse
    # mios_comments.iter_source_files: that filters by SCAN_EXT, which
    # deliberately excludes .md, and using it here silently emptied the scope.
    # Only files that actually contain a marker are opened for writing.
    targets = _tracked_markdown(
        root, tuple((ssot.get("docs", {}) or {}).get("render_extra", ())))

    rx = _marker_re()
    changed, spliced, unknown, bad_args = [], 0, set(), []
    for path in sorted(targets):
        try:
            with open(path, encoding="utf-8", newline="") as fh:
                src = fh.read()
        except OSError:
            continue
        if "MIOS-GEN:" not in src:
            continue
        rel_for_msg = os.path.relpath(path, root).replace(os.sep, "/")

        def repl(m):
            nonlocal spliced
            gid = m.group("id")
            try:
                body = _derive(gid, ssot)
            except DeriverError as exc:
                bad_args.append(f"{rel_for_msg}: {exc}")
                return m.group(0)
            if body is None:
                unknown.add(gid)
                return m.group(0)
            spliced += 1
            return f"{m.group('open')}\n{body}\n{m.group('close')}"

        new = rx.sub(repl, src)
        if new != src:
            changed.append(os.path.relpath(path, root).replace(os.sep, "/"))
            if not args.check:
                with open(path, "w", encoding="utf-8", newline="\n") as fh:
                    fh.write(new)

    if bad_args:
        print("MIOS-GEN markers asking for values the SSOT does not define:",
              file=sys.stderr)
        for msg in bad_args:
            print(f"  {msg}", file=sys.stderr)
        return 1
    if unknown:
        print("unknown MIOS-GEN ids (no deriver): " + ", ".join(sorted(unknown)),
              file=sys.stderr)
        return 1
    if args.check:
        if changed:
            print("derived sections are stale -- run `mios-manual render`:\n  "
                  + "\n  ".join(changed), file=sys.stderr)
            return 1
        print(f"derived sections up to date ({spliced} markers)")
        return 0
    print(f"rendered {spliced} marker(s); {len(changed)} file(s) updated")
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="mios-manual", description=__doc__.splitlines()[0])
    ap.add_argument("--root", default=os.environ.get("MIOS_ROOT") or _ROOT_DEFAULT)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("ledger", help="rebuild or verify the corpus ledger")
    p.add_argument("--write", action="store_true")
    p.add_argument("--check", action="store_true")
    p.set_defaults(fn=cmd_ledger)

    p = sub.add_parser("audit", help="census of the comment corpus")
    p.add_argument("--json", action="store_true")
    p.add_argument("--stale", action="store_true", help="also resolve references (slow)")
    p.set_defaults(fn=cmd_audit)

    p = sub.add_parser("coverage", help="the two ratchet numbers")
    p.add_argument("--json", action="store_true")
    p.add_argument("--write-floor", action="store_true",
                   help="record the lowest ceiling ever seen")
    p.set_defaults(fn=cmd_coverage)

    p = sub.add_parser("harvest", help="move a source comment's prose into a doc")
    p.add_argument("--path", help="source file, repo-relative")
    p.add_argument("--to", help="destination doc, repo-relative")
    p.add_argument("--class", dest="class_name", help="harvest all blocks of this class (e.g. overlong-hint)")
    p.add_argument("--block", help="only this sha12 (prefix ok)")
    p.add_argument("--apply", action="store_true", help="execute changes")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--refresh", action="store_true", help="refresh existing harvested passages from current source")
    p.add_argument("--doc", help="destination doc to refresh (e.g. usr/share/doc/mios/manual/_harvest/mios.md)")
    p.add_argument("--check", action="store_true", help="verify harvested AI-functions lines against source")
    p.set_defaults(fn=cmd_harvest)

    p = sub.add_parser("check-functions", help="verify harvested AI-functions lines against source")
    p.add_argument("--doc", help="destination doc to check (repo-relative, defaults to _harvest/mios.md)")
    p.add_argument("--path", help="alias for --doc")
    p.add_argument("--all", action="store_true", help="check all documents under _harvest/")
    p.set_defaults(fn=cmd_check_functions)

    p = sub.add_parser("distill", help="Day-N+1: scrape, sanitize and distil comments into the manual")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_distill)

    p = sub.add_parser("prune", help="delete a comment that provably landed in a doc")
    p.add_argument("--path", help="source file, repo-relative")
    p.add_argument("--class", dest="class_name", help="prune all blocks of this class (e.g. overlong-hint)")
    p.add_argument("--only-landed", action="store_true", help="only prune blocks that pass landed()")
    p.add_argument("--block", help="only this sha12 (prefix ok)")
    p.add_argument("--apply", action="store_true", help="execute changes")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_prune)

    p = sub.add_parser("landing", help="verify every pruned block still lands in a doc")
    p.add_argument("--check", action="store_true")
    p.set_defaults(fn=cmd_landing)

    p = sub.add_parser("rehash", help="carry landings across an in-place comment rewrite")
    p.add_argument("--from", dest="rev", default="HEAD", help="the revision before the rewrite")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_rehash)

    p = sub.add_parser("render", help="splice derived sections into MIOS-GEN markers")
    p.add_argument("--check", action="store_true",
                   help="fail if any derived section is stale; write nothing")
    p.set_defaults(fn=cmd_render)

    args = ap.parse_args(argv)
    if args.cmd == "ledger" and not (args.write or args.check):
        args.write = True
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
