#!/bin/bash
# AI-hint: Resolves and launches a URL in the MiOS-defined default browser or a specified override by resolving mios.toml entries and dispatching via mios-gui to the operator's WSLg desktop session.
# AI-related: /usr/libexec/mios/mios-open-url, /etc/mios/mios.toml, /usr/share/mios/mios.toml, mios-gui, mios-find, mios-window-active, mios-as-operator, mios-wsl-flatpak-heal
# AI-functions: _resolve_browser_chain, _parse_summary, _derive_verify_pattern
set -euo pipefail

if [ "$#" -lt 1 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'USAGE'
usage: mios-open-url <url> [<browser-override>]

  <url>               http:// https:// file:// chrome:// about: ...
  <browser-override>  optional: any [[desktop.apps]] entry id OR alias.
                      Without this, the MiOS-defined default browser
                      from mios.toml is used.

Opens the URL in the MiOS-defined default browser. The actual app
is resolved at run time from mios.toml -- operators rename their
default by editing one entry in mios.html / mios.toml.

Forms (every token in <ANGLES> is operator-substituted):
  mios-open-url <url>                   open in MiOS default browser
  mios-open-url <url> <browser-id>      open in a specific browser
USAGE
    [ "$#" -lt 1 ] && exit 64 || exit 0
fi

URL=""
OVERRIDE=""
MODE="tab"
PRIVATE=0
REUSE=1
PROFILE=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --mode)    MODE="${2:-tab}"; shift $(( $# >= 2 ? 2 : 1 )) ;;
        --browser) OVERRIDE="${2:-}"; shift $(( $# >= 2 ? 2 : 1 )) ;;
        --private) case "$(printf '%s' "${2:-true}" | tr '[:upper:]' '[:lower:]')" in false|0|no|off) PRIVATE=0 ;; *) PRIVATE=1 ;; esac; shift $(( $# >= 2 ? 2 : 1 )) ;;
        --reuse)   case "$(printf '%s' "${2:-true}" | tr '[:upper:]' '[:lower:]')" in false|0|no|off) REUSE=0 ;; *) REUSE=1 ;; esac; shift $(( $# >= 2 ? 2 : 1 )) ;;
        # Accepted for CLI compatibility but NOT wired to any launcher: it was
        # parsed into a variable nothing read, so it silently did nothing.
        --profile) PROFILE="${2:-}"
                   [ -z "$PROFILE" ] || printf 'mios-open-url: --profile %s is not implemented; ignoring\n' "$PROFILE" >&2
                   shift $(( $# >= 2 ? 2 : 1 )) ;;
        --)        shift ;;
        *)         if [ -z "$URL" ]; then URL="$1"; elif [ -z "$OVERRIDE" ]; then OVERRIDE="$1"; fi; shift ;;
    esac
done
[ -n "$URL" ] || { echo "Mios-open-url: missing <url>" >&2; exit 64; }
EFF_MODE="$MODE"
if [ "$PRIVATE" = 1 ]; then EFF_MODE="private"; fi
if [ "$REUSE" = 0 ] && [ "$EFF_MODE" = "tab" ]; then EFF_MODE="new-window"; fi
case "$(printf '%s' "$OVERRIDE" | tr '[:upper:]' '[:lower:]' | tr -d ' ')" in
    default|operatordefault|systemdefault|system|none) OVERRIDE="" ;;
esac

case "$URL" in
    http://*|https://*|file://*|about:*|chrome://*) : ;;
    *)
        echo "[mios-open-url] WARN: '$URL' doesn't look like a URL; passing as-is" >&2
        ;;
esac

_resolve_browser_chain() {
    if command -v mios-app-type >/dev/null 2>&1; then
        _lead="$(mios-app-type "browser" 2>/dev/null || true)"
        [ -n "$_lead" ] && echo "$_lead"
    fi
    python3 - "$(cd "$(dirname "$0")" && pwd)/../../lib/mios" <<'PYEOF' 2>/dev/null
import os
import sys
sys.path.insert(0, sys.argv[1]); import mios_toml  # the ONE shared layered resolver
chain = []
seen = set()

# 1. Environment variable override (e.g. projected from userenv.sh / dotfiles)
env_browser = os.environ.get("MIOS_BROWSER")
if env_browser and env_browser not in seen:
    chain.append(env_browser)
    seen.add(env_browser)

d = mios_toml.load_merged()

# 2. SSOT default browser: [aliases].browser from mios.toml / mios.html
val = d.get("aliases", {}).get("browser")
if isinstance(val, str) and val and val not in seen:
    chain.append(val)
    seen.add(val)

# 3. [browser].default
br_default = d.get("browser", {}).get("default")
if isinstance(br_default, str) and br_default and br_default not in seen:
    chain.append(br_default)
    seen.add(br_default)

# 4. [desktop.apps] role="browser" default=true first, then others
apps = mios_toml.section(d, "desktop").get("apps", [])
if isinstance(apps, list):
    for entry in apps:
        if not isinstance(entry, dict) or entry.get("role") != "browser":
            continue
        aid = entry.get("id")
        if aid and aid not in seen and entry.get("default"):
            chain.append(aid)
            seen.add(aid)
    for entry in apps:
        if not isinstance(entry, dict) or entry.get("role") != "browser":
            continue
        aid = entry.get("id")
        if aid and aid not in seen:
            chain.append(aid)
            seen.add(aid)

# 5. [mios-find].aliases.web
mf_aliases = mios_toml.section(d, "mios-find").get("aliases", {})
web = mf_aliases.get("web") if isinstance(mf_aliases, dict) else None
if isinstance(web, str) and web and web not in seen:
    chain.append(web)
    seen.add(web)

# 6. WSL2 / Windows host interop fallback: ensure cmd.exe is in the chain
if os.path.exists("/proc/sys/fs/binfmt_misc/WSLInterop") or os.environ.get("WSL_DISTRO_NAME") or os.path.exists("/mnt/c/Windows/System32/cmd.exe"):
    for win_h in ("cmd.exe", "explorer.exe"):
        if win_h not in seen:
            chain.append(win_h)
            seen.add(win_h)

print("\n".join(chain))
PYEOF
}

_browser_flag() {
    local target="$1"
    local mode="${2:-tab}"
    local mb=""
    if command -v mios-browser >/dev/null 2>&1; then
        mb="mios-browser"
    elif [ -x "/usr/bin/mios-browser" ]; then
        mb="/usr/bin/mios-browser"
    elif [ -x "$(dirname "$0")/../../tools/native/target/release/mios-browser" ]; then
        mb="$(dirname "$0")/../../tools/native/target/release/mios-browser"
    elif [ -x "$(dirname "$0")/mios-browser" ]; then
        mb="$(dirname "$0")/mios-browser"
    fi
    if [ -n "$mb" ]; then
        "$mb" --browser "$target" --mode "$mode" --explain 2>/dev/null | awk -F': *' '/^Flags:/{print $2}'
        return
    fi
    python3 - "$(cd "$(dirname "$0")" && pwd)/../../lib/mios" "$1" "$2" <<'PYEOF' 2>/dev/null || true
import sys
sys.path.insert(0, sys.argv[1]); import mios_toml  # the ONE shared layered resolver
target = (sys.argv[2] or "").lower()
mode = sys.argv[3] or "tab"
br = mios_toml.section(mios_toml.load_merged(), "browser")
fam_map = br.get("family", {}) or {}
flags = br.get("flags", {}) or {}
fam = ""
for name, subs in fam_map.items():
    if isinstance(subs, list) and any(isinstance(s, str) and s.lower() in target for s in subs):
        fam = name
        break
if fam and isinstance(flags.get(fam), dict):
    print((flags[fam].get(mode) or "").strip())
PYEOF
}

if [ -n "$OVERRIDE" ]; then
    CHAIN="$OVERRIDE"
else
    CHAIN="$(_resolve_browser_chain)"
    if [ -z "$CHAIN" ]; then
        cat >&2 <<ERR
mios-open-url: no browser defined in mios.toml.

Set one by editing mios.html (or directly):
  /usr/share/mios/mios.toml      (vendor; immutable on bootc hosts)
  /etc/mios/mios.toml            (host override)
  ~/.config/mios/mios.toml       (per-user override)

Add at least one:
  [[desktop.apps]]
  id      = "<your-browser-app-id>"
  role    = "browser"
  default = true     # leads the chain

After editing, re-run mios-open-url.
ERR
        exit 78    # EX_CONFIG -- configuration error
    fi
fi

set +e   # the verification path catches its own rcs; set -e here

_LAST_TARGET=""
_LAST_RC=0
while IFS= read -r TARGET; do
    [ -z "$TARGET" ] && continue
    _target_path="$(command -v "$TARGET" 2>/dev/null || true)"
    if [ -n "$_target_path" ] && [ "$(readlink -f "$_target_path")" = "$(readlink -f "$0")" ]; then
        echo "[mios-open-url] refusing recursive browser handler" >&2
        continue
    fi
    echo "[mios-open-url] trying browser: $TARGET" >&2
    read -r -a _FLAGS <<< "$(_browser_flag "$TARGET" "$EFF_MODE")"

    _already_running=0
    _seg="$(printf '%s' "$TARGET" | sed 's/.*\.//')"
    if [ "$EFF_MODE" = "tab" ]; then
        if pgrep -fi "$TARGET" >/dev/null 2>&1 \
           || { [ -n "$_seg" ] && pgrep -fi "$_seg" >/dev/null 2>&1; }; then
            _already_running=1
        elif command -v mios-windows >/dev/null 2>&1; then
            _win_proc="$(basename "$TARGET" | sed 's/\.exe$//I')"
            if mios-windows ps "Get-Process -Name $_win_proc -ErrorAction SilentlyContinue" >/dev/null 2>&1; then
                _already_running=1
            fi
        fi
    fi

    if [ "$_already_running" = "1" ] && { echo "$TARGET" | grep -qiE 'chrome|chromium'; }; then
        _cdp_port="${CDP_PORT:-${MIOS_PORTS_CHROME_CDP:-9222}}"
        if curl -fsS -m 2 "http://127.0.0.1:${_cdp_port}/json/version" >/dev/null 2>&1; then
            echo "[mios-open-url] browser $TARGET is already running with CDP -> opening tab via CDP" >&2
            if /usr/lib/mios/agents/.venv/bin/python3 - "$_cdp_port" "$URL" <<'PYEOF' 2>/dev/null; then
import sys
import json
import urllib.request
import urllib.parse
import asyncio

async def cdp_create_tab(port, url):
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{port}/json/new?{urllib.parse.quote(url)}", method="PUT")
        with urllib.request.urlopen(req, timeout=5) as r:
            created = json.loads(r.read().decode())
            return bool(created.get("id")) and created.get("url") == url
    except Exception:
        pass
    try:
        import websockets
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=5) as r:
            version_data = json.loads(r.read().decode())
        ws_url = version_data.get("webSocketDebuggerUrl")
        if not ws_url:
            return False
        async with websockets.connect(ws_url, open_timeout=5) as ws:
            mid = 1
            await ws.send(json.dumps({
                "id": mid,
                "method": "Target.createTarget",
                "params": {"url": url}
            }))
            raw = await asyncio.wait_for(ws.recv(), timeout=5)
            resp = json.loads(raw)
            target_id = (resp.get("result") or {}).get("targetId")
            if resp.get("id") == mid and target_id:
                await ws.send(json.dumps({"id": 2, "method": "Target.getTargetInfo",
                                          "params": {"targetId": target_id}}))
                observed = json.loads(await asyncio.wait_for(ws.recv(), timeout=5))
                info = (observed.get("result") or {}).get("targetInfo") or {}
                return (observed.get("id") == 2 and info.get("targetId") == target_id
                        and info.get("url") == url)
    except Exception:
        pass
    return False

if __name__ == "__main__":
    port = int(sys.argv[1])
    url = sys.argv[2]
    success = asyncio.run(cdp_create_tab(port, url))
    sys.exit(0 if success else 1)
PYEOF
                python3 -c 'import json,sys; print(json.dumps({
                    "success": True, "target": sys.argv[1], "url": sys.argv[2],
                    "summary": "tab-opened-cdp", "engine": "cdp",
                    "navigation_verified": True, "verified_by": "cdp-target-url", "launch_rc": 0}))' "$TARGET" "$URL"
                exit 0
            fi
        fi
    fi

        _cmd_bin="$(command -v cmd.exe 2>/dev/null || true)"
        [ -n "$_cmd_bin" ] || [ ! -x "/mnt/c/Windows/System32/cmd.exe" ] || _cmd_bin="/mnt/c/Windows/System32/cmd.exe"
        if [ "$TARGET" = "cmd.exe" ] || [ "$TARGET" = "explorer.exe" ]; then
            WIN_URL=$(wslpath -w "$URL" 2>/dev/null || echo "$URL")
            echo "[mios-open-url] trying Windows handler: $TARGET '$WIN_URL'" >&2
            if [ -n "$_cmd_bin" ]; then
                "$_cmd_bin" /c start "" "$WIN_URL" < /dev/null > /dev/null 2>&1 &
                _launch_rc=$?
                _used_windows_fallback=1
            else
                _launch_rc=127
            fi
        else
            mios-gui "$TARGET" "${_FLAGS[@]}" "$URL"
            _launch_rc=$?
            _used_windows_fallback=0
            if [ "$_launch_rc" -ne 0 ]; then
                echo "[mios-open-url] mios-gui $TARGET failed; trying Windows fallback via host handler" >&2
                if [ -n "$_cmd_bin" ]; then
                    WIN_URL=$(wslpath -w "$URL" 2>/dev/null || echo "$URL")
                    "$_cmd_bin" /c start "" "$WIN_URL" < /dev/null > /dev/null 2>&1 &
                    _launch_rc=$?
                    _used_windows_fallback=1
                elif command -v mios-windows >/dev/null 2>&1; then
                    if mios-windows cmd "start \"\" \"$URL\"" >/dev/null 2>&1; then
                        _launch_rc=0
                        _used_windows_fallback=1
                    fi
                fi
            fi
        fi

    _LAST_TARGET="$TARGET"
    _LAST_RC="$_launch_rc"
    if [ "$_launch_rc" = "0" ] || [ "$_launch_rc" = "3" ]; then
        # A dispatched command, a live PID, or a presented browser window does
        # not establish which URL its tab contains. Keep this outcome explicit
        # until a browser protocol or accessibility observer verifies navigation.
        python3 -c 'import json,sys; print(json.dumps({
            "success": False, "target": sys.argv[1], "url": sys.argv[2],
            "summary": "navigation-unverified", "launch_rc": int(sys.argv[3]),
            "navigation_verified": False,
            "error": {"code": "navigation_unverified",
                      "message": "Browser dispatch has no observed URL confirmation"}}))' "$TARGET" "$URL" "$_launch_rc"
        exit 3
    fi
done <<EOF
$CHAIN
EOF

echo "[mios-open-url] EXHAUSTED chain; last=$_LAST_TARGET launch_rc=$_LAST_RC" >&2
exit 2
