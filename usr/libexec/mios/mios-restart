#!/bin/sh
# AI-hint: Executes smart restarts for MiOS services, handling specific logic for Podman Quadlets (systemctl-based), standard systemd units, and hermes-agent soft restarts to clear in-process skill caches.
# AI-related: /usr/libexec/mios/mios-restart, /usr/share/mios/hermes/skills/, /usr/share/mios/hermes/skills, /usr/share/mios/hermes/skills/., /usr/share/mios/ai/hermes-soul.md, mios-open-webui, mios-searxng, mios-forge, mios-forgejo-runner
# AI-functions: usage

set -eu

usage() {
    echo "Usage: mios-restart <service>"
    echo
    echo "Shortcuts:"
    echo "  hermes              -> mios-agent-pipe.service"
    echo "  llm-light           -> mios-llm-light.service"
    echo "  pgvector            -> mios-pgvector.service"
    echo "  open-webui          -> mios-open-webui.service"
    echo "  searxng             -> mios-searxng.service"
    echo "  forge               -> mios-forge.service"
    echo "  forge-runner        -> mios-forgejo-runner.service"
    echo "  code-server         -> mios-agents.service"
    echo
    echo "Or pass a full unit name"
}

if [ "$#" -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

SVC="$1"

case "$SVC" in
    hermes|hermes-agent|gateway-agent)  UNIT="mios-agent-pipe.service" ;;
    llm-light|llmlight)             UNIT="mios-llm-light.service" ;;
    pgvector|postgres)              UNIT="mios-pgvector.service" ;;
    open-webui|owui|webui)          UNIT="mios-open-webui.service" ;;
    searxng|search)                 UNIT="mios-searxng.service" ;;
    forge|forgejo)                  UNIT="mios-forge.service" ;;
    forge-runner|forgejo-runner)    UNIT="mios-forgejo-runner.service" ;;
    code-server|codeserver|code|agents)    UNIT="mios-agents.service" ;;
    crowdsec)                       UNIT="mios-crowdsec.service" ;;
    k3s)                            UNIT="mios-k3s.service" ;;
    *)
        case "$SVC" in
            *.service|*.target|*.socket) UNIT="$SVC" ;;
            *) UNIT="${SVC}.service" ;;
        esac
        ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    if ! sudo -n true 2>/dev/null; then
        echo "Mios-restart: need root" >&2
        exit 1
    fi
    SUDO="sudo -n"
else
    SUDO=""
fi

if [ "$UNIT" = "mios-agent-pipe.service" ]; then
    if [ -d /usr/share/mios/hermes/skills ]; then
        for _target in \
            "/var/lib/mios/hermes/skills:mios-hermes:mios-hermes" \
            "/var/home/mios/.hermes/skills:mios:mios" \
            "/home/mios/.hermes/skills:mios:mios"
        do
            _dest="${_target%%:*}"
            _rest="${_target#*:}"
            _own="${_rest%%:*}"
            _grp="${_rest#*:}"
            _parent="${_dest%/skills}"
            [ -d "$_parent" ] || continue
            $SUDO mkdir -p "$_dest"
            $SUDO chown "$_own:$_grp" "$_dest" 2>/dev/null || true
            if command -v rsync >/dev/null 2>&1; then
                $SUDO rsync -au --chown="$_own:$_grp" \
                    /usr/share/mios/hermes/skills/ "$_dest/" 2>/dev/null || true
            else
                $SUDO cp -au /usr/share/mios/hermes/skills/. "$_dest/" 2>/dev/null || true
                $SUDO chown -R "$_own:$_grp" "$_dest" 2>/dev/null || true
            fi
        done
        echo "  hermes: re-synced vendor skills into HERMES_HOME"
    fi

    SOUL_SRC=/usr/share/mios/ai/hermes-soul.md
    if [ -f "$SOUL_SRC" ]; then
        for _entry in \
            "/var/lib/mios/hermes/SOUL.md:mios-hermes:mios-hermes" \
            "/var/home/mios/.hermes/SOUL.md:mios:mios" \
            "/home/mios/.hermes/SOUL.md:mios:mios"
        do
            _dest="${_entry%%:*}"
            _rest="${_entry#*:}"
            _own="${_rest%%:*}"
            _grp="${_rest#*:}"
            _parent_dir=$(dirname "$_dest")
            [ -d "$_parent_dir" ] || continue
            if [ -f "$_dest" ] && ! grep -q "MiOS-managed:" "$_dest" 2>/dev/null; then
                continue
            fi
            $SUDO install -m 0644 -o "$_own" -g "$_grp" "$SOUL_SRC" "$_dest" 2>/dev/null || true
        done
        echo "  hermes: re-synced vendor SOUL.md into HERMES_HOME + operator CLI"
    fi
fi

echo "── restarting $UNIT ──"
$SUDO systemctl restart "$UNIT"
_poll_start="$(date +%s)"
state="$($SUDO systemctl is-active "$UNIT" 2>&1 || true)"
for _ in $(seq 1 30); do
    case "$state" in
        active|failed|inactive) break ;;
    esac
    sleep 1
    state="$($SUDO systemctl is-active "$UNIT" 2>&1 || true)"
done
echo "  state: $state - _poll_start ))s)"

if [ "$UNIT" = "mios-agent-pipe.service" ]; then
    for d in /var/lib/mios/hermes /home/mios/.hermes /var/home/mios/.hermes; do
        [ -d "$d" ] || continue
        find "$d" -name '.skills_prompt_snapshot.json' -delete 2>/dev/null || true
    done
    echo "  hermes: dropped skills-prompt cache snapshots"
fi

echo
echo "── last 8 lines of journal ──"
$SUDO journalctl -u "$UNIT" --no-pager --no-hostname -n 8 2>&1 | tail -8
