#!/bin/bash
# AI-hint: Non-interactive wrapper for `flatpak install` that forces `--noninteractive` and `--from` flags to prevent agent hangs, while ensuring new apps inherit MiOS system-wide XDG override policies.
# AI-related: /usr/libexec/mios/mios-flatpak-install, /etc/mios/mios.toml, /usr/share/mios/mios.toml, /usr/libexec/mios/mios-flatpak-init, mios-flatpak-init
# AI-functions: _resolve_remote_for
set -euo pipefail
set -eu

if [ "$(id -u)" -eq 0 ]; then
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ "$(stat -c %u "$XDG_RUNTIME_DIR" 2>/dev/null)" != "0" ]; then
        unset XDG_RUNTIME_DIR
        if [ -d /run/user/0 ]; then
            export XDG_RUNTIME_DIR=/run/user/0
        fi
    fi
fi

if [ "$#" -lt 1 ]; then
    cat <<'USAGE' >&2
usage: mios-flatpak-install <flatpak-id> [<flatpak-id> ...]
       MIOS_FLATPAK_REMOTE=<remote> mios-flatpak-install <id>

Installs system-wide from the named remote (default flathub),
non-interactively. Inherits MiOS's XDG-grant override policy.

Examples:
  mios-flatpak-install org.gnome.gedit
  mios-flatpak-install org.gnome.Calendar org.gnome.Calculator
USAGE
    exit 64
fi

_MIOS_TOML_GET="$(cd "$(dirname "$0")" && pwd)/mios-toml-get"
_default_remote=$("$_MIOS_TOML_GET" flatpak default_remote flathub 2>/dev/null)
_default_remote="${_default_remote:-flathub}"
_prefer_beta=$("$_MIOS_TOML_GET" flatpak prefer_beta false 2>/dev/null)
_prefer_beta="${_prefer_beta:-false}"

_resolve_remote_for() {
    local _id="$1"
    if [ "${_id#*:}" != "$_id" ]; then
        echo "${_id%%:*}"
        return
    fi
    if [ -n "${MIOS_FLATPAK_REMOTE:-}" ]; then
        echo "$MIOS_FLATPAK_REMOTE"
        return
    fi
    if [ "$_prefer_beta" = "true" ] && flatpak remotes 2>/dev/null | grep -q "^flathub-beta"; then
        if flatpak remote-info flathub-beta "$_id" >/dev/null 2>&1; then
            echo "flathub-beta"
            return
        fi
    fi
    echo "$_default_remote"
}

if [ -x /usr/libexec/mios/mios-flatpak-init ]; then
    /usr/libexec/mios/mios-flatpak-init >/dev/null 2>&1 || true
fi

SUDO=()
if [ "$(id -u)" -ne 0 ]; then
    SUDO=(sudo -n)
fi

_default_branch="${MIOS_FLATPAK_DEFAULT_BRANCH:-24.08}"

failed=0
for id in "$@"; do
    _id_remote=$(_resolve_remote_for "$id")
    if [ "${id#*:}" != "$id" ]; then
        id="${id#*:}"
    fi
    echo "[mios-flatpak-install] installing $id from $_id_remote"
    _tmp="$(mktemp -t mios-fp-inst-XXXXXX)"
    _rc=0
    "${SUDO[@]}" flatpak install \
            --system --noninteractive --assumeyes \
            "$_id_remote" "$id" 2>&1 | tee "$_tmp" || _rc=${PIPESTATUS[0]}
    _out="$(cat "$_tmp")"
    rm -f "$_tmp"
    if [ "$_rc" -ne 0 ] && [ "${id#*//}" = "$id" ] \
            && printf '%s' "$_out" | grep -qiE 'multiple refs|must specify.*branch|multiple branches'; then
        echo "[mios-flatpak-install] ambiguous branch for $id"
        _tmp="$(mktemp -t mios-fp-inst-XXXXXX)"
        _rc=0
        "${SUDO[@]}" flatpak install \
                --system --noninteractive --assumeyes \
                "$_id_remote" "${id}//${_default_branch}" 2>&1 | tee "$_tmp" || _rc=${PIPESTATUS[0]}
        _out="$(cat "$_tmp")"
        rm -f "$_tmp"
    fi
    if [ "$_rc" -eq 0 ]; then
        echo "[mios-flatpak-install] ✓ $id installed"
    else
        echo "[mios-flatpak-install] ✗ $id failed"
        failed=$((failed + 1))
    fi
done

if [ "$failed" -ne 0 ]; then
    echo "[mios-flatpak-install] ${failed}/$# install failed" >&2
    exit 1
fi
exit 0
