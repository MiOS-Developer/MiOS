            _PS="$(_build_uri_center_ps "Start-Process -FilePath explorer.exe -ArgumentList '$_saf'" "${MIOS_LAUNCH_TITLE_HINT:-$app}")"
            exec "$0" ps "$_PS"
        elif [ -e "/mnt/c/Windows/System32/${app}" ]; then
