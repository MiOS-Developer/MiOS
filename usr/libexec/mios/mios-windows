function Get-MiosVisibleWindows {
    \$script:_wl = @()
    \$cb = [MiosLW+EnumWindowsProc]{
        param(\$h, \$l)
        if ([MiosLW]::IsWindowVisible(\$h)) {
            \$len = [MiosLW]::GetWindowTextLength(\$h)
            \$sb = New-Object System.Text.StringBuilder (\$len + 1)
            [MiosLW]::GetWindowText(\$h, \$sb, \$sb.Capacity) | Out-Null
            \$wpid = 0
            [MiosLW]::GetWindowThreadProcessId(\$h, [ref]\$wpid) | Out-Null
            \$pname = ""
            try { \$pname = (Get-Process -Id \$wpid -ErrorAction SilentlyContinue).ProcessName } catch {}
            if (\$len -gt 0 -or (\$pname -and \$hint -ne '' -and \$pname -match [regex]::Escape(\$hint))) {
                \$script:_wl += [pscustomobject]@{ hwnd = [int64]\$h; pid = [int64]\$wpid; proc = \$pname; title = \$sb.ToString() }
            }
        }
        return \$true
    }
    [MiosLW]::EnumWindows(\$cb, [IntPtr]::Zero) | Out-Null
    return \$script:_wl
}
\$hint = '${hint}'
\$preRows = Get-MiosVisibleWindows
\$pre = @(\$preRows | ForEach-Object { \$_.hwnd })
${sp}
