\$targetHwnd = [IntPtr]::Zero
\$targetTitle = ''
while ((Get-Date) -lt \$deadline) {
    \$allWins = Get-MiosVisibleWindows
    if (\$hint -ne '') {
        \$m = \$allWins | Where-Object { (\$_.title -and \$_.title -match [regex]::Escape(\$hint)) -or (\$_.proc -and \$_.proc -match [regex]::Escape(\$hint)) } | Select-Object -First 1
    } else {
        \$m = \$null
    }
    if (-not \$m) {
        \$newRows = \$allWins | Where-Object { \$pre -notcontains \$_.hwnd }
        \$m = \$newRows | Select-Object -First 1
    }
    if (\$m) { \$targetHwnd = [IntPtr][int64]\$m.hwnd; \$targetTitle = \$m.title; break }
    Start-Sleep -Milliseconds 250
}
if (\$targetHwnd -ne [IntPtr]::Zero) {
    [MiosLW]::ShowWindow(\$targetHwnd, 9) | Out-Null
    [MiosLW]::ShowWindow(\$targetHwnd, 5) | Out-Null
    \$r = New-Object MiosLW+RECT
    [MiosLW]::GetWindowRect(\$targetHwnd, [ref]\$r) | Out-Null
    \$w = \$r.Right - \$r.Left
    \$h = \$r.Bottom - \$r.Top
    \$s = [System.Windows.Forms.Screen]::PrimaryScreen.WorkingArea
    \$x = \$s.X + [int]((\$s.Width  - \$w) / 2)
    \$y = \$s.Y + [int]((\$s.Height - \$h) / 2)
    [MiosLW]::MoveWindow(\$targetHwnd, \$x, \$y, \$w, \$h, \$true) | Out-Null
    \$cp = 2; [MiosLW]::DwmSetWindowAttribute(\$targetHwnd, 33, [ref]\$cp, 4) | Out-Null
    try { [System.Windows.Forms.SendKeys]::SendWait('%') } catch {}
    \$tpid = 0; \$tt = [MiosLW]::GetWindowThreadProcessId(\$targetHwnd, [ref]\$tpid)
    \$ct = [MiosLW]::GetCurrentThreadId()
    [MiosLW]::AttachThreadInput(\$ct, \$tt, \$true) | Out-Null
    [MiosLW]::BringWindowToTop(\$targetHwnd) | Out-Null
    [MiosLW]::SetForegroundWindow(\$targetHwnd) | Out-Null
    [MiosLW]::SwitchToThisWindow(\$targetHwnd, \$true) | Out-Null
    [MiosLW]::AttachThreadInput(\$ct, \$tt, \$false) | Out-Null
    Write-Output ("[centered] '" + \$targetTitle + "' at (" + \$x + "," + \$y + ") size " + \$w + "x" + \$h)
} else {
    \$msg = "[launched; window centering deferred to enumeration"
    if (\$hint -ne '') { \$msg = \$msg + " (no new visible window matching '" + \$hint + "' within ${timeout}s)" }
    \$msg = \$msg + "]"
    Write-Output \$msg
}
