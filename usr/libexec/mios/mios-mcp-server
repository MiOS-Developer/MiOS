    return subprocess.run([python, "/usr/libexec/mios/mios-mon.py", "--ui-mode", mode, "--ui-request-stdin"],
                          input=json.dumps(request), text=True).returncode


def _load_card_signing_key(agent_id: str):
    """Load only a provisioned, owner-private Ed25519 passport key, and the
    provisioned public key it must match -- the key a verifier trusts."""
    from cryptography.hazmat.primitives import serialization
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey

    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.:-]*", agent_id) or ".." in agent_id:
        raise ValueError("Invalid relay agent identifier")
    passport = mios_toml.load_merged()["passport"]
    if not passport["enable"]:
        raise RuntimeError("AgentCard signing requires an enabled passport")
    directory = Path(passport["key_dir"]) / agent_id
    path = directory / "private.key"
    # Reject symlinks and require 0600: a public/derived fallback is never a key.
    if path.is_symlink() or not path.is_file() or path.stat().st_mode & 0o777 != 0o600:
        raise RuntimeError("AgentCard signing requires a provisioned 0600 passport key")
    priv = serialization.load_pem_private_key(path.read_bytes(), password=None)
    if not isinstance(priv, Ed25519PrivateKey):
        raise RuntimeError("AgentCard passport key must be Ed25519")
    kid = (directory / "kid").read_text(encoding="utf-8").strip()
    if not kid:
        raise RuntimeError("AgentCard passport key identifier is missing")
    public = directory / "public.key"
    if public.is_symlink() or not public.is_file():
        raise RuntimeError("AgentCard signing requires the provisioned passport public key")
    trusted = serialization.load_pem_public_key(public.read_bytes())
    if (not isinstance(trusted, Ed25519PublicKey)
            or trusted.public_bytes_raw() != priv.public_key().public_bytes_raw()):
        raise RuntimeError("AgentCard passport key does not match its provisioned public key")
    return priv, kid, trusted


def _project_agent_card(agent_id: str, cfg: dict | None = None) -> dict:
    """Project a registered relay participant, signed by its provisioned passport."""
    data = mios_toml.load_merged()
    registration = next((row for row in _agent_relay_call("mios_agent_list", {})["agents"]
                         if row["agent_id"] == agent_id), None)
    if registration is None:
        raise ValueError(f"Unknown agent: {agent_id}")
    # mios_pipe ships beside this server, not on the interpreter path.
    agent_pipe = os.path.normpath(os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios", "agent-pipe"))
    if agent_pipe not in sys.path:
        sys.path.insert(0, agent_pipe)
    from mios_pipe.federation.agentcard_sign import _agent_card_signature, _verify_agent_card_signature

    priv, kid, trusted = _load_card_signing_key(agent_id)
    base = _agent_pipe_url()
    label = registration.get("label") or agent_id
    kind = registration["kind"]
    card: dict = {
        "name": label,
        "description": f"MiOS relay participant {agent_id}",
        "version": data["meta"]["mios_version"],
        "supportedInterfaces": [{"url": f"{base}/a2a", "protocolBinding": "JSONRPC",
                                 "protocolVersion": data["a2a"]["protocol_version"]}],
        "capabilities": {"streaming": True, "pushNotifications": False},
        "defaultInputModes": ["text/plain", "application/json"],
        "defaultOutputModes": ["text/plain"],
        "skills": [{"id": agent_id, "name": label, "description": f"Registered {kind} participant",
                    "tags": [kind], "inputModes": ["text/plain", "application/json"],
                    "outputModes": ["text/plain"]}],
        "securitySchemes": {"bearer": {"httpAuthSecurityScheme": {"scheme": "bearer"}}},
        "securityRequirements": [{"schemes": {"bearer": {"list": []}}}],
    }
    sig = _agent_card_signature(card, load_priv_fn=lambda: priv, kid_fn=lambda: kid)
    if not sig:
        raise RuntimeError("AgentCard passport signing failed")
    card["signatures"] = [sig]
    # Emit only what verifies under the provisioned key; the card carries no key.
    if _verify_agent_card_signature(card, public_key=trusted) != (True, "ok"):
        raise RuntimeError("AgentCard does not verify against the provisioned passport public key")
    return card


def _agent_cli_main(args):
    cfg = _agent_cli_config()
    if args in (["--observe"], ["--watch"]):
        if args == ["--observe"] or not sys.stdout.isatty():
            print(json.dumps(_agent_relay_call("mios_agent_observe", {})))
            return 0
        return _run_monitor_ui("agents")
    if args == ["--install"]:
        _install_agent_clis()
        return 0
    if args == ["--project-wrappers"]:
        _project_agent_wrappers(cfg)
        return 0
    if len(args) == 2 and args[0] == "--card":
        card = _project_agent_card(args[1], cfg)
        print(json.dumps(card, indent=2))
        return 0
    if args:
        raise ValueError("Usage: mios agents [--install | --observe | --watch | --card <id>]")
    rows = []
    for row in cfg["tools"]:
        native = Path("/usr/bin") / row["name"]
        executable = str(native) if os.access(native, os.X_OK) else shutil.which(row["name"])
        rows.append({**row, "executable": executable, "installed": executable is not None})
    print(json.dumps({"agents": rows}, indent=2))
    return 0 if all(row["installed"] for row in rows) else 1


def _install_native(source_root, target_root):
    """One offline payload installer for bootc, dev, service and agent images.

    Only the named binary member is extracted (never archive paths). The SSOT
    digest is verified before an existing executable can be replaced.
    """
    source = Path(source_root).resolve()
    target = Path(target_root).resolve()
    with (source / "usr/share/mios/mios.toml").open("rb") as handle:
        import tomllib
        config = tomllib.load(handle)["mcp"]
    asset = config["tmux"]["assets"][platform.machine()]
    archive = (source / asset["path"]).resolve()
    if not archive.is_relative_to(source):
        raise ValueError("tmux-mcp asset is outside source root")
    if hashlib.sha256(archive.read_bytes()).hexdigest() != asset["sha256"]:
        raise ValueError("tmux-mcp asset checksum mismatch")
    font = tomllib.loads((source / "usr/share/mios/mios.toml").read_text())["theme"]["font"]
    font_archive = (source / font["native_archive"]).resolve()
    if not font_archive.is_relative_to(source) or hashlib.sha256(font_archive.read_bytes()).hexdigest() != font["native_sha256"]:
        raise ValueError("MiOS terminal font asset checksum mismatch")
    wheels = (source / config["wheelhouse"]).resolve()
    if not wheels.is_relative_to(source) or not wheels.is_dir():
        raise ValueError("MCP wheelhouse is missing or outside source root")
    python = target / config["python"].lstrip("/")
    if not python.resolve().is_relative_to(target):
        raise ValueError("MCP Python is outside install root")
    binary = target / config["tmux"]["binary"].lstrip("/")
    if not binary.resolve().is_relative_to(target):
        raise ValueError("tmux-mcp binary is outside install root")
    binary.parent.mkdir(parents=True, exist_ok=True)
    with tarfile.open(archive) as package:
        member = package.getmember("tmux-mcp")
        if not member.isfile():
            raise ValueError("tmux-mcp archive member must be a regular file")
        with package.extractfile(member) as handle:
            content = handle.read()
    temporary = binary.with_suffix(".new")
    temporary.write_bytes(content)
    temporary.chmod(0o755)
    temporary.replace(binary)
    runtime_files = (
        "usr/libexec/mios/mios-mcp-server", "usr/lib/mios/mios_toml.py", "usr/lib/mios/mios_agent_tui.py", "usr/share/mios/mios.toml",
        "usr/libexec/mios/ux/theme_sync.py", "usr/libexec/mios/mios-dotfiles-render",
        "usr/libexec/mios/mios-terminal", "usr/libexec/mios/mios-ai-terminal",
        "usr/libexec/mios/mios-mon.py", "usr/bin/mios",
        "etc/profile.d/mios-prompt.sh", "etc/tmux.conf", "etc/dconf/db/local.d/10-mios-keybindings",
        "usr/share/mios/tmux/mios-bashrc", "usr/share/mios/tmux/mios-theme.tmux.conf", "usr/share/mios/tmux/mios-keys.tmux.conf",
        "usr/share/mios/theme/templates/oh-my-posh.omp.json.tmpl", "usr/share/mios/oh-my-posh/mios.omp.json",
        "usr/share/mios/hyprland/mios-keys.conf", "usr/share/mios/sway/mios-keys.conf", "usr/share/mios/keybindings/vscode-keybindings.json",
        "usr/share/mios/keybindings/vscode-settings.json", "usr/share/mios/keybindings/mobile-shortcuts.json",
    )
    for relative in runtime_files:
        src, dst = source / relative, target / relative
        dst.parent.mkdir(parents=True, exist_ok=True)
        if src.resolve() != dst.resolve():
            shutil.copy2(src, dst)
        if relative.startswith(("usr/libexec/", "usr/bin/")):
            dst.chmod(0o755)
    notices = target / "usr/share/licenses/tmux-mcp"
    notices.mkdir(parents=True, exist_ok=True)
    for name in ("UPSTREAM-README.md", "THIRD-PARTY-NOTICES.txt"):
        shutil.copy2(source / "usr/share/mios/vendored/tmux-mcp" / name, notices / name)
    fonts = target / "usr/share/fonts/geist-nerd"
    fonts.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(font_archive) as package:
        for member in package.infolist():
            name = Path(member.filename).name
            if name.endswith((".otf", ".ttf")) or "LICENSE" in name.upper():
                (fonts / name).write_bytes(package.read(member))
    cache = shutil.which("fc-cache")
    if cache and target == Path("/"):
        subprocess.run([cache, "-f", str(fonts)], check=True)
    venv = python.parent.parent
    interpreter = shutil.which("python3.13")
    if not interpreter:
        raise RuntimeError("[packages.mcp] requires python3.13")
    subprocess.run([interpreter, "-m", "venv", str(venv)], check=True)
    subprocess.run([str(python), "-m", "pip", "install", "--no-index", "--find-links", str(wheels),
                    *config["python_packages"]], check=True)
    print(f"Installed native MiOS-MCP + tmux-mcp in {target}")


def main() -> int:
    from importlib.metadata import version

    if sys.argv[1:] == ["--monitor-request"]:
        print(json.dumps(_monitor_ui_request()))
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--workspace-menu":
        result = _run_monitor_ui("clients")
        if result == 0:
            os.execl("/bin/bash", "/bin/bash", "--rcfile", "/usr/share/mios/tmux/mios-bashrc")
        return result
    if len(sys.argv) > 1 and sys.argv[1] in {"--workspace", "--workspace-resize"}:
        if sys.argv[1] == "--workspace-resize":
            try:
                ui = _human_tmux_context(sys.argv[3], sys.argv[2])
                if ui:
                    _workspace_call("resize", ui, observer_command=_WORKSPACE_OBSERVER_COMMAND)
            except Exception as e:
                sys.stderr.write(f"[mios-mcp] workspace-resize error: {e}\n")
                return 0
        else:
            data = mios_toml.load_merged()
            arguments = sys.argv[2:]
            compact = bool(arguments and arguments[0] == "--compact")
            if compact:
                arguments = arguments[1:]
            name = arguments[0] if arguments else data["mcp"]["tmux"]["workspace"]["head_agent"]
            if name and name not in {row["name"] for row in _agent_cli_config()["tools"]}:
                raise ValueError("Workspace head is not in the SSOT CLI catalog")
            socket = os.environ.get("MIOS_TMUX_UI_SOCKET") or os.environ.get("TMUX", "").split(",")[0]
            _workspace_call("open", socket=socket, latch="mios-workspace-" + secrets.token_hex(8),
                            directory=os.getcwd(),
                            view="compact" if compact else "auto",
                            command=shlex.join(["/usr/bin/mios", "agent", name, *arguments[1:]]) if name else
                                shlex.join([data["mcp"]["python"], "/usr/libexec/mios/mios-mcp-server", "--workspace-menu"]),
                            observer_command=_WORKSPACE_OBSERVER_COMMAND,
                            adapter=shlex.join([data["mcp"]["python"], "/usr/libexec/mios/mios-mcp-server"]))
        return 0

    if len(sys.argv) > 1 and sys.argv[1] in {"--workspace-focus", "--workspace-view"}:
        socket = os.environ.get("TMUX", "").rsplit(",", 2)[0]
        pane = os.environ.get("TMUX_PANE", "")
        ui = _human_tmux_context(socket, pane)
        head = subprocess.check_output(["tmux", "-S", socket, "display-message", "-p", "-t", pane,
            "#{@mios-workspace-head}\t#{@mios-workspace-worker}"], text=True, timeout=3).strip().split('\t')[0]
        if not head:
            head = subprocess.check_output(["tmux", "-S", socket, "display-message", "-p", "-t", pane,
                "#{@mios-workspace-worker}"], text=True, timeout=3).strip()
        if not re.fullmatch(r"%\d+", head):
            if sys.argv[1] == "--workspace-focus":
                return subprocess.run(["tmux", "-S", socket, "select-pane", "-t", f"{ui['window']}.+"], check=True).returncode
            raise ValueError("This pane is not in a native AI workspace")
        ui["pane"] = head
        action = "focus" if sys.argv[1] == "--workspace-focus" else "view"
        _workspace_call(action, ui, **{"target" if action == "focus" else "view": sys.argv[2]})
        return 0

    if "--project-agent-clients" in sys.argv[1:]:
        _project_agent_clients()
        return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--agent-cli":
        return _agent_cli_main(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == "--launch-agent":
        if len(sys.argv) < 3:
            raise ValueError("Usage: mios agent NAME [ARGS...]")
        name = sys.argv[2]
        cfg_cli = _agent_cli_config()
        row = next((r for r in cfg_cli["tools"] if r["name"] == name), None)
        if row is None:
            raise ValueError("Agent is not in the SSOT CLI catalog")
        exports = mios_toml.emit_exports()
        endpoint = os.environ.get("MIOS_AI_ENDPOINT") or exports.get("MIOS_AI_ENDPOINT")
        if not endpoint:
            raise ValueError("SSOT AI endpoint is required")
        os.environ.setdefault("MIOS_AI_ENDPOINT", endpoint)
        os.environ.setdefault("MIOS_AI_GATEWAY_MODEL", exports["MIOS_AI_AGENT_MODEL"])
        # Do not launch a worker against an absent route or a different model.
        # This GET-only native gate never performs inference or starts services.
        readiness = subprocess.run(["/usr/bin/mios-ai-config", "--root", "/", "--probe"],
                                   capture_output=True, text=True, timeout=10)
        if readiness.returncode:
            raise RuntimeError(readiness.stderr.strip() or "Local AI route is not ready")
        os.environ.setdefault("OPENAI_BASE_URL", endpoint)
        os.environ.setdefault("OPENAI_API_BASE", endpoint)
        ui = None
        if os.environ.get("TMUX") and os.environ.get("TMUX_PANE"):
            ui = _human_tmux_context(os.environ["TMUX"].rsplit(",", 2)[0], os.environ["TMUX_PANE"])
            os.environ["MIOS_TMUX_UI_SOCKET"] = ui["socket"]
            os.environ["MIOS_TMUX_UI_PANE"] = ui["pane"]
            subprocess.run(["tmux", "-S", ui["socket"], "set-option", "-p", "-t", ui["pane"],
                            "@mios-agent-kind", name], check=True, timeout=3)
        _project_agent_clients()
        native = Path(cfg_cli["linux_prefix"]) / ("npm/bin" if row["kind"] == "npm" else "native" if row["kind"] == "native" else "bin") / name
        if not os.access(native, os.X_OK):
            raise RuntimeError(f"{name} is not installed; run sudo mios agents --install")
        try:
            return subprocess.call([str(native), *sys.argv[3:]])
        finally:
            if ui:
                subprocess.run(["tmux", "-S", ui["socket"], "set-option", "-pu", "-t", ui["pane"],
                                "@mios-agent-kind"], capture_output=True, timeout=3)

    if "--install-native" in sys.argv[1:]:
        import argparse
        parser = argparse.ArgumentParser()
        parser.add_argument("--install-native", action="store_true")
        parser.add_argument("--source-root", required=True)
        parser.add_argument("--root", default="/")
        args = parser.parse_args()
        _install_native(args.source_root, args.root)
        return 0

    try:
        sdk_major = int(version("mcp").split(".", 1)[0])
    except Exception:
        sdk_major = 0
    if sdk_major < 2:
        sdk_python = os.environ.get("MIOS_MCP_PYTHON") or (mios_toml.load_merged().get("mcp") or {}).get("python") or "/usr/lib/mios/agents/.venv/bin/python3"
        if os.path.isfile(sdk_python) and os.path.realpath(sdk_python) != os.path.realpath(sys.executable):
            os.execv(sdk_python, [sdk_python, os.path.abspath(__file__), *sys.argv[1:]])
    if sdk_major < 2:
        raise SystemExit("mios-mcp-server requires the FOSS MCP Python SDK 2.x in the agent venv")

    terminal_only = "--tmux-only" in sys.argv[1:]
    if not terminal_only:
        _ensure_warm()
        threading.Thread(
            target=_refresh_loop, name="mcp-tools-refresh", daemon=True,
        ).start()
    server = _sdk_server(terminal_only=terminal_only)
    if ("--http" in sys.argv[1:]
            or os.environ.get("MIOS_MCP_HTTP", "").strip().lower()
            in {"1", "true", "yes"}):
        port = int(os.environ.get("MIOS_PORTS_MCP")
                   or os.environ.get("MIOS_PORTS_MCP")
                   or os.environ.get("MIOS_PORTS_MCP")
                   or (mios_toml.load_merged().get("ports") or {}).get("mcp"))
        _serve_http(server, port)
    else:
        asyncio.run(_serve_stdio(server))
    return 0


if __name__ == "__main__":
    sys.exit(main())
