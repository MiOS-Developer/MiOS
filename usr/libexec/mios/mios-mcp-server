TIMEOUT_S = 60


def _http_get(path: str, timeout: int | None = None) -> dict:
    req = urllib.request.Request(
        f"{AGENT_PIPE_URL}{path}",
        headers={"Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout or TIMEOUT_S) as r:
            return json.loads(r.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            return {"success": False, "error": f"HTTP {e.code}: {raw}"}


def _http_post(path: str, body: dict) -> dict:
    req = urllib.request.Request(
        f"{AGENT_PIPE_URL}{path}",
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Accept": "application/json",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_S) as r:
            return json.loads(r.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            return {"success": False, "error": f"HTTP {e.code}: {raw}"}


def _ok(mid, result: dict) -> dict:
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def _err(mid, code: int, message: str, data=None) -> dict:
    e: dict = {"code": code, "message": message}
    if data is not None:
        e["data"] = data
    return {"jsonrpc": "2.0", "id": mid, "error": e}


_TOOLS_CACHE_FILE = os.environ.get(
    "MIOS_MCP_TOOLS_CACHE", "/var/lib/mios/mcp/tools.cache.json")
_TOOLS_CACHE_MEM = None
_REFRESH_INTERVAL_S = int(os.environ.get("MIOS_MCP_REFRESH_INTERVAL", "30"))
_LIST_TIMEOUT_S = int(os.environ.get("MIOS_MCP_LIST_TIMEOUT", "8"))

def _tools_cache_save(tools):
    global _TOOLS_CACHE_MEM
    _TOOLS_CACHE_MEM = tools
    try:
        _d = os.path.dirname(_TOOLS_CACHE_FILE)
        if _d and not os.path.isdir(_d):
            os.makedirs(_d, exist_ok=True)
        _tmp = _TOOLS_CACHE_FILE + ".tmp"
        with open(_tmp, "w", encoding="utf-8") as _f:
            json.dump(tools, _f)
        os.replace(_tmp, _TOOLS_CACHE_FILE)
    except Exception:
        pass


def _tools_cache_load():
    if _TOOLS_CACHE_MEM:
        return _TOOLS_CACHE_MEM
    try:
        with open(_TOOLS_CACHE_FILE, "r", encoding="utf-8") as _f:
            _d = json.load(_f)
            return _d if isinstance(_d, list) and _d else None
    except Exception:
        return None


def _tools_cache_prime():
    """Load the last-good catalog from disk into memory at startup so the very
    first tools/list -- even before the background refresher has run, even if
    agent-pipe is still booting -- serves the full set."""
    global _TOOLS_CACHE_MEM
    if _TOOLS_CACHE_MEM:
        return
    try:
        with open(_TOOLS_CACHE_FILE, "r", encoding="utf-8") as _f:
            _d = json.load(_f)
            if isinstance(_d, list) and _d:
                _TOOLS_CACHE_MEM = _d
                sys.stderr.write(
                    f"[mios-mcp] primed {len(_d)} tools from disk cache\n")
    except Exception:
        pass


def _build_mcp_tools(data: dict) -> list:
    """Convert agent-pipe /v1/tools (OpenAI function-tool shape) to MCP tool
    shape ({name, description, inputSchema}). Rows already in MCP shape pass
    through untouched."""
    out = []
    for t in (data.get("tools") or []):
        if not isinstance(t, dict):
            continue
        if t.get("name") and t.get("inputSchema") is not None:
            out.append(t)
            continue
        fn = t.get("function") or {}
        nm = fn.get("name")
        if not nm:
            continue
        out.append({
            "name": nm,
            "description": fn.get("description", ""),
            "inputSchema": fn.get("parameters")
            or {"type": "object", "properties": {}},
        })
    return out


MIOS_TOML = os.environ.get("MIOS_TOML", "/usr/share/mios/mios.toml")


def _verb_row_ssot(vname: str, vcfg: dict) -> dict:
    """Mirror agent-pipe _verb_to_openai_tool (server.py:15461): model-facing name
    = model_name||vname; each param required (OpenAI strict); a param WITH a default
    becomes nullable ([t,'null'], enum+[None]) but stays required."""
    props, required = {}, []
    for argname, argcfg in (vcfg.get("params") or {}).items():
        if not isinstance(argcfg, dict):
            continue
        _t = argcfg.get("type", "string")
        spec = {"description": argcfg.get("desc", "")}
        if argcfg.get("enum"):
            spec["enum"] = list(argcfg["enum"])
        if "default" in argcfg:
            spec["type"] = [_t, "null"]
            if "enum" in spec:
                spec["enum"] = spec["enum"] + [None]
        else:
            spec["type"] = _t
        required.append(argname)
        props[argname] = spec
    facing = str(vcfg.get("model_name", "") or "").strip() or vname
    return {"type": "function", "function": {
        "name": facing, "description": vcfg.get("desc", ""), "strict": True,
        "parameters": {"type": "object", "properties": props,
                       "required": required, "additionalProperties": False}}}


def _recipe_row_ssot(name: str, cfg: dict) -> dict:
    """Mirror agent-pipe _recipe_to_openai_tool (server.py:5345): name mangled to
    mios_recipe__<name>; every arg a string prop + an optional `os`; none required."""
    props = {}
    for argname in (cfg.get("args") or []):
        if isinstance(argname, str) and argname:
            props[argname] = {"type": "string", "description": f"value for {argname}"}
    if "os" not in props:
        props["os"] = {"type": "string",
                       "description": "target OS selector (optional; defaults to host)"}
    return {"type": "function", "function": {
        "name": "mios_recipe__" + re.sub(r"[^A-Za-z0-9_]", "_", name),
        "description": cfg.get("description", "") or f"MiOS OS recipe {name}",
        "parameters": {"type": "object", "properties": props,
                       "required": [], "additionalProperties": True}}}


def _build_catalog_from_ssot() -> list:
    """Build the verb+recipe catalog DIRECTLY from mios.toml as MCP tool specs --
    the guaranteed non-empty FLOOR, served when BOTH the live feed AND the cache
    are unavailable (cold start + agent-pipe down) so a client is never toolless
    for its whole life. Skills are NOT built here (they live in pgvector,
    unreachable from this sandbox); the verb+recipe surface -- every launch /
    OS-control / web tool -- is the floor that matters. Mirrors agent-pipe's
    /v1/tools projections (server.py:15461 verbs, :5345 recipes, :4760 filter)."""
    try:
        try:
            import tomllib
        except ImportError:
            import tomli as tomllib  # type: ignore
        with open(MIOS_TOML, "rb") as f:
            data = tomllib.load(f)
        rows = []
        verbs = data.get("verbs") or {}
        if isinstance(verbs, dict):
            for vname, vcfg in verbs.items():
                if isinstance(vcfg, dict) and "section" in vcfg:
                    rows.append(_verb_row_ssot(vname, vcfg))
        recipes = data.get("recipes") or {}
        if isinstance(recipes, dict):
            for rname, rcfg in recipes.items():
                if isinstance(rcfg, dict):
                    rows.append(_recipe_row_ssot(rname, rcfg))
        return _build_mcp_tools({"tools": rows})
    except Exception as e:  # noqa: BLE001 -- floor build is best-effort
        sys.stderr.write(f"[mios-mcp] SSOT floor build failed: {e}\n")
        return []


def _skill_names(tools) -> set:
    return {t.get("name") for t in (tools or [])
            if str(t.get("name", "")).startswith("mios_skill__")}


def _is_poisoned(live: list, cached) -> bool:
    """True when `live` looks like a degrade-open partial that would POISON
    last-good if saved. Two cases: (a) empty or >50%-shrunk vs cache (warmup);
    (b) it LOST promoted skills without gaining any -- agent-pipe's /v1/tools is
    degrade-open (server.py:15583-15590): a pgvector outage silently drops the
    skills tail (HTTP 200, no error), a drop too small to trip the size guard, so
    a skill-less feed would otherwise be accepted + persisted as the new last-good."""
    if not cached:
        return False
    if len(live) < max(1, len(cached) // 2):
        return True
    prev_sk, live_sk = _skill_names(cached), _skill_names(live)
    if (prev_sk - live_sk) and not (live_sk - prev_sk):
        return True
    return False


def _fetch_live_tools(timeout: int | None = None) -> list:
    """Fetch + convert the live agent-pipe catalog. Raises on transport failure."""
    data = _http_get("/v1/tools", timeout=timeout)
    if isinstance(data, dict) and data.get("error"):
        raise Exception(f"agent-pipe error: {data['error']}")
    return _build_mcp_tools(data)


def _refresh_once() -> bool:
    """One background catalog refresh: fetch live, and persist as last-good
    UNLESS it would poison the cache (empty/shrunk, or a degrade-open skills-tail
    drop -- see _is_poisoned)."""
    try:
        live = _fetch_live_tools(timeout=TIMEOUT_S)
    except Exception:
        return False
    cached = _tools_cache_load()
    if live and not _is_poisoned(live, cached):
        _tools_cache_save(live)
        return True
    return False


def _refresh_loop() -> None:
    """Keep the last-good catalog warm independent of client connect timing.
    Re-tries faster while the upstream looks unhealthy so the cache re-warms
    promptly once agent-pipe recovers. When the served catalog actually CHANGES
    (e.g. recovers from the SSOT floor / a degraded set back to the full surface),
    log a catalog change. The SDK serves uncached list results, so clients
    re-list against the current catalog instead of keeping a stale session."""
    prev = tuple(sorted(t.get("name", "") for t in (_tools_cache_load() or [])))
    while True:
        ok = _refresh_once()
        if ok:
            cur = tuple(sorted(t.get("name", "") for t in (_tools_cache_load() or [])))
            if cur and cur != prev:
                sys.stderr.write(
                    f"[mios-mcp] catalog changed ({len(cur)} tools); "
                    f"uncached list available\n")
            prev = cur
        time.sleep(_REFRESH_INTERVAL_S if ok else max(5, _REFRESH_INTERVAL_S // 6))


def _handle_tools_list(mid, _params: dict) -> dict:
    cached = _tools_cache_load()
    try:
        live = _fetch_live_tools(timeout=_LIST_TIMEOUT_S)
    except Exception as e:  # noqa: BLE001 -- URLError or any transport failure
        if cached:
            sys.stderr.write(
                f"[mios-mcp] /v1/tools unreachable ({e}); served "
                f"{len(cached)} CACHED tools\n")
            return _ok(mid, {"tools": cached})
        floor = _build_catalog_from_ssot()
        if floor:
            sys.stderr.write(
                f"[mios-mcp] /v1/tools unreachable + cold cache; served "
                f"{len(floor)} SSOT-floor tools (verbs+recipes from mios.toml)\n")
            return _ok(mid, {"tools": floor})
        return _err(mid, -32000,
                    f"agent-pipe unreachable + no cache + no SSOT floor: {e}")
    if cached and _is_poisoned(live, cached):
        sys.stderr.write(
            f"[mios-mcp] /v1/tools returned a partial set ({len(live)} tools vs "
            f"{len(cached)} cached); serving CACHED set (agent-pipe warming up / "
            f"degrade-open)\n")
        return _ok(mid, {"tools": cached})
    if live:
        _tools_cache_save(live)
    return _ok(mid, {"tools": live})


def _handle_tools_call(mid, params: dict) -> dict:
    name = (params or {}).get("name", "")
    args = (params or {}).get("arguments") or {}
    if not name:
        return _err(mid, -32602, "missing tool name")
    try:
        if name.startswith("mios_skill__"):
            real = name[len("mios_skill__"):]
            result = _http_post("/skills/run", {
                "name": real, "params": args,
            })
        elif name.startswith("mios_recipe__"):
            real = name[len("mios_recipe__"):]
            recipe_args = {"name": real, "params": {key:value for key,value in args.items() if key != "os"}}
            if args.get("os") is not None:
                recipe_args["os"] = args["os"]
            result = _http_post("/v1/dispatch", {
                "tool": "os_recipe",
                "args": recipe_args,
            })
        else:
            result = _http_post("/v1/dispatch", {
                "tool": name, "args": args,
            })
    except urllib.error.URLError as e:
        return _err(mid, -32000, f"agent-pipe unreachable: {e.reason}")
    except Exception as e:
        return _err(mid, -32000, f"dispatch failed: {e}")
    is_error = not result.get("success", False)
    return _ok(mid, {
        "content": [{
            "type": "text",
            "text": json.dumps(result, ensure_ascii=False),
        }],
        "isError": is_error,
    })


def _handle_resources_list(mid, _params: dict) -> dict:
    try:
        data = _http_get("/v1/resources")
    except urllib.error.URLError as e:
        return _err(mid, -32000, f"agent-pipe unreachable: {e.reason}")
    except Exception as e:
        return _err(mid, -32000, f"resources fetch failed: {e}")
    if isinstance(data, dict) and data.get("error"):
        return _err(mid, -32000, str(data.get("error")))
    return _ok(mid, {"resources": data.get("resources") or []})


def _handle_resources_read(mid, params: dict) -> dict:
    uri = (params or {}).get("uri", "")
    if not uri:
        return _err(mid, -32602, "missing resource uri")
    try:
        data = _http_get(
            "/v1/resources/read?uri=" + urllib.parse.quote(uri, safe=""))
    except urllib.error.URLError as e:
        return _err(mid, -32000, f"agent-pipe unreachable: {e.reason}")
    except Exception as e:
        return _err(mid, -32000, f"resource read failed: {e}")
    if data.get("error"):
        return _err(mid, -32002, str(data.get("error")))
    return _ok(mid, {"contents": data.get("contents") or []})


def _ensure_warm() -> None:
    """Serve the saved catalog or SSOT floor before the first client connects."""
    global _TOOLS_CACHE_MEM
    _tools_cache_prime()
    if not _TOOLS_CACHE_MEM:
        floor = _build_catalog_from_ssot()
        if floor:
            _TOOLS_CACHE_MEM = floor
            sys.stderr.write(
                f"[mios-mcp] seeded {len(floor)} tools from mios.toml SSOT floor\n"
            )


def _human_tmux_context(socket_path=None, pane=None):
    """Bind a private MiOS terminal or the caller's witnessed tmux pane."""
    socket_path = socket_path or os.environ.get("MIOS_TMUX_UI_SOCKET")
    pane = pane or os.environ.get("MIOS_TMUX_UI_PANE")
    if not socket_path and not pane:
        return None
    keys = mios_toml.load_merged()["keybindings"]
    path = Path(socket_path or "")
    ambient = os.environ.get("TMUX", "").rsplit(",", 2)
    witnessed = (len(ambient) == 3 and ambient[0] == str(path)
                 and ambient[1].isdigit() and os.environ.get("TMUX_PANE") == pane)
    native = path.name == keys["socket_name"]
    if (not path.is_absolute() or len(os.fsencode(path)) >= 104
            or not (native or witnessed) or path.resolve() != path
            or not re.fullmatch(r"%\d+", pane or "")):
        raise ValueError("invalid native MiOS desktop tmux binding")
    node, parent = path.lstat(), path.parent.lstat()
    if (not stat.S_ISSOCK(node.st_mode) or node.st_uid != os.getuid()
            or parent.st_uid != os.getuid() or parent.st_mode & 0o077):
        raise ValueError("MiOS desktop socket must be private and owned by the caller")
    result = subprocess.run(["tmux", "-S", str(path), "display-message", "-p", "-t", pane,
        "#{socket_path}\t#{session_name}\t#{pane_id}\t#{window_id}\t#{pid}"],
        capture_output=True, text=True, timeout=3, check=True)
    fields = result.stdout.rstrip("\n").split("\t")
    if len(fields) == 5 and fields[1] != keys["terminal_session"]:
        # Compact views park the head/workers in a separate session. Only
        # accept a pane whose managed main window witnesses the same head.
        tags = subprocess.check_output(["tmux", "-S", str(path), "display-message", "-p", "-t", pane,
            "#{@mios-workspace-head}\t#{@mios-workspace-worker}\t#{@mios-workspace-window}"], text=True, timeout=3).rstrip('\n').split('\t')
        head = tags[0] or (tags[1] if len(tags) > 1 else "")
        if re.fullmatch(r"%\d+", head):
            main = subprocess.check_output(["tmux", "-S", str(path), "display-message", "-p", "-t", head,
                "#{@mios-workspace-window}"], text=True, timeout=3).strip()
            if re.fullmatch(r"@\d+", main):
                witness = subprocess.check_output(["tmux", "-S", str(path), "display-message", "-p", "-t", main,
                    "#{session_name}\t#{@mios-workspace-head}"], text=True, timeout=3).strip().split('\t')
                if len(witness) == 2 and witness[1] == head:
                    fields[1] = witness[0]
    if (len(fields) != 5 or fields[0] != str(path) or fields[2] != pane
            or not re.fullmatch(r"@\d+", fields[3]) or not fields[4].isdigit()
            or (witnessed and fields[4] != ambient[1])
            or (not witnessed and fields[1] != keys["terminal_session"])):
        raise ValueError("desktop pane is not in the native MiOS session")
    return {"socket": str(path), "pane": pane, "window": fields[3], "session": fields[1],
            "tmux": f"{path},{fields[4]},0"}


# Command the workspace observer pane runs; resize uses it to rebuild a dead observer.
_WORKSPACE_OBSERVER_COMMAND = "/usr/bin/mios agents --watch"


def _workspace_call(action, ui=None, **arguments):
    """Resolve the native workspace policy from the same layered SSOT at runtime."""
    data = mios_toml.load_merged()
    session = data["keybindings"]["terminal_session"]
    if ui and ui.get("session"):
        session = ui["session"]
    elif os.environ.get("TMUX"):
        tmux_sock = os.environ["TMUX"].rsplit(",", 2)[0]
        try:
            # A compact view parks inactive heads/workers in a storage session.
            # Re-enter their witnessed main window rather than opening a new
            # workspace in that parking session.
            pane = os.environ.get("TMUX_PANE")
            if pane:
                current = _human_tmux_context(tmux_sock, pane)
                marks = subprocess.check_output(["tmux", "-S", tmux_sock, "display-message", "-p", "-t", pane,
                    "#{@mios-workspace-head}\t#{@mios-workspace-worker}\t#{@mios-workspace-observer-for}"], text=True, timeout=2).strip().split('\t')
                head = next((mark for mark in marks if re.fullmatch(r"%\d+", mark)), "")
                if head:
                    main = subprocess.check_output(["tmux", "-S", tmux_sock, "display-message", "-p", "-t", head,
                        "#{@mios-workspace-window}"], text=True, timeout=2).strip()
                    witness = subprocess.check_output(["tmux", "-S", tmux_sock, "display-message", "-p", "-t", main,
                        "#{session_name}\t#{@mios-workspace-head}"], text=True, timeout=2).strip().split('\t')
                    if len(witness) == 2 and witness[1] == head:
                        session = witness[0]
                        arguments.setdefault("session", session)
            cmd = ["tmux", "-S", tmux_sock, "display-message", "-p", "#{session_name}"]
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=2)
            if proc.returncode == 0 and proc.stdout.strip() and "session" not in arguments:
                session = proc.stdout.strip()
            elif os.environ.get("TMUX_PANE"):
                current = _human_tmux_context(tmux_sock, os.environ["TMUX_PANE"])
                session = current["session"]
        except Exception:
            if os.environ.get("TMUX_PANE"):
                current = _human_tmux_context(tmux_sock, os.environ["TMUX_PANE"])
                session = current["session"]

    # Resolve socket fallback
    socket = arguments.get("socket") or (ui and ui.get("socket")) or os.environ.get("MIOS_TMUX_UI_SOCKET") or os.environ.get("TMUX", "").split(",")[0]
    if not socket:
        socket_name = data["keybindings"].get("socket_name", "mios-human")
        try:
            res = subprocess.run(["tmux", "-L", socket_name, "display-message", "-p", "#{socket_path}"],
                                 capture_output=True, text=True, timeout=2)
            if res.returncode == 0 and res.stdout.strip():
                socket = res.stdout.strip()
        except Exception:
            pass
        if not socket:
            uid = os.getuid() if hasattr(os, "getuid") else 1000
            for candidate in [
                Path(f"/run/user/{uid}/tmux-{uid}/{socket_name}"),
                Path(f"/run/mios-tmux/{socket_name}"),
                Path(f"/tmp/tmux-{uid}/{socket_name}"),
            ]:
                if candidate.exists():
                    socket = str(candidate)
                    break
        if not socket:
            socket = f"/run/user/{os.getuid()}/tmux-{os.getuid()}/{data['keybindings'].get('socket_name', 'mios-human')}" if hasattr(os, "getuid") else f"/tmp/{data['keybindings'].get('socket_name', 'mios-human')}"
    arguments["socket"] = socket

    # Resolve directory fallback
    if "directory" not in arguments:
        cwd = (ui and ui.get("directory")) or os.getcwd()
        if not os.path.isabs(cwd) or not os.path.isdir(cwd):
            cwd = data.get("terminal", {}).get("start_directory", "/")
            if not os.path.isabs(cwd) or not os.path.isdir(cwd):
                cwd = "/tmp"
        arguments["directory"] = cwd

    request = {"action": action, "workspace": data["mcp"]["tmux"]["workspace"],
               "human_socket": data["keybindings"]["socket_name"],
               "session": session, **arguments}
    if ui:
        request.update(socket=ui.get("socket") or socket, head=ui["pane"])
    result = subprocess.run([data["mcp"]["agents"]["binary"], "--workspace"],
                            input=json.dumps(request), capture_output=True, text=True, timeout=15)
    try:
        receipt = json.loads(result.stdout)
    except Exception as e:
        raise RuntimeError(f"failed to parse workspace response: {e}; stderr: {result.stderr}")
    if result.returncode or not receipt.get("ok"):
        raise RuntimeError(receipt.get("error") or result.stderr)
    return receipt["result"]


class _TmuxBridge:
    """Per MCP session upstream client, private socket and bounded slot policy.

    The SDK owns framing and version negotiation. Its context is entered and
    exited in one owner task so concurrent tool handlers cannot corrupt an
    anyio cancel scope. Terminal access has the caller's OS permissions; a
    tool/path allowlist is not a filesystem sandbox for arbitrary shell code.
    """

    prefix = "mios_tmux_"
    creators = {"open-pane", "execute-command", "send-keys", "run-in-repl", "start-and-watch", "write-to-display"}

    def __init__(self, config, desktop=True):
        self.config = config
        if config.get("enabled", False):
            for field in ("max_slots", "timeout_s", "history_limit"):
                if type(config.get(field)) is not int or config[field] <= 0:
                    raise ValueError(f"[mcp.tmux].{field} must be a positive integer")
            if not isinstance(config.get("allowed_tools"), list) or not config["allowed_tools"]:
                raise ValueError("[mcp.tmux].allowed_tools must be a non-empty list")
        self.client = None
        self.task = None
        self.ready = asyncio.Event()
        self.stop = asyncio.Event()
        self.error = None
        self.directory = None
        self.socket_dir = None
        self.env = None
        self.tools = []
        self.names = {}
        self.slot_locks = {slot: asyncio.Lock() for slot in range(1, config.get("max_slots", 0) + 1)}
        self.allocation_lock = asyncio.Lock()
        self.start_lock = asyncio.Lock()
        self.visible = None
        self.visible_slots = {}
        self.owner_id = secrets.token_hex(16)
        self.desktop = desktop

    async def start(self):
        if not self.config.get("enabled", False):
            return
        async with self.start_lock:
            if self.task is None:
                self.task = asyncio.create_task(self._owner(), name="mios-tmux-owner")
            await asyncio.wait_for(self.ready.wait(), timeout=30)
            if self.error:
                raise RuntimeError(self.error)
            if self.client is None or self.task.done():
                raise RuntimeError("tmux-mcp session is closed")

    async def _owner(self):
        from mcp import Client, StdioServerParameters, types
        try:
            if os.name != "posix":
                raise RuntimeError("native tmux requires Linux; run MiOS-MCP inside the MiOS WSL runtime")
            binary = os.environ.get("MIOS_TMUX_MCP_BINARY") or self.config["binary"]
            if not os.path.isabs(binary) or not os.access(binary, os.X_OK):
                raise RuntimeError(f"[mcp.tmux].binary is missing or not executable: {binary}")
            if not shutil.which("tmux"):
                raise RuntimeError("native tmux executable is missing")
            self.visible = await asyncio.to_thread(_human_tmux_context) if self.desktop else None
            base = None
            # A shared service directory may be writable but owned by another
            # UID. Keep looking for the caller's runtime before falling back;
            # Codex refuses PATH helpers when its private HOME is under /tmp.
            candidates = [os.environ.get("MIOS_TMUX_RUNTIME_DIR"), os.environ.get("RUNTIME_DIRECTORY"),
                          "/run/mios-tmux", os.environ.get("XDG_RUNTIME_DIR"),
                          f"/run/user/{os.getuid()}", f"/tmp/mios-tmux-{os.getuid()}"]
            for candidate in candidates:
                if not candidate:
                    continue
                candidate = candidate.split(":")[0]
                if not os.path.isabs(candidate) or len(os.fsencode(candidate)) > 40:
                    continue
                try:
                    os.makedirs(candidate, mode=0o700, exist_ok=True)
                except OSError:
                    continue
                if (not os.path.islink(candidate) and os.path.isdir(candidate) and os.access(candidate, os.W_OK)
                        and os.stat(candidate).st_uid == os.getuid()):
                    base = candidate
                    break
            if base is None:
                raise RuntimeError("tmux runtime directory must exist and be writable by the caller")
            self.socket_dir = tempfile.TemporaryDirectory(prefix=f"uid-{os.getuid()}-", dir=base)
            os.chmod(self.socket_dir.name, 0o700)
            self.directory = tempfile.TemporaryDirectory(prefix="mios-tmux-", dir=base)
            os.chmod(self.directory.name, 0o700)
            projector = os.environ.get("MIOS_GEN") or os.path.join(
                os.path.dirname(os.path.abspath(__file__)), "mios-gen")
            if not os.path.isfile(projector):
                projector = "/usr/libexec/mios/mios-gen"
            await asyncio.to_thread(
                subprocess.run,
                [projector, "render-tmux-theme", "--runtime", self.directory.name],
                check=True, capture_output=True, text=True, timeout=60)
            # No inherited API keys, shell startup hooks, TMUX or paste buffers.
            # Keep every locale tmux consults: a non-UTF-8 client turns -F tabs
            # into "_", and upstream's slot registry scan then finds no panes.
            self.env = {k: os.environ[k] for k in ("PATH", "LANG", "LC_ALL", "LC_CTYPE") if k in os.environ}
            self.env.update({"HOME": self.directory.name, "TMUX_TMPDIR": self.socket_dir.name,
                             "NO_COLOR": "1", "TERM": "dumb", "HISTFILE": os.devnull,
                             "MIOS_THEME_PROJECTED": "1",
                             "MIOS_OMP_THEME": os.path.join(self.directory.name, "mios.omp.json")})
            # A non-secret pointer connects nested workers to the caller's shared
            # agent registry while HOME and credentials remain private.
            self.env["MIOS_AGENT_RELAY_STATE"] = str(_agent_relay_directory())
            exports = mios_toml.emit_exports()
            endpoint = os.environ.get("MIOS_AI_ENDPOINT") or exports.get("MIOS_AI_ENDPOINT")
            model = os.environ.get("MIOS_AI_MODEL") or exports.get("MIOS_AI_MODEL")
            if not endpoint or not model:
                raise RuntimeError("SSOT AI endpoint and model are required for nested agents")
            self.env["MIOS_AI_ENDPOINT"] = endpoint
            self.env["MIOS_AI_MODEL"] = model
            self.env["OPENAI_BASE_URL"] = endpoint
            self.env["OPENAI_API_BASE"] = endpoint
            await self._tmux("new-session", "-d", "-s", "mios-anchor", "-x", "200", "-y", "50",
                             "/bin/bash", "--noprofile", "--norc", check=True)
            sock_dir = os.path.join(self.socket_dir.name, f"tmux-{os.getuid()}")
            default_sock = os.path.join(sock_dir, "default")
            mcp_sock = os.path.join(sock_dir, "mcp-headless")
            if os.path.exists(mcp_sock) and not os.path.exists(default_sock):
                try:
                    os.symlink("mcp-headless", default_sock)
                except OSError:
                    pass
            for name, value in (("history-limit", str(self.config["history_limit"])),
                                ("default-shell", "/bin/bash"),
                                ("default-command", "/bin/bash --noprofile --rcfile /usr/share/mios/tmux/mios-bashrc"),
                                ("update-environment", "")):
                await self._tmux("set-option", "-g", name, value, check=True)
            # tmux carries both global and per-session environments. Set the
            # global values explicitly before upstream creates new sessions.
            for key, value in self.env.items():
                await self._tmux("set-environment", "-g", key, value, check=True)
            await self._tmux("source-file", os.path.join(self.directory.name, "tmux.conf"), check=True)
            upstream_env = dict(self.env)
            if self.visible:
                upstream_env.update(TMUX=self.visible["tmux"], TMUX_PANE=self.visible["pane"])
            async with Client(StdioServerParameters(command=binary, args=["--shell-type=bash"],
                              env=upstream_env), client_info=types.Implementation(
                                  name="mios-mcp-server", version="0.1.0")) as client:
                self.client = client
                result = await client.list_tools()
                allowed = set(self.config["allowed_tools"])
                for tool in result.tools:
                    if tool.name not in allowed:
                        continue
                    row = tool.model_dump(by_alias=True, exclude_none=True)
                    name = self.prefix + tool.name.replace("-", "_")
                    self.names[name] = tool.name
                    row["name"] = name
                    row["description"] = ("MiOS desktop worker panes. " if self.visible else "MiOS private terminal. ") + row.get("description", "")
                    schema = row["inputSchema"] = copy.deepcopy(row["inputSchema"])
                    schema.get("properties", {}).pop("isolated", None)
                    schema["additionalProperties"] = False
                    self.tools.append(row)
                if not self.tools:
                    raise RuntimeError("[mcp.tmux].allowed_tools selected zero upstream tools")
                if self.visible:
                    # Only a native workspace's original head can claim its blank
                    # reservations. Nested heads allocate their own local slots.
                    for slot in range(1, self.config["workspace"]["worker_panes"] + 1):
                        reserved = await asyncio.to_thread(self._visible_allocate, slot, True)
                        if reserved is None:
                            break
                self.ready.set()
                try:
                    await self.stop.wait()
                finally:
                    if self.visible:
                        await self._visible_retire("all")
        except Exception as error:
            while isinstance(error, BaseExceptionGroup):
                error = error.exceptions[0]
            self.error = f"tmux-mcp unavailable: {error}"
        finally:
            self.client = None
            self.ready.set()
            if self.directory:
                try:
                    await self._tmux("kill-server")
                finally:
                    if self.socket_dir:
                        self.socket_dir.cleanup()
                    self.directory.cleanup()

    async def _tmux(self, *args, check=False):
        command = ["tmux", "-L", "mcp-headless", "-f", os.devnull, *args]
        result = await asyncio.to_thread(subprocess.run, command, env=self.env,
                                        capture_output=True, timeout=10)
        if check and result.returncode:
            raise RuntimeError(result.stderr.decode("utf-8", errors="replace"))
        return result

    def _visible_allocate(self, slot, reservation_only=False):
        """Allocate under a cross-process window lock; never adopt a user's pane."""
        import fcntl
        ui = self.visible
        lock_path = Path(ui["socket"]).parent / ("mios-mcp-" + ui["window"][1:] + ".lock")
        fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        try:
            if os.fstat(fd).st_uid != os.getuid():
                raise ValueError("desktop allocation lock has a different owner")
            deadline = time.monotonic() + 5
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise TimeoutError("desktop pane allocation is busy")
                    time.sleep(0.02)
            def tmux(*args):
                return subprocess.check_output(["tmux", "-S", ui["socket"], *args], text=True, timeout=3).rstrip("\n")
            record = self.visible_slots.get(slot)
            if record:
                witness = tmux("display-message", "-p", "-t", record["pane"], "#{@mios-mcp-owner}")
                if witness != self.owner_id:
                    raise RuntimeError("desktop helper pane ownership changed")
            rows = tmux("list-panes", "-a", "-F", "#{pane_id}\t#{@mcp_slot}").splitlines()
            occupied = {row.split("\t")[1] for row in rows if "\t" in row
                        and (not record or row.split("\t")[0] != record["pane"])}
            physical = record["upstream"] if record and str(record["upstream"]) not in occupied else next((n for n in range(1, 65) if str(n) not in occupied), None)
            if physical is None:
                raise RuntimeError("desktop window has no free tmux-mcp helper slots")
            if record:
                # Upstream excludes its own head pane when a nested agent starts.
                # Restore this parent's witness only when this parent addresses it.
                for key, value in (("@mcp_pane", record["pane"]), ("@mcp_owner", "agent"), ("@mcp_slot", str(physical))):
                    tmux("set-option", "-p", "-t", record["pane"], key, value)
                record["upstream"] = physical
                return physical
            shell_env = " ".join(shlex.quote(f"{k}={v}") for k, v in self.env.items()
                                 if k != "TMUX_TMPDIR")
            command = 'exec env -i ' + shell_env + ' TMUX="$TMUX" TMUX_PANE="$TMUX_PANE" /bin/bash --noprofile --rcfile /usr/share/mios/tmux/mios-bashrc'
            reserved = _workspace_call("claim", ui, slot=slot, owner=self.owner_id, command=command)
            if reservation_only and not reserved.get("managed"):
                return None
            created = reserved.get("pane") or tmux("split-window", "-d", "-v", "-P", "-F", "#{pane_id}", "-t", ui["pane"], command)
            try:
                for key, value in (("@mcp_pane", created), ("@mcp_owner", "agent"),
                                   ("@mcp_slot", str(physical)), ("@mios-mcp-owner", self.owner_id)):
                    tmux("set-option", "-p", "-t", created, key, value)
                tmux("select-pane", "-t", created, "-T", f"MiOS worker {slot}")
                workspace_head = tmux("display-message", "-p", "-t", ui["pane"], "#{@mios-workspace-head}")
                if re.fullmatch(r"%\d+", workspace_head):
                    tmux("set-option", "-p", "-t", created, "@mios-workspace-worker", workspace_head)
                    _workspace_call("resize", {**ui, "pane": workspace_head}, observer_command=_WORKSPACE_OBSERVER_COMMAND)
                else:
                    tmux("select-layout", "-t", ui["window"], "tiled")
            except BaseException:
                tmux("kill-pane", "-t", created)
                raise
            self.visible_slots[slot] = {"pane": created, "upstream": physical}
            return physical
        finally:
            os.close(fd)

    async def _visible_retire(self, slot):
        for local in (list(self.visible_slots) if slot == "all" else [slot]):
            record = self.visible_slots.get(local)
            if not record:
                continue
            # Retire by witnessed pane ID, not a global upstream slot shared by peers.
            result = await asyncio.to_thread(subprocess.run, ["tmux", "-S", self.visible["socket"],
                "display-message", "-p", "-t", record["pane"], "#{@mios-mcp-owner}"],
                capture_output=True, text=True, timeout=3)
            if result.returncode == 0 and result.stdout.strip() == self.owner_id:
                released = await asyncio.to_thread(_workspace_call, "release", self.visible,
                                                   slot=local, owner=self.owner_id, pane=record["pane"])
                if not released.get("managed"):
                    await asyncio.to_thread(subprocess.run, ["tmux", "-S", self.visible["socket"],
                        "kill-pane", "-t", record["pane"]], capture_output=True, timeout=3, check=True)
            self.visible_slots.pop(local, None)

    async def _upstream_call(self, upstream, args, read_timeout_seconds=None):
        """Keep each head's local slot numbers separate in a shared desktop window."""
        from mcp import types
        args = dict(args)
        if self.visible and upstream == "close-pane":
            await self._visible_retire(args.get("slot", 1))
            return types.CallToolResult(content=[types.TextContent(type="text", text='{"closed":true}')])
        if self.visible and upstream == "list-slots":
            result = await asyncio.to_thread(subprocess.run, ["tmux", "-S", self.visible["socket"],
                "list-panes", "-a", "-F", "#{pane_id}\t#{@mios-mcp-owner}\t#{pane_dead}"],
                capture_output=True, text=True, timeout=3, check=True)
            rows = [line.split("\t") for line in result.stdout.splitlines()]
            live = {r[0]: r[2] for r in rows if len(r) == 3 and r[1] == self.owner_id}
            data = [{"slot": n, "paneId": r["pane"], "isolated": False,
                     "origin": "created", "isAlive": live[r["pane"]] == "0"}
                    for n, r in self.visible_slots.items() if r["pane"] in live]
            return types.CallToolResult(content=[types.TextContent(type="text", text=json.dumps(data))], structuredContent=data)
        local = args.get("slot", 1)
        if self.visible and upstream not in {"list-slots", "notify"}:
            if local not in self.visible_slots and upstream not in self.creators:
                raise ValueError("desktop helper slot is not open for this head agent")
            args["slot"] = await asyncio.to_thread(self._visible_allocate, local)
        anchor = None
        if self.visible and local in self.visible_slots and upstream != "notify":
            def field(pane, fmt):
                return subprocess.check_output(["tmux", "-S", self.visible["socket"], "display-message", "-p", "-t", pane, fmt], text=True, timeout=3).strip()
            worker = self.visible_slots[local]["pane"]
            window = await asyncio.to_thread(field, worker, "#{window_id}")
            head_window = await asyncio.to_thread(field, self.visible["pane"], "#{window_id}")
            if window != head_window:
                main = await asyncio.to_thread(field, self.visible["pane"], "#{@mios-workspace-window}")
                if not re.fullmatch(r"@\d+", main):
                    raise ValueError("worker moved outside its managed workspace")
                # Upstream scopes helpers to its own window. A compact workspace
                # uses only its witnessed observer or parking anchor for that scope.
                for option in ("@mios-workspace-observer", "@mios-workspace-anchor"):
                    candidate = await asyncio.to_thread(field, main, "#{" + option + "}")
                    if re.fullmatch(r"%\d+", candidate) and await asyncio.to_thread(field, candidate, "#{window_id}") == window:
                        anchor = candidate
                        break
                if anchor is None:
                    raise ValueError("worker moved outside its managed workspace")
        if anchor:
            from mcp import Client, StdioServerParameters
            env = {**self.env, "TMUX": self.visible["tmux"], "TMUX_PANE": anchor}
            binary = os.environ.get("MIOS_TMUX_MCP_BINARY") or self.config["binary"]
            async with Client(StdioServerParameters(command=binary, args=["--shell-type=bash"], env=env)) as client:
                result = await client.call_tool(upstream, args, read_timeout_seconds=read_timeout_seconds)
        else:
            result = await self.client.call_tool(upstream, args, read_timeout_seconds=read_timeout_seconds)
        if not self.visible:
            return result
        data = self._payload(result)
        if upstream == "list-slots" and isinstance(data, list):
            owned = {r["upstream"]: n for n, r in self.visible_slots.items()}
            data = [{**row, "slot": owned[row["slot"]]} for row in data
                    if row.get("isolated") is False and row.get("slot") in owned]
        elif isinstance(data, dict) and "slot" in data:
            data["slot"] = local
        if isinstance(data, (dict, list)):
            wire = result.model_dump(by_alias=True, exclude_none=True)
            wire["structuredContent"] = data
            for block in wire["content"]:
                if block.get("type") == "text":
                    try:
                        json.loads(block["text"])
                        block["text"] = json.dumps(data)
                    except ValueError:
                        pass
            return types.CallToolResult.model_validate(wire)
        return result

    def arguments(self, name, arguments):
        upstream = self.names.get(name)
        if upstream is None:
            raise ValueError("unknown or disallowed MiOS tmux tool")
        args = dict(arguments)
        schema = next(t["inputSchema"] for t in self.tools if t["name"] == name)
        unknown = args.keys() - schema.get("properties", {}).keys()
        if unknown:
            raise ValueError("unsupported tmux arguments: " + ", ".join(sorted(unknown)))
        if upstream in {"list-slots", "notify"}:
            slot = None
        else:
            slot = args.get("slot", 1)
            if slot == "all" and upstream == "close-pane":
                pass
            elif type(slot) is not int or not 1 <= slot <= int(self.config["max_slots"]):
                raise ValueError(f"tmux slot must be an integer in 1..{self.config['max_slots']}")
        for field in ("timeout", "timeoutSeconds"):
            if field in args:
                value = args[field]
                if type(value) not in (int, float) or not 0 < value <= self.config["timeout_s"]:
                    raise ValueError(f"{field} must be positive and <= [mcp.tmux].timeout_s")
        if upstream in self.creators and slot is not None:
            args.update(slot=slot, isolated=not bool(self.visible))
        if upstream == "execute-command":
            args.setdefault("timeoutSeconds", self.config["timeout_s"])
        elif upstream in {"watch-pane", "start-and-watch", "run-in-repl"}:
            args.setdefault("timeout", self.config["timeout_s"])
        return upstream, args, slot

    async def call(self, name, arguments):
        from mcp import types
        try:
            await self.start()
            upstream, args, slot = self.arguments(name, arguments)
            async with AsyncExitStack() as locks:
                # Closing all slots must serialize with every in-flight call.
                if slot == "all":
                    for lock in self.slot_locks.values():
                        await locks.enter_async_context(lock)
                elif slot is not None:
                    await locks.enter_async_context(self.slot_locks[slot])
                return await self._call_locked(upstream, args, slot)
        except Exception as error:
            return types.CallToolResult(content=[types.TextContent(type="text", text=str(error))],
                                        isError=True)

    @staticmethod
    def _payload(result):
        wire = result.model_dump(by_alias=True, exclude_none=True)
        if wire.get("structuredContent") is not None:
            return wire["structuredContent"]
        for block in result.content:
            if block.type == "text":
                try:
                    return json.loads(block.text)
                except ValueError:
                    continue
        return None

    async def _call_locked(self, upstream, args, slot):
        from mcp import types
        t0 = time.monotonic()
        try:
            result = await self._upstream_call(upstream, args,
                read_timeout_seconds=float(self.config["timeout_s"]) + 15)
        except BaseException:
            # A cancelled/failed RPC cannot certify command completion.
            if upstream in self.creators and self.client and slot is not None:
                await asyncio.shield(self._upstream_call("close-pane", {"slot": slot},
                    read_timeout_seconds=10))
            raise
        elapsed_s = round(time.monotonic() - t0, 3)
        wire = result.model_dump(by_alias=True, exclude_none=True)
        data = self._payload(result)
        if upstream == "execute-command":
            valid = isinstance(data, dict) and type(data.get("exitCode")) is int
            if not wire.get("isError", False) and not valid:
                if slot is not None:
                    await self._upstream_call("close-pane", {"slot": slot}, read_timeout_seconds=10)
                raise RuntimeError("tmux command returned no exit receipt")
            if valid:
                data["duration_s"] = elapsed_s
                if data.get("timedOut") or data["exitCode"] != 0:
                    wire["isError"] = True
                if data.get("timedOut") and slot is not None:
                    await self._upstream_call("close-pane", {"slot": slot})
                for block in wire.get("content", []):
                    if block.get("type") == "text":
                        try:
                            block["text"] = json.dumps(data)
                            break
                        except Exception:
                            pass
        if data is not None and isinstance(data, (dict, list)):
            wire["structuredContent"] = data
        return types.CallToolResult.model_validate(wire)

    @staticmethod
    def _idle_shell(state):
        """Only our sleeping foreground bash may accept a new workflow.

        A CLI waiting for input is still occupied. Bash/readline may poll
        instead of n_tty_read; verify its kernel state and terminal ownership.
        Missing or changing process evidence fails closed.
        """
        pid = state.get("panePid")
        if (type(pid) is not int or pid <= 0 or state.get("foregroundPid") != pid
                or state.get("foregroundCmd") != "bash" or state.get("isAlive") is not True):
            return False
        try:
            process = Path("/proc") / str(pid)
            stat = (process / "stat").read_text().rsplit(")", 1)[1].split()
            channel = (process / "wchan").read_text().strip()
            return (stat[0] == "S" and int(stat[2]) == pid and int(stat[5]) == pid
                    and re.fullmatch(r"/dev/pts/\d+", os.readlink(process / "fd/0")) is not None
                    and len(list((process / "task").iterdir())) == 1
                    and not (process / "task" / str(pid) / "children").read_text().strip()
                    and (channel in {"n_tty_read", "wait_woken", "do_select", "ep_poll"}
                         or channel.startswith("poll_schedule_timeout")))
        except (OSError, ValueError, IndexError):
            return False

    async def _reserve_nested_slot(self, requested):
        """Reserve a slot through the process probe and command dispatch."""
        if requested is not None and (type(requested) is not int
                or not 1 <= requested <= int(self.config["max_slots"])):
            raise ValueError(f"tmux slot must be an integer in 1..{self.config['max_slots']}")
        if not {"list-slots", "pane-state", "execute-command"} <= set(self.names.values()):
            raise ValueError("nested workflow requires allowed slot discovery, state and execution tools")
        async with self.allocation_lock:
            for slot in ([requested] if requested is not None else self.slot_locks):
                lock = self.slot_locks[slot]
                if lock.locked():
                    continue
                await lock.acquire()
                keep = False
                try:
                    listed = await self._upstream_call("list-slots", {}, read_timeout_seconds=10)
                    slots = self._payload(listed)
                    if listed.model_dump(by_alias=True).get("isError") or not isinstance(slots, list):
                        raise RuntimeError("cannot verify helper slot availability")
                    occupied = next((row for row in slots if row.get("slot") == slot), None)
                    if occupied is None:
                        keep = True
                        return slot
                    state = await self._upstream_call("pane-state", {"slot": slot}, read_timeout_seconds=10)
                    data = self._payload(state)
                    if (not state.model_dump(by_alias=True).get("isError") and isinstance(data, dict)
                            and occupied.get("isolated") is (not bool(self.visible)) and occupied.get("origin") == "created"
                            and await asyncio.to_thread(self._idle_shell, data)):
                        keep = True
                        return slot
                finally:
                    if not keep:
                        lock.release()
        raise ValueError("requested tmux slot is busy or no proven free helper slot is available")

    async def close(self):
        self.stop.set()
        if self.task:
            await asyncio.shield(self.task)

    async def nested_workflow(self, arguments):
        import mios_translate
        t0 = time.monotonic()
        args = dict(arguments)
        agent = args.get("agent")
        task = args.get("task")
        if not agent or not task:
            raise ValueError("nested_workflow requires agent and task")
        cfg_cli = _agent_cli_config()
        known = {row["name"] for row in cfg_cli.get("tools", [])}
        if agent not in known:
            raise ValueError(f"Agent '{agent}' is not in the SSOT CLI catalog: {sorted(known)}")

        timeout_s = args.get("timeoutSeconds", self.config["timeout_s"])
        translate_output = args.get("translate_output", True)

        escaped_task = shlex.quote(task)
        if task in ("--version", "-v", "version"):
            cmd = f"{agent} {task}"
        elif agent == "claude":
            cmd = f"claude -p {escaped_task}"
        elif agent == "codex":
            cmd = f"codex exec {escaped_task}"
        elif agent == "gemini":
            cmd = f"gemini -p {escaped_task}"
        elif agent == "copilot":
            cmd = f"copilot --exec {escaped_task}"
        elif agent == "opencode":
            cmd = f"opencode run {escaped_task}"
        elif agent == "agy":
            cmd = f"agy -p {escaped_task}"
        elif agent == "aider":
            cmd = f"aider --message {escaped_task}"
        else:
            cmd = f"{agent} {escaped_task}"

        await self.start()
        dispatcher = shutil.which("mios", path=self.env.get("PATH"))
        if not dispatcher:
            raise RuntimeError("native MiOS agent dispatcher is missing")
        # The dispatcher refreshes the private caller's MCP configuration.
        # No auth/profile files or leases are copied into this worker HOME.
        cmd = shlex.quote(dispatcher) + " agent " + cmd
        # Publish only the catalog kind while the child runs; preserve its exit.
        cmd = "( trap 'tmux set-option -pu @mios-agent-kind' EXIT; tmux set-option -p @mios-agent-kind " + shlex.quote(agent) + " && " + cmd + " )"
        slot = await self._reserve_nested_slot(args.get("slot"))
        try:
            upstream, command_args, _ = self.arguments("mios_tmux_execute_command", {
                "command": cmd, "slot": slot, "timeoutSeconds": timeout_s})
            result = await self._call_locked(upstream, command_args, slot)
        except Exception as error:
            from mcp import types
            result = types.CallToolResult(content=[types.TextContent(type="text", text=str(error))], isError=True)
        finally:
            self.slot_locks[slot].release()
        wire = result.model_dump(by_alias=True, exclude_none=True)
        structured = self._payload(result)
        verified = isinstance(structured, dict) and type(structured.get("exitCode")) is int
        exit_code = structured["exitCode"] if verified else None
        timed_out = bool(structured.get("timedOut")) if isinstance(structured, dict) else False
        raw_output = structured.get("output", "") if isinstance(structured, dict) else ""
        if not isinstance(raw_output, str):
            raw_output = ""
        clean_text = mios_translate.strip_ansi(raw_output)
        elapsed_s = round(time.monotonic() - t0, 3)
        completed = verified and exit_code == 0 and not timed_out and not wire.get("isError")
        data = {
            "agent": agent,
            "slot": slot,
            "exitCode": exit_code,
            "timedOut": timed_out,
            "duration_s": elapsed_s,
            "receiptVerified": verified,
            "status": "completed" if completed else "failed",
            "output": clean_text,
            "communication": {"status": "not_requested", "message_id": None,
                              "acknowledged": False, "replyReceived": False},
        }
        if not completed:
            data["error"] = ("nested workflow timed out" if timed_out else
                f"agent process exited with code {exit_code}" if verified else
                "nested workflow returned no verified process exit receipt: " +
                (result.content[0].text if result.content else "empty result"))
        if translate_output and clean_text:
            frames = []
            for line in clean_text.splitlines():
                line = line.strip()
                if line.startswith("{") and line.endswith("}"):
                    try:
                        parsed = json.loads(line)
                        if isinstance(parsed, dict):
                            frames.append(parsed)
                    except ValueError:
                        pass
            if frames:
                try:
                    data["translation"] = mios_translate.translate({"source": "auto", "frames": frames})
                except Exception as ex:
                    data["translation_note"] = str(ex)
        return data


class _TerminalSessions:
    """Explicit terminal capabilities for stateless HTTP; stdio stays implicit.

    Modern MCP HTTP has an application lifespan rather than a client lifespan.
    Never use that application bridge as an HTTP client's terminal. Tokens are
    opaque capabilities, expire after idle time, and are bounded by SSOT.
    """

    def __init__(self, config):
        self.config = config
        self.default = _TmuxBridge(config)
        self.sessions = {}
        self.lock = asyncio.Lock()
        self.reaper = None
        for field in ("max_sessions", "session_idle_s"):
            if type(config.get(field)) is not int or config[field] <= 0:
                raise ValueError(f"[mcp.tmux].{field} must be a positive integer")

    async def open(self):
        if not self.config.get("enabled", False):
            raise ValueError("MiOS terminal interface is disabled in SSOT")
        async with self.lock:
            if len(self.sessions) >= self.config["max_sessions"]:
                raise ValueError("MiOS terminal session limit reached; close an existing session")
            token = secrets.token_urlsafe(32)
            bridge = _TmuxBridge(self.config, desktop=False)
            row = self.sessions[token] = {"bridge": bridge, "used": time.monotonic(), "active": 1}
            if self.reaper is None:
                self.reaper = asyncio.create_task(self._expire(), name="mios-terminal-expiry")
        try:
            await bridge.start()
        except BaseException:
            async with self.lock:
                self.sessions.pop(token, None)
            await bridge.close()
            raise
        finally:
            row["active"] = 0
            row["used"] = time.monotonic()
        return {"session": token, "idleTimeoutSeconds": self.config["session_idle_s"]}

    async def call(self, name, arguments, http=False):
        args = dict(arguments)
        token = args.pop("session", None)
        if token is None:
            if http:
                raise ValueError("HTTP terminal tools require session: call mios_tmux_session_open first")
            return await self.default.call(name, args)
        async with self.lock:
            row = self.sessions.get(token) if isinstance(token, str) else None
            if row is None:
                raise ValueError("unknown or expired MiOS terminal session")
            row["active"] += 1
        try:
            return await row["bridge"].call(name, args)
        finally:
            async with self.lock:
                row["active"] -= 1
                row["used"] = time.monotonic()

    async def nested_workflow(self, arguments, http=False):
        args = dict(arguments)
        token = args.pop("session", None)
        if token is None:
            if http:
                raise ValueError("HTTP terminal tools require session: call mios_tmux_session_open first")
            return await self.default.nested_workflow(args)
        async with self.lock:
            row = self.sessions.get(token) if isinstance(token, str) else None
            if row is None:
                raise ValueError("unknown or expired MiOS terminal session")
            row["active"] += 1
        try:
            return await row["bridge"].nested_workflow(args)
        finally:
            async with self.lock:
                row["active"] -= 1
                row["used"] = time.monotonic()

    async def retire(self, token):
        async with self.lock:
            row = self.sessions.get(token) if isinstance(token, str) else None
            if row is None:
                raise ValueError("unknown or expired MiOS terminal session")
            if row["active"]:
                raise ValueError("MiOS terminal session is busy; cancel the active command first")
            self.sessions.pop(token)
        await row["bridge"].close()

    async def _expire(self):
        while True:
            await asyncio.sleep(min(30, self.config["session_idle_s"]))
            async with self.lock:
                expired = [key for key, row in self.sessions.items()
                           if not row["active"] and time.monotonic() - row["used"] >= self.config["session_idle_s"]]
                rows = [self.sessions.pop(key) for key in expired]
            for row in rows:
                await row["bridge"].close()

    async def close(self):
        if self.reaper:
            self.reaper.cancel()
            await asyncio.gather(self.reaper, return_exceptions=True)
        await self.default.close()
        await asyncio.gather(*(row["bridge"].close() for row in self.sessions.values()))
        self.sessions.clear()


def _agent_relay_directory():
    override = os.environ.get("MIOS_AGENT_RELAY_STATE")
    if override:
        directory = Path(override)
        if not directory.is_absolute():
            raise ValueError("MIOS_AGENT_RELAY_STATE must be absolute")
        return directory
    cfg = mios_toml.load_merged()["mcp"]["agents"]
    relative = Path(cfg["state_directory"])
    if relative.is_absolute() or ".." in relative.parts:
        raise ValueError("[mcp.agents].state_directory must stay beneath caller state")
    return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / relative


