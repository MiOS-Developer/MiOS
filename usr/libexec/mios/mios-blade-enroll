def cmd_parse(args: argparse.Namespace) -> int:
    """Parse and validate declared blades from mios.toml or test config."""
    try:
        blades = get_registered_blades(
            config_path=args.config,
            mock=args.mock,
            verbose=args.verbose,
        )
    except ValidationError as err:
        print(f"[ERROR] Validation failed: {err}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"[ERROR] Failed parsing configuration: {exc}", file=sys.stderr)
        return 1

    if not blades:
        print("No blades declared in pre-enrollment registry.")
        return 0

    print(f"Successfully parsed and validated {len(blades)} blade declaration(s):")
    for blade_id, record in sorted(blades.items()):
        print(
            f"  [OK] Blade '{blade_id}': arch={record.architecture}, "
            f"mac={record.mac_address}, ip={record.wireguard_ip}, "
            f"serial={record.chassis_serial}, roles={record.roles}, "
            f"ek_fingerprint={record.ek_fingerprint[:16]}...{record.ek_fingerprint[-8:]}"
        )
    return 0


def cmd_verify_ek(args: argparse.Namespace) -> int:
    """Verify TPM EK certificate or fingerprint against declared registry."""
    try:
        blades = get_registered_blades(
            config_path=args.config,
            mock=args.mock,
            verbose=args.verbose,
        )
    except ValidationError as err:
        print(f"[ERROR] Registry validation error: {err}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"[ERROR] Failed loading registry: {exc}", file=sys.stderr)
        return 1

    target_id = args.blade_id
    if target_id not in blades:
        print(f"[ERROR] Blade '{target_id}' is not enrolled in registry.", file=sys.stderr)
        return 1

    declared_record = blades[target_id]

    try:
        candidate_fp = parse_and_validate_ek(args.cert_or_fingerprint, blade_id=target_id)
    except ValidationError as err:
        print(f"[ERROR] Cryptographic validation error: {err}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"[ERROR] Failed processing candidate EK: {exc}", file=sys.stderr)
        return 1

    if candidate_fp.lower() == declared_record.ek_fingerprint.lower():
        print(
            f"[OK] TPM EK fingerprint verified for blade '{target_id}' "
            f"(hash: {candidate_fp})"
        )
        return 0
    else:
        print(
            f"[FAIL] TPM EK fingerprint mismatch for blade '{target_id}'!\n"
            f"  Declared:  {declared_record.ek_fingerprint}\n"
            f"  Candidate: {candidate_fp}",
            file=sys.stderr,
        )
        return 1


def cmd_manifest(args: argparse.Namespace) -> int:
    """Generate hardware admission policy for a specific blade."""
    try:
        blades = get_registered_blades(
            config_path=args.config,
            mock=args.mock,
            verbose=args.verbose,
        )
    except ValidationError as err:
        print(f"[ERROR] Validation failed: {err}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"[ERROR] Failed loading registry: {exc}", file=sys.stderr)
        return 1

    target_id = args.blade_id
    if target_id not in blades:
        print(f"[ERROR] Blade '{target_id}' not found in declared registry.", file=sys.stderr)
        return 1

    record = blades[target_id]
    manifest_data = record.generate_manifest()
    manifest_json = json.dumps(manifest_data, indent=2)

    if args.output:
        out_path = Path(args.output)
        if args.dry_run:
            print(f"[DRY-RUN] Would write hardware admission manifest to: {out_path}")
            if args.verbose:
                print(manifest_json)
            return 0
        try:
            out_path.parent.mkdir(parents=True, exist_ok=True)
            out_path.write_text(manifest_json + "\n", encoding="utf-8")
            print(f"Wrote admission policy manifest for blade '{target_id}' to: {out_path}")
        except Exception as exc:
            print(f"[ERROR] Failed writing manifest file '{out_path}': {exc}", file=sys.stderr)
            return 1
    else:
        print(manifest_json)

    return 0


def cmd_manifest_all(args: argparse.Namespace) -> int:
    """Generate admission policies for all declared blades."""
    try:
        blades = get_registered_blades(
            config_path=args.config,
            mock=args.mock,
            verbose=args.verbose,
        )
    except ValidationError as err:
        print(f"[ERROR] Validation failed: {err}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"[ERROR] Failed loading registry: {exc}", file=sys.stderr)
        return 1

    if not blades:
        print("No blades declared; 0 admission manifests generated.")
        return 0

    target_dir = Path(args.dir)
    if not args.dry_run:
        target_dir.mkdir(parents=True, exist_ok=True)

    generated_count = 0
    for blade_id, record in sorted(blades.items()):
        manifest_data = record.generate_manifest()
        manifest_json = json.dumps(manifest_data, indent=2)
        target_file = target_dir / f"{blade_id}.json"

        if args.dry_run:
            print(f"[DRY-RUN] Would write admission manifest for '{blade_id}' to: {target_file}")
        else:
            target_file.write_text(manifest_json + "\n", encoding="utf-8")
            print(f"Generated admission policy manifest: {target_file}")
        generated_count += 1

    print(f"Completed manifest generation: {generated_count} policy file(s) processed.")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    """Display enrolled blades and validation state."""
    try:
        blades = get_registered_blades(
            config_path=args.config,
            mock=args.mock,
            verbose=args.verbose,
        )
    except ValidationError as err:
        print(f"[ERROR] Pre-enrollment registry invalid: {err}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"[ERROR] Failed querying registry status: {exc}", file=sys.stderr)
        return 1

    if not blades:
        print("No blades declared in cluster pre-enrollment registry.")
        return 0

    print("=== MiOS Cluster Blade Pre-Enrollment Registry Status ===")
    print(f"Total Enrolled Blades: {len(blades)}\n")
    print(f"{'BLADE ID':<18} {'ARCH':<9} {'MAC ADDRESS':<19} {'MESH IP':<16} {'TPM EK FINGERPRINT':<24} {'STATUS'}")
    print("-" * 96)

    for blade_id, record in sorted(blades.items()):
        short_ek = f"{record.ek_fingerprint[:10]}...{record.ek_fingerprint[-10:]}"
        print(
            f"{record.blade_id:<18} "
            f"{record.architecture:<9} "
            f"{record.mac_address:<19} "
            f"{record.wireguard_ip:<16} "
            f"{short_ek:<24} "
            f"VALID (pre-enrolled)"
        )
    return 0


# -----------------------------------------------------------------------------
# Main Entrypoint
# -----------------------------------------------------------------------------


def main(argv: Optional[List[str]] = None) -> int:
    if argv is None:
        argv = sys.argv[1:]

    parser = argparse.ArgumentParser(
        prog="mios-blade-enroll",
        description="Declarative SSOT blade pre-enrollment registry and TPM EK fingerprint parser (task_473, task_2706).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    # Global top-level arguments
    parser.add_argument("--config", "-c", type=str, default=None, help="Path to mios.toml or test config")
    parser.add_argument("--mock", action="store_true", help="Enable mock hardware blade fixtures")
    parser.add_argument("--dry-run", action="store_true", help="Simulate actions without writing files")
    parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose logging")

    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    # parse
    p_parse = subparsers.add_parser("parse", help="Parse and validate declared blades from config")
    p_parse.add_argument("--config", "-c", type=str, default=None)
    p_parse.add_argument("--mock", action="store_true")
    p_parse.add_argument("--dry-run", action="store_true")
    p_parse.add_argument("-v", "--verbose", action="store_true")

    # verify-ek
    p_verify = subparsers.add_parser("verify-ek", help="Verify TPM EK certificate or fingerprint against declared registry")
    p_verify.add_argument("blade_id", type=str, help="Blade identifier")
    p_verify.add_argument("cert_or_fingerprint", type=str, help="TPM EK certificate file or SHA-256 fingerprint hex")
    p_verify.add_argument("--config", "-c", type=str, default=None)
    p_verify.add_argument("--mock", action="store_true")
    p_verify.add_argument("-v", "--verbose", action="store_true")

    # manifest
    p_manifest = subparsers.add_parser("manifest", help="Generate hardware admission policy for a specific blade")
    p_manifest.add_argument("blade_id", type=str, help="Blade identifier")
    p_manifest.add_argument("--output", "-o", type=str, default=None, help="Output manifest file path")
    p_manifest.add_argument("--config", "-c", type=str, default=None)
    p_manifest.add_argument("--mock", action="store_true")
    p_manifest.add_argument("--dry-run", action="store_true")
    p_manifest.add_argument("-v", "--verbose", action="store_true")

    # manifest-all
    p_manifest_all = subparsers.add_parser("manifest-all", help="Generate admission policies for all declared blades")
    p_manifest_all.add_argument("--dir", "-d", type=str, default=DEFAULT_ADMISSION_DIR, help="Target directory")
    p_manifest_all.add_argument("--config", "-c", type=str, default=None)
    p_manifest_all.add_argument("--mock", action="store_true")
    p_manifest_all.add_argument("--dry-run", action="store_true")
    p_manifest_all.add_argument("-v", "--verbose", action="store_true")

    # status
    p_status = subparsers.add_parser("status", help="Display enrolled blades and validation state")
    p_status.add_argument("--config", "-c", type=str, default=None)
    p_status.add_argument("--mock", action="store_true")
    p_status.add_argument("-v", "--verbose", action="store_true")

    # If no arguments provided, show help
    if not argv:
        parser.print_help()
        return 0

    args = parser.parse_args(argv)

    # Propagate top-level flags if present in argv
    if "--mock" in argv:
        args.mock = True
    if "--dry-run" in argv:
        args.dry_run = True
    if "-v" in argv or "--verbose" in argv:
        args.verbose = True
    for i, a in enumerate(argv):
        if a in ("--config", "-c") and i + 1 < len(argv):
            args.config = argv[i + 1]

    if not args.subcommand:
        parser.print_help()
        return 0

    if args.subcommand == "parse":
        return cmd_parse(args)
    elif args.subcommand == "verify-ek":
        return cmd_verify_ek(args)
    elif args.subcommand == "manifest":
        return cmd_manifest(args)
    elif args.subcommand == "manifest-all":
        return cmd_manifest_all(args)
    elif args.subcommand == "status":
        return cmd_status(args)

    return 0


if __name__ == "__main__":
    sys.exit(main())
