class ValidationError(Exception):
    """Raised when blade hardware or cryptographic validation fails."""
    pass


class BladeRecord:
    """Represents a validated hardware blade registered for cluster admission."""

    def __init__(
        self,
        blade_id: str,
        architecture: str,
        mac_address: str,
        chassis_serial: str,
        wireguard_ip: str,
        ek_fingerprint: str,
        wireguard_pubkey: str = "",
        roles: Optional[List[str]] = None,
        pcr_baselines: Optional[Dict[str, str]] = None,
        raw_config: Optional[dict] = None,
    ):
        self.blade_id = blade_id
        self.architecture = architecture
        self.mac_address = mac_address
        self.chassis_serial = chassis_serial
        self.wireguard_ip = wireguard_ip
        self.ek_fingerprint = ek_fingerprint
        self.wireguard_pubkey = wireguard_pubkey
        self.roles = roles or ["worker"]
        self.pcr_baselines = pcr_baselines or {
            "0": "0" * 64,
            "7": "0" * 64,
            "11": "0" * 64,
        }
        self.raw_config = raw_config or {}

    def generate_manifest(self) -> dict:
        """Create hardware admission policy manifest dictionary for cluster coordinator."""
        now_utc = datetime.datetime.now(datetime.timezone.utc).isoformat()
        return {
            "$schema": "https://mios.dev/schemas/blade-admission-v1.json",
            "schema_version": "1.0",
            "policy_type": "tpm2-rats-hardware-admission",
            "blade_id": self.blade_id,
            "status": "pre-enrolled",
            "admission_verdict": "APPROVED",
            "hardware": {
                "architecture": self.architecture,
                "mac_address": self.mac_address,
                "chassis_serial": self.chassis_serial,
            },
            "networking": {
                "wireguard_ip": self.wireguard_ip,
                "wireguard_pubkey": self.wireguard_pubkey,
            },
            "security": {
                "tpm_ek_fingerprint": self.ek_fingerprint,
                "allowed_pcr_baselines": self.pcr_baselines,
                "rat_profile": "rfc9334-tpm2-quote",
            },
            "authorized_roles": self.roles,
            "created_at": now_utc,
            "zero_touch_eligible": True,
        }


def extract_fingerprint_from_pem(pem_str: str) -> str:
    """Extract SHA-256 fingerprint from PEM certificate or key content."""
    pem_clean = pem_str.strip()
    try:
        der = ssl.PEM_cert_to_DER_cert(pem_clean)
        return hashlib.sha256(der).hexdigest().lower()
    except Exception:
        pass

    # Fallback to manual base64 decoding of PEM body
    lines = pem_clean.splitlines()
    body_lines = [line.strip() for line in lines if not line.strip().startswith("-----")]
    b64_str = "".join(body_lines)
    try:
        der_bytes = base64.b64decode(b64_str)
        if not der_bytes:
            raise ValidationError("PEM decoding resulted in 0 bytes")
        return hashlib.sha256(der_bytes).hexdigest().lower()
    except Exception as exc:
        raise ValidationError(f"Failed to decode PEM certificate body: {exc}")


def extract_fingerprint_from_bytes(raw_bytes: bytes) -> str:
    """Extract SHA-256 fingerprint from raw binary or PEM bytes."""
    if not raw_bytes:
        raise ValidationError("Certificate payload is empty (0 bytes)")
    try:
        text = raw_bytes.decode("utf-8")
        if "-----BEGIN" in text:
            return extract_fingerprint_from_pem(text)
    except UnicodeDecodeError:
        pass
    return hashlib.sha256(raw_bytes).hexdigest().lower()


def parse_and_validate_ek(val: Any, blade_id: str = "") -> str:
    """
    Validates and normalizes TPM 2.0 Endorsement Key (EK) fingerprint or certificate.
    STRICT SECURITY RULE:
    Reject wildcard ('*'), empty, missing, or malformed TPM EK fingerprints with explicit validation error!
    """
    prefix = f"Blade '{blade_id}': " if blade_id else ""

    if val is None:
        raise ValidationError(f"{prefix}Missing required TPM EK fingerprint/certificate")

    if not isinstance(val, (str, bytes)):
        raise ValidationError(f"{prefix}Invalid TPM EK data type: expected string or bytes, got {type(val).__name__}")

    if isinstance(val, bytes):
        return extract_fingerprint_from_bytes(val)

    s = val.strip()
    if not s:
        raise ValidationError(f"{prefix}Empty TPM EK fingerprint or certificate is strictly forbidden")

    # STRICT RULE: Wildcards ('*') are strictly forbidden
    if "*" in s:
        raise ValidationError(f"{prefix}Wildcard ('*') TPM EK certificates or fingerprints are strictly forbidden")

    # If it is a file path, read file
    if os.path.isfile(s):
        try:
            with open(s, "rb") as fh:
                file_bytes = fh.read()
            return extract_fingerprint_from_bytes(file_bytes)
        except Exception as exc:
            raise ValidationError(f"{prefix}Failed reading TPM EK certificate file '{s}': {exc}")

    # If it contains PEM header
    if "-----BEGIN" in s:
        return extract_fingerprint_from_pem(s)

    # Normalize hex fingerprint
    norm = s.lower()
    if norm.startswith("sha256:"):
        norm = norm[7:].strip()
    elif norm.startswith("urn:"):
        norm = norm.split(":")[-1].strip()

    norm = re.sub(r"[:\s\-]", "", norm)

    if len(norm) != 64:
        raise ValidationError(
            f"{prefix}Malformed TPM EK fingerprint length: expected 64 hex characters, got {len(norm)} ('{s}')"
        )

    if not HEX64_REGEX.fullmatch(norm):
        raise ValidationError(
            f"{prefix}Malformed TPM EK fingerprint: contains non-hexadecimal characters ('{s}')"
        )

    return norm


def validate_blade(blade_dict: dict, blade_id_key: Optional[str] = None) -> BladeRecord:
    """Validate a single blade dictionary against hardware and security specifications."""
    if not isinstance(blade_dict, dict):
        raise ValidationError(f"Blade definition must be a TOML table/dict, got {type(blade_dict).__name__}")

    # 1. Blade ID
    raw_id = blade_dict.get("id") or blade_id_key or ""
    raw_id = str(raw_id).strip()
    if not raw_id:
        raise ValidationError("Missing blade ID")
    if "*" in raw_id:
        raise ValidationError(f"Wildcard in blade ID is forbidden: '{raw_id}'")
    if not BLADE_ID_REGEX.fullmatch(raw_id):
        raise ValidationError(f"Invalid blade ID '{raw_id}': must be alphanumeric with hyphens or underscores")

    # 2. TPM EK Fingerprint / Certificate (STRICT SECURITY RULE)
    ek_raw = (
        blade_dict.get("ek_fingerprint")
        or blade_dict.get("tpm_ek_fingerprint")
        or blade_dict.get("ek_sha256")
        or blade_dict.get("ek_cert")
        or blade_dict.get("ek_certificate")
    )
    if ek_raw is None:
        raise ValidationError(f"Blade '{raw_id}' is missing required TPM EK fingerprint/certificate")
    ek_fingerprint = parse_and_validate_ek(ek_raw, blade_id=raw_id)

    # 3. MAC Address
    mac = (
        blade_dict.get("mac")
        or blade_dict.get("mac_address")
        or blade_dict.get("ethernet_mac")
    )
    if not mac:
        raise ValidationError(f"Blade '{raw_id}' is missing required MAC address")
    mac = str(mac).strip()
    if "*" in mac:
        raise ValidationError(f"Wildcard MAC address is forbidden for blade '{raw_id}'")
    if not MAC_REGEX.fullmatch(mac):
        raise ValidationError(
            f"Invalid MAC address format '{mac}' for blade '{raw_id}' (expected standard XX:XX:XX:XX:XX:XX)"
        )

    # 4. Architecture
    arch = blade_dict.get("architecture") or blade_dict.get("arch")
    if not arch:
        raise ValidationError(f"Blade '{raw_id}' is missing required architecture")
    arch = str(arch).strip().lower()
    if arch in ("x86_64", "amd64"):
        norm_arch = "x86_64"
    elif arch in ("aarch64", "arm64"):
        norm_arch = "aarch64"
    else:
        raise ValidationError(
            f"Unsupported architecture '{arch}' for blade '{raw_id}': must be 'x86_64' or 'aarch64'"
        )

    # 5. Chassis Serial
    serial = blade_dict.get("serial") or blade_dict.get("chassis_serial")
    if not serial:
        raise ValidationError(f"Blade '{raw_id}' is missing required chassis serial")
    serial = str(serial).strip()
    if "*" in serial or not serial:
        raise ValidationError(f"Wildcard or empty chassis serial is forbidden for blade '{raw_id}'")

    # 6. WireGuard / Mesh IP
    wg_ip = (
        blade_dict.get("wireguard_ip")
        or blade_dict.get("mesh_ip")
        or blade_dict.get("ip")
    )
    if not wg_ip:
        raise ValidationError(f"Blade '{raw_id}' is missing required wireguard/mesh IP")
    wg_ip = str(wg_ip).strip()
    if "*" in wg_ip:
        raise ValidationError(f"Wildcard wireguard/mesh IP is forbidden for blade '{raw_id}'")
    try:
        if "/" in wg_ip:
            ipaddress.ip_interface(wg_ip)
        else:
            ipaddress.ip_address(wg_ip)
    except ValueError as exc:
        raise ValidationError(f"Invalid wireguard/mesh IP '{wg_ip}' for blade '{raw_id}': {exc}")

    # Optional WireGuard Public Key
    wg_pubkey = (
        blade_dict.get("wireguard_pubkey")
        or blade_dict.get("mesh_pubkey")
        or blade_dict.get("pubkey")
        or ""
    )
    if wg_pubkey:
        wg_pubkey = str(wg_pubkey).strip()
        try:
            raw_b64 = base64.b64decode(wg_pubkey)
            if len(raw_b64) != 32:
                raise ValidationError(f"WireGuard public key must decode to 32 bytes, got {len(raw_b64)}")
        except Exception as exc:
            raise ValidationError(f"Invalid WireGuard public key for blade '{raw_id}': {exc}")

    # Authorized Roles
    roles_raw = blade_dict.get("roles") or blade_dict.get("authorized_roles") or ["worker"]
    if isinstance(roles_raw, str):
        roles = [r.strip() for r in roles_raw.split(",") if r.strip()]
    elif isinstance(roles_raw, list):
        roles = [str(r).strip() for r in roles_raw if str(r).strip()]
    else:
        roles = ["worker"]

    # Allowed PCR Baselines (PCR 0, 7, 11)
    pcr_raw = blade_dict.get("pcr_baselines") or blade_dict.get("pcrs") or {}
    pcr_baselines: Dict[str, str] = {}
    for pcr_num in ["0", "7", "11"]:
        val = pcr_raw.get(pcr_num) or pcr_raw.get(f"pcr{pcr_num}")
        if val:
            clean_hash = re.sub(r"[:\s\-]", "", str(val)).lower()
            if not HEX64_REGEX.fullmatch(clean_hash):
                raise ValidationError(
                    f"Blade '{raw_id}': PCR {pcr_num} baseline must be a 64 hex SHA-256 digest, got '{val}'"
                )
            pcr_baselines[pcr_num] = clean_hash
        else:
            pcr_baselines[pcr_num] = "0" * 64

    return BladeRecord(
        blade_id=raw_id,
        architecture=norm_arch,
        mac_address=mac,
        chassis_serial=serial,
        wireguard_ip=wg_ip,
        ek_fingerprint=ek_fingerprint,
        wireguard_pubkey=wg_pubkey,
        roles=roles,
        pcr_baselines=pcr_baselines,
        raw_config=blade_dict,
    )


def load_toml_file(path: str) -> dict:
    """Load a TOML configuration file using tomllib/tomli."""
    if not os.path.isfile(path):
        raise FileNotFoundError(f"Configuration file not found: {path}")
    if toml_parser is None:
        raise RuntimeError("No TOML parser available (Python 3.11+ tomllib or tomli required)")
    with open(path, "rb") as fh:
        return toml_parser.load(fh)


def load_config_data(config_path: Optional[str] = None) -> dict:
    """
    Load layered mios.toml configuration.
    If config_path is specified, loads that file directly.
    Otherwise attempts mios_toml resolver from /usr/lib/mios, falling back to standard paths.
    """
    if config_path:
        return load_toml_file(config_path)

    # 1. Try importing mios_toml from shared library
    try:
        sys.path.insert(0, "/usr/lib/mios")
        here_parent = Path(__file__).resolve().parent.parent.parent
        sys.path.insert(0, str(here_parent / "usr" / "lib" / "mios"))
        import mios_toml
        return mios_toml.load_merged()
    except Exception:
        pass

    # 2. Fallback to standard locations
    for candidate in [
        "/etc/mios/mios.toml",
        "/usr/share/mios/mios.toml",
        os.path.expanduser("~/.config/mios/mios.toml"),
    ]:
        if os.path.isfile(candidate):
            try:
                return load_toml_file(candidate)
            except Exception:
                pass

    return {}


def _is_blade_candidate(d: Any) -> bool:
    """Check if dictionary has attributes characteristic of a hardware blade declaration."""
    if not isinstance(d, dict):
        return False
    identifying_keys = {
        "ek_fingerprint",
        "tpm_ek_fingerprint",
        "ek_sha256",
        "ek_cert",
        "ek_certificate",
        "mac",
        "mac_address",
        "wireguard_ip",
        "mesh_ip",
        "chassis_serial",
    }
    return bool(identifying_keys.intersection(d.keys()))


def extract_blade_declarations(data: dict) -> Dict[str, dict]:
    """
    Extracts raw blade declarations from TOML data.
    Inspects [cluster.blades] (and fallback [blades], [blade]).
    """
    # 1. Primary: [cluster.blades] or [cluster.blade]
    cluster_sec = data.get("cluster")
    if isinstance(cluster_sec, dict):
        blades_node = cluster_sec.get("blades")
        if blades_node is not None:
            normalized = _normalize_blades_node(blades_node, filter_candidates=False)
            if normalized:
                return normalized
        blade_node = cluster_sec.get("blade")
        if blade_node is not None:
            normalized = _normalize_blades_node(blade_node, filter_candidates=False)
            if normalized:
                return normalized

    # 2. Fallback: [blades]
    if "blades" in data:
        blades_node = data["blades"]
        normalized = _normalize_blades_node(blades_node, filter_candidates=True)
        if normalized:
            return normalized

    # 3. Fallback: [blade]
    if "blade" in data:
        blade_node = data["blade"]
        normalized = _normalize_blades_node(blade_node, filter_candidates=True)
        if normalized:
            return normalized

    return {}


def _normalize_blades_node(node: Any, filter_candidates: bool = False) -> Dict[str, dict]:
    result: Dict[str, dict] = {}
    if isinstance(node, dict):
        for k, v in node.items():
            if isinstance(v, dict):
                if filter_candidates and not _is_blade_candidate(v):
                    continue
                b = dict(v)
                b_id = b.get("id") or k
                b["id"] = b_id
                result[b_id] = b
    elif isinstance(node, list):
        for idx, item in enumerate(node):
            if isinstance(item, dict):
                if filter_candidates and not _is_blade_candidate(item):
                    continue
                b = dict(item)
                b_id = b.get("id") or f"blade-{idx:02d}"
                b["id"] = b_id
                result[b_id] = b
    return result


def get_registered_blades(
    config_path: Optional[str] = None,
    mock: bool = False,
    verbose: bool = False,
) -> Dict[str, BladeRecord]:
    """Load, validate, and return dictionary of BladeRecord instances."""
    data = load_config_data(config_path)
    raw_blades = extract_blade_declarations(data)

    if mock:
        if verbose:
            print("[INFO] Mock mode active: loading mock blade fixtures")
        for mock_id, mock_cfg in MOCK_BLADES.items():
            if mock_id not in raw_blades:
                raw_blades[mock_id] = mock_cfg

    validated_blades: Dict[str, BladeRecord] = {}
    for blade_id, blade_cfg in raw_blades.items():
        validated = validate_blade(blade_cfg, blade_id_key=blade_id)
        validated_blades[validated.blade_id] = validated

    return validated_blades


