#!/usr/bin/env python3
# AI-hint: Generates the initial Headscale config.yaml by reading mios.toml [headscale], [metal.mesh] and [ports] SSOT, ensuring state directories and database paths exist before the container starts.
# AI-related: /etc/headscale/config.yaml, /usr/share/mios/mios.toml, /etc/mios/mios.toml, /var/lib/headscale, mios-headscale
"""'MiOS' Headscale mesh VPN coordinator first-boot config generator.

Writes /etc/headscale/config.yaml from the [headscale] + [metal.mesh] + [ports] SSOT in
mios.toml (layered: vendor /usr/share/mios/mios.toml < host /etc/mios/mios.toml).

Idempotent + non-destructive: if the config file already exists it does NOTHING
(Headscale state/sqlite remains preserved across runs). Pass --force to regenerate.
"""
from __future__ import annotations
import os
import pwd
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios"))
import mios_toml  # noqa: E402  -- the ONE shared layered-mios.toml resolver

CONF_DIR = "/etc/headscale"
CONF_PATH = os.path.join(CONF_DIR, "config.yaml")
STATE_DIR = "/var/lib/headscale"
RUN_DIR = "/var/run/headscale"
VENDOR_TOML = "/usr/share/mios/mios.toml"
HOST_TOML = "/etc/mios/mios.toml"
SVC_USER = "mios-headscale"


def _log(msg: str) -> None:
    print(f"[mios-headscale-firstboot] {msg}", flush=True)


def _load_layered_toml() -> dict:
    """Overlay vendor < host (host wins) via the shared resolver -- no per-user layer."""
    return mios_toml.load_merged(layers=[VENDOR_TOML, HOST_TOML])


def _ensure_dirs(uid: int, gid: int) -> None:
    for d in (CONF_DIR, STATE_DIR, RUN_DIR):
        try:
            os.makedirs(d, mode=0o750, exist_ok=True)
            if uid >= 0 and gid >= 0:
                os.chown(d, uid, gid)
        except OSError as e:
            _log(f"Warning: could not create or chown directory {d}: {e}")


def _build_config_yaml(data: dict) -> str:
    ports_sec = data.get("ports", {})
    hs_sec = data.get("headscale", {})
    mesh_sec = data.get("metal", {}).get("mesh", {})  # ONE home of the tailnet domain + prefix

    port = int(ports_sec.get("headscale", 8085))
    base_domain = str(mesh_sec.get("headscale_domain", "mesh.mios.local"))
    vnet_cidr = str(mesh_sec.get("vnet_cidr", "100.64.0.0/10"))
    server_url = str(hs_sec.get("server_url", f"http://{base_domain}:{port}"))
    listen_addr = str(hs_sec.get("listen_addr", f"0.0.0.0:{port}"))
    metrics_listen = str(hs_sec.get("metrics_listen_addr", "127.0.0.1:9090"))
    grpc_listen = str(hs_sec.get("grpc_listen_addr", "127.0.0.1:50443"))
    db_path = str(hs_sec.get("db_path", "/var/lib/headscale/db.sqlite"))
    policy_path = str(hs_sec.get("policy_path", "/usr/share/mios/mini/headscale-policy.hujson"))

    return f"""# Generated by /usr/libexec/mios/mios-headscale-firstboot from mios.toml SSOT
server_url: {server_url}
listen_addr: {listen_addr}
metrics_listen_addr: {metrics_listen}
grpc_listen_addr: {grpc_listen}
grpc_allow_insecure: false

private_key_path: /var/lib/headscale/private.key
noise:
  private_key_path: /var/lib/headscale/noise_private.key

prefixes:
  v4: {vnet_cidr}
  v6: fd7a:115c:a1e0::/48

derp:
  server:
    enabled: false
  urls: []
  paths: []
  auto_update_enabled: false
  update_frequency: 24h

disable_check_updates: true
ephemeral_node_inactivity_timeout: 30m

database:
  type: sqlite3
  sqlite:
    path: {db_path}

dns:
  magic_dns: true
  base_domain: {base_domain}
  nameservers:
    split: {{}}
    global:
      - 100.64.0.1

log:
  format: text
  level: info

policy:
  mode: file
  path: {policy_path}
"""


def main() -> int:
    force = "--force" in sys.argv

    uid = -1
    gid = -1
    try:
        pw = pwd.getpwnam(SVC_USER)
        uid = pw.pw_uid
        gid = pw.pw_gid
    except KeyError:
        pass

    _ensure_dirs(uid, gid)

    if os.path.exists(CONF_PATH) and not force:
        _log(f"{CONF_PATH} already exists; leaving untouched (use --force to overwrite)")
        return 0

    data = _load_layered_toml()
    yaml_content = _build_config_yaml(data)

    tmp_path = CONF_PATH + ".tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            f.write(yaml_content)
        os.replace(tmp_path, CONF_PATH)
        os.chmod(CONF_PATH, 0o640)
        if uid >= 0 and gid >= 0:
            os.chown(CONF_PATH, uid, gid)
        _log(f"Generated {CONF_PATH} successfully")
    except OSError as e:
        _log(f"Error writing {CONF_PATH}: {e}")
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
