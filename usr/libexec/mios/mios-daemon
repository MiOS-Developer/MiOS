def _toml_db_backend() -> str:
    """SSOT: [dispatch] db_backend from the layered mios.toml (vendor < /etc).
    Mirrors the agent-pipe so the whole agent plane flips together at the
    legacy->pgvector cutover (R15/G11). Env MIOS_PGVECTOR_DB_BACKEND still wins."""
    val = "dual"
    layers = [os.environ.get("MIOS_TOML", "/usr/share/mios/mios.toml"),
              "/etc/mios/mios.toml"]
    _b = mios_toml.get("dispatch", "db_backend", None,
                       data=mios_toml.load_merged(layers))
    if _b:
        val = str(_b).strip().lower()
    return val


DB_BACKEND = (os.environ.get("MIOS_PGVECTOR_DB_BACKEND")
