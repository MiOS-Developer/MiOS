        if "${VENV}/bin/python3" - "$VLLM_MODEL" "$VLLM_DIR" <<'PY' 2>/dev/null; then
import sys
import time
import os
from huggingface_hub import snapshot_download
model, dest = sys.argv[1], sys.argv[2]
success = False
for attempt in range(1, 4):
    try:
        snapshot_download(repo_id=model, local_dir=dest,
                          ignore_patterns=["*.pth", "original/*", "*.gguf"])
        if os.path.isfile(os.path.join(dest, "config.json")):
            success = True
            break
        else:
            raise Exception("config.json missing after download")
    except Exception as e:
        sys.stderr.write(f"Attempt {attempt} failed: {e}\n")
        if attempt < 3:
            time.sleep(2 ** attempt)
if success:
    sys.exit(0)
else:
    sys.exit(1)
PY
            touch /var/lib/mios/.vllm-firstboot-done
            log "VLLM model weights provisioned for ${VLLM_MODEL}"
            systemctl reset-failed mios-llm-heavy 2>/dev/null
            systemctl restart mios-llm-heavy 2>/dev/null || true
        else
            log "WARN: vLLM model weights fetch failed"
        fi
    else
        log "WARN: agent venv python not available"
    fi
fi

