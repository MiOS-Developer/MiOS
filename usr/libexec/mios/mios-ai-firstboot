#!/usr/bin/env bash
# AI-hint: Provisioning script that installs the hermes-agent Python venv and fetches llama.cpp GGUF models, vLLM weights and firstboot-tier images (unless [ai].firstboot_pulls is false), creating a sentinel file to gate retries.
# AI-related: /usr/share/mios/llamacpp/mios-llm-light.yaml, /usr/lib/mios/agents/.venv, /usr/share/mios/llamacpp/models, /usr/libexec/mios/72-hermes-agent.sh, /etc/mios/containers/coderun-sandbox, mios-coderun-sandbox, mios-coderun-session, mios-ai, mios-agent-pipe, mios-llm-light
# AI-functions: log
set +eu
log(){ logger -t mios-ai-firstboot "$*" 2>/dev/null; echo "[mios-ai-firstboot] $*"; }

if [ -f /etc/mios/install.env ]; then
    _mios_had_u=0; case "$-" in *u*) _mios_had_u=1;; esac
    set +u; set -a; . /etc/mios/install.env 2>/dev/null || true; set +a
    [ "$_mios_had_u" = 1 ] && set -u
fi

VENV=/usr/lib/mios/agents/.venv
MODELS=/usr/share/mios/llamacpp/models

# [ai].firstboot_pulls from the LAYERED SSOT (default true). A cloud or container
# deployment's [deployment.cloud] host drop-in sets it false: no GGUF or vLLM weight
# and no firstboot-tier inference image is downloaded. That leaves the done-sentinel
# unwritten, so removing the drop-in resumes the pulls at the next timer run.
MIOS_TOML_GET="${MIOS_TOML_GET:-/usr/libexec/mios/mios-toml-get}"
PULLS=true
[ -x "$MIOS_TOML_GET" ] && PULLS="$("$MIOS_TOML_GET" ai firstboot_pulls true 2>/dev/null)"
if [ "$PULLS" = false ]; then
    log "[ai].firstboot_pulls is false (cloud/container deployment): skipping model and inference-image pulls"
fi

if [ "$(systemd-detect-virt 2>/dev/null)" = "wsl" ]; then
    install -d -m 0755 /var/lib/mios/llamacpp/models /var/lib/mios/vllm/model 2>/dev/null
    if [ -d "$MODELS" ] && [ ! -L "$MODELS" ]; then
        if [ -n "$(ls -A "$MODELS" 2>/dev/null)" ]; then
            mv -f "$MODELS"/* /var/lib/mios/llamacpp/models/ 2>/dev/null || true
        fi
        rmdir "$MODELS" 2>/dev/null || rm -rf "$MODELS" 2>/dev/null || true
    fi
    if [ ! -e "$MODELS" ]; then
        ln -sf /var/lib/mios/llamacpp/models "$MODELS"
    fi
    _vdir="/usr/share/mios/vllm/model"
    if [ -d "$_vdir" ] && [ ! -L "$_vdir" ]; then
        if [ -n "$(ls -A "$_vdir" 2>/dev/null)" ]; then
            mv -f "$_vdir"/* /var/lib/mios/vllm/model/ 2>/dev/null || true
        fi
        rmdir "$_vdir" 2>/dev/null || rm -rf "$_vdir" 2>/dev/null || true
    fi
    if [ ! -e "$_vdir" ]; then
        ln -sf /var/lib/mios/vllm/model "$_vdir"
    fi
fi

if [ ! -x "${VENV}/bin/hermes" ]; then
    if ! command -v python3.13 >/dev/null 2>&1; then
        log "Installing python3.13"
        dnf install -y python3.13 python3.13-devel >/dev/null 2>&1 || log "WARN: python3.13 install failed"
    fi
    HSCRIPT=""
    for p in /mnt/m/automation/72-hermes-agent.sh /mnt/c/MiOS/automation/72-hermes-agent.sh /usr/libexec/mios/72-hermes-agent.sh /automation/72-hermes-agent.sh; do
        [ -f "$p" ] && [ -f "$(dirname "$p")/lib/common.sh" ] && HSCRIPT="$p" && break
    done
    if [ -z "$HSCRIPT" ] && [ -d /.git ]; then
        git -C / checkout -- automation 2>/dev/null
        [ -f /automation/72-hermes-agent.sh ] && [ -f /automation/lib/common.sh ] && HSCRIPT=/automation/72-hermes-agent.sh
    fi
    if [ -n "$HSCRIPT" ]; then
        log "Building shared agent venv via $HSCRIPT"
        bash "$HSCRIPT" 2>&1 | tail -12
    else
        log "WARN: 72-hermes-agent.sh not found"
    fi
    if [ ! -x "${VENV}/bin/hermes" ] && [ -d "${VENV}" ]; then
        log "Agent venv build incomplete/broken"
        rm -rf "${VENV}" 2>/dev/null || true
    fi
    if [ ! -x "${VENV}/bin/hermes" ] && command -v podman >/dev/null 2>&1; then
        for _img in localhost/mios:latest localhost/mios:day0 "${MIOS_IMAGE_REF:-ghcr.io/mios-dev/mios:latest}"; do
            podman image exists "$_img" 2>/dev/null || continue
            log "Agent venv build unavailable"
            install -d -m 0755 /usr/lib/mios/agents
            if podman run --rm --entrypoint="" "$_img" tar -C /usr/lib/mios/agents -cf - .venv 2>/dev/null \
                 | tar -C /usr/lib/mios/agents -xf - 2>/dev/null && [ -x "${VENV}/bin/hermes" ]; then
                log "Agent venv seeded from ${_img}"
                break
            fi
        done
    fi
    if [ -x "${VENV}/bin/hermes" ]; then log "agent venv ready: ${VENV}"; else log "WARN: agent venv still missing"; fi
fi

if [ "$PULLS" != false ] && [ ! -f "${MODELS}/.ready" ]; then
    install -d -m 0755 "${MODELS}" /var/lib/mios/llamacpp/slots 2>/dev/null
    SPEC="${MIOS_LLAMACPP_BAKE_MODELS:-}"
    if [ -z "$SPEC" ]; then
        log "GGUFs not baked + [llamacpp].bake_models empty"
        SPEC="lfm2-700m.gguf=LiquidAI/LFM2-700M-GGUF:LFM2-700M-Q4_K_M.gguf,embeddinggemma-300m-qat-q8_0.gguf=ggml-org/embeddinggemma-300m-qat-q8_0-GGUF:embeddinggemma-300m-qat-Q8_0.gguf"
    fi

    if [ -z "$SPEC" ]; then
        log "GGUFs not baked + [llamacpp].bake_models empty"
    else
        fetched=0; total=0
        IFS=',' read -ra _ents <<< "$SPEC"
        for entry in "${_ents[@]}"; do
            entry="$(printf '%s' "$entry" | tr -d '[:space:]')"; [ -z "$entry" ] && continue
            total=$((total + 1))
            dest="${entry%%=*}"; rest="${entry#*=}"; repo="${rest%%:*}"; file="${rest#*:}"
            if [ -z "$dest" ] || [ -z "$repo" ] || [ -z "$file" ] || [ "$dest" = "$entry" ]; then
                log "Malformed GGUF entry '${entry}'"; continue
            fi
            if [ -s "${MODELS}/${dest}" ]; then fetched=$((fetched + 1)); continue; fi
            _url="https://huggingface.co/${repo}/resolve/main/${file}"
            success=0
            for attempt in 1 2 3; do
                if curl -fL -C - --retry 3 --max-time 1800 \
                        -o "${MODELS}/${dest}.part" "$_url" 2>/dev/null \
                   && [ -s "${MODELS}/${dest}.part" ]; then
                    mv -f "${MODELS}/${dest}.part" "${MODELS}/${dest}"
                    success=1
                    break
                else
                    log "Attempt ${attempt}/3 to fetch GGUF ${dest} failed"
                    rm -f "${MODELS}/${dest}.part" 2>/dev/null
                    if [ "$attempt" -lt 3 ]; then
                        sleep $(( 2 ** attempt ))
                    fi
                fi
            done
            if [ "$success" -eq 1 ]; then
                fetched=$((fetched + 1)); log "GGUF ${dest} fetched from HF"
            else
                log "GGUF ${dest} fetch failed after 3 attempts"
            fi
        done
        if [ "$total" -gt 0 ] && [ "$fetched" -ge "$total" ]; then
            touch "${MODELS}/.ready"; log "GGUFs provisioned"
        else
            log "WARN: GGUFs incomplete"
        fi
    fi
fi

VLLM_MODEL="${MIOS_VLLM_BAKE_MODEL:-}"
if [ -z "$VLLM_MODEL" ] && [ -x /usr/libexec/mios/mios-toml-get ]; then
    _vram_gb=0
    _nvsmi=""
    for _c in nvidia-smi /usr/lib/wsl/lib/nvidia-smi /usr/bin/nvidia-smi /opt/cuda/bin/nvidia-smi; do
        if command -v "$_c" >/dev/null 2>&1; then _nvsmi="$_c"; break; fi
    done
    _rocmsmi=""
    for _c in rocm-smi /opt/rocm/bin/rocm-smi /usr/bin/rocm-smi; do
        if command -v "$_c" >/dev/null 2>&1; then _rocmsmi="$_c"; break; fi
    done
    if [ -n "$_nvsmi" ]; then
        _vram_mib="$("$_nvsmi" --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | awk 'BEGIN{m=0} {if ($1+0 > m) m=$1+0} END{print m}')"
        _vram_gb=$(( ${_vram_mib:-0} / 1024 ))
    elif [ -n "$_rocmsmi" ]; then
        _vram_mib="$("$_rocmsmi" --showmeminfo vram --csv 2>/dev/null | awk -F, 'NR>1 {gsub(/[^0-9]/,"",$2); if ($2+0 > m) m=$2+0} END{print m+0}')"
        _vram_gb=$(( ${_vram_mib:-0} / 1024 / 1024 / 1024 ))
    fi

    _big_vram="$(/usr/libexec/mios/mios-toml-get ai.host_thresholds big_vram_gb '16')"
    _mid_vram="$(/usr/libexec/mios/mios-toml-get ai.host_thresholds mid_vram_gb '8')"
    if [ "$_vram_gb" -ge "$_big_vram" ]; then
        VLLM_MODEL="$(/usr/libexec/mios/mios-toml-get ai.host_thresholds big_ram_model 'mistral-magistral-small-2509')"
    elif [ "$_vram_gb" -ge "$_mid_vram" ]; then
        VLLM_MODEL="$(/usr/libexec/mios/mios-toml-get ai.host_thresholds mid_ram_model 'qwen3.5:9b')"
    else
        VLLM_MODEL="$(/usr/libexec/mios/mios-toml-get ai.host_thresholds small_ram_model 'granite4.1:8b')"
    fi
fi
