        _db_config_ok=0
        log "DEGRADED: database config seeding (seed-db-config.py) failed or skipped"
    fi
fi

FBLIST="/usr/lib/mios/bake/plan.d/firstboot.list"
if [ "$PULLS" != false ] && [ -f "$FBLIST" ] && command -v podman >/dev/null 2>&1; then
    log "Pre-staging firstboot-tier images from $FBLIST"
    STORE="${STORE:-/usr/lib/containers/storage}"
    while IFS= read -r fb_img; do
        fb_img="$(echo "$fb_img" | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//')"
        [ -z "$fb_img" ] && continue
        # localhost/ firstboot-tier images are BUILT on-host (mios-webtools-
        # firstboot.service build-if-missing), never web-pulled -- a pull of a
        # localhost ref can only retry-spin against a registry that isn't there.
        case "$fb_img" in
            localhost/*)
                log "Firstboot-tier image $fb_img is locally built (webtools firstboot); skipping web pre-stage"
                continue
                ;;
        esac
        if podman --root "$STORE" image exists "$fb_img" 2>/dev/null; then
            log "Firstboot-tier image $fb_img already present in store"
            continue
        fi
        log "Pulling firstboot-tier image: $fb_img"
        _fb_pulled=0
        for _fb_try in 1 2 3; do
            if podman --root "$STORE" pull "$fb_img" >/dev/null 2>&1; then
                _fb_pulled=1
                break
            fi
            sleep $((_fb_try * 2))
        done
        if [ "$_fb_pulled" -eq 1 ]; then
            log "Pre-staged firstboot-tier image $fb_img successfully"
        else
            log "WARN: could not pre-stage firstboot-tier image $fb_img"
        fi
    done < "$FBLIST"
fi

systemctl daemon-reload 2>/dev/null
for s in mios-gateway-agent mios-agent-pipe; do
    systemctl reset-failed "${s}" 2>/dev/null
    systemctl restart --no-block "${s}" 2>/dev/null || true
done
systemctl reset-failed mios-llm-light 2>/dev/null
systemctl restart mios-llm-light 2>/dev/null || true

install -d -m 0755 /var/lib/mios 2>/dev/null
_ggufs_ok=0; [ -f "${MODELS}/.ready" ] && _ggufs_ok=1
_vllm_ok=1
if [ -n "${MIOS_VLLM_BAKE_MODEL:-}" ] && [ ! -f "/var/lib/mios/.vllm-firstboot-done" ]; then
    _vllm_ok=0
fi

_db_ok=1
if [ "$_db_seed_ok" -ne 1 ] || [ "$_db_config_ok" -ne 1 ]; then
    _db_ok=0
fi

if [ -x "${VENV}/bin/hermes" ] && [ "$_ggufs_ok" -eq 1 ] && [ "$_vllm_ok" -eq 1 ] && [ "$_db_ok" -eq 1 ]; then
    touch /var/lib/mios/.ai-firstboot-done
    log "Complete"
    exit 0
else
    log "WARNING: incomplete (venv=$( [ -x "${VENV}/bin/hermes" ] && echo ok || echo missing ) ggufs=$( [ "$_ggufs_ok" -eq 1 ] && echo ok || echo missing ) vllm=$( [ "$_vllm_ok" -eq 1 ] && echo ok || echo missing ) db=$( [ "$_db_ok" -eq 1 ] && echo ok || echo "skipped/degraded" )) -- degrading open (exit 0); mios-ai-firstboot.timer retries until the sentinel lands"
    exit 0
fi
