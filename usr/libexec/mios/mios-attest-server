]

def resolve_attest_port() -> int:
    for cfg_p in DEFAULT_CONFIG_PATHS:
        if cfg_p.is_file() and toml_parser:
            try:
                with open(cfg_p, "rb") as fh:
                    cfg = toml_parser.load(fh)
                    p = cfg.get("ports", {}).get("attest") or cfg.get("ports", {}).get("attest_server")
                    if p:
                        return int(p)
            except Exception:
                pass
    return 8443

