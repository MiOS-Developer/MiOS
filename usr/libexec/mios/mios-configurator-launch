#!/usr/bin/env bash
# AI-hint: Opens the unified MiOS Settings surface. PRIMARY target is the configurator embedded in the MiOS Portal at /configure on the `agent_pipe` port (probed with curl); only when the Portal is unreachable does it fall back to the standalone HTML configurator staged in ~/Downloads and opened via file:// (offline / USB, ADR-0008).
# AI-related: /usr/libexec/mios/mios-configurator-launch, /usr/share/mios/configurator/mios.html, /configure on the `agent_pipe` port, /etc/mios/mios.toml, /usr/share/mios/mios.toml, mios-configurator, mios-open-url, mios-rebuild
set -euo pipefail

HTML=/usr/share/mios/configurator/mios.html
DL_DIR="${HOME}/Downloads"

stage_offline() {
    mkdir -p "$DL_DIR"

    if [[ ! -f "${HOME}/.config/user-dirs.dirs" ]]; then
        mkdir -p "${HOME}/.config"
        if command -v xdg-user-dirs-update >/dev/null 2>&1; then
            xdg-user-dirs-update --force >/dev/null 2>&1 || true
        fi
        if [[ ! -f "${HOME}/.config/user-dirs.dirs" ]]; then
            cat > "${HOME}/.config/user-dirs.dirs" <<EOF
XDG_DESKTOP_DIR="\$HOME/Desktop"
XDG_DOWNLOAD_DIR="\$HOME/Downloads"
XDG_TEMPLATES_DIR="\$HOME/Templates"
XDG_PUBLICSHARE_DIR="\$HOME/Public"
XDG_DOCUMENTS_DIR="\$HOME/Documents"
XDG_MUSIC_DIR="\$HOME/Music"
XDG_PICTURES_DIR="\$HOME/Pictures"
XDG_VIDEOS_DIR="\$HOME/Videos"
EOF
            chmod 0644 "${HOME}/.config/user-dirs.dirs"
        fi
    fi

    if [[ ! -f "$DL_DIR/mios.toml" ]]; then
        for src in "$HOME/.config/mios/mios.toml" /etc/mios/mios.toml /usr/share/mios/mios.toml; do
            if [[ -r "$src" ]]; then
                cp "$src" "$DL_DIR/mios.toml"
                chmod 0644 "$DL_DIR/mios.toml"
                break
            fi
        done
    fi

    if [[ -r "$HTML" ]]; then
        cp "$HTML" "$DL_DIR/mios-configurator.html"
    fi
}

TOKEN_DIR="${XDG_RUNTIME_DIR:-/tmp}/mios"
mkdir -p "$TOKEN_DIR"
chmod 0700 "$TOKEN_DIR" 2>/dev/null || true
TOKEN_FILE="$TOKEN_DIR/portal-token"

TOKEN=""
if command -v openssl >/dev/null 2>&1; then
    TOKEN=$(openssl rand -hex 32 2>/dev/null || true)
fi
if [[ ${#TOKEN} -ne 64 && -r /dev/urandom ]]; then
    TOKEN=$(od -vN 32 -An -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || true)
fi
if [[ ${#TOKEN} -ne 64 && -r /dev/urandom ]]; then
    TOKEN=$(tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null | head -c 64 || true)
fi
if [[ ${#TOKEN} -ne 64 ]]; then
    TOKEN=$(printf "%08x%08x%08x%08x%08x%08x%08x%08x" $RANDOM $RANDOM $RANDOM $RANDOM $RANDOM $RANDOM $RANDOM $RANDOM)
fi

(umask 0177 && printf "%s" "$TOKEN" > "$TOKEN_FILE")
chmod 0600 "$TOKEN_FILE" 2>/dev/null || true

CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 1 "http://localhost:${MIOS_PORTS_AGENT_PIPE:-8700}/configure?token=${TOKEN}" || echo "000")

if [[ "$CODE" != "303" && "$CODE" != "200" ]]; then
    _here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    _miosd=""
    for _c in "${MIOS_MIOSD_BIN:-}" /usr/libexec/mios/miosd "$_here/../../src/mios-rs/target/release/miosd" "$_here/../../src/mios-rs/target/debug/miosd"; do
        if [[ -n "$_c" && -x "$_c" ]]; then _miosd="$_c"; break; fi
    done
    if [[ -n "$_miosd" ]]; then
        "$_miosd" config-server --port "${MIOS_PORTS_AGENT_PIPE:-8700}" --token "$TOKEN" >/dev/null 2>&1 &
        disown
        sleep 0.2
        CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 1 "http://localhost:${MIOS_PORTS_AGENT_PIPE:-8700}/configure?token=${TOKEN}" || echo "000")
    fi
fi

if [[ "$CODE" == "303" || "$CODE" == "200" ]]; then
    URL="http://localhost:${MIOS_PORTS_AGENT_PIPE:-8700}/configure?token=${TOKEN}"
else
    stage_offline
    URL="file://$DL_DIR/mios-configurator.html"
    [[ ! -f "$DL_DIR/mios-configurator.html" ]] && URL="file://$HTML"
fi

if command -v mios-open-url >/dev/null 2>&1; then
    mios-open-url "$URL" >/dev/null 2>&1 &
    disown
    echo "MiOS Settings opened via mios-open-url: $URL"
    exit 0
fi

if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$URL" >/dev/null 2>&1 &
    disown
    echo "MiOS Settings opened via xdg-open: $URL"
    exit 0
fi

echo "MiOS Settings URL:"
echo "  $URL"
echo "Open it in a browser to edit your configuration"
exit 0
