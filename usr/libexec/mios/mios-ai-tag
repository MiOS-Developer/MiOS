#!/usr/bin/env python3
# AI-hint: Codebase tagger -- writes a rich, structured AI header on every file.
# AI-related: mios-codebase-index, mios-bootstrap, mios-llm-light (port key `llm_light`)
"""'MiOS' AI-tagger -- a rich, agent-useful AI header on every file.

Goal (operator 2026-06-13): every file in both MiOS repos carries a header that
is descriptive of its USE + PURPOSE, the RELATED files/services it touches, and
the FUNCTIONS/entrypoints it defines -- so an agent knows what a file is for, what
it depends on, and what it exposes, without reading the whole thing.

Header block (comment-syntax + shebang aware, line-ending preserving):

Reuse keeps it cheap: an existing AI-hint is kept verbatim; only files lacking one
hit the teacher. JSON (no comments) + binaries are skipped.

Usage:
  mios-ai-tag --root /mnt/c/MiOS --root /mnt/c/mios-bootstrap \
              --manifest /var/lib/mios/finetune/ai-tag-rich.manifest
  mios-ai-tag --root DIR --no-llm     # never call the teacher (reuse/extract only)
  mios-ai-tag --root DIR --dry-run --limit 5
  mios-ai-tag --selftest              # execute self-test suite
"""
from __future__ import annotations
import argparse
import json
import os
import re
import sys
import urllib.request

EXT = {
    ".md", ".sh", ".bash", ".py", ".toml", ".yaml", ".yml", ".container",
    ".service", ".path", ".timer", ".socket", ".mount", ".target", ".conf",
    ".te", ".fc", ".if", ".html", ".js", ".css", ".ps1", ".rules", ".env",
    ".sql", ".jinja", ".j2", ".repo", ".ini", ".cfg", ".network", ".volume",
    ".pod", ".build", ".image", ".kargs", ".bu", ".tmpl", ".in", ".preset",
    ".desktop", ".pp", ".spec", ".star", ".txt", ".gitignore", ".gitattributes",
    ".editorconfig", ".dockerignore", ".cron", ".sudoers", ".pam", ".mod", ".bat",
    ".cmd", ".rs", ".snap", ".psm1", ".qml", ".nft", ".ks", ".template", ".defaults",
}
BASENAMES = {
    "Containerfile", "Dockerfile", "Justfile", "justfile", "Makefile",
    "Modelfile", "Kitfile", ".gitignore", ".gitattributes", ".dockerignore",
    ".editorconfig", ".bashrc", ".profile",
}
# Files that stay header-free are not taggable, rather than counted against
# [ai_tag].max_untagged: a header would leak into an agent-harness prompt, make a
# vendored or Law 15 mirrored copy differ from its source, be overwritten by the
# generator that owns the file, or corrupt a format with no comment syntax.
# Multi-component and (^|/)-anchored, so a code dir that only shares a name
# (usr/lib/mios/agents) stays taggable, on root-relative and absolute paths alike.
SKIP_DIR = re.compile(
    r"(^|/)(\.git|\.venv|venv|node_modules|site-packages|__pycache__|web_dist|"
    r"dist|assets|\.cache|\.mypy_cache|\.pytest_cache|\.ruff_cache|target|"
    r"base-qwen[^/]*|\.idea|\.vscode-test|finetune/venv|\.gemini|\.rustup|"
    r"\.tmp\.driveupload|tr_clone|tr_remote|shellcheck-v[0-9.]+|"
    # agent-harness prompts
    r"\.agents|\.claude/commands|\.github/agents|commands/(claude|codex|copilot|spark)|"
    # vendored upstream, applied migrations, template-compiler snapshots,
    # verbatim reference snippets
    r"usr/share/mios/(vendored|extensions|postgres/migrations)|tests/templates/golden|"
    r"docs/agy/w10-live-boot)(/|$)")
SKIP_SUFFIX = re.compile(
    r"\.(gguf|safetensors|bin|pt|pth|onnx|png|jpg|jpeg|gif|ico|webp|svg|woff2?|"
    r"ttf|otf|so|o|a|zip|gz|xz|zst|tar|whl|pyc|wasm|pdf|mp4|mp3|lock)$|"
    # JSON has no comment syntax
    r"\.json\.tmpl$|"
    # prompts, generator outputs, the Law 15 mirror, MiosServiceTool configs
    r"(^|/)(\.mios/system-prompt\.md|\.prompt\.md|TASKS\.md|automation/lib/globals\.(sh|ps1)|"
    r"usr/share/mios/(names\.generated\.txt|referenced_names\.txt|reference/env-baseline\.txt)|"
    r"\.devcontainer/Containerfile|usr/share/mios/windows/MiOS-[^/]*\.cfg)$", re.I)
JSON_EXT = {".json", ".jsonl", ".map", ".csv", ".tsv"}

AI_LINE_RE = re.compile(r"^[#/<!;\-*\s]*AI-(?:hint|related|functions):.*?(-->)?\s*$", re.I)
AI_HINT_TXT_RE = re.compile(r"AI-hint:\s*(.+?)\s*(?:-->)?\s*$", re.I)


def comment_style(path: str) -> str:
    _, ext = os.path.splitext(os.path.basename(path))
    ext = ext.lower()
    if ext in (".md", ".html"):
        return "md"
    if ext == ".css":
        return "slashstar"
    if ext in (".js", ".rs", ".qml"):
        return "slash"
    if ext == ".sql":
        return "dashdash"
    return "hash"


def _pfx(style: str) -> str:
    return {"slash": "// ", "dashdash": "-- "}.get(style, "# ")


def make_block(style: str, hint: str, related: str, funcs: str) -> list[str]:
    rows = [("AI-hint", hint)]
    if related:
        rows.append(("AI-related", related))
    if funcs:
        rows.append(("AI-functions", funcs))
    if style == "md":
        if len(rows) == 1:
            return [f"<!-- AI-hint: {hint} -->"]
        body = "\n".join(f"     {k}: {v}" for k, v in rows)
        return [f"<!-- {rows[0][0]}: {rows[0][1]}\n" +
                "\n".join(f"     {k}: {v}" for k, v in rows[1:]) + " -->"]
    if style == "slashstar":
        return [f"/* {k}: {v} */" for k, v in rows]
    pfx = _pfx(style)
    return [f"{pfx}{k}: {v}" for k, v in rows]


def _ssot() -> dict:
    """mios.toml, read once. Empty dict if unreadable -- tagging must not hard-fail
    on a missing SSOT, but every value below then falls back explicitly."""
    global _SSOT_CACHE
    if _SSOT_CACHE is not None:
        return _SSOT_CACHE
    _SSOT_CACHE = {}
    try:
        import tomllib
        here = os.path.dirname(os.path.abspath(__file__))
        root = os.path.abspath(os.path.join(here, "..", "..", ".."))
        with open(os.path.join(root, "usr", "share", "mios", "mios.toml"), "rb") as fh:
            _SSOT_CACHE = tomllib.load(fh)
    except Exception:
        pass
    return _SSOT_CACHE


_SSOT_CACHE = None


def hint_cap() -> int:
    """Hint length cap, from [ai_tag].hint_max_chars.

    Was a hardcoded 260 (Law 7). That number also silently TRUNCATED existing
    hand-written hints on every re-tag, because _clean slices to it.
    """
    return int((_ssot().get("ai_tag", {}) or {}).get("hint_max_chars", 3000))


def teacher_defaults() -> tuple[str, str]:
    """(endpoint, model) from SSOT."""
    d = _ssot()
    ai_tag = d.get("ai_tag", {}) or {}
    port_key = ai_tag.get("teacher_port_key", "llm_light")
    port = (d.get("ports", {}) or {}).get(port_key, 8500)
    models = (d.get("ai", {}) or {}).get("available_models", []) or []
    model = ai_tag.get("teacher_model") or (models[0] if models else "granite4.1:3b")
    return f"http://localhost:{port}", str(model)


def _clean(s: str, n: int | None = None) -> str:
    n = hint_cap() if n is None else n
    s = re.sub(r"\s+", " ", (s or "").strip())
    return re.sub(r'^["\'\s]+|["\'\s]+$', "", s)[:n]


def existing_hint(head: str) -> str:
    lines = head.splitlines()[:40]
    for i, ln in enumerate(lines):
        m = AI_HINT_TXT_RE.search(ln)
        if m:
            parts = [m.group(1).strip().rstrip("-->").strip()]
            j = i + 1
            while j < len(lines):
                next_ln = lines[j]
                if AI_LINE_RE.search(next_ln):
                    break
                if re.match(r"^[#/<!;\-*\s]*\s{2,}\S", next_ln):
                    cont_txt = re.sub(r"^[#/<!;\-*\s]*\s{2,}", "", next_ln).strip().rstrip("-->").strip()
                    if cont_txt:
                        parts.append(cont_txt)
                    j += 1
                else:
                    break
            return _clean(" ".join(parts))
    return ""


def extract_desc(head: str, path: str) -> str:
    lines = head.splitlines()
    if lines and lines[0].strip() == "---":
        for ln in lines[1:60]:
            if ln.strip() == "---":
                break
            m = re.match(r"\s*description:\s*(.+)", ln)
            if m:
                return _clean(m.group(1).strip().strip("\"'"))
    if path.endswith(".py"):
        m = re.search(r'^\s*[ru]?("""|\x27\x27\x27)(.+?)\1', head, re.S | re.M)
        if m:
            return _clean(m.group(2))
    started = False
    for ln in lines[:30]:
        s = ln.strip()
        if not started and (s.startswith("#!") or s == "" or s == "---"
                            or re.search(r"AI-(hint|related|functions):", s, re.I)):
            continue
        if s.startswith(("# ", "// ", "* ", "-- ", "<!-- ")) or s in ("#", "//"):
            started = True
            txt = _clean(s.lstrip("#/*-<! ").rstrip("->"))
            if txt and "://" not in txt and not re.fullmatch(r"[\w/.\-]+", txt):
                return txt
            continue
        if started:
            break
    return ""


def extract_functions(content: str, path: str) -> str:
    names: list[str] = []
    if path.endswith(".py"):
        names += re.findall(r"^\s*(?:async\s+)?def\s+([a-zA-Z_]\w*)", content, re.M)
        names += [f"class {c}" for c in re.findall(r"^\s*class\s+([A-Z]\w*)", content, re.M)]
    else:  # shell + most: `name() {` / `function name`
        names += re.findall(r"^\s*(?:function\s+)?([a-zA-Z_][\w-]*)\s*\(\)\s*\{?", content, re.M)
        names += re.findall(r"^\s*function\s+([a-zA-Z_][\w-]*)", content, re.M)
    seen, out = set(), []
    for n in names:
        if n not in seen and not n.startswith("_test"):
            seen.add(n); out.append(n)
    return ", ".join(out[:12])


def extract_related(content: str, path: str) -> str:
    rel: list[str] = []
    if path.endswith(".py"):
        for m in re.findall(r"^\s*from\s+([\w.]+)\s+import|^\s*import\s+([\w.]+)", content, re.M):
            mod = m[0] or m[1]
            if mod and (mod.startswith("mios") or mod.startswith(".")):
                rel.append(mod)
    rel += re.findall(r"(?:source|\.)\s+([/\w.\-]+\.(?:sh|bash))", content)
    rel += re.findall(r"(/usr/(?:lib|libexec|share)/mios/[\w./\-]+|/etc/mios/[\w./\-]+)", content)
    rel += re.findall(r"\b(mios-[\w-]+)\b", content)
    rel += re.findall(r"\b([\w-]+\.(?:service|container|timer|socket|target|mount))\b", content)
    rel += [f"localhost:{p}" for p in re.findall(r"localhost:(\d{2,5})", content)]
    seen, out = set(), []
    self_base = os.path.basename(path)
    for r in rel:
        r = r.strip()
        if r and r != self_base and r not in seen:
            seen.add(r); out.append(r)
    return ", ".join(out[:10])


GEN_SYS = (
    "You document a codebase FOR AI AGENTS. Write ONE dense line (<=240 chars) "
    "stating WHAT THE FILE IS and its ROLE/USE in the MiOS system -- for a "
    "script/tool/config, what an agent would use it for or what it controls. Be "
    "concrete (name the component/port/effect), not generic. No preamble, no file "
    "name, no quotes, no markdown -- just the one line.")


def teacher_hint(endpoint, model, path, head, timeout=90.0) -> str:
    rel = path.split("/mnt/c/", 1)[-1]
    user = f"Path: {rel}\n\nFirst lines:\n{head[:2400]}\n\nOne-line AI-hint:"
    payload = {"model": model, "stream": False, "temperature": 0.0,
               "messages": [{"role": "system", "content": GEN_SYS},
                            {"role": "user", "content": user}],
               "chat_template_kwargs": {"enable_thinking": False}, "max_tokens": 160}
    req = urllib.request.Request(endpoint.rstrip("/") + "/v1/chat/completions",
                                 data=json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = json.load(r)
    m = (body.get("choices") or [{}])[0].get("message") or {}
    txt = (m.get("content") or m.get("reasoning_content") or "").strip()
    return _clean(txt.splitlines()[0] if txt else "")


_BOM = b"\xef\xbb\xbf"


def retag(raw: bytes, style: str, block: list[str]) -> bytes:
    bom = b""
    if raw[:3] == _BOM:
        bom = _BOM
        raw = raw[3:]
    nl = "\r\n" if b"\r\n" in raw[:65536] else "\n"
    text = raw.decode("utf-8", errors="replace").replace("\r\n", "\n")
    all_lines = text.split("\n")

    start_idx = None
    end_idx = None
    for i, ln in enumerate(all_lines):
        if AI_LINE_RE.search(ln):
            if start_idx is None:
                start_idx = i
            end_idx = i + 1
        elif start_idx is not None:
            if re.match(r"^[#/<!;\-*\s]*\s{2,}\S", ln) or ln.strip() in ("-->", "*/"):
                end_idx = i + 1
            else:
                break

    if start_idx is not None:
        lines = all_lines[:start_idx] + all_lines[end_idx:]
        insert_idx = start_idx
    else:
        lines = all_lines
        insert_idx = 0
        if lines and lines[0].lstrip().startswith("#!"):
            insert_idx = 1
        elif style == "md" and lines and lines[0].strip() == "---":
            for i in range(1, min(len(lines), 80)):
                if lines[i].strip() == "---":
                    insert_idx = i + 1
                    break

    block_lines = []
    for b in block:
        block_lines += b.split("\n")
    lines = lines[:insert_idx] + block_lines + lines[insert_idx:]
    out = "\n".join(lines)
    body = (out.replace("\n", "\r\n") if nl == "\r\n" else out).encode("utf-8")
    return bom + body


def _has_shebang(path):
    try:
        with open(path, "rb") as fh:
            return fh.read(2) == b"#!"
    except OSError:
        return False


def indexable(path):
    if SKIP_SUFFIX.search(path.replace(os.sep, "/")):
        return False
    base = os.path.basename(path)
    _, ext = os.path.splitext(base)
    ext = ext.lower()
    if ext in JSON_EXT:
        return False
    if ext in EXT or base in BASENAMES:
        return True
    return ext == "" and _has_shebang(path)


def is_text(path):
    try:
        with open(path, "rb") as fh:
            return b"\x00" not in fh.read(2048)
    except OSError:
        return False


def _tracked(root):
    """Repo-relative paths git knows about, or None when this is not a work tree."""
    import subprocess
    try:
        out = subprocess.run(["git", "ls-files", "-z"], cwd=root,
                             capture_output=True, check=True)
    except Exception:
        return None
    return [p for p in out.stdout.decode("utf-8", "replace").split("\0") if p]


def walk(roots):
    for root in roots:
        rels = _tracked(root)
        if rels is None:
            for dp, dns, fns in os.walk(root):
                if SKIP_DIR.search(dp.replace(os.sep, "/")):
                    dns[:] = []
                    continue
                dns[:] = [d for d in dns
                          if not SKIP_DIR.search(
                              os.path.join(dp, d).replace(os.sep, "/"))]
                for fn in sorted(fns):
                    p = os.path.join(dp, fn)
                    if indexable(p) and is_text(p):
                        yield p
            continue
        for rel in sorted(rels):
            if SKIP_DIR.search(rel):
                continue
            p = os.path.join(root, rel.replace("/", os.sep))
            if os.path.isfile(p) and indexable(p) and is_text(p):
                yield p


def run_selftest() -> int:
    # 1. Shebang
    sh = b"#!/bin/bash\necho test\n"
    res1 = retag(sh, "hash", ["# AI-hint: bash test"])
    assert res1.startswith(b"#!/bin/bash\n# AI-hint: bash test\necho test\n"), f"Shebang failed: {res1!r}"

    # 2. BOM
    bom = _BOM + b"# code\n"
    res2 = retag(bom, "hash", ["# AI-hint: bom test"])
    assert res2.startswith(_BOM + b"# AI-hint: bom test\n# code\n"), f"BOM failed: {res2!r}"

    # 3. CRLF
    crlf = b"#!/bin/bash\r\necho test\r\n"
    res3 = retag(crlf, "hash", ["# AI-hint: crlf test"])
    assert b"\r\n" in res3 and not (b"\n" in res3.replace(b"\r\n", b"")), f"CRLF failed: {res3!r}"

    # 4. Front matter
    fm = b"---\ntitle: doc\n---\n# Content\n"
    res4 = retag(fm, "md", ["<!-- AI-hint: md test -->"])
    lines = res4.decode("utf-8").splitlines()
    assert lines[0] == "---" and lines[2] == "---" and lines[3] == "<!-- AI-hint: md test -->", f"Front matter failed: {res4!r}"

    # 5. Wrapped hint & region strip
    sample = "# AI-hint: first part\n#          second part\n# AI-related: foo\ncode()\n"
    h = existing_hint(sample)
    assert h == "first part second part", f"Hint collection failed: '{h}'"
    res5 = retag(sample.encode("utf-8"), "hash", ["# AI-hint: updated", "# AI-related: bar"])
    assert b"second part" not in res5, f"Region strip failed to remove continuation: {res5!r}"
    assert b"# AI-hint: updated\n# AI-related: bar\ncode()\n" in res5, f"Retag output unexpected: {res5!r}"

    # 6. Header-free paths are not taggable, relative or absolute; code dirs
    #    that only share a name stay taggable.
    for p in (".agents/skills/x/SKILL.md", "/srv/MiOS/commands/codex/goal.md",
              "usr/share/mios/vendored/k3s/k3s-install.sh", ".prompt.MD",
              "/srv/MiOS/automation/lib/globals.sh", "tests/templates/golden/bash.snap"):
        assert not indexable(p) or SKIP_DIR.search(p), f"{p} must not be taggable"
    for p in ("usr/lib/mios/agents/router.py", "/srv/MiOS/usr/share/mios/agents/run.sh",
              "automation/lib/common.sh", "docs/design/w10-live-boot/notes.md"):
        assert indexable(p) and not SKIP_DIR.search(p), f"{p} must stay taggable"

    print("mios-ai-tag: --selftest passed (6/6 tests green)", file=sys.stderr)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="mios-ai-tag")
    ap.add_argument("--root", action="append", required=False)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-llm", action="store_true")
    ap.add_argument("--limit", type=int, default=None)
    ap.add_argument("--manifest", default=None)
    ap.add_argument("--hints-json", default=None)
    ap.add_argument("--selftest", action="store_true", help="Run internal self-tests")
    _ep, _model = teacher_defaults()
    ap.add_argument("--teacher-endpoint",
                    default=os.environ.get("MIOS_AI_TEACHER_ENDPOINT") or _ep)
    ap.add_argument("--teacher-model", default=_model)
    a = ap.parse_args()

    if a.selftest:
        return run_selftest()

    if not a.root:
        ap.error("the following arguments are required: --root (unless --selftest is passed)")

    hints_map = {}
    if a.hints_json and os.path.exists(a.hints_json):
        with open(a.hints_json, encoding="utf-8") as fh:
            hints_map = {k: _clean(v) for k, v in json.load(fh).items() if v}

    done = set()
    if a.manifest and os.path.exists(a.manifest):
        with open(a.manifest, encoding="utf-8") as fh:
            done = {ln.strip() for ln in fh if ln.strip()}
    mh = open(a.manifest, "a", encoding="utf-8") if (a.manifest and not a.dry_run) else None

    files = [p for p in walk(a.root) if p not in done]
    stats = {"pending": len(files), "tagged": 0, "reused_hint": 0, "generated": 0,
             "skipped_resume": len(done), "gap": 0, "errors": 0}
    n = 0
    for p in files:
        if a.limit and n >= a.limit:
            break
        try:
            with open(p, "rb") as fh:
                raw = fh.read()
        except OSError:
            stats["errors"] += 1
            continue
        content = raw.decode("utf-8", errors="replace")
        head = content[:8192]
        if p in hints_map:
            hint = hints_map[p]
            stats["overridden"] = stats.get("overridden", 0) + 1
        elif (hint := existing_hint(head)):
            stats["reused_hint"] += 1
        elif a.no_llm:
            hint = extract_desc(head, p)
        else:
            try:
                hint = teacher_hint(a.teacher_endpoint, a.teacher_model, p, head)
                if hint:
                    stats["generated"] += 1
            except Exception as e:  # noqa: BLE001
                print(f"[ai-tag] WARN gen {p}: {e}", file=sys.stderr)
                hint = extract_desc(head, p)
        if not hint:
            stats["gap"] += 1
            continue
        style = comment_style(p)
        block = make_block(style, hint, extract_related(content, p),
                           extract_functions(content, p))
        n += 1
        stats["tagged"] += 1
        if a.dry_run:
            print(f"{p}:")
            for b in block:
                print("    " + b.replace("\n", "\n    "))
            continue
        try:
            with open(p, "wb") as fh:
                fh.write(retag(raw, style, block))
            if mh:
                mh.write(p + "\n"); mh.flush()
        except OSError as e:
            print(f"[ai-tag] WARN write {p}: {e}", file=sys.stderr)
            stats["errors"] += 1
        if n % 50 == 0:
            print(f"[ai-tag] {n} tagged ...", flush=True)
    if mh:
        mh.close()
    print(json.dumps(stats, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
