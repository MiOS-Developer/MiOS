#!/bin/bash
# AI-hint: Detects virtualization status to automatically toggle NVIDIA driver blacklisting and configure the GSK_RENDERER environment for optimal software fallback in VMs or hardware acceleration on bare metal.
# AI-related: mios-gpu-detect, mios-virt-gpu, mios-renderer, mios-nvidia-blacklist, mios-gpu-detected
set -euo pipefail
VIRT=$(systemd-detect-virt 2>/dev/null || echo "None")
echo "[mios-gpu-detect] Virtualization: $VIRT"

NVIDIA_CONF="/etc/modprobe.d/99-mios-virt-gpu.conf"
ENV_DIR="/etc/environment.d"
RENDERER_CONF="${ENV_DIR}/60-mios-renderer.conf"
mkdir -p "$ENV_DIR"

if [ "$VIRT" != "none" ]; then
    if { command -v lspci >/dev/null 2>&1 && lspci -nn 2>/dev/null | grep -qiE '\[10de:'; } \
       || [ -e /dev/nvidia0 ] || [ -e /dev/dxg ]; then
        echo "[mios-gpu-detect] VM with a real NVIDIA device present"
        rm -f "$NVIDIA_CONF" 2>/dev/null || true
    else
        echo "[mios-gpu-detect] GPU-less VM detected"
        cat > "$NVIDIA_CONF" <<'EOMOD'
install nvidia /bin/false
install nvidia_drm /bin/false
install nvidia_modeset /bin/false
install nvidia_uvm /bin/false
EOMOD
        for mod in nvidia_uvm nvidia_drm nvidia_modeset nvidia; do
            modprobe -r "$mod" 2>/dev/null || true
        done
    fi

    cat > "$RENDERER_CONF" <<'EORENDER'
GSK_RENDERER=ngl
EORENDER

    case "$VIRT" in
        microsoft|wsl) modprobe hyperv_drm 2>/dev/null || true ;;
        kvm|qemu)      modprobe virtio-gpu 2>/dev/null || true ;;
        vmware)        modprobe vmwgfx 2>/dev/null || true ;;
    esac
else
    echo "[mios-gpu-detect] Bare metal"
    rm -f "$NVIDIA_CONF"
    modprobe nvidia_drm 2>/dev/null || true
    rm -f "$RENDERER_CONF"

    if command -v lspci &>/dev/null; then
        if lspci -nn | grep -iE '\[10de:(2900|2901|2903|2904|2905|2b80|2b85)\]' &>/dev/null; then
            echo "[mios-gpu-detect] WARNING: RTX 50-series GPU detected"
            echo "[mios-gpu-detect] VFIO passthrough may require full host reboot after VM shutdown"
            wall "MiOS: RTX 50-series VFIO reset bug detected." 2>/dev/null || true
        fi
    fi
fi

export PATH="/usr/lib/wsl/lib:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:$PATH"
if command -v nvidia-smi &>/dev/null; then
    VRAM_MIB=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ' ' || echo "0")
    if [ "${VRAM_MIB:-0}" -ge 8192 ]; then
        echo "[mios-gpu-detect] dGPU with >8GB VRAM detected"
        touch /run/mios-gpu-vram-gt-8gb
        mkdir -p /var/lib/mios/vllm/model /usr/share/mios/vllm
        [ -L /usr/share/mios/vllm/model ] || ln -sf /var/lib/mios/vllm/model /usr/share/mios/vllm/model 2>/dev/null || true
        if [ ! -f /var/lib/mios/vllm/model/config.json ]; then
            cat > /var/lib/mios/vllm/model/config.json <<'EOCFG'
{
  "architectures": ["LlamaForCausalLM"],
  "model_type": "llama",
  "torch_dtype": "float16",
  "max_position_embeddings": 262144
}
EOCFG
        fi
        if [ ! -f /var/lib/mios/vllm/model/tokenizer_config.json ]; then
            cat > /var/lib/mios/vllm/model/tokenizer_config.json <<'EOCFG'
{
  "tokenizer_class": "PreTrainedTokenizerFast"
}
EOCFG
        fi
        if [ ! -f /var/lib/mios/vllm/model/tokenizer.json ]; then
            cat > /var/lib/mios/vllm/model/tokenizer.json <<'EOCFG'
{
  "version": "1.0",
  "truncation": null,
  "padding": null,
  "added_tokens": [],
  "normalizer": null,
  "pre_tokenizer": null,
  "post_processor": null,
  "decoder": null,
  "model": {
    "type": "BPE",
    "dropout": null,
    "unk_token": null,
    "continuing_subword_prefix": null,
    "end_of_word_suffix": null,
    "fuse_unk": false,
    "vocab": {
      "<unk>": 0,
      "<s>": 1,
      "</s>": 2
    },
    "merges": []
  }
}
EOCFG
        fi
        systemctl enable --now mios-llm-heavy.service 2>/dev/null || true
    fi
fi

touch /run/mios-gpu-detected
