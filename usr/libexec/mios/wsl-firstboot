#!/usr/bin/env bash
# AI-hint: Executes runtime-specific WSL initialization by syncing the hostname from install.env and verifying systemd-linger markers to bridge the gap between build-time configuration and WSL-specific boot behavior.
# AI-related: /usr/lib/mios/paths.sh, mios-user, mios-wsl-firstboot
# AI-functions: _log
set -euo pipefail
source /usr/lib/mios/paths.sh

MARKER="${MIOS_VAR_DIR}/.wsl-firstboot-done"

_log() { logger -t mios-wsl-firstboot "$*" 2>/dev/null || true; echo "[wsl-firstboot] $*" >&2; }

_log "Starting WSL2 first-boot bridge (substrate already provisioned at overlay time)"

MIOS_IDENTITY_HOSTNAME="${MIOS_IDENTITY_HOSTNAME:-mios}"
if [[ -f ${MIOS_ETC_DIR}/install.env ]]; then
    set +u
    source ${MIOS_ETC_DIR}/install.env 2>/dev/null || true
    set -u
    MIOS_IDENTITY_HOSTNAME="${MIOS_IDENTITY_HOSTNAME:-mios}"
fi

if [[ -n "$MIOS_IDENTITY_HOSTNAME" ]]; then
    echo "$MIOS_IDENTITY_HOSTNAME" > /etc/hostname
    hostname "$MIOS_IDENTITY_HOSTNAME" 2>/dev/null || true
    _log "Hostname set to $MIOS_IDENTITY_HOSTNAME"
fi

if id mios &>/dev/null; then
    if [[ -d /var/home/mios ]]; then
        mkdir -p /var/home/mios/.cache/oh-my-posh /var/home/mios/.config 2>/dev/null || true
        chown -R mios:mios /var/home/mios 2>/dev/null || true
        chmod 0755 /var/home/mios 2>/dev/null || true
        chmod -R 0755 /var/home/mios/.config /var/home/mios/.cache 2>/dev/null || true
    else
        _log "WARN: /var/home/mios missing -- tmpfiles.d/mios-user.conf may not have run"
    fi
    if ! grep -qE '^mios:' /etc/subuid 2>/dev/null; then
        _log "WARN: /etc/subuid lacks mios entry -- automation/11-user.sh should have added it at build time"
    fi
    if [[ ! -f /var/lib/systemd/linger/mios ]]; then
        _log "WARN: /var/lib/systemd/linger/mios missing -- tmpfiles.d/mios-user.conf may not have run"
    fi
else
    _log "ERROR: 'mios' user does not exist -- /usr/lib/sysusers.d/10-mios.conf was not materialized"
fi

mkdir -p "$(dirname "$MARKER")"
touch "$MARKER"
_log "WSL2 first-boot bridge complete"
