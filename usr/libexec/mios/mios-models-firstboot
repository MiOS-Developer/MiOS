#!/usr/bin/env python3
# AI-hint: FBM first-boot large-model provisioner. Reads [ai].firstboot_models from the layered mios.toml; a Hugging Face `resolve/<rev>` source floats: the revision is resolved to its current commit and the upstream-published LFS sha256, the file is fetched from that immutable commit, VERIFIED (streamed, chunked) and recorded in <models>/models.tsv; a part file that mismatches is discarded and an entry with no provable digest is refused, never installed unverified. Writes a sentinel only when the entire configured fleet is verified; the timer retries incomplete runs. Degrades open: every failure path exits 0 so a pull can never block boot.
# AI-related: mios-models, mios-models-firstboot.service, /usr/share/mios/mios.toml
import sys
import hashlib
import os
import subprocess
import pathlib
import json
import re
import time

MODELS_DIR = pathlib.Path("/var/lib/mios/llamacpp/models")
SENTINEL = pathlib.Path("/var/lib/mios/.models-firstboot-done")
PROGRESS = pathlib.Path("/var/lib/mios/.models-firstboot-progress")

if os.name == 'nt':
    MODELS_DIR = pathlib.Path("C:/var/lib/mios/llamacpp/models")
    SENTINEL = pathlib.Path("C:/var/lib/mios/.models-firstboot-done")
    PROGRESS = pathlib.Path("C:/var/lib/mios/.models-firstboot-progress")
if os.environ.get("MIOS_MODELS_DIR"):
    MODELS_DIR = pathlib.Path(os.environ["MIOS_MODELS_DIR"])
if os.environ.get("MIOS_MODELS_STATE_DIR"):
    _state = pathlib.Path(os.environ["MIOS_MODELS_STATE_DIR"])
    SENTINEL = _state / ".models-firstboot-done"
    PROGRESS = _state / ".models-firstboot-progress"
HF_ENDPOINT = os.environ.get("MIOS_HF_ENDPOINT", "https://huggingface.co").rstrip("/")
LEDGER_NAME = "models.tsv"

def _sha256_file(path, chunk=1024 * 1024):
    """Stream a file through sha256. Returns the hex digest, or None if the
    file cannot be read. Chunked so a multi-GB GGUF never lands in memory."""
    h = hashlib.sha256()
    try:
        with open(path, "rb") as fh:
            for block in iter(lambda: fh.read(chunk), b""):
                h.update(block)
    except OSError:
        return None
    return h.hexdigest()


_HF_RESOLVE = re.compile(r"^https://huggingface\.co/(?P<repo>[^/]+/[^/]+)/resolve/(?P<rev>[^/]+)/(?P<path>.+)$")


def _resolve_hf(source):
    """(immutable url, commit, sha256) for a Hugging Face resolve/<rev> source, from the
    revision API's LFS metadata (the upstream-published digest); None when not HF.
    Raises RuntimeError when it is HF but the digest cannot be obtained."""
    m = _HF_RESOLVE.match(source)
    if not m:
        return None
    repo, rev, path = m.group("repo"), m.group("rev"), m.group("path")
    api = f"{HF_ENDPOINT}/api/models/{repo}/revision/{rev}?blobs=true"
    res = subprocess.run(["curl", "-fsSL", "--retry", "3", "--max-time", "60", api],
                         capture_output=True, text=True)
    if res.returncode != 0:
        raise RuntimeError(f"revision API unreachable (curl exit {res.returncode})")
    try:
        meta = json.loads(res.stdout)
    except ValueError:
        raise RuntimeError("revision API returned no JSON")
    commit = meta.get("sha", "")
    if not re.fullmatch(r"[0-9a-f]{40}", str(commit)):
        raise RuntimeError("revision API returned no commit id")
    for sib in meta.get("siblings") or []:
        if sib.get("rfilename") == path:
            digest = ((sib.get("lfs") or {}).get("sha256") or "").lower()
            if re.fullmatch(r"[0-9a-f]{64}", digest):
                return f"{HF_ENDPOINT}/{repo}/resolve/{commit}/{path}", commit, digest
            raise RuntimeError(f"{path} has no LFS sha256 at {commit}")
    raise RuntimeError(f"{path} is not in {repo}@{commit}")


def _record(name, source, commit, digest):
    """Provisioning output: what was actually installed, never written to the SSOT."""
    ledger = MODELS_DIR / LEDGER_NAME
    new = not ledger.exists()
    with open(ledger, "a") as fh:
        if new:
            fh.write("name\tsource\tcommit\tsha256\trecorded_at\n")
        fh.write(f"{name}\t{source}\t{commit}\t{digest}\t{time.strftime('%Y-%m-%dT%H:%M:%S%z')}\n")


# Use the shared vendor < host < user resolver for the pull policy AND models.
# Optional large weights and the required light-lane fleet share one verified
# downloader; a Day-0 inference lane must not be marked ready with only the micro.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "lib/mios"))
try:
    import mios_toml
    cfg = mios_toml.load_merged()
    ai_cfg = cfg["ai"]
except Exception as e:
    print(f"WARN: layered model configuration unavailable: {e}")
    sys.exit(0)

if ai_cfg.get("firstboot_pulls", True) is False:
    print("[ai].firstboot_pulls is false: no first-boot model is downloaded")
    sys.exit(0)

MODELS_DIR.mkdir(parents=True, exist_ok=True)
PROGRESS.parent.mkdir(parents=True, exist_ok=True)
PROGRESS.write_text("Parsing config...\n")
entries = ai_cfg.get("firstboot_models") or []
failures = []
if not isinstance(entries, list):
    print("ERROR: [ai].firstboot_models must be an array")
    sys.exit(0)
models = {}
for entry in entries:
    if not isinstance(entry, dict) or not entry.get("name") or not entry.get("source"):
        failures.append("invalid firstboot_models entry")
    else:
        models[entry["name"]] = dict(entry)

required = set()
for spec in (cfg.get("llamacpp", {}).get("bake_models") or "").split(","):
    spec = spec.strip()
    if not spec:
        continue
    try:
        name, rest = spec.split("=", 1)
        repo, filename = rest.split(":", 1)
        if not name or not repo or not filename:
            raise ValueError("empty field")
    except ValueError:
        failures.append("invalid [llamacpp].bake_models entry")
        continue
    required.add(name)
    models.setdefault(name, {"name": name, "source": f"https://huggingface.co/{repo}/resolve/main/{filename}"})

verified = set()
for i, (name, model) in enumerate(models.items()):
    if not isinstance(name, str) or pathlib.Path(name).name != name or name in (".", ".."):
        print("ERROR: model name must be a file basename")
        failures.append("invalid model name")
        continue
    source = model["source"]
    digest = str(model.get("sha256") or "").strip().lower()
    commit = ""
    PROGRESS.write_text(f"{i}/{len(models)}\n{name}\n")
    dest = MODELS_DIR / name
    if dest.is_symlink():
        print(f"ERROR: refusing symbolic-link model destination {name}")
        failures.append(name)
        continue
    if not digest:
        try:
            resolved = _resolve_hf(source)
            if resolved is None:
                raise RuntimeError("refusing an unverified weight: source publishes no digest")
            source, commit, digest = resolved
        except RuntimeError as e:
            print(f"WARN: {name}: upstream digest unavailable ({e}); not downloading an unverifiable weight")
            failures.append(name)
            continue
    if not re.fullmatch(r"[0-9a-f]{64}", digest):
        print(f"ERROR: {name}: invalid sha256")
        failures.append(name)
        continue
    if dest.is_file() and _sha256_file(dest) == digest:
        verified.add(name)
        continue
    part_dest = MODELS_DIR / f"{name}.part"
    if part_dest.is_symlink():
        print(f"ERROR: refusing symbolic-link partial destination {name}")
        failures.append(name)
        continue
    cmd = ["curl", "-fL", "-C", "-", "--retry", "3", "--max-time", "1800", "-o", str(part_dest), source]
    result = subprocess.run(cmd)
    if result.returncode != 0:
        print(f"WARN: Failed to download {name} (curl exit {result.returncode})")
        failures.append(name)
        continue
    actual = _sha256_file(part_dest)
    if actual != digest:
        print(f"ERROR: sha256 MISMATCH for {name}")
        part_dest.unlink(missing_ok=True)
        failures.append(name)
        continue
    # Publish only after verification. A prior bad file is preserved until this
    # atomic replacement; it is never counted toward either readiness marker.
    part_dest.replace(dest)
    _record(name, source, commit, actual)
    verified.add(name)
    print(f"Successfully provisioned {name}")

if required and required.issubset(verified):
    (MODELS_DIR / ".ready").touch()
elif required:
    (MODELS_DIR / ".ready").unlink(missing_ok=True)
missing = sorted(set(models) - verified)
if missing or failures:
    PROGRESS.write_text("Incomplete: " + ", ".join(missing + failures) + "\n")
    print("Sentinel NOT written -- the timer will retry.")
else:
    SENTINEL.touch()
    PROGRESS.write_text("Complete\n")
    print("First-boot model provisioning complete (sentinel written).")
sys.exit(0)
