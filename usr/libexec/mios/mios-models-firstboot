#!/usr/bin/env python3
# AI-hint: FBM first-boot large-model provisioner. Reads [ai].firstboot_models from the layered mios.toml, downloads each GGUF with resume, VERIFIES its sha256 (streamed, chunked) and discards the part file on mismatch rather than installing an unverified weight, then writes a sentinel so it never re-runs. Degrades open: every failure path exits 0 so a pull can never block boot.
# AI-related: mios-models, mios-models-firstboot.service, /usr/share/mios/mios.toml
import sys
import hashlib
import os
import subprocess
import pathlib
try:
    import tomllib
except ImportError:
    try:
        import tomli as tomllib
    except ImportError:
        print("ERROR: tomllib or tomli not found")
        sys.exit(1)

MODELS_DIR = pathlib.Path("/var/lib/mios/llamacpp/models")
SENTINEL = pathlib.Path("/var/lib/mios/.models-firstboot-done")
PROGRESS = pathlib.Path("/var/lib/mios/.models-firstboot-progress")

if os.name == 'nt':
    MODELS_DIR = pathlib.Path("C:/var/lib/mios/llamacpp/models")
    SENTINEL = pathlib.Path("C:/var/lib/mios/.models-firstboot-done")
    PROGRESS = pathlib.Path("C:/var/lib/mios/.models-firstboot-progress")

if SENTINEL.exists():
    print(f"Sentinel {SENTINEL} exists. FBM provisioner already completed.")
    sys.exit(0)


# [ai].firstboot_pulls from the LAYERED SSOT (default true): a cloud or container
# deployment's [deployment.cloud] host drop-in sets it false. No sentinel is written,
# so removing the drop-in resumes the pulls on the next boot.
_TOML_GET = os.environ.get("MIOS_TOML_GET", "/usr/libexec/mios/mios-toml-get")
if os.access(_TOML_GET, os.X_OK) and subprocess.run(
        [_TOML_GET, "ai", "firstboot_pulls", "true"], capture_output=True, text=True).stdout.strip() == "false":
    print("[ai].firstboot_pulls is false (cloud/container deployment): no first-boot model is downloaded")
    sys.exit(0)


def _sha256_file(path, chunk=1024 * 1024):
    """Stream a file through sha256. Returns the hex digest, or None if the
    file cannot be read. Chunked so a multi-GB GGUF never lands in memory."""
    h = hashlib.sha256()
    try:
        with open(path, "rb") as fh:
            for block in iter(lambda: fh.read(chunk), b""):
                h.update(block)
    except OSError:
        return None
    return h.hexdigest()


MODELS_DIR.mkdir(parents=True, exist_ok=True)
PROGRESS.parent.mkdir(parents=True, exist_ok=True)
PROGRESS.write_text("Parsing config...\n")

TOML_PATH = os.environ.get("MIOS_TOML", "C:/MiOS/usr/share/mios/mios.toml" if os.name == 'nt' else "/usr/share/mios/mios.toml")

try:
    with open(TOML_PATH, "rb") as f:
        cfg = tomllib.load(f)
except Exception as e:
    print(f"Failed to load {TOML_PATH}: {e}")
    sys.exit(0)

ai_cfg = cfg.get("ai", {})
models = [m for m in (ai_cfg.get("firstboot_models") or []) if isinstance(m, dict)]

if not models:
    print("No firstboot_models found in config.")
else:
    print(f"Found {len(models)} firstboot models.")
    PROGRESS.write_text(f"0/{len(models)}\n")
    for i, m in enumerate(models):
        name = m.get("name")
        source = m.get("source")
        sha256 = m.get("sha256", "")
        
        if not name or not source:
            print(f"Skipping invalid model entry: {m}")
            continue
            
        PROGRESS.write_text(f"{i}/{len(models)}\n{name}\n")
        dest = MODELS_DIR / name
        if dest.exists():
            print(f"Model {name} already exists. Skipping.")
            continue
            
        print(f"Downloading {name} from {source}...")
        part_dest = MODELS_DIR / f"{name}.part"
        cmd = ["curl", "-fL", "-C", "-", "--retry", "3", "--max-time", "1800", "-o", str(part_dest), source]
        
        res = subprocess.run(cmd)
        if res.returncode != 0:
            print(f"WARN: Failed to download {name} (curl exit {res.returncode})")
            continue
        if sha256:
            print(f"Verifying sha256 for {name}...")
            actual = _sha256_file(part_dest)
            if actual is None:
                print(f"WARN: could not read {part_dest} to verify; discarding")
                part_dest.unlink(missing_ok=True)
                continue
            if actual.lower() != str(sha256).strip().lower():
                # An unverified weight file must never be installed under a
                # name the lanes will load. Drop the part file so the next run
                # re-downloads instead of resuming a poisoned partial.
                print(f"ERROR: sha256 MISMATCH for {name}")
                print(f"       expected {str(sha256).strip().lower()}")
                print(f"       actual   {actual.lower()}")
                part_dest.unlink(missing_ok=True)
                continue
            print(f"  sha256 OK ({actual[:16]}...)")
        part_dest.rename(dest)
        print(f"Successfully provisioned {name}")
            
# The sentinel is the unit's ConditionPathExists gate, so writing it
# unconditionally retired the provisioner after ONE pass -- a failed download or
# a rejected digest meant that model was never fetched again. Write it only when
# every declared model is actually on disk; otherwise leave it and let
# mios-models-firstboot.timer come back. Still exit 0 either way: degrade-open,
# a pull must never block boot (Architectural Law 12).
_missing = [str(m.get("name")) for m in models
            if m.get("name") and not (MODELS_DIR / str(m.get("name"))).exists()]
if _missing:
    PROGRESS.write_text("Incomplete: " + ", ".join(_missing) + "\n")
    print(f"WARN: {len(_missing)} declared model(s) still missing: {', '.join(_missing)}")
    print("Sentinel NOT written -- the timer will retry.")
else:
    SENTINEL.touch()
    PROGRESS.write_text("Complete\n")
    print("First-boot model provisioning complete (sentinel written).")
sys.exit(0)
