#!/bin/sh
# AI-hint: Retrieves and streams the most recent raw build log from /var/log/mios or /tmp, used by agents to inspect real-time or historical build output from the mios-build-driver.
# AI-related: /usr/libexec/mios/mios-build-tail, mios-build-driver, mios-build-status

set -eu

FOLLOW=0
N=100
while [ "$#" -gt 0 ]; do
    case "$1" in
        -f|--follow) FOLLOW=1; shift ;;
        -n) N="$2"; shift 2 ;;
        -h|--help)
            echo "Usage: mios-build-tail [-f] [-n N]"
            echo "  -f       follow the log live"
            echo "  -n N     print last N lines and exit"
            exit 0 ;;
        *) N="$1"; shift ;;
    esac
done

LATEST=""
for d in /var/log/mios /tmp; do
    cand="$(ls -1tr "$d"/mios-build-driver-*.log 2>/dev/null | tail -1)"
    if [ -n "$cand" ]; then
        if [ -z "$LATEST" ] || [ "$cand" -nt "$LATEST" ]; then
            LATEST="$cand"
        fi
    fi
done
if [ -z "$LATEST" ]; then
    echo "Mios-build-tail: no build-driver-*.log found" >&2
    exit 1
fi

echo "── tailing: $LATEST ──" >&2
if [ "$FOLLOW" = "1" ]; then
    exec tail -F -n "$N" "$LATEST"
else
    exec tail -n "$N" "$LATEST"
fi
