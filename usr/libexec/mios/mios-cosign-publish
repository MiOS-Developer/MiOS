#!/usr/bin/env python3
# AI-hint: Local Cosign image signing and fail-closed signature validation gate (task_454).
# AI-doc: usr/share/doc/mios/manual/ch05-build-and-pipeline.md
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from typing import Any, Dict, Optional


class CosignPublisher:
    """Sign OCI images and require verified signature proof before deployment."""

    def __init__(
        self,
        image_ref: str = "localhost:5000/mios:latest",
        key_path: str = "/etc/pki/containers/cosign.key",
        pubkey_path: str = "/etc/pki/containers/cosign.pub",
        registry_url: str = "localhost:5000",
        mock: bool = False,
        dry_run: bool = False,
    ) -> None:
        self.image_ref = image_ref
        self.key_path = key_path
        self.pubkey_path = pubkey_path
        self.registry_url = registry_url
        self.mock = mock
        self.dry_run = dry_run

    @staticmethod
    def _readable_key(path: str) -> bool:
        try:
            if not os.path.isfile(path):
                return False
            with open(path, "rb") as key:
                return bool(key.read(1))
        except OSError:
            return False

    def _run(self, action: str, key: str) -> tuple[Optional[str], Optional[str]]:
        cosign_bin = shutil.which("cosign")
        if not cosign_bin:
            return None, "cosign is unavailable; install the configured signing tool."
        if not self._readable_key(key):
            return None, f"The {action} key must be a readable, non-empty file."
        cmd = [cosign_bin, action, "--key", key]
        if action == "sign":
            cmd.extend(["--tlog-upload=false", "--yes"])
        else:
            cmd.extend(["--output", "json"])
        cmd.append(self.image_ref)
        try:
            res = subprocess.run(cmd, capture_output=True, text=True)
        except (OSError, UnicodeError):
            return None, f"cosign {action} could not run; check the executable and key access."
        if res.returncode != 0:
            # Tool output can contain signer credentials; expose only bounded action metadata.
            return None, (
                f"cosign {action} failed (exit {res.returncode}); "
                "check the key, registry access, and image reference."
            )
        return res.stdout, None

    def sign_image(self) -> Dict[str, Any]:
        """A successful sign action is not verification proof."""
        result: Dict[str, Any] = {
            "success": False,
            "action": "sign",
            "image_ref": self.image_ref,
            "digest": None,
            "signature_ref": None,
            "key_used": self.key_path,
            "verified": False,
            "permitted_for_switch": False,
            "mock": self.mock,
            "dry_run": self.dry_run,
        }
        if self.mock or self.dry_run:
            result["simulated"] = True
            result["error"] = "Simulation performs no signing and cannot authorize deployment."
            return result
        _, error = self._run("sign", self.key_path)
        if error:
            result["error"] = error
            return result
        result["success"] = True
        return result

    def verify_signature(self) -> Dict[str, Any]:
        """Only successful Cosign verification with a manifest digest authorizes deployment."""
        result: Dict[str, Any] = {
            "verified": False,
            "image_ref": self.image_ref,
            "digest": None,
            "pubkey": self.pubkey_path,
            "permitted_for_switch": False,
            "mock": self.mock,
            "dry_run": self.dry_run,
        }
        if self.mock or self.dry_run:
            result["simulated"] = True
            result["error"] = "Simulation provides no signature proof and cannot authorize deployment."
            return result
        output, error = self._run("verify", self.pubkey_path)
        if error:
            result["error"] = error
            return result
        try:
            payloads = json.loads(output)
            if not isinstance(payloads, list) or not payloads:
                raise ValueError("No verified payloads")
            digests = set()
            for payload in payloads:
                digest = payload["critical"]["image"]["docker-manifest-digest"]
                if not isinstance(digest, str) or not re.fullmatch(
                    r"(?:sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128})", digest
                ):
                    raise ValueError("Invalid manifest digest")
                digests.add(digest)
            if len(digests) != 1:
                raise ValueError("Ambiguous manifest digest")
            digest = digests.pop()
            if "@" in self.image_ref and self.image_ref.rsplit("@", 1)[1] != digest:
                raise ValueError("Manifest digest differs from requested image")
        except (TypeError, ValueError, KeyError):
            result["error"] = "cosign verify returned no unambiguous manifest proof for the requested image."
            return result
        result.update(verified=True, permitted_for_switch=True, digest=digest)
        return result


def main() -> int:
    parser = argparse.ArgumentParser(description="MiOS Cosign Image Sign and Publish Tool (task_454)")
    parser.add_argument("--image", default="localhost:5000/mios:latest", help="OCI image reference")
    parser.add_argument("--key", default="/etc/pki/containers/cosign.key", help="Path to signing key")
    parser.add_argument("--pubkey", default="/etc/pki/containers/cosign.pub", help="Path to public verification key")
    parser.add_argument("--registry", default="localhost:5000", help="Registry host/port")
    parser.add_argument("--verify-only", action="store_true", help="Only verify existing signature")
    parser.add_argument("--mock", action="store_true", help="Simulate without signing or authorizing deployment")
    parser.add_argument("--dry-run", action="store_true", help="Preview without signing or authorizing deployment")
    parser.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    args = parser.parse_args()
    publisher = CosignPublisher(
        image_ref=args.image,
        key_path=args.key,
        pubkey_path=args.pubkey,
        registry_url=args.registry,
        mock=args.mock,
        dry_run=args.dry_run,
    )
    if args.verify_only:
        result = publisher.verify_signature()
        ready = result["permitted_for_switch"] is True
    else:
        sign_res = publisher.sign_image()
        if sign_res["success"] is True:
            verify_res = publisher.verify_signature()
        else:
            verify_res = {
                "verified": False,
                "image_ref": args.image,
                "digest": None,
                "pubkey": args.pubkey,
                "permitted_for_switch": False,
                "error": "Verification was not attempted because signing did not succeed.",
            }
        ready = sign_res["success"] is True and verify_res["permitted_for_switch"] is True
        result = {"signing": sign_res, "verification": verify_res, "ready_for_switch": ready}

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"Cosign Publish & Verify: {'PASSED' if ready else 'FAILED'}")
        if not ready:
            errors = [result] if args.verify_only else [result["signing"], result["verification"]]
            for error in errors:
                if "error" in error:
                    print(error["error"], file=sys.stderr)
    return 0 if ready else 1


if __name__ == "__main__":
    sys.exit(main())
