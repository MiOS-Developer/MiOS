#!/bin/bash
# AI-hint: Executes commands in a fresh WSL login session as the operator user to bootstrap the full WSLg environment (Wayland, user-bus, and interop) required for GUI applications and Flatpaks to function correctly.
# AI-related: /usr/libexec/mios/mios-as-operator, /usr/share/mios/mios.toml, /etc/mios/wsl-distro, mios-launcher, mios-hermes, 1000.service, mios-launcher.socket, mios-launcher.service, socket.socket
# AI-functions: _quote
set -euo pipefail

if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    cat <<'USAGE'
usage: mios-as-operator <command> [args...]

Re-exec <command> as the operator user inside a real WSL login session
so it inherits the full WSLg env (Wayland, interop, user-bus). Use
this for GUI launches that need the operator's display surface (most
flatpaks, all native GUI apps).

Resolution order:
  1. mios-launcher.socket on /run/user/<op>/mios-launcher.sock
     (operator's user-systemd-managed broker; cleanest; only reaches
     /mnt/c .exes from operator context, bypassing the perm wall)
  2. wsl.exe -d <distro> --user <op> -- nohup setsid <cmd>
     (works from operator's own shell; not from agent service-user
     contexts that can't exec wsl.exe)

The launched command runs DETACHED -- this script returns
~immediately after dispatching it.
USAGE
    exit 0
fi

_op_user=""
if [ -r /etc/wsl.conf ]; then
    _op_user="$(awk -F= '/^[[:space:]]*default[[:space:]]*=/{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit}' /etc/wsl.conf 2>/dev/null)"
fi
if [ -z "$_op_user" ] && [ -r /etc/mios/mios.toml ]; then
    _op_user="$(awk -F\" '/^[[:space:]]*mios_user[[:space:]]*=/{print $2; exit}' /etc/mios/mios.toml 2>/dev/null)"
fi
if [ -z "$_op_user" ] && [ -r /usr/share/mios/mios.toml ]; then
    _op_user="$(awk -F\" '/^[[:space:]]*mios_user[[:space:]]*=/{print $2; exit}' /usr/share/mios/mios.toml 2>/dev/null)"
fi
if [ -z "$_op_user" ] || ! id -u "$_op_user" >/dev/null 2>&1; then
    if id -u mios >/dev/null 2>&1; then
        _op_user="mios"
    elif id -u user >/dev/null 2>&1; then
        _op_user="user"
    fi
fi
[ -z "$_op_user" ] && _op_user="mios"
_op_uid="$(id -u "$_op_user" 2>/dev/null || echo 992)"

_quote() {
    printf "'"
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}

_BROKER_SOCK="${MIOS_LAUNCHER_SOCK:-/run/mios-launcher/launcher.sock}"
if [ -S "$_BROKER_SOCK" ]; then
    _line=""
    for arg in "$@"; do
        _line="${_line} $(_quote "$arg")"
    done
    _line="_MIOS_FLATPAK_DEPTH=1 _MIOS_HOST_LAUNCH_DEPTH=1 ${_line# }"
    _resp="$(python3 - "$_BROKER_SOCK" "$_line" <<'PYEOF'
import socket, sys
sock_path, line = sys.argv[1], sys.argv[2]
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5.0)
try:
    s.connect(sock_path)
    s.sendall((line + "\n").encode())
    resp = b""
    while not resp.endswith(b"\n") and len(resp) < 1024:
        chunk = s.recv(256)
        if not chunk: break
        resp += chunk
    sys.stdout.write(resp.decode("utf-8", errors="replace").rstrip())
finally:
    s.close()
PYEOF
)"
    case "$_resp" in
        OK*)
            exit 0
            ;;
        ERROR:*)
            echo "[mios-as-operator] broker error: $_resp" >&2
            exit 1
            ;;
        *)
            ;;
    esac
fi

WSL_DISTRO=""
if [ -n "${WSL_DISTRO_NAME:-}" ]; then
    WSL_DISTRO="$WSL_DISTRO_NAME"
elif [ -r /etc/mios/wsl-distro ]; then
    WSL_DISTRO="$(tr -d '\r\n' < /etc/mios/wsl-distro)"
fi
if [ -z "$WSL_DISTRO" ] && [ -e /mnt/c/Windows/System32/wsl.exe ]; then
    WSL_DISTRO="$(/mnt/c/Windows/System32/wsl.exe -l --quiet 2>/dev/null | tr -d '\0\r' | head -1 | sed 's/[[:space:]]*$//')"
fi
[ -z "$WSL_DISTRO" ] && WSL_DISTRO="podman-MiOS-DEV"
WSL_EXE="/mnt/c/Windows/System32/wsl.exe"
if [ ! -e "$WSL_EXE" ]; then
    echo "Mios-as-operator: $WSL_EXE not found" >&2
    exit 1
fi

quoted=""
for arg in "$@"; do
    quoted="${quoted} $(_quote "$arg")"
done

exec "$WSL_EXE" -d "$WSL_DISTRO" --user "$_op_user" -- \
    bash -lc "nohup setsid${quoted} >/tmp/mios-as-operator.log 2>&1 < /dev/null &" \
    >/dev/null 2>&1
