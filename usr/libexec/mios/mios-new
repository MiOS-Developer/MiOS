#!/usr/bin/env python3
# AI-hint: Command-line utility to scaffold new MiOS files from canonical templates, interpolating names, dates, and settings.
# AI-related: /usr/share/mios/templates/, /usr/share/mios/mios.toml
# AI-functions: main, render_template, get_dest_path, next_ordinal

import sys
import os
import re
from datetime import datetime

repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../.."))
sys.path.insert(0, os.path.join(repo_root, "usr/lib/mios"))
import mios_toml

TEMPLATES_DIR = os.environ.get("MIOS_TEMPLATES_DIR", "/usr/share/mios/templates")
if not os.path.exists(TEMPLATES_DIR):
    repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../.."))
    TEMPLATES_DIR = os.path.join(repo_root, "usr/share/mios/templates")

def to_pascal_case(s):
    return "".join(w.capitalize() for w in re.split(r"[-_]", s))

import argparse

def render_template(content, name, type_name, description=None, ordinal=None):
    date_str = datetime.now().strftime("%Y-%m-%d")
    pascal_name = to_pascal_case(name)
    
    content = content.replace("{{name}}", name)
    content = content.replace("{{PascalName}}", pascal_name)
    content = content.replace("{{date}}", date_str)
    
    if type_name == "adr":
        # The ordinal comes from whoever knows it: the caller if they numbered
        # the name, otherwise the allocator that chose the destination. Slicing
        # the title by a PLACEHOLDER id (the old "0000") ate the first four
        # characters of every unnumbered slug.
        match = re.match(r"^(\d+)", name)
        if match:
            adr_id, slug = match.group(1), name[len(match.group(1)):]
        else:
            adr_id, slug = (ordinal or "0000"), name
        title = slug.strip("-_ ").replace("-", " ").replace("_", " ").capitalize()
        content = content.replace("{{id}}", adr_id)
        content = content.replace("{{title}}", title)
        content = content.replace("{{status}}", "accepted")
    elif type_name == "drift-check":
        content = content.replace("{{id}}", "99")
        content = content.replace("{{description}}", description if description else "static check for " + name)
    elif type_name == "quadlet":
        content = content.replace("{{image}}", "docker.io/library/" + name + ":latest")
        content = content.replace("{{uid}}", "1000")
        content = content.replace("{{gid}}", "1000")
    elif type_name == "systemd-unit":
        pass
    elif type_name == "roadmap-ws":
        content = content.replace("{{id}}", name.upper())
        content = content.replace("{{title}}", name.replace("-", " ").capitalize())
        content = content.replace("{{theme}}", "OS-Image & Build")
        content = content.replace("{{status}}", "proposed")
        content = content.replace("{{priority}}", "P2")
        content = content.replace("{{description}}", description if description else "Description of " + name)
        content = content.replace("{{task_title}}", "Task 1 for " + name)
        content = content.replace("{{task_id}}", "999")
        
    if description:
        content = content.replace("{{description}}", description)

    return content

def next_ordinal(dest_dir, width):
    """The lowest unused ordinal in dest_dir, for a type numbered sequentially.

    Scanning beats a stored counter: the directory listing IS the allocation
    record, so it cannot drift out of step with the files the way a hand-bumped
    name_prefix in SSOT did. An unreadable or empty directory yields the first
    ordinal rather than raising -- scaffolding into a fresh tree is legitimate.
    """
    pat = re.compile(r"^(\d{%d})-" % width)
    used = set()
    try:
        entries = os.listdir(dest_dir)
    except OSError:
        entries = []
    for entry in entries:
        m = pat.match(entry)
        if m:
            used.add(int(m.group(1)))
    n = 1
    while n in used:
        n += 1
    return n

def get_dest_path(name, type_name, repo_root):
    cfg = mios_toml.load_merged()
    tmpl_cfg = cfg.get("templates", {}).get(type_name, {})
    if not tmpl_cfg:
        return None

    if tmpl_cfg.get("emit") == "stdout":
        return None

    if "fixed_name" in tmpl_cfg:
        return os.path.join(repo_root, tmpl_cfg["fixed_name"])

    dest_dir = tmpl_cfg.get("dest_dir", ".")
    if tmpl_cfg.get("emit") == "directory":
        return os.path.join(repo_root, dest_dir, name)

    prefix = tmpl_cfg.get("name_prefix", "")
    if prefix:
        seed = re.match(r"^(\d+)-$", prefix)
        if seed:
            # An ordinal prefix is a seed, not a literal. A name the caller
            # already numbered is left alone; otherwise the number comes from
            # SSOT: the next free one for a sequential type (ADRs), or the seed
            # itself for a type whose ordinal means something else (the
            # automation NN- steps encode execution order, not sequence).
            width = len(seed.group(1))
            if not re.match(r"^\d+-", name):
                if tmpl_cfg.get("name_ordinal_next"):
                    nxt = next_ordinal(os.path.join(repo_root, dest_dir), width)
                else:
                    nxt = int(seed.group(1))
                name = "%0*d-%s" % (width, nxt, name)
        elif not name.startswith(prefix):
            name = prefix + name

    suffix = tmpl_cfg.get("name_suffix", "")
    if suffix and not name.endswith(suffix):
        name += suffix

    return os.path.join(repo_root, dest_dir, name)

def get_registered_types():
    cfg = mios_toml.load_merged()
    return sorted(cfg.get("templates", {}).keys())

import subprocess

def _try_native_bin(args_list):
    if len(args_list) < 2 or args_list[0] == "--list":
        return
    bin_path = os.environ.get("MIOS_MIOSD")
    if not bin_path:
        repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../.."))
        candidate = os.path.join(repo_root, "target/release/miosd.exe" if os.name == "nt" else "target/release/miosd")
        if os.path.isfile(candidate):
            bin_path = candidate
    if bin_path and os.path.isfile(bin_path):
        try:
            res = subprocess.run([bin_path, "scaffold", args_list[0], args_list[1]], stdout=sys.stdout, stderr=sys.stderr)
            sys.exit(res.returncode)
        except Exception:
            pass

def main():
    _try_native_bin(sys.argv[1:])
    types = get_registered_types()

    parser = argparse.ArgumentParser(description="Scaffold new MiOS files from canonical templates.", add_help=False)
    parser.add_argument("--list", action="store_true", help="List registered template types")
    parser.add_argument("-o", "--out", dest="out_path", help="Target output filepath override")
    parser.add_argument("-d", "--description", dest="description", help="Description interpolation override")
    parser.add_argument("-h", "--help", action="store_true", help="Show usage")
    parser.add_argument("type_name", nargs="?", help="Template type name")
    parser.add_argument("name", nargs="?", help="Scaffold entity name")

    args, unknown = parser.parse_known_args()

    if args.list:
        for t in types:
            print(t)
        sys.exit(0)

    if args.help or not args.type_name or not args.name:
        print("Usage: mios-new <type> <name> [--out <path>] [--description <desc>]")
        print("Types: " + ", ".join(types))
        sys.exit(0 if args.help else 1)

    type_name = args.type_name
    name = args.name

    template_path = os.path.join(TEMPLATES_DIR, type_name)
    if not os.path.exists(template_path):
        print(f"Error: Template for '{type_name}' not found at {template_path}")
        sys.exit(1)

    repo_root = os.environ.get("MIOS_DRIFT_CHECK_ROOT")
    if not repo_root:
        repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../.."))

    dest_path = args.out_path if args.out_path else get_dest_path(name, type_name, repo_root)

    if os.path.isdir(template_path):
        if not dest_path:
            dest_path = os.path.join(repo_root, "tools/native", name)
        dest_path = os.path.abspath(dest_path)
        os.makedirs(dest_path, exist_ok=True)
        for root_dir, _, files in os.walk(template_path):
            rel_dir = os.path.relpath(root_dir, template_path)
            target_sub = os.path.join(dest_path, rel_dir) if rel_dir != "." else dest_path
            os.makedirs(target_sub, exist_ok=True)
            for fname in files:
                src_f = os.path.join(root_dir, fname)
                dst_f = os.path.join(target_sub, fname)
                if os.path.exists(dst_f) and not args.out_path:
                    print(f"Error: Target file already exists at {dst_f}")
                    sys.exit(1)
                with open(src_f, "r", encoding="utf-8") as f:
                    content = f.read()
                rendered = render_template(content, name, type_name, description=args.description)
                with open(dst_f, "w", encoding="utf-8", newline="\n") as f:
                    f.write(rendered)
        # Auto-update workspace manifest if rust crate
        gen_script = os.path.join(repo_root, "tools/generate-cargo-manifests.py")
        if os.path.isfile(gen_script) and type_name in ("rust_crate", "rust-crate"):
            try:
                subprocess.run([sys.executable, gen_script], cwd=repo_root, check=False)
            except Exception:
                pass
        print(f"Scaffolded new {type_name} at: {dest_path}")
        return

    with open(template_path, "r", encoding="utf-8") as f:
        template_content = f.read()

    # Render AFTER the destination is known: a sequential type's ordinal only
    # exists once the allocator has picked one, and a file whose {{id}} says
    # something other than its own filename is a hand-fix waiting to happen.
    ordinal = None
    if dest_path:
        m = re.match(r"^(\d+)-", os.path.basename(dest_path))
        if m:
            ordinal = m.group(1)
    rendered = render_template(template_content, name, type_name,
                               description=args.description, ordinal=ordinal)

    if dest_path:
        dest_path = os.path.abspath(dest_path)
        os.makedirs(os.path.dirname(dest_path), exist_ok=True)
        if os.path.exists(dest_path) and not args.out_path:
            print(f"Error: Target file already exists at {dest_path}")
            sys.exit(1)
        with open(dest_path, "w", encoding="utf-8", newline="\n") as f:
            f.write(rendered)
        if type_name in ("bash-verb", "bash-tool", "bash"):
            try:
                os.chmod(dest_path, 0o755)
            except Exception:
                pass
        print(f"Scaffolded new {type_name} at: {dest_path}")
    else:
        print(rendered)

if __name__ == "__main__":
    main()
