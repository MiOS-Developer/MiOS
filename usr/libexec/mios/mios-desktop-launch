#!/bin/sh
# AI-hint: Native desktop dispatch adapter. Return the requested app's executable-start receipt; never wait for a GUI lifetime or repeat an unknown dispatch.
# AI-related: tools/native/mios-gen/src/app_preflight.rs, usr/libexec/mios/mios-launch, usr/share/mios/mios.toml [desktop.launch]
# AI-doc: usr/share/doc/mios/manual/ch31-desktop-applications-and-flatpaks.md
set -eu
if [ "${1:-}" = "launch" ]; then shift; fi
if [ "$#" -lt 1 ]; then
    echo "Usage: mios-desktop-launch [launch] <desktop-file> [args...]" >&2
    exit 1
fi
# Keep the public adapter usable when a caller has closed a standard descriptor.
if ! : <&0 2>/dev/null; then exec 0</dev/null; fi
if ! : >&1 2>/dev/null; then exec 1>/dev/null; fi
if ! : >&2 2>/dev/null; then exec 2>/dev/null; fi
# Retain the existing desktop compatibility environment. The native dispatcher
# strips every MIOS_* variable from the application, after resolving its policy.
CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
case "$CURRENT_DESKTOP" in *GNOME*) ;; *) CURRENT_DESKTOP="${CURRENT_DESKTOP}:GNOME:Phosh" ;; esac
export XDG_CURRENT_DESKTOP="$CURRENT_DESKTOP"
exec mios-gen desktop-dispatch --root "${MIOS_TOML_ROOT:-/}" -- "$@"
