#!/usr/bin/env python3
# AI-hint: Configures Open WebUI's web-search feature by updating the webui.db SQLite database to enable search augmentation and point the search engine to the local SearXNG instance on the `searxng` port.
# AI-related: mios-searxng, mios-owui-apply-system-prompt
"""mios-owui-apply-websearch -- enable Open WebUI's built-in web-search
augmentation + point it at the local SearXNG (the `searxng` port key,
through [search].endpoint).

OWUI's web-search feature is OFF by default in upstream. When enabled,
every chat turn can be augmented by retrieving + injecting web results
into the model's context (gated by an in-chat toggle the user clicks
on each message). Pointing it at the local SearXNG keeps everything
on-box; no external API keys, no rate limits, no telemetry.

Idempotent: only updates keys that aren't already correct. Mirrors the
mios-owui-apply-system-prompt pattern (operator-managed marker via the
default values themselves -- if the operator changes a key in OWUI's
admin UI, this script LEAVES it alone unless that key is one of the
must-be-true bools we flip).
"""
import json
import os
import sqlite3
import sys
from pathlib import Path

DB = Path(os.environ.get("MIOS_OWUI_DB", "/var/lib/mios/open-webui/webui.db"))

_LIB = os.path.normpath(os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios"))


def searxng_query_url() -> str:
    """The query URL Open WebUI's backend calls.

    mios-open-webui is a member of the host-network mios-ai pod, so it shares
    the host's loopback with the 127.0.0.1-bound SearXNG listener: localhost is
    its route. (On a host network host.containers.internal names a non-loopback
    host address, which a loopback bind refuses.) A non-empty
    MIOS_OWUI_SEARXNG_QUERY is an explicit override; otherwise the URL derives
    from the resolved [search].endpoint. No literal stands in for a missing
    setting (KeyError)."""
    override = os.environ.get("MIOS_OWUI_SEARXNG_QUERY", "").strip()
    if override:
        return override
    if _LIB not in sys.path:
        sys.path.insert(0, _LIB)
    import mios_toml
    endpoint = mios_toml.resolved_export("MIOS_SEARCH_ENDPOINT")
    return endpoint.rstrip("/") + "/search?q=<query>"


def desired() -> dict:
    return {
        "enable": True,
        "engine": "searxng",
        "searxng_query_url": searxng_query_url(),
        "result_count": 5,
        "concurrent_requests": 10,
        "bypass_embedding_and_retrieval": True,
        "trust_env": True,
    }


def _log(msg: str) -> None:
    print(f"[mios-owui-apply-websearch] {msg}", file=sys.stderr)


def main() -> int:
    if not DB.exists():
        _log(f"OWUI db {DB} not present yet -- skipping (re-run after OWUI first start)")
        return 0
    conn = sqlite3.connect(str(DB))
    try:
        try:
            rows = conn.execute("SELECT id, data FROM config").fetchall()
        except sqlite3.OperationalError as e:
            if "no such column: id" in str(e) or "no such column: data" in str(e):
                print("config schema likely changed -- no hardcoded websearch to clear")
                return 0
            raise e
        if not rows:
            _log("config table empty -- OWUI not initialised yet; skipping")
            return 0
        try:
            wanted = desired()
        except KeyError as e:
            _log(f"SearXNG endpoint unresolved: {e}")
            return 1
        for cid, blob in rows:
            try:
                cfg = json.loads(blob) if isinstance(blob, str) else (blob or {})
            except Exception as e:
                _log(f"config row id={cid}: not parseable JSON ({e}); skipping")
                continue
            search = cfg.setdefault("rag", {}).setdefault("web", {}).setdefault("search", {})
            applied = []
            for k, v in wanted.items():
                if search.get(k) != v:
                    search[k] = v
                    applied.append(f"{k}={v}")
            if applied:
                conn.execute(
                    "UPDATE config SET data = ? WHERE id = ?",
                    (json.dumps(cfg), cid),
                )
                conn.commit()
                _log(f"row id={cid}: applied {len(applied)} changes:")
                for a in applied:
                    _log(f"  - {a}")
            else:
                _log(f"row id={cid}: web search already configured -- no-op")
        return 0
    finally:
        conn.close()


if __name__ == "__main__":
    sys.exit(main())
