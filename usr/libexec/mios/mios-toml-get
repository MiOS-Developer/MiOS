#!/usr/bin/env python3
# AI-hint: Thin shell-facing CLI over the shared usr/lib/mios/mios_toml.py resolver, with native tools/native/mios-toml-get dispatch.
# AI-related: ../../lib/mios/mios_toml.py, ./mios-sync-theme, tools/native/mios-toml-get/
# AI-functions: main
"""Shell CLI over the shared mios_toml resolver: native dispatch with fallback."""

from __future__ import annotations
import json
import os
import subprocess
import sys


def _native_bin() -> str | None:
    exe = "mios-toml-get.exe" if os.name == "nt" else "mios-toml-get"
    root = os.environ.get("MIOS_TOML_ROOT") or os.environ.get("MIOS_ROOT") or os.path.abspath(
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..")
    )
    for p in (
        os.path.join(root, "tools", "native", "target", "release", exe),
        os.path.join(root, "tools", "native", "target", "debug", exe),
        os.path.join("/usr/bin", exe),
        os.path.join("/usr/local/bin", exe),
    ):
        if os.path.isfile(p):
            return p
    return None


def main(argv: list[str]) -> int:
    nb = _native_bin()
    if nb:
        try:
            res = subprocess.run([nb] + argv[1:], stdout=sys.stdout, stderr=sys.stderr)
            return res.returncode
        except Exception:
            pass

    args = argv[1:]
    if not args or args[0] in ("-h", "--help"):
        sys.stderr.write(
            "usage: mios-toml-get [--vendor] <section[.sub]> <key> [default]   # scalar\n"
            "       mios-toml-get [--vendor] --section <a.b>                    # sub-table as JSON\n"
            "       mios-toml-get [--vendor] --dump <a.b> <key> [<key> ...]     # k=v lines\n")
        return 2

    use_vendor = False
    if args[0] == "--vendor":
        use_vendor = True
        args = args[1:]

    if not args:
        sys.stderr.write("mios-toml-get: missing arguments after --vendor\n")
        return 2

    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios"))
    import mios_toml
    data = mios_toml.load_vendor() if use_vendor else mios_toml.load_merged()

    def _sc(v: object) -> str:
        if isinstance(v, bool):
            return "true" if v else "false"
        if isinstance(v, (list, dict)):
            return json.dumps(v)
        return "" if v is None else str(v)

    if args[0] == "--section":
        if len(args) < 2:
            sys.stderr.write("mios-toml-get --section needs a section\n")
            return 2
        print(json.dumps(mios_toml.section(data, args[1])))
        return 0

    if args[0] == "--dump":
        if len(args) < 3:
            sys.stderr.write("mios-toml-get --dump needs a section + at least one key\n")
            return 2
        sect = mios_toml.section(data, args[1])
        for k in args[2:]:
            print(f"{k}={_sc(sect.get(k))}")
        return 0

    if len(args) < 2:
        sys.stderr.write("mios-toml-get needs <section> <key>\n")
        return 2

    val = mios_toml.section(data, args[0]).get(args[1])
    default_val = args[2] if len(args) > 2 else ""
    print(default_val if val is None else _sc(val))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
