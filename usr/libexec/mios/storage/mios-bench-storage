def percentile(data: List[float], p: float) -> float:
    """Calculates percentile p (0..100) from sorted list."""
    if not data:
        return 0.0
    k = (len(data) - 1) * (p / 100.0)
    f = math.floor(k)
    c = math.ceil(k)
    if f == c:
        return data[int(k)]
    d0 = data[int(f)] * (c - k)
    d1 = data[int(c)] * (k - f)
    return d0 + d1


def prepare_benchmark_file(target_dir: str, file_size_mb: int = 32) -> str:
    """Creates a temporary pre-allocated test scratch file."""
    os.makedirs(target_dir, exist_ok=True)
    temp_fd, temp_path = tempfile.mkstemp(
        prefix="mios_bench_scratch_",
        suffix=".dat",
        dir=target_dir,
    )
    os.close(temp_fd)

    # Write initial pseudo-random data in 1MB chunks
    chunk_1m = os.urandom(1024 * 1024)
    with open(temp_path, "wb") as f:
        for _ in range(file_size_mb):
            f.write(chunk_1m)
        f.flush()
        os.fsync(f.fileno())

    return temp_path


def run_random_4k_read_benchmark(
    file_path: str,
    duration_sec: float = 2.0,
    max_ops: int = 50000,
) -> Tuple[float, float]:
    """
    Executes random 4KB read benchmark.
    Returns: (iops, avg_latency_us)
    """
    file_size = os.path.getsize(file_path)
    block_size = 4096
    max_blocks = max(1, (file_size // block_size) - 1)

    ops_done = 0
    start_time = time.perf_counter()
    end_time = start_time + duration_sec
    latencies_us: List[float] = []

    with open(file_path, "rb") as f:
        fd = f.fileno()
        while time.perf_counter() < end_time and ops_done < max_ops:
            blk = random.randint(0, max_blocks)
            offset = blk * block_size
            t0 = time.perf_counter_ns()
            os.lseek(fd, offset, os.SEEK_SET)
            _ = os.read(fd, block_size)
            t1 = time.perf_counter_ns()
            latencies_us.append((t1 - t0) / 1000.0)
            ops_done += 1

    elapsed = time.perf_counter() - start_time
    iops = (ops_done / elapsed) if elapsed > 0 else 0.0
    avg_latency = (sum(latencies_us) / len(latencies_us)) if latencies_us else 0.0
    return round(iops, 2), round(avg_latency, 2)


def run_random_4k_write_benchmark(
    file_path: str,
    duration_sec: float = 2.0,
    max_ops: int = 50000,
) -> Tuple[float, float]:
    """
    Executes random 4KB write benchmark.
    Returns: (iops, avg_latency_us)
    """
    file_size = os.path.getsize(file_path)
    block_size = 4096
    max_blocks = max(1, (file_size // block_size) - 1)
    payload = os.urandom(block_size)

    ops_done = 0
    start_time = time.perf_counter()
    end_time = start_time + duration_sec
    latencies_us: List[float] = []

    with open(file_path, "r+b") as f:
        fd = f.fileno()
        while time.perf_counter() < end_time and ops_done < max_ops:
            blk = random.randint(0, max_blocks)
            offset = blk * block_size
            t0 = time.perf_counter_ns()
            os.lseek(fd, offset, os.SEEK_SET)
            os.write(fd, payload)
            t1 = time.perf_counter_ns()
            latencies_us.append((t1 - t0) / 1000.0)
            ops_done += 1
        os.fsync(fd)

    elapsed = time.perf_counter() - start_time
    iops = (ops_done / elapsed) if elapsed > 0 else 0.0
    avg_latency = (sum(latencies_us) / len(latencies_us)) if latencies_us else 0.0
    return round(iops, 2), round(avg_latency, 2)


def run_seq_1m_read_benchmark(
    file_path: str,
    duration_sec: float = 2.0,
) -> float:
    """
    Executes sequential 1MB read benchmark.
    Returns: throughput in MB/s
    """
    file_size = os.path.getsize(file_path)
    block_size = 1024 * 1024
    bytes_read = 0

    start_time = time.perf_counter()
    end_time = start_time + duration_sec

    with open(file_path, "rb") as f:
        fd = f.fileno()
        while time.perf_counter() < end_time:
            os.lseek(fd, 0, os.SEEK_SET)
            remaining = file_size
            while remaining > 0 and time.perf_counter() < end_time:
                chunk_len = min(remaining, block_size)
                data = os.read(fd, chunk_len)
                if not data:
                    break
                bytes_read += len(data)
                remaining -= len(data)

    elapsed = time.perf_counter() - start_time
    mb_read = bytes_read / (1024 * 1024)
    mbps = (mb_read / elapsed) if elapsed > 0 else 0.0
    return round(mbps, 2)


def run_seq_1m_write_benchmark(
    file_path: str,
    duration_sec: float = 2.0,
) -> float:
    """
    Executes sequential 1MB write benchmark.
    Returns: throughput in MB/s
    """
    file_size = os.path.getsize(file_path)
    block_size = 1024 * 1024
    payload = os.urandom(block_size)
    bytes_written = 0

    start_time = time.perf_counter()
    end_time = start_time + duration_sec

    with open(file_path, "r+b") as f:
        fd = f.fileno()
        while time.perf_counter() < end_time:
            os.lseek(fd, 0, os.SEEK_SET)
            remaining = file_size
            while remaining > 0 and time.perf_counter() < end_time:
                chunk_len = min(remaining, block_size)
                wrote = os.write(fd, payload[:chunk_len])
                bytes_written += wrote
                remaining -= wrote
        os.fsync(fd)

    elapsed = time.perf_counter() - start_time
    mb_written = bytes_written / (1024 * 1024)
    mbps = (mb_written / elapsed) if elapsed > 0 else 0.0
    return round(mbps, 2)


def run_fsync_latency_benchmark(
    file_path: str,
    iterations: int = 50,
) -> Dict[str, float]:
    """
    Measures fsync flush durability latency (4K write + os.fsync).
    Returns percentiles (p50, p90, p95, p99, max, mean) in microseconds.
    """
    payload = os.urandom(4096)
    latencies_us: List[float] = []

    with open(file_path, "r+b") as f:
        fd = f.fileno()
        for _ in range(iterations):
            os.lseek(fd, 0, os.SEEK_SET)
            os.write(fd, payload)
            t0 = time.perf_counter_ns()
            os.fsync(fd)
            t1 = time.perf_counter_ns()
            latencies_us.append((t1 - t0) / 1000.0)

    latencies_us.sort()
    return {
        "p50_us": round(percentile(latencies_us, 50), 2),
        "p90_us": round(percentile(latencies_us, 90), 2),
        "p95_us": round(percentile(latencies_us, 95), 2),
        "p99_us": round(percentile(latencies_us, 99), 2),
        "max_us": round(latencies_us[-1] if latencies_us else 0.0, 2),
        "mean_us": round(sum(latencies_us) / len(latencies_us), 2) if latencies_us else 0.0,
    }


def evaluate_inference_floors(
    metrics: Dict[str, Any],
    profile_name: str = "standard",
) -> Dict[str, Any]:
    """Evaluates benchmark metrics against specified hardware floor profile."""
    floor = AI_INFERENCE_FLOORS.get(profile_name, AI_INFERENCE_FLOORS["standard"])
    evaluations: Dict[str, Any] = {}
    all_passed = True

    # 1. 4K Random Read IOPS
    eval_rand_r = metrics["iops_rand_read_4k"] >= floor["min_iops_rand_read_4k"]
    evaluations["iops_rand_read_4k"] = {
        "measured": metrics["iops_rand_read_4k"],
        "required": floor["min_iops_rand_read_4k"],
        "passed": eval_rand_r,
    }
    if not eval_rand_r:
        all_passed = False

    # 2. 4K Random Write IOPS
    eval_rand_w = metrics["iops_rand_write_4k"] >= floor["min_iops_rand_write_4k"]
    evaluations["iops_rand_write_4k"] = {
        "measured": metrics["iops_rand_write_4k"],
        "required": floor["min_iops_rand_write_4k"],
        "passed": eval_rand_w,
    }
    if not eval_rand_w:
        all_passed = False

    # 3. 1M Sequential Read Throughput
    eval_seq_r = metrics["mbps_seq_read_1m"] >= floor["min_mbps_seq_read_1m"]
    evaluations["mbps_seq_read_1m"] = {
        "measured": metrics["mbps_seq_read_1m"],
        "required": floor["min_mbps_seq_read_1m"],
        "passed": eval_seq_r,
    }
    if not eval_seq_r:
        all_passed = False

    # 4. 1M Sequential Write Throughput
    eval_seq_w = metrics["mbps_seq_write_1m"] >= floor["min_mbps_seq_write_1m"]
    evaluations["mbps_seq_write_1m"] = {
        "measured": metrics["mbps_seq_write_1m"],
        "required": floor["min_mbps_seq_write_1m"],
        "passed": eval_seq_w,
    }
    if not eval_seq_w:
        all_passed = False

    # 5. fsync Latency P95
    p95 = metrics["fsync_latency_us"]["p95_us"]
    eval_fsync = p95 <= floor["max_fsync_latency_p95_us"]
    evaluations["fsync_latency_p95_us"] = {
        "measured": p95,
        "threshold_max": floor["max_fsync_latency_p95_us"],
        "passed": eval_fsync,
    }
    if not eval_fsync:
        all_passed = False

    return {
        "profile": profile_name,
        "description": floor["description"],
        "meets_ai_inference_floors": all_passed,
        "evaluations": evaluations,
    }


def run_full_storage_benchmark(
    target_dir: str,
    file_size_mb: int = 32,
    duration_sec: float = 1.5,
    fsync_iterations: int = 50,
    profile: str = "standard",
) -> Dict[str, Any]:
    """Coordinates full benchmark suite on target directory with cleanup."""
    os.makedirs(target_dir, exist_ok=True)
    scratch_file = prepare_benchmark_file(target_dir, file_size_mb=file_size_mb)

    try:
        # Run benchmarks
        rand_r_iops, rand_r_lat = run_random_4k_read_benchmark(scratch_file, duration_sec=duration_sec)
        rand_w_iops, rand_w_lat = run_random_4k_write_benchmark(scratch_file, duration_sec=duration_sec)
        seq_r_mbps = run_seq_1m_read_benchmark(scratch_file, duration_sec=duration_sec)
        seq_w_mbps = run_seq_1m_write_benchmark(scratch_file, duration_sec=duration_sec)
        fsync_metrics = run_fsync_latency_benchmark(scratch_file, iterations=fsync_iterations)

        metrics = {
            "target_dir": os.path.abspath(target_dir),
            "file_size_mb": file_size_mb,
            "duration_sec": duration_sec,
            "iops_rand_read_4k": rand_r_iops,
            "latency_rand_read_4k_us": rand_r_lat,
            "iops_rand_write_4k": rand_w_iops,
            "latency_rand_write_4k_us": rand_w_lat,
            "mbps_seq_read_1m": seq_r_mbps,
            "mbps_seq_write_1m": seq_w_mbps,
            "fsync_latency_us": fsync_metrics,
        }

        eval_result = evaluate_inference_floors(metrics, profile_name=profile)
        metrics["assessment"] = eval_result
        return metrics
    finally:
        if os.path.exists(scratch_file):
            try:
                os.remove(scratch_file)
            except OSError:
                pass


def main() -> int:
    parser = argparse.ArgumentParser(description="MiOS Storage Performance Benchmark Tool (mios-bench-storage)")
    parser.add_argument("--path", "--target-dir", default=None, help="Benchmark target directory (default: system tmp or /var/tmp/mios/bench)")
    parser.add_argument("--file-size", type=int, default=32, help="Benchmark scratch file size in MB (default: 32MB)")
    parser.add_argument("--duration", "--runtime", type=float, default=1.5, help="Test duration in seconds per phase (default: 1.5s)")
    parser.add_argument("--profile", choices=list(AI_INFERENCE_FLOORS.keys()), default="standard", help="AI Inference Floor Profile")
    parser.add_argument("--quick", action="store_true", help="Quick mode (0.5s duration, 16MB file)")
    parser.add_argument("--json", action="store_true", help="Output machine-readable JSON")

    args = parser.parse_args()

    target_dir = args.path
    if not target_dir:
        # Default target directory
        if os.path.exists("/var/tmp"):
            target_dir = "/var/tmp/mios/bench"
        else:
            target_dir = tempfile.gettempdir()

    file_size_mb = 16 if args.quick else args.file_size
    duration_sec = 0.5 if args.quick else args.duration
    fsync_iters = 20 if args.quick else 50

    try:
        report = run_full_storage_benchmark(
            target_dir=target_dir,
            file_size_mb=file_size_mb,
            duration_sec=duration_sec,
            fsync_iterations=fsync_iters,
            profile=args.profile,
        )

        if args.json:
            print(json.dumps(report, indent=2))
        else:
            assessment = report["assessment"]
            status_str = "PASS (Meets Floor)" if assessment["meets_ai_inference_floors"] else "WARN (Below Floor)"
            print("================================================================================")
            print(f" MiOS Storage Performance Benchmark Report: {report['target_dir']}")
            print(f" Profile: {assessment['profile']} ({assessment['description']})")
            print(f" Overall Floor Status: {status_str}")
            print("================================================================================")
            print(f"  Random 4K Read:       {report['iops_rand_read_4k']:>10.1f} IOPS  (latency: {report['latency_rand_read_4k_us']:.1f} us)")
            print(f"  Random 4K Write:      {report['iops_rand_write_4k']:>10.1f} IOPS  (latency: {report['latency_rand_write_4k_us']:.1f} us)")
            print(f"  Sequential 1M Read:   {report['mbps_seq_read_1m']:>10.1f} MB/s")
            print(f"  Sequential 1M Write:  {report['mbps_seq_write_1m']:>10.1f} MB/s")
            print(f"  fsync Latency:        p50: {report['fsync_latency_us']['p50_us']} us | p95: {report['fsync_latency_us']['p95_us']} us | p99: {report['fsync_latency_us']['p99_us']} us")
            print("--------------------------------------------------------------------------------")
            for k, ev in assessment["evaluations"].items():
                p_sym = "[OK]" if ev["passed"] else "[FAIL]"
                print(f"  {p_sym} {k:<25}: measured={ev.get('measured')} req={ev.get('required') or ev.get('threshold_max')}")
            print("================================================================================")

        return 0
    except Exception as e:
        sys.stderr.write(f"[mios-bench-storage] Benchmark error: {e}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
