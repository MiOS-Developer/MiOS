#!/usr/bin/env python3
# AI-hint: Zero-Knowledge untrusted remote snapshot transport protocol client (task_466, task_2699).
# AI-doc: usr/share/doc/mios/manual/ch11-storage-and-persistence.md
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import sys
import time
from typing import Any, Dict, List


def verify_inert_snapshot(meta_file: str, payload_file: str) -> Dict[str, Any]:
    """Verify that the snapshot is genuinely inert and contains no decryption keys."""
    if not os.path.isfile(meta_file):
        raise FileNotFoundError(f"Metadata file missing: {meta_file}")
    if not os.path.isfile(payload_file):
        raise FileNotFoundError(f"Payload file missing: {payload_file}")

    with open(meta_file, "r", encoding="utf-8") as f:
        meta = json.load(f)

    # Invariant: Snapshot metadata MUST declare inert=True and MUST NOT contain raw keys or secrets
    if not meta.get("inert"):
        raise ValueError(f"Snapshot in {meta_file} is not marked as inert")

    forbidden_keys = {"key", "raw_key", "master_key", "secret", "passphrase", "key_bytes"}
    present_forbidden = forbidden_keys.intersection(meta.keys())
    if present_forbidden:
        raise ValueError(f"Zero-knowledge violation: metadata contains prohibited key data: {present_forbidden}")

    # Verify payload checksum
    with open(payload_file, "rb") as f:
        payload_bytes = f.read()

    actual_sha = hashlib.sha256(payload_bytes).hexdigest()
    expected_sha = meta.get("payload_sha256")
    if actual_sha != expected_sha:
        raise ValueError(f"Payload checksum mismatch: expected {expected_sha}, got {actual_sha}")

    return meta


def transport_snapshot(meta_file: str, payload_file: str, remote_dest: str, dry_run: bool = False) -> Dict[str, Any]:
    """Transport inert encrypted snapshot to remote destination without transmitting any keys."""
    meta = verify_inert_snapshot(meta_file, payload_file)
    snap_id = meta.get("snapshot_id", "unknown-snap")

    receipt = {
        "status": "success",
        "snapshot_id": snap_id,
        "domain": meta.get("domain"),
        "remote_destination": remote_dest,
        "payload_bytes": meta.get("payload_bytes"),
        "payload_sha256": meta.get("payload_sha256"),
        "zero_knowledge_guarantee": True,
        "keys_transmitted": False,
        "transported_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }

    if dry_run:
        receipt["dry_run"] = True
        return receipt

    # Copy files to destination (directory or mock storage URI)
    os.makedirs(remote_dest, exist_ok=True)
    dest_meta = os.path.join(remote_dest, os.path.basename(meta_file))
    dest_payload = os.path.join(remote_dest, os.path.basename(payload_file))

    shutil.copy2(meta_file, dest_meta)
    shutil.copy2(payload_file, dest_payload)

    # Write transport receipt
    receipt_file = os.path.join(remote_dest, f"{snap_id}.transport-receipt.json")
    with open(receipt_file, "w", encoding="utf-8") as f:
        json.dump(receipt, f, indent=2)

    receipt["dest_meta"] = dest_meta
    receipt["dest_payload"] = dest_payload
    receipt["receipt_file"] = receipt_file

    return receipt


def main() -> int:
    parser = argparse.ArgumentParser(description="MiOS Zero-Knowledge Snapshot Transport Client")
    parser.add_argument("--meta", required=True, help="Path to snapshot .meta.json file")
    parser.add_argument("--payload", required=True, help="Path to snapshot .payload.enc file")
    parser.add_argument("--remote-dest", required=True, help="Remote destination directory or endpoint path")
    parser.add_argument("--dry-run", action="store_true", help="Perform verification without copying data")
    parser.add_argument("--json", action="store_true", help="Output result as JSON")

    args = parser.parse_args()

    try:
        res = transport_snapshot(args.meta, args.payload, args.remote_dest, dry_run=args.dry_run)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"[OK] Transported snapshot '{res['snapshot_id']}' to {res['remote_destination']}:")
            print(f"  Domain:          {res['domain']}")
            print(f"  Payload Size:    {res['payload_bytes']} bytes")
            print(f"  SHA-256:         {res['payload_sha256']}")
            print(f"  Zero-Knowledge:  VERIFIED (zero keys transmitted)")
        return 0
    except Exception as e:
        if args.json:
            print(json.dumps({"status": "error", "error": str(e)}, indent=2))
        else:
            print(f"[ERROR] {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
