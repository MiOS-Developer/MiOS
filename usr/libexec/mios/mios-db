#!/bin/bash
# AI-hint: Unified MiOS shared-state CLI fronting the agent backends: PostgreSQL/pgvector for cross-cutting state (--pg), Open WebUI's SQLite webui.db (--owui), and local OpenAI-compat embeddings on mios-llm-light (--embed).
# AI-related: userenv.sh, /usr/libexec/mios/mios-db, /usr/share/mios/mios.toml, /etc/mios/mios.toml, /usr/lib/mios/userenv.sh, /usr/share/mios/tools/lib/userenv.sh, /usr/libexec/mios/mios-pg-query, mios-pg-query, mios-env, mios-open-webui

set -uo pipefail

if [ "${1:-}" = "--config" ]; then
    shift
    for _ue in /usr/lib/mios/userenv.sh /usr/share/mios/tools/lib/userenv.sh; do
        if [ -r "$_ue" ]; then
            # shellcheck source=usr/lib/mios/userenv.sh
            . "$_ue"
            break
        fi
    done
    PG_HOST="${MIOS_PGVECTOR_HOST:-localhost}"
    PG_PORT="${MIOS_PORTS_PGVECTOR:-8600}"
    PG_USER="${MIOS_PGVECTOR_USER:-mios}"
    PG_PASS="${MIOS_PGVECTOR_PASS:-mios}"
    PG_DB="${MIOS_PGVECTOR_DB:-mios}"

    if [ "${1:-}" = "get" ]; then
        VAL_ESCAPED=$(echo "${2:-}" | sed "s/'/''/g")
        /usr/libexec/mios/mios-db --pg "SELECT value FROM system_config WHERE key = '$VAL_ESCAPED';"
        exit $?
    elif [ "${1:-}" = "set" ]; then
        KEY_ESCAPED=$(echo "${2:-}" | sed "s/'/''/g")
        VAL_ESCAPED=$(echo "${3:-}" | sed "s/'/''/g")
        /usr/libexec/mios/mios-db --pg "INSERT INTO system_config (key, value) VALUES ('$KEY_ESCAPED', '$VAL_ESCAPED'::jsonb) ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value;"
        exit $?
    elif [ "${1:-}" = "show" ]; then
        /usr/libexec/mios/mios-db --pg "SELECT key, value FROM system_config;"
        exit $?
    else
        echo "Usage: mios-db" >&2
        exit 1
    fi
fi

for _ue in /usr/lib/mios/userenv.sh /usr/share/mios/tools/lib/userenv.sh; do
    if [ -r "$_ue" ]; then
        # shellcheck source=usr/lib/mios/userenv.sh
        . "$_ue"
        break
    fi
done

OWUI_DB="${MIOS_OWUI_DB:-/var/lib/mios/open-webui/webui.db}"
EMBED_URL="${MIOS_EMBED_URL:-http://localhost:${MIOS_PORTS_LLM_LIGHT:-8500}}"
EMBED_MODEL="${MIOS_EMBED_MODEL:-nomic-embed-text}"
PG_HOST="${MIOS_PGVECTOR_HOST:-localhost}"
PG_PORT="${MIOS_PORTS_PGVECTOR:-8600}"
PG_USER="${MIOS_PGVECTOR_USER:-mios}"
PG_PASS="${MIOS_PGVECTOR_PASS:-mios}"
PG_DB="${MIOS_PGVECTOR_DB:-mios}"

JSON=0
FILE=""
QUERY=""
MODE="none"
OWUI_SQL=""
EMBED_TEXT=""
PG_SQL=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        # Retired SurrealDB namespace/database selectors: still accepted, and
        # still require their value, so existing invocations parse unchanged.
        --ns|--db)     : "$2"; shift 2 ;;
        --json)        JSON=1; shift ;;
        -f)            FILE="$2"; shift 2 ;;
        --owui)        MODE="owui"; OWUI_SQL="$2"; shift 2 ;;
        --embed)       MODE="embed"; EMBED_TEXT="$2"; shift 2 ;;
        --pg)          MODE="pg"; PG_SQL="$2"; shift 2 ;;
        --pg-json)     MODE="pgjson"; shift ;;
        --embed-model) EMBED_MODEL="$2"; shift 2 ;;
        -h|--help)
            sed -n '2,46p' "$0" | sed 's/^# \?//'
            exit 0 ;;
        --)            shift; QUERY="$*"; break ;;
        *)             QUERY="$1"; shift
                       [ "$#" -gt 0 ] && QUERY="$QUERY $*"
                       break ;;
    esac
done

if [ "$MODE" = "owui" ]; then
    if [ ! -r "$OWUI_DB" ]; then
        echo "Mios-db: OWUI webui.db not readable at $OWUI_DB" >&2
        exit 1
    fi
    if command -v sqlite3 >/dev/null 2>&1; then
        if [ "$JSON" = "1" ]; then
            exec sqlite3 -json "$OWUI_DB" "$OWUI_SQL"
        else
            exec sqlite3 -header -column "$OWUI_DB" "$OWUI_SQL"
        fi
    fi
    if command -v podman >/dev/null 2>&1 \
       && podman ps --format '{{.Names}}' 2>/dev/null | grep -q '^mios-open-webui$'; then
        exec podman exec -i mios-open-webui python3 -c '
import sqlite3, json, sys
sql = sys.stdin.read()
c = sqlite3.connect("/app/backend/data/webui.db")
cur = c.execute(sql)
cols = [d[0] for d in cur.description] if cur.description else []
rows = cur.fetchall()
out = [dict(zip(cols, r)) for r in rows]
print(json.dumps(out, default=str, indent=2))
' <<<"$OWUI_SQL"
    fi
    echo "Mios-db: no sqlite3 + no mios-open-webui container" >&2
    exit 2
fi

if [ "$MODE" = "embed" ]; then
    if ! command -v curl >/dev/null 2>&1; then
        echo "Mios-db: curl required for" >&2
        exit 2
    fi
    PAYLOAD=$(python3 -c '
import json, sys
print(json.dumps({"model": sys.argv[1], "input": sys.argv[2]}))
' "$EMBED_MODEL" "$EMBED_TEXT")
    exec curl -sS --max-time 15 \
        -X POST "${EMBED_URL}/v1/embeddings" \
        -H "Content-Type: application/json" \
        --data "$PAYLOAD"
fi

if [ "$MODE" = "pg" ]; then
    export PGPASSWORD="$PG_PASS"
    if command -v psql >/dev/null 2>&1; then
        pa=(-h "$PG_HOST" -p "$PG_PORT" -U "$PG_USER" -d "$PG_DB" -w)
        [ "$JSON" = "1" ] && pa+=(-At)
        if [ -n "$FILE" ]; then
            exec psql "${pa[@]}" -f "$FILE"
        else
            exec psql "${pa[@]}" -c "$PG_SQL"
        fi
    fi
    if command -v podman >/dev/null 2>&1 \
       && podman ps --format '{{.Names}}' 2>/dev/null | grep -q '^mios-pgvector$'; then
        pa=(exec -i -e "PGPASSWORD=$PG_PASS" mios-pgvector
            psql -h 127.0.0.1 -p "$PG_PORT" -U "$PG_USER" -d "$PG_DB" -w)
        [ "$JSON" = "1" ] && pa+=(-At)
        if [ -n "$FILE" ]; then
            exec podman "${pa[@]}" -f - < "$FILE"
        else
            exec podman "${pa[@]}" -c "$PG_SQL"
        fi
    fi
    if [ -x /usr/libexec/mios/mios-pg-query ]; then
        export MIOS_PGVECTOR_HOST="$PG_HOST" MIOS_PG_PORT="$PG_PORT" \
               MIOS_PGVECTOR_USER="$PG_USER" MIOS_PGVECTOR_DB="$PG_DB"
        if [ -n "$FILE" ]; then
            exec /usr/libexec/mios/mios-pg-query < "$FILE"
        else
            exec /usr/libexec/mios/mios-pg-query "$PG_SQL"
        fi
    fi
    echo "Mios-db: no psql + no mios-pgvector container + no mios-pg-query" >&2
    echo "  check: systemctl start mios-pgvector.service" >&2
    exit 2
fi

if [ "$MODE" = "pgjson" ]; then
    if [ -x /usr/libexec/mios/mios-pg-query ]; then
        export MIOS_PGVECTOR_HOST="$PG_HOST" MIOS_PG_PORT="$PG_PORT" \
               MIOS_PGVECTOR_USER="$PG_USER" MIOS_PGVECTOR_DB="$PG_DB"
        exec /usr/libexec/mios/mios-pg-query --exec-json
    fi
    echo "Mios-db:" >&2
    exit 2
fi

echo "Mios-db: no backend flag" >&2
echo "  mios-db" >&2
echo "  mios-db" >&2
echo "  mios-db" >&2
exit 2
