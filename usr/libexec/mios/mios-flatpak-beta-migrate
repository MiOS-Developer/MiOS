#!/bin/bash
# AI-hint: One-shot migration script that identifies Flatpaks from the flathub remote and reinstalls them from flathub-beta to update the origin while preserving user data.
# AI-related: /usr/libexec/mios/mios-flatpak-beta-migrate, mios-flatpak
set -euo pipefail

DRY=0
if [ "${1:-}" = "--dry-run" ]; then
    DRY=1
    shift
fi

if ! flatpak remotes 2>/dev/null | grep -q "^flathub-beta"; then
    echo "Mios-flatpak-beta-migrate: flathub-beta remote not configured" >&2
    echo "  add via: flatpak remote-add"
    echo "    https://flathub.org/beta-repo/flathub-beta.flatpakrepo" >&2
    exit 2
fi

SUDO=()
if [ "$(id -u)" -ne 0 ] && [ "$DRY" = "0" ]; then
    SUDO=(sudo -n)
fi

migrated=0
skipped=0
absent=0

while IFS=$'\t' read -r app_id origin; do
    [ -z "$app_id" ] && continue
    if [ "$origin" != "flathub" ]; then
        skipped=$((skipped + 1))
        echo "  skip   $app_id"
        continue
    fi
    if flatpak remote-info flathub-beta "$app_id" >/dev/null 2>&1; then
        if [ "$DRY" = "1" ]; then
            echo "  WOULD  $app_id"
        else
            echo "  migrate $app_id "
            if "${SUDO[@]}" flatpak install --system --noninteractive \
                    --reinstall --assumeyes flathub-beta "$app_id" >/dev/null 2>&1; then
                echo "  ✓  $app_id"
                migrated=$((migrated + 1))
            else
                echo "  ✗  $app_id"
            fi
        fi
    else
        absent=$((absent + 1))
        echo "  absent $app_id"
    fi
done < <(flatpak list --app --columns=application,origin 2>/dev/null)

echo
if [ "$DRY" = "1" ]; then
    echo "[dry-run] would migrate apps marked WOULD; no changes made"
else
    echo "[migrated=$migrated absent=$absent skipped=$skipped]"
fi
