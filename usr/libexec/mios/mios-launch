#!/bin/bash
# AI-hint: Universal launcher that resolves and executes applications across multiple environments (internal services, URLs, Windows binaries, MiOS shims, Linux GUI apps, and PATH binaries) based on a prioritized resolution logic.
# AI-related: /usr/libexec/mios/mios-launch, /etc/mios/mios.toml, /usr/share/mios/mios.toml, mios-open-url, mios-windows, mios-doctor, mios-flatpak-install, mios-skill-clone, mios-tool-clone, mios-gui
# AI-functions: _alias_resolve, _launch_resolved_desktop, _try_resolved_desktop, _pf_flatpak, _broker_dispatch, _launcher_override
set -euo pipefail

if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    cat <<'USAGE'
usage: mios-launch <name> [args...]

  <name> can be:
    * a known internal service alias: cockpit, owui, hermes, prefilter,
      inference, searxng, forgejo
    * a URL: http://..., https://..., file://...
    * a Windows GUI: notepad, explorer, calc, mspaint, snipping-tool,
      taskmgr, regedit, control, cmd, powershell, pwsh, OR a full
      /mnt/c/.../*.exe path
    * a MiOS shim: mios-doctor, mios-windows, mios-flatpak-install,
      mios-open-url, mios-skill-clone, mios-tool-clone, ...
    * a Linux GUI: any installed flatpak short-name (chromedev, epiphany,
      ptyxis, codium, flatseal, calculator, gnome-software, ...)
    * a plain CLI on PATH

Discovery: `mios-apps` for the full inventory.
USAGE
    exit 0
fi

NAME="$1"
shift

if [ -z "${NAME// }" ]; then
    echo "Mios-launch: empty target" >&2
    exit 2
fi

_alias_resolve() {
    python3 - "$(cd "$(dirname "$0")" && pwd)/../../lib/mios" "$1" <<'PYEOF' 2>/dev/null
import sys, re
sys.path.insert(0, sys.argv[1])
import mios_toml
raw = sys.argv[2]
norm = re.sub(r"\s+", "-", raw.strip().lower())
norm_stripped = re.sub(r"^(my|the)-", "", norm)
candidates = [raw, raw.lower(), norm, norm_stripped]
last = norm.split("-")[-1] if norm else ""
if last and last not in candidates:
    candidates.append(last)

d = mios_toml.load_merged()
aliases = d.get("mios-find", {}).get("aliases", {})
if isinstance(aliases, dict):
    for c in candidates:
        v = aliases.get(c)
        if isinstance(v, str) and v:
            print(v)
            sys.exit(0)
apps = d.get("desktop", {}).get("apps", [])
if isinstance(apps, list):
    roles = set()
    role_app = {}
    for app_cfg in apps:
        if not isinstance(app_cfg, dict):
            continue
        role = str(app_cfg.get("role", "")).lower().rstrip("s")
        aid = str(app_cfg.get("id", ""))
        if not role or not aid:
            continue
        roles.add(role)
        if app_cfg.get("default") is True or role not in role_app:
            role_app[role] = aid.split(".")[-1].lower()
    last_word = norm.split("-")[-1] if norm else ""
    head = "-".join(norm.split("-")[:-1])
    head = re.sub(r"^(my|the|a|an)-", "", head)
    if last_word.rstrip("s") in roles and head and head.rstrip("s") not in roles:
        print(head)
        sys.exit(0)
    for c in (norm, norm_stripped, last_word):
        cn = c.rstrip("s")
        if cn in role_app:
            print(role_app[cn])
            sys.exit(0)
PYEOF
}
_ORIG_NAME="$NAME"
_alias="$(_alias_resolve "$NAME")"
if [ -n "$_alias" ] && [ "$_alias" != "$NAME" ]; then
    echo "Mios-launch: alias '$NAME' -> '$_alias'" >&2
    NAME="$_alias"
fi

if command -v mios-app-type >/dev/null 2>&1; then
    _app_type_resolved="$(mios-app-type "$NAME" 2>/dev/null || true)"
    if [ -n "$_app_type_resolved" ] && [ "$_app_type_resolved" != "$NAME" ]; then
        echo "Mios-launch: app-type '$NAME' -> '$_app_type_resolved'" >&2
        NAME="$_app_type_resolved"
    fi
fi

if [ -r /etc/mios/install.env ]; then
    _mios_had_u=0; case "$-" in *u*) _mios_had_u=1;; esac
    set +u; set -a; . /etc/mios/install.env 2>/dev/null || true; set +a
    [ "$_mios_had_u" = 1 ] && set -u
fi
_PORT_COCKPIT="${MIOS_PORTS_COCKPIT:-8110}"
_PORT_OWUI="${MIOS_PORTS_OPEN_WEBUI:-8200}"
_PORT_HERMES="${MIOS_PORTS_HERMES:-8720}"
_PORT_PREFILTER="${MIOS_PORTS_PREFILTER:-8710}"
_PORT_SEARXNG="${MIOS_PORTS_SEARXNG:-8800}"
_PORT_FORGE="${MIOS_PORTS_FORGE_HTTP:-8400}"
# Resolve an explicit registered session before local application lookup.
if [ -n "$(printenv MIOS_EXECUTION_SESSION 2>/dev/null || true)" ]; then
    if python3 "$(cd "$(dirname "$0")" && pwd)/mios-computer-use" session-launch "$NAME" "$@"; then
        exit 0
    else
        _session_rc=$?
        [ "$_session_rc" = 64 ] || exit "$_session_rc"
    fi
fi

case "$NAME" in
    cockpit)                   exec mios-open-url "http://localhost:${_PORT_COCKPIT}" "$@" ;;
    owui|open-webui|webui|ai)  exec mios-open-url "http://localhost:${_PORT_OWUI}" "$@" ;;
    hermes)                    exec mios-open-url "http://localhost:${_PORT_HERMES}/v1" "$@" ;;
    prefilter)                 exec mios-open-url "http://localhost:${_PORT_PREFILTER}/v1" "$@" ;;
    searxng|search)            exec mios-open-url "http://localhost:${_PORT_SEARXNG}" "$@" ;;
    forgejo|forge)             exec mios-open-url "http://localhost:${_PORT_FORGE}" "$@" ;;
esac

case "$NAME" in
    http://*|https://*|file://*|chrome://*|about:*)
        exec mios-open-url "$NAME" "$@"
        ;;
    *://*)
        exec mios-windows launch "$NAME"
        ;;
esac


# Desktop labels and IDs come from the installed registry. The operator broker
# owns the GUI session; agent service/private terminal environments do not.
_desktop_resolution=""
if command -v mios-gen >/dev/null 2>&1; then
    _desktop_resolution="$(mios-gen app-preflight --resolve "$NAME" 2>/dev/null || true)"
fi
_launch_resolved_desktop() {
    python3 - "$_desktop_resolution" "$(cd "$(dirname "$0")" && pwd)/mios-desktop-launch" "$@" <<'MIOS_DESKTOP_DISPATCH'
import json,os,pwd,shlex,shutil,socket,subprocess,sys
try:record=json.loads(sys.argv[1])
except (ValueError,TypeError):raise SystemExit(64)
if record.get("ok") is not True:
    if record.get("status") in ("ambiguous","invalid"):
        sys.stderr.write("Mios-launch: "+record.get("error","Cannot resolve application")+"\n");raise SystemExit(2)
    raise SystemExit(64)
launcher=sys.argv[2]
native=shutil.which("mios-gen")
if not native:raise SystemExit("Native application preflight is unavailable")
native=os.path.realpath(native)
operator_code="import json,os,pwd,shlex,subprocess,sys\nuser,desktop_id,desktop_file,native,launcher,budget,requested,*args=sys.argv[1:]\naccount=pwd.getpwnam(user)\nif os.getuid()!=account.pw_uid:\n    raise SystemExit(\"Operator broker identity mismatch\")\nenv=dict(os.environ)\nenv.update(HOME=account.pw_dir,XDG_CONFIG_HOME=account.pw_dir+\"/.config\",XDG_DATA_HOME=account.pw_dir+\"/.local/share\",XDG_RUNTIME_DIR=\"/run/user/\"+str(account.pw_uid))\nenv[\"DBUS_SESSION_BUS_ADDRESS\"]=\"unix:path=\"+env[\"XDG_RUNTIME_DIR\"]+\"/bus\"\ntimeout=int(budget)/1000\nallowed={\"DISPLAY\",\"WAYLAND_DISPLAY\",\"XAUTHORITY\",\"PULSE_SERVER\",\"HYPRLAND_INSTANCE_SIGNATURE\",\"XDG_CURRENT_DESKTOP\",\"XDG_SESSION_TYPE\",\"XDG_DATA_DIRS\"}\nfor key in allowed:env.pop(key,None)\nmanager=subprocess.run([\"systemctl\",\"--user\",\"show-environment\"],env=env,capture_output=True,text=True,timeout=timeout)\nif manager.returncode!=0:\n    raise SystemExit(\"Operator session manager is unavailable\")\nfor line in manager.stdout.splitlines():\n    parts=shlex.split(line)\n    if len(parts)==1 and \"=\" in parts[0]:\n        key,value=parts[0].split(\"=\",1)\n        if key in allowed:env[key]=value\nif not env.get(\"WAYLAND_DISPLAY\") and not env.get(\"DISPLAY\"):\n    raise SystemExit(\"Operator graphical session is unavailable\")\nimport pathlib,runpy,stat\nsession_module=runpy.run_path(str(pathlib.Path(launcher).with_name(\"mios-computer-use\")))\ninventory=session_module[\"_invocation_inventory\"]()\nsignature=env.get(\"HYPRLAND_INSTANCE_SIGNATURE\",\"\")\ncurrent_id=str(pathlib.Path(env[\"XDG_RUNTIME_DIR\"])/\"hypr\"/signature/\".socket.sock\") if signature else \"\"\nwanted=requested or current_id\nmatches=[row for row in inventory[\"sessions\"] if session_module[\"_session_matches\"](row,wanted)]\nselected=None\nif wanted:\n    if len(matches)!=1:raise SystemExit(\"Requested desktop session is no longer ready\")\n    selected=matches[0]\n    previous=env.get(\"XDG_RUNTIME_DIR\"),env.get(\"HYPRLAND_INSTANCE_SIGNATURE\")\n    env=session_module[\"_local_session_environment\"](selected,env)\n    if previous!=(env[\"XDG_RUNTIME_DIR\"],env[\"HYPRLAND_INSTANCE_SIGNATURE\"]):\n        query=subprocess.run([\"hyprctl\",\"-j\",\"instances\"],env=env,capture_output=True,text=True,timeout=timeout)\n        if query.returncode:raise SystemExit(\"Selected compositor display query failed\")\n        instances=json.loads(query.stdout)\n        instances=[item for item in instances if item.get(\"instance\")==env[\"HYPRLAND_INSTANCE_SIGNATURE\"]]\n        if len(instances)!=1:raise SystemExit(\"Selected compositor display is ambiguous\")\n        display=instances[0].get(\"wl_socket\",\"\")\n        if not display or \"/\" in display or display in (\".\",\"..\"):raise SystemExit(\"Invalid selected display\")\n        socket=pathlib.Path(env[\"XDG_RUNTIME_DIR\"])/display\n        metadata=socket.lstat()\n        if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid!=account.pw_uid or socket.resolve()!=socket:raise SystemExit(\"Selected display ownership changed\")\n        env[\"WAYLAND_DISPLAY\"]=display\n        env.pop(\"DISPLAY\",None)\ncheck=subprocess.run([native,\"app-preflight\",\"--desktop\",desktop_id],env=env,capture_output=True,text=True,timeout=timeout)\nif check.returncode:\n    sys.stderr.write(check.stderr or check.stdout);raise SystemExit(check.returncode)\ntarget=None\nsignature=env.get(\"HYPRLAND_INSTANCE_SIGNATURE\",\"\")\nif signature and all(c.isalnum() or c in \"._-\" for c in signature) and signature not in (\".\",\"..\"):\n    import pathlib,stat\n    runtime=pathlib.Path(env[\"XDG_RUNTIME_DIR\"])\n    control=runtime/\"hypr\"/signature/\".socket.sock\"\n    try:\n        metadata=control.lstat()\n        if stat.S_ISSOCK(metadata.st_mode) and metadata.st_uid==account.pw_uid and os.path.commonpath((str(runtime.resolve()),str(control.resolve())))==str(runtime.resolve()):\n            target={\"id\":str(control.resolve()),\"platform\":\"linux\",\"session_id\":signature,\"backend\":\"hyprland\"}\n    except OSError:pass\nif selected is not None:target=selected[\"execution_target\"]\nenv[\"MIOS_DESKTOP_DISPATCH_TARGET\"]=json.dumps(target)\nresult=subprocess.run([launcher,desktop_file,*args],env=env,stdin=subprocess.DEVNULL,capture_output=True,text=True,timeout=timeout)\nif result.returncode:\n    sys.stderr.write(result.stderr or result.stdout);raise SystemExit(result.returncode)\nreceipt=json.loads(result.stdout)\nmethod=receipt.get(\"method\")\nif (receipt.get(\"dispatched\") is not True or receipt.get(\"confirmed\") is not False\n    or receipt.get(\"desktop_id\")!=desktop_id or receipt.get(\"desktop_file\")!=desktop_file\n    or receipt.get(\"execution_target\")!=target\n    or method not in (\"exec\",\"activation\")\n    or (method==\"exec\" and (type(receipt.get(\"pid\")) is not int or receipt[\"pid\"]<=0))):\n    raise SystemExit(\"Desktop exec receipt does not match the requested application and session\")\nreceipt[\"operator_user\"]=user\nprint(json.dumps(receipt))\n"
argv=["python3","-c",operator_code,record["operator_user"],record["desktop_id"],record["desktop_file"],native,launcher,str(record["overall_timeout_ms"]),os.environ.get("MIOS_EXECUTION_SESSION",""),*sys.argv[3:]]
sock_path=os.environ.get("MIOS_LAUNCHER_SOCK","/run/mios-launcher/launcher.sock")
sent=False
try:
    with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as connection:
        connection.settimeout(record["overall_timeout_ms"]/1000)
        connection.connect(sock_path)
        sent=True
        bootstrap="import json,os,sys; a=json.loads(sys.argv[1]); os.execvp(a[0],a)"
        request=shlex.join(["python3","-c",bootstrap,json.dumps(argv)])
        connection.sendall(("CAPTURE_JSON: "+request+"\n").encode())
        chunks=bytearray()
        while not chunks.endswith(b"\n") and len(chunks)<1048576:
            part=connection.recv(4096)
            if not part:break
            chunks.extend(part)
    response=json.loads(chunks)
    if response.get("exit_code")!=0:
        sys.stderr.write(response.get("stderr") or "Operator desktop dispatch failed\n");raise SystemExit(1)
    result=json.loads(response["stdout"])
    if (result.get("dispatched") is not True or result.get("confirmed") is not False
        or result.get("desktop_id")!=record["desktop_id"] or result.get("desktop_file")!=record["desktop_file"]
        or result.get("operator_user")!=record["operator_user"]
        or result.get("method") not in ("exec","activation")
        or (result.get("method")=="exec" and (type(result.get("pid")) is not int or result["pid"]<=0))):
        raise ValueError("No matching operator dispatch receipt")
    print(json.dumps(result))
except (OSError,ValueError,KeyError) as error:
    if sent:
        raise SystemExit("Mios-launch: operator dispatch outcome unavailable; refusing duplicate launch")
    account=pwd.getpwnam(record["operator_user"])
    if os.getuid()!=account.pw_uid:
        raise SystemExit("Mios-launch: operator broker unavailable; refusing privileged GUI fallback")
    result=subprocess.run(argv,capture_output=True,text=True,timeout=record["overall_timeout_ms"]/1000)
    sys.stdout.write(result.stdout);sys.stderr.write(result.stderr)
    raise SystemExit(result.returncode)

MIOS_DESKTOP_DISPATCH
}
_try_resolved_desktop() {
    [ -n "$_desktop_resolution" ] || return 64
    _launch_resolved_desktop "$@"
}
if [ ! -e /mnt/c/Windows/System32/cmd.exe ] && [ -n "$_desktop_resolution" ]; then
    if _try_resolved_desktop "$@"; then
        exit 0
    else
        _desktop_rc=$?
        [ "$_desktop_rc" = 64 ] || exit "$_desktop_rc"
    fi
fi

if [ -z "${MIOS_LAUNCH_NO_PREFLIGHT:-}" ] && command -v flatpak >/dev/null 2>&1; then
    _pf_op="$(awk -F\" '/^[[:space:]]*username[[:space:]]*=/{print $2; exit}' /usr/share/mios/mios.toml 2>/dev/null)"
    [ -z "$_pf_op" ] && _pf_op="mios"
    _pf_uid="$(id -u "$_pf_op" 2>/dev/null)"
    _pf_flatpak() {  # run flatpak in the OPERATOR's per-user session
        if [ "$(id -un 2>/dev/null)" = "$_pf_op" ] || [ -z "$_pf_uid" ]; then
            flatpak "$@"
        elif [ "$(id -u)" = "0" ] && command -v runuser >/dev/null 2>&1; then
            runuser -u "$_pf_op" -- env XDG_RUNTIME_DIR="/run/user/$_pf_uid" \
                DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$_pf_uid/bus" flatpak "$@"
        else
            flatpak "$@"
        fi
    }
    _pf_id="$(_pf_flatpak ps --columns=application 2>/dev/null | awk -v n="$(printf %s "$NAME" | tr '[:upper:]' '[:lower:]')" '
        { id=$1; seg=id; sub(/.*\./,"",seg); slc=tolower(seg); ilc=tolower(id);
          if (index(n,slc)>0 || index(slc,n)>0 || index(ilc,n)>0) { print id; exit } }')"
    if [ -n "$_pf_id" ]; then
        if command -v mios-as-operator >/dev/null 2>&1; then
            mios-as-operator flatpak run "$_pf_id" >/dev/null 2>&1 || true
        fi
        command -v mios-window >/dev/null 2>&1 && mios-window center "$NAME" >/dev/null 2>&1 || true
        echo "{\"success\": true, \"target\": \"$NAME\", \"already_running\": true, \"app\": \"$_pf_id\", \"action\": \"raised existing window to foreground\"}"
        echo "Mios-launch: '$NAME' already running" >&2
        exit 0
    fi
fi

if [ -z "${MIOS_LAUNCH_NO_PREFLIGHT:-}" ] && [ -e /mnt/c/Windows/System32/cmd.exe ] \
   && command -v curl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    _wxe=""
    for _t in /etc/mios/mios.toml /usr/share/mios/mios.toml; do
        [ -r "$_t" ] || continue
        _wxe="$(awk -F\" '/^[[:space:]]*executor_endpoint[[:space:]]*=/{print $2; exit}' "$_t" 2>/dev/null || true)"
        [ -n "$_wxe" ] && break
    done
    _wxe="${_wxe%/}"
    if [ -n "$_wxe" ]; then
        _pf_wins="$(curl -s --connect-timeout 1 --max-time 3 "$_wxe/windows" 2>/dev/null)"
        _pf_title="$(MIOS_PF_WINS="$_pf_wins" python3 - "$_ORIG_NAME" "$NAME" <<'PYEOF' 2>/dev/null
import sys, json, re, os
def norm(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower())
qs = [q for q in (norm(a) for a in sys.argv[1:3]) if len(q) >= 3]
if not qs:
    sys.exit(0)
try:
    wins = json.loads(os.environ.get("MIOS_PF_WINS", "")).get("windows", [])
except Exception:
    sys.exit(0)
best = None
for w in wins:
    t = w.get("title") or ""
    tn = norm(t)
    if "openwebui" in tn or "miosai" in tn:
        continue
    if any(q in tn for q in qs):
        if best is None or len(t) < len(best):
            best = t
if best:
    print(best)
PYEOF
)"
        if [ -n "$_pf_title" ]; then
            command -v mios-window >/dev/null 2>&1 && mios-window focus "$_pf_title" >/dev/null 2>&1 || true
            _pf_safe="$(printf '%s' "$_pf_title" | tr -d '\\"')"
            _on_safe="$(printf '%s' "$_ORIG_NAME" | tr -d '\\"')"
            printf '{"success": true, "target": "%s", "already_running": true, "window": "%s", "action": "focused existing window"}\n' "$_on_safe" "$_pf_safe"
            echo "Mios-launch: '$_ORIG_NAME' already open" >&2
            exit 0
        fi
    fi
fi

case "$NAME" in
    /mnt/c/*.exe|/mnt/c/*.EXE)
        exec mios-windows launch "$NAME" "$@"
        ;;
esac
_nlc="$(printf '%s' "$NAME" | tr '[:upper:]' '[:lower:]')"
case "$_nlc" in
    "windows "*|"win "*|*.exe)
        _wname="$(printf '%s' "$NAME" | sed -E 's/\.[Ee][Xx][Ee]$//; s/^[Ww]indows[ -]+//; s/^[Ww]in[ -]+//')"
        exec mios-windows launch "$_wname" "$@"
        ;;
esac

_LAUNCHER_SOCK=/run/mios-launcher/launcher.sock
_broker_dispatch() {
    if command -v python3 >/dev/null 2>&1 && [ -S "$_LAUNCHER_SOCK" ]; then
        printf '%s\n' "$1" | python3 -c '
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect("'"$_LAUNCHER_SOCK"'")
s.sendall(sys.stdin.buffer.read())
print(s.recv(64).decode("utf-8", errors="replace").rstrip())
s.close()
'
        return $?
    fi
    return 1
}
_launcher_override() {
    python3 - "$(cd "$(dirname "$0")" && pwd)/../../lib/mios" "$1" <<'PYEOF' 2>/dev/null
import sys, re
sys.path.insert(0, sys.argv[1])
import mios_toml
name = sys.argv[2].strip()
name_lc = name.lower()
norm = re.sub(r"\s+", "-", name_lc)
apps = mios_toml.load_merged().get("desktop", {}).get("apps", [])
if isinstance(apps, list):
    for cfg in apps:
        if not isinstance(cfg, dict):
            continue
        launcher = cfg.get("launcher")
        if not (isinstance(launcher, str) and launcher):
            continue
        app_id = str(cfg.get("id", ""))
        if not app_id:
            continue
        short = app_id.split(".")[-1].lower()
        if name in (app_id, short) or name_lc == short or norm == short:
            print(launcher)
            sys.exit(0)
PYEOF
}
_override_cmd="$(_launcher_override "$NAME")"
if [ -n "$_override_cmd" ]; then
    _broker_dispatch "$_override_cmd $*" && exit 0
    exec $_override_cmd "$@"
fi

if [ -e /mnt/c/Windows/System32/cmd.exe ] && command -v mios-windows >/dev/null 2>&1; then
    for _wt in "$_ORIG_NAME" "$NAME"; do
        [ -z "$_wt" ] && continue
        echo "Mios-launch: Windows precedence -> mios-windows launch '$_wt'" >&2
        if mios-windows launch "$_wt" "$@"; then
            exit 0
        fi
        [ "$NAME" = "$_ORIG_NAME" ] && break
    done
fi

if command -v mios-everything >/dev/null 2>&1; then
    _ES_HITS="$(mios-everything -n 24 "${NAME}.exe" 2>/dev/null || true)"
    if [ -n "$_ES_HITS" ]; then
        _NAME_LC="$(printf %s "$NAME" | tr '[:upper:]' '[:lower:]')"
        _EXACT="$(printf '%s\n' "$_ES_HITS" | awk -v n="$_NAME_LC" '
            { b = $0; sub(/.*\\/,"",b); sub(/.*\//,"",b); blc = tolower(b);
              sub(/\.exe$/,"",blc); if (blc == n) print $0 }
        ')"
        _EXACT_COUNT="$(printf '%s' "$_EXACT" | grep -c . || true)"
        if [ "$_EXACT_COUNT" = "1" ]; then
            _EXACT_PATH="$(printf '%s' "$_EXACT" | head -1)"
            exec mios-windows launch "$_EXACT_PATH" "$@"
        fi
    fi
fi

_GAMES_CACHE=/var/lib/mios/agent-env/windows-games.cache
if [ -r "$_GAMES_CACHE" ]; then
    _matches="$(awk -F'|' -v q="$(printf %s "$NAME" | tr '[:upper:]' '[:lower:]')" '
        { lname = tolower($1); if (index(lname, q) > 0) print $1 "|" $2 }
    ' "$_GAMES_CACHE")"
    _hit_count="$(printf %s "$_matches" | grep -c '|' || true)"
    if [ "$_hit_count" = "1" ]; then
        _hit_name="${_matches%%|*}"
        _hit_cmd="${_matches#*|}"
        printf 'mios-launch: %s -> %s\n' "$_hit_name" "$_hit_cmd" >&2
        case "$_hit_cmd" in
            mios-windows*)
                export MIOS_LAUNCH_TITLE_HINT="$_hit_name"
                read -r -a _cmd_args <<< "$_hit_cmd"
                exec "${_cmd_args[@]}" "$@"
                ;;
            *)
                export MIOS_LAUNCH_TITLE_HINT="$_hit_name"
                exec mios-windows launch "$_hit_cmd"
                ;;
        esac
    elif [ "$_hit_count" -gt 1 ] 2>/dev/null; then
        printf 'mios-launch: ambiguous "%s" -- %d matches in games cache:\n' "$NAME" "$_hit_count" >&2
        printf '%s\n' "$_matches" | sed 's/|.*$//' | sed 's/^/  /' >&2
        echo >&2
        echo "Re-run with the exact display name" >&2
        exit 2
    fi
fi

case "$NAME" in
    mios-*)
        if command -v "$NAME" >/dev/null 2>&1; then
            exec "$NAME" "$@"
        fi
        ;;
esac

if grep -qiE 'microsoft|wsl' /proc/sys/kernel/osrelease 2>/dev/null \
   && command -v curl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    _xep=""
    for _t in /etc/mios/mios.toml /usr/share/mios/mios.toml; do
        [ -r "$_t" ] || continue
        _xep="$(awk -F\" '/^[[:space:]]*executor_endpoint[[:space:]]*=/{print $2; exit}' "$_t" 2>/dev/null || true)"
        [ -n "$_xep" ] && break
    done
    if [ -z "$_xep" ]; then
        _xgw="$(ip route show default 2>/dev/null | awk '/default/{print $3; exit}' || true)"
        [ -n "$_xgw" ] && _xep="http://${_xgw}:${MIOS_PORTS_OSCONTROL:-8950}"
    fi
    _xep="${_xep%/}"
    if [ -n "$_xep" ] && curl -fsS --connect-timeout 1 --max-time 2 "$_xep/health" >/dev/null 2>&1; then
        _xbody="$(python3 -c 'import json,sys,os; print(json.dumps({"app": sys.argv[1], "position": os.environ.get("MIOS_LAUNCH_POSITION", "default"), "verify": os.environ.get("MIOS_LAUNCH_TITLE_HINT","")}))' "$_ORIG_NAME" 2>/dev/null || true)"
        if [ -n "$_xbody" ]; then
            _xresp="$(curl -s --connect-timeout 5 --max-time 30 -X POST "$_xep/launch" -H 'Content-Type: application/json' -d "$_xbody" 2>/dev/null || true)"
            case "$_xresp" in
                *'"launched": true'*|*'"launched":true'*|*'"fired": true'*|*'"fired":true'*)
                    echo "Mios-launch: launched '$_ORIG_NAME' via in-session executor" >&2
                    exit 0 ;;
            esac
        fi
    fi
fi


if [ -n "$_desktop_resolution" ]; then
    if _try_resolved_desktop "$@"; then
        exit 0
    else
        _desktop_rc=$?
        [ "$_desktop_rc" = 64 ] || exit "$_desktop_rc"
    fi
fi

if [ -f "/usr/share/applications/${NAME}.desktop" ] \
   || [ -x /usr/local/bin/"$NAME" ] || [ -x /usr/bin/"$NAME" ] \
   || flatpak list --system --columns=application 2>/dev/null \
        | awk -v n="$(echo "$NAME" | tr '[:upper:]' '[:lower:]')" \
            '{ s=$1; sub(/.*\./,"",s); if (tolower(s)==n) found=1 } END {exit !found}'; then
    if [ -f "/usr/share/applications/${NAME}.desktop" ] \
       || flatpak list --system --columns=application 2>/dev/null \
            | awk -v n="$(echo "$NAME" | tr '[:upper:]' '[:lower:]')" \
                '{ s=$1; sub(/.*\./,"",s); if (tolower(s)==n) found=1 } END {exit !found}' \
       || [ -x /usr/local/bin/"$NAME" ] || [ -x /usr/bin/"$NAME" ]; then
