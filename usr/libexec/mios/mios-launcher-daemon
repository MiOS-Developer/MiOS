#!/usr/bin/env python3
# AI-hint: Broker service that provides a Unix socket for the mios-hermes agent to execute shell commands within the operator's user context, enabling GUI apps and Windows .exe interop via the operator's environment.
# AI-functions: _refresh_gui_environment, _operator_environment, handle, main
# AI-related: /etc/mios/launcher-token, mios-hermes, mios-launcher, mios-find, mios-wslg, mios-launcher.service, 992.service, hermes-agent.service, socket.socket
"""mios-launcher-daemon -- operator-side launcher broker.

Runs as the operator's user-level systemd service
(mios-launcher.service under user@992.service), so it inherits the
operator's full WSLg env: WAYLAND_DISPLAY, WSL2_GUI_APPS_ENABLED=1,
WSL_INTEROP=/run/WSL/<pid>_interop, DBUS_SESSION_BUS_ADDRESS, etc.
That env is what flatpak GUI apps + Windows .exe interop both need
to actually surface windows on the operator's desktop.

The agent (mios-hermes uid 820) cannot call wsl.exe or any other
Windows .exe directly because /mnt/c/Windows/System32/*.exe is mode
0544 owned by mios:mios with WSL metadata xattrs that even root
can't strip (Windows ACL blocks the xattr write for system files).
Workaround: agent connects to this broker's unix socket, writes a
single line of shell, broker dispatches it from operator context.

PROTOCOL
--------
Client connects to UNIX socket at /run/user/<uid>/mios-launcher.sock
(socket mode 0666 so any local user can connect).

Send: <one line of shell>\n
Recv: OK\n   (broker has dispatched the command; not "command finished")
       ERROR: <reason>\n  (request rejected before dispatch)

Connection closed after one line. Broker spawns the dispatched
command via subprocess.Popen with start_new_session=True so it
detaches from the broker -- broker can serve other requests
immediately, dispatched command runs forever (or until it exits).

Authentication is filesystem permissions on the socket: mode 0660,
group mios-ai. That is exactly the two parties involved -- this broker
runs as the operator, the agent plane runs as User=mios-ai, and `mios`
is a member of the mios-ai group (sysusers.d/10-mios.conf).

The socket was previously 0666, justified on the grounds that the agent
stack already holds NOPASSWD: ALL sudo so the broker granted nothing
new. That reasoning does not hold for the party it actually exposed.
0666 admitted EVERY local uid, not just the agent stack -- and the agent
executes model-generated code in a sandbox, so a world-writable broker
socket was an unauthenticated path out of that sandbox to arbitrary
execution as the operator. Confinement that a socket bypasses is not
confinement.

If the group cannot be applied the broker refuses to listen rather than
falling back to a wider mode; a broker that does not start is safer than
one every local user can reach.

Still open, deliberately not done here: /run/mios-launcher is 1777
(tmpfiles.d/mios-launcher.conf), and per-caller token auth under
/etc/mios/launcher-token would authenticate the CALLER rather than its
group. Both are follow-ups, not substitutes for narrowing the mode.
"""
from __future__ import annotations

import grp
import logging
import os
import socket
import subprocess
import sys
import threading

logging.basicConfig(level=logging.INFO, format="[mios-launcher] %(message)s")
log = logging.getLogger("mios-launcher")

UID = os.getuid()
SOCK_PATH = os.environ.get("MIOS_LAUNCHER_SOCK", "/run/mios-launcher/launcher.sock")
# Group permitted to dispatch through the broker. The agent plane runs as
# User=mios-ai; `mios` is a member of that group, so 0660 covers both.
SOCK_GROUP = os.environ.get("MIOS_LAUNCHER_GROUP", "mios-ai")

CAPTURE_TIMEOUT_S = int(os.environ.get("MIOS_LAUNCHER_CAPTURE_TIMEOUT_S", "120") or 120)


_GUI_SESSION_KEYS = frozenset((
    "DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "PULSE_SERVER",
    "HYPRLAND_INSTANCE_SIGNATURE", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE",
    "XDG_DATA_DIRS",
))


def _refresh_gui_environment(base, manager_text, runtime, uid, probe_timeout):
    """Import only GUI values; stale compositor identities never survive a refresh."""
    import shlex
    import stat
    from pathlib import Path

    env = {key: value for key, value in base.items() if key not in _GUI_SESSION_KEYS}
    runtime = Path(runtime)
    metadata = runtime.lstat()
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != uid or metadata.st_mode & 0o022:
        raise RuntimeError("Operator runtime directory is not private and owned")
    for line in manager_text.splitlines():
        try:
            fields = shlex.split(line)
        except ValueError:
            continue
        if len(fields) == 1 and "=" in fields[0]:
            key, value = fields[0].split("=", 1)
            if key in _GUI_SESSION_KEYS and not any(ord(ch) < 32 for ch in value):
                env[key] = value
    signature = env.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if signature or "hyprland" in env.get("XDG_CURRENT_DESKTOP", "").lower():
        if not signature or any(ch not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" for ch in signature) or signature in (".", ".."):
            raise RuntimeError("Active compositor signature is unavailable or invalid")
        paths = [runtime / "hypr" / signature / ".socket.sock"]
        wayland = env.get("WAYLAND_DISPLAY", "")
        if not wayland:
            raise RuntimeError("Active compositor display is unavailable")
        display = Path(wayland)
        paths.append(display if display.is_absolute() else runtime / display)
        for path in paths:
            metadata = path.lstat()
            if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != uid:
                raise RuntimeError("Active compositor socket is not owned by the operator")
            if os.path.commonpath((str(runtime.resolve()), str(path.resolve()))) != str(runtime.resolve()):
                raise RuntimeError("Active compositor socket escaped the operator runtime")
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
            probe.settimeout(probe_timeout)
            probe.connect(str(paths[0]))
    return env



def _execution_context(env):
    """The broker's local context is distinct from a forwarded app's destination."""
    from pathlib import Path
    signature = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not signature:
        return None
    control = Path(env["XDG_RUNTIME_DIR"]) / "hypr" / signature / ".socket.sock"
    return {"id": str(control.resolve()), "platform": "linux",
            "session_id": signature, "backend": "hyprland"}

def _operator_environment(*, allow_headless=False):
    import pwd
    from pathlib import Path

    sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "lib/mios"))
    import mios_toml

    policy = mios_toml.load_merged().get("desktop", {}).get("launch", {})
    probe_ms = policy.get("probe_timeout_ms")
    if isinstance(probe_ms, bool) or not isinstance(probe_ms, int) or not 100 <= probe_ms <= 30000:
        raise RuntimeError("Operator session probe timeout is not configured")
    uid = os.getuid()
    account = pwd.getpwuid(uid)
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{uid}"
    env = dict(os.environ)
    env.update(HOME=account.pw_dir, XDG_CONFIG_HOME=account.pw_dir + "/.config",
               XDG_DATA_HOME=account.pw_dir + "/.local/share", XDG_RUNTIME_DIR=runtime,
               DBUS_SESSION_BUS_ADDRESS=f"unix:path={runtime}/bus")
    result = subprocess.run(["systemctl", "--user", "show-environment"],
                            env=env, stdin=subprocess.DEVNULL, capture_output=True,
                            text=True, timeout=probe_ms / 1000)
    if result.returncode:
        raise RuntimeError("Operator session manager is unavailable")
    try:
        return _refresh_gui_environment(env, result.stdout, runtime, uid, probe_ms / 1000)
    except (OSError, RuntimeError):
        if not allow_headless:
            raise
        # Captured filesystem/console verbs need no compositor. Revalidate the
        # private runtime and remove every stale GUI value before dispatch.
        return _refresh_gui_environment(env, "", runtime, uid, probe_ms / 1000)


def handle(conn: socket.socket) -> None:
    try:
        conn.settimeout(60.0)
        data = b""
        while not data.endswith(b"\n") and len(data) < 65536:
            chunk = conn.recv(4096)
            if not chunk:
                break
            data += chunk
        line = data.decode("utf-8", errors="replace").rstrip("\n").rstrip("\r")
        if not line:
            conn.sendall(b"ERROR: empty request\n")
            return

        try:
            env = _operator_environment(allow_headless=line.startswith(("CAPTURE_JSON: ", "CAPTURE: ")))
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            message = f"Operator session unavailable: {error}"
            if line.startswith("CAPTURE_JSON: "):
                import json
                conn.sendall((json.dumps({"stdout": "", "stderr": message, "exit_code": 1}) + "\n").encode())
            else:
                conn.sendall(("ERROR: " + message + "\n").encode())
            return

        if line.startswith("CAPTURE_JSON: "):
            cmd = line[len("CAPTURE_JSON: "):]
            log.info("capture_json: %s", cmd[:200])
            env.setdefault("GDK_BACKEND", "wayland")
            payload = {"stdout": "", "stderr": "", "exit_code": -1, "operator_context": _execution_context(env)}
            try:
                result = subprocess.run(
                    ["bash", "-lc", cmd],
                    stdin=subprocess.DEVNULL,
                    capture_output=True,
                    timeout=CAPTURE_TIMEOUT_S,
                    env=env,
                )
                payload["stdout"] = result.stdout.decode("utf-8", errors="replace")
                payload["stderr"] = result.stderr.decode("utf-8", errors="replace")
                payload["exit_code"] = int(result.returncode)
            except subprocess.TimeoutExpired:
                payload["stderr"] = f"ERROR: capture timeout (>{CAPTURE_TIMEOUT_S}s)"
            except OSError as e:
                payload["stderr"] = f"ERROR: {e}"
            import json as _json
            conn.sendall((_json.dumps(payload) + "\n").encode("utf-8"))
            return

        if line.startswith("CAPTURE: "):
            cmd = line[len("CAPTURE: "):]
            log.info("capture: %s", cmd[:200])
            env.setdefault("GDK_BACKEND", "wayland")
            try:
                result = subprocess.run(
                    ["bash", "-lc", cmd],
                    stdin=subprocess.DEVNULL,
                    capture_output=True,
                    timeout=CAPTURE_TIMEOUT_S,
                    env=env,
                )
                conn.sendall(result.stdout)
                if result.stderr:
                    conn.sendall(result.stderr)
            except subprocess.TimeoutExpired:
                conn.sendall(f"ERROR: capture timeout (>{CAPTURE_TIMEOUT_S}s)\n".encode())
            except OSError as e:
                conn.sendall(f"ERROR: {e}\n".encode())
            return

        log.info("dispatch: %s", line[:200])
        env.setdefault("GDK_BACKEND", "wayland")
        log_fp = None
        log_path = "(none)"
        try:
            log_dir = os.environ.get("MIOS_LAUNCHER_LOG_DIR", "/run/mios-launcher/log")
            os.makedirs(log_dir, mode=0o755, exist_ok=True)
            ts_id = subprocess.check_output(["date", "+%Y%m%d-%H%M%S-%N"]).decode().strip()
            log_path = os.path.join(log_dir, f"dispatch-{ts_id}.log")
            log_fp = open(log_path, "w")
            try:
                os.chmod(log_path, 0o644)
            except OSError:
                pass
        except OSError as e:
            log.warning("per-dispatch log unavailable (%s) -- launching without a log file", e)
            log_fp = None
            log_path = "(none)"
        try:
            proc = subprocess.Popen(
                ["bash", "-lc", line],
                stdin=subprocess.DEVNULL,
                stdout=(log_fp or subprocess.DEVNULL),
                stderr=subprocess.STDOUT,
                start_new_session=True,
                env=env,
            )
            log.info("dispatched pid=%d log=%s", proc.pid, log_path)
            conn.sendall(b"OK\n")
        except OSError as e:
            log.warning("dispatch failed: %s", e)
            conn.sendall(f"ERROR: {e}\n".encode())
    except Exception as e:
        log.warning("connection error: %s", e)
    finally:
        try:
            conn.close()
        except OSError:
            pass


def main() -> int:
    try:
        os.unlink(SOCK_PATH)
    except FileNotFoundError:
        pass
    except OSError as e:
        log.error("can't remove stale socket %s: %s", SOCK_PATH, e)

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK_PATH)

    # The socket was 0666: ANY local user could dispatch arbitrary commands as the
    # operator. The only legitimate caller is the agent plane, which runs as
    # User=mios-ai, while this broker runs as the operator -- so the access this
    # needs is exactly "these two", not "everyone". `mios` is a member of the
    # mios-ai group (sysusers.d/10-mios.conf: `m mios mios-ai`), so group
    # ownership plus 0660 grants both and no one else.
    #
    # This matters beyond tidiness: the agent executes model-generated code in a
    # sandbox, and a world-writable broker socket is an unauthenticated path out
    # of that sandbox to arbitrary execution as the operator.
    try:
        os.chown(SOCK_PATH, -1, grp.getgrnam(SOCK_GROUP).gr_gid)
        os.chmod(SOCK_PATH, 0o660)
    except (KeyError, PermissionError, OSError) as e:
        # Fail CLOSED. A broker reachable by every local user is worse than one
        # that does not start, and a silent fallback to 0666 would reintroduce
        # exactly the hole this closes.
        log.error(
            "refusing to listen: cannot restrict %s to group %s (%s). "
            "Create the group or run the broker as a member of it.",
            SOCK_PATH, SOCK_GROUP, e)
        try:
            os.unlink(SOCK_PATH)
        except OSError:
            pass
        return 1

    srv.listen(8)
    log.info("listening on %s (uid=%d, group=%s, mode=0660)", SOCK_PATH, UID, SOCK_GROUP)

    try:
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=handle, args=(conn,), daemon=True).start()
    except KeyboardInterrupt:
        log.info("shutting down")
    finally:
        try:
            os.unlink(SOCK_PATH)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
