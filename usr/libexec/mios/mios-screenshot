#!/bin/bash
# AI-hint: Screenshot entry point behind the screenshot/snap/prtscr aliases: in a Linux Wayland session it hands off to the native /usr/bin/mios-shot (mios-shot modes and flags pass through; the legacy --clipboard/--open/--window/OUT flags are translated); under WSL it captures the primary Windows monitor as a PNG via mios-pc-control (--open, --clipboard).
# AI-related: /usr/libexec/mios/mios-screenshot, /etc/mios/mios.toml, /usr/share/mios/mios.toml, mios-pc-control, mios-find, mios-open-url, mios-window, mios-windows, /usr/bin/mios-shot, usr/share/mios/mios.toml [desktop.screenshot]
set -euo pipefail

set -u

# Linux Wayland session: the native tool (tools/native/mios-shot). WSL keeps the Windows capture below.
if [[ -n "${WAYLAND_DISPLAY:-}" && -z "${WSL_DISTRO_NAME:-}" && ! -e /mnt/wslg ]] && command -v mios-shot >/dev/null 2>&1; then
    # Detect if any legacy flags or bare output paths exist
    legacy=0
    has_mode=0
    case "${1:-}" in region|area|window|active|output|screen|all|probe) has_mode=1 ;; esac

    skip=0
    for a in "$@"; do
        if [[ "$skip" == 1 ]]; then skip=0; continue; fi
        case "$a" in
            -m|-d|-f|-g|-q) legacy=1; skip=1 ;;
            -m=*|-d=*|-f=*|-g=*|-q=*) legacy=1 ;;
            --open|--clipboard|--window|--window=*|--) legacy=1 ;;
            --output|--geometry|--delay|--file|-o|--format|--quality|--selector|--backend|--window-source) skip=1 ;;
            --output=*|--geometry=*|--delay=*|--file=*|-o=*|--format=*|--quality=*|--selector=*|--backend=*|--window-source=*) ;;
            region|area|window|active|output|screen|all|probe) has_mode=1 ;;
            -*) ;;
            *) legacy=1 ;;   # a bare output path
        esac
    done

    if [[ "$legacy" == 0 ]]; then
        if [[ "$has_mode" == 0 ]]; then
            exec mios-shot output "$@"
        else
            exec mios-shot "${@:-output}"
        fi
    fi

    # Legacy translation
    args=(output --no-copy) ; open=0 ; out=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --clipboard) args+=(--copy); shift ;;
            --open)      open=1; shift ;;
            --window|--window=*)
                m="${1#--window}"; m="${m#=}"; [[ -z "$m" ]] && { m="${2:-}"; shift; }; shift
                id="$(hyprctl -j clients 2>/dev/null | python3 -I -c 'import json,sys; m=sys.argv[1].lower(); print(next((c.get("stableId","") for c in json.load(sys.stdin) if m in (c.get("class","")+" "+c.get("title","")).lower()), ""))' "$m")"
                [[ -n "$id" ]] || { echo "mios-screenshot: no window matches '$m'" >&2; exit 1; }
                args[0]=window; args+=(--window "$id") ;;
            --output|-m) args+=(--output "$2"); shift 2 ;;
            --geometry|-g) args+=(--geometry "$2"); shift 2 ;;
            --delay|-d) args+=(--delay "$2"); shift 2 ;;
            --file|-f|-o) out="$2"; shift 2 ;;
            --file=*|-o=*) out="${1#*=}"; shift ;;
            --format) args+=(--format "$2"); shift 2 ;;
            --quality|-q) args+=(--quality "$2"); shift 2 ;;
            --cursor) args+=(--cursor); shift ;;
            --no-cursor) args+=(--no-cursor); shift ;;
            --) shift; out="${1:-}"; shift ;;
            -*) args+=("$1"); shift ;;
            *)  out="$1"; shift ;;
        esac
    done
    [[ -n "$out" ]] && args+=(--file "$out")
    path="$(mios-shot "${args[@]}")" || exit $?
    [[ -n "$out" ]] && path="$out"
    [[ "$open" == 1 && -n "$path" ]] && { xdg-open "$path" >/dev/null 2>&1 & }
    echo "$path"
    exit 0
fi

OPEN=0
CLIPBOARD=0
WINDOW=""
OUT=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --open)       OPEN=1; shift ;;
        --clipboard)  CLIPBOARD=1; shift ;;
        --window)     WINDOW="${2:-}"; shift 2 ;;
        --window=*)   WINDOW="${1#--window=}"; shift ;;
        -h|--help)
            sed -n '2,40p' "$0" | grep -E '^#' | sed 's/^# \?//'
            exit 0
            ;;
        --) shift; OUT="${1:-}"; shift ;;
        -*)
            echo "Mios-screenshot: unknown flag: $1" >&2
            exit 64
            ;;
        *)
            [[ -z "$OUT" ]] && OUT="$1" || true
            shift
            ;;
    esac
done

if [[ -n "$WINDOW" ]]; then
    if ! command -v mios-window >/dev/null 2>&1; then
        echo "Mios-screenshot" >&2
        exit 1
    fi
    echo "[mios-screenshot] focusing window matching '$WINDOW' before capture" >&2
    mios-window focus "$WINDOW" 2>&1 | head -3 >&2 || true
    sleep 1
fi

if [[ -z "$OUT" ]]; then
    WUSER=""
    if [ -r /etc/mios/mios.toml ]; then
        WUSER="$(awk -F\" '/^\s*windows_user\s*=\s*"/{print $2; exit}' /etc/mios/mios.toml 2>/dev/null)"
    fi
    [[ -z "$WUSER" ]] && [ -r /usr/share/mios/mios.toml ] && \
        WUSER="$(awk -F\" '/^\s*windows_user\s*=\s*"/{print $2; exit}' /usr/share/mios/mios.toml 2>/dev/null)"
    [[ -z "$WUSER" ]] && WUSER="${USER:-mios}"

    SCREEN_DIR="/mnt/c/Users/$WUSER/Pictures/Screenshots"
    mkdir -p "$SCREEN_DIR" 2>/dev/null || true
    TS="$(date +%Y-%m-%d_%H%M%S)"
    OUT="$SCREEN_DIR/MiOS-$TS.png"
fi

WIN_PATH=""
case "$OUT" in
    /mnt/[a-zA-Z]/*)
        WIN_PATH="$(wslpath -w "$OUT" 2>/dev/null)"
        ;;
    [a-zA-Z]:[/\\]*)
        WIN_PATH="$OUT"
        OUT="$(wslpath -u "$OUT" 2>/dev/null || echo "$OUT")"
        ;;
    *)
        echo "Mios-screenshot: output path '$OUT' isn't reachable from Windows" >&2
        echo "  Use /mnt/c/... or C:\\..., not a pure Linux path" >&2
        exit 64
        ;;
esac

if ! mios-pc-control screenshot "$WIN_PATH" 2>&1; then
    echo "Mios-screenshot: mios-pc-control failed" >&2
    exit 1
fi

if [[ ! -f "$OUT" ]]; then
    sleep 0.5
    if [[ ! -f "$OUT" ]]; then
        echo "Mios-screenshot: capture reported success but $OUT is missing" >&2
        exit 1
    fi
fi

echo "[mios-screenshot] saved $OUT" >&2

if [[ "$CLIPBOARD" == "1" ]]; then
    mios-windows ps "Set-Clipboard -Path '$WIN_PATH'" 2>/dev/null && \
        echo "[mios-screenshot] copied to clipboard" >&2
fi

if [[ "$OPEN" == "1" ]]; then
    mios-open-url "file://$WIN_PATH" 2>/dev/null || \
        mios-windows ps "Start-Process '$WIN_PATH'" 2>/dev/null
fi

echo "$OUT"
