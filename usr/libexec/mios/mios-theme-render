import mios_toml


def resolve_colors() -> Dict[str, str]:
    """Resolve the palette through the shared vendor/host/user SSOT resolver."""
    return dict(mios_toml.colors(mios_toml.load_merged()))


def render_gtk_css(colors: Dict[str, str], edge_import: bool = True, opacity: float = 1.0, radius: Optional[int] = None) -> str:
    """Generate GTK3/4 CSS variable definitions; the GTK 4 file first @imports mios-edge.css (surface gtk4-edge)."""
    bg = colors.get("bg", "#282262")
    fg = colors.get("fg", "#E7DFD3")
    accent = colors.get("accent", "#1A407F")
    err = colors.get("error", "#DC271B")
    succ = colors.get("success", "#3E7765")
    warn = colors.get("warning", "#F35C15")

    opacity = max(0.0, min(1.0, float(opacity)))
    glass = f"rgba({int(bg[1:3],16)}, {int(bg[3:5],16)}, {int(bg[5:7],16)}, {opacity:g})" if opacity < 1 else bg

    edge = '@import url("mios-edge.css");\n' if edge_import else ""
    legacy = f"""/* Generated by mios-theme-render from mios.toml SSOT */
{edge}@define-color accent_color {accent};
@define-color accent_bg_color {accent};
@define-color accent_fg_color {fg};
@define-color window_bg_color {glass};
@define-color window_fg_color {fg};
@define-color view_bg_color {glass};
@define-color view_fg_color {fg};
@define-color card_bg_color {glass};
@define-color card_fg_color {fg};
@define-color headerbar_bg_color {glass};
@define-color headerbar_fg_color {fg};
@define-color headerbar_backdrop_color {glass};
@define-color dialog_bg_color {glass};
@define-color dialog_fg_color {fg};
@define-color popover_bg_color {glass};
@define-color popover_fg_color {fg};
@define-color sidebar_bg_color {glass};
@define-color sidebar_fg_color {fg};
@define-color sidebar_backdrop_color {glass};
@define-color secondary_sidebar_bg_color {glass};
@define-color secondary_sidebar_fg_color {fg};
@define-color secondary_sidebar_backdrop_color {glass};
@define-color destructive_color {err};
@define-color destructive_bg_color {err};
@define-color destructive_fg_color {fg};
@define-color success_color {succ};
@define-color success_bg_color {succ};
@define-color success_fg_color {fg};
@define-color warning_color {warn};
@define-color warning_bg_color {warn};
@define-color warning_fg_color {fg};
@define-color error_color {err};
@define-color error_bg_color {err};
@define-color error_fg_color {fg};
"""
    if radius is not None:
        if isinstance(radius, bool) or not isinstance(radius, int) or radius < 0:
            raise ValueError("Surface radius must be a nonnegative integer")
        legacy += f"window, dialog, .background, .card, .osd, popover > contents {{ border-radius: {radius}px; }}\n"
    if not edge_import:
        return legacy
    # Current libadwaita uses custom properties; GTK3 uses named colors.
    variables = []
    for line in legacy.splitlines():
        if line.startswith("@define-color "):
            name, value = line.removeprefix("@define-color ").rstrip(";").split(maxsplit=1)
            variables.append(f"  --{name.replace('_', '-')}: {value};")
    return legacy + ":root {\n" + "\n".join(variables) + "\n}\n"


def render_qt_qss(colors: Dict[str, str], radius: Optional[int] = None) -> str:
    """Generate QT5/QT6 QSS stylesheet override."""
    bg = colors.get("bg", "#282262")
    fg = colors.get("fg", "#E7DFD3")
    accent = colors.get("accent", "#1A407F")

    geometry = ""
    if radius is not None:
        if isinstance(radius, bool) or not isinstance(radius, int) or radius < 0:
            raise ValueError("Surface radius must be a nonnegative integer")
        geometry = f"QDialog, QMainWindow, QMenu, QFrame, QDockWidget, QPushButton, QLineEdit, QTextEdit, QPlainTextEdit {{ border-radius: {radius}px; }}\n"
    return geometry + f"""/* Generated by mios-theme-render from mios.toml SSOT */
QWidget {{
    background-color: {bg};
    color: {fg};
    selection-background-color: {accent};
    selection-color: {fg};
}}

QLineEdit, QTextEdit, QPlainTextEdit {{
    background-color: {bg};
    color: {fg};
    border: 1px solid {accent};
}}

QPushButton {{
    background-color: {accent};
    color: {fg};
    padding: 4px 12px;
}}
"""


def config_dirs(flatpak: Optional[str] = None) -> List[str]:
    """Host and per-app config roots, as GTK sees them inside Flatpak."""
    roots = [os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))]
    roots.extend(sorted(glob.glob(os.path.expanduser("~/.var/app/*/config"))))
    if flatpak is not None:
        if not re.fullmatch(r"[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+){2,}", flatpak):
            raise ValueError("Invalid Flatpak application ID")
        roots.append(os.path.expanduser(f"~/.var/app/{flatpak}/config"))
    return list(dict.fromkeys(roots))


def apply_gtk(colors: Dict[str, str], dry_run: bool = False,
              roots: Optional[List[str]] = None) -> List[str]:
    """Apply GTK3 and GTK4 CSS overrides."""
    written = []
    data = mios_toml.load_merged()
    for root, gtk4 in ((root, gtk4) for root in roots or config_dirs() for gtk4 in (True, False)):
        directory = os.path.join(root, "gtk-4.0" if gtk4 else "gtk-3.0")
        path = os.path.join(directory, "gtk.css")
        if not dry_run:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            palette_path = os.path.join(os.path.dirname(path), "mios-colors.css")
            mios_toml.write_atomic(palette_path, render_gtk_css(colors, edge_import=gtk4, opacity=data.get("theme", {}).get("opacity", 100) / 100 if data.get("theme", {}).get("acrylic", False) else 1, radius=data["desktop"]["hyprland"]["config"]["decoration"]["rounding"]))
            prior = ""
            if os.path.isfile(path):
                with open(path, encoding="utf-8") as handle:
                    prior = handle.read()
            if prior.startswith(("/* Generated by mios-theme-render", "/* AI-hint: Global GTK4 theme stylesheet generated")):
                prior = ""
            directive = '@import url("mios-colors.css");'
            if directive not in prior:
                mios_toml.write_atomic(path, directive + "\n" + prior)
            settings_path = os.path.join(os.path.dirname(path), "settings.ini")
            settings = configparser.ConfigParser(interpolation=None)
            settings.read(settings_path)
            if not settings.has_section("Settings"):
                settings.add_section("Settings")
            for key, value in {
                "gtk-theme-name": data["appearance"]["gtk_theme"],
                "gtk-icon-theme-name": data["appearance"]["icon_theme"],
                "gtk-application-prefer-dark-theme": int(data.get("desktop", {}).get("color_scheme", data["appearance"].get("adw_color_scheme", "prefer-dark")) == "prefer-dark"),
                "gtk-font-name": f'{data["theme"]["font"]["family"]} {data["theme"]["font"]["size"]}',
                "gtk-cursor-theme-name": data["theme"]["cursor_linux"]["theme"],
                "gtk-cursor-theme-size": data["theme"]["cursor_linux"]["size"],
                # MiOS owns window controls; apps draw no header-bar buttons ([appearance] client_decoration_layout).
                "gtk-decoration-layout": data["appearance"].get("client_decoration_layout", ":"),
            }.items():
                settings.set("Settings", key, str(value))
            buffer = io.StringIO()
            settings.write(buffer)
            mios_toml.write_atomic(settings_path, buffer.getvalue())
            written.extend([palette_path, settings_path])
        edge_src = os.path.join(_ROOT, "etc", "skel", ".config", "gtk-4.0", "mios-edge.css")
        edge_dst = os.path.join(directory, "mios-edge.css")
        if gtk4 and os.path.isfile(edge_src) and not os.path.exists(edge_dst):
            if not dry_run:
                shutil.copyfile(edge_src, edge_dst)
            written.append(edge_dst)
        written.append(path)
    return written


def apply_qt(colors: Dict[str, str], dry_run: bool = False,
             roots: Optional[List[str]] = None) -> List[str]:
    """Activate the SSOT stylesheet and palette in both Qt configuration plugins."""
    qss = render_qt_qss(colors, radius=mios_toml.load_merged()["desktop"]["hyprland"]["config"]["decoration"]["rounding"])
    written = []
    for root in roots or config_dirs():
        for toolkit in ("qt6ct", "qt5ct"):
            directory = os.path.join(root, toolkit)
            path = os.path.join(directory, "qss", "mios.qss")
            palette_path = os.path.join(directory, "colors", "MiOS.conf")
            settings_path = os.path.join(directory, toolkit + ".conf")
            written.extend([path, palette_path, settings_path])
            if dry_run:
                continue
            os.makedirs(os.path.dirname(path), exist_ok=True)
            os.makedirs(os.path.dirname(palette_path), exist_ok=True)
            mios_toml.write_atomic(path, qss)
            bg, fg, accent = (colors[k] for k in ("bg", "fg", "accent"))
            # QPalette roles, including placeholder and accent on current Qt.
            roles = [fg, bg, bg, bg, bg, fg, fg, fg, fg, bg, bg, bg,
                     accent, fg, accent, accent, bg, bg, fg, bg, fg, accent]
            palette = configparser.ConfigParser(interpolation=None)
            palette["ColorScheme"] = {group: ", ".join(roles)
                                     for group in ("active_colors", "inactive_colors", "disabled_colors")}
            buffer = io.StringIO()
            palette.write(buffer)
            mios_toml.write_atomic(palette_path, buffer.getvalue())
            settings = configparser.ConfigParser(interpolation=None)
            settings.read(settings_path)
            for section in ("Appearance", "Interface"):
                if not settings.has_section(section):
                    settings.add_section(section)
            settings["Appearance"].update({"style": "Fusion", "custom_palette": "true",
                                          "color_scheme_path": palette_path})
            settings["Interface"]["stylesheets"] = path
            buffer = io.StringIO()
            settings.write(buffer)
            mios_toml.write_atomic(settings_path, buffer.getvalue())
    return written


_USERJS_BEGIN = "// BEGIN MiOS [browser.zen].prefs (mios-theme-render --web)"
_USERJS_END = "// END MiOS [browser.zen].prefs"


def _gecko_profiles(roots: List[str]) -> List[str]:
    """Profile directories listed in each root's profiles.ini (relative or absolute)."""
    found = []
    for root in roots:
        ini = os.path.join(os.path.expanduser(root), "profiles.ini")
        if not os.path.isfile(ini):
            continue
        cfg = configparser.ConfigParser(interpolation=None)
        cfg.read(ini)
        for sec in cfg.sections():
            if not sec.startswith("Profile") or "Path" not in cfg[sec]:
                continue
            rel = cfg[sec].get("IsRelative", "1") == "1"
            path = os.path.join(os.path.dirname(ini), cfg[sec]["Path"]) if rel else cfg[sec]["Path"]
            if os.path.isdir(path) and path not in found:
                found.append(path)
    return found


# userChrome.css / userContent.css are shared with the user: MiOS owns only the text between
# these marker lines; everything outside them is the user's and is preserved verbatim.
_CSS_BEGIN = "/* BEGIN MiOS managed theme (mios-theme-render --web): edits inside this block are replaced */"
_CSS_END = "/* END MiOS managed theme */"
# First line of every unmarked chrome CSS file earlier MiOS releases wrote whole.
_CSS_LEGACY_SIGNATURES = ("/* AI-hint: Global MiOS web stylesheet",
                          "/* AI-hint: MiOS browser chrome for Zen/Firefox")


def _css_block(mios_text: str) -> str:
    return f"{_CSS_BEGIN}\n{mios_text.rstrip()}\n{_CSS_END}\n"


def _merge_managed_css(current: Optional[str], mios_text: str) -> "tuple[str, bool]":
    """Return (new file text, whether the current content must be backed up first).

    - no file / empty: just the MiOS block.
    - markers present: only the block between them is replaced; text outside is kept.
    - unmarked legacy MiOS render: replaced by the block (backup, in case the user edited it).
    - unmarked user CSS: kept verbatim, the MiOS block appended after it (so the user's
      leading @import/@namespace rules stay first, as CSS requires), backup taken.
    - BEGIN without END (damaged block): text before BEGIN kept, rest replaced, backup taken.
    """
    block = _css_block(mios_text)
    if current is None or not current.strip():
        return block, False
    begin = current.find(_CSS_BEGIN)
    if begin >= 0:
        end = current.find(_CSS_END, begin)
        if end >= 0:
            tail = current[end + len(_CSS_END):]
            if tail.startswith("\n"):
                tail = tail[1:]
            return current[:begin] + block + tail, False
        return current[:begin] + block, True
    if current.lstrip().startswith(_CSS_LEGACY_SIGNATURES):
        if current.rstrip() == mios_text.rstrip():
            return block, False  # untouched legacy render: nothing of the user's to keep
        return block, True
    return current.rstrip("\n") + "\n\n" + block, True


def _backup_path(path: str) -> str:
    import time
    base = f"{path}.mios-backup-{time.strftime('%Y%m%dT%H%M%S')}"
    candidate, n = base, 1
    while os.path.exists(candidate):
        candidate, n = f"{base}.{n}", n + 1
    return candidate


def _write_managed_css(path: str, mios_text: str) -> Optional[str]:
    """Write the MiOS block into path without destroying user CSS; returns the backup path."""
    current = None
    if os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as fh:
                current = fh.read()
        except UnicodeDecodeError:
            print(f"mios-theme-render: {path} is not UTF-8; left untouched", file=sys.stderr)
            return None
    text, backup_needed = _merge_managed_css(current, mios_text)
    if text == current:
        return None
    backup = None
    if backup_needed and current is not None:
        backup = _backup_path(path)
        shutil.copy2(path, backup)
    mios_toml.write_atomic(path, text)
    return backup


def _user_js_block(prefs: List[str]) -> str:
    lines = [_USERJS_BEGIN]
    for entry in prefs:
        name, kind, value = entry.split("|", 2)
        literal = value.lower() if kind == "bool" else str(int(value)) if kind == "int" else json.dumps(value)
        lines.append(f'user_pref("{name}", {literal});')
    lines.append(_USERJS_END)
    return "\n".join(lines) + "\n"


_DBUSMENU_LIBS = ("libdbusmenu-glib.so.4", "libdbusmenu-gtk3.so.4")
_DBUSMENU_HOST_DIRS = ("/usr/lib64", "/usr/lib/x86_64-linux-gnu", "/usr/lib")


def _zen_global_menu(flatpak: str, enable: bool, dry_run: bool) -> List[str]:
    """Let the Zen Flatpak export its menubar for the top-bar app-menu pills.

    Gecko's widget.gtk.global-menu dlopens libdbusmenu-glib/-gtk3, which the Freedesktop runtime
    lacks: stage the host copies in the app's own data dir and point LD_LIBRARY_PATH at them
    (per-user override, so every launch path gets it). The menubar is then served at
    /com/canonical/menu/<n> on Zen's bus connection, where `miosd appmenu` finds it."""
    import subprocess
    if not flatpak or shutil.which("flatpak") is None:
        return []
    libdir = os.path.join(os.path.expanduser("~/.var/app"), flatpak, "mios-dbusmenu")
    if dry_run:
        return [libdir]
    if not enable:
        subprocess.run(["flatpak", "override", "--user", "--unset-env=LD_LIBRARY_PATH",
                        "--no-talk-name=com.canonical.AppMenu.Registrar", flatpak],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        return []
    found = {}
    for lib in _DBUSMENU_LIBS:
        for d in _DBUSMENU_HOST_DIRS:
            if os.path.isfile(os.path.join(d, lib)):
                found[lib] = os.path.realpath(os.path.join(d, lib))
                break
    if len(found) != len(_DBUSMENU_LIBS):
        print("mios-theme-render: host libdbusmenu-glib/-gtk3 missing; Zen global menu not staged", file=sys.stderr)
        return []
    os.makedirs(libdir, exist_ok=True)
    for lib, src in found.items():
        dst = os.path.join(libdir, lib)
        if not os.path.isfile(dst) or os.path.getsize(dst) != os.path.getsize(src) \
                or os.path.getmtime(dst) < os.path.getmtime(src):
            shutil.copy2(src, dst + ".tmp")
            os.replace(dst + ".tmp", dst)
    subprocess.run(["flatpak", "override", "--user", f"--env=LD_LIBRARY_PATH={libdir}",
                    "--talk-name=com.canonical.AppMenu.Registrar", flatpak],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return [libdir]


def apply_web(dry_run: bool = False) -> List[str]:
    """Project the rendered SSOT web/chrome CSS and [browser.zen].prefs into every Gecko profile."""
    merged = mios_toml.load_merged()
    zen = merged["browser"]["zen"]
    sources = {"userContent.css": "/usr/share/mios/theme/mios-web.css",
               "userChrome.css": "/usr/share/mios/theme/gecko-userChrome.css"}
    texts = {}
    for name, src in sources.items():
        with open(src, encoding="utf-8") as fh:
            texts[name] = fh.read()
    prefs = list(zen["prefs"])
    ai = merged.get("browser_ai", {})
    if ai.get("enable"):
        # Smart Window / AI chat sidebar wired to the local MiOS provider ([browser_ai], shared with Windows).
        provider = re.sub(r"\$\{MIOS_PORTS_([A-Z0-9_]+)\}",
                          lambda m: str(merged["ports"][m.group(1).lower()]), ai["provider_url"])
        prefs += list(ai.get("prefs", [])) + [f"browser.ml.chat.provider|string|{provider}"]
    # Global menu: Zen exports its menubar (File, Edit, View ...) for the top-bar app-menu pills.
    global_menu = bool(zen.get("global_menu", False))
    prefs += [f"widget.gtk.global-menu.enabled|bool|{str(global_menu).lower()}",
              f"widget.gtk.global-menu.wayland.enabled|bool|{str(global_menu).lower()}"]
    block = _user_js_block(prefs)
    written = _zen_global_menu(zen.get("flatpak", ""), global_menu, dry_run)
    for profile in _gecko_profiles(zen["profile_roots"]):
        for name, text in texts.items():
            path = os.path.join(profile, "chrome", name)
            written.append(path)
            if not dry_run:
                backup = _write_managed_css(path, text)
                if backup:
                    print(f"mios-theme-render: kept your CSS in {path}; previous file saved as {backup}", file=sys.stderr)
        user_js = os.path.join(profile, "user.js")
        written.append(user_js)
        if dry_run:
            continue
        current = ""
        if os.path.isfile(user_js):
            with open(user_js, encoding="utf-8") as fh:
                current = fh.read()
        kept = re.sub(re.escape(_USERJS_BEGIN) + r".*?" + re.escape(_USERJS_END) + r"\n?", "", current, flags=re.S)
        mios_toml.write_atomic(user_js, (kept.rstrip("\n") + "\n" if kept.strip() else "") + block)
    return written


def apply_ptys(colors: Dict[str, str], dry_run: bool = False) -> List[str]:
    """Inject ANSI OSC 4/10/11/12 escape sequences into all writable user PTYs."""
    bg = colors.get("bg", "#282262")
    fg = colors.get("fg", "#E7DFD3")
    cursor = colors.get("cursor", "#F35C15")

    # Build sequence buffer
    seqs = []
    # OSC 10: foreground
    seqs.append(f"\033]10;{fg}\033\\")
    # OSC 11: background
    seqs.append(f"\033]11;{bg}\033\\")
    # OSC 12: cursor
    seqs.append(f"\033]12;{cursor}\033\\")

    # OSC 4: ansi palette indices 0..15
    for i in range(16):
        key = f"ansi_{i}_"
        matching = [v for k, v in colors.items() if k.startswith(key)]
        if matching:
            seqs.append(f"\033]4;{i};{matching[0]}\033\\")

    payload = "".join(seqs).encode("utf-8")
    updated = []

    my_uid = os.getuid() if hasattr(os, "getuid") else 1000

    for dev in sorted(glob.glob("/dev/pts/*")):
        if not os.path.basename(dev).isdigit():
            continue
        try:
            st = os.stat(dev)
            if st.st_uid == my_uid and bool(st.st_mode & stat.S_IWUSR):
                if not dry_run:
                    fd = os.open(dev, os.O_WRONLY | os.O_NOCTTY)
                    try:
                        os.write(fd, payload)
                    finally:
                        os.close(fd)
                updated.append(dev)
        except (OSError, IOError):
            continue

    return updated


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in ("render", "check", "capture", "apply", "diff"):
        engine = os.path.join(_HERE, "mios-dotfiles-render")
        if os.path.isfile(engine):
            import subprocess
            return subprocess.run([sys.executable, engine] + sys.argv[1:]).returncode

    parser = argparse.ArgumentParser(
        description="MiOS Multi-surface live theme renderer and PTY injector (task_443)"
    )
    parser.add_argument("--gtk", action="store_true", help="Generate GTK3/4 CSS overrides")
    parser.add_argument("--qt", action="store_true", help="Generate QT5/6 QSS overrides")
    parser.add_argument("--pty", action="store_true", help="Inject ANSI OSC escapes to active PTYs")
    parser.add_argument("--web", action="store_true", help="Project web/chrome CSS and prefs into Zen/Firefox profiles")
    parser.add_argument("--all", action="store_true", help="Apply theme to all surfaces (default)")
    parser.add_argument("--dry-run", action="store_true", help="Simulate without modifying files or PTYs")
    parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    parser.add_argument("--flatpak", help="Also project into this app's sandbox config directory")
    parser.add_argument("--config-root", action="append", help="Project into these config roots (image build/skel)")

    args = parser.parse_args()

    do_all = args.all or not (args.gtk or args.qt or args.pty or args.web)
    colors = resolve_colors()
    roots = args.config_root if args.config_root is not None else config_dirs(args.flatpak)

    results: Dict[str, Any] = {
        "status": "success",
        "dry_run": args.dry_run,
        "colors": {k: v for k, v in colors.items() if not k.startswith("ansi_")},
        "surfaces": {},
    }

    if do_all or args.gtk:
        results["surfaces"]["gtk"] = apply_gtk(colors, dry_run=args.dry_run, roots=roots)
    if do_all or args.qt:
        results["surfaces"]["qt"] = apply_qt(colors, dry_run=args.dry_run, roots=roots)
    if do_all or args.pty:
        results["surfaces"]["pty"] = apply_ptys(colors, dry_run=args.dry_run)
    if do_all or args.web:
        results["surfaces"]["web"] = apply_web(dry_run=args.dry_run)

    if args.json:
        print(json.dumps(results, indent=2))
    else:
        print(f"[mios-theme-render] Theme applied successfully (dry_run={args.dry_run})")
        for surf, targets in results["surfaces"].items():
            print(f"  [{surf.upper()}] Updated {len(targets)} surface(s):")
            for t in targets:
                print(f"    - {t}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
