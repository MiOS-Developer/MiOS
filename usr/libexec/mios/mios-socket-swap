class SocketSwapper:
    """Orchestrates zero-downtime hot swap using systemd socket activation / SCM_RIGHTS."""

    def __init__(
        self,
        service: str = DEFAULT_SERVICE,
        port: int = DEFAULT_PORT,
        sock_path: Optional[str] = None,
        state_dir: Optional[pathlib.Path] = None,
        mock_mode: bool = False,
        dry_run: bool = False,
        verbose: bool = False,
    ):
        self.service = service
        self.port = port
        self.mock_mode = mock_mode
        self.dry_run = dry_run
        self.verbose = verbose

        self.state_dir = state_dir or get_default_state_dir(mock_mode)
        self.sock_path = sock_path or str(self.state_dir / f"{service}.sock")
        self.control_sock_path = str(self.state_dir / f"{service}-control.sock")
        self.state = SwapState(self.state_dir, self.service)

    def is_pid_alive(self, pid: Optional[int]) -> bool:
        if not pid or pid <= 0:
            return False
        try:
            os.kill(pid, 0)
            return True
        except OSError as e:
            return e.errno == errno.EPERM

    def get_live_active_connections(self, pid: Optional[int]) -> int:
        if not self.is_pid_alive(pid):
            return 0
        # Try asking the control socket first
        if os.path.exists(self.control_sock_path):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(0.5)
                s.connect(self.control_sock_path)
                s.sendall(b"STATUS\n")
                resp = s.recv(1024).decode("utf-8")
                s.close()
                parsed = json.loads(resp)
                return int(parsed.get("active_requests", 0))
            except Exception:
                pass
        return 0

    def query_status(self) -> Dict[str, Any]:
        self.state.load()
        active_pid = self.state.data.get("active_pid")
        is_alive = self.is_pid_alive(active_pid)

        # Check systemd status if not in mock mode
        systemd_active = False
        systemd_main_pid = None
        if not self.mock_mode and shutil_which("systemctl"):
            try:
                p = subprocess.run(
                    ["systemctl", "is-active", f"mios-{self.service}.service"],
                    capture_output=True,
                    text=True,
                    check=False,
                )
                systemd_active = (p.stdout.strip() == "active")
                p2 = subprocess.run(
                    ["systemctl", "show", "-p", "MainPID", f"mios-{self.service}.service"],
                    capture_output=True,
                    text=True,
                    check=False,
                )
                for line in p2.stdout.splitlines():
                    if line.startswith("MainPID="):
                        systemd_main_pid = int(line.split("=", 1)[1].strip())
            except Exception:
                pass

        if not is_alive and systemd_main_pid and systemd_main_pid > 0:
            active_pid = systemd_main_pid
            is_alive = self.is_pid_alive(active_pid)

        active_conn = self.get_live_active_connections(active_pid)
        self.state.data["active_connections"] = active_conn

        status_str = "ACTIVE" if is_alive else ("INACTIVE" if active_pid else "UNINITIALIZED")

        result = {
            "service": self.service,
            "status": status_str,
            "active_pid": active_pid if is_alive else None,
            "previous_pid": self.state.data.get("previous_pid"),
            "systemd_active": systemd_active,
            "sockets": [
                {"type": "tcp", "address": "127.0.0.1", "port": self.port, "fd": SD_LISTEN_FDS_START},
                {"type": "unix", "path": self.sock_path, "fd": SD_LISTEN_FDS_START + 1},
            ],
            "control_socket": self.control_sock_path,
            "active_connections": active_conn,
            "last_swap_timestamp": self.state.data.get("last_swap_timestamp"),
            "transitions_count": self.state.data.get("transitions_count", 0),
            "last_error": self.state.data.get("last_error"),
            "history": self.state.data.get("history", []),
        }
        return result

    def print_status(self, as_json: bool = False) -> None:
        st = self.query_status()
        if as_json:
            print(json.dumps(st, indent=2))
            return

        print("=" * 60)
        print(f"MiOS Socket Handoff Swapper Status: {st['service']}")
        print("=" * 60)
        print(f"Status:              {st['status']}")
        print(f"Active PID:          {st['active_pid'] or 'None'}")
        print(f"Previous PID:        {st['previous_pid'] or 'None'}")
        print(f"Active Connections:  {st['active_connections']}")
        print(f"Transitions Count:   {st['transitions_count']}")
        print(f"Last Swap Timestamp: {st['last_swap_timestamp'] or 'Never'}")
        if st.get("last_error"):
            print(f"Last Error:          {st['last_error']}")
        print("\nManaged Sockets:")
        for s in st["sockets"]:
            if s["type"] == "tcp":
                print(f"  - TCP Listener:    {s['address']}:{s['port']} (inherited as FD {s['fd']})")
            else:
                print(f"  - Unix Domain:     {s['path']} (inherited as FD {s['fd']})")
        print(f"  - Control Socket:  {st['control_socket']}")
        print("=" * 60)

    def _acquire_listening_sockets(self, old_pid: Optional[int]) -> Tuple[socket.socket, socket.socket]:
        """Acquire existing listening sockets from old process or bind them fresh."""
        tcp_sock: Optional[socket.socket] = None
        unix_sock: Optional[socket.socket] = None

        # 1. Try SCM_RIGHTS from old process via control socket
        if old_pid and self.is_pid_alive(old_pid) and os.path.exists(self.control_sock_path):
            try:
                logger.info("Requesting listening FDs from running PID %d over control socket", old_pid)
                ctrl = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                ctrl.settimeout(2.0)
                ctrl.connect(self.control_sock_path)
                ctrl.sendall(b"GET_FDS\n")
                msg, fds = recv_fds_unix(ctrl, 1024, 4)
                ctrl.close()
                if msg == b"FDS_OK" and len(fds) >= 2:
                    tcp_sock = socket.fromfd(fds[0], socket.AF_INET, socket.SOCK_STREAM)
                    unix_sock = socket.fromfd(fds[1], socket.AF_UNIX, socket.SOCK_STREAM)
                    logger.info("Successfully received %d listening FDs via SCM_RIGHTS", len(fds))
                elif msg == b"FDS_OK" and len(fds) == 1:
                    tcp_sock = socket.fromfd(fds[0], socket.AF_INET, socket.SOCK_STREAM)
            except Exception as e:
                logger.debug("Could not retrieve FDs via control socket: %s", e)

        # 2. Check if we inherited FDs from systemd socket activation ourselves
        if not tcp_sock and int(os.environ.get("LISTEN_FDS", 0)) >= 1:
            try:
                tcp_sock = socket.fromfd(SD_LISTEN_FDS_START, socket.AF_INET, socket.SOCK_STREAM)
                if int(os.environ.get("LISTEN_FDS", 0)) >= 2:
                    unix_sock = socket.fromfd(SD_LISTEN_FDS_START + 1, socket.AF_UNIX, socket.SOCK_STREAM)
                logger.info("Adopted listening sockets from parent sd_listen_fds environment")
            except Exception as e:
                logger.debug("Failed adopting from parent LISTEN_FDS: %s", e)

        # 3. If still missing, bind them with SO_REUSEADDR and SO_REUSEPORT
        if not tcp_sock:
            s_tcp = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s_tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s_tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
            except (AttributeError, OSError):
                pass
            s_tcp.bind(("127.0.0.1", self.port))
            s_tcp.listen(128)
            tcp_sock = s_tcp

        if not unix_sock:
            if not old_pid or not self.is_pid_alive(old_pid):
                if os.path.exists(self.sock_path):
                    try:
                        os.unlink(self.sock_path)
                    except OSError:
                        pass
            os.makedirs(os.path.dirname(os.path.abspath(self.sock_path)), exist_ok=True)
            s_unix = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            if not os.path.exists(self.sock_path):
                s_unix.bind(self.sock_path)
                s_unix.listen(128)
            unix_sock = s_unix

        return tcp_sock, unix_sock

    def _wait_for_health(
        self,
        candidate_proc: subprocess.Popen,
        timeout: float,
        health_url: Optional[str] = None,
    ) -> bool:
        """Poll candidate process and verify health check endpoint within timeout."""
        start_time = time.time()
        deadline = start_time + timeout

        url = health_url or f"http://127.0.0.1:{self.port}/health"
        parsed = urllib.parse.urlparse(url)

        logger.info("Probing candidate PID %d health at %s (timeout: %.1fs)", candidate_proc.pid, url, timeout)

        while time.time() < deadline:
            # First check if process terminated prematurely
            ret = candidate_proc.poll()
            if ret is not None:
                logger.error("Candidate process PID %d exited prematurely with code %d", candidate_proc.pid, ret)
                return False

            try:
                conn = http.client.HTTPConnection(parsed.hostname or "127.0.0.1", parsed.port or self.port, timeout=0.5)
                path = parsed.path or "/health"
                if parsed.query:
                    path += f"?{parsed.query}"
                conn.request("GET", path)
                resp = conn.getresponse()
                if resp.status == 200:
                    body = resp.read()
                    conn.close()
                    # If health response contains a PID, verify it belongs to candidate
                    try:
                        data = json.loads(body.decode("utf-8"))
                        resp_pid = data.get("pid")
                        if resp_pid is not None and resp_pid != candidate_proc.pid:
                            # Response came from old process, wait for candidate to take over
                            time.sleep(0.05)
                            continue
                    except Exception:
                        pass

                    if candidate_proc.poll() is not None:
                        logger.error("Candidate PID %d died immediately after health check", candidate_proc.pid)
                        return False

                    logger.info("Candidate PID %d healthcheck succeeded in %.2fs", candidate_proc.pid, time.time() - start_time)
                    return True
                conn.close()
            except Exception:
                pass

            time.sleep(0.1)

        logger.error("Candidate PID %d failed health check within %.1fs timeout", candidate_proc.pid, timeout)
        return False

    def execute_swap(
        self,
        candidate_cmd: Optional[str] = None,
        timeout: float = DEFAULT_TIMEOUT,
        drain_timeout: float = DEFAULT_DRAIN_TIMEOUT,
        signal_name: str = "SIGUSR1",
    ) -> bool:
        """Executes zero-downtime socket handoff."""
        start_time = time.time()
        self.state.load()
        old_pid = self.state.data.get("active_pid")
        if not self.is_pid_alive(old_pid):
            old_pid = None

        logger.info(
            "Initiating zero-downtime socket swap for %s (current active PID: %s)",
            self.service,
            old_pid or "None",
        )

        if self.dry_run:
            logger.info("[DRY-RUN] Sockets would be passed to candidate; old PID %s would receive %s", old_pid, signal_name)
            return True

        # Acquire listening sockets
        tcp_sock, unix_sock = self._acquire_listening_sockets(old_pid)
        self.port = tcp_sock.getsockname()[1]

        # Prepare candidate command
        if not candidate_cmd:
            if self.mock_mode or not pathlib.Path("/usr/lib/mios/agent-pipe/server.py").exists():
                candidate_cmd = (
                    f"{sys.executable} {os.path.abspath(__file__)} --mock-worker "
                    f"--service {self.service} --port {self.port} "
                    f"--sock-path {self.sock_path} --state-dir {self.state_dir}"
                )
            else:
                candidate_cmd = f"/usr/lib/mios/agents/.venv/bin/python3 -u /usr/lib/mios/agent-pipe/server.py"

        logger.info("Candidate command: %s", candidate_cmd)

        # Map listening sockets to FDs 3 and 4
        fd_tcp = 3
        fd_unix = 4

        os.dup2(tcp_sock.fileno(), fd_tcp)
        os.dup2(unix_sock.fileno(), fd_unix)

        env = os.environ.copy()
        env["LISTEN_FDS"] = "2"
        env["LISTEN_FDNAMES"] = "tcp:unix"
        env["MIOS_PORTS_AGENT_PIPE"] = str(self.port)

        # Spawn candidate process with pass_fds
        try:
            cmd_args = candidate_cmd if isinstance(candidate_cmd, list) else candidate_cmd.split()
            candidate_proc = subprocess.Popen(
                cmd_args,
                pass_fds=(fd_tcp, fd_unix),
                env=env,
                preexec_fn=None,
            )
        except Exception as e:
            logger.error("Failed to spawn candidate process: %s", e)
            self.state.data["last_error"] = f"Spawn failed: {e}"
            self.state.save()
            return False

        candidate_pid = candidate_proc.pid
        logger.info("Spawned candidate process PID %d with listening FDs 3 & 4 inherited", candidate_pid)
        self.state.data["candidate_pid"] = candidate_pid
        self.state.data["status"] = "SWAPPING"
        self.state.save()

        # Step 3: Health check validation with automated rollback on failure
        healthy = self._wait_for_health(candidate_proc, timeout)

        if not healthy:
            logger.error(
                "ABORTING SWAP: Candidate PID %d failed health check / crashed. Initiating rollback to PID %s.",
                candidate_pid,
                old_pid or "None",
            )
            try:
                candidate_proc.terminate()
                candidate_proc.wait(timeout=1.0)
            except Exception:
                try:
                    candidate_proc.kill()
                except Exception:
                    pass

            self.state.data["candidate_pid"] = None
            self.state.data["status"] = "ROLLED_BACK"
            self.state.data["last_error"] = f"Candidate PID {candidate_pid} failed startup healthcheck; retained PID {old_pid}"
            self.state.save()
            logger.info("Rollback complete. Existing process PID %s retained without dropped connections.", old_pid)
            return False

        # Step 4: Graceful drain of old process
        if old_pid and self.is_pid_alive(old_pid):
            drain_sig = getattr(signal, signal_name, signal.SIGUSR1)
            logger.info(
                "Candidate PID %d is healthy. Sending %s to old PID %d for graceful drain (timeout: %.1fs)",
                candidate_pid,
                signal_name,
                old_pid,
                drain_timeout,
            )
            try:
                # First notify via control socket if available
                if os.path.exists(self.control_sock_path):
                    with contextlib.suppress(Exception):
                        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                        s.settimeout(1.0)
                        s.connect(self.control_sock_path)
                        s.sendall(b"DRAIN\n")
                        s.close()

                # Send graceful drain signal
                os.kill(old_pid, drain_sig)
            except OSError as e:
                logger.warning("Failed sending signal to old PID %d: %s", old_pid, e)

            # Wait for old process to drain and exit
            drain_start = time.time()
            old_exited = False
            while time.time() - drain_start < drain_timeout:
                if not self.is_pid_alive(old_pid):
                    old_exited = True
                    break
                time.sleep(0.1)

            if not old_exited:
                logger.warning("Old PID %d did not exit within drain timeout. Sending SIGTERM.", old_pid)
                try:
                    os.kill(old_pid, signal.SIGTERM)
                except OSError:
                    pass

        # Step 5: Record successful swap transition
        duration_ms = (time.time() - start_time) * 1000.0
        self.state.record_transition(old_pid, candidate_pid, "ACTIVE", duration_ms)
        logger.info(
            "SUCCESS: Zero-downtime socket handoff completed for %s: PID %s -> %d in %.2fms",
            self.service,
            old_pid or "None",
            candidate_pid,
            duration_ms,
        )
        return True


def shutil_which(cmd: str) -> Optional[str]:
    """Check if command exists in PATH."""
    path = os.environ.get("PATH", "")
    for p in path.split(os.pathsep):
        candidate = os.path.join(p, cmd)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


# ==============================================================================
# CLI Entry Point
# ==============================================================================

def main() -> int:
    parser = argparse.ArgumentParser(
        description="Zero-downtime systemd socket handoff daemon swapper for agent-pipe (task_486, task_2719).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose logging")
    parser.add_argument("--mock", action="store_true", help="Run with mock fixtures / harness")
    parser.add_argument("--dry-run", action="store_true", help="Simulate swap without spawning or signaling")
    parser.add_argument(
        "--mock-worker",
        action="store_true",
        help="Internal flag to run mock worker daemon",
    )
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help=f"TCP port (default: {DEFAULT_PORT})")
    parser.add_argument("--sock-path", type=str, help="Unix domain socket path")
    parser.add_argument("--state-dir", type=str, help="Runtime state directory")
    parser.add_argument("--service", type=str, default=DEFAULT_SERVICE, help=f"Service name (default: {DEFAULT_SERVICE})")

    subparsers = parser.add_subparsers(dest="command", help="Subcommand to execute")

    # swap subcommand
    swap_parser = subparsers.add_parser("swap", help="Execute zero-downtime socket handoff")
    swap_parser.add_argument("--service", type=str, default=DEFAULT_SERVICE, help=f"Service name (default: {DEFAULT_SERVICE})")
    swap_parser.add_argument("--candidate", type=str, help="Candidate process execution command")
    swap_parser.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help=f"Candidate startup timeout (default: {DEFAULT_TIMEOUT}s)")
    swap_parser.add_argument("--drain-timeout", type=float, default=DEFAULT_DRAIN_TIMEOUT, help=f"Graceful drain timeout (default: {DEFAULT_DRAIN_TIMEOUT}s)")
    swap_parser.add_argument("--signal", type=str, default="SIGUSR1", help="Drain signal to send old process (default: SIGUSR1)")

    # status subcommand
    status_parser = subparsers.add_parser("status", help="Report socket ownership and swap transition status")
    status_parser.add_argument("--service", type=str, default=DEFAULT_SERVICE, help=f"Service name (default: {DEFAULT_SERVICE})")
    status_parser.add_argument("--json", action="store_true", help="Output status in JSON format")

    args = parser.parse_args()

    log_level = logging.DEBUG if args.verbose else logging.INFO
    logging.basicConfig(level=log_level, format="[mios-socket-swap] %(levelname)s: %(message)s")

    state_dir = pathlib.Path(args.state_dir) if args.state_dir else get_default_state_dir(args.mock)

    # Check internal mock-worker mode first
    if args.mock_worker:
        service = getattr(args, "service", DEFAULT_SERVICE)
        port = args.port
        sock_path = args.sock_path or str(state_dir / f"{service}.sock")
        ctrl_path = str(state_dir / f"{service}-control.sock")
        worker = MockDaemonWorker(service, port, sock_path, ctrl_path, state_dir)
        return worker.run()

    if not args.command:
        parser.print_help()
        return 0

    if args.command == "swap":
        swapper = SocketSwapper(
            service=args.service,
            port=args.port,
            sock_path=args.sock_path,
            state_dir=state_dir,
            mock_mode=args.mock,
            dry_run=args.dry_run,
            verbose=args.verbose,
        )
        success = swapper.execute_swap(
            candidate_cmd=args.candidate,
            timeout=args.timeout,
            drain_timeout=args.drain_timeout,
            signal_name=args.signal,
        )
        return 0 if success else 1

    if args.command == "status":
        swapper = SocketSwapper(
            service=args.service,
            port=args.port,
            sock_path=args.sock_path,
            state_dir=state_dir,
            mock_mode=args.mock,
            dry_run=args.dry_run,
            verbose=args.verbose,
        )
        swapper.print_status(as_json=args.json)
        return 0

    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
