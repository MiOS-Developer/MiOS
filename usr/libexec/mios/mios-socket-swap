class SwapState:
    """Manages persistent swap state and transition history."""

    def __init__(self, state_dir: pathlib.Path, service: str):
        self.state_dir = state_dir
        self.service = service
        self.state_file = state_dir / f"socket-swap-{service}.json"
        self.data: Dict[str, Any] = {
            "service": service,
            "status": "INITIALIZING",
            "active_pid": None,
            "candidate_pid": None,
            "previous_pid": None,
            "port": DEFAULT_PORT,
            "sock_path": str(state_dir / f"{service}.sock"),
            "control_sock_path": str(state_dir / f"{service}-control.sock"),
            "last_swap_timestamp": None,
            "transitions_count": 0,
            "last_error": None,
            "active_connections": 0,
            "history": [],
        }
        self.load()

    def load(self) -> None:
        if self.state_file.exists():
            try:
                with open(self.state_file, "r", encoding="utf-8") as f:
                    loaded = json.load(f)
                    self.data.update(loaded)
            except Exception as e:
                logger.warning("Failed to load existing state file: %s", e)

    def save(self) -> None:
        self.state_dir.mkdir(parents=True, exist_ok=True)
        tmp_file = self.state_file.with_suffix(".tmp")
        with open(tmp_file, "w", encoding="utf-8") as f:
            json.dump(self.data, f, indent=2)
        tmp_file.replace(self.state_file)

    def record_transition(self, old_pid: Optional[int], new_pid: int, status: str, duration_ms: float) -> None:
        entry = {
            "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "old_pid": old_pid,
            "new_pid": new_pid,
            "status": status,
            "duration_ms": round(duration_ms, 2),
        }
        self.data["history"].append(entry)
        if len(self.data["history"]) > 20:
            self.data["history"] = self.data["history"][-20:]
        self.data["previous_pid"] = old_pid
        self.data["active_pid"] = new_pid
        self.data["candidate_pid"] = None
        self.data["status"] = status
        self.data["last_swap_timestamp"] = entry["timestamp"]
        self.data["transitions_count"] += 1
        self.save()


# ==============================================================================
# Mock Worker / Daemon Implementation (supports sd_listen_fds & SCM_RIGHTS)
# ==============================================================================

class MockDaemonWorker:
    """Built-in daemon worker used for testing zero-downtime socket handoff.

    Accepts sd_listen_fds, serves HTTP on TCP and Unix domain socket,
    supports SCM_RIGHTS FD handoff over a control socket, and gracefully
    drains connections on SIGUSR1.
    """

    def __init__(
        self,
        service: str,
        port: int,
        sock_path: str,
        control_sock_path: str,
        state_dir: pathlib.Path,
    ):
        self.service = service
        self.port = port
        self.sock_path = sock_path
        self.control_sock_path = control_sock_path
        self.state_dir = state_dir

        self.running = True
        self.draining = False
        self.active_requests = 0
        self.lock = threading.Lock()

        self.tcp_listener: Optional[socket.socket] = None
        self.unix_listener: Optional[socket.socket] = None
        self.ctrl_listener: Optional[socket.socket] = None

        self._setup_signals()
        self._setup_sockets()

    def _setup_signals(self) -> None:
        signal.signal(signal.SIGUSR1, self._handle_sigusr1)
        signal.signal(signal.SIGTERM, self._handle_sigterm)
        signal.signal(signal.SIGINT, self._handle_sigterm)

    def _handle_sigusr1(self, signum: int, frame: Any) -> None:
        logger.info("Mock worker PID %d received SIGUSR1: initiating graceful drain", os.getpid())
        self.trigger_drain()

    def _handle_sigterm(self, signum: int, frame: Any) -> None:
        logger.info("Mock worker PID %d received termination signal", os.getpid())
        self.running = False

    def trigger_drain(self) -> None:
        with self.lock:
            if self.draining:
                return
            self.draining = True

        # Stop accepting new incoming connections on service sockets
        if self.tcp_listener:
            try:
                self.tcp_listener.close()
            except Exception:
                pass
            self.tcp_listener = None
        if self.unix_listener:
            try:
                self.unix_listener.close()
            except Exception:
                pass
            self.unix_listener = None

    def _setup_sockets(self) -> None:
        listen_pid_str = os.environ.get("LISTEN_PID")
        listen_fds_str = os.environ.get("LISTEN_FDS")

        is_socket_activated = False
        if listen_fds_str and int(listen_fds_str) > 0:
            if not listen_pid_str or listen_pid_str == str(os.getpid()):
                is_socket_activated = True

        if is_socket_activated:
            num_fds = int(listen_fds_str)  # type: ignore
            logger.info("Mock worker PID %d inherited %d socket FDs from sd_listen_fds", os.getpid(), num_fds)
            if num_fds >= 1:
                self.tcp_listener = socket.fromfd(SD_LISTEN_FDS_START, socket.AF_INET, socket.SOCK_STREAM)
            if num_fds >= 2:
                self.unix_listener = socket.fromfd(SD_LISTEN_FDS_START + 1, socket.AF_UNIX, socket.SOCK_STREAM)
        else:
            logger.info("Mock worker PID %d binding standalone sockets", os.getpid())
            # TCP socket
            s_tcp = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s_tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s_tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
            except (AttributeError, OSError):
                pass
            s_tcp.bind(("127.0.0.1", self.port))
            s_tcp.listen(128)
            s_tcp.setblocking(False)
            self.tcp_listener = s_tcp

            # Unix socket
            if os.path.exists(self.sock_path):
                try:
                    os.unlink(self.sock_path)
                except OSError:
                    pass
            s_unix = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s_unix.bind(self.sock_path)
            s_unix.listen(128)
            s_unix.setblocking(False)
            self.unix_listener = s_unix

        # Control socket for SCM_RIGHTS FD handoff
        if os.path.exists(self.control_sock_path):
            try:
                os.unlink(self.control_sock_path)
            except OSError:
                pass
        s_ctrl = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s_ctrl.bind(self.control_sock_path)
        s_ctrl.listen(10)
        s_ctrl.setblocking(False)
        self.ctrl_listener = s_ctrl

    def _handle_control_client(self, client: socket.socket) -> None:
        try:
            client.settimeout(2.0)
            data = client.recv(1024).strip()
            if data == b"GET_FDS":
                fds_to_send: List[int] = []
                if self.tcp_listener:
                    fds_to_send.append(self.tcp_listener.fileno())
                if self.unix_listener:
                    fds_to_send.append(self.unix_listener.fileno())
                if fds_to_send:
                    send_fds_unix(client, b"FDS_OK", fds_to_send)
                else:
                    client.sendall(b"NO_FDS\n")
            elif data == b"DRAIN":
                self.trigger_drain()
                client.sendall(b"DRAINING\n")
            elif data == b"STATUS":
                status_obj = {
                    "pid": os.getpid(),
                    "active_requests": self.active_requests,
                    "draining": self.draining,
                }
                client.sendall(json.dumps(status_obj).encode("utf-8") + b"\n")
            elif data == b"PING":
                client.sendall(b"PONG\n")
            else:
                client.sendall(b"UNKNOWN\n")
        except Exception as e:
            logger.debug("Control client error: %s", e)
        finally:
            try:
                client.close()
            except Exception:
                pass

    def _handle_http_request(self, client: socket.socket) -> None:
        try:
            with self.lock:
                self.active_requests += 1

            client.settimeout(5.0)
            req_data = b""
            while b"\r\n\r\n" not in req_data:
                chunk = client.recv(1024)
                if not chunk:
                    break
                req_data += chunk

            if not req_data:
                return

            req_line = req_data.decode("utf-8", errors="replace").splitlines()[0]
            parts = req_line.split()
            path = parts[1] if len(parts) > 1 else "/"

            parsed = urllib.parse.urlparse(path)
            qs = urllib.parse.parse_qs(parsed.query)

            # Support simulated delay for testing in-flight connection continuity
            delay = float(qs.get("delay", [0])[0])
            if delay > 0:
                time.sleep(delay)

            if parsed.path == "/health":
                body = json.dumps({"status": "ok", "pid": os.getpid(), "draining": self.draining}).encode("utf-8")
                resp = (
                    b"HTTP/1.1 200 OK\r\n"
                    b"Content-Type: application/json\r\n"
                    b"Content-Length: " + str(len(body)).encode("utf-8") + b"\r\n"
                    b"Connection: close\r\n\r\n" + body
                )
            elif parsed.path == "/v1/models":
                body = json.dumps({
                    "object": "list",
                    "data": [{"id": "granite4.1:8b", "object": "model"}],
                    "served_by_pid": os.getpid(),
                }).encode("utf-8")
                resp = (
                    b"HTTP/1.1 200 OK\r\n"
                    b"Content-Type: application/json\r\n"
                    b"Content-Length: " + str(len(body)).encode("utf-8") + b"\r\n"
                    b"Connection: close\r\n\r\n" + body
                )
            elif parsed.path == "/status":
                body = json.dumps({
                    "pid": os.getpid(),
                    "active_requests": self.active_requests,
                    "draining": self.draining,
                }).encode("utf-8")
                resp = (
                    b"HTTP/1.1 200 OK\r\n"
                    b"Content-Type: application/json\r\n"
                    b"Content-Length: " + str(len(body)).encode("utf-8") + b"\r\n"
                    b"Connection: close\r\n\r\n" + body
                )
            else:
                body = json.dumps({"echo": path, "pid": os.getpid()}).encode("utf-8")
                resp = (
                    b"HTTP/1.1 200 OK\r\n"
                    b"Content-Type: application/json\r\n"
                    b"Content-Length: " + str(len(body)).encode("utf-8") + b"\r\n"
                    b"Connection: close\r\n\r\n" + body
                )

            client.sendall(resp)
        except Exception as e:
            logger.debug("Request handling exception: %s", e)
        finally:
            with self.lock:
                self.active_requests = max(0, self.active_requests - 1)
            try:
                client.close()
            except Exception:
                pass

    def run(self) -> int:
        logger.info("Mock worker starting on PID %d", os.getpid())
        while self.running:
            if self.draining:
                with self.lock:
                    if self.active_requests <= 0:
                        logger.info("Mock worker PID %d finished in-flight drain. Exiting cleanly.", os.getpid())
                        break
                time.sleep(0.05)
                continue

            rlist = []
            if self.tcp_listener:
                rlist.append(self.tcp_listener)
            if self.unix_listener:
                rlist.append(self.unix_listener)
            if self.ctrl_listener:
                rlist.append(self.ctrl_listener)

            if not rlist:
                time.sleep(0.05)
                continue

            try:
                readable, _, _ = select.select(rlist, [], [], 0.2)
            except (select.error, OSError) as e:
                if getattr(e, "errno", None) == errno.EINTR:
                    continue
                break

            for sock in readable:
                if sock is self.ctrl_listener:
                    try:
                        c, _ = self.ctrl_listener.accept()
                        t = threading.Thread(target=self._handle_control_client, args=(c,), daemon=True)
                        t.start()
                    except (OSError, socket.error):
                        pass
                elif sock is self.tcp_listener:
                    try:
                        c, _ = self.tcp_listener.accept()
                        t = threading.Thread(target=self._handle_http_request, args=(c,), daemon=True)
                        t.start()
                    except (OSError, socket.error):
                        pass
                elif sock is self.unix_listener:
                    try:
                        c, _ = self.unix_listener.accept()
                        t = threading.Thread(target=self._handle_http_request, args=(c,), daemon=True)
                        t.start()
                    except (OSError, socket.error):
                        pass

        # Cleanup control socket if we created it
        if self.ctrl_listener:
            try:
                self.ctrl_listener.close()
            except Exception:
                pass
        if os.path.exists(self.control_sock_path):
            try:
                os.unlink(self.control_sock_path)
            except OSError:
                pass
        return 0


