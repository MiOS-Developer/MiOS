def get_default_state_dir(mock_mode: bool = False) -> pathlib.Path:
    """Determine runtime state directory based on privileges and mock mode."""
    if mock_mode or os.geteuid() != 0:
        tmp_dir = os.environ.get("MIOS_RUNTIME_DIR") or "/tmp/mios-socket-swap"
        p = pathlib.Path(tmp_dir)
    else:
        p = pathlib.Path("/run/mios")
    p.mkdir(parents=True, exist_ok=True)
    return p


def send_fds_unix(sock: socket.socket, msg: bytes, fds: List[int]) -> int:
    """Send file descriptors over a Unix domain socket using SCM_RIGHTS."""
    ancdata = [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array("i", fds))]
    return sock.sendmsg([msg], ancdata)


def recv_fds_unix(sock: socket.socket, msglen: int = 1024, maxfds: int = 8) -> Tuple[bytes, List[int]]:
    """Receive file descriptors over a Unix domain socket using SCM_RIGHTS."""
    fds_arr = array.array("i")
    cmsg_space = socket.CMSG_LEN(maxfds * fds_arr.itemsize)
    msg, ancdata, flags, addr = sock.recvmsg(msglen, cmsg_space)
    received_fds: List[int] = []
    for cmsg_level, cmsg_type, cmsg_data in ancdata:
        if cmsg_level == socket.SOL_SOCKET and cmsg_type == socket.SCM_RIGHTS:
            fds_arr.frombytes(cmsg_data[: len(cmsg_data) - (len(cmsg_data) % fds_arr.itemsize)])
            received_fds.extend(list(fds_arr))
    return msg, received_fds


