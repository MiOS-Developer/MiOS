#!/usr/bin/env python3
# AI-hint: Unified log aggregation pipeline streaming systemd journald events to pgvector system_logs table with nomic-embed-text vector indexing.
# AI-related: usr/lib/systemd/system/mios-log-streamer.service, tests/test-log-streamer.py, usr/share/mios/postgres/schema-init.sql
# AI-functions: parse_journal_record, generate_embeddings_batch, format_sql_insert, stream_journal_records, process_log_batch, main
"""
MiOS Unified Log Aggregation Pipeline (mios-log-streamer).
Ingests systemd journald events, filters structured JSON records (Priority 0..3),
extracts priority/unit/message metadata, computes vector embeddings (nomic-embed-text),
and batch inserts into PostgreSQL pgvector system_logs table for semantic recall.
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import math
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from typing import Any, Dict, Generator, List, Optional, Tuple

def _ssot_root() -> Dict[str, Any]:
    """The whole layered SSOT; {} when unreadable (degrade-open)."""
    here = os.path.dirname(os.path.abspath(__file__))
    for lib in ("/usr/lib/mios", os.path.join(here, "..", "..", "..", "lib", "mios")):
        lib = os.path.normpath(lib)
        if os.path.isdir(lib) and lib not in sys.path:
            sys.path.insert(0, lib)
    try:
        import mios_toml
        return mios_toml.load_merged() or {}
    except Exception:
        try:
            import tomllib
            with open(os.environ.get("MIOS_TOML", "/usr/share/mios/mios.toml"), "rb") as fh:
                return tomllib.load(fh) or {}
        except Exception:
            return {}

_SSOT = _ssot_root()
# Sub-table key as a constant, not a literal at the call site: spelled inline it
# is indistinguishable from a read of the same-named top-level table to
# check_no_inert_ssot_tables, which would credit that table a consumer it lacks.
_PIPE_KEY = "pipeline"
_PIPE = (_SSOT.get("logging") or {}).get(_PIPE_KEY) or {}
_PORTS = _SSOT.get("ports") or {}
# Law 5: the endpoint is MIOS_AI_ENDPOINT, or the SSOT agent-pipe port. The
# resolver emits the name with a ${MIOS_PORT_*} placeholder, so an unexpanded
# value is not usable and falls through to the port.
_ENDPOINT_ENV = os.path.expandvars(os.environ.get("MIOS_AI_ENDPOINT", ""))

DEFAULT_MAX_PRIORITY = int(_PIPE.get("min_priority", 3))   # 0=emerg..3=err
DEFAULT_BATCH_SIZE = int(_PIPE.get("batch_size", 50))
DEFAULT_FLUSH_INTERVAL = float(_PIPE.get("flush_interval_s", 5))
DEFAULT_AI_ENDPOINT = (_ENDPOINT_ENV if _ENDPOINT_ENV and "${" not in _ENDPOINT_ENV
                       else "http://localhost:%s/v1" % _PORTS.get("agent_pipe", 8700))
DEFAULT_EMBED_MODEL = str((_SSOT.get("ai") or {}).get("embed_model") or "nomic-embed-text")
DEFAULT_EMBED_DIM = int(_PIPE.get("embedding_dim", 768))
DEFAULT_TARGET_TABLE = str(_PIPE.get("target_table", "system_logs"))
DEFAULT_CURSOR_PATH = "/var/lib/mios/log-streamer/cursor.state"


def generate_deterministic_embedding(text: str, dim: int = DEFAULT_EMBED_DIM) -> List[float]:
    """
    Generates a deterministic, normalized unit vector of dimension `dim`
    from SHA-256 hash of text for offline / mock testing.
    """
    raw_hash = hashlib.sha512(text.encode("utf-8")).digest()
    # Expand or hash in rounds to get `dim` float values
    values: List[float] = []
    round_idx = 0
    while len(values) < dim:
        seed = f"{text}_{round_idx}".encode("utf-8")
        h = hashlib.sha256(seed).digest()
        for i in range(0, len(h), 4):
            if len(values) >= dim:
                break
            val = int.from_bytes(h[i:i+4], byteorder="little", signed=True) / 2147483648.0
            values.append(val)
        round_idx += 1

    # L2 normalize
    norm = math.sqrt(sum(v * v for v in values)) or 1.0
    return [round(v / norm, 6) for v in values]


def fetch_remote_embeddings(
    texts: List[str],
    endpoint: str = DEFAULT_AI_ENDPOINT,
    model: str = DEFAULT_EMBED_MODEL,
    timeout_sec: float = 5.0,
) -> Optional[List[List[float]]]:
    """Calls OpenAI-compatible /v1/embeddings endpoint for batch embedding generation."""
    url = endpoint.rstrip("/") + "/embeddings"
    req_payload = {
        "input": texts,
        "model": model,
    }

    try:
        data = json.dumps(req_payload).encode("utf-8")
        req = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            if resp.status == 200:
                body = json.loads(resp.read().decode("utf-8"))
                emb_data = body.get("data", [])
                # Sort by index
                emb_data.sort(key=lambda x: x.get("index", 0))
                return [item["embedding"] for item in emb_data]
    except Exception:
        pass
    return None


def generate_embeddings_batch(
    texts: List[str],
    endpoint: str = DEFAULT_AI_ENDPOINT,
    model: str = DEFAULT_EMBED_MODEL,
    mock_embeddings: bool = False,
) -> List[List[float]]:
    """Generates embeddings for a batch of text messages with local fallback."""
    if not mock_embeddings:
        remote_res = fetch_remote_embeddings(texts, endpoint=endpoint, model=model)
        if remote_res and len(remote_res) == len(texts):
            return remote_res

    # Deterministic fallback. These vectors are hash-derived, not semantic: they
    # satisfy the column and the HNSW index but retrieve nonsense. The caller
    # stamps emb_version only for REMOTE results, so the backfiller's
    # `emb_version IS DISTINCT FROM <ver>` finds exactly these rows and repairs
    # them once the endpoint is back (task_979).
    return [generate_deterministic_embedding(t) for t in texts]


def parse_journal_record(raw_record: Dict[str, Any], max_priority: int = DEFAULT_MAX_PRIORITY) -> Optional[Dict[str, Any]]:
    """
    Parses and sanitizes a raw journald JSON record.
    Filters by priority (priority <= max_priority).
    Extracts unit, priority, message, timestamp, and metadata.
    """
    # 1. Check priority
    pri_raw = raw_record.get("PRIORITY", 6)
    try:
        priority = int(pri_raw)
    except (ValueError, TypeError):
        priority = 6

    if priority > max_priority:
        return None

    # 2. Extract Message
    msg = raw_record.get("MESSAGE", "")
    if isinstance(msg, list):
        # journalctl sometimes represents binary messages as uint8 list
        try:
            msg = bytes(msg).decode("utf-8", errors="replace")
        except Exception:
            msg = str(msg)
    elif not isinstance(msg, str):
        msg = str(msg)

    msg = msg.strip()
    if not msg:
        return None

    # 3. Extract Unit / Service Identifier
    unit = (
        raw_record.get("_SYSTEMD_UNIT")
        or raw_record.get("SYSLOG_IDENTIFIER")
        or raw_record.get("_COMM")
        or "kernel"
    )
    if isinstance(unit, list):
        unit = "".join(chr(c) for c in unit if 32 <= c <= 126)

    # 4. Extract Timestamp
    ts_usec = raw_record.get("__REALTIME_TIMESTAMP")
    if ts_usec:
        try:
            ts_sec = int(ts_usec) / 1000000.0
            ts_iso = datetime.datetime.fromtimestamp(ts_sec, tz=datetime.timezone.utc).isoformat()
        except (ValueError, TypeError):
            ts_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()
    else:
        ts_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()

    # 5. Extract Cursor
    cursor = raw_record.get("__CURSOR")

    # 6. Extract structured metadata
    metadata = {
        "pid": raw_record.get("_PID"),
        "hostname": raw_record.get("_HOSTNAME", "localhost"),
        "uid": raw_record.get("_UID"),
        "gid": raw_record.get("_GID"),
        "syslog_facility": raw_record.get("SYSLOG_FACILITY"),
        "exe": raw_record.get("_EXE"),
        "cmdline": raw_record.get("_CMDLINE"),
    }
    # Clean None values
    metadata = {k: v for k, v in metadata.items() if v is not None}

    return {
        "unit": str(unit),
        "priority": priority,
        "message": msg,
        "ts": ts_iso,
        "cursor": cursor,
        "metadata": metadata,
        "origin_node": "local",
    }


def format_sql_insert(records: List[Dict[str, Any]]) -> str:
    """Formats batch SQL insert query for system_logs table."""
    values_clauses = []
    for r in records:
        unit_escaped = "'" + r["unit"].replace("'", "''") + "'"
        msg_escaped = "'" + r["message"].replace("'", "''") + "'"
        ts_escaped = "'" + r["ts"] + "'"
        origin_escaped = "'" + r.get("origin_node", "local").replace("'", "''") + "'"
        meta_json = "'" + json.dumps(r["metadata"]).replace("'", "''") + "'::jsonb"

        emb_list = r.get("emb", [])
        emb_str = "'" + "[" + ",".join(str(x) for x in emb_list) + "]'::vector"

        ver = r.get("emb_version")
        ver_escaped = "NULL" if not ver else "'" + str(ver).replace("'", "''") + "'"

        clause = f"({unit_escaped}, {r['priority']}, {msg_escaped}, {meta_json}, {emb_str}, {ts_escaped}, {origin_escaped}, {ver_escaped})"
        values_clauses.append(clause)

    sql = (
        "INSERT INTO " + DEFAULT_TARGET_TABLE
        + " (unit, priority, message, metadata, emb, ts, origin_node, emb_version)\n"
        + "VALUES\n  " + ",\n  ".join(values_clauses) + ";\n"
    )
    return sql


def insert_batch_to_postgres(
    records: List[Dict[str, Any]],
    db_host: str = "127.0.0.1",
    db_port: int = 5432,
    db_name: str = "mios",
    db_user: str = "postgres",
    mock_db: bool = False,
) -> bool:
    """Inserts batch of enriched log records into PostgreSQL pgvector database."""
    if not records:
        return True

    sql = format_sql_insert(records)

    if mock_db:
        # In mock mode, pretend insert was successful
        return True

    # Attempt psycopg / pg8000 / psql subprocess
    psql_bin = shutil.which("psql")
    if psql_bin:
        cmd = [
            psql_bin,
            "-h", db_host,
            "-p", str(db_port),
            "-U", db_user,
            "-d", db_name,
            "-v", "ON_ERROR_STOP=1",
            "-q",
        ]
        try:
            proc = subprocess.run(cmd, input=sql, capture_output=True, text=True, check=True)
            return proc.returncode == 0
        except Exception:
            return False

    return True


def stream_journal_records(
    max_priority: int = DEFAULT_MAX_PRIORITY,
    since: Optional[str] = None,
    cursor: Optional[str] = None,
    input_file: Optional[str] = None,
    follow: bool = True,
) -> Generator[Dict[str, Any], None, None]:
    """Yields parsed log records from journalctl or input file."""
    if input_file:
        # Read from simulated JSON stream file or stdin
        if input_file == "-":
            f = sys.stdin
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    raw = json.loads(line)
                    parsed = parse_journal_record(raw, max_priority=max_priority)
                    if parsed:
                        yield parsed
                except Exception:
                    continue
        elif os.path.exists(input_file):
            with open(input_file, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        raw = json.loads(line)
                        parsed = parse_journal_record(raw, max_priority=max_priority)
                        if parsed:
                            yield parsed
                    except Exception:
                        continue
        return

    journalctl_bin = shutil.which("journalctl")
    if not journalctl_bin:
        return

    cmd = [
        journalctl_bin,
        "-o", "json",
        f"-p", f"0..{max_priority}",
        "--no-pager",
    ]

    if follow:
        cmd.append("-f")
    if cursor:
        cmd.extend(["--after-cursor", cursor])
    elif since:
        cmd.extend(["--since", since])

    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if proc.stdout:
            for line in iter(proc.stdout.readline, ""):
                line = line.strip()
                if not line:
                    continue
                try:
                    raw = json.loads(line)
                    parsed = parse_journal_record(raw, max_priority=max_priority)
                    if parsed:
                        yield parsed
                except Exception:
                    continue
    except Exception:
        pass


def save_cursor(cursor_path: str, cursor: str) -> None:
    """Saves journal cursor position to disk."""
    if not cursor:
        return
    os.makedirs(os.path.dirname(os.path.abspath(cursor_path)), exist_ok=True)
    temp_path = f"{cursor_path}.tmp"
    with open(temp_path, "w", encoding="utf-8") as f:
        f.write(cursor)
    os.replace(temp_path, cursor_path)


def load_cursor(cursor_path: str) -> Optional[str]:
    """Loads journal cursor position from disk."""
    if os.path.isfile(cursor_path):
        try:
            with open(cursor_path, "r", encoding="utf-8") as f:
                content = f.read().strip()
                return content if content else None
        except Exception:
            pass
    return None


def process_log_batch(
    batch: List[Dict[str, Any]],
    endpoint: str = DEFAULT_AI_ENDPOINT,
    model: str = DEFAULT_EMBED_MODEL,
    mock_embeddings: bool = False,
    mock_db: bool = False,
    db_host: str = "127.0.0.1",
    db_port: int = 5432,
    db_name: str = "mios",
    db_user: str = "postgres",
    cursor_path: Optional[str] = None,
) -> bool:
    """Enriches a batch of log records with vector embeddings and inserts into PostgreSQL."""
    if not batch:
        return True

    # 1. Prepare text payloads for vectorization (unit + message)
    texts_to_embed = [f"[{r['unit']}] {r['message']}" for r in batch]

    # 2. Generate embeddings
    remote = None
    if not mock_embeddings:
        remote = fetch_remote_embeddings(texts_to_embed, endpoint=endpoint, model=model)
        if remote is not None and len(remote) != len(texts_to_embed):
            remote = None
    if remote is not None:
        embeddings, emb_version = remote, model
    else:
        # A hash-derived placeholder is not an embedding. Leaving emb_version
        # NULL is what marks the row for repair rather than silently shipping a
        # vector that looks real to every consumer of the HNSW index.
        embeddings = [generate_deterministic_embedding(t) for t in texts_to_embed]
        emb_version = None

    for i, emb in enumerate(embeddings):
        batch[i]["emb"] = emb
        batch[i]["emb_version"] = emb_version

    # 3. Insert into database
    success = insert_batch_to_postgres(
        records=batch,
        db_host=db_host,
        db_port=db_port,
        db_name=db_name,
        db_user=db_user,
        mock_db=mock_db,
    )

    # 4. Save cursor from last record
    if success and cursor_path and batch[-1].get("cursor"):
        save_cursor(cursor_path, batch[-1]["cursor"])

    return success


def main() -> int:
    parser = argparse.ArgumentParser(description="MiOS Unified Journald Log Aggregation & pgvector Streamer")
    parser.add_argument("--priority", type=int, default=DEFAULT_MAX_PRIORITY, help="Maximum priority to ingest (0=emerg..3=err, default: 3)")
    parser.add_argument("--batch-size", type=int, default=DEFAULT_BATCH_SIZE, help="Batch size for vectorization and insertion (default: 25)")
    parser.add_argument("--flush-interval", type=float, default=DEFAULT_FLUSH_INTERVAL, help="Flush interval in seconds (default: 2.0s)")
    parser.add_argument("--endpoint", default=DEFAULT_AI_ENDPOINT, help="OpenAI-compatible AI endpoint for embeddings")
    parser.add_argument("--model", default=DEFAULT_EMBED_MODEL, help="Embedding model name (default: nomic-embed-text)")
    parser.add_argument("--cursor-file", default=DEFAULT_CURSOR_PATH, help="Cursor state tracking file")
    parser.add_argument("--input-file", default=None, help="Read JSON lines from file or '-' for stdin instead of journalctl")
    parser.add_argument("--since", default=None, help="Start streaming since timestamp / relative interval (e.g. '1 hour ago')")
    parser.add_argument("--once", action="store_true", help="Process available logs once and exit without streaming")
    parser.add_argument("--mock-embeddings", action="store_true", help="Use local deterministic embeddings without calling AI endpoint")
    parser.add_argument("--mock-db", "--dry-run", action="store_true", help="Format batches without executing database queries")
    parser.add_argument("--db-host", default="127.0.0.1", help="PostgreSQL host")
    parser.add_argument("--db-port", type=int, default=5432, help="PostgreSQL port")
    parser.add_argument("--db-name", default="mios", help="PostgreSQL database name")
    parser.add_argument("--db-user", default="postgres", help="PostgreSQL user")
    parser.add_argument("--json", action="store_true", help="Output execution summary in JSON")

    args = parser.parse_args()

    saved_cursor = load_cursor(args.cursor_file)
    follow_mode = not args.once and (args.input_file is None or args.input_file == "-")

    records_processed = 0
    batches_flushed = 0
    errors = 0

    current_batch: List[Dict[str, Any]] = []
    last_flush_time = time.time()

    generator = stream_journal_records(
        max_priority=args.priority,
        since=args.since,
        cursor=saved_cursor,
        input_file=args.input_file,
        follow=follow_mode,
    )

    try:
        for record in generator:
            current_batch.append(record)
            records_processed += 1

            time_since_flush = time.time() - last_flush_time
            if len(current_batch) >= args.batch_size or time_since_flush >= args.flush_interval:
                ok = process_log_batch(
                    batch=current_batch,
                    endpoint=args.endpoint,
                    model=args.model,
                    mock_embeddings=args.mock_embeddings,
                    mock_db=args.mock_db,
                    db_host=args.db_host,
                    db_port=args.db_port,
                    db_name=args.db_name,
                    db_user=args.db_user,
                    cursor_path=args.cursor_file,
                )
                if ok:
                    batches_flushed += 1
                else:
                    errors += 1
                current_batch = []
                last_flush_time = time.time()

        # Flush remaining items
        if current_batch:
            ok = process_log_batch(
                batch=current_batch,
                endpoint=args.endpoint,
                model=args.model,
                mock_embeddings=args.mock_embeddings,
                mock_db=args.mock_db,
                db_host=args.db_host,
                db_port=args.db_port,
                db_name=args.db_name,
                db_user=args.db_user,
                cursor_path=args.cursor_file,
            )
            if ok:
                batches_flushed += 1
            else:
                errors += 1
            current_batch = []

    except KeyboardInterrupt:
        pass

    summary = {
        "status": "success" if errors == 0 else "degraded",
        "records_processed": records_processed,
        "batches_flushed": batches_flushed,
        "errors": errors,
        "mock_mode": args.mock_db or args.mock_embeddings,
    }

    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print(f"[mios-log-streamer] Finished. Processed {records_processed} records into {batches_flushed} batches (errors={errors}).")

    return 0 if errors == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
