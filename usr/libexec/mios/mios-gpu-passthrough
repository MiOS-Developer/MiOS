#!/bin/bash
# AI-hint: Syncs Quadlet configs with live CDI specs in /run/cdi/, mapping the GPU vendors declared in mios.toml [gpu.cdi] onto the background AI service Quadlets (mios-llm-light, the vLLM/SGLang heavy lane) per detected hardware; no vendor literal.
# AI-related: /usr/libexec/mios/mios-gpu-passthrough, /usr/libexec/mios/mios-toml-get, /usr/share/mios/mios.toml, /etc/mios/gpu-passthrough.conf, /etc/mios/gpu-passthrough.conf., mios-cdi-detect, mios-daemon, mios-igpu, mios-open-webui, mios-mycustom, mios-doctor, mios-system-status
# AI-functions: log, read_gpu_matrix, build_dropin

set -uo pipefail

CDI_DIR="${MIOS_CDI_DIR:-/run/cdi}"
SD_DIR="${MIOS_QUADLET_DIR:-/etc/containers/systemd}"
CONF_FILE="${MIOS_GPU_PASSTHROUGH_CONF:-/etc/mios/gpu-passthrough.conf}"
DROPIN_NAME="20-mios-igpu.conf"
RESTART_ON_CHANGE="${MIOS_GPU_RESTART_ON_CHANGE:-0}"

MIOS_AI_QUADLETS_DEFAULT=(
    "mios-open-webui"
    "mios-llm-light"
    "mios-llm-worker@"
    "mios-llm-heavy"
)

if [ -r "$CONF_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONF_FILE"
fi
MIOS_AI_QUADLETS=("${MIOS_AI_QUADLETS[@]:-${MIOS_AI_QUADLETS_DEFAULT[@]}}")

log() { logger -t mios-gpu-passthrough "$*" 2>/dev/null || true; echo "[gpu-passthrough] $*" >&2; }

_MIOS_TOML_GET="${_MIOS_TOML_GET:-$(cd "$(dirname "$0")" && pwd)/mios-toml-get}"

# The vendor matrix is SSOT, never a literal here (Law 7). [gpu.cdi.<vendor>]
# gives each vendor its AddDevice= value and the CDI spec filenames whose
# presence in CDI_DIR proves it is live; [gpu.vendors] switches one off without
# deleting its wiring. Emits one TAB-separated `vendor<TAB>device<TAB>specs`
# row per enabled vendor, in SSOT-name order.
read_gpu_matrix() {
    local cdi_json vendors_json
    cdi_json="$("$_MIOS_TOML_GET" --section 'gpu.cdi' 2>/dev/null)" || cdi_json=""
    vendors_json="$("$_MIOS_TOML_GET" --section 'gpu.vendors' 2>/dev/null)" || vendors_json=""
    python3 -c '
import json, sys

def _obj(raw):
    try:
        val = json.loads(raw) if raw.strip() else {}
    except Exception:
        return {}
    return val if isinstance(val, dict) else {}

def _off(val):
    if isinstance(val, bool):
        return not val
    if isinstance(val, str):
        return val.strip().lower() in ("false", "0", "no", "off")
    if isinstance(val, (int, float)):
        return val == 0
    return False

cdi = _obj(sys.argv[1])
vendors = _obj(sys.argv[2])
for vendor in sorted(cdi):
    entry = cdi[vendor]
    if not isinstance(entry, dict):
        continue
    if _off(vendors.get(vendor, True)):
        continue
    device = str(entry.get("device") or "").strip()
    specs = [str(s).strip() for s in (entry.get("specs") or []) if str(s).strip()]
    if not device or not specs:
        continue
    print("\t".join((vendor, device, " ".join(specs))))
' "$cdi_json" "$vendors_json" 2>/dev/null
}

GPU_VENDORS=()
GPU_DEVICES=()
GPU_PRESENT=()

while IFS=$'\t' read -r _vendor _device _specs; do
    [ -n "$_vendor" ] && [ -n "$_device" ] || continue
    _files=()
    read -r -a _files <<<"$_specs"
    _present=0
    if [ "${#_files[@]}" -gt 0 ]; then
        for _spec in "${_files[@]}"; do
            if [ -f "${CDI_DIR}/${_spec}" ]; then
                _present=1
                break
            fi
        done
    fi
    GPU_VENDORS+=("$_vendor")
    GPU_DEVICES+=("$_device")
    GPU_PRESENT+=("$_present")
done < <(read_gpu_matrix)

# Degrade safe, not open: an empty matrix means the SSOT read failed, and
# rewriting every drop-in from it would silently strip GPU access from lanes
# that had it. Leave the existing wiring alone and say why.
if [ "${#GPU_VENDORS[@]}" -eq 0 ]; then
    log "mios.toml [gpu.cdi] yielded no enabled vendor wiring via $_MIOS_TOML_GET"
    log "refusing to rewrite Quadlet drop-ins from an empty matrix; existing GPU wiring left intact"
    exit 3
fi

_summary=""
for _i in "${!GPU_VENDORS[@]}"; do
    _summary="${_summary}${_summary:+ }${GPU_VENDORS[$_i]}=${GPU_PRESENT[$_i]}"
done
log "CDI present: $_summary"

install -d -m 0755 /run/mios
{
    printf '{\n'
    printf '  "ts": "%s",\n' "$(date -Is)"
    for _i in "${!GPU_VENDORS[@]}"; do
        printf '  "%s": %s,\n' "${GPU_VENDORS[$_i]}" "${GPU_PRESENT[$_i]}"
    done
    printf '  "quadlets": [%s]\n' "$(printf '"%s",' "${MIOS_AI_QUADLETS[@]}" | sed 's/,$//')"
    printf '}\n'
} > /run/mios/gpu-passthrough.status


build_dropin() {
    local quadlet="$1"
    local i
    cat <<EOF

[Container]
AddDevice=
EOF
    for i in "${!GPU_VENDORS[@]}"; do
        if [ "${GPU_PRESENT[$i]}" = "1" ]; then
            echo "AddDevice=${GPU_DEVICES[$i]}"
        fi
    done
}


changed_quadlets=()
for quadlet in "${MIOS_AI_QUADLETS[@]}"; do
    dropin_parent="${SD_DIR}/${quadlet}.container.d"
    dropin_file="${dropin_parent}/${DROPIN_NAME}"

    install -d -m 0755 "$dropin_parent" || {
        log "$quadlet: cannot create $dropin_parent"; exit 2;
    }

    new_content=$(build_dropin "$quadlet")
    if [ -f "$dropin_file" ] && \
       [ "$(cat "$dropin_file" 2>/dev/null)" = "$new_content" ]; then
        log "$quadlet: drop-in already current"
        continue
    fi
    printf '%s\n' "$new_content" > "$dropin_file"
    chmod 0644 "$dropin_file"
    log "$quadlet: wrote $dropin_file"
    changed_quadlets+=("$quadlet")
done


if [ "${#changed_quadlets[@]}" -gt 0 ]; then
    if ! systemctl daemon-reload; then
        log "Systemctl daemon-reload failed"
        exit 1
    fi
    log "Reloaded systemd"

    if [ "$RESTART_ON_CHANGE" = "1" ]; then
        for q in "${changed_quadlets[@]}"; do
            svc="${q}.service"
            if systemctl is-active --quiet "$svc"; then
                log "Restarting $svc to pick up new device wiring"
                systemctl restart "$svc" || \
                    log "$svc restart failed"
            fi
        done
    fi
else
    log "No Quadlets needed reconciliation"
fi

exit 0
