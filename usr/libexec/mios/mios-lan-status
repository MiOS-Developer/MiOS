#!/bin/bash
# AI-hint: Checks and configures Windows-side port forwarding for MiOS services (e.g., Open WebUI, mios-llm-light) to ensure LAN/Wi-Fi accessibility from the host machine via a PowerShell helper script.
# AI-related: /usr/libexec/mios/mios-lan-status, /usr/libexec/mios/Setup-MiOSLanPortProxy.ps1, mios-windows
# AI-functions: windows_ip

set -uo pipefail

ACTION="${1:-status}"
SETUP_PS1="${MIOS_LAN_SETUP_PS1:-/usr/libexec/mios/Setup-MiOSLanPortProxy.ps1}"

# Resolve [firewall.windows].expose (MIOS_FIREWALL_WINDOWS_EXPOSE) and each
# [ports].<key> (MIOS_PORTS_<KEY^^>) from the environment or install.env;
# SearXNG is not forwarded (loopback-only listener on [ports].searxng /
# MIOS_PORTS_SEARXNG), so it is always listed as LAN-unsupported.
_install_env="${MIOS_PATHS_INSTALL_ENV:-/etc/mios/install.env}"
_read_install_env() {
    local var_name="$1"
    [ -r "$_install_env" ] || return 0
    (
        set +u
        set -a
        # shellcheck source=/dev/null
        . "$_install_env" >/dev/null 2>&1
        printf '%s' "${!var_name:-}"
    )
}

if [ -z "${MIOS_FIREWALL_WINDOWS_EXPOSE:-}" ]; then
    MIOS_FIREWALL_WINDOWS_EXPOSE="$(_read_install_env MIOS_FIREWALL_WINDOWS_EXPOSE)"
fi
if [ -z "${MIOS_PORTS_SEARXNG:-}" ]; then
    MIOS_PORTS_SEARXNG="$(_read_install_env MIOS_PORTS_SEARXNG)"
fi

SERVICES=()
if [ -n "${MIOS_FIREWALL_WINDOWS_EXPOSE:-}" ]; then
    IFS=',' read -r -a _expose_keys <<< "${MIOS_FIREWALL_WINDOWS_EXPOSE}"
    for _raw_key in "${_expose_keys[@]}"; do
        _key="${_raw_key#"${_raw_key%%[![:space:]]*}"}"
        _key="${_key%"${_key##*[![:space:]]}"}"
        [ -n "$_key" ] || continue
        if [ "$_key" = "searxng" ]; then
            continue
        fi
        _var="MIOS_PORTS_${_key^^}"
        _port="${!_var:-}"
        if [ -z "$_port" ]; then
            _port="$(_read_install_env "$_var")"
        fi
        if [[ "$_port" =~ ^[1-9][0-9]{0,4}$ ]] && (( _port <= 65535 )); then
            SERVICES+=("$_port $_key")
        else
            echo "mios-lan-status: mios.toml [ports].${_key} does not resolve (${_var} is unset in the environment and install.env); ${_key} omitted" >&2
        fi
    done
else
    echo "mios-lan-status: mios.toml [firewall.windows].expose does not resolve (MIOS_FIREWALL_WINDOWS_EXPOSE is unset in the environment and install.env)" >&2
fi

windows_ip() {
    local ip
    ip=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+')
    [ -n "$ip" ] && echo "$ip" && return
    hostname -I 2>/dev/null | awk '{print $1}'
}

WSL_IP=$(windows_ip)
echo "WSL bridge IP: ${WSL_IP:-<unknown>}"
echo

echo "── listening on WSL side ──"
local_count=0
listening=()
for entry in "${SERVICES[@]}"; do
    port="${entry%% *}"
    name="${entry#* }"
    if ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}\$"; then
        printf "  OK   :%-5s  %s\n" "$port" "$name"
        listening+=("$port|$name")
        local_count=$((local_count + 1))
    else
        printf "  DOWN :%-5s  %s\n" "$port" "$name"
    fi
done

_searxng_port="${MIOS_PORTS_SEARXNG:-}"
if [[ "$_searxng_port" =~ ^[1-9][0-9]{0,4}$ ]] && (( _searxng_port <= 65535 )); then
    echo "  --   :${_searxng_port}  searxng: loopback-only listener (mios.toml [ports].searxng); direct LAN forwarding is unsupported"
else
    echo "mios-lan-status: mios.toml [ports].searxng does not resolve (MIOS_PORTS_SEARXNG is unset in the environment and install.env); searxng omitted" >&2
fi

if [ "$local_count" -eq 0 ]; then
    echo
    echo "No MiOS service ports listening yet. Bring services up first"
    exit 2
fi

echo
echo "── enable LAN access ──"
if [ -r "$SETUP_PS1" ]; then
    WIN_PS1=$(printf '\\\\wsl.localhost\\%s%s\n' \
        "$(printf '%s' "${WSL_DISTRO_NAME:-podman-MiOS-DEV}")" \
        "${SETUP_PS1//\//\\}")
    echo "  Open Windows Terminal as Administrator) and paste:"
    echo
    echo "  pwsh -NoProfile -ExecutionPolicy Bypass -File \"$WIN_PS1\""
    echo
    echo "  (the helper applies mios.toml [firewall.windows] as build-mios.ps1 Phase 4 does, never searxng;"
    echo "  one-shot, idempotent, self-elevates if the operator forgot Admin)"
else
    echo "  Setup-MiOSLanPortProxy.ps1 not present at $SETUP_PS1"
fi

if [ "$ACTION" = "--enable" ]; then
    echo
    echo "──"
    if command -v mios-windows >/dev/null 2>&1 && [ -r "$SETUP_PS1" ]; then
        WIN_PATH=$(printf '\\\\\\\\wsl.localhost\\\\%s%s' \
            "${WSL_DISTRO_NAME:-podman-MiOS-DEV}" \
            "${SETUP_PS1//\//\\\\}")
        mios-windows ps "Start-Process pwsh.exe -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','$WIN_PATH' -Verb RunAs" 2>&1
        echo
        echo "  (Triggered UAC on the operator's screen; they must Approve"
        echo "  Re-run 'mios-lan-status' after to verify portproxies landed.)"
    else
        echo "  mios-windows not on PATH, or PS1 not readable"
        exit 1
    fi
fi

echo
echo "Once enabled, reach from other LAN devices at:"
WIN_LAN_HINT="<your-windows-LAN-ip>"
for entry in "${listening[@]}"; do
    port="${entry%%|*}"
    name="${entry##*|}"
    printf "  http://%s:%s/   (%s)\n" "$WIN_LAN_HINT" "$port" "$name"
done
echo
echo ""

exit 0
