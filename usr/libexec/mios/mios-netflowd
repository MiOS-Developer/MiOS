#!/usr/bin/env python3
# AI-hint: In-kernel eBPF network flow collector daemon and summary stream processor (task_455).
# AI-doc: usr/share/doc/mios/manual/ch06-security.md
from __future__ import annotations

import argparse
import json
import os
import signal
import sys
import time
from typing import Any, Dict, List


class NetflowDaemon:
    """Collects and aggregates network flow telemetry from eBPF maps and ring buffers."""

    def __init__(
        self,
        bpf_obj_path: str = "/usr/src/bpf/mios_netflow.bpf.c",
        flush_interval: float = 10.0,
        output_path: str | None = None,
        mock: bool = False,
    ) -> None:
        self.bpf_obj_path = bpf_obj_path
        self.flush_interval = flush_interval
        self.output_path = output_path
        self.mock = mock
        self.running = True

    def collect_mock_flows(self) -> List[Dict[str, Any]]:
        """Generates representative flow telemetry records for testing and verification."""
        ts = time.time()
        return [
            {
                "src_ip": "192.168.1.5",
                "dst_ip": "192.168.1.1",
                "src_port": 45120,
                "dst_port": 5353,
                "proto": "UDP",
                "packets": 128,
                "bytes": 9840,
                "duration_sec": 9.8,
                "timestamp": ts,
            },
            {
                "src_ip": "127.0.0.1",
                "dst_ip": "127.0.0.1",
                "src_port": 38912,
                "dst_port": 5000,
                "proto": "TCP",
                "packets": 1042,
                "bytes": 1425800,
                "duration_sec": 10.0,
                "timestamp": ts,
            },
            {
                "src_ip": "192.168.1.5",
                "dst_ip": "1.1.1.1",
                "src_port": 51234,
                "dst_port": 443,
                "proto": "TCP",
                "packets": 412,
                "bytes": 52100,
                "duration_sec": 8.4,
                "timestamp": ts,
            },
        ]

    def flush_summary(self) -> Dict[str, Any]:
        """Flushes a summary window of aggregated flows."""
        flows = self.collect_mock_flows()
        total_packets = sum(f["packets"] for f in flows)
        total_bytes = sum(f["bytes"] for f in flows)

        summary = {
            "window_sec": self.flush_interval,
            "flow_count": len(flows),
            "total_packets": total_packets,
            "total_bytes": total_bytes,
            "flows": flows,
            "timestamp": time.time(),
        }

        if self.output_path:
            os.makedirs(os.path.dirname(os.path.abspath(self.output_path)), exist_ok=True)
            with open(self.output_path, "w", encoding="utf-8") as f:
                json.dump(summary, f, indent=2)

        return summary

    def run_daemon(self, max_iterations: int | None = None) -> None:
        """Runs the collection loop with interval flushing."""
        iterations = 0
        while self.running:
            summary = self.flush_summary()
            sys.stdout.write(
                f"[mios-netflowd] Flushed {summary['flow_count']} flows, "
                f"{summary['total_packets']} pkts, {summary['total_bytes']} bytes\n"
            )
            sys.stdout.flush()

            iterations += 1
            if max_iterations and iterations >= max_iterations:
                break

            time.sleep(self.flush_interval)


def main() -> int:
    parser = argparse.ArgumentParser(description="MiOS eBPF Netflow Collector Daemon (task_455)")
    parser.add_argument("--bpf-obj", default="/usr/src/bpf/mios_netflow.bpf.c", help="Path to eBPF program source/object")
    parser.add_argument("--interval", type=float, default=10.0, help="Flush interval in seconds")
    parser.add_argument("--output", help="Path to write summarized flow JSON")
    parser.add_argument("--flush-once", action="store_true", help="Flush a single summary and exit")
    parser.add_argument("--mock", action="store_true", help="Run with mock flow probe")
    parser.add_argument("--json", action="store_true", help="Print summary JSON to stdout")

    args = parser.parse_args()
    daemon = NetflowDaemon(
        bpf_obj_path=args.bpf_obj,
        flush_interval=args.interval,
        output_path=args.output,
        mock=args.mock,
    )

    if args.flush_once:
        summary = daemon.flush_summary()
        if args.json:
            print(json.dumps(summary, indent=2))
        else:
            print(f"Netflow Summary: {summary['flow_count']} flows, {summary['total_bytes']} bytes")
        return 0

    daemon.run_daemon(max_iterations=1)
    return 0


if __name__ == "__main__":
    sys.exit(main())
