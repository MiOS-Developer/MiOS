#!/usr/bin/env bash
# AI-hint: Writes /etc/chrony.d/10-ptp.conf with a PHC refclock only when a /sys/class/ptp/ptpN clock_name is "hyperv" (WSL2 / Hyper-V guest), naming that /dev/ptpN; otherwise removes the drop-in it owns.
# AI-related: /etc/chrony.d/10-ptp.conf, mios-chrony-ptp.service, etc/chrony.conf, /sys/class/ptp
set -euo pipefail

# /dev/ptp0 alone says nothing about the platform: on WSL2 / Hyper-V it is the
# host-synchronised Hyper-V clock, on bare metal it is usually a NIC's
# free-running PHC (e.g. "atlantic ptp") that nothing disciplines. Only the
# Hyper-V clock is a trustworthy chrony reference without ptp4l/phc2sys, so the
# kernel's clock_name decides. The roots are overridable for fixture tests.
CHRONY_D="${CHRONY_D:-/etc/chrony.d}"
PTP_SYSFS_DIR="${PTP_SYSFS_DIR:-/sys/class/ptp}"
PTP_DEV_DIR="${PTP_DEV_DIR:-/dev}"

DROPIN_FILE="${CHRONY_D}/10-ptp.conf"
OWNER_MARK="# Generated by mios-chrony-ptp-dropin; rewritten or removed at boot."
# The pre-marker helper wrote exactly this line; a drop-in holding only it is ours too.
LEGACY_BODY="refclock PHC /dev/ptp0 poll 3 dpoll -2 offset 0 minsamples 4 prefer trust"

hyperv_dev=""
shopt -s nullglob
for clock in "$PTP_SYSFS_DIR"/ptp*; do
    [[ -r "${clock}/clock_name" ]] || continue
    name="$(< "${clock}/clock_name")"
    [[ "$name" == "hyperv" ]] || continue
    dev="${PTP_DEV_DIR}/${clock##*/}"
    # chronyd treats an unopenable refclock as fatal, so name only a present node.
    [[ -e "$dev" ]] || continue
    hyperv_dev="$dev"
    break
done
shopt -u nullglob

owned() {
    [[ -f "$DROPIN_FILE" ]] || return 1
    local first
    first="$(head -n 1 "$DROPIN_FILE")"
    [[ "$first" == "$OWNER_MARK" ]] && return 0
    [[ "$(< "$DROPIN_FILE")" == "$LEGACY_BODY" ]]
}

if [[ -z "$hyperv_dev" ]]; then
    if owned; then
        rm -f "$DROPIN_FILE"
    fi
    exit 0
fi

mkdir -p "$CHRONY_D"
TMP_FILE="${DROPIN_FILE}.tmp"

printf '%s\nrefclock PHC %s poll 3 dpoll -2 offset 0 minsamples 4 prefer trust\n' \
    "$OWNER_MARK" "$hyperv_dev" > "$TMP_FILE"

if [[ -f "$DROPIN_FILE" ]] && cmp -s "$DROPIN_FILE" "$TMP_FILE"; then
    rm -f "$TMP_FILE"
    exit 0
fi

if [[ -f "$DROPIN_FILE" ]] && ! owned; then
    rm -f "$TMP_FILE"
    echo "mios-chrony-ptp-dropin: ${DROPIN_FILE} is not ours; leaving it in place" >&2
    exit 0
fi

chmod 0644 "$TMP_FILE"
mv "$TMP_FILE" "$DROPIN_FILE"
