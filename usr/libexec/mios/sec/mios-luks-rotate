# AI-hint: Automated zero-downtime LUKS2 and dm-crypt encryption key rotation for Ceph OSDs and secure partitions.
# AI-related: usr/lib/systemd/system/mios-luks-rotate.service, usr/lib/systemd/system/mios-luks-rotate.timer, tests/test-sec.py, usr/share/mios/mios.toml
# AI-functions: LUKSDevice, LUKSRotationEngine, main
"""
MiOS LUKS2 / dm-crypt Automated Key Rotation Engine.
Provides zero-downtime in-place key rotation for Ceph OSDs and encrypted partitions:
adds new keyslot, validates unlocking, tests decryption, and safely kills old slot.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import secrets
import stat
import subprocess
import sys
from typing import Any, Callable, Dict, List, Optional, Tuple

# Layered TOML support
_LIB_PATH = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios"))
if os.path.isdir(_LIB_PATH) and _LIB_PATH not in sys.path:
    sys.path.insert(0, _LIB_PATH)

