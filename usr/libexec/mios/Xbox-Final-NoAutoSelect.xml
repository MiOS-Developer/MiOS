    <!-- Looking Glass: SPICE on the fixed [vm.looking_glass] spice_listen:spice_port the client connects to (setup-looking-glass.py). -->
    <graphics type="spice" port="5930" autoport="no" listen="127.0.0.1">
      <listen type="address" address="127.0.0.1"/>
      <image compression="off"/>
    </graphics>
    <!-- Native VNC console on the emulated display (virt-manager, Cockpit); SPICE above is for Looking Glass. Rendering with setup-looking-glass.py adds passwd from the root-only [vm.looking_glass].vnc_passwd_file. -->
