#!/bin/bash
# AI-hint: Builds the ttyd argv for the bash or powershell web terminal from MIOS_TTYD_* and mios.toml, then execs it through mios-credential exec ttyd, which adds ttyd's own login from the credstore root writes.
# AI-related: /usr/libexec/mios/mios-ttyd-launch, /etc/mios/userenv.sh, /usr/libexec/mios/mios-powershell, /usr/libexec/mios/mios-credential, /usr/libexec/mios/mios-toml-get, /etc/mios/mios.toml, /usr/share/mios/mios.toml, mios-powershell
set -euo pipefail
if [[ -r /etc/mios/userenv.sh ]]; then source /etc/mios/userenv.sh; fi
if [[ -r /etc/mios/install.env ]]; then
    _mios_had_u=0; case "$-" in *u*) _mios_had_u=1;; esac
    set +u; set -a; source /etc/mios/install.env 2>/dev/null || true; set +a
    [ "$_mios_had_u" = 1 ] && set -u
fi
set -eu
# Sibling tools resolve beside this script (/usr/libexec/mios on a host, the tree in a checkout).
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

VARIANT="${1:-bash}"
case "$VARIANT" in
    bash|powershell) ;;
    *)
        echo "Mios-ttyd-launch: variant must be bash|powershell" >&2
        exit 2
        ;;
esac

if [[ "$VARIANT" == "bash" ]]; then
    PORT="${MIOS_PORTS_TTYD_BASH:-8310}"
    SHELL_CMD="${MIOS_TTYD_BASH_SHELL:-/bin/bash}"
else
    PORT="${MIOS_PORTS_TTYD_POWERSHELL:-8320}"
    SHELL_CMD="${MIOS_TTYD_POWERSHELL_SHELL:-/usr/libexec/mios/mios-powershell --shell}"
fi

BIND="${MIOS_TTYD_BIND:-127.0.0.1}"
SSL_CERT="${MIOS_TTYD_SSL_CERT:-}"
SSL_KEY="${MIOS_TTYD_SSL_KEY:-}"
WRITABLE="${MIOS_TTYD_WRITABLE:-true}"
MAX_CLIENTS="${MIOS_TTYD_MAX_CLIENTS:-0}"

# The login is always on: mios-credential exec ttyd adds -c from the credstore
# mios-credential-apply.service writes ($CREDENTIALS_DIRECTORY, the unit's
# ImportCredential=) and refuses to start (exit 3) without one -- no literal login.
# It is ttyd's OWN login, never the operator credential (-c is visible in /proc).
ARGS=("-p" "$PORT" "-i" "$BIND")
if [[ "${WRITABLE,,}" == "true" || "$WRITABLE" == "1" ]]; then
    ARGS+=("-W")
fi
if [[ "$MAX_CLIENTS" -gt 0 ]]; then
    ARGS+=("-m" "$MAX_CLIENTS")
fi
if [[ -n "$SSL_CERT" && -n "$SSL_KEY" ]] \
        && [[ -f "$SSL_CERT" && -f "$SSL_KEY" ]]; then
    ARGS+=("-S" "-C" "$SSL_CERT" "-K" "$SSL_KEY")
fi

ARGS+=("-T" "xterm-256color")
ARGS+=("-t" "titleFixed=MiOS ttyd [$VARIANT @ $BIND:$PORT]")
ARGS+=("-t" "fontSize=${MIOS_TTYD_FONT_SIZE:-14}")
TTYD_PAGE="${MIOS_TTYD_PAGE_PATH:-$("$_here/mios-toml-get" ttyd page_path 2>/dev/null || true)}"
if [[ -n "${MIOS_TTYD_PAGE_PATH:-}" && ! -r "$TTYD_PAGE" ]]; then
    echo "Mios-ttyd-launch: explicit page is not readable" >&2
    exit 2
fi
if [[ -n "$TTYD_PAGE" && -r "$TTYD_PAGE" ]]; then ARGS+=("-I" "$TTYD_PAGE"); fi  # baked by automation/41-services.sh

read -r -a SHELL_ARGV <<< "$SHELL_CMD"

exec "$_here/mios-credential" exec ttyd -- "${ARGS[@]}" "${SHELL_ARGV[@]}"
