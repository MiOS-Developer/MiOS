#!/bin/bash
# AI-hint: Wipes all non-persistent AI state (chat history, kanban, memory, and browser profiles) while preserving core configs and models to provide a clean slate for testing or new sessions.
# AI-related: /usr/libexec/mios/mios-ai-reset, mios-hermes-browser, mios-open-webui, mios-log-watcher, mios-cron-director, mios-hermes, mios-agent, hermes-agent.service, mios-open-webui.service, mios-log-watcher.service
# AI-functions: _check_safe, _do
set -euo pipefail

DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

DENY_ROOTS=(
    /              # never
    /mnt           # Windows mounts via DrvFs
    /mnt/c         # explicit -- the incident target
    /mnt/c/MiOS    # explicit -- the source checkout
    /usr           # vendor read-only
    /etc           # operator config
    /home          # operator home tree
    /var/home      # bootc-style operator home
    /root          # root's home (we wipe .hermes/* INSIDE it, not the home itself)
)
_check_safe() {
    local p="$1"
    case "$p" in
        /mnt|/mnt/*|/usr|/usr/*|/etc|/etc/*)
            echo "Mios-ai-reset: REFUSING to touch $p" >&2
            exit 99 ;;
    esac
    for root in "${DENY_ROOTS[@]}"; do
        if [ "$p" = "$root" ] || [ "$p" = "/" ]; then
            echo "Mios-ai-reset: REFUSING to touch $p" >&2
            exit 99
        fi
    done
}

_do() {
    if [ "$DRY_RUN" = 1 ]; then
        printf "  [dry-run] %s\n" "$*"
    else
        "$@"
    fi
}

if [ "$(id -u)" -ne 0 ]; then
    if ! sudo -n true 2>/dev/null; then
        echo "Mios-ai-reset: need root" >&2
        exit 1
    fi
    exec sudo "$0" "$@"
fi

echo "════════════════════════════════════════════════════════════════"
if [ "$DRY_RUN" = 1 ]; then
    echo "  mios-ai-reset"
else
    echo "  mios-ai-reset"
fi
echo "════════════════════════════════════════════════════════════════"

echo
echo "── stop services ──"
_do systemctl stop hermes-agent.service mios-open-webui.service \
    mios-log-watcher.service mios-cron-director.service \
    mios-hermes-browser.service 2>/dev/null || true
[ "$DRY_RUN" = 0 ] && sleep 2

echo
echo "── /var/lib/mios/hermes wipe ──"
H=/var/lib/mios/hermes
_check_safe "$H"
[ -n "$H" ] || { echo "Mios-ai-reset: H empty" >&2; exit 99; }
for f in state.db state.db-shm state.db-wal \
         kanban.db kanban.db-shm kanban.db-wal \
         response_store.db response_store.db-shm response_store.db-wal \
         channel_directory.json gateway_state.json \
         .skills_prompt_snapshot.json; do
    [ -e "$H/$f" ] || continue
    _do rm -f "$H/$f"
done
for d in sessions logs memories; do
    [ -d "$H/$d" ] || continue
    _do rm -rf "$H/$d"
    _do install -d -o mios-hermes -g mios-hermes -m 0700 "$H/$d"
done

echo
echo "── operator-side Hermes CLI ──"
for d in /var/home/mios/.hermes /home/mios/.hermes /root/.hermes; do
    [ -d "$d" ] || continue
    _check_safe "$d"
    [ -n "$d" ] || continue
    case "$d" in */.hermes) ;; *) continue ;; esac
    _do find "$d" -maxdepth 1 \( -name 'state.db*' -o -name 'kanban.db*' -o -name 'response_store.db*' -o -name 'channel_directory.json' -o -name 'gateway_state.json' -o -name '.skills_prompt_snapshot.json' \) -delete 2>/dev/null || true
    for sub in sessions logs memories; do
        [ -d "$d/$sub" ] && _do find "$d/$sub" -mindepth 1 -delete 2>/dev/null || true
    done
    echo "  $d"
done

echo
echo "── OWUI chats ──"
DB=/var/lib/mios/open-webui/webui.db
if [ -f "$DB" ]; then
    if [ "$DRY_RUN" = 1 ]; then
        echo "  [dry-run] would clear: chat,chatidtag,tag,message,memory,feedback,file,folder"
    else
        python3 - "$DB" <<'PYEOF'
import sqlite3, sys
sys.path.insert(0, "/usr/lib/mios")
try:
    from mios_db_config import safe_ident
except ImportError:
    import re
    _IDENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
    def safe_ident(ident, allowlist):
        if not isinstance(ident, str) or not _IDENT_RE.match(ident):
            raise ValueError(f"Invalid SQL identifier format: {ident!r}")
        if ident not in allowlist:
            raise ValueError(f"SQL identifier {ident!r} not in schema allowlist")
        return ident

p = sys.argv[1]
c = sqlite3.connect(p); cur = c.cursor()
cur.execute("SELECT name FROM sqlite_master WHERE type='table'")
tables = sorted(r[0] for r in cur.fetchall())
CLEAR_ALLOWLIST = frozenset((
    'chat','chats','message','messages','chatidtag','tag','tags',
    'memory','feedback','file','files','folder','folders',
))
to_clear = [t for t in tables if t in CLEAR_ALLOWLIST]
keep = [t for t in tables if t in (
    'user','users','auth','config','model','models',
    'function','functions','tool','tools','prompt','prompts',
    'group','groups',
)]
print(f"  OWUI: clearing {to_clear}; keeping {keep}")
for t in to_clear:
    try:
        safe_t = safe_ident(t, CLEAR_ALLOWLIST)
        n = cur.execute(f'SELECT COUNT(*) FROM "{safe_t}"').fetchone()[0]
        cur.execute(f'DELETE FROM "{safe_t}"')
        if n: print(f"    cleared {safe_t} ({n} rows)")
    except Exception as e:
        print(f"    skip {t}: {e}")
c.commit(); cur.execute('VACUUM'); c.commit(); c.close()
PYEOF
    fi
else
    echo ""
fi

echo
echo "── observability state ──"
_do find /var/lib/mios/log-watcher -name '*.jsonl' -o -name '*.json' -delete 2>/dev/null || true
_do find /var/lib/mios/cron-director -name '*.json' -delete 2>/dev/null || true
echo "  log-watcher + cron-director cleared"

echo
echo "── /tmp AI temp ──"
_do find /tmp -maxdepth 1 -name 'agent-debug*.jsonl' -delete 2>/dev/null || true
_do find /tmp -maxdepth 1 \( -name 'hermes-*' -o -name 'mios-agent-*' -o -name 'owui-*' -o -name '.hermes*' \) -exec rm -rf {} + 2>/dev/null || true

echo
echo "── browser sidecar profile ──"
for d in /var/lib/mios/hermes-browser /run/mios-hermes-browser; do
    [ -d "$d" ] || continue
    _check_safe "$d"
    [ -n "$d" ] || continue
    case "$d" in */hermes-browser|*/mios-hermes-browser) ;; *) continue ;; esac
    _do find "$d" -mindepth 1 -delete 2>/dev/null || true
    echo "  $d"
done

echo
echo "── opencode subagent caches ──"
for base in /var/lib/mios/hermes /var/home/mios /home/mios; do
    _do rm -rf "$base/.local/share/opencode" "$base/.cache/opencode"
done

if [ "$DRY_RUN" = 0 ]; then
    echo
    echo "── restart services ──"
    systemctl reset-failed hermes-agent.service 2>/dev/null
    systemctl start hermes-agent.service mios-open-webui.service \
        mios-log-watcher.service mios-cron-director.service \
        mios-hermes-browser.service 2>&1
    sleep 8

    echo
    echo "── final state ──"
    for s in hermes-agent mios-open-webui mios-log-watcher mios-cron-director mios-hermes-browser; do
        state=$(systemctl is-active "$s.service" 2>&1)
        printf "  %-26s %s\n" "$s.service" "$state"
    done
fi

echo
echo "════════════════════════════════════════════════════════════════"
echo "  done"
echo "════════════════════════════════════════════════════════════════"
