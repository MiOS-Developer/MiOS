#!/usr/bin/env python3
# AI-hint: Projects Postgres account table rows into lldap bootstrap format.
import os
import sys
import json
import logging
import argparse

logging.basicConfig(level=logging.INFO, format="[mios-lldap-seed] %(levelname)s: %(message)s")
log = logging.getLogger("mios-lldap-seed")

def get_pg_config():
    e = os.environ
    try:
        port = int(e.get("MIOS_PORTS_PGVECTOR", "8600") or 8600)
    except (TypeError, ValueError):
        port = 8600
    return {
        "host": e.get("MIOS_PGVECTOR_HOST", "localhost"),
        "port": port,
        "user": e.get("MIOS_PGVECTOR_USER", "mios"),
        "password": e.get("MIOS_PGVECTOR_PASS", "mios"),
        "dbname": e.get("MIOS_PGVECTOR_DB", "mios"),
    }

def query_accounts(cursor):
    sql = """
    SELECT 
        name AS username, 
        password_hash, 
        uid, 
        display, 
        enabled
    FROM account 
    WHERE enabled = true;
    """
    cursor.execute(sql)
    rows = cursor.fetchall()
    results = []
    for r in rows:
        if isinstance(r, dict):
            results.append(r)
        else:
            results.append({
                "username": r[0],
                "password_hash": r[1],
                "uid": r[2],
                "display": r[3],
                "enabled": r[4],
            })
    return results

def build_lldap_bootstrap(accounts):
    users = []
    for acc in sorted(accounts, key=lambda x: x.get("username", "")):
        uname = acc.get("username")
        if not uname:
            continue
        u_entry = {
            "id": uname,
            "email": f"{uname}@mios.local",
            "displayName": acc.get("display") or uname,
        }
        pw = acc.get("password_hash")
        if pw:
            u_entry["passwordHash"] = pw
        users.append(u_entry)

    groups = [
        {"id": "users", "name": "Standard Users"},
        {"id": "admin", "name": "Administrators"}
    ]
    return {"users": users, "groups": groups}

def main():
    parser = argparse.ArgumentParser(description="Project PostgreSQL account rows into lldap bootstrap format")
    parser.add_argument("--dry-run", action="store_true", help="Print bootstrap JSON without writing")
    parser.add_argument("--out-file", default=os.environ.get("MIOS_LLDAP_BOOTSTRAP_FILE", "/var/lib/mios/lldap-bootstrap.json"), help="Output path for bootstrap.json")
    args = parser.parse_args()

    lldap_enabled = os.environ.get("MIOS_ACCOUNTS_LLDAP_ENABLE", "").lower() in ("true", "1", "yes", "on")
    db_backed = os.environ.get("MIOS_ACCOUNTS_DB_BACKED", "").lower() in ("true", "1", "yes", "on")

    if not (lldap_enabled and db_backed) and not args.dry_run:
        log.info("MIOS_ACCOUNTS_LLDAP_ENABLE / MIOS_ACCOUNTS_DB_BACKED disabled; skipping lldap seed.")
        return 0

    try:
        import psycopg
        from psycopg.rows import dict_row
    except ImportError:
        log.warning("psycopg missing; skipping lldap seed (fail-open).")
        return 0

    cfg = get_pg_config()
    conn_str = f"postgresql://{cfg['user']}:{cfg['password']}@{cfg['host']}:{cfg['port']}/{cfg['dbname']}"
    try:
        with psycopg.connect(conn_str, connect_timeout=3) as conn:
            with conn.cursor(row_factory=dict_row) as cur:
                accounts = query_accounts(cur)
                bootstrap = build_lldap_bootstrap(accounts)
                content = json.dumps(bootstrap, indent=2, sort_keys=True) + "\n"

                if args.dry_run:
                    log.info("[DRY-RUN] Would write %s:\n%s", args.out_file, content)
                else:
                    os.makedirs(os.path.dirname(args.out_file), exist_ok=True)
                    if os.path.isfile(args.out_file):
                        with open(args.out_file, "r", encoding="utf-8") as f:
                            if f.read() == content:
                                log.info("lldap bootstrap file %s unchanged.", args.out_file)
                                return 0
                    with open(args.out_file, "w", encoding="utf-8") as f:
                        f.write(content)
                    log.info("Wrote lldap bootstrap to %s", args.out_file)
    except Exception as e:
        log.warning("Postgres lldap seed query failed (fail-open): %s", e)
        return 0

    return 0

if __name__ == "__main__":
    sys.exit(main())
