#!/usr/bin/env python3
# AI-hint: Enrolls a logged-out node, syncs Tailscale to SSOT [tailscale]/[headscale], keeps an exit node only while it beats the uplink, applies the [tailscale.serve.routes.*] proxies it owns and serves the read-only agent share (--share-serve).
# AI-related: /usr/share/mios/mios.toml, /etc/mios/mios.toml, tailscaled.service, mios-headscale, mios-tailscale-sync.timer, test_mios_tailscale_sync.py
# AI-functions: _load_data, _load_config, _health_config, _ts, find_tailscale, get_status, select_exit_node, _node_flags, build_set_cmd, _auth_key_source, build_up_cmd, enroll, probe, direct_interface, exit_is_worse, _active_exit_ip, sync_mesh, dns_name, render_routes, live_routes, plan_serve, serve_cmd, legacy_ttyd_handler, dropin_path, forge_dropin, sync_serve, share_serve
"""'MiOS' Tailscale mesh client synchronization daemon/helper.

Derives Tailscale connection settings from layered mios.toml SSOT:
  [tailscale]
  enabled = true
  mode = "kernel"                # or "userspace"
  login_server = ""             # empty string = Tailscale SaaS; or Headscale URL
  accept_routes = true
  accept_dns = true
  advertise_routes = ""
  exit_nodes = []               # ordered peer names/IPs; [] = leave exit node alone
  exit_node_allow_lan_access = true
  hostname = ""                 # enrollment/node name; "" = the OS hostname
  advertise_exit_node = false   # asserted when true, never cleared
  shields_up = false            # asserted when true, never cleared
  auth_key_file = ""            # pre-auth key file; else MIOS_TAILSCALE_AUTHKEY/TS_AUTHKEY
  socks5_server = ""            # userspace-mode loopback listener (started by the caller)
  [tailscale.exit_node_health]  # probe, count, interval_s, max_extra_loss_pct,
                                # max_extra_rtt_ms, cooldown_s, state

A node that is not logged in is enrolled with `tailscale up --reset
--auth-key=file:<path>` and the same parameters when a pre-auth key is
available: [tailscale].auth_key_file, else the MIOS_TAILSCALE_AUTHKEY or
TS_AUTHKEY environment, which is written to a private 0600 file for the call
and removed after it. The key never reaches a command line or a log. Without a
key the node is left logged out with the command to run. --socket=PATH
addresses a tailscaled started on its own socket (the userspace devcontainer).

The SSOT is the operator view (mios_toml.operator_view): vendor + host in full,
and from the operator's mios.html tier ONLY the [tailscale.serve] enable toggles
-- every path, port, host, unit and public_host is vendor/host, so a file a
lower-privileged uid writes never steers this root process. A vendor/host layer
that does not parse fails closed (exit 3, nothing applied); an operator tier that
does not parse or cannot be located leaves every serve route as it is (exit 3)
while the mesh, which takes nothing from it, still syncs.

[tailscale.serve] (enabled) maps each enabled [tailscale.serve.routes.<name>]
onto `tailscale serve --bg` -- an https PROXY to [network].loopback or a tcp
forward, never a directory handler (tailscaled is root and follows symlinks)
and never funnel. The sync owns only the routes it added or adopted (a live
route that already matches), recorded in <[paths].var_tailscale_sync_dir>/
serve-owned.json; a disabled owned route is turned off, a different hand-made
route or protocol on the same listener is reported and left, a handler kept
under another node name is reported and never treated as ours, and `serve
reset` is never run. A `serve status` that fails, times out or does not parse
plans nothing (no add, remove or forget; the owned record is kept). require_auth
refuses a route unless every one of its auth_probe_paths (default "/") answers
401 or a login redirect, and a route naming a `credential` surface is refused
while that login is the published vendor default (the vendor tier's own value)
or, for ttyd, while no own login is set. A ws: probe is a websocket handshake.
The handler the retired mios-ttyd-expose.service published is adopted once and
then follows the ttyd_bash route (kept when enabled, turned off when not); a
host that still sets the retired [ttyd].tailnet_expose = true keeps it unowned.
A forge_http route this sync actually serves renders the Forgejo ROOT_URL/DOMAIN
drop-in under Quadlet's runtime dir from a validated DNS name (retired otherwise). --check prints the serve plan
and exits 1 when anything differs.

--share-serve --bind ADDR --port N [--root DIR] [--prefix /share/] is the
read-only agent share mios-agent-share.service runs as a DynamicUser: loopback
only, never as root, O_NOFOLLOW on every component, and only world-readable,
singly linked regular files (sandboxed by CSP, never rendered as HTML). The
root and prefix default to [paths].srv_agent_share_dir and
[tailscale.serve.routes.agent_share].path of the vendor + host tiers.

If [tailscale].enabled is true, applies the mesh parameters with `tailscale
set` (which only touches the flags it names, unlike `up --reset`). The exit
node is the first exit_nodes entry that is online, offers itself as one and
is not cooling down; when none qualifies the exit node is cleared, so egress
falls back to the host's own default route instead of a dead peer.

With [tailscale.exit_node_health] enabled, exit nodes are a standby failover.
Every run first probes the host's own lowest-metric default route; while it
loses at most max_extra_loss_pct and no exit node is active, the exit nodes
stay on standby -- switching one in just to measure it would change the
public IP and drop open connections. Otherwise the candidate is applied and
the probe runs through it and, in parallel, directly. An exit node that loses
clearly more, or matches the loss but adds more than max_extra_rtt_ms, is put
on cooldown and the next preference is tried. --dry-run prints the command
without running it or probing.
"""
from __future__ import annotations
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios"))
import mios_toml  # noqa: E402

_HEALTH_KEYS = ("probe", "count", "interval_s", "max_extra_loss_pct",
                "max_extra_rtt_ms", "cooldown_s", "state")


def _log(msg: str) -> None:
    print(f"[mios-tailscale-sync] {msg}", flush=True)


def _as_list(value) -> list[str]:
    if isinstance(value, str):
        value = value.split(",")
    return [str(v).strip() for v in value or [] if str(v).strip()]


def _health_config(ts: dict) -> dict | None:
    """The exit-node health gate from SSOT, or None when disabled/incomplete."""
    health = ts.get("exit_node_health") or {}
    if not health.get("enabled"):
        return None
    missing = [k for k in _HEALTH_KEYS if health.get(k) in (None, "")]
    if missing:
        _log(f"exit-node health gate off: [tailscale.exit_node_health] lacks {', '.join(missing)}")
        return None
    try:
        return {"probe": str(health["probe"]), "count": int(health["count"]),
                "interval_s": float(health["interval_s"]),
                "max_extra_loss_pct": float(health["max_extra_loss_pct"]),
                "max_extra_rtt_ms": float(health["max_extra_rtt_ms"]),
                "cooldown_s": int(health["cooldown_s"]), "state": str(health["state"])}
    except (TypeError, ValueError) as e:
        _log(f"exit-node health gate off: invalid [tailscale.exit_node_health] ({e})")
        return None


def _load_data() -> dict:
    # The operator view (Law 13 tiers with their mios.d drop-ins; MIOS_*_TOML retarget them):
    # vendor + host in full and, as root, only the [tailscale.serve] enable toggles from the
    # operator's mios.html tier. A layer that does not parse raises mios_toml.LayerError.
    return mios_toml.operator_view()[0]


def _load_config(data: dict | None = None) -> dict:
    data = _load_data() if data is None else data
    ts = data.get("tailscale", {})
    hs = data.get("headscale", {})
    metal_mesh = data.get("metal", {}).get("mesh", {})
    return {
        "enabled": bool(ts.get("enabled", True)),
        "mode": str(ts.get("mode", "kernel")),
        "login_server": str(ts.get("login_server", "") or (hs.get("server_url", "") if hs.get("enabled") else "")),
        "accept_routes": bool(ts.get("accept_routes", True)),
        "accept_dns": bool(ts.get("accept_dns", True)),
        "advertise_routes": str(ts.get("advertise_routes", "")),
        "exit_nodes": _as_list(ts.get("exit_nodes", [])),
        "exit_node_allow_lan_access": bool(ts.get("exit_node_allow_lan_access", True)),
        "hostname": str(ts.get("hostname", "") or ""),
        "advertise_exit_node": bool(ts.get("advertise_exit_node", False)),
        "shields_up": bool(ts.get("shields_up", False)),
        "auth_key_file": str(ts.get("auth_key_file", "") or ""),
        "health": _health_config(ts),
        "headscale_domain": str(metal_mesh.get("headscale_domain", "mesh.mios.local")),
    }


_SOCKET = ""  # --socket=PATH: a tailscaled on its own socket


def _ts(ts_bin: str, *args: str) -> list[str]:
    return [ts_bin] + ([f"--socket={_SOCKET}"] if _SOCKET else []) + list(args)


def find_tailscale() -> str:
    for b in ("tailscale", "/usr/bin/tailscale", "/usr/sbin/tailscale"):
        if shutil.which(b) or os.path.isfile(b):
            return b
    return "tailscale"


def get_status() -> dict:
    ts_bin = find_tailscale()
    try:
        res = subprocess.run(_ts(ts_bin, "status", "--json"),
                             capture_output=True, text=True, timeout=10)
        if res.returncode == 0 and res.stdout.strip():
            return json.loads(res.stdout)
    except Exception as e:
        _log(f"Error querying tailscale status: {e}")
    return {}


def _peer_names(peer: dict) -> set[str]:
    names = {str(peer.get("HostName", "")).lower(),
             str(peer.get("DNSName", "")).split(".")[0].lower()}
    names.update(str(ip) for ip in peer.get("TailscaleIPs") or [])
    return names - {""}


def select_exit_node(status: dict, wanted: list[str],
                     skip: frozenset[str] = frozenset()) -> tuple[str, str]:
    """(tailscale IPv4, peer name) of the first usable preference not in
    `skip` (exit nodes cooling down), else ("", "")."""
    peers = list((status.get("Peer") or {}).values())
    for want in wanted:
        match = [p for p in peers if want.lower() in _peer_names(p)]
        if not match:
            _log(f"exit node {want}: not in this tailnet")
            continue
        peer = match[0]
        if not peer.get("Online"):
            _log(f"exit node {want}: offline")
        elif not peer.get("ExitNodeOption"):
            _log(f"exit node {want}: online but not advertising an exit node")
        else:
            ips = [ip for ip in peer.get("TailscaleIPs") or [] if ":" not in ip]
            if not ips:
                _log(f"exit node {want}: no Tailscale IPv4")
            elif ips[0] in skip:
                _log(f"exit node {want}: cooling down after a failed health check")
            else:
                return ips[0], want
    return "", ""


def _node_flags(cfg: dict) -> list[str]:
    """The SSOT parameters shared by enrollment (`up`) and sync (`set`).
    advertise_exit_node and shields_up are asserted only when true."""
    flags = [f"--accept-routes={str(cfg['accept_routes']).lower()}",
             f"--accept-dns={str(cfg['accept_dns']).lower()}",
             f"--advertise-routes={cfg['advertise_routes']}"]
    if cfg.get("hostname"):
        flags.append(f"--hostname={cfg['hostname']}")
    if cfg.get("advertise_exit_node"):
        flags.append("--advertise-exit-node=true")
    if cfg.get("shields_up"):
        flags.append("--shields-up=true")
    return flags


def build_set_cmd(ts_bin: str, cfg: dict, exit_ip: str) -> list[str]:
    cmd = _ts(ts_bin, "set", *_node_flags(cfg))
    # A node that offers itself as an exit node cannot use one.
    if cfg["exit_nodes"] and not cfg.get("advertise_exit_node"):
        cmd.append(f"--exit-node={exit_ip}")
        cmd.append(f"--exit-node-allow-lan-access={str(cfg['exit_node_allow_lan_access']).lower()}")
    return cmd


def probe(health: dict, interface: str = "") -> tuple[float, float]:
    """(loss %, average RTT ms) pinging the probe; through `interface` when
    given (SO_BINDTODEVICE skips Tailscale's exit-node table), else through
    whatever route is active. A failed probe is (100, inf)."""
    cmd = ["ping", "-n", "-q", "-c", str(health["count"]), "-i", str(health["interval_s"]), "-W", "2"]
    if interface:
        cmd += ["-I", interface]
    cmd.append(health["probe"])
    try:
        out = subprocess.run(cmd, capture_output=True, text=True,
                             timeout=health["count"] * health["interval_s"] + 15).stdout
    except (OSError, subprocess.TimeoutExpired):
        return 100.0, math.inf
    loss = re.search(r"([\d.]+)% packet loss", out)
    rtt = re.search(r"= [\d.]+/([\d.]+)/", out)
    return (float(loss.group(1)) if loss else 100.0), (float(rtt.group(1)) if rtt else math.inf)


def direct_interface() -> str:
    """The host's own uplink: the lowest-metric main-table default route."""
    try:
        res = subprocess.run(["ip", "-j", "route", "show", "table", "main", "default"],
                             capture_output=True, text=True, timeout=10)
        routes = json.loads(res.stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return ""
    routes = [r for r in routes if r.get("dev")]
    return min(routes, key=lambda r: r.get("metric", 0))["dev"] if routes else ""


def exit_is_worse(direct: tuple[float, float], via_exit: tuple[float, float], health: dict) -> bool:
    """Loss decides when the paths differ by more than max_extra_loss_pct;
    otherwise the exit node may add at most max_extra_rtt_ms."""
    (d_loss, d_rtt), (e_loss, e_rtt) = direct, via_exit
    margin = health["max_extra_loss_pct"]
    if e_loss + margin < d_loss:
        return False
    if e_loss > d_loss + margin:
        return True
    return e_rtt > d_rtt + health["max_extra_rtt_ms"]


def _cooldowns(health: dict, now: float) -> dict[str, float]:
    try:
        with open(health["state"]) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return {}
    return {ip: until for ip, until in state.items()
            if isinstance(until, (int, float)) and until > now}


def _save_cooldowns(health: dict, cooling: dict[str, float]) -> None:
    path = health["state"]
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            json.dump(cooling, f)
        os.replace(tmp, path)
    except OSError as e:
        _log(f"could not record exit-node cooldown in {path}: {e}")


def _active_exit_ip(status: dict) -> str:
    """The Tailscale IPv4 of the exit node in use, else ""."""
    ips = (status.get("ExitNodeStatus") or {}).get("TailscaleIPs") or []
    return next((ip.split("/")[0] for ip in ips if ":" not in ip), "")


def _auth_key_source(cfg: dict) -> tuple[str, bool]:
    """(path of a file holding the pre-auth key, whether it is a temporary copy
    of the environment key to remove after use), or ("", False)."""
    path = cfg.get("auth_key_file", "")
    if path:
        if os.path.isfile(path) and os.access(path, os.R_OK):
            return path, False
        _log(f"[tailscale].auth_key_file {path} is not a readable file")
    key = (os.environ.get("MIOS_TAILSCALE_AUTHKEY") or os.environ.get("TS_AUTHKEY") or "").strip()
    if not key:
        return "", False
    import tempfile
    fd, tmp = tempfile.mkstemp(prefix="mios-ts-authkey-")  # 0600
    with os.fdopen(fd, "w") as f:
        f.write(key)
    return tmp, True


def build_up_cmd(ts_bin: str, cfg: dict, key_path: str) -> list[str]:
    cmd = _ts(ts_bin, "up", "--reset", f"--auth-key=file:{key_path}", *_node_flags(cfg))
    if cfg.get("login_server"):
        cmd.append(f"--login-server={cfg['login_server']}")
    return cmd


def enroll(ts_bin: str, cfg: dict, dry_run: bool = False) -> int:
    """Enroll a logged-out node from a pre-auth key file; 0 when enrolled,
    2 when no key is available, else the failing exit code."""
    key_path, temporary = _auth_key_source(cfg)
    if not key_path:
        return 2
    try:
        cmd = build_up_cmd(ts_bin, cfg, key_path)
        if dry_run:
            print(" ".join(cmd))
            return 0
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        if res.returncode != 0:
            # tailscale never echoes the key; trim anyway so a log stays short.
            _log(f"tailscale up failed ({res.returncode}): {res.stderr.strip()[:400]}")
        else:
            _log(f"enrolled as {cfg.get('hostname') or 'the OS hostname'}")
        return res.returncode
    finally:
        if temporary:
            os.unlink(key_path)


def _apply(cmd: list[str]) -> int:
    res = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    if res.returncode != 0:
        _log(f"tailscale set failed ({res.returncode}): {res.stderr.strip()[:400]}")
    return res.returncode


def _fmt(path: tuple[float, float]) -> str:
    return f"{path[0]:.0f}% loss, {path[1]:.0f} ms"


def sync_mesh(dry_run: bool = False, data: dict | None = None) -> int:
    cfg = _load_config(data)
    if not cfg["enabled"]:
        _log("Tailscale is disabled in SSOT [tailscale].enabled=false")
        return 0

    ts_bin = find_tailscale()
    if not shutil.which(ts_bin) and not os.path.isfile(ts_bin):
        _log("tailscale CLI binary not found on PATH")
        return 1

    status = get_status()
    backend_state = status.get("BackendState", "NoState")
    _log(f"Current Tailscale BackendState: {backend_state}")
    if backend_state != "Running":
        rc = enroll(ts_bin, cfg, dry_run)
        if rc != 2:
            return rc
        server = cfg["login_server"] or "Tailscale SaaS"
        _log(f"not logged in; run: tailscale up --login-server={server}" if cfg["login_server"]
             else f"not logged in to {server}; run: tailscale up")
        return 0

    health = cfg["health"] if cfg["exit_nodes"] else None
    now = time.time()
    cooling = _cooldowns(health, now) if health else {}
    if health and not dry_run and not _active_exit_ip(status):
        uplink = direct_interface()
        direct = probe(health, uplink) if uplink else (100.0, math.inf)
        if direct[0] <= health["max_extra_loss_pct"]:
            _log(f"direct uplink {uplink} healthy ({_fmt(direct)}) -- exit nodes on standby")
            return _apply(build_set_cmd(ts_bin, cfg, ""))
        _log(f"direct uplink {uplink or 'none'} degraded ({_fmt(direct)}) -- trying exit nodes")
    while True:
        exit_ip, exit_name = select_exit_node(status, cfg["exit_nodes"], frozenset(cooling))
        if cfg["exit_nodes"]:
            _log(f"exit node: {exit_name} ({exit_ip})" if exit_ip
                 else "exit node: none usable -- cleared, egress via the host default route")
        cmd = build_set_cmd(ts_bin, cfg, exit_ip)
        if dry_run:
            print(" ".join(cmd))
            return 0
        rc = _apply(cmd)
        if rc != 0 or not (health and exit_ip):
            return rc
        uplink = direct_interface()
        with ThreadPoolExecutor(max_workers=2) as pool:
            direct = pool.submit(probe, health, uplink) if uplink else None
            via_exit = pool.submit(probe, health).result()
            direct = direct.result() if direct else (100.0, math.inf)
        _log(f"health {exit_name}: via exit {_fmt(via_exit)}; direct via {uplink or 'none'} {_fmt(direct)}")
        is_worse = exit_is_worse(direct, via_exit, health)
        if not is_worse:
            return 0
        _log(f"exit node {exit_name}: worse than the direct uplink -- cooling down {health['cooldown_s']} s")
        cooling[exit_ip] = now + health["cooldown_s"]
        _save_cooldowns(health, cooling)


# ------------------------------------------------------------------ tailnet serve routes

_DNS_LABEL = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
_DNS_NAME = re.compile(rf"^(?=.{{1,253}}$){_DNS_LABEL}(?:\.{_DNS_LABEL})*$")
_ROUTE_NAME = re.compile(r"^[a-z0-9_]+$")
_SERVE_PATH = re.compile(r"^/(?:[A-Za-z0-9._~-]+/)*$")
_UNIT_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
QUADLET_RUNTIME_DIR = "/run/containers/systemd"   # Quadlet's runtime search dir: generated drop-ins
OWNED_STATE_NAME = "serve-owned.json"             # in [paths].var_tailscale_sync_dir
DROPIN_NAME = "60-mios-tailnet.conf"
LEGACY_TTYD_MARK = "migrated:ttyd-expose"         # owned-state marker, not a route key
_PROBE_PATH = re.compile(r"^(?:ws:)?/[A-Za-z0-9._~/-]*$")   # ws: = a websocket handshake probe


def _loopback(data: dict) -> str:
    """[network].loopback when it IS a loopback address, else ''."""
    import ipaddress
    host = str((data.get("network") or {}).get("loopback") or "")
    try:
        return host if ipaddress.ip_address(host).is_loopback else ""
    except ValueError:
        return ""


def _port(value) -> int:
    try:
        port = int(value)
    except (TypeError, ValueError):
        return 0
    return port if 0 < port < 65536 else 0


def dns_name(host) -> str:
    """host (its trailing dot dropped) when it is a strict DNS name, else ''."""
    host = str(host or "").strip().rstrip(".")
    return host if _DNS_NAME.match(host) else ""


def render_routes(data: dict) -> tuple[list[dict], list[str]]:
    """The desired routes from [tailscale.serve.routes.*] as (routes, errors). Every
    route PROXIES to [network].loopback:<[ports].upstream>; it listens on the tailnet at
    that port number, or, with front_door = true, on [ports].tailnet_https
    (MIOS_PORTS_TAILNET_HTTPS) under its path. One listener port is either one tcp route or https routes with
    distinct paths -- never both. Nothing here may come from the operator tier except
    the enabled toggles (operator_view enforces that)."""
    serve = (data.get("tailscale") or {}).get("serve") or {}
    if not serve.get("enabled"):
        return [], []
    ports = data.get("ports") or {}
    loop = _loopback(data)
    if not loop:
        return [], ["*: [network].loopback is not a loopback address -- no route is rendered"]
    try:  # the one tailnet HTTPS listener, by its canonical name
        front = _port(mios_toml.expand_refs(data, "${MIOS_PORTS_TAILNET_HTTPS}"))
    except mios_toml.LayerError:
        front = 0
    out, errors = [], []
    for name, r in sorted((serve.get("routes") or {}).items()):
        if not isinstance(r, dict) or not r.get("enabled"):
            continue
        if not _ROUTE_NAME.match(str(name)):
            errors.append(f"{name}: a route name is [a-z0-9_]")
            continue
        proto = str(r.get("proto", ""))
        up = _port(ports.get(str(r.get("upstream", ""))))
        if proto not in ("https", "tcp") or not up:
            errors.append(f"{name}: proto must be https|tcp and upstream a [ports] key")
            continue
        port = up
        if r.get("front_door"):
            if proto != "https" or not front:
                errors.append(f"{name}: a front_door route is https on [ports].tailnet_https")
                continue
            port = front
        path = "" if proto == "tcp" else str(r.get("path") or "/")
        if proto == "https" and not _SERVE_PATH.match(path):
            errors.append(f"{name}: path must be / or /segment/.../ (ending in /)")
            continue
        probes = r.get("auth_probe_paths", ["/"])
        if not (isinstance(probes, list) and probes and all(isinstance(p, str) and _PROBE_PATH.match(p)
                                                             for p in probes)):
            errors.append(f"{name}: auth_probe_paths must be a non-empty list of /paths")
            continue
        cred = str(r.get("credential") or "")
        if cred and cred not in _credential_surfaces():
            errors.append(f"{name}: credential must name a mios-credential surface")
            continue
        out.append({"name": name, "proto": proto, "port": port, "path": path,
                    "require_auth": bool(r.get("require_auth")), "credential": cred,
                    "target": f"tcp://{loop}:{up}" if proto == "tcp" else f"http://{loop}:{up}",
                    "probes": [] if proto == "tcp" else [
                        f"ws://{loop}:{up}{p[3:]}" if p.startswith("ws:") else f"http://{loop}:{up}{p}"
                        for p in probes]})
    seen: dict = {}
    for r in out:
        for o in seen.get(r["port"], []):
            if "tcp" in (r["proto"], o["proto"]) or r["path"] == o["path"]:
                errors.append(f"{r['name']}: listener {r['port']}{r['path']} collides with {o['name']}")
        seen.setdefault(r["port"], []).append(r)
    bad = {e.split(":", 1)[0] for e in errors}
    return [r for r in out if r["name"] not in bad], errors


def _rkey(proto: str, port, path: str) -> str:
    return f"{proto}:{port}:{path}"


def _is_rkey(key: str) -> bool:
    """A serve-owned.json route key (proto:port:path), not a marker such as LEGACY_TTYD_MARK."""
    return key.count(":") >= 2 and key.split(":", 1)[0] in ("https", "http", "tcp")


def live_routes(serve_status: dict, self_host: str) -> tuple[dict, list[str]]:
    """({route key: target}, [foreign HostPort]) of the live `tailscale serve status
    --json`. Only Web handlers of THIS node's MagicDNS name count; a handler kept under
    another name (a renamed node) is reported, never folded onto ours. A Web handler is
    keyed by its listener's protocol from the TCP map (HTTPS -> https, HTTP -> http, else
    'web', which no route matches), and every handler counts -- a Text or unknown one
    included -- so a route is never written over a different hand-made listener."""
    live, foreign, web_proto = {}, [], {}
    for port, tcp in ((serve_status or {}).get("TCP") or {}).items():
        if not isinstance(tcp, dict):
            continue
        if tcp.get("TCPForward"):
            live[_rkey("tcp", port, "")] = "tcp://" + str(tcp["TCPForward"])
        elif tcp.get("HTTPS"):
            web_proto[str(port)] = "https"
        elif tcp.get("HTTP"):
            web_proto[str(port)] = "http"
    for hostport, web in ((serve_status or {}).get("Web") or {}).items():
        host, _, port = str(hostport).rpartition(":")
        if host.rstrip(".").lower() != self_host.lower():
            foreign.append(str(hostport))
            continue
        for path, h in ((web or {}).get("Handlers") or {}).items():
            h = h if isinstance(h, dict) else {}
            target = h.get("Proxy") or h.get("Path") or ("text:" if "Text" in h else "unknown:")
            live[_rkey(web_proto.get(port, "web"), port, path)] = str(target)
    return live, sorted(foreign)


def plan_serve(desired: list[dict], live: dict, owned: dict) -> list[tuple[str, dict]]:
    """Pure plan: [(action, route)] where action is add | adopt | keep | replace
    (an owned route whose target moved) | conflict (a different unowned route, or
    another protocol, holds the listener: left alone) | remove (an owned route now
    disabled) | forget (an owned route already gone, or changed by hand: not touched)."""
    plan, want = [], set()
    protos: dict = {}
    for k in live:
        proto, port, _path = k.split(":", 2)
        protos.setdefault(port, set()).add(proto)
    for r in desired:
        k = _rkey(r["proto"], r["port"], r["path"])
        want.add(k)
        if k not in live:
            other = protos.get(str(r["port"]), set()) - {r["proto"]}
            plan.append(("conflict" if other else "add", r))
        elif live[k] == r["target"]:
            plan.append(("keep" if k in owned else "adopt", r))
        else:
            plan.append(("replace" if owned.get(k) == live[k] else "conflict", r))
    for k, target in sorted(owned.items()):
        if k in want or not _is_rkey(k):
            continue
        proto, port, path = k.split(":", 2)
        r = {"name": k, "proto": proto, "port": int(port), "path": path, "target": target}
        plan.append(("remove" if live.get(k) == target else "forget", r))
    return plan


def serve_cmd(ts_bin: str, action: str, r: dict) -> list[str]:
    if r["proto"] == "tcp":
        return _ts(ts_bin, "serve", f"--tcp={r['port']}", "off") if action == "remove" else \
            _ts(ts_bin, "serve", "--bg", f"--tcp={r['port']}", r["target"])
    lst = [f"--https={r['port']}", f"--set-path={r['path']}"]
    return _ts(ts_bin, "serve", *lst, "off") if action == "remove" else \
        _ts(ts_bin, "serve", "--bg", *lst, r["target"])


def _probe(url: str) -> str:
    """An anonymous GET of url: 'login' (401, or a redirect to a login page), 'down' (no
    answer, or a 5xx while it starts) or 'open' (anything else served without a login).
    A ws:// url is an anonymous websocket handshake (HTTP middleware never sees one): 'open'
    when the server switches protocols, 'login' when it refuses the upgrade."""
    import base64
    import http.client
    import urllib.parse
    u = urllib.parse.urlsplit(url)
    ws = u.scheme == "ws"
    hdrs = {"Connection": "Upgrade", "Upgrade": "websocket", "Sec-WebSocket-Version": "13",
            "Sec-WebSocket-Key": base64.b64encode(os.urandom(16)).decode()} if ws else {}
    try:
        conn = http.client.HTTPConnection(u.hostname, u.port, timeout=6)
        conn.request("GET", u.path or "/", headers=hdrs)
        resp = conn.getresponse()
        loc = resp.getheader("Location") or ""
        conn.close()
    except OSError:
        return "down"
    if resp.status >= 500:
        return "down"
    if ws:
        return "open" if resp.status == 101 else "login"
    if resp.status == 401 or (resp.status in (301, 302, 303, 307, 308) and "login" in loc.lower()):
        return "login"
    return "open"


def _auth_refusal(r: dict) -> str:
    """Why a require_auth route must not be published ('' when every auth probe asks for a
    login): a route publishes its WHOLE upstream, so one open path refuses it. A probe that
    gets no answer marks the route 'down' -- not published yet, but an owned one is kept."""
    import urllib.parse
    down = False
    for url in r.get("probes") or []:
        state = _probe(url)
        if state == "open":
            u = urllib.parse.urlsplit(url)
            kind = "a websocket on " if u.scheme == "ws" else ""
            return f"the upstream answered {kind}{u.path or '/'} without a login"
        down = down or state == "down"
    r["down"] = down
    return ""


def _credential_surfaces() -> tuple:
    import mios_credentials  # noqa: PLC0415 -- beside mios_toml
    return mios_credentials.SURFACES


def _vendor_default_login(data: dict, surface: str) -> str:
    """Why the login guarding a route is not one to publish ('' when it is fine): it does
    not resolve, it equals the VENDOR tier's own [identity].default_password or surface
    key -- a value anyone can read in the image -- or (ttyd) no own login is set, so the
    route would serve a generated login nobody was given. Resolved as the reconciler
    applies it (root)."""
    import mios_credentials as mc  # noqa: PLC0415
    vendor, vendor_d, *_rest = mios_toml._tier_dirs()
    try:
        shipped = mios_toml.load_strict([vendor] + mios_toml._frags(vendor_d))
        got = mc.surface_password(surface, data)
    except (mc.CredentialError, mios_toml.LayerError) as exc:
        return f"its {surface} login does not resolve ({exc})"
    if got["tier"] == mc.OWN_GENERATED:
        return f"its {surface} login is a generated secret -- set [ttyd].auth_pass in mios.html first"
    value = got["value"]
    public = {mc._s(mc._sect(shipped, "identity").get("default_password"))}
    sk = mc._SURFACE_TOML.get(surface)
    if sk:
        public.add(mc._s(mc._sect(shipped, sk[0]).get(sk[1])))
    public.discard("")
    return f"its {surface} login is the vendor default -- set one in mios.html first" if value in public else ""


def legacy_ttyd_handler(data: dict) -> tuple[str, str]:
    """(route key, target) of the handler the retired mios-ttyd-expose.service published
    (`serve --https=<ttyd_bash> http://<loopback>:<ttyd_bash>`), or ('', '')."""
    port, loop = _port((data.get("ports") or {}).get("ttyd_bash")), _loopback(data)
    return (_rkey("https", port, "/"), f"http://{loop}:{port}") if port and loop else ("", "")


def dropin_path(data: dict) -> str:
    """<Quadlet runtime dir>/<[units].forge container>.container.d/60-mios-tailnet.conf, or ''."""
    unit = str((data.get("units") or {}).get("forge") or "")
    ctr = unit[:-len(".service")] if unit.endswith(".service") else unit
    if not _UNIT_NAME.match(ctr):
        return ""
    return os.path.join(QUADLET_RUNTIME_DIR, f"{ctr}.container.d", DROPIN_NAME)


def forge_dropin(data: dict, host: str, ssh: bool, port: int) -> str:
    """The generated mios-forge Quadlet drop-in for a tailnet-served Forgejo. host must be
    a dns_name() and port the forge_http route's tailnet port: nothing unvalidated is
    written into a unit."""
    loop = _loopback(data)
    if not (dns_name(host) == host and loop and _port(port)):
        raise ValueError("forge drop-in: host, loopback or port failed validation")
    lines = ["# GENERATED by mios-tailscale-sync from [tailscale.serve.routes.forge_http] -- DO NOT EDIT;",
             "# change [portal].public_host or the route in mios.toml / mios.html instead.",
             "[Container]",
             f"Environment=FORGEJO__server__HTTP_ADDR={loop}",
             f"Environment=GITEA__server__HTTP_ADDR={loop}",
             f"Environment=FORGEJO__server__ROOT_URL=https://{host}:{port}/",
             f"Environment=FORGEJO__server__DOMAIN={host}",
             f"Environment=FORGEJO__server__SSH_DOMAIN={host}"]
    if ssh:
        lines.append(f"Environment=FORGEJO__server__SSH_LISTEN_HOST={loop}")
    return "\n".join(lines) + "\n"


def _read_json(path: str) -> dict:
    try:
        with open(path) as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def _write_private(path: str, text: str, mode: int = 0o600) -> None:
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def _owned_state_path(data: dict) -> str:
    raw = str((data.get("paths") or {}).get("var_tailscale_sync_dir") or "")
    return os.path.join(mios_toml.expand_refs(data, raw), OWNED_STATE_NAME) if raw else ""


def _sync_forge_dropin(data: dict, desired: list[dict], status: dict, check: bool) -> bool:
    """Render or retire the generated drop-in; True when it differs (check) or changed."""
    path = dropin_path(data)
    if not path:
        _log("serve: [units].forge names no container -- forge drop-in left alone")
        return False
    by = {r["name"]: r for r in desired}
    want = ""
    if "forge_http" in by:
        raw = (str((data.get("portal") or {}).get("public_host") or "").strip()
               or str((status.get("Self") or {}).get("DNSName") or ""))
        host = dns_name(raw)
        if not host:
            _log("serve: refusing the forge drop-in: [portal].public_host / the MagicDNS name is not a DNS name")
            return False
        want = forge_dropin(data, host, "forge_ssh" in by, by["forge_http"]["port"])
    try:
        with open(path) as f:
            have = f.read()
    except OSError:
        have = ""
    if have and not have.startswith("# GENERATED by mios-tailscale-sync"):
        _log(f"serve: {path} is not generated by this sync -- left alone")
        return False
    if have == want:
        return False
    _log(f"serve: forge tailnet drop-in {'would change' if check else 'updated'}")
    if check:
        return True
    if want:
        _write_private(path, want, 0o644)
    else:
        os.unlink(path)
    unit = str((data.get("units") or {}).get("forge") or "")
    subprocess.run(["systemctl", "daemon-reload"], capture_output=True, timeout=60)
    if _UNIT_NAME.match(unit):
        subprocess.run(["systemctl", "--no-block", "try-restart", unit], capture_output=True, timeout=60)
    return True


def _serve_status(ts_bin: str):
    """The live `tailscale serve status --json` as a dict ({} for an empty config), or None
    when the command fails, times out or prints something that is not a JSON object."""
    try:
        res = subprocess.run(_ts(ts_bin, "serve", "status", "--json"),
                             capture_output=True, text=True, timeout=10)
        doc = json.loads(res.stdout) if res.returncode == 0 else False
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return {} if doc is None else doc if isinstance(doc, dict) else None


def sync_serve(dry_run: bool = False, check: bool = False, data: dict | None = None) -> int:
    data = _load_data() if data is None else data
    state = _owned_state_path(data)
    owned = _read_json(state) if state else {}
    desired, errors = render_routes(data)
    for r in list(desired):
        why = _vendor_default_login(data, r["credential"]) if r.get("credential") else ""
        why = why or (_auth_refusal(r) if r.get("require_auth") else "")
        if why:
            errors.append(f"{r['name']}: refused, {why}")
            desired.remove(r)
    for e in errors:
        _log(f"serve: route {e}")
    migrate = bool(state) and LEGACY_TTYD_MARK not in owned
    if not desired and not any(_is_rkey(k) for k in owned) and not migrate:
        return 1 if errors else 0
    ts_bin = find_tailscale()
    quiet = not desired and not any(_is_rkey(k) for k in owned)   # only the one-time migration is due
    if quiet and not shutil.which(ts_bin) and not os.path.isfile(ts_bin):
        return 1 if errors else 0                                  # no tailscale here: nothing to migrate
    status = get_status()
    if status.get("BackendState") != "Running":
        if not quiet:
            _log("serve: node not Running -- routes left as they are")
        return 1 if errors else 0
    self_host = dns_name((status.get("Self") or {}).get("DNSName"))
    if not self_host:
        _log("serve: this node has no valid MagicDNS name -- routes left as they are")
        return 1 if errors else 0
    serve_status = _serve_status(ts_bin)
    if serve_status is None:
        # Never plan from a blank: an add would overwrite a hand-made handler and a
        # disabled owned route would be forgotten while still live.
        _log("serve: `tailscale serve status --json` failed or did not parse -- nothing planned, "
             "the owned routes are kept")
        return 1
    live, foreign = live_routes(serve_status, self_host)
    if foreign:
        _log(f"serve: handlers of another node name are not ours and are left alone: {', '.join(foreign)}")
    if migrate:
        k, target = legacy_ttyd_handler(data)
        if k and k not in owned and live.get(k) == target:
            if (data.get("ttyd") or {}).get("tailnet_expose") is True:
                _log("serve: [ttyd].tailnet_expose = true (retired): the handler mios-ttyd-expose published is "
                     "left as it is, not owned -- set [tailscale.serve.routes.ttyd_bash].enabled and "
                     "[ttyd].auth_pass in mios.html for this sync to manage it")
            else:
                _log("serve: the handler the retired mios-ttyd-expose published is adopted once; it now "
                     "follows [tailscale.serve.routes.ttyd_bash].enabled")
                owned[k] = target
    rc = 1 if errors else 0
    drift = False
    published = set()          # desired routes that are live and ours once this plan has run
    for action, r in plan_serve(desired, live, owned):
        k = _rkey(r["proto"], r["port"], r["path"])
        label = f"{r['name']} ({r['proto']}:{r['port']}{r['path']})"
        if action in ("add", "replace", "adopt") and r.get("down"):
            _log(f"serve: {label}: its upstream is not answering -- not published yet")
            rc = 1
            continue
        if action == "conflict":
            _log(f"serve: {label}: a different hand-made route or protocol holds this listener -- left alone")
            rc = 1
            continue
        if action == "keep":
            published.add(r["name"])
            continue
        drift = True
        _log(f"serve: {action} {label}")
        if check or dry_run:
            if action in ("add", "replace", "adopt"):
                published.add(r["name"])          # what the plan would publish
            if dry_run and action in ("add", "replace", "remove"):
                print(" ".join(serve_cmd(ts_bin, action, r)))
            continue
        if action in ("add", "replace", "remove"):
            res = subprocess.run(serve_cmd(ts_bin, action, r), capture_output=True, text=True, timeout=30)
            if res.returncode != 0:
                _log(f"serve: {action} {label} failed ({res.returncode}): {res.stderr.strip()[:300]}")
                rc = 1
                continue
        if action in ("add", "replace", "adopt"):
            owned[k] = r["target"]
            published.add(r["name"])
        else:
            owned.pop(k, None)
    # Forgejo is pointed at the tailnet URL only while its route is actually served by us.
    drift = _sync_forge_dropin(data, [r for r in desired if r["name"] in published], status,
                               check or dry_run) or drift
    if state and not (check or dry_run):
        if migrate:
            owned[LEGACY_TTYD_MARK] = "done"
        _write_private(state, json.dumps(owned, sort_keys=True))
    return 1 if (check and drift) else rc


# ------------------------------------------------------------------ the read-only agent share
# tailscaled runs as root and follows symlinks, so a directory others can write is never a
# `serve` path handler. mios-agent-share.service runs THIS as a DynamicUser on loopback:
# every path component is opened with O_NOFOLLOW from the share's own directory fd, the
# opened file must resolve inside the share, and only world-readable, singly linked
# regular files (and world-readable directories, as a plain-text listing) are served.

def _share_open(root_fd: int, root_real: str, rel: str):
    """(fd, stat) of rel inside the share, or None for anything that must not be served."""
    import stat as _stat
    parts = [p for p in rel.split("/") if p]
    if any(p in (".", "..") or "\0" in p for p in parts):
        return None
    fd = os.dup(root_fd)
    try:
        for i, part in enumerate(parts):
            nxt = os.open(part, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
            os.close(fd)
            fd = nxt
            st = os.fstat(fd)
            if _stat.S_ISDIR(st.st_mode):
                if st.st_mode & 0o005 != 0o005:
                    raise PermissionError
            elif i != len(parts) - 1:
                raise NotADirectoryError
        st = os.fstat(fd)
        real = os.readlink(f"/proc/self/fd/{fd}")
        inside = real == root_real or real.startswith(root_real.rstrip("/") + "/")
        if _stat.S_ISREG(st.st_mode):
            ok = st.st_mode & 0o004 and st.st_nlink == 1
        else:
            ok = _stat.S_ISDIR(st.st_mode) and st.st_mode & 0o005 == 0o005
        if not (inside and ok):
            raise PermissionError
        return fd, st
    except OSError:
        os.close(fd)
        return None


def _share_listing(fd: int) -> bytes:
    """Names a client could fetch: world-readable regular files and directories, no links."""
    import stat as _stat
    names = []
    for name in sorted(os.listdir(fd)):
        try:
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
        except OSError:
            continue
        if _stat.S_ISREG(st.st_mode) and st.st_mode & 0o004 and st.st_nlink == 1:
            names.append(name)
        elif _stat.S_ISDIR(st.st_mode) and st.st_mode & 0o005 == 0o005:
            names.append(name + "/")
    return ("\n".join(names) + "\n").encode("utf-8", "replace")


def share_serve(root: str, bind: str, port: int, prefix: str = "/") -> int:
    """Serve the share read-only on bind:port (loopback only, never as root)."""
    import http.server
    import ipaddress
    import mimetypes
    import urllib.parse
    if os.geteuid() == 0:
        _log("share: refusing to serve as root (run it as mios-agent-share.service's DynamicUser)")
        return 2
    try:
        loop = ipaddress.ip_address(bind).is_loopback
    except ValueError:
        loop = False
    if not loop or not _port(port):
        _log("share: --bind must be a loopback address and --port a port")
        return 2
    root_real = os.path.realpath(root)
    try:
        root_fd = os.open(root_real, os.O_RDONLY | os.O_DIRECTORY)
    except OSError as exc:
        _log(f"share: {root_real} is not a readable directory ({exc.strerror})")
        return 2
    prefix = "/" + prefix.strip("/") + "/" if prefix.strip("/") else "/"
    safe = {"text/plain", "application/json", "application/pdf", "image/png", "image/jpeg", "image/gif"}

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "mios-agent-share"
        sys_version = ""

        def log_message(self, fmt, *args):  # method and status only, never a query
            pass

        def _send(self, code, body=b"", ctype="text/plain; charset=utf-8", head=False, stream=None, size=0):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(size if stream else len(body)))
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy", "default-src 'none'; sandbox")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            if head:
                return
            if stream is None:
                self.wfile.write(body)
                return
            left = size                     # exactly the stat'ed size, in bounded chunks
            while left > 0:
                chunk = stream.read(min(65536, left))
                if not chunk:
                    break
                self.wfile.write(chunk)
                left -= len(chunk)

        def _serve(self, head):
            path = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
            rel = path[len(prefix):] if path.startswith(prefix) else path.lstrip("/")
            got = _share_open(root_fd, root_real, rel)
            if got is None:
                return self._send(404, b"not found\n", head=head)
            fd, st = got
            import stat as _stat
            try:
                if _stat.S_ISDIR(st.st_mode):
                    return self._send(200, _share_listing(fd), head=head)
                ctype = mimetypes.guess_type(rel)[0] or "application/octet-stream"
                ctype = ctype if ctype in safe else "application/octet-stream"
                with os.fdopen(os.dup(fd), "rb") as fh:
                    self._send(200, b"", ctype + ("; charset=utf-8" if ctype.startswith("text/") else ""),
                               head, stream=fh, size=st.st_size)
            finally:
                os.close(fd)

        def do_GET(self):
            self._serve(False)

        def do_HEAD(self):
            self._serve(True)

    srv = http.server.ThreadingHTTPServer((bind, port), Handler)
    _log(f"share: serving {root_real} read-only on {bind}:{port} (prefix {prefix})")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def _share_defaults() -> tuple[str, str]:
    """([paths].srv_agent_share_dir, [tailscale.serve.routes.agent_share].path) from the
    vendor + host tiers -- the share server never reads an operator tier, and its unit
    restates neither value. A layer that does not parse raises mios_toml.LayerError."""
    base = mios_toml.base_view()
    root = mios_toml.expand_refs(base, str((base.get("paths") or {}).get("srv_agent_share_dir") or ""))
    route = (((base.get("tailscale") or {}).get("serve") or {}).get("routes") or {}).get("agent_share") or {}
    return root, str(route.get("path") or "/")


def _arg(name: str, default: str = "") -> str:
    for i, a in enumerate(sys.argv):
        if a == name and i + 1 < len(sys.argv):
            return sys.argv[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return default


def main() -> int:
    global _SOCKET
    for arg in sys.argv[1:]:
        if arg.startswith("--socket="):
            _SOCKET = arg.split("=", 1)[1]
    if "--status" in sys.argv:
        print(json.dumps(get_status(), indent=2))
        return 0
    if "--share-serve" in sys.argv:
        root, prefix = _arg("--root"), _arg("--prefix")
        if not (root and prefix):
            try:
                ssot_root, ssot_prefix = _share_defaults()
            except mios_toml.LayerError as exc:
                _log(f"share: SSOT unresolved -- not serving: {exc}")
                return 3
            root, prefix = root or ssot_root, prefix or ssot_prefix
        return share_serve(root, _arg("--bind"), _port(_arg("--port")), prefix)
    try:
        data = _load_data()
    except mios_toml.LayerError as exc:
        # The mesh takes nothing from the operator tier, so a broken or unlocatable
        # operator tier stops only the serve routes (left exactly as they are); exit-node
        # failover keeps running on vendor + host. A broken vendor/host layer stops all.
        try:
            base = mios_toml.derive_ports(mios_toml.base_view())
        except mios_toml.LayerError as exc2:
            _log(f"SSOT unresolved -- nothing applied: {exc2}")
            return 3
        _log(f"operator tier unresolved -- serve routes left as they are: {exc}")
        if "--check" not in sys.argv:
            sync_mesh(dry_run="--dry-run" in sys.argv, data=base)
        return 3
    if "--check" in sys.argv:
        return sync_serve(check=True, data=data)
    rc = sync_mesh(dry_run="--dry-run" in sys.argv, data=data)
    return sync_serve(dry_run="--dry-run" in sys.argv, data=data) or rc


if __name__ == "__main__":
    sys.exit(main())
