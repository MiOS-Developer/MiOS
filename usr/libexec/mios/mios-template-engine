#!/usr/bin/env python3
# AI-hint: Thin shim delegating template rendering to the mios-new canonical generator, preserving the legacy <kind> <target_filepath> [description] contract.
# AI-related: /usr/libexec/mios/mios-new, /usr/share/mios/templates/
# AI-functions: main

import sys
import os
import subprocess

def main():
    if len(sys.argv) < 3:
        print("Usage: mios-template-engine <kind> <target_filepath> [description]")
        sys.exit(1)

    kind = sys.argv[1]
    target = sys.argv[2]
    desc = sys.argv[3] if len(sys.argv) > 3 else ""

    name, _ = os.path.splitext(os.path.basename(target))
    mios_new_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "mios-new")

    cmd = [sys.executable, mios_new_bin, kind, name, "--out", target]
    if desc:
        cmd.extend(["--description", desc])

    res = subprocess.run(cmd, capture_output=True, text=True)
    sys.stdout.write(res.stdout)
    sys.stderr.write(res.stderr)
    sys.exit(res.returncode)

if __name__ == "__main__":
    main()
