def _handle_screen_observe(args: list[str], as_json: bool) -> int:
    display_id = 0
    fmt = "ppm"
    strict_tmpfs = True
    tmpfs_dir = None

    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--display-id", "-d") and i + 1 < len(args):
            display_id = int(args[i + 1])
            i += 2
        elif a in ("--format", "-f") and i + 1 < len(args):
            fmt = args[i + 1]
            i += 2
        elif a in ("--tmpfs-dir", "-t") and i + 1 < len(args):
            tmpfs_dir = args[i + 1]
            i += 2
        elif a == "--no-strict-tmpfs":
            strict_tmpfs = False
            i += 1
        elif a == "--strict-tmpfs":
            strict_tmpfs = True
            i += 1
        else:
            i += 1

    try:
        res = screen_observe(
            display_id=display_id,
            fmt=fmt,
            strict_tmpfs=strict_tmpfs,
            tmpfs_dir=tmpfs_dir,
        )
        print(json.dumps(res, indent=2 if as_json else None))
        return 0
    except Exception as e:
        print(json.dumps({"error": str(e), "prog": PROG}), file=sys.stderr)
        return 1


def _handle_mouse_action(args: list[str], as_json: bool) -> int:
    action = "click"
    x = None
    y = None
    button = "left"
    delta_x = 0
    delta_y = 0
    display_id = 0

    i = 0
    if args and not args[0].startswith("-"):
        action = args[0]
        i = 1

    while i < len(args):
        a = args[i]
        if a in ("--action", "-a") and i + 1 < len(args):
            action = args[i + 1]
            i += 2
        elif a in ("--x", "-x") and i + 1 < len(args):
            x = float(args[i + 1])
            i += 2
        elif a in ("--y", "-y") and i + 1 < len(args):
            y = float(args[i + 1])
            i += 2
        elif a in ("--button", "-b") and i + 1 < len(args):
            button = args[i + 1]
            i += 2
        elif a in ("--display-id", "-d") and i + 1 < len(args):
            display_id = int(args[i + 1])
            i += 2
        elif a in ("--delta-x", "-dx") and i + 1 < len(args):
            delta_x = int(args[i + 1])
            i += 2
        elif a in ("--delta-y", "-dy") and i + 1 < len(args):
            delta_y = int(args[i + 1])
            i += 2
        elif i + 1 < len(args) and x is None and y is None:
            try:
                x = float(args[i])
                y = float(args[i + 1])
                i += 2
                if i < len(args) and not args[i].startswith("-"):
                    button = args[i]
                    i += 1
            except ValueError:
                i += 1
        else:
            i += 1

    try:
        res = mouse_action(
            action=action,
            x=x,
            y=y,
            button=button,
            delta_x=delta_x,
            delta_y=delta_y,
            display_id=display_id,
        )
        print(json.dumps(res, indent=2 if as_json else None))
        return 0
    except ValueError as e:
        print(json.dumps({"error": str(e), "prog": PROG}), file=sys.stderr)
        return 1
    except Exception as e:
        print(json.dumps({"error": str(e), "prog": PROG}), file=sys.stderr)
        return 1


def _handle_keyboard_action(args: list[str], as_json: bool) -> int:
    action = "type"
    text = None
    key = None
    combo = None
    keys = []

    i = 0
    if args and not args[0].startswith("-"):
        action = args[0]
        i = 1

    while i < len(args):
        a = args[i]
        if a in ("--action", "-a") and i + 1 < len(args):
            action = args[i + 1]
            i += 2
        elif a in ("--text", "-t") and i + 1 < len(args):
            text = args[i + 1]
            i += 2
        elif a in ("--key", "-k") and i + 1 < len(args):
            key = args[i + 1]
            i += 2
        elif a in ("--combo", "-c") and i + 1 < len(args):
            combo = args[i + 1]
            i += 2
        elif a == "--keys" and i + 1 < len(args):
            keys = [k.strip() for k in args[i + 1].split(",") if k.strip()]
            i += 2
        elif not a.startswith("-"):
            if action == "type" and text is None:
                text = a
            elif action in ("press", "key") and key is None:
                key = a
            elif action == "combo" and combo is None:
                combo = a
            i += 1
        else:
            i += 1

    try:
        res = keyboard_action(
            action=action,
            text=text,
            key=key,
            combo=combo,
            keys=keys if keys else None,
        )
        print(json.dumps(res, indent=2 if as_json else None))
        return 0
    except Exception as e:
        print(json.dumps({"error": str(e), "prog": PROG}), file=sys.stderr)
        return 1


INPUT_ACTIONS = {"click", "double-click", "mouse-move", "type", "key", "key-combo"}
WINDOW_ACTIONS = {"window-list", "window-focus", "window-move", "window-resize"}


def main() -> int:
    ap = argparse.ArgumentParser(prog=PROG, add_help=False)
    ap.add_argument("--openai-tools", action="store_true", help="Print OpenAI tool definitions")
    ap.add_argument("subcommand", nargs="?", default="help")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("rest", nargs=argparse.REMAINDER)
    ns = ap.parse_args()
    sub = ns.subcommand
    args = [a for a in ns.rest if a != "--json"]
    as_json = ns.json or ("--json" in ns.rest)

    if ns.openai_tools or sub in ("--openai-tools", "openai-tools"):
        print(json.dumps(get_openai_tool_definitions(), indent=2))
        return 0

    if sub in ("screen_observe", "screen-observe"):
        return _handle_screen_observe(args, as_json)

    if sub in ("mouse_action", "mouse-action"):
        return _handle_mouse_action(args, as_json)

    if sub in ("keyboard_action", "keyboard-action"):
        return _handle_keyboard_action(args, as_json)

    if sub in ("ground-lane", "resolve-grounding-lane"):
        print(json.dumps(resolve_grounding_lane(), indent=2 if as_json else None))
        return 0

    ep = _executor_endpoint()
    if ep:
        if _endpoint_up(ep):
            return _route_remote(ep, sub, args, as_json)
        _die(f"computer-use executor {ep} configured but unreachable (no blind local fallback)")

    if _have_wayland():
        if sub == "screenshot":
            return _capture(args[0] if args else _die("screenshot needs <out-path>"))
        if sub == "atspi-query":
            return _atspi_query(args[0] if args else _die("atspi-query needs a query"), as_json)
        if sub == "cu_act":
            return _cu_act(args[0] if args else _die("cu_act needs a query"), args[1] if len(args) > 1 else "left", as_json)
        if sub == "ground":
            return _ground(args[0] if args else _die("ground needs a query"), as_json)
        if sub in INPUT_ACTIONS:
            return _do_input(sub, args)
        if sub == "window-list":
            return _list_windows(as_json)
        if sub in WINDOW_ACTIONS:
            _die(f"{sub} not yet implemented for Wayland (compositor-specific; "
                 f"use window-list + focus via wmctrl/hyprctl)")
        _die(f"unknown subcommand: {sub}")

    if _is_wsl():
        return _delegate_pc_control(sub, args, as_json)

    _die("no desktop backend: no WAYLAND_DISPLAY, no configured executor, not WSL2")
    return 1


if __name__ == "__main__":
    sys.exit(main())
