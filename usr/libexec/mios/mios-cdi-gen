#!/usr/bin/env python3
# AI-hint: Scoped CDI specification generator for NVIDIA, AMD, and Intel rootless Podman containers (task_469).
# AI-doc: usr/share/doc/mios/manual/ch14-cdi-gpu-passthrough-and-isolation.md
from __future__ import annotations

import argparse
import glob
import json
import os
import sys
from typing import Any, Dict, List, Optional


def find_nvidia_devices() -> Dict[str, Any]:
    """Inspects NVIDIA character devices."""
    devices: Dict[str, Any] = {
        "common": [],
        "instances": {},
    }
    # Common control and memory management devices
    for dev in ["/dev/nvidiactl", "/dev/nvidia-uvm", "/dev/nvidia-uvm-tools", "/dev/nvidia-modeset"]:
        if os.path.exists(dev):
            devices["common"].append(dev)

    # Per-GPU device nodes
    gpu_devs = sorted(glob.glob("/dev/nvidia[0-9]*"))
    for idx, path in enumerate(gpu_devs):
        name = os.path.basename(path).replace("nvidia", "")
        devices["instances"][name] = {
            "path": path,
            "index": idx,
        }
    return devices


def find_dri_devices(vendor_id: Optional[str] = None) -> List[Dict[str, str]]:
    """Inspects Direct Rendering Infrastructure (DRI) nodes for AMD (0x1002) or Intel (0x8086)."""
    matches: List[Dict[str, str]] = []
    render_nodes = sorted(glob.glob("/dev/dri/renderD[0-9]*"))

    for node in render_nodes:
        card_name = os.path.basename(node)
        sys_pci = f"/sys/class/drm/{card_name}/device"
        vendor_file = os.path.join(sys_pci, "vendor")

        detected_vendor = ""
        if os.path.isfile(vendor_file):
            try:
                with open(vendor_file, "r") as f:
                    detected_vendor = f.read().strip().lower()
            except OSError:
                pass

        if vendor_id and detected_vendor and detected_vendor != vendor_id.lower():
            continue

        # Look for corresponding cardX node
        card_node = ""
        card_candidates = glob.glob(f"/sys/class/drm/{card_name}/device/drm/card*")
        if card_candidates:
            card_base = os.path.basename(card_candidates[0])
            card_path = f"/dev/dri/{card_base}"
            if os.path.exists(card_path):
                card_node = card_path

        matches.append({
            "render": node,
            "card": card_node,
            "vendor": detected_vendor,
        })
    return matches


def build_nvidia_cdi_spec(nvidia_info: Dict[str, Any], scoped: bool = True) -> Dict[str, Any]:
    """Constructs CDI specification according to Container Device Interface spec v0.6.0."""
    spec: Dict[str, Any] = {
        "cdiVersion": "0.6.0",
        "kind": "nvidia.com/gpu",
        "devices": [],
    }

    common_nodes = [{"path": p} for p in nvidia_info["common"]]

    if not nvidia_info["instances"]:
        # Fallback if no specific GPUs found or in virtual environment
        if os.path.exists("/dev/dxg"):
            spec["devices"].append({
                "name": "all",
                "containerEdits": {
                    "deviceNodes": [{"path": "/dev/dxg"}],
                    "mounts": [{
                        "hostPath": "/usr/lib/wsl",
                        "containerPath": "/usr/lib/wsl",
                        "options": ["ro", "nosuid", "nodev", "rbind"],
                    }],
                },
            })
            return spec

        # Scoped default nodes for container / virtual build environment
        default_devs = [
            {"path": "/dev/nvidia0"},
            {"path": "/dev/nvidiactl"},
            {"path": "/dev/nvidia-uvm"},
        ]
        spec["devices"].append({
            "name": "0",
            "containerEdits": {"deviceNodes": default_devs},
        })
        spec["devices"].append({
            "name": "all",
            "containerEdits": {"deviceNodes": default_devs},
        })
        return spec

    # Per-GPU scoped definitions
    for name, info in nvidia_info["instances"].items():
        dev_nodes = [{"path": info["path"]}] + common_nodes
        spec["devices"].append({
            "name": str(name),
            "containerEdits": {
                "deviceNodes": dev_nodes,
            },
        })

    # "all" composite definition
    all_nodes = [{"path": info["path"]} for info in nvidia_info["instances"].values()] + common_nodes
    spec["devices"].append({
        "name": "all",
        "containerEdits": {
            "deviceNodes": all_nodes,
        },
    })
    return spec


def build_amd_cdi_spec(dri_nodes: List[Dict[str, str]]) -> Dict[str, Any]:
    """Constructs CDI specification for AMD GPUs including KFD."""
    spec: Dict[str, Any] = {
        "cdiVersion": "0.6.0",
        "kind": "amd.com/gpu",
        "devices": [],
    }

    kfd_node = [{"path": "/dev/kfd"}] if os.path.exists("/dev/kfd") else []

    for idx, node in enumerate(dri_nodes):
        dev_nodes = [{"path": node["render"]}]
        if node["card"]:
            dev_nodes.append({"path": node["card"]})
        dev_nodes.extend(kfd_node)

        spec["devices"].append({
            "name": str(idx),
            "containerEdits": {
                "deviceNodes": dev_nodes,
            },
        })

    if dri_nodes:
        all_nodes = []
        for n in dri_nodes:
            all_nodes.append({"path": n["render"]})
            if n["card"]:
                all_nodes.append({"path": n["card"]})
        all_nodes.extend(kfd_node)
        spec["devices"].append({
            "name": "all",
            "containerEdits": {
                "deviceNodes": all_nodes,
            },
        })
    else:
        default_amd = [{"path": "/dev/dri/renderD128"}]
        if os.path.exists("/dev/kfd"):
            default_amd.append({"path": "/dev/kfd"})
        spec["devices"].append({"name": "0", "containerEdits": {"deviceNodes": default_amd}})
        spec["devices"].append({"name": "all", "containerEdits": {"deviceNodes": default_amd}})
    return spec


def build_intel_cdi_spec(dri_nodes: List[Dict[str, str]]) -> Dict[str, Any]:
    """Constructs CDI specification for Intel GPUs."""
    spec: Dict[str, Any] = {
        "cdiVersion": "0.6.0",
        "kind": "intel.com/gpu",
        "devices": [],
    }

    for idx, node in enumerate(dri_nodes):
        dev_nodes = [{"path": node["render"]}]
        if node["card"]:
            dev_nodes.append({"path": node["card"]})

        spec["devices"].append({
            "name": str(idx),
            "containerEdits": {
                "deviceNodes": dev_nodes,
            },
        })

    if dri_nodes:
        all_nodes = []
        for n in dri_nodes:
            all_nodes.append({"path": n["render"]})
            if n["card"]:
                all_nodes.append({"path": n["card"]})
        spec["devices"].append({
            "name": "all",
            "containerEdits": {
                "deviceNodes": all_nodes,
            },
        })
    else:
        default_intel = [{"path": "/dev/dri/renderD128"}]
        spec["devices"].append({"name": "0", "containerEdits": {"deviceNodes": default_intel}})
        spec["devices"].append({"name": "all", "containerEdits": {"deviceNodes": default_intel}})
    return spec


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Scoped CDI specification generator for NVIDIA, AMD, and Intel rootless Podman containers (task_469)"
    )
    parser.add_argument("--output-dir", default="/etc/cdi", help="Destination directory for CDI JSON specifications")
    parser.add_argument("--vendor", choices=["auto", "nvidia", "amd", "intel", "all"], default="auto")
    parser.add_argument("--dry-run", action="store_true", help="Simulate generation without writing files")
    parser.add_argument("--json", action="store_true", help="Output summary in JSON format")

    args = parser.parse_args()

    out_dir = args.output_dir
    if not args.dry_run and not os.path.exists(out_dir):
        try:
            os.makedirs(out_dir, mode=0o755, exist_ok=True)
        except OSError as e:
            # Fallback to /run/cdi if /etc/cdi not writable by current user
            out_dir = "/run/cdi"
            os.makedirs(out_dir, mode=0o755, exist_ok=True)

    generated: Dict[str, Any] = {}

    # 1. NVIDIA
    if args.vendor in ("auto", "nvidia", "all"):
        nv_info = find_nvidia_devices()
        if nv_info["instances"] or os.path.exists("/dev/dxg") or args.vendor in ("nvidia", "all"):
            spec = build_nvidia_cdi_spec(nv_info)
            target = os.path.join(out_dir, "nvidia.json")
            generated["nvidia"] = {
                "target": target,
                "devices": len(spec["devices"]),
                "spec": spec,
            }
            if not args.dry_run:
                with open(target, "w") as f:
                    json.dump(spec, f, indent=2)

    # 2. AMD
    if args.vendor in ("auto", "amd", "all"):
        amd_nodes = find_dri_devices(vendor_id="0x1002")
        if amd_nodes or os.path.exists("/dev/kfd") or args.vendor in ("amd", "all"):
            spec = build_amd_cdi_spec(amd_nodes)
            target = os.path.join(out_dir, "amd.json")
            generated["amd"] = {
                "target": target,
                "devices": len(spec["devices"]),
                "spec": spec,
            }
            if not args.dry_run:
                with open(target, "w") as f:
                    json.dump(spec, f, indent=2)

    # 3. Intel
    if args.vendor in ("auto", "intel", "all"):
        intel_nodes = find_dri_devices(vendor_id="0x8086")
        if intel_nodes or args.vendor in ("intel", "all"):
            spec = build_intel_cdi_spec(intel_nodes)
            target = os.path.join(out_dir, "intel.json")
            generated["intel"] = {
                "target": target,
                "devices": len(spec["devices"]),
                "spec": spec,
            }
            if not args.dry_run:
                with open(target, "w") as f:
                    json.dump(spec, f, indent=2)

    result = {
        "status": "success",
        "dry_run": args.dry_run,
        "output_dir": out_dir,
        "generated": list(generated.keys()),
        "specs": generated,
    }

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"[cdi-gen] Generated {len(generated)} CDI spec(s) in {out_dir}")
        for vendor, details in generated.items():
            print(f"  - {vendor}: {details['target']} ({details['devices']} device entry/entries)")

    return 0


if __name__ == "__main__":
    sys.exit(main())
