#!/usr/bin/env python3
# AI-hint: Generate CDI only for currently host-bound character devices; NVIDIA specs come intact from its official toolkit.
# AI-doc: usr/share/doc/mios/manual/ch14-cdi-gpu-passthrough-and-isolation.md
# AI-related: tests/test-cdi-gen.py, tests/test-cdi-device-isolate.sh, usr/share/mios/mios.toml
from __future__ import annotations

import argparse
import glob
import fcntl
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from typing import Any, Dict, List, Optional


def _read_text(path: str) -> str:
    try:
        with open(path, encoding="utf-8") as source:
            return source.read().strip()
    except OSError:
        return ""


def _is_character_device(path: str) -> bool:
    try:
        return stat.S_ISCHR(os.stat(path).st_mode)
    except OSError:
        return False


def _driver(device: str) -> str:
    try:
        return os.path.basename(os.readlink(os.path.join(device, "driver")))
    except OSError:
        return ""


def _nvidia_host_pci() -> List[str]:
    return [pci for pci in sorted(glob.glob("/sys/bus/pci/devices/*"))
            if _read_text(pci + "/vendor").lower() == "0x10de"
            and _read_text(pci + "/class").lower().startswith("0x03")
            and _driver(pci) == "nvidia"]


def nvidia_host_owned() -> bool:
    # Refresh may create missing nodes after a verified host driver bind. WSL
    # has no Linux NVIDIA PCI binding and uses the real dxg character device.
    return bool(_nvidia_host_pci()) or _is_character_device("/dev/dxg")


def find_nvidia_devices() -> Dict[str, Any]:
    """Correlate a freshly bound PCI GPU, driver minor and actual device node."""
    devices: Dict[str, Any] = {"common": [], "instances": {},
                               "wsl": _is_character_device("/dev/dxg")}
    for path in ("/dev/nvidiactl", "/dev/nvidia-uvm", "/dev/nvidia-uvm-tools", "/dev/nvidia-modeset"):
        if _is_character_device(path):
            devices["common"].append(path)
    for pci in _nvidia_host_pci():
        address = os.path.basename(pci)
        info = _read_text(f"/proc/driver/nvidia/gpus/{address}/information")
        minor = re.search(r"^Device Minor:\s*(\d+)\s*$", info, re.MULTILINE)
        if not minor:
            continue
        name = minor.group(1)
        path = "/dev/nvidia" + name
        if _is_character_device(path) and "/dev/nvidiactl" in devices["common"]:
            devices["instances"][name] = {"path": path, "index": int(name), "pci": address}
    return devices


def find_dri_devices(vendor_id: Optional[str] = None) -> List[Dict[str, str]]:
    """Unknown vendors, detached drivers and regular files are never GPU evidence."""
    matches: List[Dict[str, str]] = []
    drivers = {"0x1002": {"amdgpu"}, "0x8086": {"i915", "xe"}}
    for node in sorted(glob.glob("/dev/dri/renderD[0-9]*")):
        if not _is_character_device(node):
            continue
        pci = f"/sys/class/drm/{os.path.basename(node)}/device"
        detected = _read_text(pci + "/vendor").lower()
        if (vendor_id and detected != vendor_id.lower()) or _driver(pci) not in drivers.get(detected, set()):
            continue
        card = ""
        for candidate in sorted(glob.glob(pci + "/drm/card*")):
            path = "/dev/dri/" + os.path.basename(candidate)
            if _is_character_device(path):
                card = path
                break
        matches.append({"render": node, "card": card, "vendor": detected})
    return matches


def _empty_spec(kind: str) -> Dict[str, Any]:
    return {"cdiVersion": "0.6.0", "kind": kind, "devices": []}


def build_nvidia_cdi_spec(nvidia_info: Dict[str, Any], scoped: bool = True) -> Dict[str, Any]:
    """Keep the official driver library mounts, hooks, aliases and common edits intact."""
    if not nvidia_info["instances"] and not nvidia_info.get("wsl", False):
        return _empty_spec("nvidia.com/gpu")
    toolkit = shutil.which("nvidia-ctk")
    if toolkit is None:
        raise RuntimeError("NVIDIA hardware is host-bound but nvidia-ctk is unavailable")
    # An explicit empty output overrides NVIDIA_CTK_CDI_OUTPUT_FILE_PATH even in
    # dry-run mode. NVML/WSL discovery cannot be replaced by a fabricated CSV list.
    mode = "wsl" if nvidia_info.get("wsl", False) and not nvidia_info["instances"] else "nvml"
    command = [toolkit, "cdi", "generate", "--format=json", "--output=", "--mode=" + mode, "--device-id=all"]
    result = subprocess.run(command, text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError("nvidia-ctk CDI generation failed: " + result.stderr.strip())
    try:
        spec = json.loads(result.stdout)
    except (TypeError, ValueError) as error:
        raise RuntimeError("nvidia-ctk returned invalid CDI JSON") from error
    if (not isinstance(spec, dict) or spec.get("kind") != "nvidia.com/gpu"
            or not isinstance(spec.get("cdiVersion"), str) or not spec["cdiVersion"]):
        raise RuntimeError("nvidia-ctk returned an unexpected CDI kind")
    devices = spec.get("devices")
    if not isinstance(devices, list) or not devices:
        raise RuntimeError("nvidia-ctk returned no NVIDIA CDI devices")
    edits = [spec.get("containerEdits", {})]
    for device in devices:
        if not isinstance(device, dict) or not isinstance(device.get("name"), str) or not device["name"]:
            raise RuntimeError("nvidia-ctk returned an invalid CDI device")
        edits.append(device.get("containerEdits", {}))
    if not all(isinstance(edit, dict) for edit in edits):
        raise RuntimeError("nvidia-ctk returned invalid container edits")
    for edit in edits:
        for key in ("mounts", "hooks", "deviceNodes"):
            if key in edit and not isinstance(edit[key], list):
                raise RuntimeError("nvidia-ctk returned invalid " + key)
    mounts = [mount for edit in edits for mount in edit.get("mounts", [])]
    hooks = [hook for edit in edits for hook in edit.get("hooks", [])]
    if not mounts or not hooks:
        raise RuntimeError("nvidia-ctk CDI is missing driver mounts or runtime hooks")
    for mount in mounts:
        path = mount.get("hostPath", "") if isinstance(mount, dict) else ""
        if not isinstance(path, str) or not os.path.isabs(path) or not os.path.exists(path):
            raise RuntimeError("nvidia-ctk CDI refers to a missing driver mount")
    for hook in hooks:
        path = hook.get("path", "") if isinstance(hook, dict) else ""
        if not isinstance(path, str) or not os.path.isabs(path) or not os.path.isfile(path) or not os.access(path, os.X_OK):
            raise RuntimeError("nvidia-ctk CDI refers to an unavailable runtime hook")
    known = {info["path"] for info in nvidia_info["instances"].values()}
    if nvidia_info.get("wsl", False):
        known.add("/dev/dxg")
    all_nodes = []
    for edit in edits:
        for node in edit.get("deviceNodes", []):
            if not isinstance(node, dict):
                raise RuntimeError("nvidia-ctk CDI has an invalid device node")
            path = node.get("hostPath") or node.get("path", "")
            if not isinstance(path, str) or not os.path.isabs(path) or not _is_character_device(path):
                raise RuntimeError("nvidia-ctk CDI refers to an unavailable character device: " + path)
            all_nodes.append(path)
    required_controls = set(nvidia_info["common"]).intersection({"/dev/nvidiactl", "/dev/nvidia-uvm"})
    if not required_controls.issubset(all_nodes):
        raise RuntimeError("nvidia-ctk CDI omits a required NVIDIA control device")
    if not known.issubset(all_nodes):
        raise RuntimeError("nvidia-ctk CDI does not identify every probed NVIDIA device")
    if any(re.fullmatch(r"/dev/nvidia[0-9]+", path) and path not in known for path in all_nodes):
        raise RuntimeError("nvidia-ctk CDI advertises an unprobed NVIDIA device")
    # Binding may have changed while the toolkit inspected the driver.
    fresh = find_nvidia_devices()
    if fresh != nvidia_info:
        raise RuntimeError("NVIDIA ownership changed during CDI generation")
    return spec


def _build_dri_spec(dri_nodes: List[Dict[str, str]], vendor: str) -> Dict[str, Any]:
    spec = _empty_spec(vendor + ".com/gpu")
    if dri_nodes != find_dri_devices("0x1002" if vendor == "amd" else "0x8086"):
        raise RuntimeError("DRM ownership changed during CDI generation")
    kfd = [{"path": "/dev/kfd"}] if vendor == "amd" and _is_character_device("/dev/kfd") else []
    all_nodes = []
    for index, node in enumerate(dri_nodes):
        paths = [node["render"]] + ([node["card"]] if node["card"] else [])
        if not all(_is_character_device(path) for path in paths):
            raise RuntimeError("DRM ownership changed during CDI generation")
        nodes = [{"path": path} for path in paths] + kfd
        spec["devices"].append({"name": str(index), "containerEdits": {"deviceNodes": nodes}})
        for entry in nodes:
            if entry not in all_nodes:
                all_nodes.append(entry)
    if all_nodes:
        spec["devices"].append({"name": "all", "containerEdits": {"deviceNodes": all_nodes}})
    return spec


def build_amd_cdi_spec(dri_nodes: List[Dict[str, str]]) -> Dict[str, Any]:
    return _build_dri_spec(dri_nodes, "amd")


def build_intel_cdi_spec(dri_nodes: List[Dict[str, str]]) -> Dict[str, Any]:
    return _build_dri_spec(dri_nodes, "intel")


def _publish(target: str, spec: Dict[str, Any]) -> None:
    if os.path.islink(target):
        raise RuntimeError("refusing linked CDI target: " + target)
    descriptor, temporary = tempfile.mkstemp(prefix=".mios-cdi-", dir=os.path.dirname(target))
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(spec, output, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
            os.fchmod(output.fileno(), 0o644)
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _filename(vendor: str) -> str:
    # Match the upstream refresh service and the canonical gpu.cdi.nvidia spec.
    return "nvidia.yaml" if vendor == "nvidia" else vendor + ".json"


def _digest(path: str) -> str:
    if os.path.islink(path) or not os.path.isfile(path):
        raise RuntimeError("refusing non-regular CDI target: " + path)
    if os.stat(path).st_uid != os.geteuid():
        raise RuntimeError("refusing foreign-owned CDI target: " + path)
    with open(path, "rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


def _load_state(path: str) -> Dict[str, Any]:
    if not os.path.lexists(path):
        return {"owner": "mios-cdi-gen", "version": 1, "files": {}}
    if os.path.islink(path) or not os.path.isfile(path):
        raise RuntimeError("refusing non-regular CDI ownership state: " + path)
    if os.stat(path).st_uid != os.geteuid():
        raise RuntimeError("refusing foreign-owned CDI ownership state: " + path)
    with open(path, encoding="utf-8") as source:
        state = json.load(source)
    names = {"nvidia.yaml", "nvidia.json", "amd.json", "intel.json"}
    if (not isinstance(state, dict) or state.get("owner") != "mios-cdi-gen"
            or state.get("version") != 1 or not isinstance(state.get("files"), dict)
            or any(name not in names or not isinstance(digest, str)
                   or re.fullmatch("[a-f0-9]{64}", digest) is None
                   for name, digest in state["files"].items())):
        raise RuntimeError("unrecognized CDI ownership state: " + path)
    return state


def _reconcile(output_dir: str, selected: tuple, generated: Dict[str, Any]) -> List[str]:
    """Only this producer's unchanged, recorded output can be replaced or removed."""
    if not generated and not os.path.exists(output_dir):
        return []
    os.makedirs(output_dir, mode=0o755, exist_ok=True)
    descriptor = os.open(os.path.join(output_dir, ".mios-cdi-lock"),
                         os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid():
            raise RuntimeError("CDI lock must be a regular file owned by the current user")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        state_path = os.path.join(output_dir, ".mios-cdi-state")
        state = _load_state(state_path)
        # Check every affected file before changing any: an unmarked legacy
        # output or an administrator edit needs a reviewed migration, not a guess.
        for vendor in selected:
            names = [_filename(vendor)] + (["nvidia.json"] if vendor == "nvidia" else [])
            for name in names:
                target = os.path.join(output_dir, name)
                if os.path.lexists(target):
                    recorded = state["files"].get(name)
                    if recorded is None:
                        raise RuntimeError("refusing unmanaged CDI target: " + target)
                    if _digest(target) != recorded:
                        raise RuntimeError("preserving modified CDI target: " + target)
        published = []
        for vendor in selected:
            name = _filename(vendor)
            target = os.path.join(output_dir, name)
            if vendor in generated:
                _publish(target, generated[vendor]["spec"])
                state["files"][name] = _digest(target)
                published.append(target)
            else:
                if os.path.lexists(target):
                    os.unlink(target)
                state["files"].pop(name, None)
            if vendor == "nvidia":
                legacy = os.path.join(output_dir, "nvidia.json")
                if os.path.lexists(legacy):
                    os.unlink(legacy)
                state["files"].pop("nvidia.json", None)
        _publish(state_path, state)
        return published
    finally:
        os.close(descriptor)


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate CDI for probed, host-bound GPU devices")
    parser.add_argument("--output-dir", default="/etc/cdi", help="Destination directory for CDI specifications")
    parser.add_argument("--vendor", choices=["auto", "nvidia", "amd", "intel", "all"], default="auto")
    parser.add_argument("--dry-run", action="store_true", help="Inspect hardware and preview specs without writing files")
    parser.add_argument("--json", action="store_true", help="Output summary in JSON format")
    parser.add_argument("--check-nvidia-owner", action="store_true",
                        help="Check current host NVIDIA ownership without generating or writing CDI")
    args = parser.parse_args()
    if args.check_nvidia_owner:
        owned = nvidia_host_owned()
        if args.json:
            print(json.dumps({"host_owned": owned, "status": "available" if owned else "unavailable"}))
        return 0 if owned else 1
    selected = ("nvidia", "amd", "intel") if args.vendor in ("auto", "all") else (args.vendor,)
    generated: Dict[str, Any] = {}
    unavailable: Dict[str, str] = {}
    errors: Dict[str, str] = {}
    for vendor in selected:
        try:
            if vendor == "nvidia":
                evidence = find_nvidia_devices()
                spec = build_nvidia_cdi_spec(evidence)
            else:
                nodes = find_dri_devices("0x1002" if vendor == "amd" else "0x8086")
                spec = build_amd_cdi_spec(nodes) if vendor == "amd" else build_intel_cdi_spec(nodes)
            if not spec["devices"]:
                unavailable[vendor] = "no matching host-bound character devices"
                continue
            generated[vendor] = {"target": os.path.join(args.output_dir, _filename(vendor)),
                                 "devices": len(spec["devices"]), "spec": spec}
        except (OSError, RuntimeError, ValueError) as error:
            errors[vendor] = str(error)
    published: List[str] = []
    if not args.dry_run:
        try:
            published = _reconcile(args.output_dir, selected, generated)
        except (OSError, RuntimeError, ValueError) as error:
            errors["output"] = str(error)
    failed = bool(errors) or (args.vendor not in ("auto", "all") and args.vendor in unavailable)
    result = {"status": "error" if errors else ("unavailable" if failed else "success"),
              "dry_run": args.dry_run, "output_dir": args.output_dir,
              "generated": list(generated), "specs": generated, "published": published,
              "unavailable": unavailable, "errors": errors}
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f"[cdi-gen] {result['status']}: {len(generated)} available CDI spec(s) in {args.output_dir}")
        for vendor, reason in {**unavailable, **errors}.items():
            print(f"  {vendor}: {reason}", file=sys.stderr)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
