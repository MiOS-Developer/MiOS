def check_footer_tools(state_name, state, rail_box):
    errs = []
    tools = state.get("tools") or []
    inner_h = (state.get("inner") or {}).get("h", 0)
    rail_right = (rail_box or {}).get("right", 0)
    if len(tools) < 3:
        errs.append(f"{state_name}: apps footer has {len(tools)} button(s), expected >= 3 MiOS apps: {tools}")
        return errs
    for b in tools:
        v = str(b.get("view") or "")
        if v in FIREFOX_BUILTIN_TOOLS or not v.startswith("mios-app-") or not b.get("miosApp"):
            errs.append(f"{state_name}: footer button {v!r} is a Firefox built-in tool, not a MiOS app: {b}")
        in_bounds = (
            b.get("shown")
            and b.get("w", 0) > 0
            and b.get("h", 0) > 0
            and b.get("x", -1) >= -0.5
            and b.get("y", -1) >= -0.5
            and b.get("y", 0) + b.get("h", 0) <= inner_h + 0.5
            and b.get("x", 0) + b.get("w", 0) <= rail_right + 0.5
        )
        if not in_bounds:
            errs.append(
                f"{state_name}: footer MiOS app {v!r} is clipped or off-screen "
                f"(box={b}, window_h={inner_h}, rail_right={rail_right})"
            )
    return errs


def check_chat_surface(rv_state):
    errs = []
    chat = rv_state.get("chat") or {}
    sbr = (rv_state.get("boxes") or {}).get("#sidebar-box") or {}
    inner_h = (rv_state.get("inner") or {}).get("h", 0)
    href = str(chat.get("href") or "")
    valid_href = (
        href.startswith("chrome://browser/content/aiwindow/aiWindow.html")
        or href.startswith("chrome://browser/content/genai/chat.html")
    )
    if not chat.get("loaded") or not valid_href:
        errs.append(f"chat-revealed: chat document not loaded: {chat}")
        return errs
    if chat.get("summarizeShown"):
        errs.append(f"chat-revealed: Firefox 'Summarize page' button (#summarize-button) is still visible: {chat}")
    if chat.get("hasNotFound"):
        errs.append(f"chat-revealed: chat panel contains 'Not Found' 404 error text: {chat}")
    if chat.get("remoteBrowserShown"):
        errs.append(f"chat-revealed: nested remote <browser> is still visible in #browser-container: {chat}")
    for key, min_w in (("panel", 150), ("messages", 150), ("input", 100), ("send", 30)):
        box = chat.get(key) or {}
        ok = (
            box.get("shown")
            and box.get("w", 0) >= min_w
            and box.get("h", 0) >= 20
            and box.get("x", -1) >= sbr.get("x", 0) - 2
            and box.get("x", 0) + box.get("w", 0) <= sbr.get("right", 0) + 2
            and box.get("y", 0) + box.get("h", 0) <= inner_h + 2
        )
        if not ok:
            errs.append(f"chat-revealed: chat {key!r} is missing, hidden, or out of #sidebar-box bounds: {box} vs {sbr}")
    if chat.get("smartWindow") or "modelSelect" in chat:
        ms = chat.get("modelSelect") or {}
        ms_ok = (
            ms.get("shown")
            and ms.get("w", 0) >= 40
            and ms.get("h", 0) >= 18
            and ms.get("miosAi") is True
        )
        if not ms_ok:
            errs.append(f"chat-revealed: native Smart Window MiOS-AI model selector invalid or hidden: {ms}")
    return errs


def _settle(inst, layout, extra=0.0):
    time.sleep(max(1.2, 3 * float(layout["chat_transition_ms"]) / 1000.0) + extra)


def cmd_layout(args):
    spec = ssot()
    L = spec["layout"]
    out = os.path.abspath(args.out)
    os.makedirs(out, exist_ok=True)
    app = args.app or spec["gecko"]["install_dir"]
    peek, width = int(L["chat_peek_px"]), int(L["chat_width_px"])
    problems, states, shots = [], {}, {}

    def check(cond, msg):
        if not cond:
            problems.append(msg)

    with Instance(app, spec["gecko"]["binary"], out, args.url or spec["home_url"], args.width, args.height,
                  args.memory) as inst:
        inst.wait_started()
        _settle(inst, L, 2.0)
        seq = (("tabs-collapsed", (0.5, 0.5)),
               ("tabs-expanded", (8, 0.5)),
               ("chat-revealed", (-max(1, peek // 2), 0.5)),
               ("chat-hidden", (0.5, 0.5)))
        for name, (x, y) in seq:
            inst.hover(x, y)
            _settle(inst, L)
            states[name] = inst.m.js(_MEASURE)
            png = inst.m.screenshot()
            shots[name] = hashlib.sha256(png).hexdigest()
            with open(os.path.join(out, f"{name}.png"), "wb") as fh:
                fh.write(png)
        # Verify sidebar height grows dynamically when a second tab is opened.
        inst.m.js(
            "gBrowser.addTab(arguments[0], {triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal()});"
            "return gBrowser.tabs.length;",
            [args.url or spec["home_url"]]
        )
        time.sleep(0.4)
        states["tabs-two-tabs"] = inst.m.js(_MEASURE)
        inst.sample_pids()
    scope_after = inst.scope_after

    c, e, rv, hd, t2 = (
        states["tabs-collapsed"],
        states["tabs-expanded"],
        states["chat-revealed"],
        states["chat-hidden"],
        states["tabs-two-tabs"],
    )
    W, H = c["inner"]["w"], c["inner"]["h"]
    B = lambda st, k: st["boxes"].get(k) or {}
    # Vertical tabs on the start side, horizontal strip gone, floating and scaling with tab count.
    if L["vertical_tabs"]:
        check(c["prefs"]["sidebar.verticalTabs"] is True, f"sidebar.verticalTabs is {c['prefs']['sidebar.verticalTabs']} (SSOT vertical_tabs=true)")
        vt = B(c, "#vertical-tabs")
        check(vt and not vt.get("hidden") and vt.get("w", 0) > 0 and vt.get("h", 0) >= 60, f"#vertical-tabs not rendered as a rail: {vt}")
        ts = B(c, "#TabsToolbar")
        check(not ts or ts.get("hidden") or ts.get("h", 0) <= 1, f"horizontal #TabsToolbar still rendered: {ts}")
    sc, tb = B(c, "#sidebar-container"), B(c, "#tabbrowser-tabbox")
    if L["tabs_at_start"]:
        check(sc and abs(sc.get("x", -1)) < 1,
              f"tab rail is not on the start side: rail {sc}, page {tb}")
    # Floating Hyprglass left rail: does not stretch full window height, and grows when a tab is added.
    check(sc.get("y", 0) > 20 and sc.get("h", H) < H - 40,
          f"left Zen Sidebar is not floating (expected y > 20 and h < {H - 40}): {sc}")
    wbox = c.get("wrapperBox") or {}
    check("blur" in str(wbox.get("backdropFilter") or ""),
          f"left Zen Sidebar .wrapper lacks Hyprglass backdrop-filter blur: {wbox}")
    sc2 = B(t2, "#sidebar-container")
    check(sc2.get("h", 0) >= sc.get("h", 0) + 25,
          f"left Zen Sidebar height did not grow with tab count (1 tab={sc.get('h')}px vs 2 tabs={sc2.get('h')}px)")
    # Collapsible: hovering the rail expands it (apps footer visible), leaving collapses it.
    check(not c["expanded"] and e["expanded"], f"rail expanded state collapsed={c['expanded']} hovered={e['expanded']} (want False/True)")
    sce = B(e, "#sidebar-container")
    check(sce.get("w", 0) > sc.get("w", 0) + 40, f"rail width collapsed {sc.get('w')} vs expanded {sce.get('w')}")
    # Full-frame webpage: spans the entire Portal window frame (0..W, 0..H) in every state.
    pc, pe = c["content"], e["content"]
    check(abs(pc["x"]) <= 1 and abs(pc["right"] - W) <= 1 and abs(pc["y"]) <= 1 and abs(pc["h"] - H) <= 1,
          f"webpage does not fill the entire Portal window frame (0..{W}, 0..{H}): {pc}")
    check(abs(pe["w"] - W) <= 1 and abs(pe["h"] - H) <= 1,
          f"expanding the floating rail shrank the full-frame webpage: {pe}")
    problems.extend(check_footer_tools("tabs-collapsed", c, sc))
    problems.extend(check_footer_tools("tabs-expanded", e, sce))
    problems.extend(check_chat_surface(rv))
    check(bool((rv.get("chat") or {}).get("smartWindow")),
          f"chat panel is not running native Smart Window (aiWindow.html): {rv.get('chat')}")
    # Chat on the end side, auto-hidden to a peek strip, overlaying the page.
    if L["chat_at_end"]:
        for name, st in (("chat-hidden", hd), ("chat-revealed", rv)):
            sb = B(st, "#sidebar-box")
            check(sb and not sb.get("hidden"), f"{name}: chat panel (#sidebar-box) is not open")
        sbr = B(rv, "#sidebar-box")
        check(abs(sbr.get("right", 0) - W) < 1 and sbr.get("x", 0) > B(rv, "#tabbrowser-tabbox").get("x", 0),
              f"chat panel is not on the end side: {sbr}")
        check(str(rv["sidebarId"]) == "viewGenaiChatSidebar", f"the open sidebar panel is {rv['sidebarId']}, not the chat")
    if L["chat_autohide"]:
        sbh, sbr = B(hd, "#sidebar-box"), B(rv, "#sidebar-box")
        vis_h, vis_r = W - sbh.get("x", W), W - sbr.get("x", W)
        check(abs(vis_h - peek) <= 1, f"hidden chat shows {vis_h:.1f}px, SSOT chat_peek_px={peek}")
        check(abs(sbh.get("opacity", -1) - float(L["chat_peek_opacity"])) < 0.02,
              f"hidden chat opacity {sbh.get('opacity')}, SSOT chat_peek_opacity={L['chat_peek_opacity']}")
        check(abs(vis_r - width) <= 1 and abs(sbr.get("w", 0) - width) <= 1,
              f"revealed chat is {vis_r:.1f}px visible / {sbr.get('w')}px wide, SSOT chat_width_px={width}")
        check(abs(sbr.get("opacity", 0) - 1.0) < 0.02, f"revealed chat opacity {sbr.get('opacity')}")
        check(abs(rv["content"]["w"] - hd["content"]["w"]) < 1, "revealing the chat resized the page (it must overlay it)")
    if L["hide_window_controls"]:
        bb = B(c, ".titlebar-buttonbox-container")
        check(not bb or bb.get("hidden"), f"window controls are rendered: {bb}")
    if int(L["uidensity"]) == 1:
        check(c["uidensity"] == "compact", f"uidensity attribute is {c['uidensity']!r}, SSOT uidensity=1 (compact)")
    check(c["prefs"]["browser.ml.chat.provider"] == spec["chat_url"],
          f"browser.ml.chat.provider {c['prefs']['browser.ml.chat.provider']!r} is not SSOT chat_url {spec['chat_url']!r}")
    check(c["prefs"]["browser.smartwindow.endpoint"] == spec["chat_url"],
          f"browser.smartwindow.endpoint {c['prefs']['browser.smartwindow.endpoint']!r} is not SSOT chat_url {spec['chat_url']!r}")
    check(c["autoconfig"]["file"] and c["autoconfig"]["lockedServer"],
          f"the autoconfig file did not run (general.config.filename={c['autoconfig']['file']!r}, lockPref not applied)")
    # The screenshots of opposite states must differ.
    check(shots["tabs-collapsed"] != shots["tabs-expanded"], "tabs-collapsed and tabs-expanded screenshots are identical")
    check(shots["chat-hidden"] != shots["chat-revealed"], "chat-hidden and chat-revealed screenshots are identical")
    check(scope_after in ("gone", "inactive", "failed"), f"probe scope still {scope_after} after quit")

    result = {"mode": "layout", "app": app, "ssot_layout": L, "chat_url": spec["chat_url"], "screenshots": shots,
              "states": states, "scope_after": scope_after, "problems": problems, "ok": not problems}
    with open(os.path.join(out, "result.json"), "w", encoding="utf-8") as fh:
        json.dump(result, fh, indent=2, default=str)
    for p in problems:
        sys.stderr.write(f"[mios-portal-probe] layout: {p}\n")
    print(f"[mios-portal-probe] layout {'OK' if not problems else 'FAILED'}: {len(problems)} problem(s); "
          + ", ".join(f"{k}={v[:12]}" for k, v in shots.items()) + f"; scope {scope_after}")
    return 0 if not problems else 1


# ------------------------------------------------------------------ egress
def _proc_net(kind):
    """{inode: (remote_ip, remote_port, state)} for /proc/net/<kind> (the probe's network namespace)."""
    out = {}
    try:
        with open(f"/proc/net/{kind}", encoding="ascii") as fh:
            next(fh)
            for line in fh:
                f = line.split()
                rem, st, inode = f[2], f[3], int(f[9])
                hexip, hexport = rem.split(":")
                raw = bytes.fromhex(hexip)
                if len(raw) == 4:
                    ip = ipaddress.IPv4Address(raw[::-1])
                else:
                    ip = ipaddress.IPv6Address(b"".join(raw[i:i + 4][::-1] for i in range(0, 16, 4)))
                out[inode] = (ip, int(hexport, 16), st)
    except OSError:
        pass
    return out


def _is_local(ip):
    if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    return ip.is_loopback or ip.is_unspecified


def socket_peers(pids):
    """Non-loopback peers of every socket the given processes hold."""
    tables = {}
    for kind in ("tcp", "tcp6", "udp", "udp6"):
        tables.update(_proc_net(kind))
    peers = set()
    for pid in pids:
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                link = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if not link.startswith("socket:["):
                continue
            ent = tables.get(int(link[8:-1]))
            if ent and not _is_local(ent[0]):
                peers.add(f"{ent[0]}:{ent[1]} (state {ent[2]}, pid {pid})")
    return peers


_RESOLVE = re.compile(r"Resolving host \[([^\]<]+)\]")


def resolved_hosts(out):
    hosts = set()
    for fn in os.listdir(out):
        if not fn.startswith("moz-resolver.log"):
            continue
        with open(os.path.join(out, fn), encoding="utf-8", errors="replace") as fh:
            for line in fh:
                for h in _RESOLVE.findall(line):
                    hosts.add(h.strip().lower())
    return hosts


def _host_is_local(h):
    if h in LOOPBACK_NAMES or h.endswith(".localhost"):
        return True
    try:
        return _is_local(ipaddress.ip_address(h.strip("[]")))
    except ValueError:
        return False


def cmd_egress(args):
    spec = ssot()
    out = os.path.abspath(args.out)
    os.makedirs(out, exist_ok=True)
    for fn in os.listdir(out):
        if fn.startswith("moz-resolver.log"):
            os.remove(os.path.join(out, fn))
    app = args.app or spec["gecko"]["install_dir"]
    url = args.url or spec["home_url"]
    problems, peers, samples = [], set(), 0
    with Instance(app, spec["gecko"]["binary"], out, url, args.width, args.height, args.memory, moz_log=True) as inst:
        inst.wait_started()
        if args.plant_url:
            inst.m.js("gBrowser.addTab(arguments[0], {triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal()}); return 1;",
                      [args.plant_url])
        deadline = time.time() + args.seconds
        while time.time() < deadline:
            inst.sample_pids()
            peers |= socket_peers(inst.pids())
            samples += 1
            time.sleep(0.5)
        tracked = dict(inst.seen)
    scope_after = inst.scope_after
    hosts = resolved_hosts(out)
    bad_hosts = sorted(h for h in hosts if not _host_is_local(h))
    with open(os.path.join(out, "console.log"), encoding="utf-8", errors="replace") as fh:
        console_bad = [ln.rstrip() for ln in fh if any(p.search(ln) for p in CONSOLE_FAILURES)]

    if "firefox-bin" not in tracked.values() and not any(v.startswith("firefox") for v in tracked.values()):
        problems.append(f"no firefox-bin process was ever tracked in the scope ({tracked}); the probe proved nothing")
    # Canary: the page the probe itself loaded must show up as a lookup, or the log saw nothing.
    canary = (urllib.parse.urlsplit(url).hostname or "").lower()
    if not any(fn.startswith("moz-resolver.log") for fn in os.listdir(out)):
        problems.append("Gecko wrote no resolver log; DNS lookups were not observable")
    elif canary and canary not in hosts:
        problems.append(f"the resolver log does not show the probe's own page host {canary!r}; DNS observation is broken")
    if bad_hosts:
        problems.append("DNS lookups of non-loopback hosts: " + ", ".join(bad_hosts))
    if peers:
        problems.append("sockets to non-loopback peers: " + ", ".join(sorted(peers)))
    if console_bad:
        problems.append("console: " + " | ".join(console_bad[:5]))
    if scope_after not in ("gone", "inactive", "failed"):
        problems.append(f"probe scope still {scope_after} after quit")

    result = {"mode": "egress", "app": app, "url": url, "plant_url": args.plant_url, "seconds": args.seconds,
              "samples": samples, "canary_host": canary, "tracked_processes": {str(k): v for k, v in sorted(tracked.items())},
              "resolved_hosts": sorted(hosts), "non_loopback_hosts": bad_hosts, "non_loopback_peers": sorted(peers),
              "console_failures": console_bad, "scope_after": scope_after, "problems": problems, "ok": not problems}
    with open(os.path.join(out, "result.json"), "w", encoding="utf-8") as fh:
        json.dump(result, fh, indent=2)
    for p in problems:
        sys.stderr.write(f"[mios-portal-probe] egress: {p}\n")
    print(f"[mios-portal-probe] egress {'OK' if not problems else 'FAILED'}: {len(tracked)} process(es) tracked "
          f"({', '.join(sorted(set(tracked.values())))}), {samples} socket sample(s) over {args.seconds}s, "
          f"{len(hosts)} resolved name(s) ({', '.join(sorted(hosts)) or 'none'}); scope {scope_after}")
    return 0 if not problems else 1


def main(argv=None):
    ap = argparse.ArgumentParser(prog="mios-portal-probe", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("layout", "egress"):
        p = sub.add_parser(name)
        p.add_argument("--out", required=True)
        p.add_argument("--app", help="app dir (default [desktop.portal.gecko].install_dir)")
        p.add_argument("--url")
        p.add_argument("--width", type=int, default=1440)
        p.add_argument("--height", type=int, default=900)
        p.add_argument("--memory", default="3G", help="MemoryMax of the probe's scope")
        if name == "egress":
            p.add_argument("--seconds", type=int, default=45)
            p.add_argument("--plant-url", help="negative control: also open this page")
    args = ap.parse_args(argv)
    return {"layout": cmd_layout, "egress": cmd_egress}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
