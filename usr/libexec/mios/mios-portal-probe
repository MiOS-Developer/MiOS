def die(msg):
    sys.stderr.write(f"[mios-portal-probe] FAIL: {msg}\n")
    raise SystemExit(1)


# ------------------------------------------------------------------ SSOT
def ssot():
    merged = mios_toml.load_merged(mios_toml.layer_paths())
    gecko = mios_toml.section(merged, "desktop.portal.gecko")
    layout = mios_toml.section(merged, "desktop.portal.gecko.layout")
    if not gecko or not layout:
        die("mios.toml has no [desktop.portal.gecko] / [desktop.portal.gecko.layout]")
    exports = mios_toml.emit_exports(merged)

    def url(key):
        v = exports.get("MIOS_DESKTOP_PORTAL_GECKO_" + key.upper())
        if not v or "${" in v:
            die(f"[desktop.portal.gecko].{key} does not resolve ({v!r})")
        return v

    need = ("vertical_tabs", "tabs_at_start", "tools", "chat_at_end", "chat_autohide", "chat_width_px",
            "chat_peek_px", "chat_peek_opacity", "chat_transition_ms", "uidensity", "hide_window_controls")
    missing = [k for k in need if k not in layout]
    if missing:
        die(f"[desktop.portal.gecko.layout] lacks {', '.join(missing)}")
    for k in ("install_dir", "binary"):
        if not gecko.get(k):
            die(f"[desktop.portal.gecko].{k} is unset")
    return {"gecko": gecko, "layout": layout, "home_url": url("home_url"), "chat_url": url("chat_url")}


# ------------------------------------------------------------------ Marionette (protocol 3)
class Marionette:
    def __init__(self, port, timeout=90):
        deadline, last = time.time() + timeout, None
        while time.time() < deadline:
            try:
                self.sock = socket.create_connection(("127.0.0.1", port), timeout=10)
                break
            except OSError as e:
                last = e
                time.sleep(0.5)
        else:
            raise RuntimeError(f"marionette port {port} never opened: {last}")
        self.sock.settimeout(120)
        self.buf, self.msgid = b"", 0
        self._recv()

    def _recv(self):
        while b":" not in self.buf:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise RuntimeError("marionette closed")
            self.buf += chunk
        n, rest = self.buf.split(b":", 1)
        n = int(n)
        while len(rest) < n:
            chunk = self.sock.recv(1 << 20)
            if not chunk:
                raise RuntimeError("marionette closed")
            rest += chunk
        self.buf = rest[n:]
        return json.loads(rest[:n])

    def cmd(self, name, params=None):
        self.msgid += 1
        data = json.dumps([0, self.msgid, name, params or {}]).encode()
        self.sock.sendall(str(len(data)).encode() + b":" + data)
        while True:
            msg = self._recv()
            if msg[0] == 1 and msg[1] == self.msgid:
                if msg[2]:
                    raise RuntimeError(f"{name}: {msg[2]}")
                return msg[3]

    def js(self, script, args=None, ctx="chrome"):
        self.cmd("Marionette:SetContext", {"value": ctx})
        r = self.cmd("WebDriver:ExecuteScript", {"script": script, "args": args or []})
        return r.get("value") if isinstance(r, dict) else r

    def screenshot(self):
        self.cmd("Marionette:SetContext", {"value": "chrome"})
        r = self.cmd("WebDriver:TakeScreenshot", {"full": False, "hash": False, "scroll": False})
        return base64.b64decode(r.get("value") if isinstance(r, dict) else r)

    def quit(self):
        try:
            self.cmd("Marionette:Quit", {"flags": ["eForceQuit"]})
        except Exception:
            pass


# ------------------------------------------------------------------ the instance
def _free_port():
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    p = s.getsockname()[1]
    s.close()
    return p


class Instance:
    """One headless app in its own user scope; every PID in the scope's cgroup is the app."""

    def __init__(self, app, binary, out, url, width, height, memory, moz_log=False):
        self.app, self.out, self.url = app, out, url
        exe = os.path.join(app, binary) if os.path.exists(os.path.join(app, binary)) else os.path.join(app, "firefox")
        if not os.access(exe, os.X_OK):
            die(f"{exe} is not executable")
        self.exe = exe
        self.width, self.height, self.memory, self.moz_log = width, height, memory, moz_log
        self.unit = f"mios-portal-probe-{os.getpid()}-{int(time.time())}"
        self.m = None
        self.proc = None
        self.seen = {}   # pid -> comm, every process ever seen in the scope

    def __enter__(self):
        self.profile = tempfile.mkdtemp(prefix="profile-", dir=self.out)
        port = _free_port()
        with open(os.path.join(self.profile, "user.js"), "w", encoding="utf-8") as fh:
            fh.write(f'user_pref("marionette.port", {port});\n')
        env = {k: v for k, v in os.environ.items() if k not in ("WAYLAND_DISPLAY", "DISPLAY", "MOZ_LOG", "MOZ_LOG_FILE")}
        env.update(MOZ_HEADLESS="1", MOZ_HEADLESS_WIDTH=str(self.width), MOZ_HEADLESS_HEIGHT=str(self.height),
                   MOZ_DBUS_REMOTE="0", MOZ_CRASHREPORTER_DISABLE="1")
        if self.moz_log:
            # sync: unbuffered, so a lookup right before quit is on disk (a buffered log lost its tail).
            env.update(MOZ_LOG="sync,timestamp,nsHostResolver:5", MOZ_LOG_FILE=os.path.join(self.out, "moz-resolver.log"))
        self.console = open(os.path.join(self.out, "console.log"), "w", encoding="utf-8")
        self.proc = subprocess.Popen(
            ["systemd-run", "--user", "--scope", "--quiet", "--collect", "--unit", self.unit,
             "-p", f"MemoryMax={self.memory}", "-p", "MemorySwapMax=0", "--",
             self.exe, "--headless", "--marionette", "--remote-allow-system-access", "--no-remote",
             "--profile", self.profile, self.url],
            env=env, stdout=self.console, stderr=subprocess.STDOUT)
        self.m = Marionette(port)
        self.m.cmd("WebDriver:NewSession", {"capabilities": {"alwaysMatch": {"moz:accessibilityChecks": False}}})
        self.sample_pids()
        return self

    def cgroup(self):
        r = subprocess.run(["systemctl", "--user", "show", "-p", "ControlGroup", "--value", self.unit + ".scope"],
                           capture_output=True, text=True)
        cg = r.stdout.strip()
        return "/sys/fs/cgroup" + cg if cg else ""

    def pids(self):
        cg = self.cgroup()
        try:
            with open(os.path.join(cg, "cgroup.procs"), encoding="ascii") as fh:
                return [int(x) for x in fh.read().split()]
        except (OSError, ValueError):
            return []

    def sample_pids(self):
        for pid in self.pids():
            try:
                with open(f"/proc/{pid}/comm", encoding="utf-8") as fh:
                    self.seen.setdefault(pid, fh.read().strip())
            except OSError:
                pass

    def __exit__(self, *exc):
        if self.m:
            self.m.quit()
        try:
            self.proc.wait(timeout=20)
        except subprocess.TimeoutExpired:
            pass
        subprocess.call(["systemctl", "--user", "stop", self.unit + ".scope"], stderr=subprocess.DEVNULL)
        try:
            self.proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        self.console.close()
        shutil.rmtree(self.profile, ignore_errors=True)
        state = subprocess.run(["systemctl", "--user", "is-active", self.unit + ".scope"],
                               capture_output=True, text=True).stdout.strip()
        self.scope_after = state or "gone"
        return False

    def wait_started(self, timeout=60):
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.m.js("return !!(window.gBrowserInit && gBrowserInit.delayedStartupFinished);"):
                return
            time.sleep(0.5)
        raise RuntimeError("browser window never finished delayed startup")

    def hover(self, x, y):
        """A real (native) pointer move into the headless widget: :hover and the sidebar's
        expand-on-hover react exactly as they do under a mouse. A coordinate in (0, 1) is a fraction
        of the window, a negative one counts from the far edge, anything else is CSS pixels."""
        return self.m.js(
            "const [x,y]=arguments; const wu=window.windowUtils; const s=window.devicePixelRatio;"
            "const at=(v,n)=> (v > 0 && v < 1) ? v*n : (v < 0 ? n + v : v);"
            "const X=(window.mozInnerScreenX + at(x, window.innerWidth))*s;"
            "const Y=(window.mozInnerScreenY + at(y, window.innerHeight))*s;"
            "wu.sendNativeMouseEvent(X, Y, wu.NATIVE_MOUSE_MESSAGE_MOVE, 0, 0, document.documentElement, null);"
            "return [X,Y];", [x, y])


