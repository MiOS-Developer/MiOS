# Non-mutating endpoint patterns
SAFE_GET_PATHS = [
    r"^/v1/models/?$",
    r"^/v1/models/[^/]+/?$",
    r"^/models/?$",
    r"^/models/[^/]+/?$",
    r"^/health/?$",
    r"^/v1/health/?$",
    r"^/ready/?$",
    r"^/v1/ready/?$",
    r"^/version/?$",
    r"^/v1/version/?$",
]

SAFE_POST_PATHS = [
    r"^/v1/chat/completions/?$",
    r"^/chat/completions/?$",
    r"^/v1/embeddings/?$",
    r"^/embeddings/?$",
    r"^/v1/completions/?$",
    r"^/completions/?$",
    r"^/v1/responses/?$",
    r"^/responses/?$",
]

MUTATING_KEYWORDS = [
    "write",
    "delete",
    "update",
    "reload",
    "mutate",
    "admin",
    "config",
    "reset",
    "shutdown",
    "drop",
    "insert",
    "modify",
    "patch",
    "purge",
    "destroy",
    "restart",
]


def resolve_state_file(custom_path: Optional[str] = None) -> Path:
    """Resolves a writable path for the shadow metrics journal."""
    if custom_path:
        p = Path(custom_path).resolve()
        p.parent.mkdir(parents=True, exist_ok=True)
        return p

    target_dir = Path(DEFAULT_STATE_DIR)
    try:
        target_dir.mkdir(parents=True, exist_ok=True)
        test_file = target_dir / ".write_test"
        test_file.write_text("ok")
        test_file.unlink()
        return target_dir / "metrics.json"
    except (PermissionError, OSError):
        fallback_dir = Path(FALLBACK_STATE_DIR)
        fallback_dir.mkdir(parents=True, exist_ok=True)
        return fallback_dir / "metrics.json"


def check_mutating_request(method: str, path: str, body: Any = None) -> Tuple[bool, str]:
    """
    Evaluates whether an HTTP query represents a state-mutating operation.
    Enforces the Mutation Guard invariant: under no circumstances may state-altering
    operations be mirrored to candidate instances.
    """
    method_upper = method.strip().upper()
    norm_path = "/" + path.strip().lstrip("/")
    path_lower = norm_path.lower()

    # Any non-GET/POST HTTP verb is considered state-mutating
    if method_upper in ("DELETE", "PUT", "PATCH"):
        return True, f"HTTP method '{method_upper}' is inherently state-mutating"

    # Block any path containing dangerous mutating keywords
    for kw in MUTATING_KEYWORDS:
        if re.search(r"[/_-]" + re.escape(kw) + r"([/_-]|$)", path_lower) or kw in path_lower:
            return True, f"Path '{norm_path}' matches mutating keyword '{kw}'"

    if method_upper == "GET":
        for pattern in SAFE_GET_PATHS:
            if re.match(pattern, norm_path):
                return False, "Safe non-mutating GET endpoint"
        return False, "GET method is read-only"

    if method_upper == "POST":
        for pattern in SAFE_POST_PATHS:
            if re.match(pattern, norm_path):
                return False, "Safe read-only inference POST endpoint"
        return True, f"POST to endpoint '{norm_path}' is not an authorized read-only inference route"

    return True, f"Unsupported HTTP method '{method_upper}'"


def validate_openai_schema(endpoint: str, data: Any) -> Tuple[bool, List[str]]:
    """
    Validates candidate daemon response against OpenAI REST API schemas.
    Covers /v1/models, /v1/chat/completions, and /v1/embeddings.
    """
    errors: List[str] = []
    if not isinstance(data, dict):
        return False, [f"Response body is not a JSON object (type: {type(data).__name__})"]

    norm_endpoint = "/" + endpoint.strip().lstrip("/").lower()

    if "models" in norm_endpoint:
        if data.get("object") != "list":
            errors.append(f"Expected object == 'list', got '{data.get('object')}'")
        models_data = data.get("data")
        if not isinstance(models_data, list):
            errors.append(f"Expected 'data' to be a list, got {type(models_data).__name__}")
        else:
            for i, item in enumerate(models_data):
                if not isinstance(item, dict):
                    errors.append(f"models.data[{i}] is not a dict")
                    continue
                if not item.get("id"):
                    errors.append(f"models.data[{i}] missing required 'id' field")
                if not item.get("object"):
                    errors.append(f"models.data[{i}] missing required 'object' field")

    elif "chat/completions" in norm_endpoint or "completions" in norm_endpoint:
        if not data.get("id"):
            errors.append("Missing required 'id' field in chat completion")
        choices = data.get("choices")
        if not isinstance(choices, list) or len(choices) == 0:
            errors.append(f"Expected non-empty 'choices' list, got {type(choices).__name__}")
        else:
            for i, choice in enumerate(choices):
                if not isinstance(choice, dict):
                    errors.append(f"choices[{i}] is not a dict")
                    continue
                msg = choice.get("message")
                if not isinstance(msg, dict):
                    errors.append(f"choices[{i}].message is not a dict")
                    continue
                if "role" not in msg or "content" not in msg:
                    errors.append(f"choices[{i}].message missing 'role' or 'content'")
                if "finish_reason" not in choice:
                    errors.append(f"choices[{i}] missing 'finish_reason'")
        if not data.get("model"):
            errors.append("Missing required 'model' field")
        usage = data.get("usage")
        if usage is not None and not isinstance(usage, dict):
            errors.append("Expected 'usage' to be a dict if present")

    elif "embeddings" in norm_endpoint:
        if data.get("object") != "list":
            errors.append(f"Expected object == 'list', got '{data.get('object')}'")
        data_list = data.get("data")
        if not isinstance(data_list, list) or len(data_list) == 0:
            errors.append(f"Expected non-empty 'data' list, got {type(data_list).__name__}")
        else:
            for i, emb in enumerate(data_list):
                if not isinstance(emb, dict):
                    errors.append(f"data[{i}] is not a dict")
                    continue
                if emb.get("object") != "embedding":
                    errors.append(f"data[{i}].object expected 'embedding', got '{emb.get('object')}'")
                embedding_vector = emb.get("embedding")
                if not isinstance(embedding_vector, list) or len(embedding_vector) == 0:
                    errors.append(f"data[{i}].embedding must be a non-empty list of numbers")
        if not data.get("model"):
            errors.append("Missing required 'model' field")

    return len(errors) == 0, errors


@dataclass
class HttpResponseRecord:
    status_code: int
    body_text: str
    json_data: Optional[Any]
    latency_ms: float
    headers: Dict[str, str] = field(default_factory=dict)
    error_msg: Optional[str] = None


@dataclass
class QueryComparisonResult:
    request_id: str
    method: str
    path: str
    blocked_mutating: bool = False
    block_reason: Optional[str] = None
    live_response: Optional[HttpResponseRecord] = None
    candidate_response: Optional[HttpResponseRecord] = None
    status_match: bool = False
    schema_valid: bool = False
    schema_errors: List[str] = field(default_factory=list)
    latency_delta_ms: float = 0.0
    latency_ratio: float = 1.0
    divergence: bool = False
    divergence_reasons: List[str] = field(default_factory=list)


def dispatch_request(
    base_url: str,
    method: str,
    path: str,
    headers: Optional[Dict[str, str]] = None,
    body: Optional[Any] = None,
    timeout: float = 15.0,
) -> HttpResponseRecord:
    """Dispatches a single HTTP request and measures precise round-trip latency."""
    base = base_url.rstrip("/")
    rel_path = "/" + path.lstrip("/")
    if base.endswith("/v1") and rel_path.startswith("/v1/"):
        rel_path = rel_path[3:]
    url = base + rel_path

    req_headers = {"User-Agent": "MiOS-Shadow-Tester/1.0", "Accept": "application/json"}
    if headers:
        req_headers.update(headers)

    body_bytes: Optional[bytes] = None
    if body is not None:
        if isinstance(body, (dict, list)):
            body_bytes = json.dumps(body).encode("utf-8")
            if "Content-Type" not in req_headers:
                req_headers["Content-Type"] = "application/json"
        elif isinstance(body, str):
            body_bytes = body.encode("utf-8")
        elif isinstance(body, bytes):
            body_bytes = body

    req = urllib.request.Request(url, data=body_bytes, headers=req_headers, method=method.upper())
    start_time = time.perf_counter()

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            elapsed_ms = (time.perf_counter() - start_time) * 1000.0
            status_code = resp.status
            raw_body = resp.read()
            body_text = raw_body.decode("utf-8", errors="replace")
            resp_headers = dict(resp.headers.items())
            json_data = None
            try:
                json_data = json.loads(body_text)
            except Exception:
                pass
            return HttpResponseRecord(
                status_code=status_code,
                body_text=body_text,
                json_data=json_data,
                latency_ms=elapsed_ms,
                headers=resp_headers,
            )
    except urllib.error.HTTPError as he:
        elapsed_ms = (time.perf_counter() - start_time) * 1000.0
        raw_body = he.read()
        body_text = raw_body.decode("utf-8", errors="replace")
        json_data = None
        try:
            json_data = json.loads(body_text)
        except Exception:
            pass
        return HttpResponseRecord(
            status_code=he.code,
            body_text=body_text,
            json_data=json_data,
            latency_ms=elapsed_ms,
            headers=dict(he.headers.items()),
            error_msg=f"HTTP {he.code}: {he.reason}",
        )
    except Exception as exc:
        elapsed_ms = (time.perf_counter() - start_time) * 1000.0
        return HttpResponseRecord(
            status_code=0,
            body_text="",
            json_data=None,
            latency_ms=elapsed_ms,
            error_msg=str(exc),
        )


class MockOpenAIDaemon:
    """
    Lightweight, embedded HTTP server implementing OpenAI API endpoints for testing.
    Can operate in standard compliant mode or divergence-simulation mode.
    """

    def __init__(self, port: int = 0, simulate_divergence: bool = False, server_name: str = "mock-openai"):
        self.port = port
        self.simulate_divergence = simulate_divergence
        self.server_name = server_name
        self._server: Optional[http.server.HTTPServer] = None
        self._thread: Optional[threading.Thread] = None
        self.actual_port: int = 0

    def start(self) -> int:
        parent = self

        class Handler(http.server.BaseHTTPRequestHandler):
            def log_message(self, format: str, *args: Any) -> None:
                pass  # Suppress default stdout log

            def do_GET(self) -> None:
                parsed = urllib.parse.urlparse(self.path)
                p = parsed.path.rstrip("/")
                sub = re.sub(r"^(/v1)+", "", p)
                if sub in ("/health", "/ready") or p in ("/health", "/v1/health", "/ready", "/v1/ready"):
                    self._send_json(200, {"status": "ok", "service": parent.server_name})
                elif sub == "/models" or p in ("/models", "/v1/models"):
                    if parent.simulate_divergence:
                        # Negative control: Schema divergence (missing data array / error)
                        self._send_json(500, {"error": "Internal Mock Injected Error"})
                    else:
                        self._send_json(
                            200,
                            {
                                "object": "list",
                                "data": [
                                    {"id": "default", "object": "model", "owned_by": "mios"},
                                    {"id": "nomic-embed-text", "object": "model", "owned_by": "mios"},
                                ],
                            },
                        )
                else:
                    self._send_json(404, {"error": "Not found"})

            def do_POST(self) -> None:
                parsed = urllib.parse.urlparse(self.path)
                p = parsed.path.rstrip("/")
                sub = re.sub(r"^(/v1)+", "", p)
                content_len = int(self.headers.get("Content-Length", 0))
                body = self.rfile.read(content_len).decode("utf-8", errors="replace")
                try:
                    req_data = json.loads(body) if body else {}
                except Exception:
                    req_data = {}

                if parent.simulate_divergence:
                    # Injected divergence: schema failure or HTTP 502
                    self._send_json(200, {"invalid_schema_field": True})
                    return

                if sub in ("/chat/completions", "/completions") or p in ("/chat/completions", "/v1/chat/completions"):
                    messages = req_data.get("messages", [])
                    user_msg = messages[-1].get("content", "hello") if messages else "hello"
                    resp = {
                        "id": f"chatcmpl-{int(time.time()*1000)}",
                        "object": "chat.completion",
                        "created": int(time.time()),
                        "model": req_data.get("model", "default"),
                        "choices": [
                            {
                                "index": 0,
                                "message": {"role": "assistant", "content": f"Echo: {user_msg}"},
                                "finish_reason": "stop",
                            }
                        ],
                        "usage": {
                            "prompt_tokens": len(str(user_msg).split()),
                            "completion_tokens": 5,
                            "total_tokens": len(str(user_msg).split()) + 5,
                        },
                    }
                    self._send_json(200, resp)

                elif sub in ("/embeddings",) or p in ("/embeddings", "/v1/embeddings"):
                    input_text = req_data.get("input", "")
                    tokens = len(str(input_text).split()) or 1
                    resp = {
                        "object": "list",
                        "data": [{"object": "embedding", "index": 0, "embedding": [0.05] * 128}],
                        "model": req_data.get("model", "nomic-embed-text"),
                        "usage": {"prompt_tokens": tokens, "total_tokens": tokens},
                    }
                    self._send_json(200, resp)

                else:
                    self._send_json(404, {"error": f"Endpoint not found: {p}"})

            def _send_json(self, status: int, data: Any) -> None:
                body = json.dumps(data).encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

        self._server = http.server.HTTPServer(("127.0.0.1", self.port), Handler)
        self.actual_port = self._server.server_address[1]
        self._thread = threading.Thread(target=self._server.serve_forever, daemon=True)
        self._thread.start()
        return self.actual_port

    def stop(self) -> None:
        if self._server:
            self._server.shutdown()
            self._server.server_close()


