def create_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-v", "--verbose", action="store_true", help="Enable verbose diagnostic logging.")
    common.add_argument("--dry-run", action="store_true", help="Simulate query execution without network dispatch.")
    common.add_argument("--mock", action="store_true", help="Execute with mock daemons and synthetic fixtures.")
    common.add_argument("--state-file", type=str, default=None, help="Path to shadow metrics state journal.")

    parser = argparse.ArgumentParser(
        prog="mios-shadow-test",
        description="Shadow dual-process candidate daemon validator and query mirroring harness (task_485, task_2718).",
        parents=[common],
    )

    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # 1. mirror
    p_mirror = subparsers.add_parser(
        "mirror", parents=[common], help="Run query mirroring comparison between live and candidate."
    )
    p_mirror.add_argument("--live", type=str, default=None, help="URL of production live daemon.")
    p_mirror.add_argument("--candidate", type=str, default=None, help="URL of isolated candidate daemon.")
    p_mirror.add_argument("--requests", type=str, default=None, help="Path to JSON/JSONL requests trace file.")
    p_mirror.add_argument("--concurrency", type=int, default=4, help="Parallel worker threads count.")
    p_mirror.add_argument("--tolerance", type=float, default=0.15, help="Latency differential tolerance ratio.")
    p_mirror.add_argument("--output", type=str, default=None, help="Path to write JSON parity report.")
    p_mirror.add_argument(
        "--simulate-divergence", action="store_true", help="Inject candidate divergence for negative control testing."
    )

    # 2. validate
    p_validate = subparsers.add_parser(
        "validate", parents=[common], help="Automated shadow container/binary validation loop."
    )
    p_validate.add_argument(
        "--candidate", type=str, required=True, help="Candidate binary path or container image name."
    )
    p_validate.add_argument("--live", type=str, default=None, help="URL of production live daemon.")
    p_validate.add_argument("--port", type=int, default=DEFAULT_CANDIDATE_PORT, help="Shadow candidate port.")
    p_validate.add_argument("--timeout", type=int, default=30, help="Startup readiness timeout in seconds.")
    p_validate.add_argument("--isolated-net", action="store_true", help="Isolate network namespace via netns.")
    p_validate.add_argument("--output", type=str, default=None, help="Path to write JSON validation receipt.")

    # 3. status
    p_status = subparsers.add_parser(
        "status", parents=[common], help="Report shadow test runs, parity metrics, and divergence history."
    )
    p_status.add_argument("--json", action="store_true", help="Output status report in raw JSON format.")
    p_status.add_argument("--clear", action="store_true", help="Clear historical metrics journal.")

    return parser


def main() -> int:
    parser = create_parser()
    args = parser.parse_args()

    if args.subcommand == "mirror":
        return cmd_mirror(args)
    elif args.subcommand == "validate":
        return cmd_validate(args)
    elif args.subcommand == "status":
        return cmd_status(args)
    else:
        parser.print_help()
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
