def cmd_mirror(args: argparse.Namespace) -> int:
    """Executes query mirroring and evaluates parity."""
    state_file = resolve_state_file(args.state_file)
    live_url = args.live or DEFAULT_LIVE_URL
    candidate_url = args.candidate

    mock_live: Optional[MockOpenAIDaemon] = None
    mock_cand: Optional[MockOpenAIDaemon] = None

    if args.mock:
        # Spin up mock daemons on ephemeral ports if not provided
        mock_live = MockOpenAIDaemon(server_name="mock-live")
        live_port = mock_live.start()
        live_url = f"http://127.0.0.1:{live_port}/v1"

        mock_cand = MockOpenAIDaemon(
            server_name="mock-candidate",
            simulate_divergence=getattr(args, "simulate_divergence", False),
        )
        cand_port = mock_cand.start()
        candidate_url = f"http://127.0.0.1:{cand_port}/v1"

    if not candidate_url:
        print("Error: --candidate <url> is required (or use --mock)", file=sys.stderr)
        return EXIT_ERROR

    queries: List[Dict[str, Any]] = []
    if args.requests:
        req_path = Path(args.requests)
        if not req_path.is_file():
            print(f"Error: Requests file '{args.requests}' does not exist.", file=sys.stderr)
            return EXIT_ERROR
        try:
            content = req_path.read_text(encoding="utf-8").strip()
            if content.startswith("["):
                queries = json.loads(content)
            else:
                for line in content.splitlines():
                    if line.strip():
                        queries.append(json.loads(line))
        except Exception as exc:
            print(f"Error reading requests file: {exc}", file=sys.stderr)
            return EXIT_ERROR
    else:
        queries = generate_default_test_queries()

    harness = ShadowHarness(
        live_url=live_url,
        candidate_url=candidate_url,
        concurrency=args.concurrency,
        tolerance=args.tolerance,
        verbose=args.verbose,
        dry_run=args.dry_run,
        state_file=state_file,
    )

    try:
        report = harness.run_mirroring(queries)
        print("\n" + "=" * 60)
        print("  SHADOW QUERY MIRRORING PARITY REPORT")
        print("=" * 60)
        print(f"  Live Endpoint:       {report['live_url']}")
        print(f"  Candidate Endpoint:  {report['candidate_url']}")
        print(f"  Total Queries:       {report['total_queries']}")
        print(f"  Blocked Mutations:   {report['blocked_mutations']} (Filtered by Mutation Guard)")
        print(f"  Mirrored Queries:    {report['mirrored_queries']}")
        print(f"  Status Parity:       {report['status_parity_count']}/{report['mirrored_queries']}")
        print(f"  Schema Compliance:   {report['schema_pass_count']}/{report['mirrored_queries']}")
        print(f"  Parity Score:        {report['parity_score']*100:.1f}%")
        print(f"  Avg Latency (Live):  {report['avg_live_latency_ms']:.1f} ms")
        print(f"  Avg Latency (Cand):  {report['avg_cand_latency_ms']:.1f} ms")
        print(f"  P95 Latency Delta:   {report['p95_latency_delta_ms']:.1f} ms")
        print(f"  Divergence Events:   {report['divergence_count']}")
        print(f"  Final Verdict:       {report['verdict']}")
        print("=" * 60)

        if report["divergences"]:
            print("\nDetected Divergences:")
            for d in report["divergences"]:
                print(f"  - [{d['request_id']}] {d['endpoint']}: {', '.join(d['reasons'])}")

        if args.output:
            out_p = Path(args.output)
            out_p.parent.mkdir(parents=True, exist_ok=True)
            out_p.write_text(json.dumps(report, indent=2), encoding="utf-8")
            print(f"Saved report to {args.output}")

        return EXIT_SUCCESS if report["verdict"] == "PASS" else EXIT_DIVERGENCE
    finally:
        if mock_live:
            mock_live.stop()
        if mock_cand:
            mock_cand.stop()


def cmd_validate(args: argparse.Namespace) -> int:
    """Automated shadow container/binary validation loop."""
    state_file = resolve_state_file(args.state_file)
    candidate_target = args.candidate
    live_url = args.live or DEFAULT_LIVE_URL
    port = args.port or DEFAULT_CANDIDATE_PORT
    candidate_url = f"http://127.0.0.1:{port}/v1"

    print(f"[shadow-validate] Initializing shadow candidate validation for: {candidate_target}")

    mock_live: Optional[MockOpenAIDaemon] = None
    mock_cand: Optional[MockOpenAIDaemon] = None
    container_proc: Optional[subprocess.Popen] = None
    binary_proc: Optional[subprocess.Popen] = None

    try:
        if args.mock:
            print("  [mock] Spawning mock live and candidate daemons...")
            mock_live = MockOpenAIDaemon(server_name="mock-live")
            live_port = mock_live.start()
            live_url = f"http://127.0.0.1:{live_port}/v1"

            mock_cand = MockOpenAIDaemon(port=port, server_name="mock-shadow-candidate")
            mock_cand.start()
            candidate_url = f"http://127.0.0.1:{port}/v1"
        else:
            # Check if candidate_target is executable binary or container image
            cand_path = Path(candidate_target)
            if cand_path.is_file() and os.access(cand_path, os.X_OK):
                print(f"  [exec] Launching candidate binary: {cand_path} --port {port}")
                cmd = [str(cand_path), "--port", str(port)]
                binary_proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            else:
                # Container execution via podman
                print(f"  [container] Launching candidate container: {candidate_target} on port {port}")
                c_cmd = [
                    "podman",
                    "run",
                    "-d",
                    "--name",
                    f"mios-shadow-{port}",
                    "-p",
                    f"{port}:{port}",
                    "--rm",
                    candidate_target,
                ]
                subprocess.run(c_cmd, check=True, capture_output=True)

        # Readiness Probe
        print("  [health] Polling candidate readiness probe (/v1/models or /health)...")
        ready = False
        start_poll = time.time()
        timeout = args.timeout or 30
        while time.time() - start_poll < timeout:
            rec = dispatch_request(candidate_url, "GET", "/health", timeout=1.0)
            if rec.status_code == 200:
                ready = True
                break
            rec_models = dispatch_request(candidate_url, "GET", "/v1/models", timeout=1.0)
            if rec_models.status_code == 200:
                ready = True
                break
            time.sleep(0.5)

        if not ready and not args.dry_run:
            print(f"  [ERROR] Candidate daemon failed readiness probe within {timeout}s", file=sys.stderr)
            return EXIT_DIVERGENCE

        print("  [health] Candidate is ready and accepting requests.")

        # Prepare validation queries (including positive controls and mutating queries for filter test)
        queries = generate_default_test_queries()
        queries.append({"method": "POST", "path": "/v1/write", "body": {"data": "exploit"}})
        queries.append({"method": "DELETE", "path": "/v1/models/old-model"})

        harness = ShadowHarness(
            live_url=live_url,
            candidate_url=candidate_url,
            concurrency=4,
            verbose=args.verbose,
            dry_run=args.dry_run,
            state_file=state_file,
        )

        report = harness.run_mirroring(queries)

        print("\n" + "=" * 60)
        print("  CANDIDATE CANARY PROMOTION GATE VERDICT")
        print("=" * 60)
        print(f"  Target:              {candidate_target}")
        print(f"  Status Parity:       {report['status_parity_count']}/{report['mirrored_queries']}")
        print(f"  Schema Compliance:   {report['schema_pass_count']}/{report['mirrored_queries']}")
        print(f"  Blocked Mutations:   {report['blocked_mutations']}/2 (100% Guard Compliance)")
        print(f"  Divergence Count:    {report['divergence_count']}")

        passed = (
            report["verdict"] == "PASS"
            and report["schema_pass_count"] == report["mirrored_queries"]
            and report["blocked_mutations"] >= 2
        )

        if passed:
            print("\n  VERDICT: PROMOTION_ALLOWED")
            print("  All architectural and schema invariants verified successfully.")
            print("=" * 60)
            return EXIT_SUCCESS
        else:
            print("\n  VERDICT: PROMOTION_BLOCKED")
            print("  Candidate daemon failed parity, schema compliance, or mutation guard checks.")
            print("=" * 60)
            return EXIT_DIVERGENCE

    finally:
        if mock_live:
            mock_live.stop()
        if mock_cand:
            mock_cand.stop()
        if binary_proc:
            binary_proc.terminate()
            try:
                binary_proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                binary_proc.kill()
        if not args.mock and not binary_proc:
            # Cleanup podman container if spawned
            subprocess.run(["podman", "rm", "-f", f"mios-shadow-{port}"], capture_output=True)


def cmd_status(args: argparse.Namespace) -> int:
    """Reports shadow test runs, parity metrics, and divergence statistics."""
    state_file = resolve_state_file(args.state_file)
    if args.clear:
        if state_file.exists():
            state_file.unlink()
            print(f"[shadow-status] Cleared metrics journal at {state_file}")
        else:
            print(f"[shadow-status] No metrics file found at {state_file}")
        return EXIT_SUCCESS

    if not state_file.exists():
        print(f"[shadow-status] No shadow test runs recorded yet. (Journal: {state_file})")
        return EXIT_SUCCESS

    try:
        with open(state_file, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as exc:
        print(f"Error reading metrics journal: {exc}", file=sys.stderr)
        return EXIT_ERROR

    if args.json:
        print(json.dumps(data, indent=2))
        return EXIT_SUCCESS

    summary = data.get("summary", {})
    runs = data.get("runs", [])

    print("=" * 65)
    print("  MIOS SHADOW TEST HISTORICAL METRICS & CANARY STATUS")
    print("=" * 65)
    print(f"  Journal Location:       {state_file}")
    print(f"  Total Validations Run:  {summary.get('total_runs', len(runs))}")
    print(f"  Last Run Timestamp:     {summary.get('last_run_timestamp', 'N/A')}")
    print(f"  Last Candidate Target:  {summary.get('last_candidate', 'N/A')}")
    print(f"  Total Queries Mirrored: {summary.get('total_queries_mirrored', 0)}")
    print(f"  Blocked Mutations:      {summary.get('total_mutations_blocked', 0)}")
    print(f"  Total Divergences:      {summary.get('total_divergences', 0)}")
    print(f"  Average Parity Score:   {summary.get('average_parity_score', 1.0)*100:.1f}%")
    print(f"  Last Promotion Verdict: {summary.get('last_verdict', 'N/A')}")
    print("-" * 65)
    print("  Recent Runs History:")
    print(f"  {'TIMESTAMP':<24} {'CANDIDATE':<22} {'PARITY':<8} {'VERDICT'}")
    for r in runs[-10:]:
        ts = r.get("timestamp", "N/A")[:19]
        cand = (r.get("candidate_url") or "candidate")[-20:]
        parity = f"{r.get('parity_score', 1.0)*100:.1f}%"
        verdict = r.get("verdict", "N/A")
        print(f"  {ts:<24} {cand:<22} {parity:<8} {verdict}")
    print("=" * 65)
    return EXIT_SUCCESS


