class ShadowHarness:
    """Core test engine that executes query mirroring, evaluates parity, and records metrics."""

    def __init__(
        self,
        live_url: str,
        candidate_url: str,
        concurrency: int = 4,
        tolerance: float = 0.15,
        min_parity: float = 0.95,
        verbose: bool = False,
        dry_run: bool = False,
        state_file: Optional[Path] = None,
    ):
        self.live_url = live_url.rstrip("/")
        self.candidate_url = candidate_url.rstrip("/")
        self.concurrency = max(1, concurrency)
        self.tolerance = tolerance
        self.min_parity = min_parity
        self.verbose = verbose
        self.dry_run = dry_run
        self.state_file = state_file or resolve_state_file()

    def log(self, msg: str) -> None:
        print(f"[shadow-test] {msg}")

    def diag(self, msg: str) -> None:
        if self.verbose:
            print(f"  [diag] {msg}")

    def execute_query_comparison(self, query: Dict[str, Any], query_idx: int) -> QueryComparisonResult:
        req_id = f"q-{query_idx:04d}"
        method = query.get("method", "GET").upper()
        path = query.get("path", "/v1/models")
        headers = query.get("headers", {})
        body = query.get("body")

        # 1. Evaluate Mutation Guard
        is_mutating, block_reason = check_mutating_request(method, path, body)
        if is_mutating:
            self.log(f"[GUARD] Blocked state-mutating request: {method} {path} ({block_reason})")
            return QueryComparisonResult(
                request_id=req_id,
                method=method,
                path=path,
                blocked_mutating=True,
                block_reason=block_reason,
            )

        if self.dry_run:
            self.diag(f"Dry-run: Would mirror non-mutating {method} {path}")
            return QueryComparisonResult(
                request_id=req_id,
                method=method,
                path=path,
                status_match=True,
                schema_valid=True,
            )

        # 2. Concurrently dispatch to Live and Candidate
        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
            fut_live = executor.submit(dispatch_request, self.live_url, method, path, headers, body)
            fut_candidate = executor.submit(dispatch_request, self.candidate_url, method, path, headers, body)
            res_live = fut_live.result()
            res_candidate = fut_candidate.result()

        # 3. Analyze Responses
        status_match = res_live.status_code == res_candidate.status_code
        schema_valid = True
        schema_errors: List[str] = []

        if res_candidate.status_code == 200 and res_candidate.json_data is not None:
            schema_valid, schema_errors = validate_openai_schema(path, res_candidate.json_data)
        elif res_candidate.status_code >= 400:
            schema_valid = False
            schema_errors.append(f"Candidate returned HTTP status {res_candidate.status_code}")

        # Latency metrics
        delta_ms = abs(res_candidate.latency_ms - res_live.latency_ms)
        denom = max(res_live.latency_ms, 0.001)
        ratio = res_candidate.latency_ms / denom

        divergences: List[str] = []
        if not status_match:
            divergences.append(
                f"Status code mismatch: Live={res_live.status_code}, Candidate={res_candidate.status_code}"
            )
        if not schema_valid:
            divergences.append(f"Candidate schema invalid: {'; '.join(schema_errors)}")
        if res_candidate.error_msg:
            divergences.append(f"Candidate request failed: {res_candidate.error_msg}")

        has_divergence = len(divergences) > 0

        self.diag(
            f"Query {req_id} ({method} {path}): status_match={status_match}, "
            f"schema_valid={schema_valid}, live_ms={res_live.latency_ms:.1f}, "
            f"cand_ms={res_candidate.latency_ms:.1f}, divergence={has_divergence}"
        )

        return QueryComparisonResult(
            request_id=req_id,
            method=method,
            path=path,
            blocked_mutating=False,
            live_response=res_live,
            candidate_response=res_candidate,
            status_match=status_match,
            schema_valid=schema_valid,
            schema_errors=schema_errors,
            latency_delta_ms=delta_ms,
            latency_ratio=ratio,
            divergence=has_divergence,
            divergence_reasons=divergences,
        )

    def run_mirroring(self, queries: List[Dict[str, Any]]) -> Dict[str, Any]:
        """Runs batch query mirroring across worker pool and computes aggregate metrics."""
        self.log(f"Starting query mirroring against live ({self.live_url}) and candidate ({self.candidate_url})")
        self.log(f"Evaluating {len(queries)} total queries with concurrency={self.concurrency}")

        results: List[QueryComparisonResult] = []
        with concurrent.futures.ThreadPoolExecutor(max_workers=self.concurrency) as pool:
            futures = [pool.submit(self.execute_query_comparison, q, i + 1) for i, q in enumerate(queries)]
            for fut in concurrent.futures.as_completed(futures):
                results.append(fut.result())

        # Sort by request ID for deterministic reporting
        results.sort(key=lambda r: r.request_id)

        total_queries = len(results)
        blocked_mutations = sum(1 for r in results if r.blocked_mutating)
        mirrored = [r for r in results if not r.blocked_mutating]
        mirrored_count = len(mirrored)

        status_parity_count = sum(1 for r in mirrored if r.status_match)
        schema_pass_count = sum(1 for r in mirrored if r.schema_valid)
        divergence_count = sum(1 for r in mirrored if r.divergence)

        if mirrored_count > 0:
            parity_score = (status_parity_count + schema_pass_count) / (2.0 * mirrored_count)
            avg_live_latency = sum(r.live_response.latency_ms for r in mirrored if r.live_response) / mirrored_count
            avg_cand_latency = (
                sum(r.candidate_response.latency_ms for r in mirrored if r.candidate_response) / mirrored_count
            )
            lat_deltas = sorted([r.latency_delta_ms for r in mirrored])
            p95_idx = int(0.95 * len(lat_deltas))
            p95_delta = lat_deltas[min(p95_idx, len(lat_deltas) - 1)]
        else:
            parity_score = 1.0
            avg_live_latency = 0.0
            avg_cand_latency = 0.0
            p95_delta = 0.0

        all_divergences = []
        for r in mirrored:
            if r.divergence:
                all_divergences.append(
                    {
                        "request_id": r.request_id,
                        "endpoint": f"{r.method} {r.path}",
                        "reasons": r.divergence_reasons,
                    }
                )

        report = {
            "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "live_url": self.live_url,
            "candidate_url": self.candidate_url,
            "total_queries": total_queries,
            "blocked_mutations": blocked_mutations,
            "mirrored_queries": mirrored_count,
            "status_parity_count": status_parity_count,
            "schema_pass_count": schema_pass_count,
            "divergence_count": divergence_count,
            "parity_score": round(parity_score, 4),
            "avg_live_latency_ms": round(avg_live_latency, 2),
            "avg_cand_latency_ms": round(avg_cand_latency, 2),
            "p95_latency_delta_ms": round(p95_delta, 2),
            "divergences": all_divergences,
            "verdict": "PASS" if divergence_count == 0 and parity_score >= self.min_parity else "FAIL",
        }

        self.save_run_metrics(report)
        return report

    def save_run_metrics(self, report: Dict[str, Any]) -> None:
        """Appends run report to persisted metrics journal."""
        if self.dry_run:
            return
        data = {"summary": {}, "runs": []}
        if self.state_file.exists():
            try:
                with open(self.state_file, "r", encoding="utf-8") as f:
                    data = json.load(f)
            except Exception:
                data = {"summary": {}, "runs": []}

        runs: List[Dict[str, Any]] = data.get("runs", [])
        runs.append(report)
        # Keep recent 50 runs
        if len(runs) > 50:
            runs = runs[-50:]

        total_runs = len(runs)
        total_mirrored = sum(r.get("mirrored_queries", 0) for r in runs)
        total_blocked = sum(r.get("blocked_mutations", 0) for r in runs)
        total_div = sum(r.get("divergence_count", 0) for r in runs)
        avg_parity = sum(r.get("parity_score", 1.0) for r in runs) / max(1, total_runs)

        data["summary"] = {
            "total_runs": total_runs,
            "last_run_timestamp": report["timestamp"],
            "last_candidate": self.candidate_url,
            "total_queries_mirrored": total_mirrored,
            "total_mutations_blocked": total_blocked,
            "total_divergences": total_div,
            "average_parity_score": round(avg_parity, 4),
            "last_verdict": report["verdict"],
        }
        data["runs"] = runs

        try:
            with open(self.state_file, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
            self.diag(f"Saved run metrics to {self.state_file}")
        except Exception as exc:
            self.log(f"Warning: Could not persist state to {self.state_file}: {exc}")


