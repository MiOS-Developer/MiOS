# CLI Subcommands & Main
# -----------------------------------------------------------------------------


def cmd_evaluate(mgr: HardwareFallbackManager, args: argparse.Namespace) -> int:
    res = mgr.evaluate()
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        status_str = res.get("overall_status", "nominal").upper()
        fallbacks = "ACTIVE" if res.get("fallbacks_applied") else "INACTIVE"
        print(f"Hardware Status: {status_str} | Fallbacks: {fallbacks}")
        if res.get("network_fallback", {}).get("fallback_active"):
            chosen = res["network_fallback"].get("chosen_interface", "unknown")
            print(f"  [!] Network Fallback Active: auto-activated '{chosen}'")
        if res.get("audio_fallback", {}).get("fallback_active"):
            sink = res["audio_fallback"].get("sink_name", FALLBACK_NULL_SINK_NAME)
            print(f"  [!] Audio Fallback Active: PipeWire null-sink '{sink}' loaded")
        if res.get("display_fallback", {}).get("fallback_active"):
            print(f"  [!] Display Fallback Active: headless rendering fallback")
        if not res.get("fallbacks_applied"):
            print("  [*] All monitored hardware components are nominal. No fallback required.")
    return 0


def cmd_status(mgr: HardwareFallbackManager, args: argparse.Namespace) -> int:
    st = mgr.get_status()
    if args.json:
        print(json.dumps(st, indent=2))
        return 0

    print("=== MiOS Hardware Fallback Manager Status ===")
    print(f"Evaluated At:     {st.get('timestamp', 'unknown')}")
    print(f"Hardware State:   {st.get('overall_status', 'nominal').upper()}")
    print(f"Fallbacks Active: {st.get('fallbacks_applied', False)}")

    net_fb = st.get("network_fallback", {})
    if net_fb.get("fallback_active"):
        print(f"  Network: ACTIVE (Fallback NIC: {net_fb.get('chosen_interface')})")
    else:
        print(f"  Network: Nominal ({net_fb.get('message', 'OK')})")

    aud_fb = st.get("audio_fallback", {})
    if aud_fb.get("fallback_active"):
        print(f"  Audio:   ACTIVE (PipeWire Null Sink: {aud_fb.get('sink_name')})")
    else:
        print(f"  Audio:   Nominal ({aud_fb.get('message', 'OK')})")

    disp_fb = st.get("display_fallback", {})
    if disp_fb.get("fallback_active"):
        print(f"  Display: ACTIVE ({disp_fb.get('mode', 'headless')})")
    else:
        print(f"  Display: Nominal ({disp_fb.get('message', 'OK')})")

    alerts = st.get("alerts_dispatched", [])
    print(f"Alerts Dispatched: {len(alerts)}")
    for a in alerts:
        print(f"  - {a}")

    return 0


def cmd_daemon(mgr: HardwareFallbackManager, args: argparse.Namespace) -> int:
    interval = getattr(args, "interval", 10)
    logger.info("Starting mios-hardware-fallback daemon (poll interval: %ds)...", interval)

    stop_requested = False

    def handle_signal(sig, frame):
        nonlocal stop_requested
        logger.info("Shutdown signal received (%d). Terminating daemon...", sig)
        stop_requested = True

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    while not stop_requested:
        try:
            mgr.evaluate()
        except Exception as exc:
            logger.error("Error during evaluation cycle: %s", exc)

        # Sleep interval in small chunks to respond quickly to signals
        elapsed = 0
        while elapsed < interval and not stop_requested:
            time.sleep(0.5)
            elapsed += 0.5

    logger.info("Daemon cleanly stopped.")
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    if argv is None:
        argv = sys.argv[1:]

    common_parser = argparse.ArgumentParser(add_help=False)
    common_parser.add_argument("--mock", action="store_true", help="Run with mock hardware degradation fixtures")
    common_parser.add_argument("--dry-run", action="store_true", help="Simulate fallback actions without changing state")
    common_parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose diagnostic logging")
    common_parser.add_argument("--degrade-log", default=DEFAULT_DEGRADE_LOG, help="Path to hardware degradation log")
    common_parser.add_argument("--state-file", default=DEFAULT_STATE_FILE, help="Path to fallback state JSON file")
    common_parser.add_argument("--notif-log", default=DEFAULT_NOTIF_LOG, help="Path to notification recording log")
    common_parser.add_argument("--json", action="store_true", help="Output status or evaluation in JSON format")

    parser = argparse.ArgumentParser(
        prog="mios-hardware-fallback",
        description="Automated network and audio fallback manager with operator desktop alert daemon (task_476, task_2709).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[common_parser],
    )

    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    # Subcommand: evaluate
    p_eval = subparsers.add_parser("evaluate", parents=[common_parser], help="Evaluate hardware state and apply fallbacks")

    # Subcommand: status
    p_status = subparsers.add_parser("status", parents=[common_parser], help="Print current active fallback states")

    # Subcommand: daemon
    p_daemon = subparsers.add_parser("daemon", parents=[common_parser], help="Run background evaluation loop daemon")
    p_daemon.add_argument("--interval", type=int, default=10, help="Evaluation cycle interval in seconds (default: 10)")

    if not argv:
        parser.print_help()
        return 0

    args = parser.parse_args(argv)

    mgr = HardwareFallbackManager(
        degrade_log=args.degrade_log,
        state_file=args.state_file,
        notif_log=args.notif_log,
        mock=args.mock,
        dry_run=args.dry_run,
        verbose=args.verbose,
    )

    if args.subcommand == "evaluate":
        return cmd_evaluate(mgr, args)
    elif args.subcommand == "status":
        return cmd_status(mgr, args)
    elif args.subcommand == "daemon":
        return cmd_daemon(mgr, args)
    else:
        parser.print_help()
        return 0


if __name__ == "__main__":
    sys.exit(main())
