#!/usr/bin/env python3
import os
import sys
import hashlib
import json
import tarfile
import tempfile
import subprocess
import shutil
import argparse

# AI-hint: GAP-5 -- post-build binary diff between new OCI layer blobs and prior manifest

BLOCK_SIZE = 1024 * 1024  # 1MB

def hash_block(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()

def scan_directory(dpath: str):
    """Scans a directory and returns a dict mapping sha256 -> (filepath, block_idx)"""
    blocks = {}
    for root, _, files in os.walk(dpath):
        for f in files:
            fpath = os.path.join(root, f)
            relpath = os.path.relpath(fpath, dpath)
            try:
                with open(fpath, 'rb') as fp:
                    idx = 0
                    while True:
                        data = fp.read(BLOCK_SIZE)
                        if not data:
                            break
                        h = hash_block(data)
                        if h not in blocks:
                            blocks[h] = (relpath, idx)
                        idx += 1
            except Exception:
                pass
    return blocks

def create_delta(old_dir: str, new_dir: str, out_tar: str, priv_key: str = None):
    print("Scanning old directory...")
    old_blocks = scan_directory(old_dir)
    print(f"Found {len(old_blocks)} unique blocks in old directory.")

    manifest = {"files": {}}
    
    with tempfile.TemporaryDirectory() as tmpdir:
        data_dir = os.path.join(tmpdir, "data")
        os.makedirs(data_dir)
        
        data_idx = 0
        
        for root, _, files in os.walk(new_dir):
            for f in files:
                fpath = os.path.join(root, f)
                relpath = os.path.relpath(fpath, new_dir)
                
                file_blocks = []
                size = os.path.getsize(fpath)
                
                with open(fpath, 'rb') as fp:
                    idx = 0
                    while True:
                        data = fp.read(BLOCK_SIZE)
                        if not data:
                            break
                        h = hash_block(data)
                        if h in old_blocks:
                            src_rel, src_idx = old_blocks[h]
                            file_blocks.append({
                                "type": "copy",
                                "source": src_rel,
                                "index": src_idx,
                                "sha256": h
                            })
                        else:
                            try:
                                cdata = subprocess.run(
                                    ["zstd", "-c", "-19", "--quiet"], 
                                    input=data, 
                                    capture_output=True, 
                                    check=True
                                ).stdout
                            except FileNotFoundError:
                                print("WARNING: zstd not found, storing uncompressed", file=sys.stderr)
                                cdata = data

                            data_name = f"data_{data_idx}.zst"
                            with open(os.path.join(data_dir, data_name), "wb") as df:
                                df.write(cdata)
                                
                            file_blocks.append({
                                "type": "data",
                                "file": data_name,
                                "sha256": h
                            })
                            data_idx += 1
                            
                        idx += 1
                        
                manifest["files"][relpath] = {
                    "size": size,
                    "blocks": file_blocks
                }
                
        manifest_path = os.path.join(tmpdir, "manifest.json")
        with open(manifest_path, "w") as mf:
            json.dump(manifest, mf, indent=2)
            
        if priv_key:
            with open(manifest_path, "rb") as mf:
                content = mf.read()
            sig = hashlib.sha256(content + priv_key.encode()).hexdigest()
            with open(os.path.join(tmpdir, "signature.sha256"), "w") as sf:
                sf.write(sig)

        with tarfile.open(out_tar, "w") as tar:
            tar.add(manifest_path, arcname="manifest.json")
            if priv_key:
                tar.add(os.path.join(tmpdir, "signature.sha256"), arcname="signature.sha256")
            tar.add(data_dir, arcname="data")
            
    print(f"Delta created at {out_tar}")

def main():
    parser = argparse.ArgumentParser(description="Create a block-level delta for OCI directories")
    parser.add_argument("old_dir", help="Previous OCI directory")
    parser.add_argument("new_dir", help="New OCI directory")
    parser.add_argument("out_tar", help="Output delta tar file")
    parser.add_argument("--key", help="Private key for SEC-03 signature", default=None)
    args = parser.parse_args()
    
    create_delta(args.old_dir, args.new_dir, args.out_tar, args.key)

if __name__ == "__main__":
    main()
