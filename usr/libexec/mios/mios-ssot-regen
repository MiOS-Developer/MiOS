#!/usr/bin/env bash
# AI-hint: One-command regeneration of every mios.toml-derived SSOT projection the drift-gate verifies
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="${MIOS_ROOT:-$(cd "${script_dir}/../../.." && pwd)}"
libexec="${root}/usr/libexec/mios"
tools="${root}/tools"

export MIOS_TOML="$root/usr/share/mios/mios.toml"
export MIOS_AGENT_PIPE_DIR="$root/usr/lib/mios/agent-pipe"
export MIOS_VERB_MANIFEST="$root/usr/share/mios/ai/v1/tools.generated.json"
export MIOS_CAPS_OUT="$root/usr/share/mios/ai/v1/capabilities.generated.json"

echo "[ssot-regen] project mios.toml [verbs.*]/[recipes.*] -> ai/v1 manifests"
if [[ -f "$libexec/mios-ai-manifest-gen" ]]; then
    python3 "$libexec/mios-ai-manifest-gen" || true
fi
if [[ -f "$libexec/mios-ai-capabilities-gen" ]]; then
    python3 "$libexec/mios-ai-capabilities-gen" || true
fi

echo "[ssot-regen] regenerating roadmap index, gate index, and value duplication report"
if command -v mios-gen >/dev/null 2>&1; then
    mios-gen roadmap-index --root "$root" || true
    mios-gen gate-index --root "$root" || true
elif [[ -x "$root/tools/native/target/debug/mios-gen" ]]; then
    "$root/tools/native/target/debug/mios-gen" roadmap-index --root "$root" || true
    "$root/tools/native/target/debug/mios-gen" gate-index --root "$root" || true
else
    if [[ -f "$tools/roadmap-index.py" ]]; then
        python3 "$tools/roadmap-index.py" || true
    fi
    if [[ -f "$tools/generate-gate-index.py" ]]; then
        python3 "$tools/generate-gate-index.py" || true
    fi
fi
if [[ -f "$tools/mios-dup-report" ]]; then
    python3 "$tools/mios-dup-report" || true
fi

echo "[ssot-regen] all derived surfaces regenerated and in sync with SSOT"
