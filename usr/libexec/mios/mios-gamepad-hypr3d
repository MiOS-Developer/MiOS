# ---------------------------------------------------------------------------
# Linux Input Subsystem Constants & Protocol
# ---------------------------------------------------------------------------

EV_SYN = 0x00
EV_KEY = 0x01
EV_REL = 0x02
EV_ABS = 0x03

SYN_REPORT = 0x00
SYN_DROPPED = 0x03

# Gamepad buttons (Linux input-event-codes.h)
BTN_GAMEPAD = 0x130  # 304, also BTN_SOUTH / BTN_A
BTN_SOUTH = 0x130
BTN_EAST = 0x131    # 305, BTN_B
BTN_NORTH = 0x133   # 307, BTN_X
BTN_WEST = 0x134    # 308, BTN_Y
BTN_TL = 0x136      # 310, Left Bumper
BTN_TR = 0x137      # 311, Right Bumper
BTN_TL2 = 0x138     # 312, Left Trigger (LT)
BTN_TR2 = 0x139     # 313, Right Trigger (RT)
BTN_SELECT = 0x13A  # 314
BTN_START = 0x13B   # 315
BTN_MODE = 0x13C    # 316
BTN_THUMBL = 0x13D  # 317, L3
BTN_THUMBR = 0x13E  # 318, R3

# Absolute axes (Linux input-event-codes.h)
ABS_X = 0x00        # Left Stick X
ABS_Y = 0x01        # Left Stick Y
ABS_Z = 0x02        # Left Trigger (LT) / Fallback Right Stick X
ABS_RX = 0x03       # Right Stick X
ABS_RY = 0x04       # Right Stick Y
ABS_RZ = 0x05       # Right Trigger (RT) / Fallback Right Stick Y
ABS_HAT0X = 0x10    # D-pad X (-1 left, 1 right)
ABS_HAT0Y = 0x11    # D-pad Y (-1 up, 1 down)

KEY_NAMES = {
    "BTN_GAMEPAD": BTN_GAMEPAD,
    "BTN_SOUTH": BTN_SOUTH,
    "BTN_EAST": BTN_EAST,
    "BTN_NORTH": BTN_NORTH,
    "BTN_WEST": BTN_WEST,
    "BTN_TL": BTN_TL,
    "BTN_TR": BTN_TR,
    "BTN_TL2": BTN_TL2,
    "BTN_TR2": BTN_TR2,
    "BTN_SELECT": BTN_SELECT,
    "BTN_START": BTN_START,
    "BTN_MODE": BTN_MODE,
    "BTN_THUMBL": BTN_THUMBL,
    "BTN_THUMBR": BTN_THUMBR,
}

AXIS_NAMES = {
    "ABS_X": ABS_X,
    "ABS_Y": ABS_Y,
    "ABS_Z": ABS_Z,
    "ABS_RX": ABS_RX,
    "ABS_RY": ABS_RY,
    "ABS_RZ": ABS_RZ,
    "ABS_HAT0X": ABS_HAT0X,
    "ABS_HAT0Y": ABS_HAT0Y,
}

# struct input_event: timeval (tv_sec, tv_usec), type, code, value
# 64-bit Linux: timeval is 16 bytes (qq), type is uint16 (H), code is uint16 (H), value is int32 (i) = 24 bytes
INPUT_EVENT_FORMAT = "qqHHi"
INPUT_EVENT_SIZE = struct.calcsize(INPUT_EVENT_FORMAT)

# ioctl helpers
_IOC_NRBITS = 8
_IOC_TYPEBITS = 8
_IOC_SIZEBITS = 14
_IOC_DIRBITS = 2

_IOC_NRSHIFT = 0
_IOC_TYPESHIFT = _IOC_NRSHIFT + _IOC_NRBITS
_IOC_SIZESHIFT = _IOC_TYPESHIFT + _IOC_TYPEBITS
_IOC_DIRSHIFT = _IOC_SIZESHIFT + _IOC_SIZEBITS

_IOC_READ = 2


def _IOC(dir_: int, type_: int, nr: int, size: int) -> int:
    return (
        (dir_ << _IOC_DIRSHIFT)
        | (type_ << _IOC_TYPESHIFT)
        | (nr << _IOC_NRSHIFT)
        | (size << _IOC_SIZESHIFT)
    )


def EVIOCGBIT(ev: int, length: int) -> int:
    return _IOC(_IOC_READ, ord("E"), 0x20 + ev, length)


def EVIOCGNAME(length: int) -> int:
    return _IOC(_IOC_READ, ord("E"), 0x06, length)


def EVIOCGABS(axis: int) -> int:
    return _IOC(_IOC_READ, ord("E"), 0x40 + axis, 24)


def EVIOCGKEY(length: int) -> int:
    return _IOC(_IOC_READ, ord("E"), 0x18, length)


