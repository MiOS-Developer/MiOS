#!/bin/bash
# AI-hint: Provides high-speed fuzzy lookup against the cached environment inventory to resolve "launch <app>" requests into executable commands in <100ms, bypassing slow filesystem crawls.
# AI-related: /usr/libexec/mios/mios-find, /etc/mios/mios.toml, /usr/share/mios/mios.toml, mios-apps, mios-everything, mios-gui, mios-windows, mios-find-err, mios-hermes-browser, mios-shim
set -euo pipefail

if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    cat <<'USAGE'
usage: mios-find [--json] <query>

Fast fuzzy lookup against the MiOS environment inventory. Returns
the launch command for the best match, or lists candidates if the
query is ambiguous. Use as the FIRST step before any Get-ChildItem
when the operator asks to launch something.

Forms:
  mios-find <query>             -> ONE runnable launch line on stdout
  mios-find --json <query>      -> structured envelope:
                                   {ok, query, resolved:{launch,
                                    source, alias?}, alternates[]}
  mios-find <multi word query>  -> quote it: "<multi word query>"
  mios-find <alias>             -> resolved via mios.toml [mios-find.aliases]

The plain (no --json) output line is ready-to-execute (mios-gui
<id>, mios-windows launch <path>, etc.). Run it AS-IS; don't re-
shape into a different subcommand.
USAGE
    exit 0
fi

JSON_OUT=0
if [ "$1" = "--json" ]; then
    JSON_OUT=1
    shift
fi

QUERY="$*"
QUERY="${QUERY#\"}"
QUERY="${QUERY%\"}"

if [ "$JSON_OUT" -eq 1 ]; then
    _OUT="$("$0" "$QUERY" 2>/tmp/.mios-find-err.$$)"
    _RC=$?
    _ERR="$(cat /tmp/.mios-find-err.$$ 2>/dev/null)"
    rm -f /tmp/.mios-find-err.$$ 2>/dev/null
    _OUT="$_OUT" _ERR="$_ERR" _RC="$_RC" _QUERY="$QUERY" python3 - <<'PYEOF'
import json, os
out = os.environ.get("_OUT", "").strip()
err = os.environ.get("_ERR", "")
rc = int(os.environ.get("_RC", "0"))
query = os.environ.get("_QUERY", "")
envelope = {
    "ok": rc == 0,
    "verb": "mios_find",
    "query": query,
    "exit_code": rc,
}
if rc == 0 and out:
    envelope["resolved"] = {"launch": out}
    if "via mios-everything" in err:
        envelope["resolved"]["source"] = "mios-everything"
    elif "alias:" in err:
        envelope["resolved"]["source"] = "alias"
    else:
        envelope["resolved"]["source"] = "mios-apps"
    if err.strip():
        envelope["stderr_preview"] = err.strip()[:600]
else:
    envelope["error"] = "no_match"
    if err.strip():
        envelope["stderr_preview"] = err.strip()[:600]
print(json.dumps(envelope))
PYEOF
    exit "$_RC"
fi

ALIAS_TARGET=""
ALIAS_TARGET="$(python3 - "$(cd "$(dirname "$0")" && pwd)/../../lib/mios" "$QUERY" <<'PYEOF' 2>/dev/null
import sys
sys.path.insert(0, sys.argv[1])
import mios_toml
q = sys.argv[2].strip().lower()
if not q:
    sys.exit(0)
aliases = mios_toml.section(mios_toml.load_merged(), "mios-find.aliases")
if isinstance(aliases, dict):
    for k, v in aliases.items():
        if isinstance(k, str) and isinstance(v, str) and k.strip().lower() == q:
            print(v)
            sys.exit(0)
PYEOF
)"
if [ -n "$ALIAS_TARGET" ]; then
    echo "" >&2
    QUERY="$ALIAS_TARGET"
fi

if command -v mios-app-type >/dev/null 2>&1; then
    _app_type_resolved="$(mios-app-type "$QUERY" 2>/dev/null || true)"
    if [ -n "$_app_type_resolved" ] && [ "$_app_type_resolved" != "$QUERY" ]; then
        echo "" >&2
        QUERY="$_app_type_resolved"
    fi
fi

_REDUCED="$(python3 - "$(cd "$(dirname "$0")" && pwd)/../../lib/mios" "$QUERY" <<'PYEOF' 2>/dev/null
import sys, re
sys.path.insert(0, sys.argv[1])
import mios_toml
q = re.sub(r"\s+", "-", sys.argv[2].strip().lower())
if "-" not in q:
    sys.exit(0)
roles = set()
d = mios_toml.load_merged()
for a in (d.get("desktop", {}).get("apps", []) or []):
    if isinstance(a, dict) and a.get("role"):
        roles.add(str(a["role"]).lower().rstrip("s"))
last = q.split("-")[-1].rstrip("s")
head = re.sub(r"^(my|the|a|an)-", "", "-".join(q.split("-")[:-1]))
if (last in roles and head and len(head.replace("-", "")) >= 4
        and head.rstrip("s") not in roles):
    print(head.replace("-", " "))
PYEOF
)"
if [ -n "$_REDUCED" ]; then
    echo "" >&2
    QUERY="$_REDUCED"
fi

if command -v mios-everything >/dev/null 2>&1; then
    ES_OUT="$(mios-everything -n 5 -ext exe "$QUERY" 2>/dev/null || true)"
    if [ -n "$ES_OUT" ]; then
        FIRST_EXE="$(printf '%s\n' "$ES_OUT" | head -1)"
        if [ -n "$FIRST_EXE" ]; then
            ESCAPED="$(printf '%s' "$FIRST_EXE" | sed 's/\\/\\\\/g')"
            echo "Mios-windows launch \"$ESCAPED\""
            n_alt="$(printf '%s\n' "$ES_OUT" | wc -l)"
            if [ "$n_alt" -gt 1 ]; then
                echo ") other .exe matches:)" >&2
                printf '%s\n' "$ES_OUT" | tail -n +2 | sed 's/^/  /' >&2
            fi
            exit 0
        fi
    fi
fi

python3 - "$(cd "$(dirname "$0")" && pwd)/../../lib/mios" "$QUERY" <<'PYEOF'
import json
import os
import re
import subprocess
import sys
sys.path.insert(0, sys.argv[1])
import mios_toml

query = sys.argv[2].strip().lower()
if not query:
    print("mios-find: empty query", file=sys.stderr)
    sys.exit(2)

_DEFAULT_TIERS = [
    "name_exact", "name_prefix", "name_word", "name_substr",
    "desc_word", "desc_substr", "fuzzy",
]
_DEFAULT_CAT_PRIORITY = {
    "windows-browser": 1, "windows-app": 1, "windows-gui": 2,
    "linux-flatpak": 3, "linux-rpm-gui": 4, "agent-cli": 5,
    "mios-shim": 6, "service-url": 7,
}
_DEFAULT_FUZZY_MIN_TOKEN_LEN = 4
_DEFAULT_FUZZY_MAX_EDIT_DISTANCE = 2
_DEFAULT_FUZZY_MAX_EDIT_RATIO = 0.34


def _load_ranker_cfg():
    tiers = None
    cat_priority = None
    fuzzy_min = None
    fuzzy_cap = None
    fuzzy_ratio = None
    d = mios_toml.load_merged()
    mf = d.get("mios-find", {})
    if isinstance(mf, dict):
        r = mf.get("ranker", {})
        if isinstance(r, dict):
            if tiers is None and isinstance(r.get("tiers"), list):
                t = [str(x) for x in r["tiers"] if isinstance(x, str)]
                if t:
                    tiers = t
            if fuzzy_min is None and isinstance(r.get("fuzzy_min_token_len"), int):
                fuzzy_min = r["fuzzy_min_token_len"]
            if (fuzzy_cap is None
                    and isinstance(r.get("fuzzy_max_edit_distance"), int)):
                fuzzy_cap = r["fuzzy_max_edit_distance"]
            if (fuzzy_ratio is None
                    and isinstance(r.get("fuzzy_max_edit_ratio"), (int, float))):
                fuzzy_ratio = float(r["fuzzy_max_edit_ratio"])
        cp = mf.get("category_priority", {})
        if cat_priority is None and isinstance(cp, dict) and cp:
            try:
                cat_priority = {str(k): int(v) for k, v in cp.items()}
            except (TypeError, ValueError):
                cat_priority = None
    return (
        tiers if tiers is not None else list(_DEFAULT_TIERS),
        cat_priority if cat_priority is not None else dict(_DEFAULT_CAT_PRIORITY),
        fuzzy_min if fuzzy_min is not None else _DEFAULT_FUZZY_MIN_TOKEN_LEN,
        fuzzy_cap if fuzzy_cap is not None else _DEFAULT_FUZZY_MAX_EDIT_DISTANCE,
        fuzzy_ratio if fuzzy_ratio is not None else _DEFAULT_FUZZY_MAX_EDIT_RATIO,
    )


TIERS, CAT_PRIORITY, FUZZY_MIN_TOKEN_LEN, FUZZY_MAX_EDIT_DISTANCE, FUZZY_MAX_EDIT_RATIO = _load_ranker_cfg()
_TIER_RANK = {name: i for i, name in enumerate(TIERS)}

try:
    proc = subprocess.run(
        ["mios-apps", "--json"], capture_output=True, text=True, timeout=15
    )
    out = proc.stdout or ""
except (subprocess.TimeoutExpired, FileNotFoundError) as e:
    print(f"mios-find: mios-apps failed: {e}", file=sys.stderr)
    sys.exit(3)
if not out.strip():
    print(f"mios-find: mios-apps returned no inventory "
          f"(rc={proc.returncode}): {proc.stderr[:200]}", file=sys.stderr)
    sys.exit(3)

entries = []
for line in out.splitlines():
    line = line.strip()
    if not line:
        continue
    try:
        e = json.loads(line)
    except json.JSONDecodeError:
        continue
    name = (e.get("name") or "").lower()
    desc = (e.get("description") or "").lower()
    cat = e.get("category") or ""
    launch = e.get("launch") or e.get("command") or ""
    if not name or not launch:
        continue
    entries.append({
        "name": e.get("name"),
        "desc": e.get("description") or "",
        "cat": cat,
        "launch": launch,
        "lname": name,
        "ldesc": desc,
    })

def _lev(a, b, cap=3):
    if a == b:
        return 0
    la, lb = len(a), len(b)
    if abs(la - lb) > cap:
        return cap + 1
    if la < lb:
        a, b = b, a
        la, lb = lb, la
    prev = list(range(lb + 1))
    for i in range(1, la + 1):
        cur = [i] + [0] * lb
        row_min = cur[0]
        for j in range(1, lb + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            cur[j] = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
            if cur[j] < row_min:
                row_min = cur[j]
        if row_min > cap:
            return cap + 1
        prev = cur
    return prev[lb]

def rank(e):
    n = e["lname"]
    d = e["ldesc"]
    cat_w = CAT_PRIORITY.get(e["cat"], 99)

    def _r(name):
        return _TIER_RANK.get(name)

    t = _r("name_exact")
    if t is not None and n == query:
        return (t, cat_w, len(n))
    t = _r("name_prefix")
    if t is not None and n.startswith(query):
        return (t, cat_w, len(n))
    t = _r("name_word")
    if t is not None and re.search(rf"\b{re.escape(query)}", n):
        return (t, cat_w, len(n))
    t = _r("name_substr")
    if t is not None and query in n:
        return (t, cat_w, len(n))
    t = _r("desc_word")
    if t is not None and re.search(rf"\b{re.escape(query)}", d):
        return (t, cat_w, len(d))
    t = _r("desc_substr")
    if t is not None and query in d:
        return (t, cat_w, len(d))
    t = _r("fuzzy")
    if t is not None:
        q_tokens = [tok for tok in query.split()
                    if len(tok) >= FUZZY_MIN_TOKEN_LEN]
        n_tokens = n.split() + d.split()
        if q_tokens and n_tokens:
            matches = []
            for qt in q_tokens:
                dists = [_lev(qt, nt, cap=FUZZY_MAX_EDIT_DISTANCE) for nt in n_tokens]
                best_for_token = min(dists, default=99)
                allowed = min(FUZZY_MAX_EDIT_DISTANCE,
                              int(len(qt) * FUZZY_MAX_EDIT_RATIO))
                if best_for_token <= allowed:
                    matches.append(best_for_token)
            if len(matches) == len(q_tokens):
                best = max(matches)
                return (t, cat_w, best * 100 + len(n))
    return None

scored = []
for e in entries:
    r = rank(e)
    if r is not None:
        scored.append((r, e))
scored.sort(key=lambda x: x[0])

if not scored:
    print(f'no match for "{query}" in inventory; '
          f'try `mios-apps --filter {query}` or list with `mios-apps`',
          file=sys.stderr)
    sys.exit(1)

best = scored[0][1]
print(best["launch"].replace("\\", "\\\\"))
if len(scored) > 1:
    n_alt = min(4, len(scored) - 1)
    print(f'(picked best of {len(scored)}; {n_alt} alternatives:)',
          file=sys.stderr)
    for i, (_, e) in enumerate(scored[1:1+n_alt], 1):
        print(f'  {i}. [{e["cat"]:<14}] {e["name"]:<30} -> {e["launch"]}',
              file=sys.stderr)
sys.exit(0)
PYEOF
