#!/usr/bin/env python3
# AI-hint: CLI over usr/lib/mios/mios_credentials.py -- prints the layered-SSOT account name / sha512 hash, or writes the 0600 MIOS_RESOLVED_JSON the Windows (answer file, DISM, UUP, ISO) pipeline overlays. Fails closed (exit 3) naming the missing key.
# AI-related: usr/lib/mios/mios_credentials.py, automation/11-user.sh, automation/build-mios.sh, mios-bootstrap field/autounattend/MiOS-Provision.lib.ps1
"""mios-credential -- fail-closed credential reads from the layered mios.toml.

  mios-credential username            [identity].username
  mios-credential hash                sha512-crypt for /etc/shadow (env hash > [auth].password_hash > default_password)
  mios-credential sysrescue-user      [field.sysrescue].username -> [identity].username
  mios-credential identity KEY        a PUBLIC [identity] key (username|fullname|hostname|shell) from
                                      the merged layers, WITHOUT validating the credential plane
                                      (empty output when unset or when no layer exists; installers prompt)
  mios-credential check               validate every credential key (no output on success)
  mios-credential win-json --out F    write the Windows projection JSON (mode 0600, atomic)

Layers follow mios_toml (MIOS_TOML_ROOT, MIOS_VENDOR_TOML(_D), MIOS_HOST_TOML(_D),
MIOS_USER_TOML(_D)). Passwords are never printed except as a hash.
"""

from __future__ import annotations

import json
import os
import sys
import tempfile

for _lib in (os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios")),
             "/usr/lib/mios"):
    if os.path.isfile(os.path.join(_lib, "mios_credentials.py")):
        sys.path.insert(0, _lib)
        break

import mios_credentials as mc  # noqa: E402


def _write_0600(path: str, text: str) -> None:
    d = os.path.dirname(os.path.abspath(path)) or "."
    fd, tmp = tempfile.mkstemp(prefix=".mios-cred.", dir=d)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise
    dfd = os.open(d, os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    cmd = argv[0]
    if cmd == "identity":
        if len(argv) != 2:
            print("usage: mios-credential identity username|fullname|hostname|shell", file=sys.stderr)
            return 2
        if argv[1] not in mc.IDENTITY_PUBLIC_KEYS:
            print(f"mios-credential: identity.{argv[1]} is not a public identity key", file=sys.stderr)
            return 2
        try:
            print(mc.identity_field(mc.load(), argv[1]))
        except mc.CredentialError:
            print("")          # no SSOT layer on this host yet -- the caller prompts
        return 0
    try:
        data = mc.load()
        if cmd == "username":
            print(mc.resolve(data)["username"])
        elif cmd == "hash":
            print(mc.password_hash(data))
        elif cmd == "sysrescue-user":
            print(mc.sysrescue(data)["username"])
        elif cmd == "check":
            mc.resolve(data)
        elif cmd == "win-json":
            if len(argv) != 3 or argv[1] != "--out":
                print("usage: mios-credential win-json --out FILE", file=sys.stderr)
                return 2
            _write_0600(argv[2], json.dumps(mc.windows_projection(data), indent=1, sort_keys=True))
        else:
            print(f"mios-credential: unknown command '{cmd}'", file=sys.stderr)
            return 2
    except mc.CredentialError as exc:
        print(f"[mios-credential] ERROR: {exc}", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
