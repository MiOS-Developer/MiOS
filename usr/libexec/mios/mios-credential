#!/usr/bin/env python3
# AI-hint: CLI over usr/lib/mios/mios_credentials.py -- account name, sha512 hash, the 0600 Windows MIOS_RESOLVED_JSON, and `apply`, which reconciles every admin surface to the mios.html credential. Fails closed (exit 3) naming the key.
# AI-related: usr/lib/mios/mios_credentials.py, automation/11-user.sh, automation/build-mios.sh, mios-bootstrap field/autounattend/MiOS-Provision.lib.ps1, mios-credential-apply.service, mios-credential-apply.timer, forge-firstboot.sh, mios-ttyd-launch
"""mios-credential -- fail-closed credential reads from the layered mios.toml.

  mios-credential username            [identity].username
  mios-credential hash                sha512-crypt for /etc/shadow (env hash > [auth].password_hash > default_password)
  mios-credential sysrescue-user      [field.sysrescue].username -> [identity].username
  mios-credential identity KEY [--operator]
                                      a PUBLIC [identity] key (username|fullname|hostname|shell|email)
                                      from the merged layers, WITHOUT validating the credential plane
                                      (empty output when unset or when no layer exists; installers
                                      prompt). --operator reads the operator view (see below).
  mios-credential get TABLE.KEY       a NON-secret scalar from the operator view -- what root code
                                      such as forge-firstboot.sh reads, so it agrees with apply
                                      (secret paths are refused; empty when unset)
  mios-credential check               validate every credential key (no output on success)
  mios-credential win-json --out F    write the Windows projection JSON (mode 0600, atomic)
  mios-credential apply [--check] [--verify] [--wait] [--bootstrap] [--no-restart] (--all | SURFACE...)
                                      first merge the Portal's queued credential saves into the
                                      operator tier, then reconcile portal|forge|code_server|ttyd|
                                      owui|shadow to the operator credential; --all = [security.
                                      credential_apply].surfaces; --check reports drift (exit 1)
                                      and changes nothing;
                                      --verify re-proves forge against its live login; --wait waits
                                      [services.forge].ready_timeout_s; --bootstrap also creates
                                      [services.forge].initial_repo; --no-restart queues no unit
                                      restart (a unit's own ExecStartPre)
  mios-credential exec ttyd -- ARGS   exec ttyd with -c from the ttyd credstore `apply ttyd`
                                      writes ($CREDENTIALS_DIRECTORY, the units' ImportCredential=),
                                      then ARGS; exit 3 when nothing was applied

Layers follow mios_toml (MIOS_TOML_ROOT, MIOS_VENDOR_TOML(_D), MIOS_HOST_TOML(_D),
MIOS_USER_TOML(_D)). apply, get and --operator read the OPERATOR view
(mios_toml.operator_view): a system caller (root, a service uid) resolves [identity].username
from the vendor/host tiers, reads that account's ~/.config/mios/mios.toml (the file
mios.html writes) and takes from it ONLY [security.operator_tier] -- the credential values
and enable toggles; everything else stays vendor/host. A layer that does not parse, an
operator that cannot be located, or an operator credential that must be refused (not a
string, control characters) fails closed (exit 3, nothing written). One apply runs at a
time (a flock in [paths].var_credential_apply_dir; a second waits). Passwords are never
printed except as a hash, never logged and never put on a command line, except ttyd's -c:
ttyd reads it nowhere else and local uids can read it in /proc, so ttyd gets its OWN login
([ttyd].auth_pass / MIOS_TTYD_AUTH_PASS, else a secret generated once and kept root-only),
never a shared credential (one equal to any is refused). apply never moves a surface whose
last credential was operator-set back to a vendor/host default (exit 3, nothing written).
"""

from __future__ import annotations

import json
import os
import sys
import tempfile

for _lib in (os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios")),
             "/usr/lib/mios"):
    if os.path.isfile(os.path.join(_lib, "mios_credentials.py")):
        sys.path.insert(0, _lib)
        break

import mios_credentials as mc  # noqa: E402


def _write_0600(path: str, text: str) -> None:
    d = os.path.dirname(os.path.abspath(path)) or "."
    fd, tmp = tempfile.mkstemp(prefix=".mios-cred.", dir=d)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise
    dfd = os.open(d, os.O_DIRECTORY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    cmd = argv[0]
    if cmd == "identity":
        operator = argv[2:] == ["--operator"]
        if len(argv) != 2 + operator:
            print("usage: mios-credential identity username|fullname|hostname|shell|email [--operator]", file=sys.stderr)
            return 2
        if argv[1] not in mc.IDENTITY_PUBLIC_KEYS:
            print(f"mios-credential: identity.{argv[1]} is not a public identity key", file=sys.stderr)
            return 2
        try:
            print(mc.identity_field(mc.operator_load()[0] if operator else mc.load(), argv[1]))
        except mc.CredentialError as exc:
            if operator:
                print(f"[mios-credential] ERROR: {exc}", file=sys.stderr)
                return 3
            print("")          # no SSOT layer on this host yet -- the caller prompts
        return 0
    if cmd == "get":
        if len(argv) != 2 or "." not in argv[1]:
            print("usage: mios-credential get TABLE.KEY", file=sys.stderr)
            return 2
        import mios_toml
        try:
            data, _reason, _taken = mc.operator_load()
            secret = set(mc._sect(data, "security.secret_keys").get("paths") or [])
            secret |= set(mc._sect(data, "security.operator_tier").get("values") or [])
            if argv[1] in secret:
                print(f"mios-credential: {argv[1]} is a secret path", file=sys.stderr)
                return 2
            table, key = argv[1].rsplit(".", 1)
            val = mc._sect(data, table).get(key)
            if isinstance(val, (dict, list)):
                print(f"mios-credential: {argv[1]} is not a scalar", file=sys.stderr)
                return 2
            print(mios_toml.expand_refs(data, mc._s(val)) if val is not None else "")
        except (mc.CredentialError, mios_toml.LayerError) as exc:
            print(f"[mios-credential] ERROR: {exc}", file=sys.stderr)
            return 3
        return 0
    if cmd == "apply":
        flags = {a for a in argv[1:] if a.startswith("--")}
        names = [a for a in argv[1:] if not a.startswith("--")]
        unknown = flags - {"--check", "--verify", "--wait", "--bootstrap", "--all", "--no-restart"}
        if unknown or bool(names) == ("--all" in flags) or any(n not in mc.SURFACES for n in names):
            print("usage: mios-credential apply [--check] [--verify] [--wait] [--bootstrap] [--no-restart] "
                  f"(--all | {'|'.join(mc.SURFACES)}...)", file=sys.stderr)
            return 2
        try:
            data, reason, _taken = mc.operator_load()
            log = lambda m: print(f"[mios-credential] {m}", file=sys.stderr)  # noqa: E731
            try:
                _lock = mc.apply_lock(data)   # held until exit; a concurrent apply waits here
            except OSError as exc:
                log(f"apply: no lock ({exc.strerror or type(exc).__name__}); running unserialized")
            data, reason, _taken = mc.operator_load()     # re-read: a run we waited for changed it
            log(f"apply: {reason}")
            mc.scrub_leftovers(data, log, check="--check" in flags)
            if mc.ingest_inbox(data, log, check="--check" in flags):
                data, reason, _taken = mc.operator_load()     # the merged save is the input now
            if "--check" not in flags:
                mc.publish_operator_toggles(data, log)
            return mc.apply(mc.enabled_surfaces(data) if "--all" in flags else names, data,
                            check="--check" in flags, verify="--verify" in flags,
                            wait="--wait" in flags, bootstrap="--bootstrap" in flags,
                            restart="--no-restart" not in flags, log=log, taken=_taken)
        except mc.CredentialError as exc:
            print(f"[mios-credential] ERROR: {exc}", file=sys.stderr)
            return 3
    if cmd == "exec":
        if len(argv) < 3 or argv[1] != "ttyd" or argv[2] != "--":
            print("usage: mios-credential exec ttyd -- ARGS...", file=sys.stderr)
            return 2
        try:
            args = mc.ttyd_argv(argv[3:])
        except mc.CredentialError as exc:
            print(f"[mios-credential] ERROR: {exc}", file=sys.stderr)
            return 3
        os.execvp(args[0], args)
    try:
        data = mc.load()
        if cmd == "username":
            print(mc.resolve(data)["username"])
        elif cmd == "hash":
            print(mc.password_hash(data))
        elif cmd == "sysrescue-user":
            print(mc.sysrescue(data)["username"])
        elif cmd == "check":
            mc.resolve(data)
        elif cmd == "win-json":
            if len(argv) != 3 or argv[1] != "--out":
                print("usage: mios-credential win-json --out FILE", file=sys.stderr)
                return 2
            _write_0600(argv[2], json.dumps(mc.windows_projection(data), indent=1, sort_keys=True))
        else:
            print(f"mios-credential: unknown command '{cmd}'", file=sys.stderr)
            return 2
    except mc.CredentialError as exc:
        print(f"[mios-credential] ERROR: {exc}", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
