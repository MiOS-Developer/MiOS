#!/usr/bin/env python3
# AI-hint: A/B UKI staging and systemd-ukify compilation pipeline with baked kargs (task_451).
# AI-doc: usr/share/doc/mios/manual/ch02-boot-and-lifecycle.md
from __future__ import annotations

import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
from typing import Any, Dict, List, Optional

_HERE = os.path.dirname(os.path.abspath(__file__))
_REPO_ROOT = os.path.normpath(os.path.join(_HERE, "..", ".."))

DEFAULT_CMDLINE_PATH = "/usr/lib/kernel/cmdline"
DEFAULT_OUTPUT_EFI = "/boot/EFI/Linux/mios-next.efi"
DEFAULT_LOADER_ENTRY = "/boot/loader/entries/mios-next.conf"


def load_baked_cmdline(root: str = "/") -> str:
    """Loads authoritative kernel command line baked into image."""
    cmdline_file = os.path.join(root, "usr/lib/kernel/cmdline")
    if os.path.isfile(cmdline_file):
        with open(cmdline_file, "r", encoding="utf-8") as f:
            return f.read().strip()

    # Fallback to scanning kargs.d
    kargs_dir = os.path.join(root, "usr/lib/bootc/kargs.d")
    args: List[str] = []
    if os.path.isdir(kargs_dir):
        for toml_path in sorted(glob.glob(os.path.join(kargs_dir, "*.toml"))):
            try:
                with open(toml_path, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith('"') and line.endswith('",'):
                            args.append(line.strip('",'))
            except OSError:
                pass
    return " ".join(args)


def find_kernel_and_initrd(root: str = "/") -> Dict[str, Optional[str]]:
    """Locates newest kernel vmlinuz and initramfs."""
    modules_dir = os.path.join(root, "lib/modules")
    if not os.path.isdir(modules_dir):
        modules_dir = os.path.join(root, "usr/lib/modules")

    vmlinuz: Optional[str] = None
    initrd: Optional[str] = None

    if os.path.isdir(modules_dir):
        versions = sorted(os.listdir(modules_dir), reverse=True)
        for ver in versions:
            cand_vmlinuz = os.path.join(modules_dir, ver, "vmlinuz")
            if os.path.isfile(cand_vmlinuz):
                vmlinuz = cand_vmlinuz
                cand_initrd = os.path.join(modules_dir, ver, "initramfs.img")
                if os.path.isfile(cand_initrd):
                    initrd = cand_initrd
                break

    if not vmlinuz:
        for cand in sorted(glob.glob(os.path.join(root, "boot/vmlinuz-*")), reverse=True):
            if os.path.isfile(cand):
                vmlinuz = cand
                ver = os.path.basename(cand).replace("vmlinuz-", "")
                cand_initrd = os.path.join(root, f"boot/initramfs-{ver}.img")
                if os.path.isfile(cand_initrd):
                    initrd = cand_initrd
                break

    return {"vmlinuz": vmlinuz, "initrd": initrd}


def stage_uki(
    output_efi: str = DEFAULT_OUTPUT_EFI,
    loader_entry: Optional[str] = None,
    kernel_path: Optional[str] = None,
    initrd_path: Optional[str] = None,
    cmdline: Optional[str] = None,
    oneshot: bool = False,
    dry_run: bool = False,
    root: str = "/",
    simulate: bool = False,
) -> Dict[str, Any]:
    """Compiles kernel + initrd + baked kargs into staged UKI and writes loader entry."""
    discovered = find_kernel_and_initrd(root)
    kernel = kernel_path or discovered["vmlinuz"] or "/boot/vmlinuz-simulated"
    initrd = initrd_path or discovered["initrd"] or "/boot/initramfs-simulated.img"
    baked_cmdline = cmdline or load_baked_cmdline(root) or "rw quiet splash"

    result: Dict[str, Any] = {
        "status": "success",
        "output_efi": output_efi,
        "kernel": kernel,
        "initrd": initrd,
        "baked_kargs": baked_cmdline,
        "dry_run": dry_run,
        "ukify_executed": False,
        "oneshot_configured": False,
    }

    ukify_bin = shutil.which("ukify")

    if not dry_run:
        # A missing compiler or input is an error, never a quietly simulated
        # UKI: the loader entry below would point the next boot at a text file.
        if not simulate:
            if not ukify_bin:
                result["status"] = "error"
                result["error"] = "ukify not found on PATH (install systemd-ukify, or pass --simulate)"
                return result
            missing = [p for p in (kernel, initrd) if not os.path.isfile(p)]
            if missing:
                result["status"] = "error"
                result["error"] = f"kernel/initrd not found: {', '.join(missing)}"
                return result
        os.makedirs(os.path.dirname(output_efi), exist_ok=True)
        if not simulate:
            cmd = [
                ukify_bin,
                "build",
                f"--linux={kernel}",
                f"--initrd={initrd}",
                f"--cmdline={baked_cmdline}",
                f"--output={output_efi}",
            ]
            try:
                subprocess.run(cmd, check=True, capture_output=True)
                result["ukify_executed"] = True
            except subprocess.CalledProcessError as e:
                result["status"] = "error"
                result["error"] = f"ukify failed: {e.stderr.decode().strip()}"
                return result
            except OSError as e:
                # Found on PATH but not runnable (exec format, permission): an
                # error result, not a traceback that skips the JSON report.
                result["status"] = "error"
                result["error"] = f"ukify could not run: {e}"
                return result
        else:
            # --simulate only: a header envelope for container/test environments
            with open(output_efi, "w", encoding="utf-8") as f:
                f.write(f"MZ-SIMULATED-UKI\nKERNEL={kernel}\nINITRD={initrd}\nCMDLINE={baked_cmdline}\n")
            result["ukify_executed"] = False
            result["simulated"] = True

        # Determine target loader entry
        if loader_entry:
            loader_entry_path = loader_entry
        else:
            entry_cand = os.path.join(root, DEFAULT_LOADER_ENTRY.lstrip("/"))
            try:
                os.makedirs(os.path.dirname(entry_cand), exist_ok=True)
                loader_entry_path = entry_cand
            except OSError:
                # Fallback to alongside output_efi if /boot is unwritable
                loader_entry_path = os.path.join(os.path.dirname(output_efi), "mios-next.conf")

        try:
            os.makedirs(os.path.dirname(loader_entry_path), exist_ok=True)
            with open(loader_entry_path, "w", encoding="utf-8") as f:
                f.write("# MiOS A/B UKI Staging Boot Entry (task_451)\n")
                f.write("title MiOS Next (Staged UKI)\n")
                f.write(f"linux /EFI/Linux/{os.path.basename(output_efi)}\n")
                f.write("options (baked into UKI)\n")
            result["loader_entry"] = loader_entry_path
        except OSError as e:
            result["loader_entry_warning"] = f"Could not write loader entry: {e}"

        if oneshot and shutil.which("bootctl"):
            try:
                subprocess.run(
                    ["bootctl", "set-oneshot", os.path.basename(loader_entry_path)],
                    capture_output=True,
                    check=True,
                )
                result["oneshot_configured"] = True
            except Exception:
                pass

    return result


def main() -> int:
    parser = argparse.ArgumentParser(
        description="A/B UKI staging and systemd-ukify compilation pipeline (task_451)"
    )
    parser.add_argument("--output", default=DEFAULT_OUTPUT_EFI, help="Destination UKI EFI binary")
    parser.add_argument("--loader-entry", help="Custom path for systemd-boot loader entry")
    parser.add_argument("--root", default="/", help="Filesystem root directory")
    parser.add_argument("--kernel", help="Kernel vmlinuz image")
    parser.add_argument("--initrd", help="Initramfs image")
    parser.add_argument("--cmdline", help="Explicit kernel command line to bake into UKI")
    parser.add_argument("--oneshot", action="store_true", help="Set bootctl oneshot to staged entry")
    parser.add_argument("--dry-run", action="store_true", help="Report the plan without writing files")
    parser.add_argument("--simulate", action="store_true",
                        help="Write a placeholder UKI envelope instead of running ukify (test/container use only)")
    parser.add_argument("--json", action="store_true", help="Output in JSON format")

    args = parser.parse_args()

    res = stage_uki(
        output_efi=args.output,
        loader_entry=args.loader_entry,
        kernel_path=args.kernel,
        initrd_path=args.initrd,
        cmdline=args.cmdline,
        oneshot=args.oneshot,
        dry_run=args.dry_run,
        root=args.root,
        simulate=args.simulate,
    )

    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print(f"[mios-ukify-stage] Status: {res['status'].upper()}")
        if res.get("error"):
            print(f"  - Error: {res['error']}")
        print(f"  - Target EFI: {res['output_efi']}")
        print(f"  - Kernel: {res['kernel']}")
        print(f"  - Initrd: {res['initrd']}")
        print(f"  - Baked kargs: {res['baked_kargs']}")
        if res.get("loader_entry"):
            print(f"  - Loader Entry: {res['loader_entry']}")
        if res.get("oneshot_configured"):
            print(f"  - Oneshot Boot: ACTIVE")

    return 0 if res["status"] == "success" else 1


if __name__ == "__main__":
    sys.exit(main())
