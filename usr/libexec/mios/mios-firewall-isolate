#!/usr/bin/env python3
# AI-hint: Declarative nftables inter-container firewall rule generator and micro-segmentation enforcer (task_423).
# AI-doc: usr/share/doc/mios/manual/ch20-firewall-nftables-microsegmentation.md
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tomllib
from typing import Any, Dict, List, Optional

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "..", "lib", "mios"))
import mios_toml  # noqa: E402  -- the ONE shared layered-mios.toml resolver

DEFAULT_TOML_PATH = "/usr/share/mios/mios.toml"
DEFAULT_NFT_CONF = "/etc/nftables/mios_container_isolate.nft"

_HERE = os.path.dirname(os.path.abspath(__file__))
_REPO_ROOT = os.path.normpath(os.path.join(_HERE, "..", ".."))
_LOCAL_TOML = os.path.join(_REPO_ROOT, "usr", "share", "mios", "mios.toml")
if not os.path.exists(DEFAULT_TOML_PATH) and os.path.exists(_LOCAL_TOML):
    DEFAULT_TOML_PATH = _LOCAL_TOML


def load_firewall_matrix(toml_path: str) -> Dict[str, Any]:
    """Loads container firewall matrix from mios.toml."""
    if not os.path.isfile(toml_path):
        return {"default_policy": "drop", "rules": []}

    try:
        with open(toml_path, "rb") as f:
            data = tomllib.load(f)
        return data.get("network", {}).get("firewall", {}).get("container_matrix", {
            "default_policy": "drop",
            "rules": [],
        })
    except Exception as e:
        return {"default_policy": "drop", "rules": [], "error": str(e)}


def rule_port(rule: Dict[str, Any]) -> int:
    """A rule's destination port: a literal `port`, or `port_key` naming a
    [ports] key. A port_key resolves through the layered SSOT exactly as
    install.env renders MIOS_PORTS_<KEY> (vendor < host < user, the
    [ports.categories] derivation, the [ports].stack_id offset), whatever file
    --toml names for the matrix. Nothing stands in for a key that does not
    resolve: ValueError names the rule and the key."""
    where = f"rule {rule.get('source', '?')}->{rule.get('destination', '?')}"
    key = rule.get("port_key")
    if key is not None and "port" in rule:
        raise ValueError(f"{where}: set port or port_key, not both")
    if key is None:
        if "port" not in rule:
            raise ValueError(f"{where}: neither port nor port_key is set")
        try:
            return int(rule["port"])
        except (TypeError, ValueError):
            raise ValueError(f"{where}: port {rule['port']!r} is not a port number") from None
    try:
        return int(mios_toml.resolved_export(mios_toml.canonical_name(f"ports.{key}")))
    except KeyError as e:
        raise ValueError(f"{where}: port_key {key!r}: {e.args[0]}") from None


def resolve_rules(matrix: Dict[str, Any]) -> Dict[str, Any]:
    """The matrix with every rule's `port` resolved (rule_port)."""
    rules = [{**rule, "port": rule_port(rule)} for rule in matrix.get("rules", [])]
    return {**matrix, "rules": rules}


def generate_nftables_ruleset(matrix: Dict[str, Any]) -> str:
    """Generates declarative nftables configuration with default-deny policy."""
    lines = [
        "#!/usr/sbin/nft -f",
        "# AI-hint: Auto-generated declarative nftables container micro-segmentation table (task_423)",
        "",
        "table inet mios_container_isolate {",
        "    chain forward {",
        "        type filter hook forward priority 0; policy drop;",
        "",
        "        # Allow established and related connections",
        "        ct state established,related accept",
        "",
        "        # Allow loopback interface traffic",
        "        iifname \"lo\" accept",
        "",
        "        # Micro-segmentation container whitelist rules",
    ]

    for rule in matrix.get("rules", []):
        src = rule.get("source", "any")
        dst = rule.get("destination", "any")
        port = rule.get("port")
        proto = rule.get("protocol", "tcp")
        comment = f"# Allow {src} -> {dst}:{port}/{proto}"
        lines.append(f"        {proto} dport {port} accept comment \"{src}->{dst}\"")

    lines.extend([
        "",
        "        # Log dropped undeclared inter-container cross-talk",
        "        iifname \"podman+\" oifname \"podman+\" log prefix \"[mios-fw-drop] \" drop",
        "        # Drop any remaining transit traffic",
        "        drop",
        "    }",
        "}",
        "",
    ])
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Declarative nftables inter-container firewall rule generator (task_423)"
    )
    parser.add_argument("--toml", default=DEFAULT_TOML_PATH, help="Path to mios.toml")
    parser.add_argument("--generate", action="store_true", help="Generate nftables ruleset to stdout")
    parser.add_argument("--apply", action="store_true", help="Apply generated nftables ruleset to active kernel")
    parser.add_argument("--out", default=DEFAULT_NFT_CONF, help="Output nftables file path")
    parser.add_argument("--check", action="store_true", help="Validate ruleset syntax and policy conformance")
    parser.add_argument("--dry-run", action="store_true", help="Simulate applying ruleset")
    parser.add_argument("--json", action="store_true", help="Output matrix and status in JSON")

    args = parser.parse_args()

    try:
        matrix = resolve_rules(load_firewall_matrix(args.toml))
    except ValueError as e:
        print(f"mios-firewall-isolate: [network.firewall.container_matrix] {e}", file=sys.stderr)
        return 78
    ruleset = generate_nftables_ruleset(matrix)

    if args.generate and not args.json:
        print(ruleset)
        return 0

    apply_status = "unapplied"
    if args.apply:
        if args.dry_run:
            apply_status = "simulated"
        else:
            try:
                os.makedirs(os.path.dirname(args.out), exist_ok=True)
                with open(args.out, "w", encoding="utf-8") as f:
                    f.write(ruleset)
            except OSError:
                pass

            if shutil.which("nft"):
                try:
                    res = subprocess.run(["nft", "-c", "-f", "-"], input=ruleset, text=True, capture_output=True)
                    if res.returncode == 0:
                        subprocess.run(["nft", "-f", "-"], input=ruleset, text=True, capture_output=True)
                        apply_status = "applied"
                    else:
                        apply_status = f"syntax_error: {res.stderr.strip()}"
                except OSError as e:
                    apply_status = f"exec_error: {e}"
            else:
                apply_status = "nft_absent_staged"

    output = {
        "status": "valid",
        "default_policy": matrix.get("default_policy", "drop"),
        "rule_count": len(matrix.get("rules", [])),
        "rules": matrix.get("rules", []),
        "apply_status": apply_status,
        "nft_file": args.out,
        "ruleset": ruleset,
    }

    if args.json:
        print(json.dumps(output, indent=2))
    else:
        print(f"[mios-firewall-isolate] Matrix Rules: {len(matrix.get('rules', []))} (Default Policy: {matrix.get('default_policy', 'drop').upper()})")
        print(f"  - Ruleset Generated: {len(ruleset.splitlines())} lines")
        print(f"  - Apply Status: {apply_status}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
