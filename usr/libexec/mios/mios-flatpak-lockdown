#!/usr/bin/env python3
# AI-hint: Flatpak permission lockdown profile validator and manager (task_433).
# AI-doc: usr/share/doc/mios/manual/ch31-desktop-applications-and-flatpaks.md
from __future__ import annotations

import argparse
import configparser
import json
import os
import sys
from typing import Any, Dict

DEFAULT_GLOBAL_OVERRIDE = "/usr/share/flatpak/overrides/global"
_HERE = os.path.dirname(os.path.abspath(__file__))
_LOCAL_GLOBAL = os.path.normpath(os.path.join(_HERE, "..", "..", "share", "flatpak", "overrides", "global"))


def inspect_profile(path: str) -> Dict[str, Any]:
    target = path
    if not os.path.exists(target) and os.path.exists(_LOCAL_GLOBAL):
        target = _LOCAL_GLOBAL

    if not os.path.exists(target):
        return {"status": "missing", "path": target, "valid": False}

    cfg = configparser.ConfigParser()
    cfg.read(target)

    sockets = cfg.get("Context", "sockets", fallback="")
    filesystems = cfg.get("Context", "filesystems", fallback="")
    devices = cfg.get("Context", "devices", fallback="")

    x11_disabled = "!x11" in sockets
    wayland_enabled = "wayland" in sockets
    host_fs_denied = "!host" in filesystems
    portal_mediated = "org.freedesktop.portal.*" in cfg.get("Session Bus Policy", "org.freedesktop.portal.*", fallback="") or "talk" in cfg.get("Session Bus Policy", "org.freedesktop.portal.*", fallback="")

    valid = x11_disabled and wayland_enabled and host_fs_denied

    return {
        "status": "valid" if valid else "non_compliant",
        "path": target,
        "x11_disabled": x11_disabled,
        "wayland_enabled": wayland_enabled,
        "host_fs_denied": host_fs_denied,
        "portal_mediated": portal_mediated,
        "devices": devices,
        "valid": valid,
    }


def verify_boundaries(path: str) -> Dict[str, Any]:
    info = inspect_profile(path)
    if not info.get("valid"):
        return {"status": "invalid_profile", "valid": False, "checks": {}}

    cfg = configparser.ConfigParser()
    cfg.read(info["path"])

    sockets = [s.strip() for s in cfg.get("Context", "sockets", fallback="").split(";") if s.strip()]
    filesystems = [f.strip() for f in cfg.get("Context", "filesystems", fallback="").split(";") if f.strip()]

    # 1. Shadow read test: !host, !host-os, !host-etc explicitly forbid /etc/shadow access
    shadow_blocked = ("!host" in filesystems or "!host-os" in filesystems or "!host-etc" in filesystems) and "host" not in filesystems and "/etc" not in filesystems

    # 2. X11 socket test: !x11 prevents mounting /tmp/.X11-unix
    x11_blocked = "!x11" in sockets and "x11" not in sockets

    # 3. Wayland enabled
    wayland_allowed = "wayland" in sockets

    # 4. Bus policy: org.freedesktop.portal.* allowed, org.freedesktop.Flatpak denied
    portal_allowed = cfg.get("Session Bus Policy", "org.freedesktop.portal.*", fallback="") in ("talk", "own")
    flatpak_denied = cfg.get("Session Bus Policy", "org.freedesktop.Flatpak", fallback="") == "none"

    all_passed = shadow_blocked and x11_blocked and wayland_allowed and portal_allowed and flatpak_denied

    return {
        "status": "contained" if all_passed else "leak_detected",
        "valid": all_passed,
        "shadow_blocked": shadow_blocked,
        "x11_blocked": x11_blocked,
        "wayland_allowed": wayland_allowed,
        "portal_allowed": portal_allowed,
        "flatpak_denied": flatpak_denied,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Flatpak permission lockdown profile manager (task_433, task_434)")
    parser.add_argument("--profile", default=DEFAULT_GLOBAL_OVERRIDE, help="Path to global override file")
    parser.add_argument("--check", action="store_true", help="Check compliance of global override profile")
    parser.add_argument("--verify-boundaries", action="store_true", help="Verify XDG desktop portal and sandbox boundary containment")
    parser.add_argument("--json", action="store_true", help="Emit JSON output")

    args = parser.parse_args()

    if args.verify_boundaries:
        res = verify_boundaries(args.profile)
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"[mios-flatpak-lockdown] Boundary Verification: {res['status'].upper()}")
            print(f"  - Direct /etc/shadow Read Blocked: {res.get('shadow_blocked')}")
            print(f"  - X11 Display Socket Blocked: {res.get('x11_blocked')}")
            print(f"  - Wayland Socket Allowed: {res.get('wayland_allowed')}")
            print(f"  - Portal Communication Mediated: {res.get('portal_allowed')}")
            print(f"  - Flatpak Escape Denied: {res.get('flatpak_denied')}")
        return 0 if res["valid"] else 1

    info = inspect_profile(args.profile)

    if args.json:
        print(json.dumps(info, indent=2))
    else:
        print(f"[mios-flatpak-lockdown] Status: {info['status'].upper()} (Path: {info['path']})")
        print(f"  - X11 Disabled: {info.get('x11_disabled')}")
        print(f"  - Wayland Enforced: {info.get('wayland_enabled')}")
        print(f"  - Host FS Denied: {info.get('host_fs_denied')}")
        print(f"  - Portal Mediation: {info.get('portal_mediated')}")

    return 0 if info["valid"] else 1


if __name__ == "__main__":
    sys.exit(main())
