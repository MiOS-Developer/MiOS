#!/usr/bin/env bash
# AI-hint: The `mios blade` verb -- the day-2 face of the blade archetype (WS-BLADE). Writes the HOST tier (/etc/mios/role.conf) and re-runs role-apply, which detects the change and activates the new role target. Every argument is validated against the SSOT before it is written: an unknown archetype or an ungrantable capability is refused with the legal set, because both used to be accepted verbatim and produced a blade that silently started nothing.
# AI-related: usr/lib/mios/blade.sh, usr/libexec/mios/role-apply, /etc/mios/role.conf, /etc/mios/blade.d/, usr/share/mios/mios.toml, usr/share/doc/mios/adr/0016-blade-node-topology.md
# AI-functions: log, die, show_help, _load_ssot, _require_archetype, _require_capability, _set_conf_key
set -euo pipefail

ROLE_CONF="${MIOS_ETC_DIR:-/etc/mios}/role.conf"
BLADE_D="${MIOS_ETC_DIR:-/etc/mios}/blade.d"
BLADE_ENV="${MIOS_PATHS_BLADE_ENV:-/run/mios/blade.env}"

log() { printf '[mios-blade] %s\n' "$*"; }
die() { printf '[mios-blade] ERROR: %s\n' "$*" >&2; exit 1; }

_BLADE_LIB="$(dirname "$0")/../../lib/mios/blade.sh"
if [[ -r "/usr/lib/mios/blade.sh" ]]; then
    # shellcheck source=/dev/null
    source /usr/lib/mios/blade.sh
elif [[ -r "$_BLADE_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$_BLADE_LIB"
fi

SSOT_TYPE=""; SSOT_ARCHETYPES=""; SSOT_CAPS_LEGAL=""; SSOT_ALIASES=""
_load_ssot() {
    declare -F _ssot_query >/dev/null || return 0
    while read -r _line || [[ -n "$_line" ]]; do
        [[ -z "$_line" || "$_line" =~ ^# ]] && continue
        if [[ "$_line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            _k="${BASH_REMATCH[1]}"
            _v="${BASH_REMATCH[2]}"
            if [[ "$_v" =~ ^\'(.*)\'$ ]] || [[ "$_v" =~ ^\"(.*)\"$ ]]; then
                _v="${BASH_REMATCH[1]}"
            fi
            declare -g "$_k=$_v"
        fi
    done < <(_ssot_query)
}

# An unvalidated archetype resolves to zero capabilities, so the blade comes up
# with its target active and its whole service plane condition-skipped -- the
# failure looks like "nothing works" with one WARN in the journal.
_require_archetype() {
    local want="$1" canon
    [[ -n "${SSOT_ARCHETYPES:-}" ]] || return 0
    canon="$(_canon_role "$want")"
    if [[ " $SSOT_ARCHETYPES " != *" $canon "* ]]; then
        die "'$want' is not a blade archetype. Legal: ${SSOT_ARCHETYPES// /, }$(
            [[ -n "${SSOT_ALIASES:-}" ]] && printf ' (aliases: %s)' "${SSOT_ALIASES// /, }")"
    fi
}

# Capabilities are a CLOSED set -- the union of [blade.archetypes]. A marker no
# ConditionPathExists ever asks for is dead weight; a typo used to create one.
_require_capability() {
    local cap="$1"
    [[ -n "${SSOT_CAPS_LEGAL:-}" ]] || return 0
    _is_legal_cap "$cap" \
        || die "'$cap' is not a blade capability. Legal: ${SSOT_CAPS_LEGAL// /, }"
}

_set_conf_key() {
    local key="$1" val="$2"
    mkdir -p "$(dirname "$ROLE_CONF")"
    if [[ -f "$ROLE_CONF" ]] && grep -q "^${key}=" "$ROLE_CONF"; then
        sed -i "s|^${key}=.*|${key}=\"${val}\"|" "$ROLE_CONF"
    else
        printf '%s="%s"\n' "$key" "$val" >> "$ROLE_CONF"
    fi
}

show_help() {
    cat <<'HELP'
Usage: mios blade <command> [args]

Commands:
  set <archetype>       Set the active blade archetype (host tier: /etc/mios/role.conf)
  add-capability <cap>  Grant one capability on top of the archetype
  list                  Show the archetypes this image declares and what each grants
  status                Show active archetype, capabilities, and systemd target
  help                  Show this help

Precedence (highest first): an explicit mios.blade= karg, /etc/mios/role.conf,
then the vendor [blade].type baked into usr/lib/bootc/kargs.d/05-mios-blade.toml.
HELP
}

[[ $# -ge 1 ]] || { show_help; exit 1; }

cmd="$1"
shift

case "$cmd" in
    set)
        [[ $# -ge 1 ]] || die "missing blade archetype (try: mios blade list)"
        _load_ssot
        _require_archetype "$1"
        _set_conf_key ROLE "$1"
        log "Set blade archetype to '$1' in $ROLE_CONF"
        if [[ -x "/usr/libexec/mios/role-apply" ]]; then
            /usr/libexec/mios/role-apply
        else
            "$(dirname "$0")/role-apply"
        fi
        systemctl daemon-reload 2>/dev/null || true
        ;;
    add-capability)
        [[ $# -ge 1 ]] || die "missing capability name (try: mios blade list)"
        _load_ssot
        _require_capability "$1"
        cap="$1"
        mkdir -p "$BLADE_D"
        touch "$BLADE_D/$cap"
        log "Added capability marker '$cap' to $BLADE_D"
        # Also record it in the host tier: role-apply wipes blade.d on every run,
        # so a marker that is not declared here does not survive a reboot.
        feats="$(_conf_get "$ROLE_CONF" FEATURES)"
        if [[ ",${feats}," != *",${cap},"* ]]; then
            _set_conf_key FEATURES "${feats:+${feats},}${cap}"
        fi
        systemctl daemon-reload 2>/dev/null || true
        ;;
    list)
        _load_ssot
        [[ -n "${SSOT_ARCHETYPES:-}" ]] || die "cannot read [blade.archetypes] from the SSOT"
        printf 'Archetypes (vendor default: %s)\n' "${SSOT_TYPE:-unset}"
        for a in $SSOT_ARCHETYPES; do
            caps="$(_caps_for "$a")"
            printf '  %-12s %s\n' "$a" "${caps:-<none> -- this is a SEAT: it starts no service}"
        done
        if [[ -n "${SSOT_ALIASES:-}" ]]; then
            printf 'Aliases\n'
            for pair in $SSOT_ALIASES; do
                printf '  %-12s -> %s\n' "${pair%%=*}" "${pair#*=}"
            done
        fi
        printf 'Capabilities\n  %s\n' "${SSOT_CAPS_LEGAL:-<none>}"
        ;;
    status)
        if [[ -f "$BLADE_ENV" ]]; then
            # shellcheck source=/dev/null
            source "$BLADE_ENV"
            echo "Blade Type:   ${MIOS_BLADE_TYPE:-unknown}"
            echo "Capabilities: ${MIOS_BLADE_CAPS//,/ }"
        elif [[ -f /var/lib/mios/role.active ]]; then
            # shellcheck source=/dev/null
            source /var/lib/mios/role.active
            echo "Blade Type:   ${ROLE:-unknown}"
            echo "Capabilities: ${FEATURES:-}"
        else
            echo "Blade state not active or initialized"
        fi

        echo "Active Capability Markers:"
        if [[ -d "$BLADE_D" ]] && compgen -G "$BLADE_D/*" >/dev/null; then
            for f in "$BLADE_D"/*; do
                [[ -f "$f" ]] && echo "  - $(basename "$f")"
            done
        else
            echo "  (none -- this blade activates nothing capability-gated)"
        fi

        if command -v systemctl >/dev/null 2>&1; then
            echo "Systemd Default Target: $(systemctl get-default 2>/dev/null || echo unknown)"
        fi

        # Where this blade's services actually live, and whether they answer.
        # On a seat every target is REMOTE, so this is the one question a seat
        # operator has: is my blade there? Without it an unreachable blade looks
        # like a broken model -- the lane resolver hands back its terminal lane
        # even when the probe fails, by design, so the turn degrades rather than
        # dead-ends and the transport error is all you see.
        echo "Offload targets:"
        _any=0
        while IFS="$(printf '\t')" read -r _label _url; do
            [ -n "${_url:-}" ] || continue
            _any=1
            if _url_is_local "$_url"; then _where="local"; else _where="REMOTE"; fi
            case "$_url" in
                *'${'*) printf '  %-22s %-7s %s  (UNRESOLVED)\n' "$_label" "$_where" "$_url"; continue ;;
            esac
            if command -v curl >/dev/null 2>&1 &&
               curl -sS -o /dev/null --max-time "${MIOS_BLADE_PROBE_TIMEOUT:-2}" "$_url" 2>/dev/null; then
                _state="up"
            else
                _state="UNREACHABLE"
            fi
            printf '  %-22s %-7s %-12s %s\n' "$_label" "$_where" "$_state" "$_url"
        done <<EOF
$(_ssot_offload_targets)
EOF
        [ "$_any" = 1 ] || echo "  (none resolved -- the SSOT could not be read)"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        printf '[mios-blade] ERROR: unknown command %s\n' "'$cmd'" >&2
        show_help
        exit 1
        ;;
esac
