# AI-hint: Atomic composefs image descriptor validator and fs-verity digest verifier (task_471, task_2704).
# AI-doc: usr/share/doc/mios/manual/ch71-composefs-sealing.md
"""
MiOS Composefs Atomic Descriptor Validator and fs-verity Digest Verifier.
Validates composefs (.cfs) images, parses descriptor headers, verifies
fs-verity / sha256 digests, and detects corruption or tampering.
"""

from __future__ import annotations

import argparse
import errno
import hashlib
import math
import os
import shutil
import struct
import subprocess
import sys
from typing import Any, Dict, List, Optional, Tuple

# Known Composefs Magic Numbers:
# 0xd078629a: Standard libcomposefs CFS_MAGIC (little-endian: 9a 62 78 d0)
# 0x00736663: 'cfs\0' (little-endian: 63 66 73 00)
# 0x00534643: 'CFS\0' (little-endian: 43 46 53 00)
# 0x66706d63: 'cmpf'
# 0x636d7066: 'fpmc'
KNOWN_MAGICS: Dict[int, str] = {
    0xd078629a: "CFS_MAGIC (libcomposefs)",
    0x00736663: "cfs\\0",
    0x00534643: "CFS\\0",
    0x66706d63: "cmpf",
    0x636d7066: "fpmc",
}

EXIT_SUCCESS = 0
EXIT_ERROR = 1
EXIT_EIO = errno.EIO  # 5 (EIO: Input/output error / invalid descriptor)


def compute_fsverity_digest(data: bytes) -> str:
    """
    Computes Linux kernel fs-verity root digest using SHA-256 Merkle tree (4096-byte blocks).
    Matches composefs-info measure-file and Linux kernel FS_IOC_MEASURE_VERITY.
    """
    block_size = 4096
    hash_fn = hashlib.sha256
    hash_size = 32

    num_blocks = math.ceil(len(data) / block_size) if len(data) > 0 else 0
    hashes: List[bytes] = []
    for i in range(num_blocks):
        block = data[i * block_size : (i + 1) * block_size]
        if len(block) < block_size:
            block = block.ljust(block_size, b"\x00")
        hashes.append(hash_fn(block).digest())

    if not hashes:
        root_hash = bytes(hash_size)
    elif len(hashes) == 1:
        root_hash = hashes[0]
    else:
        hashes_per_block = block_size // hash_size
        curr = hashes
        while len(curr) > 1:
            next_level: List[bytes] = []
            num_parent_blocks = math.ceil(len(curr) / hashes_per_block)
            for b in range(num_parent_blocks):
                chunk = b"".join(curr[b * hashes_per_block : (b + 1) * hashes_per_block])
                if len(chunk) < block_size:
                    chunk = chunk.ljust(block_size, b"\x00")
                next_level.append(hash_fn(chunk).digest())
            curr = next_level
        root_hash = curr[0]

    # Linux kernel fsverity_descriptor struct (256 bytes total):
    # u8 version (1)
    # u8 hash_algorithm (1 = SHA-256)
    # u8 log_blocksize (12 = 4096)
    # u8 salt_size (0)
    # u32 sig_size (0)
    # u64 data_size (len(data))
    # u8 root_hash[64]
    # u8 salt[32]
    # u8 reserved[144]
    desc = struct.pack("<BBBBIQ", 1, 1, 12, 0, 0, len(data))
    desc += root_hash.ljust(64, b"\x00")
    desc += bytes(32)
    desc += bytes(144)
    return hash_fn(desc).hexdigest()


def compute_sha256_digest(data: bytes) -> str:
    """Computes SHA-256 digest of the descriptor byte stream."""
    return hashlib.sha256(data).hexdigest()


class ComposefsValidator:
    """Validates and inspects Composefs (.cfs) image files."""

    def __init__(self, verbose: bool = False) -> None:
        self.verbose = verbose
        self.composefs_info_bin = shutil.which("composefs-info")

    def _log(self, msg: str) -> None:
        if self.verbose:
            print(f"[composefs-validator] {msg}", file=sys.stderr)

    def parse_header(self, data: bytes) -> Tuple[bool, Optional[int], str, int, int]:
        """
        Parses and validates the binary header of a composefs image.
        Returns: (is_valid, magic, magic_desc, vmaj, vmin)
        """
        if len(data) < 64:
            return False, None, "Truncated header (<64 bytes)", 0, 0

        magic = struct.unpack("<I", data[:4])[0]
        raw_magic = data[:4]

        # Check magic matches
        if magic in KNOWN_MAGICS:
            magic_desc = KNOWN_MAGICS[magic]
        elif raw_magic in (b"cfs\x00", b"CFS\x00", b"\x9a\x62\x78\xd0", b"cmpf"):
            magic_desc = f"Raw bytes {raw_magic!r}"
        else:
            return False, magic, f"Unknown magic: 0x{magic:08x} ({raw_magic!r})", 0, 0

        vmaj = data[4]
        vmin = data[5]
        if vmaj > 20:
            return False, magic, f"Invalid format version {vmaj}.{vmin}", vmaj, vmin

        return True, magic, magic_desc, vmaj, vmin

    def check_descriptor_integrity(self, file_path: str, data: bytes, magic: Optional[int]) -> Tuple[bool, str]:
        """
        Validates internal descriptor integrity, inode table structure, and bounds.
        Delegates to composefs-info if available or uses internal binary validation.
        """
        # If composefs-info is available and magic is libcomposefs CFS_MAGIC (0xd078629a), delegate dump inspection
        if self.composefs_info_bin and magic == 0xd078629a:
            try:
                proc = subprocess.run(
                    [self.composefs_info_bin, "dump", file_path],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=15,
                )
                if proc.returncode != 0:
                    err_msg = proc.stderr.decode("utf-8", errors="replace").strip()
                    return False, f"composefs-info dump rejected image (EIO): {err_msg}"
            except Exception as exc:
                return False, f"composefs-info dump failed: {exc}"

        # Internal pure-Python structural check:
        # Check alignment / minimum block bounds
        if len(data) < 64:
            return False, "Descriptor truncated (< 64 bytes)"

        # Check for corrupted payload or invalid table bounds in header
        try:
            # Check trailer / table references
            # Minimum sanity: file must have at least 1 non-zero byte beyond offset 4
            if not any(data[4:min(len(data), 512)]):
                return False, "Null / zeroed descriptor structure"
        except Exception as exc:
            return False, f"Descriptor structure parse error: {exc}"

        return True, "Integrity verified"

    def verify(self, file_path: str, expected_digest: Optional[str] = None) -> int:
        """
        Verifies composefs descriptor integrity and optional digest.
        Exits with 0 on success, or non-zero / EXIT_EIO on tampering or failure.
        """
        if not os.path.exists(file_path):
            print(f"[-] ERROR: File not found: {file_path}", file=sys.stderr)
            return EXIT_ERROR

        try:
            with open(file_path, "rb") as f:
                data = f.read()
        except Exception as exc:
            print(f"[-] ERROR: Failed to read {file_path}: {exc}", file=sys.stderr)
            return EXIT_EIO

        # 1. Truncation check (< 64 bytes)
        if len(data) < 64:
            print(
                f"[-] ERROR: Corrupted descriptor '{file_path}': truncated ({len(data)} bytes, min 64 required) (EIO)",
                file=sys.stderr,
            )
            return EXIT_EIO

        # 2. Magic header check
        is_valid_hdr, magic, magic_desc, vmaj, vmin = self.parse_header(data)
        if not is_valid_hdr:
            print(
                f"[-] ERROR: Invalid magic header in '{file_path}': {magic_desc} (EIO)",
                file=sys.stderr,
            )
            return EXIT_EIO

        self._log(f"Header valid: magic=0x{magic:08x} ({magic_desc}), version={vmaj}.{vmin}")

        # 3. Descriptor integrity & inode table validation
        ok_integrity, integrity_msg = self.check_descriptor_integrity(file_path, data, magic)
        if not ok_integrity:
            print(
                f"[-] ERROR: Composefs descriptor integrity check failed for '{file_path}': {integrity_msg} (EIO)",
                file=sys.stderr,
            )
            return EXIT_EIO

        self._log(f"Descriptor integrity check passed: {integrity_msg}")

        # 4. Compute digests
        fsverity_digest = compute_fsverity_digest(data)
        sha256_digest = compute_sha256_digest(data)

        self._log(f"Computed fs-verity digest: {fsverity_digest}")
        self._log(f"Computed sha256 digest:    {sha256_digest}")

        # 5. Digest comparison if requested
        if expected_digest:
            exp_clean = expected_digest.strip().lower()
            if exp_clean.startswith("sha256:"):
                exp_clean = exp_clean[7:]

            if exp_clean != fsverity_digest.lower() and exp_clean != sha256_digest.lower():
                print(
                    f"[-] ERROR: Composefs descriptor digest mismatch in '{file_path}' (EIO):\n"
                    f"    Expected:   {expected_digest}\n"
                    f"    fs-verity:  {fsverity_digest}\n"
                    f"    sha256:     {sha256_digest}",
                    file=sys.stderr,
                )
                return EXIT_EIO

            self._log("Digest match confirmed")

        print(
            f"[+] OK: Composefs descriptor '{file_path}' verified successfully "
            f"(magic: 0x{magic:08x}, fs-verity: {fsverity_digest})"
        )
        return EXIT_SUCCESS

    def inspect(self, file_path: str) -> int:
        """
        Inspects composefs descriptor metadata and content.
        Uses composefs-info if available or internal binary parser.
        """
        if not os.path.exists(file_path):
            print(f"[-] ERROR: File not found: {file_path}", file=sys.stderr)
            return EXIT_ERROR

        try:
            with open(file_path, "rb") as f:
                data = f.read()
        except Exception as exc:
            print(f"[-] ERROR: Failed to read {file_path}: {exc}", file=sys.stderr)
            return EXIT_EIO

        if len(data) < 64:
            print(f"[-] ERROR: Image file too small ({len(data)} bytes)", file=sys.stderr)
            return EXIT_EIO

        is_valid_hdr, magic, magic_desc, vmaj, vmin = self.parse_header(data)
        fsverity_digest = compute_fsverity_digest(data)
        sha256_digest = compute_sha256_digest(data)

        print(f"=== Composefs Descriptor Inspection: {file_path} ===")
        print(f"File Size:        {len(data)} bytes ({len(data) / 1024:.2f} KiB)")
        print(f"Header Valid:     {is_valid_hdr}")
        print(f"Magic:            0x{magic:08x} ({magic_desc})")
        print(f"Version:          {vmaj}.{vmin}")
        print(f"fs-verity Digest: {fsverity_digest}")
        print(f"SHA-256 Digest:   {sha256_digest}")

        # If composefs-info is available and magic is libcomposefs CFS_MAGIC (0xd078629a), delegate dump & objects
        if self.composefs_info_bin and is_valid_hdr and magic == 0xd078629a:
            print("\n--- Inode Table Dump (composefs-info dump) ---")
            try:
                dump_res = subprocess.run(
                    [self.composefs_info_bin, "dump", file_path],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=15,
                )
                if dump_res.returncode == 0:
                    lines = dump_res.stdout.decode("utf-8", errors="replace").splitlines()
                    if len(lines) > 20 and not self.verbose:
                        for line in lines[:15]:
                            print(f"  {line}")
                        print(f"  ... ({len(lines) - 15} additional entries omitted; use -v to see all)")
                    else:
                        for line in lines:
                            print(f"  {line}")
                else:
                    print(f"  [dump error] {dump_res.stderr.decode().strip()}")
            except Exception as exc:
                print(f"  [dump execution failed] {exc}")

            print("\n--- Referenced Objects (composefs-info objects) ---")
            try:
                obj_res = subprocess.run(
                    [self.composefs_info_bin, "objects", file_path],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=15,
                )
                if obj_res.returncode == 0:
                    objs = obj_res.stdout.decode("utf-8", errors="replace").strip().splitlines()
                    if not objs:
                        print("  (no external content objects referenced; self-contained or inline payload)")
                    else:
                        for obj in objs[:15]:
                            print(f"  {obj}")
                        if len(objs) > 15:
                            print(f"  ... ({len(objs) - 15} more objects)")
                else:
                    print(f"  [objects error] {obj_res.stderr.decode().strip()}")
            except Exception as exc:
                print(f"  [objects execution failed] {exc}")
        else:
            print("\n(internal binary parser inspection complete)")

        return EXIT_SUCCESS if is_valid_hdr else EXIT_EIO


def build_parser() -> argparse.ArgumentParser:
    """Constructs command-line argument parser."""
    parser = argparse.ArgumentParser(
        prog="mios-composefs-validator",
        description="MiOS Atomic Composefs Image Descriptor Validator & fs-verity Digest Verifier (task_471, task_2704)",
    )
    parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose diagnostic output")

    subparsers = parser.add_subparsers(dest="command", help="Validation command")

    # verify
    verify_p = subparsers.add_parser("verify", help="Verify composefs image descriptor integrity and optional digest")
    verify_p.add_argument("file", help="Path to composefs image file (.cfs)")
    verify_p.add_argument("--digest", help="Expected fs-verity or sha256 descriptor digest")
    verify_p.add_argument("-v", "--verbose", action="store_true", help="Enable verbose output")

    # inspect
    inspect_p = subparsers.add_parser("inspect", help="Inspect composefs image descriptor metadata and objects")
    inspect_p.add_argument("file", help="Path to composefs image file (.cfs)")
    inspect_p.add_argument("-v", "--verbose", action="store_true", help="Enable verbose output")

    return parser


def parse_argv(argv: List[str]) -> Tuple[argparse.ArgumentParser, argparse.Namespace]:
    """Parses argv supporting both subcommand style and direct file invocation."""
    parser = build_parser()
    raw = list(argv[1:])

    # If --help or -h present, let argparse handle it directly
    if "-h" in raw or "--help" in raw:
        return parser, parser.parse_args(raw)

    # If neither 'verify' nor 'inspect' in raw args, default to 'verify'
    if not any(cmd in raw for cmd in ("verify", "inspect")):
        # Find first non-flag argument to insert 'verify' before it
        for idx, arg in enumerate(raw):
            if not arg.startswith("-"):
                raw.insert(idx, "verify")
                break
        else:
            raw.insert(0, "verify")

    return parser, parser.parse_args(raw)


def main() -> int:
    parser, args = parse_argv(sys.argv)
    verbose = getattr(args, "verbose", False)
    validator = ComposefsValidator(verbose=verbose)

    if args.command == "inspect":
        return validator.inspect(args.file)
    elif args.command == "verify":
        return validator.verify(args.file, expected_digest=getattr(args, "digest", None))
    else:
        parser.print_help()
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
