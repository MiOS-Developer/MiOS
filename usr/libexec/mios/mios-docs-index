#!/bin/bash
# AI-hint: Generates a unified index of all system documentation (.md files) across MiOS directories to allow agents to discover and selectively load specific documentation into context via grep or direct path access.
# AI-related: /usr/libexec/mios/mios-docs-index, /usr/share/mios/ai/, /usr/share/mios/docs/, /usr/share/mios/hermes/skills/, /usr/share/mios/cookbooks/, /usr/share/mios/prompts/, /etc/mios/system-prompts/, /usr/share/mios/ai, /usr/share/mios/docs, /usr/share/mios/hermes/skills
# AI-functions: _describe, emit_index

set -uo pipefail

PATTERN=""
WRITE=0
INDEX_OUT="/var/lib/mios/scratch/docs-index.md"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --grep)  PATTERN="$2"; shift 2 ;;
        --write) WRITE=1; shift ;;
        -h|--help)
            sed -n '2,40p' "$0" | sed 's/^# \?//'
            exit 0 ;;
        *) echo "Mios-docs-index: unknown arg: $1" >&2; exit 64 ;;
    esac
done

SCAN_ROOTS=(
    "/usr/share/mios/ai"
    "/usr/share/mios/docs"
    "/usr/share/mios/hermes/skills"
    "/usr/share/mios/cookbooks"
    "/usr/share/mios/prompts"
    "/etc/mios/system-prompts"
    "/var/lib/mios/scratch"
    "/var/lib/mios/ai/scratch"
    "/var/lib/mios/compacted"
)

_describe() {
    local f="$1" line=""
    line="$(awk '
        BEGIN { in_fm=0; n=0 }
        NR==1 && /^---[[:space:]]*$/ { in_fm=1; next }
        in_fm && /^---[[:space:]]*$/ { exit }
        in_fm && /^description:/ {
            sub(/^description:[[:space:]]*/, "")
            sub(/^["\x27]/, ""); sub(/["\x27][[:space:]]*$/, "")
            if (length($0) > 0) { print; exit }
            next
        }
    ' "$f" 2>/dev/null | head -1)"
    if [ -n "$line" ]; then echo "${line:0:180}"; return; fi
    line="$(grep -m1 '^# ' "$f" 2>/dev/null | sed 's/^#\s*//')"
    if [ -n "$line" ]; then echo "${line:0:180}"; return; fi
    line="$(awk '
        BEGIN { in_fm=0 }
        NR==1 && /^---[[:space:]]*$/ { in_fm=1; next }
        in_fm && /^---[[:space:]]*$/ { in_fm=0; next }
        in_fm { next }
        /^[[:space:]]*$/ { next }
        /^[[:space:]]*<!--/ { next }
        { print; exit }
    ' "$f" 2>/dev/null)"
    echo "${line:0:180}"
}

emit_index() {
    echo "# MiOS unified doc index"
    echo "_auto-generated by mios-docs-index_"
    echo
    echo "Format: \`<path>"
    echo
    for root in "${SCAN_ROOTS[@]}"; do
        [ -d "$root" ] || continue
        echo "## $root"
        echo
        while IFS= read -r f; do
            desc="$(_describe "$f")"
            printf '%s  --  %s\n' "$f" "$desc"
        done < <(find "$root" -type f -name '*.md' 2>/dev/null | sort)
        echo
    done
}

if [ "$WRITE" = "1" ]; then
    install -d -m 0755 "$(dirname "$INDEX_OUT")"
    emit_index > "${INDEX_OUT}.tmp"
    mv -f "${INDEX_OUT}.tmp" "$INDEX_OUT"
    chmod 0644 "$INDEX_OUT"
    echo "[mios-docs-index] wrote $INDEX_OUT ($(wc -l < "$INDEX_OUT") lines)"
fi

if [ -n "$PATTERN" ]; then
    emit_index | grep -E "$PATTERN" 2>/dev/null
else
    emit_index
fi
