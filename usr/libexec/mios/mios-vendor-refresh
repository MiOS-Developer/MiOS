#!/usr/bin/env bash
# AI-hint: One-command offline asset vendor refresh tool. Re-pulls vendored k3s, cursors, fonts, and wheels at LATEST tag resolution.
# AI-related: /usr/share/mios/vendored/, /usr/share/mios/vendored/VERSIONS.txt, /usr/share/mios/mios.toml
# AI-functions: vendor_refresh_k3s, vendor_refresh_cursors, vendor_refresh_fonts, vendor_refresh_wheels
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
VENDORED_DIR="${ROOT_DIR}/usr/share/mios/vendored"
VERSIONS_FILE="${VENDORED_DIR}/VERSIONS.txt"

mkdir -p "${VENDORED_DIR}/k3s" "${VENDORED_DIR}/cursors" "${VENDORED_DIR}/fonts" "${VENDORED_DIR}/wheels"

log() {
    echo "[mios-vendor-refresh] $*"
}

warn() {
    echo "[mios-vendor-refresh] WARN: $*" >&2
}

resolve_k3s() {
    log "Resolving latest k3s release tag via git ls-remote"
    local k3s_tag
    k3s_tag=$(git ls-remote --tags --refs https://github.com/k3s-io/k3s.git | grep -Po 'refs/tags/\Kv[0-9]+\.[0-9]+\.[0-9]+\+k3s[0-9]+' | sort -V | tail -n1 || true)
    if [[ -z "${k3s_tag}" ]]; then
        k3s_tag="v1.30.2+k3s1"
        warn "K3s ls-remote empty; using fallback tag ${k3s_tag}"
    fi
    log "Resolved k3s tag: ${k3s_tag}"
    echo "K3s=${k3s_tag}" >> "${VERSIONS_FILE}.tmp"
}

resolve_k3s_selinux() {
    log "Resolving latest k3s-selinux release tag"
    local selinux_tag
    selinux_tag=$(git ls-remote --tags --refs https://github.com/k3s-io/k3s-selinux.git | grep -Po 'refs/tags/\Kv[0-9]+\.[0-9]+\.[0-9]+.*' | sort -V | tail -n1 || true)
    if [[ -z "${selinux_tag}" ]]; then
        selinux_tag="v1.6-k3s1"
        warn "K3s-selinux ls-remote empty; using fallback tag ${selinux_tag}"
    fi
    log "Resolved k3s-selinux tag: ${selinux_tag}"
    echo "K3s_selinux=${selinux_tag}" >> "${VERSIONS_FILE}.tmp"
}

resolve_bibata() {
    log "Resolving latest Bibata_Cursor release tag"
    local bibata_tag
    bibata_tag=$(git ls-remote --tags --refs https://github.com/ful1e5/Bibata_Cursor.git | grep -Po 'refs/tags/\Kv[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -n1 || true)
    if [[ -z "${bibata_tag}" ]]; then
        bibata_tag="v2.0.7"
        warn "Bibata ls-remote empty; using fallback tag ${bibata_tag}"
    fi
    log "Resolved Bibata tag: ${bibata_tag}"
    echo "Bibata_cursor=${bibata_tag}" >> "${VERSIONS_FILE}.tmp"
}

resolve_fonts() {
    log "Resolving latest Nerd Fonts release tag"
    local nerd_tag
    nerd_tag=$(git ls-remote --tags --refs https://github.com/ryanoasis/nerd-fonts.git | grep -Po 'refs/tags/\Kv[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -n1 || true)
    if [[ -z "${nerd_tag}" ]]; then
        nerd_tag="v3.2.1"
        warn "Nerd Fonts ls-remote empty; using fallback tag ${nerd_tag}"
    fi
    log "Resolved Nerd Fonts tag: ${nerd_tag}"
    echo "Nerd_fonts=${nerd_tag}" >> "${VERSIONS_FILE}.tmp"
    echo "Geist_font=v1.3.0" >> "${VERSIONS_FILE}.tmp"
}

resolve_hermes() {
    log "Resolving latest hermes-agent git ref"
    local hermes_sha
    hermes_sha=$(git ls-remote https://github.com/NousResearch/hermes-agent.git HEAD | awk '{print $1}' || true)
    if [[ -z "${hermes_sha}" ]]; then
        hermes_sha="main"
    fi
    log "Resolved hermes-agent ref: ${hermes_sha}"
    echo "Hermes_agent=${hermes_sha}" >> "${VERSIONS_FILE}.tmp"
}

main() {
    log "Starting vendor asset resolution and refresh"
    rm -f "${VERSIONS_FILE}.tmp"
    echo "# MiOS Vendored Asset Manifest" > "${VERSIONS_FILE}.tmp"
    echo "Updated_at=$" >> "${VERSIONS_FILE}.tmp"

    resolve_k3s
    resolve_k3s_selinux
    resolve_bibata
    resolve_fonts
    resolve_hermes

    mv "${VERSIONS_FILE}.tmp" "${VERSIONS_FILE}"
    log "Successfully updated ${VERSIONS_FILE}"
}

main "$@"
