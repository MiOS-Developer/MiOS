#!/usr/bin/env bash
# AI-hint: Resolves the DB-driven LOGIN account the dashboards advertise -- the globally-controlled account SSOT (pgvector), NOT the operator DISPLAY name ([user].name). Shared by the Linux dashboard and the Windows dashboard (via wsl) so the two never drift. Interim consumer ahead of the full WS-ACCT control plane (task_151..task_154).
# AI-related: /usr/libexec/mios/mios-dashboard.sh, powershell/profile.ps1, mios-pg-query, account (pgvector table)
# AI-functions: _db_name, main
set -uo pipefail

PGQ=/usr/libexec/mios/mios-pg-query

_db_name() {
    [ -r "$PGQ" ] || return 0
    local n
    n="$(python3 "$PGQ" -At "SELECT username FROM person WHERE username IS NOT NULL AND btrim(username) <> '' ORDER BY id LIMIT 1" 2>/dev/null | head -1)"
    if [ -z "$n" ]; then
        n="$(python3 "$PGQ" -At "SELECT name FROM account WHERE kind = 'user' AND name NOT LIKE 'mios-cli-%' ORDER BY id LIMIT 1" 2>/dev/null | head -1)"
    fi
    printf '%s' "$n"
}

name="$(_db_name)"
if [ -z "$name" ]; then
    name="$(getent passwd 2>/dev/null | awk -F: '$3>=1000 && $3<65000 && $7 ~ /(bash|zsh|fish)$/ {print $3":"$1}' | sort -n | head -1 | cut -d: -f2)"
fi
if [ -z "$name" ]; then
    # Layered SSOT [identity].username -- never a literal account name.
    _tg="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/mios-toml-get"
    [ -x "$_tg" ] || _tg=/usr/libexec/mios/mios-toml-get
    name="$("$_tg" identity username '' 2>/dev/null)"
fi
if [ -z "$name" ]; then
    echo "mios-login-account: no login account in the DB, /etc/passwd or SSOT [identity].username" >&2
    exit 3
fi

if [ "${1:-}" = "password" ]; then
    # The password is the layered-SSOT credential ([identity].default_password); it is never
    # advertised (the old behaviour printed the account NAME, matching a retired user/user seed).
    exit 0
fi
printf '%s' "$name"
