+fn check_user_authorized(username: &str) -> bool {
+    let Ok(c_user) = std::ffi::CString::new(username) else {
+        return false;
+    };
+    // SAFETY: getpwnam lookup for user
+    let pwd = unsafe { libc::getpwnam(c_user.as_ptr()) };
+    if pwd.is_null() {
+        return false;
+    }
+    let (uid, gid) = unsafe { ((*pwd).pw_uid, (*pwd).pw_gid) };
+    if uid < 1000 {
+        return false;
+    }
+    let Ok(c_group) = std::ffi::CString::new("mios-rdp") else {
+        return false;
+    };
+    // SAFETY: getgrnam lookup for mios-rdp group
+    let grp = unsafe { libc::getgrnam(c_group.as_ptr()) };
+    if grp.is_null() {
+        return true;
+    }
+    let target_gid = unsafe { (*grp).gr_gid };
+    if gid == target_gid {
+        return true;
+    }
+    let mut gr_mem = unsafe { (*grp).gr_mem };
+    if !gr_mem.is_null() {
+        unsafe {
+            while !(*gr_mem).is_null() {
+                let member = std::ffi::CStr::from_ptr(*gr_mem);
+                if member.to_bytes() == username.as_bytes() {
+                    return true;
+                }
+                gr_mem = gr_mem.add(1);
+            }
+        }
+    }
+    false
+}
