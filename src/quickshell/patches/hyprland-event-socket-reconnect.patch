+void HyprlandIpc::scheduleEventReconnect() {
+	// 50 ms, doubling to 2 s; keeps trying while the compositor's socket exists (gone = the compositor exited)
+	auto delay = std::min(50 << std::min(this->eventReconnectAttempts, 6), 2000);
+	this->eventReconnectAttempts++;
+	QTimer::singleShot(delay, this, [this]() {
+		if (this->eventSocket.state() != QLocalSocket::UnconnectedState) return;
+		if (!QFileInfo::exists(this->mEventSocketPath)) {
+			qCWarning(logHyprlandIpc) << "Hyprland event socket" << this->mEventSocketPath << "is gone; not reconnecting.";
+			this->eventReconnecting = false;
+			return;
+		}
+		this->eventSocket.connectToServer(this->mEventSocketPath, QLocalSocket::ReadOnly);
+	});
+}
