+#[cfg(test)]
+mod tests {
+  use tui::{backend::TestBackend, Terminal};
+
+  use super::draw;
+  use crate::{ui::common::masked::MaskedString, Greeter, Mode};
+
+  #[test]
+  fn selected_account_renders_raw_login_in_every_prompt_mode() {
+    for mode in [Mode::Username, Mode::Password, Mode::Action] {
+      let mut greeter = Greeter::default();
+      greeter.config = Greeter::options().parse(&["--width", "60"]).ok();
+      greeter.user_menu = true;
+      greeter.username = MaskedString::from("mios".to_string(), Some("MiOS".to_string()));
+      greeter.mode = mode;
+      greeter.prompt = Some("Password:".to_string());
+      greeter.asking_for_secret = true;
+      let mut terminal = Terminal::new(TestBackend::new(80, 24)).unwrap();
+      terminal.draw(|frame| { draw(&mut greeter, frame).unwrap(); }).unwrap();
+
+      // Read the actual rendered username row, rather than a display helper.
+      let buffer = terminal.backend().buffer();
+      let rows: Vec<String> = (0..24)
+        .map(|y| (0..80).map(|x| buffer.get(x, y).symbol()).collect())
+        .collect();
+      let label = fl!("username");
+      let row = rows.iter().find(|row| row.contains(&label)).unwrap();
+      let (_, value) = row.split_once(&label).unwrap();
+      assert_eq!(value.trim_start().split_whitespace().next(), Some("mios"), "mode {mode:?}");
+      assert!(!value.contains("MiOS"), "pretty name leaked into username field in {mode:?}");
+      assert_eq!(greeter.username.mask.as_deref(), Some("MiOS"));
+    }
+  }
+}
