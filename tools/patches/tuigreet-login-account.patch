+  // Account display metadata must never obscure the actual login identity.
+  pub fn display(&self) -> Cow<'_, str> {
+    match self.mask.as_deref() {
+      Some(name) if !name.is_empty() && name != self.value => Cow::Owned(format!("{} ({})", self.get(), self.value)),
+      _ => Cow::Borrowed(&self.value),
