--- a/server-client.c
+++ b/server-client.c
@@ -50,6 +50,236 @@ static int	server_client_dispatch_identify(struct client *, struct imsg *);
 static int	server_client_dispatch_shell(struct client *);
 static void	server_client_report_theme(struct client *, enum client_theme);
 
+static uint64_t server_client_instance;
+static uint64_t server_pointer_generation;
+static void server_client_pointer_cancel(struct client *, int);
+
+/* A control client's mouse is a lease on one witnessed terminal client. */
+static struct client *
+server_client_pointer_find(uint64_t generation)
+{
+	struct client *c;
+	TAILQ_FOREACH(c, &clients, entry) {
+		if (c->pointer_owner != NULL && c->pointer_generation == generation)
+			return (c);
+	}
+	return (NULL);
+}
+
+int
+server_client_pointer_valid(struct mouse_event *m)
+{
+	return (m->pointer_generation == 0 ||
+	    server_client_pointer_find(m->pointer_generation) != NULL);
+}
+
+void
+server_client_pointer_delivered(struct window_pane *wp, struct mouse_event *m,
+    u_int x, u_int y)
+{
+	struct client *c;
+	struct pointer_press *p;
+	u_int button;
+	if (m->pointer_generation == 0 ||
+	    (c = server_client_pointer_find(m->pointer_generation)) == NULL)
+		return;
+	button = MOUSE_BUTTONS(m->sgr_b);
+	if (button >= 3)
+		return;
+	p = &c->pointer_presses[button];
+	if (m->sgr_type == 'm')
+		p->pane = -1;
+	else if (!MOUSE_DRAG(m->b) || p->pane == (int)wp->id) {
+		p->pane = wp->id; p->pid = wp->pid;
+		p->x = x; p->y = y;
+	}
+}
+
+static void
+server_client_pointer_cancel(struct client *c, int end)
+{
+	struct window_pane *wp;
+	struct mouse_event m;
+	struct pointer_press *p;
+	const char *buf;
+	size_t len;
+	u_int i;
+	if (c->pointer_owner == NULL)
+		return;
+	/* Release only presses actually encoded to a still-identical app PTY. */
+	for (i = 0; i < 3; i++) {
+		p = &c->pointer_presses[i];
+		wp = p->pane < 0 ? NULL : window_pane_find_by_id(p->pane);
+		if (wp != NULL && wp->pid == p->pid && wp->event != NULL) {
+			memset(&m, 0, sizeof m);
+			m.b = 3; m.sgr_b = i; m.sgr_type = 'm';
+			if (input_key_get_mouse(wp->screen, &m,
+			    p->x, p->y, &buf, &len))
+				bufferevent_write(wp->event, buf, len);
+		}
+		p->pane = -1;
+	}
+	popup_pointer_cancel(c, c->pointer_generation);
+	/* No MouseUp binding: disconnect must never activate a title/dock. */
+	if (c->pointer_drag_generation == c->pointer_generation) {
+		window_copy_cancel_pointer_drag(c, c->pointer_generation);
+		c->tty.mouse_drag_update = NULL;
+		c->tty.mouse_drag_release = NULL;
+		c->tty.mouse_drag_flag = c->tty.mouse_scrolling_flag = 0;
+		c->tty.mouse_slider_mpos = c->tty.mouse_last_pane = -1;
+		c->pointer_drag_generation = 0;
+	}
+	c->tty.mouse_last_b = 3;
+	evtimer_del(&c->click_timer);
+	c->flags &= ~(CLIENT_DOUBLECLICK|CLIENT_TRIPLECLICK);
+	c->pointer_buttons = 0;
+	c->pointer_visible = 0;
+	c->pointer_motion = NULL;
+	/* Invalidate copies held by queues and asynchronous mouse bindings. */
+	if (++server_pointer_generation == 0)
+		fatalx("pointer generation exhausted");
+	c->pointer_generation = server_pointer_generation;
+	c->pointer_last_b = 3;
+	if (end)
+		c->pointer_owner = NULL;
+}
+
+static void
+server_client_pointer_clamp(struct client *c)
+{
+	if (c->pointer_x >= c->tty.sx) c->pointer_x = c->tty.sx - 1;
+	if (c->pointer_y >= c->tty.sy) c->pointer_y = c->tty.sy - 1;
+	if (c->pointer_last_x >= c->tty.sx) c->pointer_last_x = c->tty.sx - 1;
+	if (c->pointer_last_y >= c->tty.sy) c->pointer_last_y = c->tty.sy - 1;
+}
+
+static void
+server_client_pointer_event(struct client *c, u_int b, u_int sgr, int up,
+    int motion)
+{
+	struct key_event *event;
+	struct mouse_event *m;
+	if (motion && c->pointer_motion != NULL) {
+		c->pointer_motion->m.x = c->pointer_x;
+		c->pointer_motion->m.y = c->pointer_y;
+		c->pointer_last_x = c->pointer_x;
+		c->pointer_last_y = c->pointer_y;
+		return;
+	}
+	event = xcalloc(1, sizeof *event);
+	event->key = KEYC_MOUSE;
+	event->pointer_queued = 1;
+	m = &event->m;
+	m->pointer_generation = c->pointer_generation;
+	m->x = c->pointer_x; m->y = c->pointer_y;
+	m->lx = c->pointer_last_x; m->ly = c->pointer_last_y;
+	m->lb = c->pointer_last_b; m->b = b;
+	m->sgr_b = sgr; m->sgr_type = up ? 'm' : 'M';
+	c->pointer_last_x = m->x; c->pointer_last_y = m->y;
+	c->pointer_last_b = b;
+	if (motion)
+		c->pointer_motion = event;
+	else
+		c->pointer_motion = NULL;
+	c->pointer_pending++;
+	if (!server_client_handle_key(c, event)) {
+		c->pointer_pending--;
+		if (c->pointer_motion == event)
+			c->pointer_motion = NULL;
+		free(event);
+	}
+}
+
+int
+server_client_pointer(struct client *owner, struct client *c,
+    const char *action, int relative, int x, int y, int button,
+    struct cmdq_item *item)
+{
+	long long px, py;
+	u_int i, b = 3, count = 1;
+	int move = strcmp(action, "move") == 0;
+	int wheel = strcmp(action, "wheel") == 0;
+	if (strcmp(action, "begin") == 0) {
+		if (c->pointer_owner != NULL && c->pointer_owner != owner)
+			goto busy;
+		if (c->pointer_owner == NULL) {
+			if (c->pointer_physical_buttons != 0 || c->tty.mouse_drag_flag)
+				goto busy;
+			if (++server_pointer_generation == 0)
+				fatalx("pointer generation exhausted");
+			c->pointer_generation = server_pointer_generation;
+			c->pointer_owner = owner;
+			c->pointer_visible = 0;
+			c->pointer_x = c->tty.sx / 2;
+			c->pointer_y = c->tty.sy / 2;
+			c->pointer_last_x = c->pointer_x;
+			c->pointer_last_y = c->pointer_y;
+			c->pointer_last_b = 3;
+			for (i = 0; i < 3; i++) c->pointer_presses[i].pane = -1;
+		}
+		goto ack;
+	}
+	if (c->pointer_owner != owner) {
+		cmdq_error(item, "pointer lease is not owned by this control connection");
+		return (0);
+	}
+	if (strcmp(action, "hide") == 0 || strcmp(action, "end") == 0) {
+		server_client_pointer_cancel(c, strcmp(action, "end") == 0);
+		goto ack;
+	}
+	if (strcmp(action, "show") == 0) {
+		c->pointer_visible = 1;
+		goto ack;
+	}
+	if (move && c->pointer_motion != NULL) count = 0;
+	if (wheel) count = abs(x) + abs(y);
+	/* Reject before any position/button mutation when the native queue is full. */
+	if (c->pointer_pending + count > 64) {
+		cmdq_error(item, "pointer event queue is full");
+		return (0);
+	}
+	server_client_pointer_clamp(c);
+	if (move) {
+		px = relative ? (long long)c->pointer_x + x : x;
+		py = relative ? (long long)c->pointer_y + y : y;
+		if (px < 0) px = 0;
+		if (py < 0) py = 0;
+		if (px >= c->tty.sx) px = c->tty.sx - 1;
+		if (py >= c->tty.sy) py = c->tty.sy - 1;
+		if (c->pointer_x == (u_int)px && c->pointer_y == (u_int)py)
+			goto ack;
+		c->pointer_x = px; c->pointer_y = py;
+		for (i = 0; i < 3; i++) if (c->pointer_buttons & (1U << i)) {b = i; break;}
+		server_client_pointer_event(c, b|MOUSE_MASK_DRAG, b|MOUSE_MASK_DRAG, 0, 1);
+	} else if (wheel) {
+		for (i = 0; i < (u_int)abs(y); i++) {
+			b = y > 0 ? 64 : 65;
+			server_client_pointer_event(c, b, b, 0, 0);
+		}
+		for (i = 0; i < (u_int)abs(x); i++) {
+			b = x > 0 ? 67 : 66;
+			server_client_pointer_event(c, b, b, 0, 0);
+		}
+	} else if (strcmp(action, "down") == 0) {
+		if (c->pointer_buttons & (1U << button)) goto ack;
+		c->pointer_buttons |= 1U << button;
+		server_client_pointer_event(c, button, button, 0, 0);
+	} else {
+		if (!(c->pointer_buttons & (1U << button))) goto ack;
+		c->pointer_buttons &= ~(1U << button);
+		server_client_pointer_event(c, 3, button, 1, 0);
+	}
+ack:
+	server_client_pointer_clamp(c);
+	cmdq_print(item, "pointer-v1 %llu %u %u %d %u",
+	    (unsigned long long)c->instance, c->pointer_x, c->pointer_y,
+	    c->pointer_visible, c->pointer_buttons);
+	return (1);
+busy:
+	cmdq_error(item, "pointer is busy");
+	return (0);
+}
