+	instance = args_strtonum(args, 'I', 1, LLONG_MAX, &cause);
+	if (cause != NULL)
+		goto invalid;
+	pane_pid = args_strtonum(args, 'P', 1, INT_MAX, &cause);
+	if (cause != NULL)
+		goto invalid;
