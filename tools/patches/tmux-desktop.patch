+	if (cause == NULL && args_has(args, 'y'))
+		sy = args_percentage(args, 'y', 1, INT_MAX, w->sy, &cause);
+	if (cause != NULL) {
+		cmdq_error(item, "size %s", cause);
+		free(cause);
+		return (CMD_RETURN_ERROR);
+	}
+	if (args_has(args, 'L'))
+		sx = adjust >= (u_int)sx ? 1 : sx - adjust;
+	else if (args_has(args, 'R'))
+		sx = adjust > (u_int)(INT_MAX - sx) ? INT_MAX : sx + adjust;
+	else if (args_has(args, 'U'))
+		sy = adjust >= (u_int)sy ? 1 : sy - adjust;
+	else if (args_has(args, 'D'))
+		sy = adjust > (u_int)(INT_MAX - sy) ? INT_MAX : sy + adjust;
+	if (layout_resize_floating_pane(wp, sx, sy, lc->xoff, lc->yoff)) {
+		server_redraw_window(w);
+		server_redraw_window_borders(w);
+		notify_window("window-layout-changed", w);
+	}
+	return (CMD_RETURN_NORMAL);
+}
