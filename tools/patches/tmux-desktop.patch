+/*
+ * Window coordinates are also meaningful on pane borders. Use the viewport
+ * saved with the event, rather than whichever client is current at expansion.
+ * Status rows have no window coordinate and must not activate title controls.
+ */
+static int
+format_mouse_window_position(struct format_tree *ft, u_int *x, u_int *y)
+{
+	struct mouse_event *m = &ft->m;
+	u_int raw_y;
+
+	if (!m->valid)
+		return (0);
+	if (m->statusat >= 0 && m->y >= (u_int)m->statusat &&
+	    m->y - m->statusat < m->statuslines)
+		return (0);
+	raw_y = m->y;
+	if (m->statusat == 0) {
+		if (raw_y < m->statuslines)
+			return (0);
+		raw_y -= m->statuslines;
+	}
+	if (m->x > UINT_MAX - m->ox || raw_y > UINT_MAX - m->oy)
+		return (0);
+	*x = m->x + m->ox;
+	*y = raw_y + m->oy;
+	return (1);
+}
+
+/* Callback for mouse_window_x. */
+static void *
+format_cb_mouse_window_x(struct format_tree *ft)
+{
+	u_int x, y;
+
+	if (format_mouse_window_position(ft, &x, &y))
+		return (format_printf("%u", x));
+	return (NULL);
+}
+
+/* Callback for mouse_window_y. */
+static void *
+format_cb_mouse_window_y(struct format_tree *ft)
+{
+	u_int x, y;
+
+	if (format_mouse_window_position(ft, &x, &y))
+		return (format_printf("%u", y));
+	return (NULL);
+}
+
