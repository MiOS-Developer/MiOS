+
+/* Stop only an Inputd lease's autoscroll; no selection/copy/release binding. */
+void
+window_copy_cancel_pointer_drag(struct client *c, uint64_t generation)
+{
+	struct window_pane *wp;
+	struct window_mode_entry *wme;
+	struct window_copy_mode_data *data;
+	if (generation == 0 || c->pointer_drag_generation != generation ||
+	    c->tty.mouse_last_pane < 0)
+		return;
+	wp = window_pane_find_by_id(c->tty.mouse_last_pane);
+	if (wp == NULL || (wme = TAILQ_FIRST(&wp->modes)) == NULL)
+		return;
+	if (wme->mode != &window_copy_mode && wme->mode != &window_view_mode)
+		return;
+	data = wme->data;
+	evtimer_del(&data->dragtimer);
+}
