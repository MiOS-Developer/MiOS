+/* All identity checks and the layout mutation run in the same event turn. */
+static enum cmd_retval
+cmd_client_window_action_exec(struct cmd *self, struct cmdq_item *item)
+{
+	struct args		*args = cmd_get_args(self);
+	struct client		*owner = cmdq_get_client(item);
+	struct client		*c = cmdq_get_target_client(item);
+	struct window_pane	*wp;
