+	    strcmp(args_get(args, 't'), c->name) != 0 ||
+	    (owner->flags & CLIENT_READONLY) ||
+	    !(c->flags & CLIENT_TERMINAL) ||
+	    (c->flags & (CLIENT_CONTROL|CLIENT_READONLY|CLIENT_SUSPENDED|
+	    CLIENT_UNATTACHEDFLAGS)) || owner->peer == NULL || c->peer == NULL ||
+	    proc_get_peer_uid(c->peer) == (uid_t)-1 ||
+	    proc_get_peer_uid(c->peer) != proc_get_peer_uid(owner->peer) ||
+	    c->session == NULL || c->session->curw == NULL ||
+	    c->tty.sx == 0 || c->tty.sy == 0) {
+		cmdq_error(item, "window action requires an exact writable terminal client");
+		return (CMD_RETURN_ERROR);
+	}
+	client_pid = args_strtonum(args, 'C', 1, INT_MAX, &cause);
+	if (cause != NULL)
