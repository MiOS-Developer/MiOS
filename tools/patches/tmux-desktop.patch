+
+/* Native client mouse projection: only a persistent control client may own it. */
+static enum cmd_retval cmd_client_pointer_exec(struct cmd *, struct cmdq_item *);
+const struct cmd_entry cmd_client_pointer_entry = {
+	.name = "client-pointer",
+	.alias = NULL,
+	.args = { "b:I:P:rt:x:y:", 1, 1, NULL },
+	.usage = "-t exact-client -P client-pid -I client-instance [-r] [-x n -y n] [-b left|middle|right] action",
+	.flags = CMD_CLIENT_TFLAG|CMD_READONLY,
+	.exec = cmd_client_pointer_exec
+};
+
+static enum cmd_retval
+cmd_client_pointer_exec(struct cmd *self, struct cmdq_item *item)
+{
+	struct args *args = cmd_get_args(self);
+	struct client *owner = cmdq_get_client(item), *c = cmdq_get_target_client(item);
+	const char *action = args_string(args, 0), *button;
+	char *cause = NULL;
+	long long pid, instance, x = 0, y = 0;
+	int b = -1, move = strcmp(action, "move") == 0;
+	int wheel = strcmp(action, "wheel") == 0;
+	int edge = strcmp(action, "down") == 0 || strcmp(action, "up") == 0;
+	if (owner == NULL || !(owner->flags & CLIENT_CONTROL) ||
+	    c == NULL || owner == c || !args_has(args, 't') ||
+	    strcmp(args_get(args, 't'), c->name) != 0 ||
+	    !(c->flags & CLIENT_TERMINAL) ||
+	    (c->flags & (CLIENT_CONTROL|CLIENT_READONLY|CLIENT_UNATTACHEDFLAGS)) ||
+	    c->peer == NULL || owner->peer == NULL ||
+	    proc_get_peer_uid(c->peer) == (uid_t)-1 ||
+	    proc_get_peer_uid(c->peer) != proc_get_peer_uid(owner->peer) ||
+	    c->session == NULL || c->tty.sx == 0 || c->tty.sy == 0) {
+		cmdq_error(item, "pointer requires an exact writable terminal client and a control owner");
+		return (CMD_RETURN_ERROR);
+	}
+	pid = args_strtonum(args, 'P', 1, INT_MAX, &cause);
+	if (cause != NULL) goto invalid;
+	instance = args_strtonum(args, 'I', 1, LLONG_MAX, &cause);
+	if (cause != NULL) goto invalid;
+	if (pid != c->pid || (uint64_t)instance != c->instance) {
+		cmdq_error(item, "pointer client identity changed");
+		return (CMD_RETURN_ERROR);
+	}
+	if (!move && !wheel && !edge && strcmp(action, "begin") != 0 &&
+	    strcmp(action, "show") != 0 && strcmp(action, "hide") != 0 &&
+	    strcmp(action, "end") != 0) goto syntax;
+	if (args_has(args, 'r') && !move) goto syntax;
+	if (args_has(args, 'b') != edge) goto syntax;
+	if (args_has(args, 'x') != (move || wheel) ||
+	    args_has(args, 'y') != (move || wheel)) goto syntax;
+	if (edge) {
+		button = args_get(args, 'b');
+		if (strcmp(button, "left") == 0) b = 0;
+		else if (strcmp(button, "middle") == 0) b = 1;
+		else if (strcmp(button, "right") == 0) b = 2;
+		else goto syntax;
+	}
+	if (move || wheel) {
+		long long bound = wheel ? 32 : (args_has(args, 'r') ? 64 : 32767);
+		x = args_strtonum(args, 'x', -bound, bound, &cause);
+		if (cause != NULL) goto invalid;
+		y = args_strtonum(args, 'y', -bound, bound, &cause);
+		if (cause != NULL) goto invalid;
+		if (wheel && llabs(x) + llabs(y) > 32) goto syntax;
+	}
+	if (!server_client_pointer(owner, c, action, args_has(args, 'r'), x, y, b, item))
+		return (CMD_RETURN_ERROR);
+	return (CMD_RETURN_NORMAL);
+syntax:
+	cmdq_error(item, "invalid pointer action or flags");
+	return (CMD_RETURN_ERROR);
+invalid:
+	cmdq_error(item, "invalid pointer number: %s", cause);
+	free(cause);
+	return (CMD_RETURN_ERROR);
+}
