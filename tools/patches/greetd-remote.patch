+fn needs_fresh_remote_audit(class: &SessionClass, authenticate: bool, remote: bool) -> bool {
+    authenticate && remote && matches!(class, SessionClass::User)
+}
+
+fn valid_remote_audit_uid(uid: Uid) -> bool {
+    !uid.is_root() && uid.as_raw() != u32::MAX
+}
+
+fn read_audit_identity(path: &str) -> Result<u32, Error> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    let mut value = String::new();
+    file.take(32).read_to_string(&mut value)?;
+    if value.len() >= 32 {
+        return Err("remote kernel audit identity exceeded bounds".into());
+    }
+    value
+        .trim()
+        .parse()
+        .map_err(|_| "remote kernel audit identity is invalid".into())
+}
+
+/// A nested remote login must not reuse its transport's audit session. Linux-PAM
+/// skips an equal-UID loginuid write, but the kernel allocates a fresh session ID
+/// for each permitted valid-UID write. Change only this authenticated PAM worker;
+/// never clear its identity, change another process or relax kernel audit policy.
+fn establish_fresh_remote_audit(uid: Uid) -> Result<(), Error> {
+    if !nix::unistd::geteuid().is_root() || !valid_remote_audit_uid(uid) {
+        return Err(
+            "fresh remote audit identity requires a root worker and valid non-root account".into(),
+        );
+    }
+    let previous = read_audit_identity("/proc/self/sessionid")?;
+    let mut loginuid = OpenOptions::new()
+        .write(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open("/proc/self/loginuid")?;
+    loginuid.write_all(uid.as_raw().to_string().as_bytes())?;
+    let current = read_audit_identity("/proc/self/sessionid")?;
+    if read_audit_identity("/proc/self/loginuid")? != uid.as_raw()
+        || current == u32::MAX
+        || current == previous
+    {
+        return Err("kernel did not establish a fresh selected-account audit session".into());
+    }
+    Ok(())
+}
