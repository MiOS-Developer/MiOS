+fn validate_mios_remote(file: &ConfigFile) -> Result<(), Error> {
+    let host = file.general.remote_host.as_deref().unwrap_or("");
+    if file.terminal.vt != VtSelection::None
+        || file.terminal.switch
+        || file.default_session.user != "root"
+        || file.general.source_profile
+        || host.is_empty()
+        || host.len() > 255
+        || host.chars().any(char::is_control)
+        || matches!(
+            host.trim_end_matches('.').to_ascii_lowercase().as_str(),
+            "localhost" | "localhost.localdomain"
+        )
+        || host
+            .parse::<std::net::IpAddr>()
+            .map(|ip| ip.is_loopback() || ip.is_unspecified())
+            .unwrap_or(false)
+    {
+        return Err("private remote mode requires vt=none, switch=false, source_profile=false, a root default-session and a non-local remote_host".into());
+    }
+    Ok(())
+}
