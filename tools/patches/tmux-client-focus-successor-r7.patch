+/* A stale controller request must not resolve through a default client. */
+const struct cmd_entry cmd_client_window_action_entry = {
+	.name = "client-window-action",
+	.alias = NULL,
+	.args = { "C:I:p:P:s:t:w:", 1, 1, NULL },
+	.usage = "-t exact-client -C client-pid -I client-instance "
+		 "-s session-id -w window-id -p pane-id -P pane-pid zoom",
+	.flags = CMD_CLIENT_TFLAG,
+	.exec = cmd_client_window_action_exec
+};
+
+static int
+cmd_client_window_action_id(struct args *args, u_char flag, char prefix,
+    u_int id)
+{
+	char value[32];
+
+	if (!args_has(args, flag))
+		return (0);
+	xsnprintf(value, sizeof value, "%c%u", prefix, id);
+	return (strcmp(args_get(args, flag), value) == 0);
+}
+
+/* All identity checks and the layout mutation run in the same event turn. */
+static enum cmd_retval
+cmd_client_window_action_exec(struct cmd *self, struct cmdq_item *item)
+{
+	struct args		*args = cmd_get_args(self);
+	struct client		*owner = cmdq_get_client(item);
+	struct client		*c = cmdq_get_target_client(item);
+	struct window_pane	*wp;
+	struct window		*w;
+	char			*cause = NULL;
+	long long		 client_pid, instance, pane_pid;
+	int			 changed;
+
+	if (strcmp(args_string(args, 0), "zoom") != 0) {
+		cmdq_error(item, "unsupported client window action");
+		return (CMD_RETURN_ERROR);
+	}
+	if (owner == NULL || c == NULL || !args_has(args, 't') ||
+	    strcmp(args_get(args, 't'), c->name) != 0 ||
+	    (owner->flags & CLIENT_READONLY) ||
+	    !(c->flags & CLIENT_TERMINAL) ||
+	    (c->flags & (CLIENT_CONTROL|CLIENT_READONLY|CLIENT_SUSPENDED|
+	    CLIENT_UNATTACHEDFLAGS)) || owner->peer == NULL || c->peer == NULL ||
+	    proc_get_peer_uid(c->peer) == (uid_t)-1 ||
+	    proc_get_peer_uid(c->peer) != proc_get_peer_uid(owner->peer) ||
+	    c->session == NULL || c->session->curw == NULL ||
+	    c->tty.sx == 0 || c->tty.sy == 0) {
+		cmdq_error(item, "window action requires an exact writable terminal client");
+		return (CMD_RETURN_ERROR);
+	}
+	client_pid = args_strtonum(args, 'C', 1, INT_MAX, &cause);
+	if (cause != NULL)
+		goto invalid;
+	instance = args_strtonum(args, 'I', 1, LLONG_MAX, &cause);
+	if (cause != NULL)
+		goto invalid;
+	pane_pid = args_strtonum(args, 'P', 1, INT_MAX, &cause);
+	if (cause != NULL)
+		goto invalid;
+
+	wp = server_client_get_pane(c);
+	w = c->session->curw->window;
+	if (client_pid != c->pid || (uint64_t)instance != c->instance ||
+	    wp == NULL || wp->window != w || pane_pid != wp->pid ||
+	    window_pane_exited(wp) || !window_pane_visible(wp) ||
+	    !cmd_client_window_action_id(args, 's', '$', c->session->id) ||
+	    !cmd_client_window_action_id(args, 'w', '@', w->id) ||
+	    !cmd_client_window_action_id(args, 'p', '%', wp->id)) {
+		cmdq_error(item, "focused client window identity changed");
+		return (CMD_RETURN_ERROR);
+	}
+
+	/* The native zoom tree retains floating geometry, process and PTY too. */
+	if (w->flags & WINDOW_ZOOMED)
+		changed = (window_unzoom(w, 1) == 0);
+	else
+		changed = (window_zoom(wp) == 0);
+	if (changed)
+		server_redraw_window(w);
+	cmdq_print(item, "ok");
+	return (CMD_RETURN_NORMAL);
+
+invalid:
+	cmdq_error(item, "invalid window action number: %s", cause);
+	free(cause);
+	return (CMD_RETURN_ERROR);
+}
