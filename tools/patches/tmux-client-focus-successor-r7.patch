+/* Explicit client input focus; pane_id keeps its existing window semantics. */
+static struct window_pane *
+format_client_input_pane(struct format_tree *ft)
+{
+	struct window_pane	*wp;
+
+	if (ft->c == NULL || ft->c->session == NULL ||
+	    ft->c->session->curw == NULL)
+		return (NULL);
+	wp = server_client_get_pane(ft->c);
+	if (wp == NULL || wp->window != ft->c->session->curw->window ||
+	    window_pane_exited(wp))
+		return (NULL);
+	return (wp);
+}
+
+static void *
+format_cb_client_pane_id(struct format_tree *ft)
+{
+	struct window_pane	*wp = format_client_input_pane(ft);
+
+	if (wp != NULL)
+		return (format_printf("%%%u", wp->id));
+	return (NULL);
+}
+
+static void *
+format_cb_client_pane_pid(struct format_tree *ft)
+{
+	struct window_pane	*wp = format_client_input_pane(ft);
+
+	if (wp != NULL)
+		return (format_printf("%ld", (long)wp->pid));
+	return (NULL);
+}
+
+static void *
+format_cb_client_window_id(struct format_tree *ft)
+{
+	struct window_pane	*wp = format_client_input_pane(ft);
+
+	if (wp != NULL)
+		return (format_printf("@%u", wp->window->id));
+	return (NULL);
+}
+
+static void *
+format_cb_client_window_zoomed_flag(struct format_tree *ft)
+{
+	struct window_pane	*wp = format_client_input_pane(ft);
+
+	if (wp != NULL)
+		return (xstrdup((wp->window->flags & WINDOW_ZOOMED) ? "1" : "0"));
+	return (NULL);
+}
+
+static void *
+format_cb_client_window_action_version(struct format_tree *ft)
+{
+	if (ft->c != NULL)
+		return (xstrdup("1"));
+	return (NULL);
+}
